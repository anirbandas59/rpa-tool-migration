{
  "properties": {
    "connectionReferences": {{ connection_references_json }},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {{ parameters_json }},
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "boolean": {
                  "title": "Loader_Flag",
                  "description": "No",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                },
                "boolean_1": {
                  "title": "Performer_Flag",
                  "description": "No",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                }
              },
              "required": ["boolean", "boolean_1"]
            }
          }
        }
      },
      "actions": {
        "Init_Flow_Status": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [{ "name": "Flow_Status", "type": "boolean", "value": false }]
          },
          "runAfter": {}
        },
        "Init_var_Config": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [{ "name": "var", "type": "object", "value": {} }]
          },
          "runAfter": { "Init_Flow_Status": ["Succeeded"] }
        },
        "Init_Flow_Message": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [{ "name": "Flow_Message", "type": "string" }]
          },
          "runAfter": { "Init_var_Config": ["Succeeded"] }
        },
        "Init_Exception_Message": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [{ "name": "Exception_Message", "type": "string" }]
          },
          "runAfter": { "Init_Flow_Message": ["Succeeded"] }
        },
        "Init_Work_Queue_ID": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [{ "name": "WorkQueue_ID", "type": "string" }]
          },
          "runAfter": { "Init_Exception_Message": ["Succeeded"] }
        },
        "Try:_Init": {
          "type": "Scope",
          "actions": {
            "Compose:_Config": {
              "type": "Compose",
              "inputs": {{ config_compose_json }},
              "runAfter": {}
            },
            "Set_Config_value": {
              "type": "SetVariable",
              "inputs": {
                "name": "var",
                "value": "@outputs('Compose:_Config')"
              },
              "runAfter": { "Compose:_Config": ["Succeeded"] }
            },
            "Set_Init_Status": {
              "type": "SetVariable",
              "inputs": { "name": "Flow_Status", "value": true },
              "runAfter": { "Set_Config_value": ["Succeeded"] }
            }
          },
          "runAfter": { "Init_Work_Queue_ID": ["Succeeded"] }
        },
        "Try:_Loader": {
          "type": "Scope",
          "actions": {
            "Assign_Work_Queue_ID": {
              "type": "SetVariable",
              "inputs": {
                "name": "WorkQueue_ID",
                "value": "@variables('var')?['Ctrl_WorkQueueId']"
              },
              "runAfter": {}
            },
            "If_Loader_flag_=_yes": {
              "type": "If",
              "expression": {
                "and": [{ "equals": ["@triggerBody()?['boolean']", true] }]
              },
              "actions": {
                {# Cloud-native loader is a config-selectable option with no PAD implementation yet (architecture doc §A2 lines 88-89). STOP if a real BP process ever needs this path. #}
                "If_Loader_type_=_Cloud": {
                  "type": "If",
                  "expression": {
                    "and": [{ "equals": ["@toLower(variables('var')?['Ctrl_LoaderType'])", "cloud"] }]
                  },
                  "actions": {},
                  "else": {
                    "actions": {
                      "If_Desktop_run_=_Unattended": {
                        "type": "If",
                        "expression": {
                          "and": [{ "equals": ["@toLower(variables('var')?['Ctrl_LoaderUnattendedRun'])", "yes"] }]
                        },
                        "actions": {
                          "Desktop_Flow_-_Loader_-_Unattended": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "parameters": {
                                "uiFlowId": "{{ loader_uiflow_id }}",
                                "runMode": "unattended",
                                "item/In_txt_Config": "@string(variables('var'))"
                              },
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                                "operationId": "RunUIFlow_V2",
                                "connectionName": "shared_uiflow"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Desktop_Flow_-_Loader_-_Attended": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "uiFlowId": "{{ loader_uiflow_id }}",
                                  "runMode": "attended",
                                  "item/In_txt_Config": "@string(variables('var'))"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                                  "operationId": "RunUIFlow_V2",
                                  "connectionName": "shared_uiflow"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          }
                        }
                      },
                      "Loader_Flow_Success": {
                        "type": "SetVariable",
                        "inputs": { "name": "Flow_Status", "value": true },
                        "runAfter": { "If_Desktop_run_=_Unattended": ["Succeeded"] }
                      }
                    }
                  }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "Assign_Work_Queue_ID": ["Succeeded"] }
            }
          },
          "runAfter": { "Try:_Init": ["Succeeded"] }
        },
        "Try:_Performer": {
          "type": "Scope",
          "actions": {
            "If_Performer_flag_=_yes": {
              "type": "If",
              "expression": {
                "and": [{ "equals": ["@triggerBody()?['boolean_1']", true] }]
              },
              "actions": {
                "List_rows_-_Get_Queue_Item_count": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "workqueueitems",
                      "$filter": "_workqueueid_value eq '@{variables('WorkQueue_ID')}' and statecode eq 0"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Total_Queue_Items": {
                  "type": "Compose",
                  "inputs": "@length(outputs('List_rows_-_Get_Queue_Item_count')?['body/value'])",
                  "runAfter": { "List_rows_-_Get_Queue_Item_count": ["Succeeded"] }
                },
                "If_Work_Queue_Items_present": {
                  "type": "If",
                  "expression": {
                    "and": [{ "greater": ["@outputs('Total_Queue_Items')", 0] }]
                  },
                  "actions": {
                    "If_Performer_type_=_desktop": {
                      "type": "If",
                      "expression": {
                        "and": [{ "equals": ["@toLower(variables('var')?['Ctrl_PerfomerType'])", "desktop"] }]
                      },
                      "actions": {
                        "If_performer_run_=_Unattended": {
                          "type": "If",
                          "expression": {
                            "and": [{ "equals": ["@toLower(variables('var')?['Ctrl_PerfomerUnattendedRun'])", "yes"] }]
                          },
                          "actions": {
                            "Desktop_Flow_-_Performer_-_Unattended": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "uiFlowId": "{{ performer_uiflow_id }}",
                                  "runMode": "unattended",
                                  "item/In_txt_Config": "@string(variables('var'))"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                                  "operationId": "RunUIFlow_V2",
                                  "connectionName": "shared_uiflow"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Desktop_Flow_-_Performer_-_Attended": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "parameters": {
                                    "uiFlowId": "{{ performer_uiflow_id }}",
                                    "runMode": "attended",
                                    "item/In_txt_Config": "@string(variables('var'))"
                                  },
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                                    "operationId": "RunUIFlow_V2",
                                    "connectionName": "shared_uiflow"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              }
                            }
                          }
                        },
                        "Performer_Flow_Success": {
                          "type": "SetVariable",
                          "inputs": { "name": "Flow_Status", "value": true },
                          "runAfter": { "If_performer_run_=_Unattended": ["Succeeded"] }
                        }
                      },
                      {# Non-desktop performer type has no PAD implementation yet (architecture doc §A2 line 107). STOP if a real BP process ever needs this path. #}
                      "else": { "actions": {} }
                    }
                  },
                  "else": { "actions": {} },
                  "runAfter": { "Total_Queue_Items": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": {}
            },
            "Respond_to_a_Power_App_or_flow_-_Success": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "out_txt_mainflow_status": {
                      "title": "Out_txt_MainFlow_Status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": { "out_txt_mainflow_status": "Success" }
              },
              "runAfter": { "If_Performer_flag_=_yes": ["Succeeded"] },
              "operationOptions": "Asynchronous"
            }
          },
          "runAfter": { "Try:_Loader": ["Succeeded"] }
        },
        "Catch:_Init": {
          "type": "Scope",
          "actions": {
            "Get_CurrentDateTime_-_Init": {
              "type": "Compose",
              "inputs": "@formatDateTime(utcNow(), 'MM/dd/yyyy hh:mm:ss tt')"
            },
            "Init_Flow_Exception": {
              "type": "SetVariable",
              "inputs": {
                "name": "Exception_Message",
                "value": "{{ init_failure_email_expr }}"
              },
              "runAfter": { "Get_CurrentDateTime_-_Init": ["Succeeded"] }
            },
            "Get_Current_workflow_Details_-_Init_failure": {
              "type": "Compose",
              "inputs": "@workflow()",
              "runAfter": { "Init_Flow_Exception": ["Succeeded"] }
            },
            "Send_an_email_(V2)_-_Init_Flow_Failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "{{ init_email_recipient }}",
                  "emailMessage/Subject": "@{workflow()?['tags']['flowDisplayName']} - Init System Exception - @{outputs('Get_CurrentDateTime_-_Init')}",
                  "emailMessage/Body": "<p>An exception occurred during initialization in the Power Automate flow.</p><p>Flow name: @{workflow()?['tags']['flowDisplayName']}</p><p>Error message: @{variables('Exception_Message')}</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": { "Get_Current_workflow_Details_-_Init_failure": ["Succeeded"] }
            },
            "Terminate_Flow_-_Init": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Run a flow built with Power Automate for desktop Failed",
                  "message": "@variables('Exception_Message')"
                }
              },
              "runAfter": { "Respond_to_a_Power_App_or_flow_-_Init_fail": ["Succeeded"] }
            },
            "Respond_to_a_Power_App_or_flow_-_Init_fail": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "out_txt_mainflow_status": {
                      "title": "Out_txt_MainFlow_Status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": { "out_txt_mainflow_status": "@{variables('Exception_Message')}" }
              },
              "runAfter": { "Send_an_email_(V2)_-_Init_Flow_Failure": ["Succeeded"] },
              "operationOptions": "Asynchronous"
            }
          },
          "runAfter": { "Try:_Init": ["Failed", "TimedOut"] }
        },
        "Catch:_Loader": {
          "type": "Scope",
          "actions": {
            "Get_CurrentDateTime_-_Loader": {
              "type": "Compose",
              "inputs": "@formatDateTime(utcNow(), 'MM/dd/yyyy hh:mm:ss tt')"
            },
            "Loader_Flow_Exception": {
              "type": "SetVariable",
              "inputs": {
                "name": "Exception_Message",
                "value": "@coalesce(outputs('Desktop_Flow_-_Loader_-_Attended')?['body']?['error']?['message'], outputs('Desktop_Flow_-_Loader_-_Unattended')?['body']?['error']?['message'], 'Unknown error')"
              },
              "runAfter": { "Get_CurrentDateTime_-_Loader": ["Succeeded"] }
            },
            "Get_Current_workflow_Details_-_Loader_failure": {
              "type": "Compose",
              "inputs": "@workflow()",
              "runAfter": { "Loader_Flow_Exception": ["Succeeded"] }
            },
            "Send_an_email_(V2)_-_Loader_Flow_Failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@variables('var')?['Mail_SystemExceptionTo']",
                  "emailMessage/Subject": "@{workflow()?['tags']['flowDisplayName']} - Loader System Exception - @{outputs('Get_CurrentDateTime_-_Loader')}",
                  "emailMessage/Body": "<p>An exception occurred in the Loader phase of the Power Automate flow.</p><p>Flow name: @{workflow()?['tags']['flowDisplayName']}</p><p>Error message: @{variables('Exception_Message')}</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": { "Get_Current_workflow_Details_-_Loader_failure": ["Succeeded"] }
            },
            "Terminate_Flow_-_Loader": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Run a flow built with Power Automate for desktop Failed",
                  "message": "@variables('Exception_Message')"
                }
              },
              "runAfter": { "Respond_to_a_Power_App_or_flow_-_Loader_fail": ["Succeeded"] }
            },
            "Respond_to_a_Power_App_or_flow_-_Loader_fail": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "out_txt_mainflow_status": {
                      "title": "Out_txt_MainFlow_Status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": { "out_txt_mainflow_status": "@{variables('Exception_Message')}" }
              },
              "runAfter": { "Send_an_email_(V2)_-_Loader_Flow_Failure": ["Succeeded"] },
              "operationOptions": "Asynchronous"
            }
          },
          "runAfter": { "Try:_Loader": ["Failed", "TimedOut"] }
        },
        "Catch:_Performer": {
          "type": "Scope",
          "actions": {
            "Get_CurrentDateTime_-_Performer": {
              "type": "Compose",
              "inputs": "@formatDateTime(utcNow(), 'MM/dd/yyyy hh:mm:ss tt')"
            },
            "Performer_Flow_Exception": {
              "type": "SetVariable",
              "inputs": {
                "name": "Exception_Message",
                "value": "@coalesce(outputs('Desktop_Flow_-_Performer_-_Attended')?['body']?['error']?['message'], outputs('Desktop_Flow_-_Performer_-_Unattended')?['body']?['error']?['message'], 'Unknown error')"
              },
              "runAfter": { "Get_CurrentDateTime_-_Performer": ["Succeeded"] }
            },
            "Get_Current_workflow_Details_-_Performer_failure": {
              "type": "Compose",
              "inputs": "@workflow()",
              "runAfter": { "Performer_Flow_Exception": ["Succeeded"] }
            },
            "Send_an_email_(V2)_-_Performer_Flow_Failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@variables('var')?['Mail_SystemExceptionTo']",
                  "emailMessage/Subject": "@{workflow()?['tags']['flowDisplayName']} - Performer System Exception - @{outputs('Get_CurrentDateTime_-_Performer')}",
                  "emailMessage/Body": "<p>An exception occurred in the Performer phase of the Power Automate flow.</p><p>Flow name: @{workflow()?['tags']['flowDisplayName']}</p><p>Error message: @{variables('Exception_Message')}</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": { "Get_Current_workflow_Details_-_Performer_failure": ["Succeeded"] }
            },
            "Terminate_Flow_-_Performer": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Run a flow built with Power Automate for desktop Failed",
                  "message": "@variables('Exception_Message')"
                }
              },
              "runAfter": { "Respond_to_a_Power_App_or_flow_-_Performer_fail": ["Succeeded"] }
            },
            "Respond_to_a_Power_App_or_flow_-_Performer_fail": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "out_txt_mainflow_status": {
                      "title": "Out_txt_MainFlow_Status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": { "out_txt_mainflow_status": "@{variables('Exception_Message')}" }
              },
              "runAfter": { "Send_an_email_(V2)_-_Performer_Flow_Failure": ["Succeeded"] },
              "operationOptions": "Asynchronous"
            }
          },
          "runAfter": { "Try:_Performer": ["Failed", "TimedOut"] }
        },
        "Catch:_Global_Error_Handler": {
          "type": "Scope",
          "actions": {
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Try:_Loader')",
                "where": "@or(equals(item()?['status'],'Failed'),equals(item()?['status'],'TimedOut'))"
              },
              "runAfter": {}
            },
            "Set_Exception_Message": {
              "type": "SetVariable",
              "inputs": {
                "name": "Exception_Message",
                "value": "@coalesce(first(body('Filter_array'))?['outputs']?['body']?['error']?['message'], first(body('Filter_array'))?['error']?['message'], 'Unknown error')"
              },
              "runAfter": { "Filter_array": ["Succeeded"] }
            },
            "Get_workflow_details": {
              "type": "Compose",
              "inputs": "@workflow()",
              "runAfter": { "Set_Exception_Message": ["Succeeded"] }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@variables('var')?['Mail_BusinessExceptionTo']",
                  "emailMessage/Subject": "@{workflow()?['tags']['flowDisplayName']} - System Exception",
                  "emailMessage/Body": "<p>An exception occurred in the Power Automate flow.</p><p>Flow name: @{workflow()?['tags']['flowDisplayName']}</p><p>Action: @{first(body('Filter_array'))?['name']}</p><p>Error message: @{variables('Exception_Message')}</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": { "Get_workflow_details": ["Succeeded"] }
            },
            "Respond_to_a_Power_App_or_flow_-_Global_fail": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "out_txt_mainflow_status": {
                      "title": "Out_txt_MainFlow_Status",
                      "type": "string",
                      "x-ms-content-hint": "TEXT",
                      "x-ms-dynamically-added": true
                    }
                  },
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": { "out_txt_mainflow_status": "@{variables('Exception_Message')}" }
              },
              "runAfter": { "Send_an_email_(V2)": ["Succeeded"] },
              "operationOptions": "Asynchronous"
            }
          },
          "runAfter": {
            "Catch:_Performer": ["Succeeded", "Failed", "TimedOut"],
            "Catch:_Init": ["Succeeded", "TimedOut", "Failed"],
            "Catch:_Loader": ["Succeeded", "TimedOut", "Failed"]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
