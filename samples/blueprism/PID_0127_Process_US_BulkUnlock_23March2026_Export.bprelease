ge stageid="26a883cb-d6ab-49c9-b3b8-7e83aaf6f4fe" name="Standards" type="Note"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list.(Unique Column to be prefered )

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://abc-sp.xyz.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://abcsp.xyz.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="3df19264-8259-45b7-ad9f-517e95afd6dc" name="Unexpected exception recover" type="Recover"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="450" y="-120" /><onsuccess>9ed8b0d3-aaa1-4d5f-97a4-26352e5f5fa0</onsuccess></stage><stage stageid="618098ab-9baf-4735-bde3-1928bf875104" name="Unexpected Exception" type="Exception"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="a4ed4aac-68cc-4dba-aeb3-7cb4e380f55a" name="Script_Location" type="Data"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="50d56f0d-8a1f-41c6-ac88-7eafce057098" name="Find_Item_By" type="Data"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9ed8b0d3-aaa1-4d5f-97a4-26352e5f5fa0" name="Delete_Script" type="Action"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="450" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>618098ab-9baf-4735-bde3-1928bf875104</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="01e6a18c-1cce-41d8-ba40-d3b88437abf3" name="Validate Temp Script Path" type="SubSheet"><subsheetid>888