An Exception will occur if access to the credentials is not allowed, based on the running Resource, Process and User.</narrative><display x="-120" y="-45" /><inputs><input type="text" name="Credentials Name" narrative="The name of the credentials to get" expr="[RPA_AzureBlob_Credential_Name]" /></inputs><outputs><output type="text" name="Username" friendlyname="Username" narrative="The user name" stage="" /><output type="password" name="Password" friendlyname="Password" narrative="The password" stage="SAS_Key" /><output type="date" name="Expiry Date" friendlyname="Expiry Date" narrative="The expiry date" stage="" /><output type="text" name="Status" friendlyname="Status" narrative="The status" stage="" /></outputs><onsuccess>4316e4b9-6abc-4fea-9464-95cd0f2c5684</onsuccess><resource object="Blueprism.Automate.clsCredentialsActions" action="Get" /></stage><stage stageid="efdf702e-fa21-41cd-b194-f4c9f84263ca" name="RPA_AzureBlob_Credential_Name" type="Data"><subsheetid>74d5ec64-5060-4bb4-b1e7-cf3f788792d2</subsheetid><display x="-360" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">RPA_Azure_Blob_Credential</initialvalue><exposure>Environment</exposure><alwaysinit /></stage><stage stageid="16d7265b-0508-4672-9ed1-ae7dd4d0c280" name="SAS_Key" type="Data"><subsheetid>74d5ec64-5060-4bb4-b1e7-cf3f788792d2</subsheetid><display x="-360" y="45" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="4316e4b9-6abc-4fea-9464-95cd0f2c5684" name="Empty Credentials?" type="Decision"><subsheetid>74d5ec64-5060-4bb4-b1e7-cf3f788792d2</subsheetid><loginhibit onsuccess="true" /><display x="-120" y="0" /><decision expression="[SAS_Key]= &quot;&quot;" /><ontrue>dd8623f0-e9d2-4062-966a-867e6932fa53</ontrue><onfalse>9f2d5f95-6d3f-42bf-90db-8890f922be97</onfalse></stage><stage stageid="dd8623f0-e9d2-4062-966a-867e6932fa53" name="Credential Is Invalid" type="Exception"><subsheetid>74