]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>4047caa7-fd67-4ad7-80bc-c54fa1a21720</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="bbae97bd-a951-4517-a77f-038ad0d2d3aa" name="Error Message?" type="Decision"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="165" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>a3f4b3a2-8640-4a0a-aac7-6655ba613218</ontrue><onfalse>7f88f405-5bb2-4cc3-832d-ededf3c18464</onfalse></stage><stage stageid="a3f4b3a2-8640-4a0a-aac7-6655ba613218" name="Received exception after running the script" type="Exception"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="120" y="165" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="842d58b4-fbd5-4c1e-80c1-e965a857f2ea" name="Input" type="Block"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="-345" y="60" w="195" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="88f4b74b-b4aa-43e6-a102-7ad3d87c74c9" name="Inhouse" type="Block"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="-495" y="60" w="120" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="966ac27b-f0f6-49cc-9d53-1304f69a3cc0" name="LIst_Item_Values" type="Data"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><narrative>LIst_Item_Values</narrative><display x="-210" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65082087-ea11-4f91-ac7c-24037ac19b51" name="End" type="End"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="390" /></stage><stage stageid="94ba82ee-b6ec-4a9c-b474-04bb0446dd99" name="User Name" type="Data"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="-435" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bcd34fc0-6d46-4d30-b76e-9b81216d63a7" name="Column_name_values" type="Note"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><narrative>Column_name_values

Single column:
Chr(34)&amp;[Column Name in SP list]&amp;Chr(34)&amp;"=$Record.'Column Name in CSV';"

EX:  Chr(34)&amp;[Title]&amp;Chr(34)&amp;"=$Record.'ABC';"

Multiple column:
Chr(34)&amp;[Column Name1 in SP list]&amp;Chr(34)&amp;"=$Record.'Column Name in CSV';"&amp;NewLine()&amp;Chr(34)&amp;[Column Name2 in SP list]&amp;Chr(34)&amp;"=$Record.'Column Name in CSV';"


EX:  Chr(34)&amp;[Title]&amp;Chr(34)&amp;"=$Record.'ABC';"&amp;NewLine()&amp;Chr(34)&amp;[Material]&amp;Chr(34)&amp;"=$Record.'EFG';"</narrative><display x="360" y="-15" w="300" h="210" /></stage><stage stageid="4047caa7-fd67-4ad7-80bc-c54fa1a21720" name="Build Script" type="Calculation"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="-15" /><onsuccess>f2d9974b-0023-4883-b6ee-a6000318a7e0</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL]&amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;$fullStatus= @()&quot;&amp;NewLine()&amp;&#xA;&quot;$CustomerData = Import-CSV &quot;&amp;Chr(34)&amp;[CSV_File_Path]&amp;Chr(34)&amp;NewLine() &amp; &#xA;&quot;foreach ($Record in $CustomerData )&quot;&amp; NewLine() &amp;&#xA;&quot;{&quot;&amp;NewLine()&amp;&#xA;&quot;Try {&quot;&amp;NewLine()&amp;&quot;&#xA;$List_Item=Add-PnPListItem -List &quot;&amp;Chr(34)&amp;[SP_Target_List]&amp;Chr(34)&amp;&quot; -Values @{&quot;&amp;NewLine()&amp;[LIst_Item_Values]&amp; &quot;}&quot;&amp;NewLine()&amp;&quot;&#xA;If ($List_Item.ID -gt 0 )&quot; &amp; NewLine() &amp;&#xA;&quot;{&quot; &amp; NewLine() &amp;&#xA;&#xA; &quot;$fullStatus = New-Object PSObject -Property @{&quot;&amp;NewLine()&amp;&#xA;      &quot;'List ID' = $List_Item.ID&quot;&amp;NewLine()&amp;&quot;&#xA;      Status = &quot;&amp;Chr(34)&amp;&quot;Successfully added&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;        }&#xA;}&quot;&amp;NewLine()&amp;&#xA;&quot;}&quot;&amp;NewLine()&amp;&#xA;&quot;Catch{&quot;&amp;NewLine()&amp;&#xA;&quot;$fullStatus = New-Object PSObject -Property @{&quot;&amp;NewLine()&amp;&quot;&#xA;      'List ID' = &quot;&amp;Chr(34)&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;&#xA;            Status = &quot;&amp;Chr(34)&amp;&quot;ERROR Message: $($_.Exception.Message)&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;        }&quot;&#xA;&amp;NewLine()&amp;&#xA;&quot;}&quot;&amp;NewLine()&amp;&#xA;&quot;$fullStatus | Export-Csv &quot;&amp;Chr(34)&amp;[Logs_CSV_FilePath]&amp;Chr(34)&amp;&quot; –Append&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&#xA;&#xA;" stage="Script" /></stage><stage stageid="9640909d-9e44-445f-894b-49106fa0d565" name="CSV_File_Path" type="Data"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="-210" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c95d07b9-25be-4f42-a4f5-b93d81428cd2" name="Logs_CSV_FilePath" type="Data"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><narrative>Logs_CSV_FilePath</narrative><display x="-285" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="819063b9-eb63-4d5c-887f-fca5ee202c6a" name="Get File Name in Sharepoint - Matching a keyword" type="SubSheetInfo"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><narrative>Helps to Find Item in SharePoint Library.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5e7aab2a-78f8-4b47-8761-2d8b4970b38a" name="Start" type="Start"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="15" y="-300" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_Lib_Folder" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder)" stage="SP_Target_Lib" /><input type="text" name="Search_FileName" narrative="Share thele to be searched. (Ex:- APIdoc.docx)" stage="File_Name" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>a1ea7bc2-424b-4b51-bc07-427087330486</onsuccess></stage><stage stageid="152b94b4-602b-4a43-81b4-5835549d7788" name="End" type="End"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="15" y="345" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run details( If Item Found Shares Item Details. Else will be empty)" stage="Run Report" /><output type="text" name="Script_Error_Message" narrative="Returns error/exception details ( On error shares error details)" stage="Error_Message" /></outputs></stage><stage stageid="5ca7bcaf-8615-4c79-9528-a34c3028a143" name="Build Script" type="Calculation"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="15" y="-105" /><onsuccess>1521bcec-0592-4bbb-9a4a-85d7ed02142f</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$item = Find-PnPFile -Folder  &#xA;&quot; &amp; Chr(34) &amp; [SP_Target_Lib] &amp; Chr(34) &amp;  &quot;-Match &quot; &amp; Chr(34) &amp; [File_Name] &amp; Chr(34)&#xA;&amp; NewLine() &amp;  &quot;$str=(($item.Name -split '\r?\n').Trim() | ForEach-Object { ''+$_+'' }) -Join ','&quot; &amp; NewLine() &amp; &quot;write-Host $str&quot;&#xA;" stage="Script" /></stage><stage stageid="90fbed79-2eea-4483-a2e7-16c9c32ac80c" name="Run PnP_Script" type="SubSheet"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script 