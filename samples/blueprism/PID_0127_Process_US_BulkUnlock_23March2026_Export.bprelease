exception</narrative><display x="15" y="180" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>2bd04759-6431-4486-a836-b2859435809c</ontrue><onfalse>37eeaebb-8677-487f-8195-b296e4240fb4</onfalse></stage><stage stageid="a36a283b-251c-4526-aaa3-34daa4e0e59a" name="Received exception after running the script" type="Exception"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="240" y="135" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="f46f913b-aa3c-4292-a31a-f8589d82637c" name="Input" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-285" y="-90" w="180" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7330be1d-3d26-47ff-9ff1-b7ff64e5d507" name="Inhouse" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-480" y="-45" w="180" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7a34f308-6012-437c-b091-988467d66a7f" name="End" type="End"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="330" /><outputs><output type="text" name="Success_Message" narrative="On Success a meesge with file location will be shared" stage="Run Report" /></outputs></stage><stage stageid="c7b606e6-1572-4393-a1b0-c14d1a281e0f" name="User Name" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-390" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9599652b-194e-44bf-9fb1-3bf5ff8d8733" name="Result_File_location" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ccfc495-f8d7-41db-8a57-dceb98a15575" name="Check_ResultLoc" type="Decision"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="-45" /><decision expression="[Result_File_location]=&quot;&quot;" /><ontrue>f3069b13-620f-451e-8208-6dcb084885f2</ontrue><onfalse>09747f33-7bbb-406e-b92a-52c43767c366</onfalse></stage><stage stageid="f3069b13-620f-451e-8208-6dcb084885f2" name="Set_Default_Loc" type="Calculation"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="135" y="-45" /><onsuccess>09747f33-7bbb-406e-b92a-52c43767c366</onsuccess><calculation expression="[Script_Location]" stage="Result_File_location" /></stage><stage stageid="7342907a-2581-4f7c-ae27-b3e77647cb88" name="Count" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-390" y="135" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="7aa56265-197a-4e6f-90c8-91b46527b3cc" name="Get Oldest Filename in folder" type="SubSheetInfo"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><narrative>For the given Site and folder location, the name of the oldest file (as per the modifed date) is given as output</narrative><display x="-390" y="-75" w="180" h="60" /></stage><stage stageid="bdb3acf5-5262-4989-9b47-07d10074ac06" name="Start" type="Start"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="List/Lib_Name" narrative="List or library name" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /></inputs><onsuccess>e08ec335-408f-4b88-991e-3113864026cf</onsuccess></stage><stage stageid="a831a54d-16a3-4ced-898a-3dd84c12ee49" name="Build Script" type="Calculation"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="-45" w="90" h="30" /><onsuccess>c7291b3c-2bd6-4a0a-aef8-85059e31d0ab</onsuccess><calculation expression="&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$items=(Get-PnPFolderItem $SourceName -ErrorAction Stop -WarningAction silentlyContinue) &quot;&amp; NewLine() &amp; &#xA;&quot;$items = $items | Sort-Object -Property {$_.TimeLastModified} &quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount = $items.Count&quot;&amp; NewLine() &amp;&#xA;&quot;$FileName = ''&quot;&amp; NewLine() &amp; &#xA;&quot;$emptyStr = ''&quot; &amp; NewLine() &amp; &#xA;&#xA;&quot;If ($itemsCount -gt 0){ &quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;foreach($itm in $items) {&quot;&amp; NewLine() &amp; &#xA;&quot;If ($itm.GetType().Name -eq 'File') { &quot;&amp; NewLine() &amp; &#xA;&quot;$FileName = $itm.Name&quot;&amp; NewLine() &amp; &#xA;&quot;Break&quot;&amp; NewLine() &amp; &#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;Else { continue}}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;If ( $FileName -eq $emptyStr) {&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('No files found')&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Else{ &quot;&amp; NewLine() &amp; &#xA;&quot;Write-Host 'FILE NAME: '$FileName}&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else{&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('Folder is empty')&quot;&amp; NewLine() &amp; &#xA;&quot;}}&quot;&amp; NewLine() &amp; &#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="c7c8ee6c-1fbe-4d7d-83ed-5d7b68eb0a62" name="Run PnP_Script" type="SubSheet"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="90" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>da3595e6-57c9-43f6-acf7-a7fff2365c37</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="89d52a2b-425a-4ce2-b982-248cc6e201dd" name="Delete_Script" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="240" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>c592a196-6c01-402c-a412-e5a4ac5b1822</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="c7291b3c-2bd6-4a0a-aef8-85059e31d0ab" name="Generate_PnPScript" type="SubSheet"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_Oldest_File_in_folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>1ebebe8f-0b5d-46a5-ae0c-e2e572e2ad72</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="1ebebe8f-0b5d-46a5-ae0c-e2e572e2ad72" name="Check_Error" type="Decision"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c6aba161-e823-4935-bfcb-b225f34da387</ontrue><onfalse>c7c8ee6c-1fbe-4d7d-83ed-5d7b68eb0a62</onfalse></stage><stage stageid="c6aba161-e823-4935-bfcb-b225f34da387" name="Exception while creating  Script" type="Exception"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="e408fa9a-ed40-4586-8166-8f336c1fbb91" name="Check Process_Exist" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="180" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>b789d48c-1a71-453a-9327-342de10cf3c7</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="b789d48c-1a71-453a-9327-342de10cf3c7" name="ProcessExist?" type="Decision"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="135" y="180" /><decision expression="[P_Exists]=True" /><ontrue>01fb71e1-1daa-4b3e-abd7-9a3d646a322a</ontrue><onfalse>89d52a2b-425a-4ce2-b982-248cc6e201dd</onfalse></stage><stage stageid="01fb71e1-1daa-4b3e-abd7-9a3d646a322a" name="Kill Process" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="135" y="240" w="90" h="30" /><inputs><in