eetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-285" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5053d7ea-7264-49ec-bfba-d5f3fb045b58" name="Script" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-150" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7a6c76c-9d14-414f-b075-f4e197ad5eca" name="Script Path" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c19b694d-eaa8-408e-ab86-5f10b763c573" name="Output" type="Block"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-345" y="135" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e889c1f1-2312-4fd5-bacb-7c0b5e40b97f" name="Inhouse" type="Block"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-210" y="-15" w="120" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="afe4e41d-fb0b-489d-a17a-914d30214956" name="Exists" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-150" y="120" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8b665632-024d-4358-9e1b-4e2e8f0bb88c" name="Temp_Retry" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-150" y="150" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="00e34ce0-f2e1-4641-bb9f-f7a7427eea18" name="Run_Status" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-150" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06317914-c5ae-4cf1-b7e8-56403926ce16" name="Error_Message" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-285" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07c83e9a-31aa-4b17-b7b9-7a655c49678e" name="Script_Loc" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-315" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b5fefb39-5c17-403b-8d73-8337a964c7a6" name="Comments" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-300" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cba4772-5d8d-4313-a072-a684163f97ba" name="Block8" type="Block"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="-45" y="-210" w="255" h="465" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="eb52156f-4934-4216-a1ca-f7f474796d46" name="Block9" type="Block"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-30" y="-210" w="225" h="465" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c973c1dd-66ec-4af6-8717-20056d2e3b38" name="ExportAsCSV_AllFilesInFolder" type="SubSheetInfo"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><narrative>Export the list of all files fro the specified folder to a CSV file. (Doesn't give the list of folders)</narrative><display x="-390" y="-75" w="180" h="30" /></stage><stage stageid="55f793cb-e814-4d62-8283-9c7516fbf4a5" name="Start" type="Start"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="List/Lib_Name" narrative="List or library name" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /><input type="text" name="Result_File_Loc" narrative="result File Location(optional)" stage="Result_File_location" /></inputs><onsuccess>0eeb6d77-418d-4e71-90aa-093d5d075b21</onsuccess></stage><stage stageid="09747f33-7bbb-406e-b92a-52c43767c366" name="Build Script" type="Calculation"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="0" w="90" h="30" /><onsuccess>e56db55e-8e44-4856-a4ad-3924bfb61be7</onsuccess><calculation expression="&quot;$outputfile= &quot; &amp; Chr(34)  &amp;[Result_File_location] &amp; &quot;\Result.csv&quot;&amp; Chr(34) &amp; NewLine() &amp; &#xA;&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;if (Test-Path $outputfile -PathType Leaf)&quot;&amp; NewLine() &amp; &#xA;&quot;    {&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;        Remove-Item $outputfile -Force&quot;&amp; NewLine() &amp; &#xA;        &#xA;&quot;    }&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else { New-Item $outputfile -ItemType File -ErrorAction Stop }&quot;&amp; NewLine() &amp; &#xA;&quot;$items=(Get-PnPFolderItem $SourceName -ErrorAction Stop) &quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount = $items.Count&quot;&amp; NewLine() &amp;&#xA;&quot; $NonFileCount = 0 &quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;If ($itemsCount -gt 0){ &quot;&amp; NewLine() &amp; &#xA;&quot;Add-Content &quot; &amp;&quot; $outputfile -Value  'Name, Type, TimeLastModified'&quot; &amp; NewLine() &amp;&#xA;&#xA;&quot;foreach($itm in $items) {&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;If ($itm.GetType().Name -eq 'File') { &quot;&amp; NewLine() &amp; &#xA;&quot;$str =$itm.Name + &quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot; + $itm.GetType().Name + &quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot; + $itm.TimeLastModified&quot;&amp; NewLine() &amp; &#xA;&quot;Add-Content &quot; &amp; &quot; $outputfile $str &quot; &amp; NewLine() &amp;&#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA; &#xA;&quot;Else { $NonFileCount = $NonFileCount + 1&quot;&amp; NewLine() &amp; &#xA;&quot;continue}&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&#xA;&#xA;&quot;If ($NonFileCount -eq $itemsCount) {&quot;&amp; NewLine() &amp; &#xA;&quot;Remove-Item $outputfile -Force&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('No files found')&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Else{ &quot;&amp; NewLine() &amp; &#xA;&quot;Write-Host &quot; &amp; Chr(34)&amp; &quot;Completed. result stored in &quot; &amp;Chr(34) &amp; &quot;$outputfile }&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else{&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('Folder is empty')&quot;&amp; NewLine() &amp; &#xA;&quot;}}&quot;&amp; NewLine() &amp; &#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="fa9750c4-e68b-4160-a306-e253ba6a3b05" name="Run PnP_Script" type="SubSheet"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="135" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>0bfd375a-d67e-43c9-a1c9-970e3c9d7991</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="320cfc17-5ab8-4baf-b944-639598cd53a5" name="Delete_Script" type="Action"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="270" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>7a34f308-6012-437c-b091-988467d66a7f</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="e56db55e-8e44-4856-a4ad-3924bfb61be7" name="Generate_PnPScript" type="SubSheet"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="45" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Export_listLib_CSV&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>3252ba95-f770-4f84-a2bb-7cb9f904002c</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="3252ba95-f770-4f84-a2bb-7cb9f904002c" name="Check_Error" type="Decision"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="90" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>cca7e0eb-c7c6-4f73-a9e3-381a2627168c</ontrue><onfalse>fa9750c4-e68b-4160-a306-e253ba6a3b05</onfalse></stage><stage stageid="cca7e