        <object id="a58931ca-49e6-4bbb-9f86-a0e4c18ebbae" name="Utility_Object_Generic_KillProcess" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility_Object_Generic_KillProcess" version="1.0" bpversion="7.3.1.15031" narrative="Kill Process is Changed" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Background"><appdef><element name="Application Root"><id>61663cf7-dbd3-4e5f-900e-315a6b4e2f4c</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="94e0471c-5396-4b9d-bdab-7a1d1faa5bd7" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="ec32d8a6-bac6-486e-859f-fcb5c9b7dab2" type="Normal" published="True"><name>Kill Process</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="50d9aac5-643d-4a58-bb38-4873bebd94e5" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>7282eb43-740e-4024-be76-171c2102bd07</onsuccess></stage><stage stageid="7282eb43-740e-4024-be76-171c2102bd07" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="dea56b8f-d860-414e-b4c2-518f3fd3a74c" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import></imports><language>visualbasic</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="9fce5f94-64a4-4bd6-8fa2-fce319e501e6" name="Clean Up" type="SubSheetInfo"><subsheetid>94e0471c-5396-4b9d-bdab-7a1d1faa5bd7</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="48238c99-c53b-4ffd-a352-2c97aa5416db" name="Start" type="Start"><subsheetid>94e0471c-5396-4b9d-bdab-7a1d1faa5bd7</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>9fbc111b-f7f5-407d-8313-92b63925a668</onsuccess></stage><stage stageid="9fbc111b-f7f5-407d-8313-92b63925a668" name="End" type="End"><subsheetid>94e0471c-5396-4b9d-bdab-7a1d1faa5bd7</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="6e8a15a5-c614-4648-9f3f-54950475d3b2" name="Kill Process" type="SubSheetInfo"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><narrative>Force kills all processes with a given name.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="fe140260-ba9b-4147-9dab-194df2f46fa6" name="Start" type="Start"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="All processes with the given name will be terminated." /></postconditions><display x="15" y="-105" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" stage="Process Name" /></inputs><onsuccess>d4fd22d0-4628-403f-ad67-0d9d18177875</onsuccess></stage><stage stageid="fd6c59aa-5ac4-49a4-9a65-fd297cf58e51" name="End" type="End"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><loginhibit /><display x="15" y="60" /></stage><stage stageid="8e59c915-6c8d-433e-9102-1738222df321" name="Note1" type="Note"><subsheetid>94e0471c-5396-4b9d-bdab-7a1d1faa5bd7</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="dfc182f8-3f3f-4eea-ac08-17cf49820ad9" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="d4fd22d0-4628-403f-ad67-0d9d18177875" name="Kill Process" type="Code"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><loginhibit /><display x="15" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" expr="[Process Name]" /></inputs><onsuccess>fd6c59aa-5ac4-49a4-9a65-fd297cf58e51</onsuccess><code><![CDATA[
    for each p as System.Diagnostics.Process in System.Diagnostics.Process.GetProcessesByName(Process_Name)
	  Try
      p.kill
	  Catch ex As Exception
	  End Try
    next
  ]]></code></stage><stage stageid="50f31471-6567-4432-ac8e-45570f20ee58" name="Process Name" type="Data"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><display x="-120" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="84b94186-5340-4bda-a5ed-93238912209f" name="Input Parameter" type="Block"><subsheetid>ec32d8a6-bac6-486e-859f-fcb5c9b7dab2</subsheetid><loginhibit /><display x="-180" y="-30" w="120" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage></process></object>
        <object id="37b722f9-1f2f-47a7-9a37-e35535439e53" name="Utility_Object_Generic_RandomNumberGenerator" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility_Object_Generic_RandomNumberGenerator" version="1.0" bpversion="7.3.1.15031" narrative="To generate Random Number within given range" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="Application Root"><id>e4683166-49ae-4d98-b2e3-e42e33f3a3a2</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="9ed9d2ea-3e6a-4e7a-b29a-7eeb1f161193" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="38a885d8-65ec-45e7-9f18-eba0e30f3fc1" type="Normal" published="True"><name>Get n Random Numbers (Text)</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="08bf9326-8c57-454a-b551-a4dabac08192" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>6fe3b90d-21b7-4027-944f-f2f1c70ec994</onsuccess></stage><stage stageid="6fe3b90d-21b7-4027-944f-f2f1c70ec994" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="3bca8718-f770-4b53-89f5-cd169cec7229" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>System.Runtime.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import></imports><language>csharp</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="e3f05962-8132-4d70-a2a7-41ad277c5b3f" name="Clean Up" type="SubSheetInfo"><subsheetid>9ed9d2ea-3e6a-4e7a-b29a-7eeb1f161193</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="36613502-c9e0-4434-82a6-e655be6339c8" name="Start" type="Start"><subsheetid>9ed9d2ea-3e6a-4e7a-b29a-7eeb1f161193</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>785dd037-e690-4829-8751-9a23d3273436</onsuccess></stage><stage stageid="785dd037-e690-4829-8751-9a23d3273436" name="End" type="End"><subsheetid>9ed9d2ea-3e6a-4e7a-b29a-7eeb1f161193</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="b7596d96-72a4-44b7-9fc2-a47652c645b0" name="Get n Random Numbers (Text)" type="SubSheetInfo"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><narrative>Get n random numbers form start and end range specified
if start and end range is not mentioned then start is treated as 0 and end as 100</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="2c5ec61e-195d-4675-81d3-ee6eecc8f675" name="Start" type="Start"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="StartingNumber" narrative="Starting Number for sample selection" stage="in_StartRange" /><input type="number" name="EndingNumber" narrative="Ending Number for sample selection" stage="in_EndRange" /><input type="number" name="RequiredSampleCount" narrative="Number of samples requiered" stage="in_NumberCountRequired" /><input type="text" name="DelimiterForSeparation" narrative="Delimiter to be provided, if null then by default ;" stage="in_Delimiter" /></inputs><onsuccess>1c3aa0b0-42eb-4759-b8cc-d0b535b3e93f</onsuccess></stage><stage stageid="48706024-979a-4d7a-bb6e-c512925525f4" name="End" type="End"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Output" narrative="Random Numbers with delimiter" stage="txt_FinalText" /></outputs></stage><stage stageid="be56a954-05d2-4454-a0d1-3af533315b0c" name="Note1" type="Note"><subsheetid>9ed9d2ea-3e6a-4e7a-b29a-7eeb1f161193</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="4112a77b-3644-4350-add8-68023831da3c" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="1c3aa0b0-42eb-4759-b8cc-d0b535b3e93f" name="Generate Random Number" type="Code"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="number" name="StartRange" expr="[in_StartRange]" /><input type="number" name="EndRange" expr="[in_EndRange]" /><input type="number" name="NumberCountRequired" expr="[in_NumberCountRequired]" /><input type="text" name="Delimiter" expr="[in_Delimiter]" /></inputs><outputs><output type="text" name="FinalText" stage="txt_FinalText" /></outputs><onsuccess>48706024-979a-4d7a-bb6e-c512925525f4</onsuccess><code><![CDATA[// Instantiate random number generator using system-supplied value as seed.
var rand = new Random();
// Generate and display 5 random integers from 50 to 100.
FinalText = "";
int startRng = Convert.ToInt32(StartRange);
int endRng = Convert.ToInt32(EndRange);
int numCountReq = Convert.ToInt32(NumberCountRequired);
if(Delimiter=="")
	{Delimiter=";";}
if(endRng==0)
	{startRng=0;endRng=100;}
if(numCountReq<1)
	{numCountReq=1;}
//Setting FinalText to Delimiter for search operation
FinalText = Delimiter;
string temp = "";
string testString = "";
int limit = 0;
for (int ctr = 0; ctr < numCountReq; ctr++)
	{
		limit = 0;
		do
		{
		temp = Convert.ToString(rand.Next(startRng, endRng));
		testString = Delimiter+temp+Delimiter;
		limit+=1;
		if (limit>endRng-startRng+1)
		{
				FinalText = "Error, check limits and required output.";
				break;
		}
		}while(FinalText.Contains(testString));
		FinalText+=temp+Delimiter;
	}
]]></code></stage><stage stageid="2e9222f9-9f29-4ca2-b353-ff298e913b57" name="txt_FinalText" type="Data"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bb42f6e5-8547-4f9e-a3e0-ba269c2f036f" name="in_NumberCountRequired" type="Data"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="-240" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="04a998e0-e8db-4076-89bc-9f435fb65b46" name="in_StartRange" type="Data"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="-165" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="328074c1-b973-423d-81f1-392cfa0e743d" name="in_EndRange" type="Data"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="-165" y="45" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b52b282-7461-461e-99da-b612fab5af37" name="in_Delimiter" type="Data"><subsheetid>38a885d8-65ec-45e7-9f18-eba0e30f3fc1</subsheetid><loginhibit /><display x="-240" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
