CreatedBy" /><output type="text" name="Error_Message" friendlyname="Error_Message" narrative="return failure/error message" stage="txt_ErrorMessage" /></outputs><onsuccess>dad25ec6-187b-48b1-854b-39e7ce8ea21d</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="9c3801e0-0333-40bf-a74e-3fe0f552a0dd" name="Anchor2" type="Anchor"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="15" y="135" w="10" h="10" /><onsuccess>0f474ceb-6d8f-4e32-89ce-049aa6dde9e1</onsuccess></stage><stage stageid="b7f94856-0d6f-4b53-ae96-3c09bd66e00b" name="Build Script" type="Calculation"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="-150" /><onsuccess>5f62051d-21b0-43d2-a31a-03a2de78943a</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$libraryurl = &quot;&amp;Chr(34)&amp;[SP_Target_Lib]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$filename = &quot;&amp;Chr(34)&amp;[File_Name]&amp;Chr(34)&amp;NewLine()&amp;&quot; $libraryurl = $libraryurl.Replace('\','/')&quot;&amp;NewLine()&amp;&quot;if($libraryurl.StartsWith('/')){&quot;&amp;NewLine()&amp;&quot; $libraryurl = $libraryurl.Substring(1,$libraryurl.Length-1)&#xA;}&quot;&amp;NewLine()&amp;&quot; if($libraryurl.EndsWith('/')){&quot;&amp;NewLine()&amp;&quot;$libraryurl = $libraryurl.Substring(0,$libraryurl.Length-1)&#xA;}&quot;&amp;NewLine()&amp;&quot;$libraryurl = $libraryurl+'/'+$filename&quot;&amp;NewLine()&amp;&quot;&#xA;$index =  $libraryurl.IndexOf('/')&quot;&amp;NewLine()&amp;&quot;&#xA;$libraryname = $libraryurl.Substring(0,$index)&quot;&amp;NewLine()&amp; &#xA;&#xA;&#xA;&quot;#Get the Libraries(code 101) , Lists (code 100)&quot;&amp;NewLine()&amp;&quot;&#xA;$ListItems = Get-PnPList | Where-Object {$_.BaseTemplate -eq 101 -and $_.Hidden -eq $false}&quot;&amp;NewLine()&amp;&quot; foreach($list in $ListItems){&quot;&amp;NewLine()&amp;&quot; if($list.DefaultViewURL.ToUpper().Contains(&quot;&quot;/&quot;&quot;+ $libraryname.ToUpper()+&quot;&quot;/&quot;&quot;) -or $list.DefaultViewURL.ToUpper().EndsWith(&quot;&quot;/&quot;&quot;+$libraryname.ToUpper())){&quot;&amp;NewLine()&amp;&quot;$listname = $list.Title&quot;&amp;NewLine()&amp;&quot;break&quot;&amp;NewLine()&amp;&quot;}}&quot;&amp;&quot;if($listname -ne $null){&quot;&amp;NewLine()&amp;&quot; $tobedeleted = Get-PnPFile -Url $libraryurl -AsListItem&quot;&amp;NewLine()&amp;&quot;if($tobedeleted -ne $null){&quot;&amp;NewLine()&amp;&quot;Remove-PnPListItem -List $listname -Identity $tobedeleted.Id -Force&quot;&amp;NewLine()&amp;&quot;}else{&quot;&amp;NewLine()&amp;&quot; throw &quot;&quot;File Not found&quot;&quot;}}&quot;&amp;NewLine()&amp;&quot;else{&quot;&amp;NewLine()&amp;&quot;throw &quot;&quot;List not found&quot;&quot;&#xA;}&quot;" stage="Script" /></stage><stage stageid="b5f6516b-2683-4121-9841-0fbb93029e88" name="Remove / in URL" type="SubSheetInfo"><subsheetid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</subsheetid><narrative>Remove / in URL</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d0e9fdf4-adc7-4f49-8385-acf84e6c56d6" name="Start" type="Start"><subsheetid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</subsheetid><loginhibit /><display x="15" y="-165" /><inputs><input type="text" name="URL" narrative="URL" stage="URL" /></inputs><onsuccess>aa4e1505-0668-48de-af96-a104dce8438f</onsuccess></stage><stage stageid="0088bc66-5c90-40be-a21f-bb0fb618fc7c" name="End" type="End"><subsheetid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</subsheetid><loginhibit /><display x="15" y="150" /><outputs><output type="text" name="URL" narrative="URL" stage="URL" /></outputs></stage><stage stageid="e4651cef-fcca-4889-bcc6-6