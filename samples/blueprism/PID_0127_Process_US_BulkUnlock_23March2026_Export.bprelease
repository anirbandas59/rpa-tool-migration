eetid><display x="-420" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="50fbffd4-7072-4b53-8912-0680d6d962c2" name="SharePoint_Login" type="SubSheetInfo"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><narrative>Initiate force login by clearing the cookies and login by using current user profile.</narrative><display x="-240" y="-165" w="150" h="90" /></stage><stage stageid="4c705480-ac78-40b0-a5df-c5d8b99956de" name="Download attachment from list item" type="SubSheetInfo"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><narrative>action to download an attachment in a specific SP list item</narrative><display x="-270" y="-180" w="150" h="90" /></stage><stage stageid="f094b61a-e9d2-4b6c-b03a-adbdbb9937f0" name="Start" type="Start"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="15" y="-255" /><inputs><input type="text" name="txt_URL" narrative="URL of the SP site" stage="txt_URL" /><input type="text" name="txt_ListName" narrative="ListName of the SP list" stage="txt_ListName" /><input type="number" name="num_ListID" narrative="ID of the list item in SP list" stage="num_ListID" /><input type="text" name="txt_FolderPath" narrative="Location to drop the downloaded file" stage="txt_FolderPath" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /><input type="text" name="Script_Location" narrative="(optional) Location to store temporary PowerShell file" stage="Script_Location" /></inputs><onsuccess>88883b65-bd7d-4741-ad4a-5f7be346ef56</onsuccess></stage><stage stageid="f62cec4b-1031-4ba3-983b-653fdd02826a" name="End" type="End"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="15" y="405" /><outputs><output type="text" name="Success Message" narrative="Success Message" stage="Run Report" /><output type="text" name="Error Message" narrative="Contains errors captured in the powershell" stage="txt_ErrorMsg" /></outputs></stage><stage stageid="4a05ac51-1531-4248-b8c1-d6be94d0a4df" name="Build script" type="Calculation"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><narrative>"$WarningPreference ="&amp;Chr(34)&amp;"SilentlyContinue"&amp;Chr(34)&amp;""&amp;NewLine()&amp;"</narrative><display x="15" y="-120" /><onsuccess>2c6f6f10-f910-4482-8430-539718296538</onsuccess><calculation expression="&quot;$WarningPreference =&quot;&amp;Chr(34)&amp;&quot;SilentlyContinue&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [txt_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$listitem = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [txt_ListName] &amp; Chr(34) &amp;  &quot;-Id &quot; &amp; [num_ListID] &amp; NewLine() &amp;  &quot;$attachments = ForEach-Object{Get-PnPProperty -ClientObject $listitem -Property &quot; &amp; Chr(34) &amp; &quot;AttachmentFiles&quot; &amp; Chr(34) &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;$attachments | ForEach-Object { Get-PnPFile -Url $_.ServerRelativeUrl -FileName $_.FileName -Path &quot; &amp; Chr(34) &amp; [txt_FolderPath] &amp; Chr(34) &amp; &quot; -AsFile}&quot;" stage="txt_PnPScript" /></stage><stage stageid="996b079d-91c2-4618-9407-9dc5d587fc2a" name="txt_PnPScript" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-300" y="-75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab026cd1-cba1-4a8e-8b0d-5a6fb81a18e7" name="txt_URL" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-285" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a27652a-0dde-48b6-9d25-354099cae797" name="txt_ListName" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-360" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="75fb9d9e-aeb4-4e42-8ade-62a2691c74cf" name="num_ListID" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-360" y="-30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ebeadd5-666f-440b-aad8-fae8e1ff9fe4" name="txt_FolderPath" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-300" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d3fda0d3-6a8d-4120-a42f-30ae0922fd9d" name="Input" type="Block"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="-405" y="-105" w="210" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ad85a0e5-2fea-47af-aa97-60ac78614b66" name="txt_ErrorMessage" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-300" y="135" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3488f8ba-7e88-43a1-ad06-2fac3106a8a5" name="txt_ScriptPath" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-300" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="11fd3453-8e38-46d7-9b92-302e30b27096" name="Output" type="Block"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="-405" y="75" w="210" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2d77d7c3-48a1-4ff9-8c96-7daeba1cf489" name="txt_ErrorMsg" type="Data"><subsheetid>376867eb-4829-4c13-