value /><private /><alwaysinit /></stage><stage stageid="b950981f-5cda-4796-b134-cf36ee3b98ed" name="ProcessExist?" type="Decision"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="255" /><decision expression="[Exists]=True" /><ontrue>2c210d73-17dc-464d-8fe2-a8e4ab714034</ontrue><onfalse>984bd6e5-6b5d-4077-8d5b-77c818ebedac</onfalse></stage><stage stageid="179e1c21-6630-43ae-8a42-e23d89198df6" name="Temp_Retry" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-270" y="285" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="984bd6e5-6b5d-4077-8d5b-77c818ebedac" name="Anchor8" type="Anchor"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="195" y="255" w="10" h="10" /><onsuccess>67036341-0915-422c-805c-d1d68e4cf100</onsuccess></stage><stage stageid="2c210d73-17dc-464d-8fe2-a8e4ab714034" name="Kill Process" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="300" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>8c83a6e8-2251-469b-9922-d4cba00e641c</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="67036341-0915-422c-805c-d1d68e4cf100" name="Anchor9" type="Anchor"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="195" y="360" w="10" h="10" /><onsuccess>8c83a6e8-2251-469b-9922-d4cba00e641c</onsuccess></stage><stage stageid="20134306-4db4-4170-8a68-f03e756a70f5" name="Run_Status" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-330" y="225" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2dc18ff2-38cf-4aa4-ba53-59fe047340a8" name="Error_Message" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-450" y="420" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0b2ff36-170b-4f15-90c1-17a15b376f7e" name="Unexpected exception recover" type="Recover"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="420" y="150" /><onsuccess>e234edee-0c13-427a-a993-fa39e1b3c5cb</onsuccess></stage><stage stageid="bedcf681-99eb-452f-8977-70b9b3ff6fdf" name="Unexpected Exception" type="Exception"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="570" y="150" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="35056a2f-a611-4366-9203-cc8a7e626c99" name="Script_Loc" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-270" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e234edee-0c13-427a-a993-fa39e1b3c5cb" name="Delete_Script" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="495" y="150" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>bedcf681-99eb-452f-8977-70b9b3ff6fdf</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="43e11505-3f4f-4d82-8c36-8f3efb3f62dc" name="Validate Temp Script Path" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="-105" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>bf699542-d536-4d1a-9dbe-5c6d2158bd30</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="b562fc00-7af5-49be-9c5c-bc4c801ca152" name="Library Name" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-435" y="225" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6b344ef-c6bc-425a-a0de-680e4cdb74b6" name="Make changes" type="MultipleCalculation"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="0" /><onsuccess>412fd076-4280-427b-8cbb-f1e747efa29c</onsuccess><steps><calculation expression="Replace([Script], &quot;___RPA_LIBRARYNAME___&quot;, [Library Name])" stage="Script" /><calculation expression="Replace([Script], &quot;___RPA_LIBRARYPATH___&quot;, [SP_Lib_Folder_Path])" stage="Script" /></steps></stage><stage stageid="620a5b59-f89a-499c-b59b-93006bd4b3f7" name="Delete_Script" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="135" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>96805e6f-324d-4a11-afa7-daf9f347b882</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="2bd04759-6431-4486-a836-b2859435809c" name="Delete_Script" type="Action"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="240" y="180" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>a36a283b-251c-4526-aaa3-34daa4e0e59a</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="d7e67637-7125-40ac-b522-6fc63a99968f" name="Delete_Script" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="285" y="90" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3f40da45-acaf-41b8-a8ab-5f16b599b8c9</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="5960732a-e83a-487e-a4c2-1fea650ab344" name="Upload File without FSO Access with single Metadata" type="SubSheetInfo"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>It will upload the file without FSO access and  will updates  the single  metadata with provided value.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="991f47f6-b4e5-401b-ac5c-6b752727b1de" name="Start" type="Start"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without FSO access  and updates Metadata value given</narrative><display x="90" y="-285" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Library Name" narrative="Library name in Sharepoint" stage="Library Name" /><input type="text" name="FieldValue" narrative="Metadata value" stage="FieldValue" /><input type="text" name="FieldName" narrative="Metdata Column name" stage="FieldName" /></inputs><onsuccess>240a4d86-5f8a-4be3-802f-a5029627bb93</onsuccess></stage><stage stageid="3f407478-1d64-4b92-af33-0a80d1f9851b" name="End" type="End"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="420" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="40dc1194-9043-4c80-bcda-16b4ea81f3c9" name="Return Message" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-300" y="420" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c533714-5bf6-44a9-b976-21f9545020af" name="Build Script" type="Calculation"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="-60" /><onsuccess>843f4c23-1d43-4ee8-b818-9c27af4116d8</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$SourceFile=&quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FileStream = ([System.IO.FileInfo] (Get-Item $SourceFile)).OpenRead()&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx = Get-PnPContext&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($ctx.web);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$lists = $ctx.web.lists;$ctx.load($lists);$ctx.executequery();$myList = $lists | Where-Object{$_.Title -match '___RPA_LIBRARYNAME___'}&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile = new-object Microsoft.SharePoint.Client.fileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.OverWrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.ContentStream = $FileStream&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$newFile.Url = $ctx.web.url + &quot;&amp;Chr(34)&amp;&quot;___RPA_LIBRARYPATH___&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;&#xA;$addFile = $myList.RootFolder.Files.Add($newFile)&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem = $addFile.ListItemAllFields&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem[&quot;&amp;&quot;&quot;&quot;&quot;&amp;[FieldName]&amp;&quot;&quot;&quot;&quot;&amp;&quot;]=&quot;&quot;&quot;&amp;[FieldValue]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem.Update()&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$ctx.load($addFile);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$FileStream.Close()&quot;" stage="Script" /></stage><stage stageid="71fde886-fb7a-49d9-9141-7348edc6795c" name="Script" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="364e4f9d-e93d-4f70-a33f-8d35acf8fe1c" name="SP_Site_URL" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>Link for site or subsite.</narrative><display x="-450" y="210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="78ed1832-35b4-4613-a8c5-dffa8e4349f9" name="SP_Lib_Folder_Path" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-450" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b272951-4eda-4dac-90eb-925f05618520" name="FilePath" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>File Location to upload the file.</narrative><display x="-450" y="300" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27aa4108-618f-4c12-8892-b536b3227914" name="Run PnP_Script" type="SubSheet"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="150" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>517f95c6-6275-4ac2-bb63-0f6d19825347</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="32ac1eb3-a027-45e0-9ec3-68c5c8c4eed2" name="Note3" type="Note"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

