d>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-255" y="-75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f9c8ae6a-e84b-424e-880c-0b7c1f2cfc95" name="SP_Site_URL" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><narrative>Link for site or subsite.</narrative><display x="-375" y="-90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7989b563-d187-4ce4-8e0c-68541ed47ff1" name="SP_Folder_Source" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><narrative>Path for Library til the subfolder level where the file is located in SP</narrative><display x="-375" y="-60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b4a7afe9-6024-48cc-a0ba-3aeab8e84953" name="FileName" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><narrative>File Location to upload the file.</narrative><display x="-375" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9bf8b752-c8bc-44d2-8de2-a993dfa742ee" name="Note3" type="Note"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><narrative>FileName: Test.xlsx

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

SP_Folder_Source: Includes Library and sub folder ( Example:- Documents/FO/Data)

SP_Folder_Destination: Includes Library and sub folder ( Example:- /sites/AAAAA3201/Documents/FO/Data/Test)

****************************************************************************************************
Considering the file from "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data/Test.xlsx" will be moved to "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data/Test)</narrative><display x="-300" y="-240" w="300" h="240" /></stage><stage stageid="c48297c1-a032-4bf9-ba75-0f29d1ee37d3" name="Script Path" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-270" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="18da2f61-fedd-4afe-842f-da2f1b4381a2" name="Input" type="Block"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-435" y="-105" w="120" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e5dca44c-e507-4483-ad1b-6f7a693eb5dc" name="Output" type="Block"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-435" y="45" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="16c7be2a-91bd-4e7a-89c3-9a6a015acafe" name="Inhouse" type="Block"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-300" y="-105" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9158f429-523b-4f04-a7dd-8b709200a6fc" name="Exists" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-225" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35004027-3198-463f-a420-640840c1a379" name="Temp_Retry" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-210" y="45" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="fe4b30d5-c49f-4987-9c33-316510045257" name="Run_Status" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-270" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bb60488d-1bd6-43fc-a842-8ff32ac9b274" name="Error_Message" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-390" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b02e8d09-c48e-4f04-be8a-c42242562a1f" name="Script_Loc" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="-210" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="230e78cd-d502-420e-8407-55f2f5535a57" name="SP_Folder_Destination" type="Data"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded started from /sites in SP</narrative><display x="-375" y="-30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="64d9a05d-c58b-4760-acfb-5ab6d0188694" name="End" type="End"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="15" y="150" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="53149ca5-efe0-4815-b107-fe241dfe2c65" name="Build Script" type="Calculation"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="15" y="-270" /><onsuccess>26bb2402-a626-4fbe-9b16-a533bcc830f2</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;Move-PnPFile -SiteRelativeUrl &quot; &amp; Chr(34) &amp; [SP_Folder_Source] &amp;  &quot;/&quot; &amp; [FileName] &amp; Chr(34) &amp; &quot; -TargetUrl &quot; &amp; Chr(34) &amp; [SP_Folder_Destination] &amp; &quot;/&quot; &amp; [FileName] &amp; Chr(34) &amp; &quot; -Overwrite -Force&quot;&#xA;" stage="Script" /></stage><stage stageid="85cd670c-9428-4e45-824a-31923fc731f4" name="Run PnP_Script" type="SubSheet"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="15" y="-120" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>0c2bf673-5d0c-418d-8a1e-ef14669c0800</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="089bb38e-c4f1-4204-acdb-477875710e22" name="Delete_Script" type="Action"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="15" y="90" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>64d9a05d-c58b-4760-acfb-5ab6d0188694</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="26bb2402-a626-4fbe-9b16-a533bcc830f2" name="Generate_PnPScript" type="SubSheet"><subsheetid>9b9563be-f9de-4ee0-a5d5-2dabe252d10c</subsheetid><display x="15" y="-225" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[