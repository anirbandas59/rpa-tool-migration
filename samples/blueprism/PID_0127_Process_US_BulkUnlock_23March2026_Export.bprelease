387d</onsuccess><steps><calculation expression="ExceptionDetail()" stage="Exception Detail" /><calculation expression="ExceptionType()" stage="Exception Type" /></steps></stage><stage stageid="f4363a72-c706-4f2f-80eb-ce94517a2dd2" name="Correct Collection for Comma" type="LoopStart"><subsheetid>0cb78916-8a2f-49bc-937f-a4df839669a5</subsheetid><loginhibit /><display x="105" y="315" /><onsuccess>9c72b8d2-3920-4db5-8b9a-96793c9b0233</onsuccess><groupid>fd7d1091-d0ab-466a-994d-44eee1368667</groupid><looptype>ForEach</looptype><loopdata>List_Of_Files</loopdata></stage><stage stageid="bdd3d583-f4b8-4d12-9f92-284041a5707f" name="Correct Collection for Comma" type="LoopEnd"><subsheetid>0cb78916-8a2f-49bc-937f-a4df839669a5</subsheetid><loginhibit /><display x="105" y="405" /><onsuccess>74f4e254-b553-4f8e-96d6-ca3e1833008e</onsuccess><groupid>fd7d1091-d0ab-466a-994d-44eee1368667</groupid></stage><stage stageid="9c72b8d2-3920-4db5-8b9a-96793c9b0233" name="Revert The Comma" type="Calculation"><subsheetid>0cb78916-8a2f-49bc-937f-a4df839669a5</subsheetid><loginhibit /><display x="105" y="360" /><onsuccess>bdd3d583-f4b8-4d12-9f92-284041a5707f</onsuccess><calculation expression="Replace(  [List_Of_Files.File Name], &quot;__Comma__&quot;, &quot;,&quot;)" stage="List_Of_Files.File Name" /></stage><stage stageid="f4a78456-32ca-47b5-9a43-eadccc270b7e" name="Transfer to Collection" type="Action"><subsheetid>0cb78916-8a2f-49bc-937f-a4df839669a5</subsheetid><loginhibit /><display x="15" y="315" /><inputs><input type="text" name="CSV" narrative="The CSV to be converted into a collection" expr="[Txt_FromRPATxtBox]" /><input type="flag" name="First Row Is Header" narrative="Indicates whether the first row of the CSV file should be treated as headers" expr="True" /><input type="collection" name="Schema" narrative="Optional. A collection of column names. If left blank the column names will be taken from the first row. " expr="[Structure]" /></inputs><outputs><output type="collection" name="Out