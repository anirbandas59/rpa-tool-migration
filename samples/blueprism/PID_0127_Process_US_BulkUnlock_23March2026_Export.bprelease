"Name of the oldest file in the specified folderq" stage="FileName" /></outputs></stage><stage stageid="2731b636-2005-41dc-97ab-c8f6f77fdfa8" name="User Name" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c63af18f-25b7-4eea-a66a-96614274faef" name="Count" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="120" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c592a196-6c01-402c-a412-e5a4ac5b1822" name="Extract Filename" type="MultipleCalculation"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="285" w="90" h="30" /><onsuccess>2e6263c7-4125-4cba-b9ad-75b39ec6b433</onsuccess><steps><calculation expression="InStr([Run Report], &quot;FILE NAME:  &quot;)+Len(&quot;FILE NAME:  &quot;)" stage="NameStartPoint" /><calculation expression="Mid([Run Report],[NameStartPoint], Len([Run Report]) - [NameStartPoint])" stage="FileName" /></steps></stage><stage stageid="78dbf523-77ae-4842-b54c-12d4459327d2" name="NameStartPoint" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="150" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ba86c75c-cf80-4279-af77-dfba3fa9c2d2" name="FileName" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-195" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f08c73a8-1596-4945-8dea-37a21469746b" name="Block10" type="Block"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-60" y="-120" w="255" h="435" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="76095ce3-25f1-4759-a557-22dcaa68cb5f" name="Block11" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-60" y="-120" w="255" h="420" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ec797894-8845-4157-ad5d-9c3f6342209a" name="Get MetaData Of File" type="SubSheetInfo"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><narrative>For a given Filer, all the metadata (specified in the input collection) are extracted and sent as output collection

To know what are the internal field names in Sharepoint use "GetField_InternalName" page</narrative><display x="-405" y="-270" w="180" h="90" /></stage><stage stageid="1586dfe5-1a76-4ce2-812e-9956eeb9ec82" name="Start" type="Start"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-450" /><inputs><input type="collection" name="Column_names" narrative="Collection of all header/ fields need to be extracted." stage="Field_Names" /><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="File Path" narrative="Complete Path of the file to extract Metadata for" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /></inputs><onsuccess>978ff6cd-8e12-455e-9d9b-114dc159c12b</onsuccess></stage><stage stageid="80c37908-143e-4994-9903-abc151ae8a91" name="Build Script" type="Calculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="-45" w="90" h="30" /><onsuccess>1be6784b-8ea3-4675-a07b-9e8000f3e260</onsuccess><calculation expression="&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$items=( Get-PnPFile -Url $SourceName -AsListItem -ErrorAction Stop -WarningAction silentlyContinue) &quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount= $items.Count&quot; &amp; NewLine() &amp;&#xA;&#xA;&quot;if ($itemsCount -gt 0) {&quot; &amp; NewLine() &amp;&#xA;&quot;$FieldList= &quot; &amp;[Field_Qry] &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;Metadata- $FieldList&quot; &amp; Chr(34) &amp; NewLine() &amp;&#xA;&quot;}&quot; &amp; NewLine() &amp;&#xA;&quot;Else{&quot;&amp; NewLine() &amp;&#xA;&quot;Throw(&quot; &amp;Chr(34)&amp; &quot;File not found to extract Metadata&quot; &amp; Chr(34) &amp;&quot;)&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;" stage="Script" /></stage><stage stageid="4f875140-17c2-4991-92f4-928206eb8c26" name="Run PnP_Script" type="SubSheet"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="45" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>9b5b9cce-e72f-4d6e-9e1b-7d931ab56cf1</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d7b48a78-1439-4e31-b2c2-76def6423b9f" name="Delete_Script" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="180" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>f11a377e-513a-430c-96d8-f26a9e15d24b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="1be6784b-8ea3-4675-a07b-9e8000f3e260" name="Generate_PnPScript" type="SubSheet"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-45" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;MetaData&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>96e02a43-5bed-49bd-b71e-5bea65a3b945</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="96e02a43-5bed-49bd-b71e-5bea65a3b945" name="Check_Error" type="Decision"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="0" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>6e1e9024-b760-439c-854e-f037442e6359</ontrue><onfalse>4f875140-17c2-4991-92f4-928206eb8c26</onfalse></stage><stage stageid="6e1e9024-b760-439c-854e-f037442e6359" name="Exception while creating  Script" type="Exception"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="390" y="0" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="3729dcac-8c9e-42ca-8b66-e620f59fb52e" name="Check Process_Exist" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="135" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>eee25d0c-4511-4d0e-86e9-5c45b1bc5de3</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage 