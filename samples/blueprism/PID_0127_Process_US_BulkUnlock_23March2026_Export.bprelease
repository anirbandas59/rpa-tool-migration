name="Exception1" type="Exception"><display x="675" y="-90" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="134cdd45-9d02-4f6b-b38e-8395513774ff" name="Exception1" type="Exception"><display x="645" y="30" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="ce36a6bb-50d0-49f6-9cae-d0d05b0b989c" name="Stop?" type="Decision"><display x="1155" y="840" w="90" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><decision expression="IsStopRequested()" /><ontrue>6d5d6b99-5f71-4ff0-aa1a-2a838b4a9f91</ontrue><onfalse>1d002d4f-7111-403e-a20f-c8234e796bd0</onfalse></stage><stage stageid="fe01bf1d-c377-43e4-8dc5-f2d14d2fca48" name="Anchor8" type="Anchor"><subsheetid>bf57723b-f31f-465f-a44d-6b23e78fd2de</subsheetid><display x="450" y="-45" w="10" h="10" /><onsuccess>3681d73d-3222-4945-a6ab-f4c6d17eaa4c</onsuccess></stage><stage stageid="d2fe91ae-8fd6-49e4-9db1-9e164b2fa7d8" name="Anchor11" type="Anchor"><subsheetid>d64a5c4d-aa8a-4bbf-afdd-577c303c37fb</subsheetid><display x="450" y="-45" w="10" h="10" /><onsuccess>35e351f4-e706-42c7-83eb-959d7467356a</onsuccess></stage><stage stageid="667d1689-394b-4822-ae50-8178d5eb8b15" name="Size" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-270" y="270" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b318cfe0-0c81-4e00-aaf1-690eebba887a" name="Previous Size" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-285" y="315" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="24eff825-0d45-4407-8148-b29f1b2421f2" name="WithSIMAAS" type="Data"><loginhibit onsuccess="true" /><display x="-735" y="240" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$outputfile= "_RPA_outputfile_RPA_"
$SourceName= "_RPA_SourceName_RPA_"
$baseURL = "_RPA_baseURL_RPA_"
$temp = ""
Connect-PnPOnline -SPOManagementShell -Url $baseURL
if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }
Else{ New-Item $outputfile -ItemType File -ErrorAction stop }
Add-Content  $outputfile -Value "File ID__RPA__File Name__RPA__Relative Path"
Get-PnPListItem -List $SourceName -Fields("FSObjType","ID","FileLeafRef","FileDirRef").FieldValues -PageSize 500 -ScriptBlock { Param($items) foreach($itm in $items) { if($itm.FieldValues["FSObjType"] -eq "0"){ $str = $itm.FieldValues["ID"].ToString() + "__RPA__" + $itm.FieldValues["FileLeafRef"] + "__RPA__" +   $itm.FieldValues["FileDirRef"] ;  Add-Content  $outputfile $str ;  } } }</initialvalue><private /><alwaysinit /></stage><stage stageid="8055210d-5dbb-4cfe-8986-349b9904a989" name="WithOutSIMAAS" type="Data"><loginhibit onsuccess="true" /><display x="-780" y="285" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$outputfile= "_RPA_outputfile_RPA_"
$SourceName= "_RPA_SourceName_RPA_"
$baseURL = "_RPA_baseURL_RPA_"
$temp = ""
Connect-PnPOnline -Url $baseURL -UseWebLogin
if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }
Else{ New-Item $outputfile -ItemType File -ErrorAction stop }
Add-Content  $outputfile -Value "File ID__RPA__File Name__RPA__Relative Path"
Get-PnPListItem -List $SourceName -Fields("FSObjType","ID","FileLeafRef","FileDirRef").FieldValues -PageSize 500 -ScriptBlock { Param($items) foreach($itm in $items) { if($itm.FieldValues["FSObjType"] -eq "0"){ $str = $itm.FieldValues["ID"].ToString() + "__RPA__" + $itm.FieldValues["FileLeafRef"] + "__RPA__" +   $itm.FieldValues["FileDirRef"] ;  Add-Content  $outputfile $str ;  } } }</initialvalue><private /><alwaysinit /></stage><stage stageid="ebe87586-1738-436c-b171-0373ae16af9a" name="IsSIMAAS?" type="Decision"><display x="30" y="300" /><decision expression="Upper(Trim([ConfigFileData.IsSIMAAS] )) = &quot;TRUE&quot;" /><ontrue>ed7b7ea5-1fdf-4691-a29e-dd5cad6643ff</ontrue><onfalse>9e06ecbb-9377-46b3-bd56-2490122c5438</onfalse></stage><stage stageid="ed7b7ea5-1fdf-4691-a29e-dd5cad6643ff" name="AssignWithSIMAS" type="Calculation"><loginhibit onsuccess="true" /><display x="30" y="375" /><onsuccess>d1a44ce8-0ff9-4147-b40d-86ff1a8bf8ef</onsuccess><calculation expression="[WithSIMAAS]" stage="PowerShellGetAllFile_Template" /></stage><stage stageid="9e06ecbb-9377-46b3-bd56-2490122c5438" name="AssignWithOutSIMAS" type="Calculation"><loginhibit onsuccess="true" /><display x="120" y="300" /><onsuccess>d1a44ce8-0ff9-4147-b40d-86ff1a8bf8ef</onsuccess><calculation expression="[WithOutSIMAAS]" stage="PowerShellGetAllFile_Template" /></stage><stage stageid="d1a44ce8-0ff9-4147-b40d-86ff1a8bf8ef" name="Anchor12" type="Anchor"><loginhibit onsuccess="true" /><display x="120" y="375" w="10" h="10" /><onsuccess>aaaeec8c-a2df-4b32-8c23-ceb0a8f008b1</onsuccess></stage><stage stageid="384b0f0f-6971-4eb4-9ce0-d0ad49b03276" name="WaitTimeForFileSize" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="90" y="-180" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d450c6ad-427e-4bdb-9a86-c54e6779b329" name="Clear Txt" type="Calculation"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><loginhibit /><display x="150" y="615" /><onsuccess>c4443376-a9bc-4280-957f-31f691937407</onsuccess><calculation expression="&quot;&quot;" stage="Txt_FromRPATxtBox" /></stage><stage stageid="84025d55-522d-47cb-a36a-7b680f5732f6" name="Note1" type="Note"><narrative>Stop Bot after completing one item</narrative><display x="660" y="210" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /><onsuccess>458762d9-7dd4-47c0-bbdc-55d193273d9c</onsuccess></stage><stage stageid="ab5b475a-a692-4e97-a2e2-320d3d994767" name="Global JS" type="Data"><loginhibit onsuccess="true" /><display x="-210" y="720" /><datatype>text</datatype><initialvalue xml:space="preserve">
function addElement(){

    var childElement = document.getElementById('RPAtextBox');
    if(childElement){
        childElement.parentNode.removeChild(childElement);
    }
    var body = document.getElementsByTagName('Body')[0];
    var textArea = document.createElement('div');
    textArea.setAttribute('id', 'RPAtextBox');
    textArea.setAttribute('style', 'width:200px');
    body.appendChild(textArea);

}

function getFormDigest(webUrl) {
    return jQuery.ajax({
       url: webUrl + "/_api/contextinfo",
       method: "POST",
       headers: { "Accept": "application/json; odata=verbose" }
   });
}

function createListItem(webUrl, siteUrl, listURL, key , fileName, RelativeURL) {
   var DELIMITER = "__RPA__";
   itemProperties = '{"listUrl":"'+ siteUrl +"/"+ listURL + '","itemId":"' + key + '"}' ; 
   document.getElementById('RPAtextBox').innerText = "";
   return getFormDigest(webUrl).then(function (data) {

       return   jQuery.ajax({
           url: webUrl + "/_api/SP.CompliancePolicy.SPPolicyStoreProxy.UnlockRecordItem()",
           method: "POST",
           data: itemProperties,
           headers: {
               "Content-Type" : "application/json; odata=verbose" ,
               "x-requestdigest": data.d.GetContextWebInformation.FormDigestValue
               
           },
           success:function(){
               //console.log("success:" + fileName);
               document.getElementById('RPAtextBox').innerText =  "Success:" + DELIMITER + key + DELIMITER + fileName + DELIMITER + RelativeURL + "\n";
           },
           error:
           function(xhr, status, error){
               //console.log("Error:" + fileName);
               document.getElementById('RPAtextBox').innerText =  "Error:" + DELIMITER + key + DELIMITER + fileName + DELIMITER + RelativeURL + "\n";
           }
       });
   });
}

</initialvalue><alwaysinit /></stage><stage stageid="faf376d2-ba31-4024-95a8-ac9c0e6897d1" name="Add Element-Invoke" type="Action"><loginhibit onsuccess="true" /><display x="210" y="1095" w="90" h="30" /><inputs><input type="text" name="Function Name" friendlyname="Function Name" narrative="JavaScript Function Name" expr="&quot;createListItem&quot;" /><input type="text" name="Arguments" friendlyname="Arguments" narrative="Arguments" expr="&quot;[&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Item Data.BaseConnection]&amp;&quot;&quot;&quot;&quot;&amp;&quot;,&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Item Data.SiteURL]&amp;&quot;&quot;&quot;&quot;&amp;&quot;,&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Item Data.BaseFolderURL]&amp;&quot;&quot;&quot;&quot;&amp;&quot;,&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Child Item Data.File ID]&amp;&quot;&quot;&quot;&quot;&amp;&quot;,&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Child Item Data.File Name]&amp;&quot;&quot;&quot;&quot;&amp;&quot;,&quot;&amp;&quot;&quot;&quot;&quot;&amp;[Child Item Data.Relative Path]&amp;&quot;&quot;&quot;&quot;&amp;&quot;]&quot;" /></inputs><onsuccess>7d1b2d94-6bab-44d1-99b2-11e4025e3349</onsuccess><breakpoint type="0"><condition></condition></breakpoint><resource object="Utility_Object_Generic_IE_SharePoint_CommonActions - Edge" action="Invoke JS" /></stage><stage stageid="919acd67-c3a1-4802-aef8-629b78ed33a0" name="Block11" type="Block"><loginhibit onsuccess="true" /><display x="885" y="150" w="240" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c6e17335-c119-4cde-b78f-2b7ec389e58f" name="Recover3" type="Recover"><loginhibit /><display x="1065" y="210" /><onsuccess>b305ac38-acb2-4996-91be-11171cfbf552</onsuccess></stage><stage stageid="b305ac38-acb2-4996-91be-11171cfbf552" name="Resume1" type="Resume"><loginhibit /><display x="1035" y="120" /><onsuccess>458762d9-7dd4-47c0-bbdc-55d193273d9c</onsuccess></stage><stage stageid="edd51599-086a-48a9-89a4-60694ed219a3" name="Completed No Outcome" type="SubSheetInfo"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>This page can be used to check if the current exception belongs to 'Completed Without Outcome' category

</narrative><display x="15" y="-240" w="180" h="60" /></stage><stage stageid="6b7533f9-da07-412c-9b93-dedbb6070f7c" name="Start" type="Start"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="330" y="-255" /><inputs><input type="text" name="Exception Type" narrative="Exception Type : Ex: SYSTEM EXCEPTION" stage="txt_Exception Type" /><input type="text" name="Completed without outcome msgs" narrative="Config file data to split based on the exception details" stage="Completed without outcome msgs" /></inputs><onsuccess>1b589273-e329-4808-b855-9b7af5aadc22</onsuccess></stage><stage stageid="c78c60ad-c3b7-49f5-a8b2-ca3022ae17b5" name="End" type="End"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="240" y="45" /></stage><stage stageid="1b589273-e329-4808-b855-9b7af5aadc22" name="Split Completed Wo Outcome Rules" type="Action"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="330" y="-195" /><inputs><input type="text" name="Text to Split" friendlyname="Text to Split" narrative="The text to split" expr="[Completed without outcome msgs]" /><input type="text" name="Split Char" friendlyname="Split Char" narrative="The split delimiter" expr="&quot;,&quot;" /><input type="text" name="Collection Field Name" friendlyname="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Exception&quot;" /></inputs><outputs><output type="collection" name="Split Values" friendlyname="Split Values" narrative="The resulting collection containing the split values" stage="coll_Exceptions" /></outputs><onsuccess>3e53fde3-db16-4ea2-ad16-b91b941972f9</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="a1ff07d0-ff08-4569-bec3-3a678958eec2" name="Check If Rule Is Found" type="Action"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="330" y="-75" /><inputs><input type="collection" name="Collection" friendlyname="Collection" narrative="Required : The collection to search" expr="[coll_Exceptions]" /><input type="text" name="Column Name" friendlyname="Column Name" narrative="Required : The name of the column to search" expr="&quot;Exception&quot;" /><input type="text" name="Exact Value" friendlyname="Exact Value" narrative="Optional : The exact value to search for - this is case insensitive" expr="[txt_Exception Detail]" /><input type="text" name="Regex" friendlyname="Regex" narrative="Optional : The regular expression to search for - this is case sensitive unless specified otherwise in the regular expression using &quot;(?i)&quot;" expr="" /></inputs><outputs><output type="flag" name="Contains Search Term" friendlyname="Contains Search Term" narrative="Flag indicating if the collection found the given search term or not" stage="flg_Contains Search Term" /><output type="collection" name="Groups" friendlyname="Groups" narrative="The groups defined in the regular expression when it is applied to the found term" stage="" /></outputs><onsuccess>931a2b8c-d69f-435a-ae71-aa7a23f711a1</onsuccess><resource object="Utility - Collection Manipulation_Extended" action="Collection Contains Value" /></stage><stage stageid="69016af0-e418-4056-9ad3-5fa12041feed" name="flg_Contains Search Term" type="Data"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="15" y="-135" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="931a2b8c-d69f-435a-ae71-aa7a23f711a1" name="Completed Without Outcome" type="Decision"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="330" y="-15" /><decision expression="[flg_Contains Search Term]" /><ontrue>63032abc-c2ad-482f-a159-751cd593c4e9</ontrue><onfalse>589bc7f1-d044-4780-bb05-fb1f2dcbca6f</onfalse></stage><stage stageid="63032abc-c2ad-482f-a159-751cd593c4e9" name="Set Status" type="Action"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="240" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Child ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;COMPLETED WITHOUT OUTCOME&quot;" /></inputs><onsuccess>c78c60ad-c3b7-49f5-a8b2-ca3022ae17b5</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="589bc7f1-d044-4780-bb05-fb1f2dcbca6f" name="Set Status" type="Action"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="330" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Child ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[txt_Exception Type]" /></inputs><onsuccess>c78c60ad-c3b7-49f5-a8b2-ca3022ae17b5</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="a4f80d7e-d6d2-428c-bb7f-0c8f9948b00c" name="Variables" type="Block"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="-195" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="02543b84-f2a6-4f66-b5e4-d078979701f1" name="Completed without outcome" type="Decision"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="150" y="-15" /><decision expression="InStr([txt_Exception Detail],[coll_Exceptions.Exception])&gt;0" /><ontrue>63032abc-c2ad-482f-a159-751cd593c4e9</ontrue><onfalse>21553bf5-97f7-41a3-a424-48dbdbb896fb</onfalse></stage><stage stageid="2c5b238c-c4ef-460a-9182-3dfbcc58ae39" name="Exceptions" type="LoopStart"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="150" y="-75" /><onsuccess>02543b84-f2a6-4f66-b5e4-d078979701f1</onsuccess><groupid>44d2197a-0be7-4295-af55-11578647d55a</groupid><looptype>ForEach</looptype><loopdata>coll_Exceptions</loopdata></stage><stage stageid="21553bf5-97f7-41a3-a424-48dbdbb896fb" name="Exceptions" type="LoopEnd"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="150" y="45" /><onsuccess>51b258e5-a0c3-4f50-9db4-f7584a811745</onsuccess><groupid>44d2197a-0be7-4295-af55-11578647d55a</groupid></stage><stage stageid="e21b8ecd-6deb-4a20-a8fc-bca7563d8a9e" name="Aprox Match                      /                        Exact Match" type="Block"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="120" y="-225" w="330" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="72d1e882-c142-4389-8163-1fa07a6f158a" name="Note10" type="Note"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>If the recieved Exception is not an exact match with the one present in the Config file, this logic can be used

After Split Text action, Link it to this Block
</narrative><display x="45" y="-15" w="90" h="150" /><font family="Segoe UI" size="10" style="Bold" color="008000" /></stage><stage stageid="51b258e5-a0c3-4f50-9db4-f7584a811745" name="Anchor5" type="Anchor"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="150" y="105" w="10" h="10" /><onsuccess>f3ad7ac3-3b85-43b6-b4c1-5f23f92ec11b</onsuccess></stage><stage stageid="f3ad7ac3-3b85-43b6-b4c1-5f23f92ec11b" name="Anchor6" type="Anchor"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="330" y="105" w="10" h="10" /><onsuccess>589bc7f1-d044-4780-bb05-fb1f2dcbca6f</onsuccess></stage><stage stageid="c9a0ee03-6bc6-4689-9b40-d518dea3fc86" name="Note12" type="Note"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>Storing 'Completed Without Outome' messages in Config file is the recommended approach.
If you want to use a different approach, please connect with the QA reviewer to explain your Strategy.</narrative><display x="675" y="-195" w="390" h="60" /><font family="Segoe UI" size="10" style="Bold" color="008000" /><onsuccess>1b589273-e329-4808-b855-9b7af5aadc22</onsuccess></stage><stage stageid="a601e6cc-17d9-4d7c-8942-49e7cd32dc41" name="Recover" type="Recover"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit /><display x="420" y="45" /><onsuccess>94726464-4127-4d58-b1e7-0298b9bbc44d</onsuccess><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="94726464-4127-4d58-b1e7-0298b9bbc44d" name="Resume" type="Resume"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit /><display x="510" y="45" /><onsuccess>a56429b6-b098-4709-a9db-6edfe51415d3</onsuccess></stage><stage stageid="1d2e0f73-d462-429d-bf90-24e6873790f8" name="End8" type="End"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="510" y="165" /></stage><stage stageid="a56429b6-b098-4709-a9db-6edfe51415d3" name="Set Status" type="Action"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="510" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Child ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[txt_Exception Type]" /></inputs><onsuccess>1d2e0f73-d462-429d-bf90-24e6873790f8</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="2c4f0f6f-c2f6-422c-b33c-e82e7dffdad9" name="Note12" type="Note"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><narrative>The list of Completed without Outcome Messages are stored in the Config file
We are checking if the obtained exception for the Current Item matches with the One in the list.
Please note that this logic needs an exact match </narrative><display x="675" y="-75" w="390" h="60" /><font family="Segoe UI" size="10" style="Bold" color="008000" /><onsuccess>a1ff07d0-ff08-4569-bec3-3a678958eec2</onsuccess></stage><stage stageid="3e53fde3-db16-4ea2-ad16-b91b941972f9" name="Exact Match Logic Followed" type="Decision"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="330" y="-135" /><decision expression="[flg_CompletedWithoutOutcomeExactMatchLogic]" /><ontrue>a1ff07d0-ff08-4569-bec3-3a678958eec2</ontrue><onfalse>0a4c7cc6-bda4-429a-9997-862115b50bff</onfalse></stage><stage stageid="0a4c7cc6-bda4-429a-9997-862115b50bff" name="Anchor2" type="Anchor"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><loginhibit onsuccess="true" /><display x="150" y="-135" w="10" h="10" /><onsuccess>2c5b238c-c4ef-460a-9182-3dfbcc58ae39</onsuccess></stage><stage stageid="ec8f5d72-7bd7-489b-885b-079b463ac4a4" name="coll_Exceptions" type="Collection"><subsheetid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</subsheetid><display x="15" y="-165" w="180" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Exception" type="text" /></collectioninfo></stage><stage stageid="85189ad2-76b2-4bb7-a996-2440f26b6a97" name="Not Completed" type="Calculation"><subsheetid>d599353b-a78b-40f4-ab04-255791b86a1a</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-120" /><onsuccess>808cbef2-cfe3-460f-ba72-91e0e6283988</onsuccess><calculation expression="False" stage="flg_IsCompleted" /></stage><stage stageid="f291c522-86c2-4871-bed3-d9772203d937" name="Reset Global Data" type="SubSheetInfo"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><loginhibit onsuccess="true" /><narrative>This page is only used to reset global data items</narrative><display x="-150" y="-90" w="180" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="b16161c1-1572-4b2d-a278-fba3b9d5a9b2"