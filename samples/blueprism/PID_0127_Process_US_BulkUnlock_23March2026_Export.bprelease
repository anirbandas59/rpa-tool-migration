<subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="75" w="180" h="30" /><datatype>flag</datatype><initialvalue /><alwaysinit /></stage><stage stageid="4eaa5fca-0ff7-484d-8695-7f5f3fee8e5f" name="datetm_Loaded DateTime" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="135" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><alwaysinit /></stage><stage stageid="f06000cf-f231-4fc9-8856-1f9b9512e67b" name="datetm_Exception DateTime" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="105" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><alwaysinit /></stage><stage stageid="44304c85-db2e-4532-84a9-9b726e22a80d" name="txt_ItemKey" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="165" w="180" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="0912a2d5-4850-464b-8fcf-5f3df75beb5f" name="datetm_Completed DateTime" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="195" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><alwaysinit /></stage><stage stageid="e39ace0c-260e-48cb-bcf7-a02d585fff6b" name="tmspan_Worktime" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="225" w="180" h="30" /><datatype>timespan</datatype><initialvalue>0.00:00:00</initialvalue><alwaysinit /></stage><stage stageid="8b504ca6-5cf8-4d0c-a759-e81ae96624a5" name="datetm_InputReceivedOn" type="Data"><subsheetid>1a2702d0-5106-411d-9d8e-d854f2ba039f</subsheetid><display x="-360" y="255" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><alwaysinit /></stage><stage stageid="c5ceb352-ed0d-40b4-8877-fbe6e02b92a1" name="Completed No Outcome" type="SubSheet"><subsheetid>d599353b-a78b-40f4-ab04-255791b86a1a</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="165" /><inputs><input type="text" name="Exception Type" friendlyname="Exception Type" narrative="Exception Type : Ex: SYSTEM EXCEPTION" expr="&quot;SYSTEM EXCEPTION&quot;" /><input type="text" name="Completed without outcome msgs" friendlyname="Completed without outcome msgs" narrative="Config file data to split based on the exception details" expr="[Completed without outcome msgs]" /></inputs><onsuccess>5e858612-1974-421a-a45d-a1bb078456ce</onsuccess><processid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</processid></stage><stage stageid="d58b4f07-eb5b-41d9-9e5d-fbf2054fc9f6" name="Completed No Outcome" type="SubSheet"><subsheetid>d599353b-a78b-40f4-ab04-255791b86a1a</subsheetid><loginhibit onsuccess="true" /><display x="300" y="-45" /><inputs><input type="text" name="Exception Type" friendlyname="Exception Type" narrative="Exception Type : Ex: SYSTEM EXCEPTION" expr="&quot;BUSINESS EXCEPTION&quot;" /><input type="text" name="Completed without outcome msgs" friendlyname="Completed without outcome msgs" narrative="Config file data to split based on the exception details" expr="[Completed without outcome msgs]" /></inputs><onsuccess>adf4d0f0-74ac-4308-a5b8-a989dd3ad520</onsuccess><processid>bd8dd561-a8b9-46a4-b30b-a05085a465d7</processid></stage><stage stageid="32e86f23-7688-41d6-a681-eb80f3e5b576" name="DataGateway" type="SubSheetInfo"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><narrative>Handle Data Gateway Related Administration</narrative><display x="-195" y="-120" w="150" h="60" /></stage><stage stageid="0d9ebfdc-ab9a-4c37-aeb7-5bbf95d99211" name="Start" type="Start"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><display x="-45" y="-135" /><inputs><input type="text" name="Child Item Status" narrative="Current status of the child item" stage="Chiild_Item_ID" /></inputs><onsuccess>82dbab02-1e67-4629-b4b8-89d5d36a98b2</onsuccess></stage><stage stageid="24f039ae-e8f1-44b5-aca2-69d72546c572" name="End" type="End"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><display x="-45" y="165" /></stage><stage stageid="e95b7cfa-fcce-4f2d-8482-5c6ff3e0260b" name="Get Item Data" type="Action"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><loginhibit onsuccess="true" /><narrative>Get data relating to an item in a queue. You do not need to have a lock on the item to do this.</narrative><display x="-45" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item to get data from. An error will be raised if this item does not exist." expr="[Chiild_Item_ID]" /></inputs><outputs><output type="collection" name="Data" narrative="The data associated with the item - a single collection row." stage="" /><output type="text" name="Status" narrative="The status of the item." stage="txt_Item Status" /><output type="number" name="Attempts" narrative="The number of attempts already made to work this item." stage="" /><output type="text" name="Key" friendlyname="Key" narrative="The key value of the item." stage="txt_ItemKey" /><output type="number" name="Priority" friendlyname="Priority" narrative="The priority of the item" stage="" /><output type="timespan" name="Worktime" friendlyname="Worktime" narrative="The total time spent on this item (including previous attempts)" stage="tmspan_Worktime" /><output type="timespan" name="Attempt Worktime" friendlyname="Attempt Worktime" narrative="The amount of time spent on this particular attempt of the item" stage="" /><output type="datetime" name="Loaded DateTime" friendlyname="Loaded DateTime" narrative="The date and time at which this item was first loaded into the queue." stage="datetm_Loaded DateTime" /><output type="datetime" name="Deferred DateTime" friendlyname="Deferred DateTime" narrative="The date and time at which this item has been deferred to. Empty if this item has not been deferred." stage="" /><output type="datetime" name="Completed DateTime" friendlyname="Completed DateTime" narrative="The date and time at which this item was marked as complete. Empty if this item has not been marked as complete" stage="datetm_Completed DateTime" /><output type="datetime" name="Exception DateTime" friendlyname="Exception DateTime" narrative="The date and time at which this item was marked as an exception. Empty if there has never been an exception on this item." stage="datetm_Exception DateTime" /><output type="text" name="Exception Reason" friendlyname="Exception Reason" narrative="The exception reason recorded against this item." stage="txt_Exception Detail" /><output type="text" name="Tags" friendlyname="Tags" narrative="The semi-colon separated set of tags which apply to the item. " stage="" /></outputs><onsuccess>1f6f9221-86ad-4972-9078-97067ff42520</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Item Data" /></stage><stage stageid="bf9709c1-dde4-4fc4-93c7-1dac1def21f1" name="Data Gateway Completed" type="Action"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="105" /><inputs><input type="text" name="Process Name" friendlyname="Process Name" narrative="Process Name" expr="[txt_FullProcessName]" /><input type="text" name="Item Id" friendlyname="Item Id" narrative="Unique id to investigate from Blue Prism database" expr="[Child ID]" /><input type="text" name="Item Key" friendlyname="Item Key" narrative="Unique id to help business team connect to the transaction" expr="[txt_ItemKey]" /><input type="datetime" name="Input Data Received On" friendlyname="Input Data Received On" narrative="Time when input was available for the bot. Example Email reveived on, Input received from SAP etc." expr="[datetm_InputReceivedOn]" /><input type="datetime" name="Item Created On" friendlyname="Item Created On" narrative="Time when item is loaded into the queue" expr="[datetm_Loaded DateTime]" /><input type="datetime" name="Item Completed On" friendlyname="Item Completed On" narrative="Completed time for the item. Helps calculate TAT" expr="[datetm_Completed DateTime]" /><input type="timespan" name="Total Work Time" friendlyname="Total Work Time" narrative="Handling time for the transaction" expr="[tmspan_Worktime]" /><input type="text" name="Queue Item Status" friendlyname="Queue Item Status" narrative="COMPLETED, COMPLETED WITHOUT OUTCOME, SYSTEM EXCEPTION, BUSINESS EXCEPTION" expr="[txt_Item Status]" /><input type="text" name="Final Outcome" friendlyname="Final Outcome" narrative="Applicable only in case of BUSINESS EXCEPTION, SYSTEM EXCEPTION or COMPLETED WITHOUT OUTCOME" expr="[txt_Exception Detail]" /><input type="text" name="Resource VM" friendlyname="Resource VM" narrative="Resource VM name" expr="GetResourceName()" /></inputs><onsuccess>24f039ae-e8f1-44b5-aca2-69d72546c572</onsuccess><resource object="Utility_DataGateways-CustomFramework" action="Send Data to Data Gateways" /></stage><stage stageid="82dbab02-1e67-4629-b4b8-89d5d36a98b2" name="Send Data to Gateways" type="Decision"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><display x="-45" y="-75" /><decision expression="[flg_SendDatatoDataGateways]" /><ontrue>e95b7cfa-fcce-4f2d-8482-5c6ff3e0260b</ontrue><onfalse>94c5e2cf-36be-413d-b12c-cfda72ccf18c</onfalse></stage><stage stageid="1f6f9221-86ad-4972-9078-97067ff42520" name="Is Completed" type="Decision"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><display x="-45" y="45" /><decision expression="[flg_IsCompleted]" /><ontrue>bf9709c1-dde4-4fc4-93c7-1dac1def21f1</ontrue><onfalse>79b35b85-6086-4a49-ab6d-0080018f7a88</onfalse></stage><stage stageid="79b35b85-6086-4a49-ab6d-0080018f7a88" name="Data Gateway Exception " type="Action"><subsheetid>aa6569fa-f401-47fe-91a0-849adc68e634</subsheetid><loginhibit onsuccess="true" /><display x="0" y="105" /><inputs><input type="text" name="Process Name" friendlyname="Process Name" narrative="Process Name" expr="[txt_FullProcessName]