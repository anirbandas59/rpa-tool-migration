input type="text" name="Script_location" narrative="Directory where to stor ethe script" stage="ScriptLocation" /></inputs><onsuccess>217d7803-bb86-4628-9785-bbbe2fc03dd3</onsuccess></stage><stage stageid="0f4714ab-8f19-43a2-8032-daed7cf00036" name="End" type="End"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-45" y="150" /><outputs><output type="text" name="Script_Path" stage="ScriptPath" /><output type="text" name="Status_Message" stage="Return Message" /></outputs></stage><stage stageid="e5f58cf6-c0b9-480b-98fb-b13b1332fe0a" name="Return Message" type="Data"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-195" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f8f9c846-9e75-44f3-b785-062f0e37d02a" name="Script" type="Data"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-195" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a2244b0-eed9-4e5c-b886-4bd4f89e1c22" name="Script_Name" type="Data"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="878570f6-2175-4ee0-92e2-c52587454a0a" name="ScriptPath" type="Data"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-195" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a7c5e547-52f8-495c-9ec0-2d7e7ecc7f2e" name="Input" type="Block"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="db7564f7-f284-4312-b59e-3f74118f0555" name="Output" type="Block"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-270" y="90" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ac6c1a44-05b4-4635-9623-913ba22ad896" name="Generate_PnPScript" type="SubSheet"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="-75" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>b1db1e48-9b61-458d-a846-d47e88ee5e91</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="483f51e2-1eaf-40a3-a632-841b58bed4a8" name="Input" type="Block"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-600" y="15" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1321d674-ae35-4c9e-b148-19114a95d667" name="Output" type="Block"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-600" y="180" w="120" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ea5ae437-cbb7-48c0-9a3c-25dfd38cb173" name="Inhouse" type="Block"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-465" y="15" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b1db1e48-9b61-458d-a846-d47e88ee5e91" name="Check_Error" type="Decision"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="-30" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>b4abe309-0a1e-4031-8eee-8da1343c699d</ontrue><onfalse>dd5364c6-e7a5-4f49-8bd9-940c853504b4</onfalse></stage><stage stageid="b4abe309-0a1e-4031-8eee-8da1343c699d" name="Exception while 