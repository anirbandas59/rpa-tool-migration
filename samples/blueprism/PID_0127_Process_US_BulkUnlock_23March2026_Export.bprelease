pattern and extract values" stage="Target String" /></inputs><onsuccess>2ad0c111-6108-4ca5-945b-22aab4b6bb27</onsuccess></stage><stage stageid="46282093-d3a9-4e38-b030-95b332ec5371" name="End" type="End"><subsheetid>a6b6398e-c21a-4c4e-9742-65ccad8370d9</subsheetid><loginhibit /><display x="-30" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Matched?" narrative="Whether or not the regex match" stage="Regex Match" /></outputs></stage><stage stageid="32d3ef8a-d0b2-4093-afc5-98bad356c881" name="Regex Pattern" type="Data"><subsheetid>a6b6398e-c21a-4c4e-9742-65ccad8370d9</subsheetid><display x="165" y="-120" w="300" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5747c96e-0ce3-4e78-b446-17b9cef5b655" name="Target String" type="Data"><subsheetid>a6b6398e-c21a-4c4e-9742-65ccad8370d9</subsheetid><narrative>100-200
56 to 99
400 - 600</narrative><display x="165" y="-75" w="300" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ad0c111-6108-4ca5-945b-22aab4b6bb27" name="Test Regex Match1" type="Code"><subsheetid>a6b6398e-c21a-4c4e-9742-65ccad8370d9</subsheetid><loginhibit /><display x="-30" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Regex Pattern" expr="[Regex Pattern]" /><input type="text" name="Target String" expr="[Target String]" /></inputs><outputs><output type="flag" name="Regex Match" stage="Regex Match" /></outputs><onsuccess>46282093-d3a9-4e38-b030-95b332ec5371</onsuccess><code><![CDATA[
Dim R as New Regex(Regex_Pattern, RegexOptions.SingleLine)
Dim M as Match = R.Match(Target_String)
Regex_Match =  M IsNot Nothing AndAlso M.Success]]></code></stage><stage stageid="24d6e567-f121-4d8a-a4ee-1402f8f2832d" name="Regex Match" type="Data"><subsheetid>a6b6398e-c21a-4c4e-9742-65ccad8370d9</subsheetid><display x="45" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
        <object id="924279c8-ecc4-4633-9c3b-b122a9d35229" name="Utility_DataGateways-CustomFramework" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility_DataGateways-CustomFramework" version="1.0" bpversion="7.3.1.15031" narrative="Helps in sending the custom Data to Data Gateways component so that the Data Gateways engine can act on it as per the configuration." byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="Business Object Template - BASIC"><id>3e0f9e2b-2024-4342-833f-4b41c0c905a9</id><group name="Dynamic - Common"><id>4f807269-1270-48ee-834f-79ccebf0d208</id><group name="Dyn_Input - Name"><id>9a413629-813a-438c-9c3e-051995e3a2a9</id></group><group name="Dyn_Button - Name"><id>ac064e25-01bd-48bd-83f9-b39fa96e746e</id></group></group><group name="Window - Name"><id>ee309f04-7b50-48a8-81b4-b11a1c3071d4</id><group name="Page - Name"><id>ca364050-86cf-4912-bce0-e3d9f14c9c81</id><group name="Input - Name"><id>adedf32f-b051-4831-b0ca-8e6c603c3879</id></group><group name="Button - Name"><id>74892cff-3cf1-4969-b7ce-20b50ca93167</id></group><group name="Label - Name"><id>24d71dea-3238-4449-98bf-c291119dff32</id></group><group name="Combobox - Name"><id>3676a1cc-f8d1-4379-88e2-c09f234aff8b</id></group><group name="Checkbox - Name"><id>0729c707-fe17-4384-b719-2afdd3c4b002</id></group><group name="Radio - Name"><id>1788109a-7e5b-4134-acd6-af4e7d14f0a0</id></group></group></group><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element><apptypeinfo><id>HTMLLaunch</id><parameters><parameter><name>Path</name><value>C:\Program Files\Internet Explorer\iexplore.exe</value></parameter><parameter><name>CommandLineParams</name><value></value></parameter><parameter><name>ActiveTabOnly</name><value>True</value></parameter><parameter><name>UseJavaInBrowser</name><value>False</value></parameter><parameter><name>ExcludeHTC</name><value>True</value></parameter><parameter><name>ProcessMode</name><value>Internal</value></parameter><parameter><name>ExternalProcessTimeout</name><value>0</value></parameter></parameters></apptypeinfo></appdef><view><camerax>164</camerax><cameray>9</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="4d90b7b1-abe4-474c-9bdb-f262c1cf5d4b" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="97c7bb95-591e-4365-816e-c7fd9a51995b" type="Normal" published="True"><name>Send Data to Data Gateways</name><view><camerax>-330</camerax><cameray>37</cameray><zoom version="2">1.5625</zoom></view></subsheet><stage stageid="49208c02-60bc-4d85-9b5f-2329da558424" name="Start" type="Start"><loginhibit /><display x="-45" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>82152898-e3bb-44f2-9f95-f2e1cfef4464</onsuccess></stage><stage stageid="82152898-e3bb-44f2-9f95-f2e1cfef4464" name="End" type="End"><loginhibit /><display x="-45" y="-75" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="cb366ce4-5098-497c-a459-fdd4a18a872d" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><references><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference></references><imports><import>System</import><import>System.Drawing</import></imports><language>visualbasic</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="4ff092af-e2ef-42f9-9f41-c45b10e95ee4" name="Clean Up" type="SubSheetInfo"><subsheetid>4d90b7b1-abe4-474c-9bdb-f262c1cf5d4b</subsheetid><display x="-135" y="-75" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="c4ad023a-bddc-450b-968b-af2adb51d467" name="Start" type="Start"><subsheetid>4d90b7b1-abe4-474c-9bdb-f262c1cf5d4b</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>18b195f9-00c5-41f9-9c66-0331f725f03d</onsuccess></stage><stage stageid="18b195f9-00c5-41f9-9c66-0331f725f03d" name="End" type="End"><subsheetid>4d90b7b1-abe4-474c-9bdb-f262c1cf5d4b</subsheetid><loginhibit /><display x="15" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="8835c958-97b6-4bfe-bdeb-ea0cc4d69d45" name="new" type="Note"><subsheetid>4d90b7b1-abe4-474c-9bdb-f262c1cf5d4b</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="165" y="-15" w="150" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="41507d9c-7b7b-44be-a366-b00a8b288a20" name="new" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="120" y="120" w="180" h="180" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="1101c09b-70b2-49aa-abc8-49ffc4a549c7" name="GLOBAL Timeout - XS" type="Data"><loginhibit /><display x="-195" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>1</initialvalue><alwaysinit /></stage><stage stageid="0cdfd238-d9b8-4e9e-8eda-7517d3584f9d" name="GLOBAL Timeout - S" type="Data"><loginhibit /><display x="-195" y="45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>5</initialvalue><alwaysinit /></stage><stage stageid="ff1d442f-3eca-4795-b61d-6c7dfb4c29f8" name="GLOBAL Timeout - M" type="Data"><loginhibit /><display x="-195" y="75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>10</initialvalue><alwaysinit /></stage><stage stageid="942999a2-daa5-434f-ae96-ffe2284af183" name="GLOBAL Timeout - L" type="Data"><loginhibit /><display x="-195" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>30</initialvalue><alwaysinit /></stage><stage stageid="f19f8e77-9940-4725-bf46-ad1c05fbb762" name="GLOBAL Timeout - XL" type="Data"><loginhibit /><display x="-195" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>60</initialvalue><alwaysinit /></stage><stage stageid="3d07e424-1849-42fc-a368-bfa880c24c66" name="GLOBAL Timeout - XXL" type="Data"><loginhibit /><display x="-195" y="165" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>120</initialvalue><alwaysinit /></stage><stage stageid="49f07426-232c-490c-8e5b-41d26bf0c12e" name="GLOBAL Timeout - XXS" type="Data"><loginhibit /><display x="-195" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0.5</initialvalue><alwaysinit /></stage><stage stageid="9a4d8a49-44ae-4263-b04d-804fa4c62e90" name="flg_Attached" type="Data"><display x="-195" y="195" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><alwaysinit /></stage><stage stageid="791a8a24-2376-4f58-995e-4cb45545917b" name="Variable" type="Block"><loginhibit /><display x="-270" y="-45" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d6c003ea-3f24-451a-b993-41075693bbc9" name="Note7" type="Note"><loginhibit onsuccess="true" /><narrative>This color represent COMMENTS, no actions required from your side</narrative><display x="120" y="-60" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="0000FF" /></stage><stage stageid="16cef646-25ce-4d79-8569-9075a3bcf5b2" name="Note7" type="Note"><loginhibit onsuccess="true" /><narrative>This color represent ACTIONS. You have to change/add element(s).
When you are done, color it to BLACK.</narrative><display x="120" y="0" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FF00FF" /></stage><stage stageid="9ff4be0a-6369-4a94-9e5b-438831795558" name="Note7" type="Note"><loginhibit onsuccess="true" /><narrative>READ BELOW FIRST TWO
THEN DELETE COMMENTS
WHEN YOU UNDERSTOOD</narrative><display x="120" y="-120" w="180" h="60" /><font family="Segoe UI" size="15" style="Bold" color="FF0000" /></stage><stage stageid="65b4dd91-d770-462b-8de5-746b51bbc1eb" name="TemplateVersion" type="Note"><loginhibit onsuccess="true" /><narrative>****DO NOT DELETE THIS NOTE***
ObjectTemplateVersion : v2020.06.25.1</narrative><display x="120" y="-180" w="180" h="60" /><font family="Segoe UI" size="15" style="Bold" color="800000" /></stage><stage stageid="9ab73d01-07ac-47f0-98ff-ac98c7578125" name="Send Data to Data Gateways" type="SubSheetInfo"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><narrative>Sends data to Data Gateways</narrative><display x="-540" y="-135" w="150" h="90" /></stage><stage stageid="5b291221-84d2-48e5-a8e7-0fb55e4788ca" name="End" type="End"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><display x="-345" y="30" w="90" h="30" /></stage><stage stageid="57cf6b19-6f77-4eb1-8651-813cf57c42d2" name="Data Gateways::Send Custom Data" type="Action"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><loginhibit onsuccess="true" /><narrative>This action can be used to serialize and send a Blue Prism collection to the data gateway. 
    There is a limit of approximately ~4MB on the data that can be sent through this method. 
    This is due to limitations enforced by the JSON Serializer.</narrative><display x="-345" y="-45" w="120" h="60" /><inputs><input type="collection" name="Custom Data" friendlyname="Custom Data" narrative="The Blue Prism collection to send to the data gateways table" expr="[in_DateGateways_coll]" /></inputs><onsuccess>5b291221-84d2-48e5-a8e7-0fb55e4788ca</onsuccess><resource object="Blueprism.Automate.clsDataGatewaysActions" action="Send Custom Data" /></stage><stage stageid="48b439fe-2974-48a8-94ba-8fe687e7c99e" name="Note31" type="Note"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><narrative>Data Gateways may not be enabled in DEV/SIT/UAT.
During those executions, running these will not result in error as it's written to primary database.
In the environments or for Processes where Data Gateway is enabled (in PROD), the Datagateways Engine will read and send the data to configured output application ( Secondary Database, File, HTTP, SPLUNK, etc.)</narrative><display x="-195" y="165" w="270" h="120" /><font family="Segoe UI" size="11" style="Bold" color="993300" /></stage><stage stageid="bff2decb-92be-45d8-b2e7-cc8dd875ea41" name="Variables" type="Block"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><loginhibit onsuccess="true" /><display x="-615" y="-45" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3dd9cf51-3d34-4212-ad36-14bcbba7e6d4" name="Note1" type="Note"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><loginhibit /><narrative>This action can be used to serialize and send a Blue Prism collection to the data gateway. 
    There is a limit of approximately ~4MB on the data that can be sent through this method. 
    This is due to limitations enforced by the JSON Serializer.</narrative><display x="-480" y="165" w="270" h="120" /><font family="Segoe UI" size="11" style="Bold" color="993300" /></stage><stage stageid="09e9c743-95a1-43ec-b469-97137f6ba2e1" name="Start" type="Start"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><display x="-345" y="-150" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="Process Name" stage="in_DateGateways_coll.ProcessName" /><input type="text" name="Item Id" narrative="Unique id to investigate from Blue Prism database" stage="in_DateGateways_coll.ItemId" /><input type="text" name="Item Key" narrative="Unique id to help business team connect to the transaction" stage="in_DateGateways_coll.ItemKey" /><input type="datetime" name="Input Data Received On" narrative="Time when input was available for the bot. Example Email reveived on, Input received from SAP etc." stage="in_DateGateways_coll.InputReceivedTime" /><input type="datetime" name="Item Created On" narrative="Time when item is loaded into the queue" stage="in_DateGateways_coll.ItemCreatedOn" /><input type="datetime" name="Item Completed On" narrative="Completed time for the item. Helps calculate TAT" stage="in_DateGateways_coll.ItemCompletedOn" /><input type="timespan" name="Total Work Time" narrative="Handling time for the transaction" stage="timespan_TotalWorkTime" /><input type="text" name="Queue Item Status" narrative="COMPLETED, COMPLETED WITHOUT OUTCOME, SYSTEM EXCEPTION, BUSINESS EXCEPTION" stage="in_DateGateways_coll.QueueItemStatus" /><input type="text" name="Final Outcome" narrative="Applicable only in case of BUSINESS EXCEPTION, SYSTEM EXCEPTION or COMPLETED WITHOUT OUTCOME" stage="in_DateGateways_coll.FinalOutcome" /><input type="text" name="Resource VM" narrative="Resource VM name" stage="in_DateGateways_coll.ResourceVM" /></inputs><onsuccess>b08f3d94-ee50-4ed0-acfc-07effc3ab46b</onsuccess></stage><stage stageid="c2f3b8c6-5855-41a7-8d99-5a8d2b935a61" name="in_DateGateways_coll" type="Collection"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><display x="-525" y="-15" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><singlerow /><field name="ProcessName" type="text" description="ProcessName" /><field name="ItemId" type="text" description="Unique id to investigate from Blue Prism database" /><field name="ItemKey" type="text" description="Unique id to help business team connect to the transaction" /><field name="InputReceivedTime" type="datetime" description="This could be the main trigger point such as EmailReceivedOn, file etc." /><field name="ItemCreatedOn" type="datetime" description="Time when item is loaded into the queue" /><field name="ItemCompletedOn" type="datetime" description="Completed time for the item. Helps calculate TAT" /><field name="QueueItemStatus" type="text" description="Completed,System Exception, Business Exception, Completed without Outcome" /><field name="ResourceVM" type="text" description="ResourceVM name" /><field name="TotalWorkTimeInSeconds" type="number" description="Handling time for the transaction" /><field name="FinalOutcome" type="text" description="Applicable only in case of Business Exception or System Exception: COMPLETED WITHOUT OUTCOME" /></collectioninfo><initialvalue><singlerow /><row><field name="ProcessName" type="text" value="" /><field name="ItemId" type="text" value="" /><field name="ItemKey" type="text" value="" /><field name="InputReceivedTime" type="datetime" value="" /><field name="ItemCreatedOn" type="datetime" value="" /><field name="ItemCompletedOn" type="datetime" value="" /><field name="QueueItemStatus" type="text" value="" /><field name="ResourceVM" type="text" value="" /><field name="TotalWorkTimeInSeconds" type="number" value="" /><field name="FinalOutcome" type="text" value="" /></row></initialvalue></stage><stage stageid="d4c171d6-53dd-4bbd-a42b-014a93ba25dc" name="timespan_TotalWorkTime" type="Data"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><display x="-525" y="30" w="120" h="30" /><datatype>timespan</datatype><initialvalue>0.00:00:00</initialvalue><private /><alwaysinit /></stage><stage stageid="b08f3d94-ee50-4ed0-acfc-07effc3ab46b" name="convert Worktime from timespan to number (Seconds) DataType" type="Calculation"><subsheetid>97c7bb95-591e-4365-816e-c7fd9a51995b</subsheetid><loginhibit /><narrative>timespan to seconds</narrative><display x="-345" y="-105" w="120" h="30" /><onsuccess>57cf6b19-6f77-4eb1-8651-813cf57c42d2</onsuccess><calculation expression="ToSeconds([timespan_TotalWorkTime])" stage="in_DateGateways_coll.TotalWorkTimeInSeconds" /></stage></process></object>
        <object id="aefc733d-4ea0-4ef7-a858-08df99018d1e" name="Utility_Generic_Process_General_Actions" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility_Generic_Process_General_Actions" version="1.0" bpversion="7.3.1.15031" narrative="" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="Utility_Generic_Business Object_General_Actions"><id>b125a091-7938-4113-b353-78f2b64bc0db</id><group name="Element1"><id>e76a3b51-dc35-451d-b8f4-5bc4d667dd8b</id></group><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element><apptypeinfo><id>Win32Attach</id><parameters><parameter><name>WindowTitle</name><value></value></parameter><parameter><name>ProcessName</name><value></value></parameter><parameter><name>Path</name><value></value></parameter><parameter><name>CommandLineParams</name><value></value></parameter><parameter><name>NonInvasive</name><value>True</value></parameter><parameter><name>ProcessMode</name><value>Internal</value></parameter><parameter><name>ExternalProcessTimeout</name><value>0</value></parameter><parameter><name>Options</name><value></value></parameter></parameters></apptypeinfo></appdef><view><camerax>0</camerax><cameray>-90</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="997258e1-f1f9-4d18-a732-38146e5ec596" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="1945f412-4288-49a8-a046-138ef176bfc0" type="Normal" published="True"><name>Wait 10 Seconds</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="dfc2f421-3657-4420-ba22-45079b56dfd9" type="Normal" published="True"><name>Get Process List</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="bd1dce08-b0b9-4eb0-adaa-912c9b812c9b" type="Normal" published="True"><name>Get Process ID</name><view><camerax>-181</camerax><cameray>-63</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="f3a4498b-b420-4d97-886e-424cb6d45a14" type="Normal" published="True"><name>Get Process ID w.r.t Window Titles</name><view><camerax>-50</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="54750081-764e-44ea-aef2-9a4a171b07fc" name="Start" type="Start"><loginhibit /><display x="15" y="-225" /><onsuccess>86cd00fc-83cc-45dc-9291-04816ed20629</onsuccess></stage><stage stageid="86cd00fc-83cc-45dc-9291-04816ed20629" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="915c926c-8c08-40ee-9ed6-6ba8f0a7d107" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import><import>System.Diagnostics</import></imports><language>csharp</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="a177102b-7526-4c44-8af2-be2f2cc9fcc6" name="Clean Up" type="SubSheetInfo"><subsheetid>997258e1-f1f9-4d18-a732-38146e5ec596</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1315250f-7bb9-4636-886a-b23a7f67760a" name="Start" type="Start"><subsheetid>997258e1-f1f9-4d18-a732-38146e5ec596</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>c456db56-69d1-4163-9eb0-12b01b56e82a</onsuccess></stage><stage stageid="c456db56-69d1-4163-9eb0-12b01b56e82a" name="End" type="End"><subsheetid>997258e1-f1f9-4d18-a732-38146e5ec596</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="6d6ef297-8059-48bc-88c9-91bd8f9c9742" name="Get Process List" type="SubSheetInfo"><subsheetid>dfc2f421-3657-4420-ba22-45079b56dfd9</subsheetid><display x="-255" y="-165" w="150" h="90" /></stage><stage stageid="b71c9772-9b12-4815-8d2a-a7df8e8d4826" name="Start" type="Start"><subsheetid>dfc2f421-3657-4420-ba22-45079b56dfd9</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>721a0459-6bf8-4a16-9817-7891a0148b8e</onsuccess></stage><stage stageid="1e9c5181-b416-49b0-ba65-616fc1eef986" name="End" type="End"><subsheetid>dfc2f421-3657-4420-ba22-45079b56dfd9</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="e1bfc87c-eb60-4569-a16a-a44296ff97ec" name="Note1" type="Note"><subsheetid>997258e1-f1f9-4d18-a732-38146e5ec596</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="baa0c2f3-4d3a-407d-9a7d-1a35f15deedf" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="721a0459-6bf8-4a16-9817-7891a0148b8e" name="Get Process List" type="Code"><subsheetid>dfc2f421-3657-4420-ba22-45079b56dfd9</subsheetid><loginhibit /><display x="15" y="-30" /><inputs><input type="collection" name="PList" expr="[ProcessList]" /></inputs><outputs><output type="collection" name="ProcessList" stage="ProcessList" /></outputs><onsuccess>1e9c5181-b416-49b0-ba65-616fc1eef986</onsuccess><code><![CDATA[Process[] processlist = Process.GetProcesses();

            foreach (Process theprocess in processlist)
            {
						DataRow Row = PList.NewRow();
						Row["ProcessID"] = theprocess.Id;
						Row["ProcessTitle"] = theprocess.MainWindowTitle;
						Row["ProcessName"] = theprocess.ProcessName;
						PList.Rows.Add(Row);
			}
		ProcessList = PList;	]]></code></stage><stage stageid="7d652ed0-2552-44ff-b65f-932a1795bd5f" name="ProcessList" type="Collection"><subsheetid>dfc2f421-3657-4420-ba22-45079b56dfd9</subsheetid><loginhibit /><display x="-210" y="-45" /><datatype>collection</datatype><alwaysinit /><collectioninfo><field name="ProcessID" type="text" /><field name="ProcessName" type="text" /><field name="ProcessTitle" type="text" /></collectioninfo></stage><stage stageid="a630cd26-0e2f-4663-be77-0951134a40db" name="Get Process ID" type="SubSheetInfo"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-240" y="-240" w="150" h="90" /></stage><stage stageid="e833c14e-41da-4615-96ed-bee2ad38bf54" name="Start" type="Start"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="ProcessName" narrative="eg.: iexplore chrome OUTLOOK etc take from Task Manager Active Process List" stage="ProcessName" /><input type="text" name="ProcessTitle" narrative="Use Wild Card eg: *SAP HANA*" stage="ProcessTitle" /><input type="text" name="String1" narrative="if Title Contains String1 -Optional" stage="String1" /><input type="text" name="String2" narrative="if Title Contains String2 -Optional" stage="String2" /><input type="text" name="String3" narrative="if Title Contains String3 -Optional" stage="String3" /></inputs><onsuccess>32efe257-aff1-4321-8cf7-93422dc233d4</onsuccess></stage><stage stageid="afd0ec02-19c7-4956-bd4a-8a6b8d7e4f70" name="End" type="End"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="15" y="120" /><outputs><output type="text" name="ProcessID" stage="ProcessID" /></outputs></stage><stage stageid="5f510046-cad8-4dff-912f-7ada189518e5" name="Get Process ID" type="Code"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="15" y="15" /><inputs><input type="collection" name="ProcessList" expr="[ProcessList]" /><input type="text" name="A" expr="[String1]" /><input type="text" name="B" expr="[String2]" /><input type="text" name="C" expr="[String3]" /><input type="text" name="ProcessName" expr="[ProcessName]" /></inputs><outputs><output type="text" name="ProcessID" stage="ProcessID" /></outputs><onsuccess>afd0ec02-19c7-4956-bd4a-8a6b8d7e4f70</onsuccess><code><![CDATA[ProcessID = "";
foreach (DataRow Row in ProcessList.Rows)
{
	if (ProcessName != "")
	{
		if (Row["ProcessTitle"].ToString().Contains(A) && Row["ProcessTitle"].ToString().Contains(B) && Row["ProcessTitle"].ToString().Contains(C))
		{
		ProcessID = Row["ProcessID"].ToString();
		}
	}
	else
	{
		if (Row["ProcessTitle"].ToString().Contains(ProcessName) )
		{
		ProcessID = Row["ProcessID"].ToString();
		}
	}
  
}]]></code></stage><stage stageid="d91ce4f8-ec9f-449a-9e4e-3d0209fe99ce" name="ProcessName" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-240" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="69eda4a7-586a-4bc6-8514-862604b705a7" name="ProcessTitle" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-345" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f9fcd09c-0b63-4b2b-9f1c-b40b48ce0148" name="String1" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-375" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1caef6ed-1999-4d21-8df1-09c4b43fc769" name="String2" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-255" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="71bf9ea1-6adb-4fb2-aff5-5cd880d35f14" name="String3" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-315" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2550697c-c7b8-4b96-9544-bbb304869d12" name="ProcessID" type="Data"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><display x="-375" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32efe257-aff1-4321-8cf7-93422dc233d4" name="Get Process List" type="SubSheet"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="15" y="-45" /><onsuccess>5f510046-cad8-4dff-912f-7ada189518e5</onsuccess><processid>dfc2f421-3657-4420-ba22-45079b56dfd9</processid></stage><stage stageid="a45ca0c8-cc52-4265-9bbb-088c6cf1d734" name="Input Parameters" type="Block"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="-420" y="-150" w="270" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e9d12c44-9387-412e-8e5d-b2aa6ef0e710" name="Output" type="Block"><subsheetid>bd1dce08-b0b9-4eb0-adaa-912c9b812c9b</subsheetid><loginhibit /><display x="-420" y="0" w="270" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FF6600" /></stage><stage stageid="03c361c4-41b4-4014-8d2f-a85aade4a233" name="Wait 10 Seconds" type="SubSheetInfo"><subsheetid>1945f412-4288-49a8-a046-138ef176bfc0</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="44f17071-785e-4cdc-9f1a-6bed6a4a980d" name="Start" type="Start"><subsheetid>1945f412-4288-49a8-a046-138ef176bfc0</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>f8f3899e-4771-4899-8be3-a1ed43ad81e0</onsuccess></stage><stage stageid="a39b892a-bc78-499d-980e-57178a352d1a" name="End" type="End"><subsheetid>1945f412-4288-49a8-a046-138ef176bfc0</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="74b465de-437e-44fa-8277-b26b37a09c75" name="Time Out1" type="WaitEnd"><subsheetid>1945f412-4288-49a8-a046-138ef176bfc0</subsheetid><loginhibit /><display x="15" y="60" w="30" h="30" /><onsuccess>a39b892a-bc78-499d-980e-57178a352d1a</onsuccess><groupid>7fa6b34e-94f8-4ddf-a1ef-dcde584a336e</groupid></stage><stage stageid="f8f3899e-4771-4899-8be3-a1ed43ad81e0" name="Wait1" type="WaitStart"><subsheetid>1945f412-4288-49a8-a046-138ef176bfc0</subsheetid><loginhibit /><display x="15" y="-60" w="30" h="30" /><groupid>7fa6b34e-94f8-4ddf-a1ef-dcde584a336e</groupid><choices /><timeout>10</timeout></stage><stage stageid="9e08d5dc-cab0-46c3-8655-b48182559b6f" name="Get Process ID w.r.t Window Titles" type="SubSheetInfo"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><narrative>Gets the PID for the matched Window With in the Window Titles variable separated by comma(,).</narrative><display x="-270" y="-120" w="150" h="90" /></stage><stage stageid="e2310f60-a7bc-40d2-aacb-081bf64de659" name="Start" type="Start"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Window Titles" narrative="Window titles Separated by Comma(,)" stage="in_ProcessTitle" /><input type="text" name="Process Name" narrative="eg.: iexplore chrome OUTLOOK etc take from Task Manager Active Process List" stage="in_ProcessName" /></inputs><onsuccess>ef96e7cb-8887-4bab-bf7e-28cd2bcd4ad3</onsuccess></stage><stage stageid="c036fa76-4a08-436d-bf04-d94cb03e358d" name="End" type="End"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="ProcessID" narrative="Process ID of the matched window" stage="out_ProcessID" /></outputs></stage><stage stageid="19a40c97-6ab8-404a-8ed9-d42b3c929420" name="Get Process ID W.r.t Window Titles" type="Code"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="15" y="15" /><inputs><input type="collection" name="ProcessList" expr="[ProcessList]" /><input type="text" name="ProcessName" expr="[in_ProcessName]" /><input type="text" name="ProcessTitle" expr="[in_ProcessTitle]" /></inputs><outputs><output type="text" name="ProcessID" stage="out_ProcessID" /></outputs><onsuccess>c036fa76-4a08-436d-bf04-d94cb03e358d</onsuccess><code><![CDATA[ProcessID = "";
foreach (DataRow Row in ProcessList.Rows)
{
	if (ProcessName != "")
	{
		foreach (String str in ProcessTitle.Split(','))
		{
		if (Row["ProcessTitle"].ToString().Contains(str))
		{
		ProcessID = Row["ProcessID"].ToString();
		}
		}
	}
  
}]]></code></stage><stage stageid="50351e05-751e-48df-bb96-bb94d8ed5da8" name="in_ProcessName" type="Data"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><display x="-225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a2deab78-262a-4c13-a115-a11899099d10" name="in_ProcessTitle" type="Data"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><display x="-300" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2b14d9bb-b486-4a8a-bed5-207b09781872" name="Output" type="Block"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="-345" y="30" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6cd3eb0d-91d8-4b13-b3b8-8f7b314ee2a1" name="Input" type="Block"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="-345" y="-45" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9c81e094-080d-49bb-bd42-ae2bade3d9ca" name="out_ProcessID" type="Data"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><display x="-270" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef96e7cb-8887-4bab-bf7e-28cd2bcd4ad3" name="Get Process List" type="SubSheet"><subsheetid>f3a4498b-b420-4d97-886e-424cb6d45a14</subsheetid><loginhibit /><display x="15" y="-45" /><onsuccess>19a40c97-6ab8-404a-8ed9-d42b3c929420</onsuccess><processid>dfc2f421-3657-4420-ba22-45079b56dfd9</processid></stage></process></object>
