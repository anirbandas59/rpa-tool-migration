e /><alwaysinit /></stage><stage stageid="6df20b40-003d-4035-ab83-e1feebce9a8a" name="Script Path" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="76ea0eab-d347-4469-a4c7-491807e01621" name="Error_Message" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa73f966-9efc-4b85-9734-e27338c6434c" name="Run Report" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c910364d-ef01-4244-a9e9-1a4a6110a1c9" name="P_Exists" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="da54f68c-a2a2-4a4b-a804-812accd171a1" name="File_Type" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-210" y="75" /><datatype>text</datatype><initialvalue xml:space="preserve">Item</initialvalue><private /><alwaysinit /></stage><stage stageid="f645a7a1-df26-4fcf-99e4-c2fd46cf5f8f" name="Standards" type="Note"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><narrative>Item_Type:Choose Item Type( All,Folder or File) best fit for your search

File Name:- File to be checked (Example:- test.xlsx)

Share_Target_Lib: Includes Library and sub folder where to search file present or not( Example:- Documents/FO/Data/Test.xlsx)

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Test.xlsx" in  f "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data".
</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="6e334ef4-564d-42d9-b854-9e8a58fb7015" name="Unexpected exception recover" type="Recover"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="375" y="-15" /><onsuccess>1ea1d9ea-fac6-456c-9dd7-66ddd3d35464</onsuccess></stage><stage stageid="5f668c82-50cc-4c9b-b559-3a5bb96c28ea" name="Unexpected Exception" type="Exception"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="585" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="a49e1ed6-4363-4810-90b9-20e8bec6441d" name="Script_Location" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1ea1d9ea-fac6-456c-9dd7-66ddd3d35464" name="Delete_Script" type="Action"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="480" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>5f668c82-50cc-4c9b-b559-3a5bb96c28ea</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="84dfac61-fa37-473f-8594-595a6ac4e3c4" name="Validate Temp Script Path" type="SubSheet"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>5ca7bcaf-8615-4c79-9528-a34c3028a143</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="54d209b1-81aa-4191-a071-a12d713fdec6" name="File_Name" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-180" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1a4ee114-eb8b-4e3d-bcdb-c4b0d4305075" name="Get List Items to CSV - Query" type="SubSheetInfo"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><narrative>Exports provided columns of given list to a csv file including EmailIds and VlookUp Values</narrative><display x="-405" y="-405" w="150" h="90" /></stage><stage stageid="9e437b9b-1ea2-4705-96d2-a104b4ab8d95" name="Return Message" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9e59256-e16a-4d26-a511-3e0482e54790" name="SP_Site_URL" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-255" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38d3a951-ea1e-40fa-b4ea-f88dbfbfbd1e" name="Unexpected exception recover" type="Recover"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="30" y="-225" /><onsuccess>32f0bf8e-1404-4fd5-a0e7-77c62f439dbd</onsuccess></stage><stage stageid="a1bcf8b5-d7c1-4031-9497-51b7a11ba90c" name="Unexpected Exception" type="Exception"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="30" y="-105" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="63613486-06e6-4e93-8932-644e88edc5bd" name="Start" type="Start"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><preconditions><condition narrative="Required Proper Calm Query, Valid CSV FilePath, List Internal Column Names" /></preconditions><postconditions><condition narrative="Generates Output csv" /></postconditions><display x="-165" y="-510" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_List" narrative="Name of Sharepoint list to be exported." stage="SP_List" /><input type="text" name="CalmQuery" narrative="CAML is an XML-based query language. Default Value : &quot;&lt;View&gt;&lt;OrderBy&gt;&lt;FieldRef Name='ID' Ascending='TRUE'/&gt;&lt;/OrderBy&gt;&lt;/View&gt;&quot;. It will fetch all the list Items. provide required query to limit the items" stage="Query" /><input type="number" name="PageSize" narrative="(Optional) default value is 1000. It is required when we exporting large set of items from SharePoint List(Max Value : 5000)" stage="PageSize" /><input type="text" name="CSV FilePath" narrative="CSV full file path to export the list" stage="CSV FilePath" /><input type="text" name="Columns" narrative="Internal column names to be exported provided as a text values separated by comma e.g. Title,Created Date" stage="Columns" /></inputs><onsuccess>d2f174a4-d635-4df0-9a1b-cf3bd812be0f</onsuccess></stage><stage stageid="450608da-f385-412c-bf9e-f392b9599b06" name="End" type="End"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="165" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="43debb62-94d7-4cbe-9c70-3f1712c8dc1f" name="Run PnP_Script" type="SubSheet"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>bb48f2ed-bbb5-41c9-a52d-46a0eb9b0815</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="f140c077-9bc2-43c2-9815-7d5cf49647d9" name="Delete_Script" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="105" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>450608da-f385-412c-bf9e-f392b9599b06</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="5300b123-0ad5-4c74-819d-dec5d9098985" name="Generate_PnPScript" type="SubSheet"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-255" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script Template]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;TempListItemQuery&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Folder]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>20eed3db-3389-4590-8c81-b7a9ba6a3689</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="20eed3db-3389-4590-8c81-b7a9ba6a3689" name="Check_Error" type="Decision"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-195" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>790ca066-2f35-4848-bf62-0ccbc619b4ac</ontrue><onfalse>43debb62-94d7-4cbe-9c70-3f1712c8dc1f</onfalse></stage><stage stageid="790ca066-2f35-4848-bf62-0ccbc619b4ac" name="Exception while creating  Script" type="Exception"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-75" y="-195" /><exception type="System Exception" detail="[Return Message]" /></stage><stage stageid="bb48f2ed-bbb5-41c9-a52d-46a0eb9b0815" name="Check Process_Exist" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-75" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Process_Exists" /></outputs><onsuccess>abf50b09-335a-4ac6-8230-e698f5d29a07</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="abf50b09-335a-4ac6-8230-e698f5d29a07" name="ProcessExist?" type="Decision"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-15" /><decision expression="[Process_Exists]=True" /><ontrue>2b3e9c2a-125f-41b2-a940-c3befd40330b</ontrue><onfalse>11c88d3b-c08b-44e5-9f92-77b8bb830905</onfalse></stage><stage stageid="11c88d3b-c08b-44e5-9f92-77b8bb830905" name="Anchor8" type="Anchor"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-105" y="-15" w="10" h="10" /><onsuccess>45b6cb5a-08c6-4c51-9305-664839797091</onsuccess></stage><stage stageid="2b3e9c2a-125f-41b2-a940-c3befd40330b" name="Kill Process" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="45" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>f140c077-9bc2-43c2-9815-7d5cf49647d9</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="45b6cb5a-08c6-4c51-9305-664839797091" name="Anchor9" type="Anchor"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-105" y="105" w="10" h="10" /><onsuccess>f140c077-9bc2-43c2-9815-7d5cf49647d9</onsuccess></stage><stage stageid="8342796c-f7fa-441c-ae2b-a35939c0446d" name="Input" type="Block"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-480" y="-345" w="150" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="aeab10b8-8356-4054-80d2-e658ab37e8ab" name="OutPut" type="Block"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-480" y="-135" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="bd8339c6-11ab-4cb2-91a0-ccdeb7ad90e2" name="Inhouse" type="Block"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-480" y="-30" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="55b05017-6b8d-47cb-8315-8f3f3943470f" name="Process_Exists" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="120" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="80b3c522-110b-4b4b-8869-c4b41930d52e" name="Error_Message" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32f0bf8e-1404-4fd5-a0e7-77c62f439dbd" name="Delete_Script" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="30" y="-165" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>a1bcf8b5-d7c1-4031-9497-51b7a11ba90c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="56adf2de-41e9-4316-8fbb-85b1eb650fb2" name="SP_List" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-285" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b5348a53-fbb1-4225-8ec9-5c2cfbfabc8e" name="Columns" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d934582f-e634-48ee-80d8-353c1f49fb7b" name="Script Template" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit /><display x="-405" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$Columns = "__COLUMNS__"
$Columns = $Columns.Split(",")
$filePath = "__FILEPATH__"
$URL = "__URL__"
$listName =  "__LISTNAME__"
$query = "__QUERY__"
$pagesize = __PAGESIZE__
If (Test-Path($filePath )){
    Remove-Item $filePath 
}
$env:PNPPOWERSHELL_UPDATECHECK="false"
Connect-PnPOnline -Url $URL -AccessToken "__ACCESSTOKEN__" -WarningAction SilentlyContinue
$fields = Get-PnPField -List $listName

foreach($Column in $Columns){
    foreach($field in $fields){
        if($field.InternalName -eq $Column){
            if($field.GetType().Name -eq "FieldUser"){
               $field.Title + "_Email" + "," | Add-Content -Path $filePath -NoNewline
                $field.Title  + "_Value" + "," | Add-Content -Path $filePath -NoNewline 
            }
            else{
                $field.Title  + ","| Add-Content -Path $filePath -NoNewline
            }
            break
        }
    }
}
"" | Add-Content -Path $filePath
$listitems = Get-PnPListItem -List $listName -Query $query -PageSize $pagesize

$listColumn = [System.Collections.ArrayList]@()

foreach($listitem in $listitems ){
    
    foreach($Column in $Columns){
        if($listitem[$Column] -ne $null) {

            if($listitem[$Column].GetType() -ne $null){
                
                if($listitem[$Column].GetType().Name -eq "FieldUserValue"){
                   
                   """" + $listitem[$Column].Email + """" + ","| Add-Content -Path $filePath -NoNewline
                   """" + $listitem[$Column].LookupValue + """" + ","| Add-Content -Path $filePath -NoNewline 
                    
                }
                
                elseif($listitem[$Column].GetType().Name -eq "FieldLookupValue"){
                   
                     """" + $listitem[$Column].LookupValue + """" + ","| Add-Content -Path $filePath -NoNewline
                }
                elseif($listitem[$Column].GetType().Name -eq "String[]"){
                   
                     """" + ($listitem[$Column] -join "|") + """" + ","| Add-Content -Path $filePath -NoNewline
                }
				elseif($listitem[$Column].GetType().Name -eq "DateTime"){

                     """" + $listitem[$Column].ToLocalTime() + """" + ","| Add-Content -Path $filePath -NoNewline
                }
                
                else{

                     """" + $listitem[$Column] + """" + ","| Add-Content -Path $filePath -NoNewline
                }
            }
        }
      else{
        
          
                   "" + ","| Add-Content -Path $filePath -NoNewline
       
       }
    
    }
    "" | Add-Content -Path $filePath 
}

</initialvalue><private /><alwaysinit /></stage><stage stageid="9a77f3b3-eb19-4747-b48a-bfeba0e062dd" name="Script To Extract Vales" type="MultipleCalculation"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit /><display x="-165" y="-315" /><onsuccess>5300b123-0ad5-4c74-819d-dec5d9098985</onsuccess><steps><calculation expression="Replace([Script Template], &quot;__COLUMNS__&quot;, [Columns])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__FILEPATH__&quot;, [CSV FilePath] )" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__URL__&quot;, [SP_Site_URL])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__LISTNAME__&quot;, [SP_List])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__QUERY__&quot;, [Query])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__PAGESIZE__&quot;, [PageSize])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__ACCESSTOKEN__&quot; , [AccessToken]  )" stage="Script Template" /></steps></stage><stage stageid="f94a07ba-8c2b-4d8b-afc7-9d827db04c52" name="CSV FilePath" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-225" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b01dd37-706b-4304-bf8c-74e6f77f2efe" name="Query" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-315" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">&lt;View&gt;&lt;OrderBy&gt;&lt;FieldRef Name='ID' Ascending='TRUE'/&gt;&lt;/OrderBy&gt;&lt;/View&gt;</initialvalue><private /><alwaysinit /></stage><stage stageid="5d407976-43bd-4776-a8f4-28ab2d8f7d36" name="PageSize" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-165" w="150" h="30" /><datatype>number</datatype><initialvalue>1000</initialvalue><private /><alwaysinit /></stage><stage stageid="4bc5c184-2494-42d2-8cd0-a292291d90cf" name="Get FileName and Path" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="-375" /><inputs><input type="text" name="File Path" friendlyname="File Path" narrative="The path to split" expr="[CSV FilePath]" /></inputs><outputs><output type="text" name="File Name" friendlyname="File Name" narrative="The filename" stage="File Name" /><output type="text" name="Folder" friendlyname="Folder" narrative="The folder" stage="Folder" /></outputs><onsuccess>9a77f3b3-eb19-4747-b48a-bfeba0e062dd</onsuccess><resource object="Utility - File Management_Extended" action="Split Path" /></stage><stage stageid="977768d2-2b13-4ee3-bb64-5c2a44a5b21b" name="File Name" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65e92234-1ec8-45dc-afab-612fb136d0d2" name="Folder" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e3c7c575-2a61-41ca-b5c6-8ba7d1d77a34" name="Script Path" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="14bcd6e3-ef09-45ad-b16b-370e17c160f7" name="Remove_Folder_From_Library" type="SubSheetInfo"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><narrative>Remove file from specific library/ sharepoint location.</narrative><display x="-75" y="-270" w="150" h="90" /></stage><stage stageid="fad799cf-fc4f-4172-aec5-032dfdf02e81" name="Start" type="Start"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><preconditions><condition narrative="&gt; Make sure SharePoint API is installed." /><condition narrative="&gt;Make sure you have atleast Edit access/contribute access to Site/Library to use this action." /></preconditions><postconditions><condition narrative="&gt; Get the output and create the success/failure condition." /></postconditions><display x="120" y="-330" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_Lib_Folder" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder/)" stage="SP_Target_Lib" /><input type="text" name="FolderName" narrative="Input the folder namer to be deleted (Ex:- Test)" stage="Folder" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>172db761-39e4-42fc-8122-9cba4b4140a2</onsuccess></stage><stage stageid="b9a9a1bd-618c-4ad5-98f4-98309a738965" name="End" type="End"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="300" /><outputs><output type="text" name="Script_Run_Message" narrative="returns Blank/Warning for software update." stage="Run Report" /><output type="text" name="Script_Error_Message" narrative="Returns error/exception details ( On error shares error details)" stage="Error_Message" /></outputs></stage><stage stageid="78cadce4-297b-4423-8efe-6f705070d96a" name="Build Script" type="Calculation"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-135" /><onsuccess>305020f3-3db9-4d28-a472-b4bf10d6dcda</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot; Remove-PnPFolder -Folder &#xA;&quot; &amp; Chr(34) &amp; [SP_Target_Lib]&amp;Chr(34)&amp;&quot; -Name &quot;&amp;Chr(34)&amp; [Folder]&amp; Chr(34) &amp;  &quot; -Force&quot;" stage="Script" /></stage><stage stageid="113b646f-aed3-4381-aa92-1d195e91ca9e" name="Run PnP_Script" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="15" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>54d72b98-3a45-44f7-a881-fcbcccfd87a9</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="bfb1c261-3562-4c96-b2cf-573065e2f9b3" name="Delete_Script" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="225" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b9a9a1bd-618c-4ad5-98f4-98309a738965</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="305020f3-3db9-4d28-a472-b4bf10d6dcda" name="Generate_PnPScript" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-90" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>0313064d-28eb-40f1-ae18-a2c69de4a5d6</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="0313064d-28eb-40f1-ae18-a2c69de4a5d6" name="Check_Error" type="Decision"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>da536f88-683c-4b75-b648-cae928168b3c</ontrue><onfalse>113b646f-aed3-4381-aa92-1d195e91ca9e</onfalse></stage><stage stageid="da536f88-683c-4b75-b648-cae928168b3c" name="Exception while creating  Script" type="Exception"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="315" y="-45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="54d72b98-3a45-44f7-a881-fcbcccfd87a9" name="Check Process_Exist" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="60" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>b21b303c-be28-4f9f-9111-cafefb3848ba</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="b21b303c-be28-4f9f-9111-cafefb3848ba" name="ProcessExist?" type="Decision"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="120" /><decision expression="[P_Exists]=True" /><ontrue>96108b3b-79aa-408a-9865-6a7c43e20ba0</ontrue><onfalse>6b9455c4-e6c9-4631-8798-ad788b4267ec</onfalse></stage><stage stageid="6b9455c4-e6c9-4631-8798-ad788b4267ec" name="Anchor8" type="Anchor"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="225" y="120" w="10" h="10" /><onsuccess>3ad5eb41-fdce-4577-ab41-f2615953c8c1</onsuccess></stage><stage stageid="96108b3b-79aa-408a-9865-6a7c43e20ba0" name="Kill Process" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="165" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>bfb1c261-3562-4c96-b2cf-573065e2f9b3</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="3ad5eb41-fdce-4577-ab41-f2615953c8c1" name="Anchor9" type="Anchor"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="225" y="225" w="10" h="10" /><onsuccess>bfb1c261-3562-4c96-b2cf-573065e2f9b3</onsuccess></stage><stage stageid="d4fb9d3c-e93a-48bd-9296-9e30fbdb8fe7" name="SP_Site_URL" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-105" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b6b5c7cb-b9ad-47ff-ba07-b106c4803ec7" name="SP_Target_Lib" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-105" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56812c14-dc99-4a10-b49e-6dedb0193035" name="Folder" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-30" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07daa41e-c268-4aad-9bc1-cdf433197880" name="Input" type="Block"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-165" y="-75" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6c3ac3af-6062-49ea-8ba4-81c91ad4f7ab" name="Output" type="Block"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-165" y="75" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2fb3a640-a086-4005-8a9a-aa0640133ff0" name="Inhouse" type="Block"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-345" y="-75" w="90" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8cc14bf5-c812-4dc7-b579-b301c83eec50" name="Script" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-300" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1357592-a2e2-4be8-bca1-c22d62f57066" name="Return Message" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-300" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="496b840e-4cdb-42aa-b553-b1d3291217f0" name="Script Path" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-300" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="784ea115-f2eb-40c2-8996-30cbe103b10c" name="Error_Message" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-120" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9b32ec5c-b849-4804-bb1a-ffa7c5a8c852" name="Run Report" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-30" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9caf1109-5b0e-4a10-8e59-f74451bf5f84" name="P_Exists" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><narrative>Process exist or not</narrative><display x="-300" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="101abf33-b567-44b6-8544-3b84baf2edad" name="Standards" type="Note"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><narrative>
Folder Name:- Folder to be Deleted (Example:- Test)

Share_Target_Lib: Includes Library and sub folder where to search file present or not( Example:- Documents/FO/Data/)

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)


</narrative><display x="-315" y="-165" w="300" h="150" /></stage><stage stageid="6548feca-e814-459c-928e-e78adcb0abfb" name="Unexpected exception recover" type="Recover"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="480" y="-45" /><onsuccess>1b8c84e4-84fd-478c-ba34-29b014a811c5</onsuccess></stage><stage stageid="b5702135-2f02-4cb6-9f21-0758b17d091e" name="Unexpected Exception" type="Exception"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="690" y="-45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="2224d8a8-a3aa-4499-8601-4bcac4a85816" name="Script_Location" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-30" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b8c84e4-84fd-478c-ba34-29b014a811c5" name="Delete_Script" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="585" y="-45" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b5702135-2f02-4cb6-9f21-0758b17d091e</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="9fdd1d06-a440-4767-a288-448b8e8753d0" name="Validate Temp Script Path" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-180" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>78cadce4-297b-4423-8efe-6f705070d96a</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="fe88019b-6076-4cf4-8aad-0b604571b5bf" name="Publish a File" type="SubSheetInfo"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Publish a File to Sharepoint library.</narrative><display x="-255" y="-120" w="150" h="90" /></stage><stage stageid="8a9e0f23-b0c3-41b2-92f5-66a3eec9e259" name="Start" type="Start"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="-15" y="-345" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="SP_Lib_Folder_Path" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Publish Comment" narrative="Comment while publishing" stage="Publish Comment" /></inputs><onsuccess>49533fea-ceeb-47d0-a1d5-934e6e507e20</onsuccess></stage><stage stageid="77500ab4-58cf-4404-b899-3405ef7ec17d" name="End" type="End"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="300" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="99337576-f0c9-4a13-8af0-0c011062b11f" name="Return Message" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-540" y="210" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6fecc824-0547-4fff-acdb-a3589e1b5a6a" name="Build Script" type="Calculation"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="-120" /><onsuccess>9a2359e8-c195-4bad-8c86-b4b55ac202e8</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;&#xA;# Get Context&quot; &amp; NewLine() &amp; &quot;&#xA;&#xA;$clientContext = Get-PnPContext&quot; &amp; NewLine() &amp; &quot;&#xA;# -Url: relative path of the file&quot; &amp; NewLine() &amp; &quot;&#xA;# -AsListItem: Retrieves the file and returns it as a ListItem object&quot; &amp; NewLine() &amp; &quot;&#xA;$ListItem = Get-PnPFile -Url &quot;&amp; Chr(34) &amp; [SP_Lib_Folder_Path] &amp; Chr(34) &amp;&quot; -AsListItem&quot; &amp; NewLine() &amp; &quot;&#xA;# Get the File object&quot; &amp; NewLine() &amp; &quot;&#xA;$targetFile = $ListItem.File&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.Load($targetFile)&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.ExecuteQuery()&quot; &amp; NewLine() &amp; &quot;&#xA;# Publish content and provide comment&quot; &amp; NewLine() &amp; &quot;&#xA;# You cannot perform this action on a checked out document.&quot; &amp; NewLine() &amp; &quot;&#xA;$targetFile.Publish(&quot;&amp; Chr(34) &amp; [Publish Comment] &amp; Chr(34) &amp;&quot;)&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.ExecuteQuery()&quot; &amp; NewLine() &amp; &quot;&#xA;Disconnect-PnPOnline&quot;" stage="Script" /></stage><stage stageid="f9f8e271-b18b-43d4-b7d4-8285464c091c" name="Script" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-420" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9393d711-de46-4fc0-afc9-e944af925082" name="SP_Site_URL" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Link for site or subsite.</narrative><display x="-540" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56c29a08-5638-46c3-bf3f-861a68308775" name="SP_Lib_Folder_Path" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-540" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="110fa089-2987-4dc8-8b40-81469cbd014f" name="FilePath" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>File Location to upload the file.</narrative><display x="-540" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0253ada1-6e4f-4635-b13c-4fd69afd2202" name="Run PnP_Script" type="SubSheet"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>6b20b05c-eb33-4012-b455-32aeff37fbb5</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="62bdd158-bf43-4e39-b20b-eee2177a8635" name="Note3" type="Note"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Publish Comment : "Published by PNP"


Share_Lib_Folder_Path: Includes Library and sub folder and file name ( Example:- Documents/FO/Data.xlsx)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

