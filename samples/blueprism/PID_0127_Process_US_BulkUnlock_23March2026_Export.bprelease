heet subsheetid="9c0d3b1a-daf9-4598-89bf-9db913cbdca3" type="Normal" published="True"><name>Delete all files in folder including Subfolders (Recursive)</name><view><camerax>0</camerax><cameray>-87</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="d27ca775-2cf6-4856-9e03-482312570937" type="Normal" published="True"><name>Get All Latest Files W.r.t File Created Time Large data</name><view><camerax>-166</camerax><cameray>-52</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="112ca2fc-ab20-4908-9135-7d9915f037d3" type="Normal" published="True"><name>Get Latest File that starts with</name><view><camerax>-87</camerax><cameray>-79</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="ed63d0d3-f604-4b62-82e5-f7dceb2af6a3" type="Normal" published="True"><name>Download all files in folder including Subfolders (Recursive)</name><view><camerax>0</camerax><cameray>-129</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="e5ab72df-9f86-4e44-a30c-5e626e223b95" type="Normal" published="True"><name>Upload folder structure to SharePoint</name><view><camerax>-76</camerax><cameray>87</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="b9490419-e858-4f7b-87b4-c9c117c025b7" type="Normal" published="True"><name>Upload folder structure to SharePoint - Large data</name><view><camerax>-37</camerax><cameray>42</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="0455bdbc-b551-4c40-a6ea-2c3e98a7d932" type="Normal" published="True"><name>Export List to Excel by Columns</name><view><camerax>-328</camerax><cameray>-326</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="6008694c-4949-440e-8b35-f576ebcda3e5" type="Normal" published="True"><name>Get All Files From Folder sorted (File Created Time)</name><view><camerax>-359</camerax><cameray>-225</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="b8c9af06-4143-4b28-ab5e-def3d94cc99a" name="Start" type="Start"><display x="15" y="-105" /><onsuccess>eacaab65-ef05-4946-8008-fccd66ccbd4a</onsuccess></stage><stage stageid="eacaab65-ef05-4946-8008-fccd66ccbd4a" name="End" type="End"><display x="15" y="90" /></stage><stage stageid="d0467e3b-15e1-4479-a2d6-5dd2e795d304" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import><import>System.Diagnostics</import><import>System.IO</import><import>System.Text</import></imports><language>csharp</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="e9fbd171-4a7e-4ab7-ab9e-72198693dc8f" name="Clean Up" type="SubSheetInfo"><subsheetid>080f2495-bb12-4ec4-9fbe-efc25ef4e13f</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bfa42f14-8f41-4613-90f5-6f0e73aab566" name="Start" type="Start"><subsheetid>080f2495-bb12-4ec4-9fbe-efc25ef4e13f</subsheetid><display x="15" y="-105" /><onsuccess>0733167c-cd0b-485c-988b-01a8c2ed7074</onsuccess></stage><stage stageid="0733167c-cd0b-485c-988b-01a8c2ed7074" name="End" type="End"><subsheetid>080f2495-bb12-4ec4-9fbe-efc25ef4e13f</subsheetid><display x="15" y="90" /></stage><stage stageid="42c3caf7-f90c-43c9-84f1-eba7db490b63" name="Note1" type="Note"><subsheetid>080f2495-bb12-4ec4-9fbe-efc25ef4e13f</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="ed371658-866f-4507-87db-4a84eb25b9c8" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="672d1801-4572-4b98-9381-41dfba734c0b" name="Common_Data Items" type="Block"><display x="165" y="-150" w="270" h="330" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3a4944e0-bde4-4372-87c4-08dea4c3b91f" name="Wait-S" type="Data"><display x="255" y="-90" /><datatype>number</datatype><initialvalue>30</initialvalue><alwaysinit /></stage><stage stageid="ed75999a-6af9-43ec-9b6c-474823fe4fca" name="Wait-L" type="Data"><display x="300" y="-90" /><datatype>number</datatype><initialvalue>60</initialvalue><alwaysinit /></stage><stage stageid="e7b00ea4-a42e-4fff-a520-8772c17187eb" name="Wait-XL" type="Data"><display x="345" y="-90" /><datatype>number</datatype><initialvalue>90</initialvalue><alwaysinit /></stage><stage stageid="530a2595-adee-4974-8031-4c59bfbb2242" name="Retry Limit" type="Data"><display x="225" y="-45" /><datatype>number</datatype><initialvalue>10</initialvalue><alwaysinit /></stage><stage stageid="1f48ab15-6dad-41fc-b525-6ec55a6ca494" name="Wait-XS" type="Data"><display x="210" y="-90" /><datatype>number</datatype><initialvalue>15</initialvalue><alwaysinit /></stage><stage stageid="d6e5c18d-d683-431a-adc0-2a7540e6cf42" name="Wait-2S" type="Data"><display x="390" y="-90" /><datatype>number</datatype><initialvalue>2</initialvalue><alwaysinit /></stage><stage stageid="8c3cd73a-8208-492b-82b7-72fe1820940c" name="Application_nm" type="Data"><display x="255" y="45" /><datatype>text</datatype><initialvalue xml:space="preserve">Powershell</initialvalue><alwaysinit /></stage><stage stageid="1e964932-b118-40ac-9d36-e53af0495df5" name="Wait-XXL" type="Data"><display x="285" y="-45" /><datatype>number</datatype><initialvalue>120</initialvalue><alwaysinit /></stage><stage stageid="5bc87d6c-fe2e-4a1e-b7ec-f0cee92b5096" name="Upload File To SharePoint" type="SubSheetInfo"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><narrative>Upload Files to Sharepoint library.</narrative><display x="-255" y="-120" w="150" h="90" /></stage><stage stageid="1dd900ae-318f-408e-a739-d8713363f4ec" name="Start" type="Start"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="-15" y="-300" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>bbbe3565-0ba9-4f24-831a-3f9e7fd25b4c</onsuccess></stage><stage stageid="156ca2e9-e04b-4c6b-a530-f924cd1f5eb4" name="End" type="End"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="345" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="ca143a8a-105d-49f1-a3bc-161a069dd10a" name="Return Message" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-540" y="240" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a6ba7a6c-6282-4d8a-afda-05775af0f9cc" name="Build Script" type="Calculation"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="-120" /><onsuccess>ac6c1a44-05b4-4635-9623-913ba22ad896</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&#xA;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&quot;$path = &quot;&amp;Chr(34)&amp;[SP_Lib_Folder_Path]&amp;Chr(34)&amp;&quot;.Trim()&quot;&amp;NewLine()&amp;&quot;if($path.EndsWith(&quot;&amp;Chr(34)&amp;&quot;/&quot;&amp;Chr(34)&amp;&quot;))&quot;&amp;NewLine()&amp;&quot;{$path = $path.Substring(0, $path.Length - 1)}&quot;&amp;NewLine()&amp;&quot;if($path.Contains(&quot;&amp;Chr(34)&amp;&quot;/&quot;&amp;Chr(34)&amp;&quot;))&quot;&amp;NewLine()&amp;&quot;{&quot;&amp;NewLine()&amp;&quot;$folderToCreate = ($path -split &quot;&amp;Chr(34)&amp;&quot;/&quot;&amp;Chr(34)&amp;&quot;)[-1].Trim()&quot;&amp;NewLine()&amp;&quot; $LibraryPath = $path.Substring(0, $path.Length- ($folderToCreate.Length+1)).Trim() &#xA;&quot;&amp;NewLine()&amp;&quot;$items = Get-PnPFolderItem -FolderSiteRelativeUrl $LibraryPath&quot;&amp;NewLine()&amp;&quot;$folderExists = $items | Where-Object { $_.Name -eq $folderToCreate}&quot;&amp;NewLine()&amp;&quot;if( $folderExists)&quot;&amp;NewLine() &#xA;&amp; &quot;{Add-PnPFile -Folder $path&quot;&amp;&quot; -Path &quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;&quot;}&quot;&amp;NewLine()&amp;&quot;else&quot;&amp;NewLine()&amp;&quot;{Add-PnPFolder -Name $folderToCreate -Folder $LibraryPath&quot;&amp;NewLine()&amp;&quot;Add-PnPFile -Folder $path&quot;&amp;&quot; -Path &quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;&quot;}&quot;&amp;NewLine()&amp;&quot;}&quot;&amp;NewLine()&amp;&quot;else{Add-PnPFile -Folder $path&quot;&amp;&quot; -Path &quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="fc51ab7e-64c3-44ac-bd64-957de4a416c7" name="Script" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-420" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="61beb49f-c06a-499b-aa64-d998407ace57" name="SP_Site_URL" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><narrative>Link for site or subsite.</narrative><display x="-540" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c68a83a1-1690-4047-b67c-c231e975dae8" name="SP_Lib_Folder_Path" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-540" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c1b6b7f-a011-4873-90cb-fb9a2bcb1c80" name="FilePath" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><narrative>File Location to upload the file.</narrative><display x="-540" y="105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e36c0ea2-cf16-409b-8fd1-888f490eeb05" name="Run PnP_Script" type="SubSheet"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="75" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>5a689a9a-c43b-4fc1-86a5-818c5673a04c</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="3f7a9098-f668-4bdf-a54d-7a32693ac26c" name="Note3" type="Note"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

****************************************************************************************************
Considering the file from "C:\Apps\Test.xlsx" to be uploaded to "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data)</narrative><display x="-555" y="-210" w="300" h="240" /></stage><stage stageid="2e13720e-ffd8-4647-aa71-730a8b7132f6" name="Script Path" type="Data"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-435" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1899a5f4-1c31-4684-ad6f-196bf7cf47b7" name="Delete_Script" type="Action"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="285" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>156ca2e9-e04b-4c6b-a530-f924cd1f5eb4</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="625310b9-b6b8-4700-9f7a-6ea2acf368e6" name="Download File From SharePoint" type="SubSheetInfo"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><narrative>Help to Download File from Sharepoint.</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="838f61c2-4811-4b69-bc83-6cffb0e3bba3" name="Return Message" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2651d518-3421-47d3-828c-64c846b3cbff" name="Script" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-600" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8d9a47bf-1b3a-4258-a0a4-920173d8b016" name="SP_Site_URL" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="-90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3709c154-7fa9-4d75-b4c0-e7aa7d22cd85" name="SP_Lib_File_Path" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="-60" /><datatype>text</datatype><initialvalue xml:space="preserve">sdsdsa</initialvalue><private /><alwaysinit /></stage><stage stageid="08a54f88-4158-4d30-98f1-173c1d5e8595" name="Dest_Directory" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4054d418-bab6-4e77-ac6e-81ee974385b3" name="Standards" type="Note"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><narrative>Dest_Directory: destination directory where the file will be downloadedC:\Apps

