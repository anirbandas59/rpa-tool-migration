text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f83ecc47-0291-4e1c-975a-0c6d7054cf97" name="Generate Script" type="Calculation"><subsheetid>1f7e1a65-ec7e-4bdb-964b-973be7324f74</subsheetid><display x="-45" y="-60" /><onsuccess>2f3f9579-5812-4730-ad49-c4b9a44ee0af</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp;Chr(34)&amp;[SharePoint URL]&amp;Chr(34)&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;&#xA;$results = @()&quot;&amp;NewLine()&amp;&quot;&#xA;$ExportFile = &quot;&quot;&quot;&amp;[Destination Latest Excel Name Folder Path]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$now= (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;').AddDays(&quot;&amp;[AddDays]&amp;&quot;).AddHours(&quot;&amp;[AddHours]&amp;&quot;).AddMinutes(&quot;&amp;[AddMinutes]&amp;&quot;).AddSeconds(&quot;&amp;[AddSeconds]&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;')&quot;&amp;NewLine()&amp;&quot;    &#xA;        $allItems = Get-PnPListItem -List '&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;' -PageSize 500 &quot;&amp;NewLine()&amp;&quot;&#xA;    &#xA;    foreach($item in $allItems){&quot;&amp;NewLine()&amp;&quot;&#xA;    if ($item[&quot;&quot;FileLeafRef&quot;&quot;] -like &quot;&quot;*.*&quot;&quot; -and ([DateTime]$item[&quot;&quot;Modified&quot;&quot;] -gt $now -And [DateTime]$item[&quot;&quot;Modified&quot;&quot;] -lt $currentDt)) &quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        $results += [PSCustomObject][ordered]@{&quot;&amp;NewLine()&amp;&quot;&#xA;            FileName    = $item[&quot;&quot;FileLeafRef&quot;&quot;] &quot;&amp;NewLine()&amp;&quot;&#xA;                       Modified_Date = [DateTime]$item[&quot;&quot;Modified&quot;&quot;]&quot;&amp;NewLine()&amp;&quot;&#xA;            &#xA;            FilePath    = $item[&quot;&quot;FileRef&quot;&quot;]&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$results | Select FileName, Modified_Date | ConvertTo-Csv -NoTypeInformation | Select-Object -Skip 1 |Set-Content -Path $ExportFile &quot;&#xA;" stage="Script" /></stage><stage stageid="38c1dbb2-6a5a-466b-b87b-f6e2d6afecc8" name="Script" type="Data"><subsheetid>1f7e1a65-ec7e-4bdb-964b-973be7324f74</subsheetid><display x="-300" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d87f0fb4-8167-4857-bd14-0af2a72b702e" name="Success" type="Data"><subsheetid>1f7e1a65-ec7e-4bdb-964b-973be7324f74</subsheetid><display x="-300" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="652b3aa3-c70f-49f0-9256-7f0c0b8699c7" name="Standards" type="Note"><subsheetid>1f7e1a65-ec7e-4bdb-964b-973be7324f74</subsheetid><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

