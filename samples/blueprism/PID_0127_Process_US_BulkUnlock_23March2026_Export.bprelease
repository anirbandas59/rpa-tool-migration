 /><private /><alwaysinit /></stage><stage stageid="215c5fde-c138-4d6d-9b8c-68a6c643e307" name="Delete_Script" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="450" y="75" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>329e292c-f2f0-4d3a-a25d-d45ca050cdc2</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ef1b2002-9b80-46b7-ba93-b16ba94e77bf" name="Validate Temp Script Path" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>dccd5738-1f0f-42d1-b35a-c50678078ae2</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="018b0769-e7b0-4fdb-b740-498f8ed53185" name="Error Message?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Checks if run received exception</narrative><display x="105" y="225" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>4a99e6a0-61cb-4bd0-ab57-08d764938c16</ontrue><onfalse>20a11f7c-4a74-4f22-a886-e08f2e752c09</onfalse></stage><stage stageid="4a99e6a0-61cb-4bd0-ab57-08d764938c16" name="Received exception after running the script" type="Exception"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="210" y="225" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="0105628d-48ed-4f94-8d69-bb50f20942b4" name="Input" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-315" y="60" w="165" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3f723268-7d9b-4777-9835-15b9263b8097" name="Inhouse" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-465" y="60" w="120" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ec7b6214-d923-4732-9329-3cae273ab25a" name="End" type="End"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="495" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Folder Created Successfully&#xA;&quot; will be displayed" stage="Run Report" /><output type="text" name="Error_Message" narrative="On Error &quot; correcsponding  error message &quot; will be displayed" stage="Error_Message" /></outputs></stage><stage stageid="0f342f6d-44b7-49db-a7f3-640ed22d84a3" name="User Name" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91ee6138-bc9f-4355-9c13-2d6102db11d5" name="New_Foldername" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-270" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b22aaa2-3703-4ec6-a637-31773192f382" name="Is folder already Exists?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="225" /><decision expression="InStr(Lower([Run Report]), &quot;already exists&quot;)&gt;0" /><ontrue>41404d70-906f-4d2e-89c7-4462f963b4fc</ontrue><onfalse>018b0769-e7b0-4fdb-b740-498f8ed53185</onfalse></stage><stage stageid="41404d70-906f-4d2e-89c7-4462f963b4fc" name="Message - Folder already exists" type="Calculation"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-75" y="225" /><onsuccess>20a11f7c-4a74-4f22-a886-e08f2e752c09</onsuccess><calculation expression="Replace([Run Report], &quot;ERROR&quot;, &quot;&quot;)" stage="Run Report" /></stage><stage stageid="dfa213dc-e42c-4d29-b9c5-4c96e264de3c" name="Upload File without FSO Access" type="SubSheetInfo"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>It will upload the file without FSO access and update the  metadata.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="15cda6e2-2ba6-411e-b53c-d5f2075b5581" name="Start" type="Start"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="90" y="-255" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Library Name" narrative="Library name in Sharepoint" stage="Library Name" /></inputs><onsuccess>fc009d75-d18c-46f2-9cb2-127a5c354ed8</onsuccess></stage><stage stageid="d1a4f59e-b859-4a3a-9fc9-3d40ca2532d4" name="End" type="End"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="420" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="d5e0909f-beee-4e5a-a67a-8233eb7f4b69" name="Return Message" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-435" y="360" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bf699542-d536-4d1a-9dbe-5c6d2158bd30" name="Build Script" type="Calculation"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="-60" /><onsuccess>f6b344ef-c6bc-425a-a0de-680e4cdb74b6</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$SourceFile=&quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FileStream = ([System.IO.FileInfo] (Get-Item $SourceFile)).OpenRead()&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx = Get-PnPContext&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($ctx.web);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$lists = $ctx.web.lists;$ctx.load($lists);$ctx.executequery();$myList = $lists | Where-Object{$_.Title -eq '___RPA_LIBRARYNAME___'}&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile = new-object Microsoft.SharePoint.Client.fileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.OverWrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.ContentStream = $FileStream&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$newFile.Url = $ctx.web.url + &quot;&amp;Chr(34)&amp;&quot;___RPA_LIBRARYPATH___&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;&#xA;$addFile = $myList.RootFolder.Files.Add($newFile)&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($addFile);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$FileStream.Close()&quot;&#xA;" stage="Script" /></stage><stage stageid="04a672d9-7718-497c-be18-3c3ace021cb9" name="Script" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-315" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65e95c2b-53d8-44b6-908a-5448648674d9" name="SP_Site_URL" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>Link for site or subsite.</narrative><display x="-435" y="195" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="407c8052-eab2-4eb1-b82a-11ad706f2102" name="SP_Lib_Folder_Path" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-435" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d15cd05e-5a2e-443b-acb7-fb024ba1003e" name="FilePath" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>File Location to upload the file.</narrative><display x="-435" y="255" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2d2de81c-08f5-4f6f-8682-9330dc105a59" name="Run PnP_Script" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="150" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>6fd3f066-3704-4e29-a04f-f14202f5fc58</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="c7d9f2fc-6402-444f-8857-fc16833b87b0" name="Note3" type="Note"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

