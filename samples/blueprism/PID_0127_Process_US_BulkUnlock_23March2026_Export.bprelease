ubsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="-375" /><inputs><input type="text" name="Script_Loc" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="Default Script Path" stage="ScriptLocation" /></outputs><onsuccess>2a314ae1-77eb-4bc9-9d7a-ed2bd0404f66</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="9f37f456-602b-4adc-a9d4-5668fa5f22de" name="Validate Temp Script Path" type="SubSheet"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>2e7a2267-5b21-41e4-8ad2-7d243a91e687</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="21cdfa23-4289-49fb-9d0f-15f2ca032756" name="Validate Temp Script Path" type="SubSheet"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>0fc6fcd7-bc45-4b8f-8db6-aee0bf35c5ae</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="5c4ba2f9-fdcd-436d-8596-b1cbec6e1d53" name="Error Message?" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="90" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot;" /><ontrue>22489d82-79a9-44f7-9691-0dc1c1828c3e</ontrue><onfalse>082f05a8-fbf9-47a5-9934-12568db4cce9</onfalse></stage><stage stageid="22489d82-79a9-44f7-9691-0dc1c1828c3e" name="Received exception after running the script" type="Exception"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="210" y="90" /><exception type="Business Exception" detail="[Error_Message]" /></stage><stage stageid="7722b30d-5c97-45f3-ba73-6b6a482c19f2" name="Add_Item_to_List" type="SubSheetInfo"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><narrative>Adds an item to the list and sets the creation time to the current date and time. The author is set to the current authenticated user 
MinAccess:- Add_Edit ( With out delete)</narrative><display x="-420" y="-90" w="150" h="90" /></stage><stage stageid="559a9d93-be6d-4245-bc33-96467feda252" name="Start" type="Start"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="15" y="-165" /><inputs><input type="text" name="SP_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234" stage="SP_Site_URL" /><input type="text" name="List Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Column_name_values" narrative="Provide the Column name and Values in format &quot;Column1&quot;=&quot;Value&quot;;&quot;Column2&quot;=&quot;value2&quot; Ex:- &quot;Emp_Name&quot; =&quot;Abhi&quot;;&quot;Location&quot;=&quot;Chennai&quot;;&quot;DOB&quot; = &quot;03/05/1987&quot;;&quot;Dept&quot; = &quot;Sales&quot;;" stage="LIst_Item_Values" /><input type="text" name="Temp_Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>af3eda2c-95ed-4624-9a1c-146457510ff5</onsuccess></stage><stage stageid="f3faa871-42c9-4edb-a7b8-75b80c6f2680" name="Build Script" type="Calculation"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="15" y="-15" /><onsuccess>7da4a5a3-790d-42da-90cc-9e860999b656</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;$List_Item=Add-PnPListItem -List &quot; &amp;[SP_Target_List] &amp; &quot; -Values @{&quot; &amp; [LIst_Item_Values]&amp; &quot;}&quot; &amp; NewLine() &amp; &#xA;&quot;If ($List_Item.ID -gt 0 )&quot; &amp; NewLine() &amp;&#xA;&quot;{&quot; &amp; NewLine() &amp;&#xA;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;Item ID-&quot;&amp; Chr(34) &amp; &quot;$List_Item.ID&quot; &amp; Chr(34) &amp; &quot; Successfully added &quot;&amp; Chr(34)  &amp; NewLine() &amp;&#xA;&#xA;&#xA; &quot;}&quot; &amp; NewLine() &amp;&#xA;&#xA;&quot;Else&quot; &amp; NewLine() &amp;&#xA;&quot;{ Write-Host &quot; &amp; Chr(34) &amp; &quot; ERROR:- Check List Name&quot; &amp; Chr(34) &amp; &quot;}}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="fb94ed18-debc-49b6-bf99-e66fca662dfc" name="Run PnP_Script" type="SubSheet"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="15" y="180" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>a157bedb-2d87-410b-bbc1-3306df26ea12</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="48d3db3d-a2f0-4450-b359-341682cba5c1" name="Delete_Script" type="Action"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="15" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><outpu