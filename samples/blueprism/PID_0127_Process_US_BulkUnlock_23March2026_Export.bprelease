Element JS" type="Data"><loginhibit onsuccess="true" /><display x="-210" y="765" /><datatype>text</datatype><initialvalue xml:space="preserve">function addElement(){
var childElement = document.getElementById('RPAtextBox');
    if(childElement){
        childElement.parentNode.removeChild(childElement);
    }
    var body = document.getElementsByTagName('Body')[0];
    var textArea = document.createElement('div');
    textArea.setAttribute('id', 'RPAtextBox');
    textArea.setAttribute('style', 'width:200px');
    body.appendChild(textArea);

}

</initialvalue><alwaysinit /></stage><stage stageid="803df02c-cbb5-4f00-8219-07e4a6bde09f" name="Check Jquery Loaded" type="Data"><loginhibit onsuccess="true" /><display x="-210" y="795" /><datatype>text</datatype><initialvalue xml:space="preserve">function CheckJqueryStatus() {
    var status = (typeof jQuery !== 'undefined') ? 'jQuery is loaded' : 'jQuery is NOT loaded';
    document.getElementById('RPAtextBox').innerText = status;
}</initialvalue><alwaysinit /></stage><stage stageid="069a84ee-6d1c-4cfc-9c5d-abf8879c618b" name="Sleep" type="Action"><subsheetid>7b56672a-60f4-4708-acb1-e6a119c2658d</subsheetid><display x="195" y="-150" /><inputs><input type="number" name="Sleep Time (Seconds)" narrative="The time (in seconds) for which to sleep" expr="6" /></inputs><onsuccess>20897f27-b403-4c89-a40e-3dbc4e3b68cd</onsuccess><resource object="Utility - General" action="Sleep" /></stage><stage stageid="d42064ad-c663-4127-97d7-2b2609bc5a7c" name="Load Function CheckJqueryStatus" type="Action"><subsheetid>7b56672a-60f4-4708-acb1-e6a119c2658d</subsheetid><display x="15" y="-75" w="90" h="30" /><inputs><input type="text" name="JSToRun" narrative="JavaScript to run" expr="[Check Jquery Loaded]" /></inputs><onsuccess>2f463666-807c-4b6e-ad2a-3237a716e13c</onsuccess><resource object="Utility_Object_Generic_IE_SharePoint_CommonActions - Edge" action="Run_JS" /></stage><stage stageid="2d656f57-5ac9-4b42-b491-404bdb8f7166" name="Read Textbox Value" type="Action"><subsheetid>7b56672a-60f4-4708-acb1-e6a119c2658d</subsheetid><display x="15" y="60" w="90" h="30" /><outputs><output type="text" name="Txt_FromRPATxtBox" narrative="Read Txt from RPA Text Box" stage="Jquery Loaded?" /></outputs><onsuccess>06cc6f9e-6414-4244-97c0-8e0068790519</onsuccess><resource object="Utility_Object_Generic_IE_SharePoint_CommonActions - Edge" action="ReadAllFilesFromSharePoint" /></stage><stage stageid="8935dc00-153c-4cf8-81bc-99e924d95c6a" name="Jquery Loaded?" type="Data"><subsheetid>7b56672a-60f4-4708-acb1-e6a119c2658d</subsheetid><display x="-270" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06cc6f9e-6414-4244-97c0-8e0068790519" name="If Not Loaded" type="Decision"><subsheetid>7b56672a-60f4-4708-acb1-e6a119c2658d</subsheetid><display x="15" y="120" /><decision expression="InStr([Jquery Loaded?], &quot;not loaded&quot;)&gt;0" /><ontrue>ab90d71d-e5b0-4c9f-a5d9-f7c410f1f524</on