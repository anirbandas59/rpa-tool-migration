"b9426e06-6379-4bc9-8327-b14c3487f230" name="Get all files under Folder Recursive (Including Sub-Folders files)" type="SubSheetInfo"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><narrative>Get all lists or libraries from a site
This action downloads all the files form the folder recursively including sub folder files (the root folder can be either a library/ list/ folder to extract details from). Output is a file either in csv/ txt format as path in Output file path parameter.</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="4e5c48e1-cbfc-4f84-9ec0-fa0a932877bf" name="Return Message" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="543bee93-5efa-4fc8-8f84-b983ba1f260f" name="Script" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-600" y="-30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b91afc84-6aa0-43cd-bfc9-54979f36f4ef" name="Unexpected exception recover" type="Recover"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-15" y="225" /><onsuccess>8381072e-b489-40ef-8bea-4782aab8102c</onsuccess></stage><stage stageid="534f9f38-edcd-4cce-827d-a499969e71d5" name="Unexpected Exception" type="Exception"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="225" y="225" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="424bd6b7-6db1-4466-9c91-df6596c83712" name="Script Path" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-600" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c0a8e753-35e0-4454-812d-7ce05f1d5bac" name="Start" type="Start"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="-270" /><inputs><input type="text" name="Script Location" narrative="Folder Location to create script(Ex:- C:\Apps\PID1)" stage="ScriptLocation" /><input type="text" name="Base URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="Base URL" /><input type="text" name="Folder Relative URL" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="Folder Relative URL" /><input type="text" name="OutputFilePath" narrative="Enter the name of the file that is created to save the output" stage="Output File Path" /></inputs><onsuccess>1cc89791-621e-42a3-a2b9-636ca0848363</onsuccess></stage><stage stageid="5642ad24-3950-4ed4-b46c-21ba06d734e0" name="End" type="End"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="495" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /><output type="text" name="File Path" narrative="Returns downloaded file complete file path" stage="Output File Path" /></outputs></stage><stage stageid="84a823fa-48c7-48e2-89f8-ba4b6b2dc647" name="Run PnP_Script" type="SubSheet"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="60" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>06615639-c8f4-4d07-9126-1bb51727873e</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="4f1b9021-bb88-48d3-8c70-d25d1a26fc76" name="Delete_Script" type="Action"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>5642ad24-3950-4ed4-b46c-21ba06d734e0</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="1eb7ac0e-1dc8-4aa8-a25e-440fa1f4c5f7" name="Generate_PnPScript" type="SubSheet"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;GetallfilesunderFolderRecursive&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>8fc5a596-8d86-4016-93af-30d394de1f1d</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="8fc5a596-8d86-4016-93af-30d394de1f1d" name="Check_Error" type="Decision"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="0" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>2058a441-f671-462e-abae-10378ea9bb3d</ontrue><onfalse>84a823fa-48c7-48e2-89f8-ba4b6b2dc647</onfalse></stage><stage stageid="2058a441-f671-462e-abae-10378ea9bb3d" name="Exception while creating  Script" type="Exception"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-30" y="0" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="6a73bf5f-576a-44df-85