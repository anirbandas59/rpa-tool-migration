e8-f0da47d5fe0d</ontrue><onfalse>181c5635-526a-420d-8062-3005c7f7cc69</onfalse></stage><stage stageid="544731a8-ff61-45f9-94e8-f0da47d5fe0d" name="Set_Default_Loc" type="Calculation"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="390" y="-180" /><onsuccess>63ad594d-d58b-4376-a025-6ef5ff9cc2fc</onsuccess><calculation expression="[Script_Location]" stage="Result_File_location" /></stage><stage stageid="63ad594d-d58b-4376-a025-6ef5ff9cc2fc" name="Anchor21" type="Anchor"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="390" y="-135" w="10" h="10" /><onsuccess>181c5635-526a-420d-8062-3005c7f7cc69</onsuccess></stage><stage stageid="181c5635-526a-420d-8062-3005c7f7cc69" name="Anchor22" type="Anchor"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="315" y="-135" w="10" h="10" /><onsuccess>bb778773-af82-408e-affd-add0b26bff0f</onsuccess></stage><stage stageid="71011767-f364-4a58-b984-553032f8fe1f" name="Build Script" type="Calculation"><subsheetid>fb2f5d95-347a-48e6-a9d7-9a6c1e54e22e</subsheetid><display x="15" y="15" /><onsuccess>b95dcee1-c9aa-4e1c-82bd-e343ad93fa94</onsuccess><calculation expression="&quot;$outputfile= &quot; &amp; Chr(34)  &amp;[Result_File_location] &amp; &quot;\Result.csv&quot;&amp; Chr(34) &amp; NewLine() &amp; &#xA;&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;if (Test-Path $outputfile -PathType Leaf)&quot;&amp; NewLine() &amp; &#xA;&quot;    {&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;        Remove-Item $outputfile -Force&quot;&amp; NewLine() &amp; &#xA;        &#xA;&quot;    }&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else { New-Item $outputfile -ItemType File -ErrorAction Stop }&quot;&amp; NewLine() &amp; &#xA;&quot;$items=(Get-PnPListItem -List $SourceName -ErrorAction Stop) &quot;&amp; NewLine() &amp; &#xA;&quot;Add-Content &quot; &amp;&quot; $outputfile -Value '&quot; &amp; [Headers] &amp; &quot; ' &quot; &amp; NewLine() &amp;&#xA;&quot;foreach($itm in $items) {&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$str = &quot; &amp; [Field_Qry] &amp; NewLine() &amp;&#xA;&#xA;&#xA;&quot;Add-Content &quot; &amp; &quot; $outputfile $str &quot; &amp; NewLine() &amp;&#xA;&#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;Write-Host &quot; &amp; Chr(34)&amp; &quot;Completed. result stored in &quot; &amp;Chr(34) &amp; &quot;$outputfile }&quot; &amp; NewLine() &amp;&#xA;&#xA;&#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="2e9b4c9f-a91f-4921-92f0-570dfb7a966c" name="Run PnP_Script" type="SubSheet"><subsheetid>fb2f5d95-347a-48e6-a9d7-9a6c1e54e22e</subsheetid><display x="15" y="165" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>2deacd4e-5e8f-48a3-8d5d-2a3c65fc7e13</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="aa51ba40-eee8-4fa1-be61-0becf8324c02" name="Delete_Script" type="Action"><subsheetid>fb2f5d95-347a-48e6-a9d7-9a6c1e54e22e</subsheetid><display x="15" y="420" /