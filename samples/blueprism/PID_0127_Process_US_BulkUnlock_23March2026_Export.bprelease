</narrative><display x="-345" y="-105" w="150" h="90" /></stage><stage stageid="64aacd5d-f6c1-4581-9ea4-1804646057e2" name="Start" type="Start"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="75" y="-360" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_Lib_File_Location" narrative="Library with folder (Ex:- sites/AAAAB2827/)  Note: It should start from sites  " stage="Sp_Lib_Folder" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="File name to checkout" narrative="Exact file name to be checked out" stage="File Name" /></inputs><onsuccess>be15cb23-1ac3-487a-b3ba-8e024a2103bc</onsuccess></stage><stage stageid="228a0870-7636-4a23-ab0f-62451b4bfac8" name="SP_Site_URL" type="Data"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="-360" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6135845c-6d3e-43d6-af57-a2463628a2d1" name="Sp_Lib_Folder" type="Data"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="-285" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1ec01d4-d687-4fc8-9a97-bd99258fede6" name="File Name" type="Data"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="-360" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23d003d9-e182-4c6d-b7da-e5403129e473" name="Block7" type="Block"><subsheetid>2eeb4105-e5fb-44da-9cf9-75ef1586d122</subsheetid><display x="-405" y="-15" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="466c2e61-d0a7-4f3