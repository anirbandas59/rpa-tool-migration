b3c-7fef64fbb95a" name="Processed" type="Data"><display x="-540" y="-135" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9e7e35a9-22bf-4130-9b08-f65335c0404c" name="TotalFiles" type="Data"><display x="-375" y="-225" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="34658b03-b7cb-4cc9-b948-2336c3f4d0d6" name="Block3" type="Block"><display x="0" y="270" w="360" h="495" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="27d074fc-ed41-43d3-805e-207441d22937" name="CurAttempt" type="Data"><display x="-540" y="-225" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="920cc955-cd3e-4760-84e6-12659389b711" name="MaxAttempt" type="Data"><display x="-540" y="-90" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d10cd2f7-4a7a-421a-9c75-38bf5ab40c09" name="sProcessed" type="Data"><display x="-375" y="-135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f9f0bca-df92-4850-b30a-78bbd09d23f4" name="sAttempt" type="Data"><display x="-375" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="156dcb93-fed5-4df3-9579-4658872cfa72" name="ReturnStatus" type="Data"><display x="-375" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9e57d87-a5e8-451e-b1a5-8ae2e50137b7" name="Populate Queue" type="SubSheetInfo"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>Populate Queue</narrative><display x="-210" y="-150" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="d26889cb-6b53-4584-9973-52e644b2d915" name="Start" type="Start"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="-210" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="QueCollection" narrative="QueCollection" stage="Parent_Q" /></inputs><onsuccess>0faf4398-4fe1-4f8b-83ee-f1ea103c06f1</onsuccess></stage><stage stageid="57a94569-a666-4890-9866-3b5940b4a672" name="End" type="End"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="360" /><font family="Tahoma" size="10" style="Regular" color="000000" /><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="cb8268f2-df68-4eda-b94d-071bb2ce9e5a" name="Lock Token" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-300" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="54b6a80c-1fc4-4315-83d3-9caf0385b937" name="Aquire Lock" type="Action"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>Acquires the lock associated with the given name. If this session already holds the required lock, it will be re-acquired with a new token</narrative><display x="15" y="-75" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Name" narrative="The name of the required lock. Mandatory parameter." expr="[Lock Name]" /><input type="timespan" name="Timeout" narrative="The maximum amount of time to await the lock. Default is to wait forever" expr="MakeTimeSpan(0, 0, 0, 0)" /><input type="text" name="Preferred Token" narrative="The preferred token to use for the lock. Default behaviour is to generate a new unique token." expr="[Lock Token]" /><input type="text" name="Comment" narrative="The comments to set on the lock" expr="" /></inputs><outputs><output type="text" name="Token" narrative="The token registered against the lock. This will be empty if the lock could not be acquired" stage="Lock Token" /></outputs><onsuccess>ccfb84d9-6814-4595-8deb-feff0c03c051</onsuccess><resource object="BluePrism.AutomateAppCore.clsEnvironmentLockingBusinessObject" action="Acquire Lock" /></stage><stage stageid="8469c43e-a0ee-4e8a-a4d2-edbeafe87d34" name="Populate Queue Settings" type="Block"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-495" y="-60" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ccfb84d9-6814-4595-8deb-feff0c03c051" name="Got Lock?" type="Decision"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Lock Token]&lt;&gt;&quot;&quot;" /><ontrue>c1ccddda-fcfa-4aaf-bb9c-f53b26765c2d</ontrue><onfalse>a058b5b2-2f11-456a-8c18-1b77945ce43b</onfalse></stage><stage stageid="3005dee6-62ee-492b-b47f-c0ab62962a95" name="Load Work Block" type="Block"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-90" y="15" w="360" h="300" /><font family="Tahoma" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6f076cd7-3920-4d93-a766-6e12c4f657f2" name="Recover" type="Recover"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="210" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>cabffac1-2077-4c23-9877-c456e3d51bbc</onsuccess><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="cabffac1-2077-4c23-9877-c456e3d51bbc" name="Release Lock" type="Action"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>Releases the lock(s) associated with the given name and token</narrative><display x="330" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Name" narrative="The name of the specific lock to be released. Default behaviour is to release all locks with the given token." expr="[Lock Name]" /><input type="text" name="Token" narrative="The token associated with the lock(s) to be released. Mandatory parameter." expr="[Lock Token]" /><input type="text" name="Comment" narrative="The comments to set on the lock(s)" expr="" /><input type="flag" name="All Sessions" narrative="True to release locks matching the specified constraints across all sessions; False to only release locks acquired in the current session. Default is False" expr="True" /></inputs><onsuccess>631a49f3-2293-413e-9e35-20a3a0a1fe24</onsuccess><resource object="BluePrism.AutomateAppCore.clsEnvironmentLockingBusinessObject" action="Release Lock" /></stage><stage stageid="631a49f3-2293-413e-9e35-20a3a0a1fe24" name="Throw" type="Exception"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="420" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="fe5f11c4-5ed6-4179-953b-34102b684e62" name="Release Lock" type="Action"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>Releases the lock(s) associated with the given name and token</narrative><display x="15" y="285" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Name" narrative="The name of the specific lock to be released. Default behaviour is to release all locks with the given token." expr="[Lock Name]" /><input type="text" name="Token" narrative="The token associated with the lock(s) to be released. Mandatory parameter." expr="[Lock Token]" /><input type="text" name="Comment" narrative="The comments to set on the lock(s)" expr="" /><input type="flag" name="All Sessions" narrative="True to release locks matching the specified constraints across all sessions; False to only release locks acquired in the current session. Default is False" expr="True" /></inputs><onsuccess>57a94569-a666-4890-9866-3b5940b4a672</onsuccess><resource object="BluePrism.AutomateAppCore.clsEnvironmentLockingBusinessObject" action="Release Lock" /></stage><stage stageid="0adbc031-d17f-4230-b4aa-62251e4e44d0" name="qCount" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-315" y="30" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3f6dd854-8b5f-4198-ab01-dc87c595cf84" name="sCount" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-210" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f80e5761-e77b-4443-b273-cbfdac70bb40" name="Add to Queue" type="Action"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>The Data collection contains the items to be added to the queue. The collection may contain single or multiple rows, with each representing an item to be added.

If there is a failure during the process, the queue will be unchanged - i.e. no rows will be loaded even if the error occurred on the last one.

If Defer Until is specified, the items will not be available to be worked until then. Otherwise, they are available immediately.

If the queue has a key field defined, an item added has key data longer than the maximum permitted 255 characters, an error will occur</narrative><display x="15" y="195" /><inputs><input type="text" name="Queue Name" narrative="The name of the queue to add items to" expr="[Parent Queue Name]" /><input type="collection" name="Data" narrative="A collection containing the data, one row for each item to be added" expr="[Parent_Q_SingleRow]" /><input type="datetime" name="Defer Until" narrative="Optionally, the date/time the new item(s) should be deferred until" expr="" /><input type="number" name="Priority" narrative="Optionally, the priority for the new item(s). Lower numbers represent higher priorities. The default is 0." expr="" /><input type="text" name="Tags" narrative="Optionally, a semi-colon-separated set of tags to apply to the queue item(s)" expr="&quot;NEW&quot;" /><input type="text" name="Status" narrative="Optionally, the initial status required of the work queue item(s) " expr="&quot;NEW&quot;" /></inputs><outputs><output type="collection" name="Item IDs" narrative="The IDs of the items which have been added to the queue, in the order of the collection of data passed that was input" stage="Item IDs" /></outputs><onsuccess>63d592f1-4ef9-4afc-b76c-11242aad75a9</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Add To Queue" /></stage><stage stageid="1c341791-30dd-4447-be03-7a651d23c617" name="Item IDs" type="Collection"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Item ID" type="text" description="The Item ID of the work queue item" /></collectioninfo></stage><stage stageid="0faf4398-4fe1-4f8b-83ee-f1ea103c06f1" name="LockName" type="Calculation"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="-135" /><onsuccess>54b6a80c-1fc4-4315-83d3-9caf0385b937</onsuccess><calculation expression="[Queue Name]" stage="Lock Name" /></stage><stage stageid="343bd929-2c02-46fb-9d9b-e51098e8f5b6" name="MaxTries" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-405" y="105" w="120" h="30" /><datatype>number</datatype><initialvalue>10</initialvalue><private /><alwaysinit /></stage><stage stageid="6c712661-2456-4fac-bf46-3ba9dc158802" name="ReturnStatus" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-300" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Success</initialvalue><private /><alwaysinit /></stage><stage stageid="a058b5b2-2f11-456a-8c18-1b77945ce43b" name="End5" type="End"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="420" y="-15" /></stage><stage stageid="dd53c7f8-3b1d-4105-82d3-a5639242eb0c" name="Parent_Q" type="Collection"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-420" y="-15" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Sno" type="text" /><field name="URL" type="text" /><field name="BaseConnection" type="text" /><field name="BaseFolderURL" type="text" /><field name="SiteURL" type="text" /><field name="ListTitle" type="text" /></collectioninfo></stage><stage stageid="04803c9b-b218-4311-b9ca-0066c7931b8c" name="Check if Exist" type="Action"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><narrative>Check if an item with the given key is already in the queue</narrative><display x="15" y="105" /><inputs><input type="text" name="Queue Name" narrative="The name of the queue to check" expr="[Parent Queue Name]" /><input type="text" name="Key" narrative="The key to check." expr="[Parent_Q.Sno]" /><input type="flag" name="Include Pending" narrative="Check any items in the queue which are currently awaiting being worked. This will include any deferred items which have a deferral date in the past and any locked items. Optional - Default is True" expr="True" /><input type="flag" name="Include Deferred" narrative="Check any items in the queue which are currently deferred to a later date. Optional - Default is True" expr="" /><input type="flag" name="Include Completed" narrative="Check any items in the queue which are completed. Optional - Default is True" expr="True" /><input type="flag" name="Include Terminated" narrative="Check any items in the queue which have been fully terminated. Optional - Default is True" expr="Trim([ConfigFileData.Include_Terminated])" /></inputs><outputs><output type="collection" name="Item IDs" narrative="The Item IDs which represent the work items found with the given key" stage="Item IDs" /><output type="flag" name="Result" narrative="True if an item with the given key is in the queue, False otherwise." stage="Result" /></outputs><onsuccess>6cd12e8c-674a-4975-be45-c8a53e54ca09</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Is Item In Queue" /></stage><stage stageid="6cd12e8c-674a-4975-be45-c8a53e54ca09" name="If Exist" type="Decision"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="150" /><decision expression="[Result]" /><ontrue>230bf1fe-6269-4ea0-acfb-23d2fc44609b</ontrue><onfalse>6a317b2c-9713-4030-8a53-6c3839c88b9e</onfalse></stage><stage stageid="a22741d6-b5cd-4798-85e7-fc7cd2f8a2ee" name="Result" type="Data"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-420" y="30" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b3be4ae4-2f73-4f1c-89d7-9e7db4d4baa2" name="Parent Queue Name" type="Data"><display x="-390" y="765" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="7e8a1674-75a5-49f3-beb5-fb54b433e593" name="Populate Queue - Child" type="SubSheetInfo"><subsheetid>22f0d39b-1a59-430e-bf16-5b227cd1c8aa</subsheetid><narrative>Populate Queue</narra