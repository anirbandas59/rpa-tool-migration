Next
Output_Collection = Input_Collection]]></code></stage><stage stageid="c37487be-76d3-44b0-bbb7-2afc05814e34" name="End" type="End"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><loginhibit /><display x="0" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Output Collection" narrative="The collection with Trimmed column names" stage="Output Collection" /></outputs></stage><stage stageid="d9979a75-1aca-4d17-8c0b-dedb3dcb9a66" name="Input Collection" type="Collection"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><display x="-195" y="-75" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="2fdf2c74-3353-4c0a-a220-54fcf8692d42" name="Start" type="Start"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="The collection will have fields with no dots." /></postconditions><display x="0" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Input Collection" narrative="The collection with unwanted spaces in headers" stage="Input Collection" /></inputs><onsuccess>55217e84-df71-46e4-a4da-7fd7303a1b5f</onsuccess></stage><stage stageid="fc8f2e73-85fe-4b01-b910-c01448720294" name="Note1" type="Note"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><loginhibit /><narrative>Inputs</narrative><display x="-195" y="-120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e5299bc9-6c4e-4b6f-b441-c6dc4a80f852" name="Output Collection" type="Collection"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><display x="-195" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a858167d-8f8a-4a8f-9e91-e5e6e9b0c6be" name="Note1" type="Note"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><loginhibit /><narrative>Outputs</narrative><display x="-195" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="99ffb58d-eecc-43e3-8af0-5368de77ebda" name="Trim Collection Values" type="SubSheetInfo"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><narrative>Object to Trim additional space from collection</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="86ca3c09-b7cc-4845-8024-dd2e41e7c560" name="Start" type="Start"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><preconditions><condition narrative="None" /></preconditions><postconditions><condition narrative="Output Collection will have additional space removed from beginning and end of each value in collection field specified" /></postconditions><display x="15" y="-105" /><inputs><input type="collection" name="Input Collection" narrative="Collection with duplicates" stage="Input_Collection" /><input type="text" name="Column Name" narrative="Column Name to Remove Duplicates" stage="Column_Name" /></inputs><onsuccess>ec98336b-e748-4668-b964-231e799d0f32</onsuccess></stage><stage stageid="ff7d9d88-64aa-4b96-a162-867cec116bb8" name="End" type="End"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Output Collection" narrative="Output Colelction Name" stage="Output_Collection" /></outputs></stage><stage stageid="ec98336b-e748-4668-b964-231e799d0f32" name="Trim Collection Values" type="Code"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="60" /><inputs><input type="collection" name="input_collection" expr="[Input_Collection]" /><input type="text" name="column_name" expr="[Column_Name]" /></inputs><outputs><output type="collection" name="output_collection" stage="Output_Collection" /></outputs><onsuccess>ff7d9d88-64aa-4b96-a162-867cec116bb8</onsuccess><code><![CDATA[Dim newvar as string

Dim aRowData As String

output_collection = new DataTable()

output_collection.Columns.Add(column_name, GetType(String))

For Each aRow as DataRow In input_Collection.Rows

aRowData = CStr(aRow(column_name))

newvar = aRowData.Trim()


output_collection.Rows.Add(newvar)

Next

]]></code></stage><stage stageid="4acb13d1-a7b3-460b-af16-867c1ed16c69" name="Output_Collection" type="Collection"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><display x="150" y="-15" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="927fa367-fc33-4a08-9554-5fefb365352a" name="Input_Collection" type="Collection"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="150" y="-75" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="56e3d02d-1b0f-4481-a774-2a303d16e704" name="Column_Name" type="Data"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="150" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d39afaa1-fc26-4099-a160-fdac1b82b893" name="Input Parameters" type="Block"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="90" y="-120" w="120" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7cd989da-daf7-4aa8-a886-ff3c7e4cc1d1" name="Exception" type="Exception"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><display x="-135" y="90" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="b2ce5b3b-fc3e-4888-99e8-49971a62fb49" name="Recover" type="Recover"><subsheetid>d1dd82c9-68be-446d-b5d1-e2551d98326b</subsheetid><loginhibit /><display x="-135" y="0" /><onsuccess>7cd989da-daf7-4aa8-a886-ff3c7e4cc1d1</onsuccess></stage><stage stageid="bc2e496d-e693-4af5-850b-69af96d5ae7b" name="Populate All Days in Current Month" type="SubSheetInfo"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><narrative>Populates all days in current month into a collection</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="4574d34b-a646-4e9c-b738-485d1c1d7dd6" name="End" type="End"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="Number of Days" narrative="Number of Days in Month" stage="Num Days" /><output type="collection" name="Output Collection" narrative="Output Collection with all dys in current month" stage="Ouput Collection" /></outputs></stage><stage stageid="7ec355ce-da81-4e6c-a393-54e1ca4dbf9e" name="Populate Dates" type="Code"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="field_name" expr="[Field Name]" /><input type="text" name="date_format" expr="[Date Format]" /></inputs><outputs><output type="collection" name="output_collection" stage="Ouput Collection" /><output type="number" name="Num_Days" stage="Num Days" /></outputs><onsuccess>4574d34b-a646-4e9c-b738-485d1c1d7dd6</onsuccess><code><![CDATA[Dim i as Integer
Dim newvar as string

output_collection = new DataTable()

output_collection.Columns.Add(field_name, GetType(String))

Num_Days = System.DateTime.DaysInMonth(Today.Year, Today.Month)

For i = 1 To Num_Days
newvar = Format(DateSerial(Today.Year, Today.Month, i),date_format)
output_collection.Rows.Add(newvar)

Next i
]]></code></stage><stage stageid="4981a080-b65f-4995-b66d-1931207f2cff" name="Start" type="Start"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><preconditions><condition narrative="None" /></preconditions><postconditions><condition narrative="None" /></postconditions><display x="15" y="-105" /><inputs><input type="text" name="Field Name" narrative="Field Name for Ouput Collection " stage="Field Name" /><input type="text" name="Date Format" narrative="Date Format for Output Collection" stage="Date Format" /></inputs><onsuccess>7ec355ce-da81-4e6c-a393-54e1ca4dbf9e</onsuccess></stage><stage stageid="2ea3414d-509a-4494-95af-7a681cea80f3" name="Field Name" type="Data"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><display x="-405" y="0" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7974108d-a1cb-4848-a2a9-14ba89e3b0f7" name="Num Days" type="Data"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><display x="-405" y="165" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a045aeed-74ea-4864-a79b-407034b52f7a" name="Ouput Collection" type="Collection"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><display x="-405" y="195" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="2447ee11-57cf-4f30-a947-5e2aeb847e9b" name="Input Parameters" type="Block"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><display x="-465" y="-30" w="120" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="67d51156-b2f7-497d-974d-4f58b2708a2c" name="Output Parameters" type="Block"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><display x="-465" y="120" w="120" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="d50fc8dd-dc53-496b-b628-3f7144bf8dd7" name="Recover" type="Recover"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><display x="225" y="-60" /><onsuccess>b333577f-06ac-41a8-b14b-5185197c3189</onsuccess></stage><stage stageid="b333577f-06ac-41a8-b14b-5185197c3189" name="Exception" type="Exception"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><display x="225" y="30" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="12b0c889-54a9-415c-ac51-6525054b363e" name="Date Format" type="Note"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><loginhibit /><narrative>Note that date format is case sensetive

eg1. dd/MM/yyyy
eg2. ddMMyyyy

If no value is given to Date Format, System date format will be used by Blueprism</narrative><display x="-195" y="45" w="180" h="90" /></stage><stage stageid="cbc0dbe4-921c-441e-ab5f-1f459105222f" name="Date Format" type="Data"><subsheetid>67206203-ca6e-425c-9008-450b7f332b3f</subsheetid><display x="-405" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="da7fad82-1749-4360-afd8-90b648098613" name="Transpose Rows &amp; Columns" type="SubSheetInfo"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><narrative>Transposes Rows &amp; Columns of a collection with only 2 columns in the original collection</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8ee4c495-f8fc-43f9-8348-135093116245" name="Start" type="Start"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="collection" name="In_Collection" narrative="In_Collection" stage="In_Collection" /></inputs><onsuccess>74ecdefd-3853-4a2a-8188-b95ab513bd50</onsuccess></stage><stage stageid="b1f57adb-494e-4721-bf87-307ea0ebf4dd" name="End" type="End"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Out_Collection" narrative="Out_Collection" stage="Out_Collection" /></outputs></stage><stage stageid="74ecdefd-3853-4a2a-8188-b95ab513bd50" name="Transpose Collection" type="Code"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="collection" name="coll_Original" expr="[In_Collection]" /></inputs><outputs><output type="collection" name="coll_Transposed" stage="Out_Collection" /></outputs><onsuccess>95d86fd0-ba3a-4d9e-a4f5-a5261d9b9069</onsuccess><code><![CDATA[coll_Transposed = Transpose(coll_Original)]]></code></stage><stage stageid="4028db8d-45a9-4917-82f9-ddabc69b4f0c" name="In_Collection" type="Collection"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="-195" y="0" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="27f3c5e2-d6e1-4945-8d4a-4e487c86c271" name="Out_Collection" type="Collection"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="-195" y="45" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="95d86fd0-ba3a-4d9e-a4f5-a5261d9b9069" name="Set Column Names From First Row" type="SubSheet"><subsheetid>76f9a14b-ef77-483f-89f0-08d847a98860</subsheetid><loginhibit /><display x="15" y="45" /><inputs><input type="collection" name="Input Collection" narrative="The collection with the column to rename" expr="[Out_Collection]" /></inputs><outputs><output type="collection" name="Output Collection" narrative="The amended collection" stage="Out_Collection" /></outputs><onsuccess>b1f57adb-494e-4721-bf87-307ea0ebf4dd</onsuccess><processid>b8e3b975-d485-49a3-b962-864d13a96e05</processid></stage><stage stageid="d8838f7e-0cdf-4c03-b1cd-deb85599ba28" name="Remove Duplicates based on Field" type="SubSheetInfo"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><narrative>This action will first sort the collection in ascending order with the Field specified. Then it will remove any duplicated row of data based on data in the Field specified.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="fcdc21bb-bbfb-4a3f-be16-65bfa34b9d87" name="Start" type="Start"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><loginhibit /><preconditions><condition narrative="No Preconditions" /></preconditions><postconditions><condition narrative="Sorted collection with duplicates removed " /></postconditions><display x="15" y="-105" /><inputs><input type="collection" name="Collection_In" narrative="The collection to be processed" stage="Collection_In" /><input type="text" name="Collection_Field" narrative="The collection field that you would want to remove duplicates" stage="Header" /></inputs><onsuccess>a1fc7cff-7b37-4298-a18f-3f76276cce49</onsuccess></stage><stage stageid="4a25325d-924b-4b32-8479-c51abe137868" name="End" type="End"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Collection_Out" narrative="Resulted collection after remove duplicates" stage="Collection_Out" /></outputs></stage><stage stageid="a1fc7cff-7b37-4298-a18f-3f76276cce49" name="Remove Duplicates" type="Code"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><loginhibit /><display x="15" y="-30" /><inputs><input type="collection" name="Collection_In" expr="[Collection_In]" /><input type="text" name="Header" expr="[Header]" /></inputs><outputs><output type="collection" name="Collection_Out" stage="Collection_Out" /></outputs><onsuccess>4a25325d-924b-4b32-8479-c51abe137868</onsuccess><code><![CDATA[Dim prevData as String
Dim iRow as integer

prevData = "Dummy"

'Sort the column first
Collection_In.DefaultView.Sort = Header & " ASC"
Collection_In = Collection_In.DefaultView.ToTable

' Loop through each row
For iRow = Collection_In.Rows.Count - 1 to 0 step -1
	
	'check if current value existed in previous row
	if Trim(Collection_In.Rows(iRow)(Header).ToString()) = prevData then
		Collection_In.Rows.Remove(Collection_In.Rows(iRow))
	end if
	'Store current value to be compared for next row
	prevData = Collection_In.Rows(iRow)(Header).ToString()
Next

'output collection
Collection_Out = Collection_In.Copy]]></code></stage><stage stageid="f50ef7d5-cdf2-47b2-8e9a-b08a81dcc8ce" name="Collection_Out" type="Collection"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><display x="90" y="90" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a372aabf-ac49-456c-92d3-b22fee7c0fda" name="Collection_In" type="Collection"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><display x="90" y="-105" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="c286c028-a0bf-4d29-88f9-9da6dafb96ff" name="Header" type="Data"><subsheetid>f6397916-b409-42e3-a45e-35e01ae52387</subsheetid><loginhibit /><display x="165" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff1f8cd8-aa7a-48c2-b730-b16c35017865" name="Get Unique values of a Field" type="SubSheetInfo"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><narrative>Returns a collection with specified field, containing only its unique values in sorted order - ascending (removes deplicates in a single field)</narrative><display x="-150" y="-105" w="150" h="60" /></stage><stage stageid="9cd20345-b91e-4ffe-b9a7-6398cc4c3566" name="Start" type="Start"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="45" y="-75" /><inputs><input type="collection" name="Input Collection" narrative="Input collection " stage="Collection In" /><input type="text" name="Field Name" narrative="Name of the collection field to get unique values" stage="FieldName" /></inputs><onsuccess>45edc737-dea4-4a7a-afa4-4599c8c0cc5f</onsuccess></stage><stage stageid="e91db187-34d0-4f74-bd19-e5e17477f826" name="End" type="End"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="45" y="60" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection with unique values of a field" stage="Collection Out" /></outputs></stage><stage stageid="3aae7924-3bdd-44d4-9fa2-b17aae3d69de" name="Collection In" type="Collection"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><display x="-150" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="de63f1dc-d237-40d8-8ea5-8c42af956916" name="Collection Out" type="Collection"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><display x="-150" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="45edc737-dea4-4a7a-afa4-4599c8c0cc5f" name="Get Unique values in a Field" type="Code"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="45" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Collection In" expr="[Collection In]" /><input type="text" name="FieldName" expr="[FieldName]" /></inputs><outputs><output type="collection" name="Collection Out" stage="Collection Out" /></outputs><onsuccess>e91db187-34d0-4f74-bd19-e5e17477f826</onsuccess><code><![CDATA[Dim iRow as integer
Dim iCol as integer

Dim prevData = ""

' Loop through each column
For iCol = Collection_In.Columns.Count - 1 to 0 step -1
	If Collection_In.Columns(iCol).ColumnName <> FieldName
		Collection_In.Columns.Remove(Collection_In.Columns(iCol))
	End If
Next

'Sort the field
Collection_In.DefaultView.Sort = FieldName
Collection_In = Collection_In.DefaultView.ToTable

'Loop through each row to retain unique values
if Collection_In.Rows.Count > 1 then
	prevData = Trim(Collection_In.Rows(Collection_In.Rows.Count - 1)(FieldName).ToString())
	For iRow = Collection_In.Rows.Count - 2 to 0 step -1
		'check if current value existed in previous row
		If Trim(Collection_In.Rows(iRow)(FieldName).ToString()) = prevData then
			Collection_In.Rows.Remove(Collection_In.Rows(iRow))
		End If
		'Get the new value as the Previous value
		prevData = Collection_In.Rows(iRow)(FieldName).ToString()
	Next
End if

'Set output parameter
Collection_Out = Collection_In.Copy]]></code></stage><stage stageid="c0e7bac9-96d7-4028-b90c-37c5bd1155e3" name="Input parameters" type="Block"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="-225" y="-60" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="4e754b1d-3189-4c49-b12c-8369e212da32" name="Output parameters" type="Block"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="-225" y="60" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="cc59e4e7-0684-44fe-983a-bcb1722a0e5d" name="FieldName" type="Data"><subsheetid>e609f9e7-3693-4bd0-a10b-e0258e59567f</subsheetid><loginhibit /><display x="-150" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4304025-ae26-4bd1-b902-09c24e096583" name="Collection to HTML Table" type="SubSheetInfo"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><narrative>This action is to convert collection into HTML Table</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="3bf9a21b-4d55-49b1-8ae4-c2277c8e9a92" name="Start" type="Start"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><preconditions><condition narrative="Collection as input" /></preconditions><postconditions><condition narrative="html table as text output" /></postconditions><display x="15" y="-105" /><inputs><input type="collection" name="Input Collection" narrative="Collection to be converted to HTML table" stage="in_collection" /><input type="flag" name="Bolded Header?" narrative="Flag to enable bolding of header, defaulted to False" stage="header_bold" /><input type="text" name="Header Colour" narrative="HTML Colour for header font, leave it blank for black" stage="header_colour" /><input type="text" name="Text Align" narrative="Alignment of text in table. Default value: center. Other values: left, right" stage="text_align" /></inputs><onsuccess>f964c44e-1331-4379-811e-3b1dbcbd8473</onsuccess></stage><stage stageid="d68ad622-8019-4c30-b011-44c83ccb36b8" name="End" type="End"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Output HTML Table" narrative="Text in HTML format for table" stage="out_html_table" /></outputs></stage><stage stageid="f964c44e-1331-4379-811e-3b1dbcbd8473" name="Generate HTML Table" type="Code"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><narrative>Code to convert Collection to HTML string</narrative><display x="15" y="-30" /><inputs><input type="collection" name="in_coll" expr="[in_collection]" /><input type="text" name="header_colour" expr="[header_colour]" /><input type="flag" name="header_bold" expr="[header_bold]" /><input type="text" name="text_align" expr="[text_align]" /></inputs><outputs><output type="text" name="out_html" stage="out_html_table" /></outputs><onsuccess>d68ad622-8019-4c30-b011-44c83ccb36b8</onsuccess><code><![CDATA[Dim sb As New System.Text.StringBuilder

sb.Append("<style>table, th, td {border-collapse: collapse; border: 1px solid black;padding: 5px;")

if text_align<>"" then
	sb.Append("text-align:"& text_align & ";")
Else
	sb.Append("text-align: center;")
End if

sb.Append("}</style>")

if in_coll.Rows.Count>0 then
	sb.Append("<table style=""width:100%&"">")
	sb.Append("<tr>")

	for each dc As DataColumn in in_coll.Columns
			if header_colour <> "" then
				sb.Append("<th style=""color:"& header_colour &";"">")
			else
				sb.Append("<th>")
			End If
			if header_bold then
				sb.Append("<b>")
			End If
			sb.Append(dc.ColumnName)
			if header_bold then
				sb.Append("</b>")
			End If
			sb.Append("</th>")
	Next

	sb.Append("</tr>")
	
	for each dr As DataRow in in_coll.Rows
		sb.Append("<tr>")
		For dCount As Integer = 0 To in_coll.Columns.Count - 1
			sb.Append("<td>")
			sb.Append(dr(dCount))
			sb.Append("</td>")
		Next
		sb.Append("</tr>")
	Next
	sb.Append("</table>")
End If

out_html = sb.ToString()
]]></code></stage><stage stageid="4be6fa53-b43c-4526-98b2-9c6d6d907f96" name="in_collection" type="Collection"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><narrative>Input Collection</narrative><display x="-135" y="-15" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="40a8b62e-ccb5-4061-9269-161508ed18b0" name="out_html_table" type="Data"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><narrative>output HTML table in string which resembles the collection</narrative><display x="135" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52d1ce9f-7acc-44cd-bd02-b47e591909fb" name="header_colour" type="Data"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><display x="-135" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b897796-b2e3-41a0-bf7b-aab2f6ed81e1" name="header_bold" type="Data"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><display x="-135" y="75" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="55a3e9f6-cbbb-4ed9-a73e-7ca866c23545" name="Input" type="Block"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><display x="-225" y="-45" w="135" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="731bf8b3-0692-41ca-b3b7-84cda662746c" name="output" type="Block"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><loginhibit /><display x="90" y="-45" w="75" h="45" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="12dd5fbe-eb59-47b6-b3a2-cb20386930ec" name="text_align" type="Data"><subsheetid>60619acb-1bdf-4365-88ff-0af0ab6ca19e</subsheetid><display x="-195" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="496bdd54-b799-474b-94c1-92397a9bf0be" name="Get Missing Values from Collection - Collection Compare" type="SubSheetInfo"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><narrative>It compares Base Collection with CollectionToCompare. 
Returns the Rows which are missing in Collection To Compare</narrative><display x="-360" y="-150" w="150" h="90" /></stage><stage stageid="5d656143-8667-4920-b425-68842a466951" name="Start" type="Start"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="collection" name="BaseCollection" narrative="Collection from which missing values are required" stage="BaseCollection" /><input type="collection" name="CollectionToCompare" narrative="Collection for comparing" stage="CollectionToCompare" /><input type="text" name="BField" narrative="Field Name of Base Collection" stage="BField" /><input type="text" name="CField" narrative="Field Name of Compare Collection" stage="CField" /></inputs><onsuccess>c411e077-6dc2-4774-bf00-91cafd587dc9</onsuccess></stage><stage stageid="b5dd9356-9295-4df9-806f-688340f3d357" name="End" type="End"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><loginhibit /><display x="15" y="15" /><outputs><output type="collection" name="OutputCollection" narrative="Collection with Schema of BaseCollection &amp; Missing Values" stage="OutputCollection" /></outputs></stage><stage stageid="590cff1a-1446-4a69-8731-b2d7a282a515" name="BaseCollection" type="Collection"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><display x="-360" y="-30" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="9f26b72c-4b36-4866-816f-a19e94ac0bc3" name="CollectionToCompare" type="Collection"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><display x="-360" y="-60" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="c24797b8-726a-4542-95cb-b4950f6bd3a1" name="OutputCollection" type="Collection"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><display x="-360" y="120" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="0f08699d-6482-480e-a285-36c171ae128d" name="BField" type="Data"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><display x="-360" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Field1</initialvalue><private /><alwaysinit /></stage><stage stageid="c411e077-6dc2-4774-bf00-91cafd587dc9" name="Get Missing Values from Collection" type="Code"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="30" /><inputs><input type="collection" name="table" expr="[BaseCollection]" /><input type="collection" name="table1" expr="[CollectionToCompare]" /><input type="text" name="FieldB" expr="[BField]" /><input type="text" name="FieldC" expr="[CField]" /></inputs><outputs><output type="collection" name="OpTable" stage="OutputCollection" /></outputs><onsuccess>b5dd9356-9295-4df9-806f-688340f3d357</onsuccess><code><![CDATA[Dim Result As EnumerableRowCollection(Of DataRow) = table.AsEnumerable().Where(Function(a) Not table1.AsEnumerable().[Select](Function(x) x(FieldC).ToString()).ToList().Contains(a(FieldB).ToString()))
OpTable = If(Result.Any(), Result.CopyToDataTable(), table.Clone())]]></code></stage><stage stageid="7aa199b2-56eb-4b81-91e7-6cf6cbf204e0" name="Input" type="Block"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><loginhibit /><display x="-435" y="-90" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b1e2533e-76ad-48c4-9108-cfcbf487732e" name="Output" type="Block"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><loginhibit /><display x="-435" y="75" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7acdb016-9416-491c-831b-538aff72e8a1" name="CField" type="Data"><subsheetid>de3fd37b-a535-48e8-bb08-d27dc3a7de4e</subsheetid><display x="-360" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Field1</initialvalue><private /><alwaysinit /></stage><stage stageid="9aeab187-e062-4168-8b18-aae652ac6cec" name="Split Collection - Dynamic Headers" type="SubSheetInfo"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><narrative>Split Collection requires Field Names to be predefined. With this action, Field Names need not be defined and can be passed dynamically from Config File. Output Collection will only have the columns required. </narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b167fd33-ef79-4958-9bcf-b0e635e486a5" name="Start" type="Start"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><preconditions><condition narrative="Output Headers should be in the format &quot;BP_Queue,BP_Key&quot; (Separated by comma)" /></preconditions><postconditions><condition narrative="Output Collection will have columns which are mentioned in Output Headers " /></postconditions><display x="15" y="-105" /><inputs><input type="collection" name="Input Collection" narrative="Input Collection to Split" stage="Collection_In" /><input type="text" name="Output Headers separated by comma eg: BP_Queue,BP_Key" narrative="Output Headers separated by comma eg: BP_Queue,BP_Key" stage="Output_Headers" /><input type="flag" name="Remove_Duplicate_Rows?" narrative="If Set to true, only unique rows will be returned in Output Collection. Default Value is False" stage="Remove_Duplicate_Rows?" /></inputs><onsuccess>a5a40a26-f160-4702-85de-024a4905e1db</onsuccess></stage><stage stageid="179bae27-1439-49ba-9bde-01b3459d9766" name="End" type="End"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection having specified headers" stage="Collection_Out" /></outputs></stage><stage stageid="d1e8d541-bc5c-4b37-8cec-3a4f898fe02b" name="Collection_In" type="Collection"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><display x="-195" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="adf75448-9311-4b03-8412-60875b08f090" name="Collection_Out" type="Collection"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><display x="-195" y="135" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a5a40a26-f160-4702-85de-024a4905e1db" name="Split Collection -Dynamic Headers" type="Code"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Collection_In" expr="[Collection_In]" /><input type="text" name="Output_Headers" expr="[Output_Headers]" /><input type="flag" name="Remove_Duplicate_Rows" expr="[Remove_Duplicate_Rows?]" /></inputs><outputs><output type="collection" name="Collection_Out" stage="Collection_Out" /></outputs><onsuccess>179bae27-1439-49ba-9bde-01b3459d9766</onsuccess><code><![CDATA[
Collection_Out = new DataTable()
Dim s As String = Output_Headers

' Split string based on comma

Dim headers As String() = s.Split(New Char() {","})

Collection_Out = Collection_In.DefaultView.ToTable("tempTableName", Remove_Duplicate_Rows,headers)]]></code></stage><stage stageid="923d839a-135b-4308-b9f8-9ccadf320150" name="Output_Headers" type="Data"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><display x="-195" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f936488a-a47d-42a3-af24-0cd20f6bb700" name="Input" type="Block"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="631ea409-c15d-42ae-878c-43f766dbadc5" name="Output" type="Block"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="70bc340a-8c73-4140-96b5-8532bb956c09" name="Remove_Duplicate_Rows?" type="Data"><subsheetid>bb384da3-7957-4196-8658-c206ba607331</subsheetid><display x="-195" y="60" w="90" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="e0aaf68b-330e-4d24-aec1-aa3df3d5077f" name="Fill Blanks With First Row" type="SubSheetInfo"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><narrative>Fills value of first row to rest of the empty rows for provided column, if first row is empty it will mark complete column as empty</narrative><display x="-375" y="-105" w="180" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="42619d9e-d4df-4b0c-93de-6ee15200aab7" name="Start" type="Start"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="The collection will have its empty values filled with empty text." /></postconditions><display x="-135" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="In_Collection" narrative="A collection to be updated" stage="In_Collection" /><input type="text" name="Column" narrative="Name of column to be autofilled from first row" stage="Column" /></inputs><onsuccess>33889d2d-c4d7-4c23-91f1-99c7c47373a6</onsuccess></stage><stage stageid="e8ad506b-8f34-4554-ae01-b48f226ca24b" name="End" type="End"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-135" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Out_Collection" narrative="Updated Collection" stage="Out_Collection" /></outputs></stage><stage stageid="0766d505-bef6-42dc-b9f8-4196508cc057" name="In_Collection" type="Collection"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><display x="-405" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="33889d2d-c4d7-4c23-91f1-99c7c47373a6" name="Fill Blanks With First Row" type="Code"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-135" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="In_Collection" expr="[In_Collection]" /><input type="text" name="Column" expr="[Column]" /></inputs><outputs><output type="collection" name="Out_Collection" stage="Out_Collection" /><output type="text" name="val" stage="val" /></outputs><onsuccess>e8ad506b-8f34-4554-ae01-b48f226ca24b</onsuccess><code><![CDATA[try

Dim row as Integer = 0
Dim totalrow = In_Collection.Rows.Count

' Get value of first column
val = CStr(In_Collection.Rows.Item(0).Item(Column))

While row <= totalrow-1

'MsgBox("Before : "&In_Collection.Rows.Item(row).Item(Column)) 

'assign currenct row val to first row val
In_Collection.Rows(row)(Column) = Cstr(val)

'MsgBox("After : "&In_Collection.Rows.Item(row).Item(Column))

row+=1

End While

'set ouput collection as value
Out_Collection = In_Collection

catch e as exception

end try

]]></code></stage><stage stageid="3790807b-f2b4-4c6c-ba85-fa9559e945a0" name="Column" type="Data"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><display x="-330" y="-15" /><datatype>text</datatype><initialvalue xml:space="preserve">Result</initialvalue><private /><alwaysinit /></stage><stage stageid="776e0984-22ed-46f8-abdb-b309467d5855" name="Out_Collection" type="Collection"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><display x="-405" y="75" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="5ed3a6a6-1c1f-48a4-8a1d-0021e278dede" name="Input" type="Block"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-465" y="-45" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="a2f70330-88da-4d74-932b-07d5300e8aad" name="Output" type="Block"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-465" y="45" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="464d7102-16cb-44fa-a4f7-d87b5c063c83" name="Code" type="Block"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-210" y="-60" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4680c3e5-c750-46c5-9da1-589405dbef04" name="Recover" type="Recover"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><loginhibit /><display x="-90" y="-30" /><onsuccess>f9ac5fc7-f4d5-4744-8ca7-18b8c10ba4d9</onsuccess></stage><stage stageid="f9ac5fc7-f4d5-4744-8ca7-18b8c10ba4d9" name="Exception" type="Exception"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><display x="0" y="-30" /><exception localized="yes" type="System Exception" detail="&quot;Collection Manupalation &gt;&gt; Fill Blanks with First Row &gt;&gt; Error in filling entire column &quot;&amp; [Column]&amp;&quot; with first row value&quot;&amp;[val]" /></stage><stage stageid="9cddd1b6-7aa4-4498-bf04-d1911ccedad3" name="val" type="Data"><subsheetid>2feb2121-5bcd-46f4-8795-9f45245ce1bd</subsheetid><display x="-330" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aa4ec9be-1bae-41c4-98f2-c0e1e1e1a8b9" name="Enter Single Value in Entire Column" type="SubSheetInfo"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><narrative>Returns a collection with specified field, containing a single value in specified field</narrative><display x="-150" y="-105" w="150" h="60" /></stage><stage stageid="a9f19893-c2d4-44c2-83f7-502578764243" name="Start" type="Start"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="45" y="-75" /><inputs><input type="collection" name="Input Collection" narrative="Input collection " stage="Collection In" /><input type="text" name="Field Name" narrative="Name of the collection field to enter single value" stage="FieldName" /><input type="text" name="NewValue" narrative="NewValue to enter in specified field name" stage="NewValue" /></inputs><onsuccess>4b6a807b-5d22-4da3-9eda-459855a8bc98</onsuccess></stage><stage stageid="1f0e5f36-f624-45f3-a495-fb4d2f863850" name="End" type="End"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="45" y="45" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection with Single value in entire column" stage="Collection Out" /></outputs></stage><stage stageid="139264b6-6c60-44d1-9d64-68a54d5fa342" name="Collection In" type="Collection"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><display x="-150" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="31364937-8971-417a-8d8f-28360f09dc4f" name="Collection Out" type="Collection"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><display x="225" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="4b6a807b-5d22-4da3-9eda-459855a8bc98" name="Set Value for entire column" type="Code"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="45" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Collection_In" expr="[Collection In]" /><input type="text" name="FieldName" expr="[FieldName]" /><input type="text" name="NewValue" expr="[NewValue]" /></inputs><outputs><output type="collection" name="Collection_Out" stage="Collection Out" /></outputs><onsuccess>1f0e5f36-f624-45f3-a495-fb4d2f863850</onsuccess><code><![CDATA[Dim iRow as integer
'Loop through each row to enter new value
if Collection_In.Rows.Count > 0 then
	For iRow = Collection_In.Rows.Count - 1 to 0 step -1

		Collection_In.Rows(iRow)(FieldName) = NewValue
	Next
End If
'Set output parameter
Collection_Out = Collection_In]]></code></stage><stage stageid="8e48cea9-b4e7-4be9-9752-f8777e2c7a9e" name="Input parameters" type="Block"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="-225" y="-60" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="5cf04c10-9d0f-4085-97e4-8e073cb73052" name="Output parameters" type="Block"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="150" y="-45" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="1412a42a-e1bd-4103-b108-bc8b0ceb032a" name="FieldName" type="Data"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="-150" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d94729f6-ad81-4f27-a859-8d08b746307c" name="NewValue" type="Data"><subsheetid>48587274-4a5d-410a-b4b1-76ed68b108e2</subsheetid><loginhibit /><display x="-150" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
        <object id="1755dccf-ee8a-456b-86d6-6d83220f12de" name="Utility - Environment" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility - Environment" version="6.3.0.6190" bpversion="7.3.1.15031" narrative="Utilities for interacting with the environment - read screen resolution, determine OS type, etc." byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Background"><appdef><element name="Application Root"><id>257afd68-bed2-460b-94e5-17b2b6263b15</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>-67</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="72ac1b78-ac00-4ede-b5fa-13beef468814" type="Normal" published="True"><name>Font Smoothing Enabled</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="cf31a66d-5534-4af0-9a07-433066d1a4b9" type="Normal" published="True"><name>Get Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="cf9f6573-f06c-4ab6-9672-34d2e644415e" type="Normal" published="True"><name>Set Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="50ea2955-c157-4803-b16c-fea2255ce9e2" type="Normal" published="True"><name>Clear Clipboard</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="a7ea3097-4e9b-48f3-9431-68977353a6bc" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="4987fdec-ac7a-4166-a60b-adef47ecdcc7" type="Normal" published="True"><name>Get Screen Resolution</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="80ee143b-0379-4ba5-b13f-5d42dde3160d" type="Normal" published="True"><name>Start Process Read Stderr and Stdout</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="e5864a25-e7a2-430a-9045-78a116e64701" type="Normal" published="True"><name>Kill Process</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="3d4412bd-579a-4d1e-937e-12fbb756630c" type="Normal" published="True"><name>Read Memory Stats</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="7b5cc7aa-ca53-495f-a51e-4ed559efe88b" type="Normal" published="True"><name>Read Process Working Set</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7" type="Normal" published="True"><name>Start Process</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="29015311-1659-438e-b7b6-b8ff65e4a840" type="Normal" published="True"><name>Run Process Until Ended</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="13c8f06e-8a7c-4da8-b813-d5738ce5369a" type="Normal" published="True"><name>Wait for Process</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="1e22dc28-2f71-421b-9687-c367358919e3" type="Normal" published="True"><name>Wait for Process Window</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="b6e051bf-8afe-4ea3-9ae0-52eee58eec76" type="Normal" published="True"><name>Get User Name</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="c556a801-8bd8-4e0e-bf8e-2dd6b5642063" type="Normal" published="True"><name>Get Machine Name</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="5f046b4e-e1db-4786-ae90-3d5d6c6d9302" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>9e4646d0-d8c7-44d6-a5d9-9509e3ba8883</onsuccess></stage><stage stageid="9e4646d0-d8c7-44d6-a5d9-9509e3ba8883" name="End" type="End"><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="d9e9a8ad-308f-49f4-9dd0-9dafbc1f625a" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><references><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>system.windows.forms.dll</reference><reference>Microsoft.VisualBasic.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Windows.Forms</import><import>System.Diagnostics</import><import>System.Data</import><import>Microsoft.VisualBasic</import><import>System.Threading</import></imports><language>visualbasic</language><globalcode><![CDATA[

]]></globalcode><code><![CDATA[

]]></code></stage><stage stageid="6e5c9120-5c20-4fe2-9bfd-149470c9a1ea" name="Clean Up" type="SubSheetInfo"><subsheetid>a7ea3097-4e9b-48f3-9431-68977353a6bc</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e36d7ef5-340c-4d1f-a670-d1f1dcd7bdc3" name="Start" type="Start"><subsheetid>a7ea3097-4e9b-48f3-9431-68977353a6bc</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>1451859f-91ff-4e0a-b8a8-7bbd6dc50341</onsuccess></stage><stage stageid="1451859f-91ff-4e0a-b8a8-7bbd6dc50341" name="End" type="End"><subsheetid>a7ea3097-4e9b-48f3-9431-68977353a6bc</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="f50788a0-79a5-446b-b3cc-fc8d66091330" name="Get Screen Resolution" type="SubSheetInfo"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><narrative>Gets the resolution of the screen in pixels for the current environment.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="d9e8deba-018e-4402-bb33-773a299ae864" name="Start" type="Start"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>bd2d0918-9c73-4138-90b8-538eaa06f135</onsuccess></stage><stage stageid="3348aa7d-5b76-4d3f-a590-e571a9a83494" name="End" type="End"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Horizontal Resolution" narrative="The number of pixels in the horizontal screen axis" stage="Horizontal Resolution" /><output type="number" name="Vertical Resolution" narrative="The number of pixels in the vertical screen axis" stage="Vertical Resolution" /></outputs></stage><stage stageid="c970b361-339a-4e60-a056-cf8571553cb8" name="new" type="Note"><subsheetid>a7ea3097-4e9b-48f3-9431-68977353a6bc</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="faf2adc8-9198-4483-b6dc-e67e978cbf7b" name="new" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="bd2d0918-9c73-4138-90b8-538eaa06f135" name="GetResolution" type="Code"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Horizontal Resolution" stage="Horizontal Resolution" /><output type="number" name="Vertical Resolution" stage="Vertical Resolution" /></outputs><onsuccess>3348aa7d-5b76-4d3f-a590-e571a9a83494</onsuccess><code><![CDATA[dim S As Size = Screen.PrimaryScreen.Bounds.Size
Horizontal_Resolution = S.Width
Vertical_Resolution = S.Height]]></code></stage><stage stageid="37500b62-bdb6-42ed-91a3-02fbcffc75ee" name="Horizontal Resolution" type="Data"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><display x="105" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8edafede-371d-454f-a5ca-0b28eda542e5" name="Vertical Resolution" type="Data"><subsheetid>4987fdec-ac7a-4166-a60b-adef47ecdcc7</subsheetid><display x="165" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8bff191-0772-44c3-bea4-1d4ff701d49f" name="Kill Process" type="SubSheetInfo"><subsheetid>e5864a25-e7a2-430a-9045-78a116e64701</subsheetid><narrative>Force kills all processes with a given name.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e3791a92-d20e-4afe-81bf-5aab170c3aba" name="Start" type="Start"><subsheetid>e5864a25-e7a2-430a-9045-78a116e64701</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="All processes with the given name will be terminated." /></postconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" stage="Process Name" /></inputs><onsuccess>697bc06f-0d64-430d-a5ea-b3fd02b746c8</onsuccess></stage><stage stageid="e9c6833a-30a3-4233-840b-35d605e44199" name="End" type="End"><subsheetid>e5864a25-e7a2-430a-9045-78a116e64701</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="06a89dc2-9ed1-497c-b7f0-14664bdb76c5" name="Process Name" type="Data"><subsheetid>e5864a25-e7a2-430a-9045-78a116e64701</subsheetid><display x="120" y="-105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="697bc06f-0d64-430d-a5ea-b3fd02b746c8" name="Kill Process1" type="Code"><subsheetid>e5864a25-e7a2-430a-9045-78a116e64701</subsheetid><loginhibit /><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" expr="[Process Name]" /></inputs><onsuccess>e9c6833a-30a3-4233-840b-35d605e44199</onsuccess><code><![CDATA[  Try
    for each p as System.Diagnostics.Process in System.Diagnostics.Process.GetProcessesByName(Process_Name)
      p.kill
    next
  Catch ex As Exception
  End Try]]></code></stage><stage stageid="374fc1ad-8b82-4d95-b3d4-9710692a2725" name="Read Memory Stats" type="SubSheetInfo"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><narrative>Get memory statistics for a given set of processes including the working set and the virtual memory size.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="237994c5-9c89-409f-9459-a9f1ce60d7ad" name="Start" type="Start"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="" /></postconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Process Names" narrative="The names of the processes to get memory statistics for" stage="Processes" /></inputs><onsuccess>c64eaa40-85d5-42b9-bcfe-0e314328bccb</onsuccess></stage><stage stageid="83912618-be8e-4f5a-860a-03cc449519c4" name="End" type="End"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Process Statistics" narrative="A collection of process statistics including the working set and the virtual memory size" stage="Process Statistics" /></outputs></stage><stage stageid="c64eaa40-85d5-42b9-bcfe-0e314328bccb" name="Get Stats" type="Code"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><loginhibit /><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Processes" expr="[Processes]" /></inputs><outputs><output type="collection" name="Process Statistics" stage="Process Statistics" /></outputs><onsuccess>83912618-be8e-4f5a-860a-03cc449519c4</onsuccess><code><![CDATA[GC.Collect()
Process_Statistics = New DataTable
process_statistics.Columns.Add("Process Name", GetType(String))
process_statistics.Columns.Add("PID", GetType(Decimal))
process_statistics.Columns.Add("Working Set", GetType(Decimal))
process_statistics.Columns.Add("Virtual Memory", GetType(Decimal))

For Each R As DataRow in Processes.Rows
	dim ProcName As String = CStr(R("Process Name"))
	Dim PID As Integer = CInt(R("PID"))
	For Each P As Process in Process.GetProcesses()
		If P.ProcessName = ProcName OrElse P.ID = PID Then
			Process_Statistics.Rows.Add(New Object() {P.ProcessName, P.ID, P.WorkingSet64, P.VirtualMemorySize64})
		End If
	Next
Next]]></code></stage><stage stageid="2d4e55c2-5e4d-45d5-8fd3-27d58de71615" name="Processes" type="Collection"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><display x="120" y="-105" w="120" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Process Name" type="text" /><field name="PID" type="number" /></collectioninfo><initialvalue><row><field name="Process Name" type="text" value="Automate" /><field name="PID" type="number" value="-1" /></row><row><field name="Process Name" type="text" value="javaw" /><field name="PID" type="number" value="-1" /></row></initialvalue></stage><stage stageid="99b25e8c-cd81-4e2f-99c3-d4c8afb738fc" name="Process Statistics" type="Collection"><subsheetid>3d4412bd-579a-4d1e-937e-12fbb756630c</subsheetid><display x="120" y="90" w="120" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Process Name" type="text" /><field name="PID" type="number" /><field name="Working Set" type="number" /><field name="Virtual Memory" type="number" /></collectioninfo></stage><stage stageid="f781848e-f409-4be9-aea7-4672e21e840e" name="Read Process Working Set" type="SubSheetInfo"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><narrative>Gets the size of the working set for the given process.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="41b78729-d533-460b-98af-6180066d831b" name="Start" type="Start"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" narrative="The name of the process you want stats for" stage="Process Name" /></inputs><onsuccess>92e54184-9c46-425a-a681-ca15d5f38671</onsuccess></stage><stage stageid="d9a48cd9-620d-4b45-87bb-cb1a223d729e" name="End" type="End"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Working Set" narrative="The working set number holding memory stats for your process" stage="Working Set" /></outputs></stage><stage stageid="92e54184-9c46-425a-a681-ca15d5f38671" name="Get Memory Set" type="Code"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><loginhibit /><narrative>Used += to return the total memory used by the application we are interested - just in case it is running multiple times.</narrative><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Proc" expr="[Process Name]" /></inputs><outputs><output type="number" name="Working Set" stage="Working Set" /></outputs><onsuccess>d9a48cd9-620d-4b45-87bb-cb1a223d729e</onsuccess><code><![CDATA[
For Each P As Process in Process.GetProcesses()
	If P.ProcessName = Proc Then
		Working_Set += P.WorkingSet64
	End If
Next]]></code></stage><stage stageid="2db08314-74db-4968-8a01-2fffb03cc350" name="Process Name" type="Data"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><loginhibit /><display x="135" y="-105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="192be4f9-084a-4c4d-99a1-67383bb9cf30" name="Working Set" type="Data"><subsheetid>7b5cc7aa-ca53-495f-a51e-4ed559efe88b</subsheetid><display x="135" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue xml:space="preserve">0</initialvalue><private /><alwaysinit /></stage><stage stageid="fb42bad5-7a16-4ac1-8cc7-148cb8ad1d0f" name="Font Smoothing Enabled" type="SubSheetInfo"><subsheetid>72ac1b78-ac00-4ede-b5fa-13beef468814</subsheetid><narrative>Gets the font smoothing setting for the current environment.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ad641c65-2bb5-4746-a61c-38a70a4e0b89" name="Start" type="Start"><subsheetid>72ac1b78-ac00-4ede-b5fa-13beef468814</subsheetid><loginhibit /><preconditions><condition narrative="" /></preconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>96f9fe29-f641-44ab-ab0e-a4091edaec4c</onsuccess></stage><stage stageid="9150eaee-22ec-4228-803e-123c888b87e5" name="End" type="End"><subsheetid>72ac1b78-ac00-4ede-b5fa-13beef468814</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Enabled" narrative="True if font smoothing is enabled" stage="Enabled?" /></outputs></stage><stage stageid="96f9fe29-f641-44ab-ab0e-a4091edaec4c" name="Get Font Smoothing Enabled" type="Code"><subsheetid>72ac1b78-ac00-4ede-b5fa-13beef468814</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Enabled" stage="Enabled?" /></outputs><onsuccess>9150eaee-22ec-4228-803e-123c888b87e5</onsuccess><code><![CDATA[Enabled=System.Windows.Forms.Systeminformation.IsFontSmoothingEnabled]]></code></stage><stage stageid="d7db2bff-a394-483d-a249-bae03f688e95" name="Enabled?" type="Data"><subsheetid>72ac1b78-ac00-4ede-b5fa-13beef468814</subsheetid><display x="120" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="80a2dcaa-31dd-419b-9fd4-a61249245b1b" name="Start Process" type="SubSheetInfo"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><narrative>Starts a process directly with the given arguments.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="6d5177aa-21f6-4dac-b731-60fd85c76097" name="Start" type="Start"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Application" narrative="The application or short cut to start" stage="Application" /><input type="text" name="Arguments" narrative="Any arguments needed for the app" stage="Arguments" /></inputs><onsuccess>8fd5d005-95ec-43c3-acae-de13b914eb3e</onsuccess></stage><stage stageid="9c57d68b-5d25-4c88-8bb1-8f7c6aa327d3" name="End" type="End"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="b3401dc5-5639-4e5d-b55a-b633330db327" name="Run Process Until Ended" type="SubSheetInfo"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><narrative>Run a process and wait until completion or timeout.</narrative><display x="-195" y="-120" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="f6878e25-301c-4540-a15d-7a83dfc57a75" name="End" type="End"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-45" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="09ddad15-d793-4697-8f79-1a42247fb0ba" name="Note1" type="Note"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><narrative>Inputs</narrative><display x="-165" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ca8b3a6e-c15d-4b6b-bf9f-96c0675d8e04" name="Application" type="Data"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><display x="-165" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9d495c29-e0f2-4bdd-ac85-b7875f7b1117" name="Arguments" type="Data"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><display x="-165" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8fd5d005-95ec-43c3-acae-de13b914eb3e" name="Start Process" type="Code"><subsheetid>12ea7001-8ac4-4a2f-a00d-9b6e3a9583f7</subsheetid><loginhibit /><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Application" expr="[Application]" /><input type="text" name="Arguments" expr="[Arguments]" /></inputs><onsuccess>9c57d68b-5d25-4c88-8bb1-8f7c6aa327d3</onsuccess><code><![CDATA[If Arguments<>"" Then
  System.Diagnostics.Process.Start(Application, Arguments)
Else
  System.Diagnostics.Process.Start(Application)
End If]]></code></stage><stage stageid="085fdcca-3a7c-4a20-8b83-69add0889a54" name="Application" type="Data"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-195" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e53a27fe-26fe-4503-ab86-8a5208e43d80" name="Arguments" type="Data"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b84d4bb-deea-40c5-96eb-6adcf59fe7cf" name="Run Process" type="Code"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-45" y="-105" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="appn" expr="[Application]" /><input type="text" name="args" expr="[Arguments]" /><input type="text" name="dir" expr="[Working Folder]" /><input type="timespan" name="timeout" expr="[Timeout]" /></inputs><outputs><output type="flag" name="timedOut" stage="Fail Datetime Reached?" /></outputs><onsuccess>7fa022c9-fce8-496a-a40b-9119406000db</onsuccess><code><![CDATA[timedOut = False
Dim startTime as Date = Date.Now

Dim info as New ProcessStartInfo(appn)
If args <> "" Then  info.Arguments = args
If dir <> "" Then info.WorkingDirectory = dir

Using proc As Process = Process.Start(info)
	timedOut = Not proc.WaitForExit( _
	 CInt(timeout.TotalMilliseconds))
End Using]]></code></stage><stage stageid="f0792b52-0999-4f35-a46c-513fdcc3c381" name="Timeout" type="Data"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-195" y="75" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>timespan</datatype><initialvalue>0.00:00:10</initialvalue><private /><alwaysinit /></stage><stage stageid="2adaf80c-c627-4556-8b6d-64929056128b" name="Start" type="Start"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-45" y="-150" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Application" narrative="The application or shortcut to start" stage="Application" /><input type="text" name="Arguments" narrative="Optional - any arguments needed to run the application" stage="Arguments" /><input type="text" name="Working Folder" narrative="Optional - the application working folder" stage="Working Folder" /><input type="timespan" name="Timeout" narrative="How long to wait for the application to finish. Default is 10 seconds" stage="Timeout" /></inputs><onsuccess>0b84d4bb-deea-40c5-96eb-6adcf59fe7cf</onsuccess></stage><stage stageid="c91ac000-31f2-44b8-a481-a878929285ae" name="Fail Datetime Reached?" type="Data"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-195" y="150" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="7fa022c9-fce8-496a-a40b-9119406000db" name="Timed Out?" type="Decision"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="-45" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Fail Datetime Reached?]" /><ontrue>433c4289-a312-4554-bc27-6ee3c7ace153</ontrue><onfalse>f6878e25-301c-4540-a15d-7a83dfc57a75</onfalse></stage><stage stageid="433c4289-a312-4554-bc27-6ee3c7ace153" name="System Exception" type="Exception"><subsheetid>29015311-1659-438e-b7b6-b8ff65e4a840</subsheetid><display x="45" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Application &quot; &amp; [Application] &amp; &quot; was still running after the maximum time period&quot;" /></stage><stage stageid="bcdc67ee-3c90-443c-9c4f-ec02fc8ee8d2" name="Wait for Process" type="SubSheetInfo"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><narrative>Attach to a process and wait for it to complete.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="99a09b67-00bd-4e8a-bad7-2f589ac9de94" name="End" type="End"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Found?" narrative="True=process found, false=process not found" stage="Found?" /></outputs></stage><stage stageid="0dcbb991-85d4-45bb-aaa9-a8bf5da36d15" name="Start" type="Start"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Maximum wait time (seconds)" narrative="The maximum time to wait for the process to complete" stage="Maximum wait time (seconds)" /><input type="text" name="Process Name" narrative="The name of the process to attach to" stage="Process Name" /></inputs><onsuccess>dfe0f2dc-5806-4cf9-82f3-269f9b06b03f</onsuccess></stage><stage stageid="55ae0a29-1ee0-4fd1-b077-eeb2e6f1e9dd" name="End" type="End"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Found?" narrative="True=process found, false=process not found" stage="Found?" /></outputs></stage><stage stageid="e1eea34b-f6e4-49b3-bcae-930f70caec29" name="Maximum wait time (seconds)" type="Data"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><display x="90" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="dfe0f2dc-5806-4cf9-82f3-269f9b06b03f" name="Wait for process" type="Code"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><loginhibit /><display x="15" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" expr="[Process Name]" /><input type="number" name="Max Wait" expr="[Maximum wait time (seconds)]" /></inputs><outputs><output type="flag" name="Found?" stage="Found?" /></outputs><onsuccess>55ae0a29-1ee0-4fd1-b077-eeb2e6f1e9dd</onsuccess><code><![CDATA[                Try
                  Found_ = False
                  Dim bProcFound as Boolean = False
                  Dim iLoop as Integer = 0
                  Dim myProcesses() As System.Diagnostics.Process
                  Dim instance As System.Diagnostics.Process
                  Do While bProcFound = False AND iLoop < Max_Wait
                    myProcesses = System.Diagnostics.Process.GetProcessesByName(Process_Name)
                    For Each instance In myProcesses
                        bProcFound = True
                        Found_ = True
                    Next
                    Threading.Thread.Sleep(1000)
                    iloop += 1
                  Loop
                Catch ex As Exception
                End Try]]></code></stage><stage stageid="9344b166-5d5d-4b99-bc53-0c0331b8c776" name="Found?" type="Data"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><display x="90" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="8a02d7fb-31ed-4c83-92c9-9a9a7831920e" name="Process Name" type="Data"><subsheetid>13c8f06e-8a7c-4da8-b813-d5738ce5369a</subsheetid><display x="-60" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="952ca62f-afb2-4f25-adea-21d86339081c" name="Wait for Process Window" type="SubSheetInfo"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><narrative>Waits for a process with a given name has displayed a window with the given title.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="19ea35dc-66b8-406e-9eca-4c6ef4d4e0ab" name="Start" type="Start"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" narrative="The name of the process to attach to" stage="Process Name" /><input type="text" name="Window Title" narrative="The title of the window within the process" stage="Window Title" /><input type="number" name="Wait" narrative="The maximum amount of time to wait for" stage="Wait" /></inputs><onsuccess>d3b1986a-fa70-41e9-a8af-cd2ffc78342e</onsuccess></stage><stage stageid="b6fdc874-6a8d-405b-946e-10b6b47a6ae1" name="End" type="End"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="15" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Found" stage="Found" /></outputs></stage><stage stageid="d3b1986a-fa70-41e9-a8af-cd2ffc78342e" name="Find Process" type="Code"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="15" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Process Name" expr="[Process Name]" /><input type="text" name="Window Title" expr="[Window Title]" /></inputs><outputs><output type="flag" name="Found" stage="Found" /></outputs><onsuccess>d0d526bd-c3dd-4eb6-bbe7-2d46cca6e06f</onsuccess><code><![CDATA[try

for each p as system.diagnostics.process in system.diagnostics.process.getprocessesbyname(process_name)

	if p.mainwindowtitle.trim.tolower like window_title.trim.tolower then
		found = true
		exit sub
	end if

next

catch e as exception
end try]]></code></stage><stage stageid="6088ca18-1f7c-4db7-84af-ccecfe1ced0f" name="Time Out2" type="WaitEnd"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="105" y="-45" w="30" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>d3b1986a-fa70-41e9-a8af-cd2ffc78342e</onsuccess><groupid>d8f20257-87c3-4cf6-a20e-b44dbd21ce6a</groupid></stage><stage stageid="4498756a-e9e1-4bef-86e6-3b7ed91a7439" name="Wait" type="WaitStart"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="195" y="-45" w="30" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><groupid>d8f20257-87c3-4cf6-a20e-b44dbd21ce6a</groupid><choices /><timeout>0.5</timeout></stage><stage stageid="ba11e756-90e9-4cd7-a787-a41c2818e4b6" name="Count Down" type="Calculation"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="195" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>4498756a-e9e1-4bef-86e6-3b7ed91a7439</onsuccess><calculation expression="[Wait]-0.5" stage="Wait" /></stage><stage stageid="a5225d0b-41b3-4ed2-9f7c-31461a1f262a" name="Wait?" type="Decision"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="105" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Wait]&gt;0" /><ontrue>ba11e756-90e9-4cd7-a787-a41c2818e4b6</ontrue><onfalse>ec831f1a-5b48-4bc2-8ceb-a362fa4e15d9</onfalse></stage><stage stageid="d0d526bd-c3dd-4eb6-bbe7-2d46cca6e06f" name="Found?" type="Decision"><subsheetid>1e22dc28-2f71-421b-9687-c367358919e3</subsheetid><loginhibit /><display x="15" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Found]" /><ontrue>b6fdc874-6a8d-405b-946e-10b6b47a6ae1</ontrue><onfalse>a5225d0b-41b3-4ed2-9f7c-31461a1f262a</onfalse></stage><stage stageid="ec831f1a-5b48-4bc2-8ceb-a362fa4e15