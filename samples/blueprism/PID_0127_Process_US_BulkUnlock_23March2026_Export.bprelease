 already exists" type="Calculation"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-75" y="180" /><onsuccess>d59ffd93-48b3-4f9e-b501-fc93b9575b8b</onsuccess><calculation expression="Replace([Run Report], &quot;ERROR&quot;, &quot;&quot;)" stage="Run Report" /></stage><stage stageid="945a35e3-e59e-4bde-ba67-2605aacd0dfb" name="Content_Type" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-255" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ba1dcce-890d-4687-966b-28abe463ffd0" name="Get All Latest Files W.r.t File Modified Time" type="SubSheetInfo"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><narrative>Get All Latest File W.r.t File modified time From Sharepoint</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="637d96e3-040c-473a-8eaf-2dc836471e1b" name="Return Message" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="270" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3582af1a-f38d-4833-a981-2f1627cc5951" name="Generate Script" type="Calculation"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-45" y="-60" /><onsuccess>32087c91-09bf-4cb8-ba2e-239d24db0b88</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&quot;&quot; &amp;[SharePoint URL]&amp;&quot;&quot;&quot;&quot;&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;&#xA;$files= Get-PnPFolderItem -FolderSiteRelativeUrl '&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;'&quot;&amp;NewLine()&amp;&quot;&#xA;$now= (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;').AddDays(&quot;&amp;[AddDays]&amp;&quot;).AddHours(&quot;&amp;[AddHours]&amp;&quot;).AddMinutes(&quot;&amp;[AddMinutes]&amp;&quot;).AddSeconds(&quot;&amp;[AddSeconds]&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;')&quot;&amp;NewLine()&amp;&quot;&#xA;$files=$files | Sort-Object -Property TimeLastModified&quot;&amp;NewLine()&amp;&quot;&#xA;For ($i=0; $i -le $files.Count ; $i++)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;if($files[$i].TimeLastModified -gt $now -And $files[$i].TimeLastModified -lt $currentDt)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;$Excel = $files[$i].Name +&quot;&quot;,&quot;&quot;+$files[$i].TimeLastModified&quot;&amp;NewLine()&amp;&quot;&#xA;Add-Content &quot;&quot;&quot;&amp;[Destination Latest Excel Name Folder Path]&amp;&quot;&quot;&quot; $Excel }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&#xA;&#xA;" stage="Script" /></stage><stage stageid="256ad2c2-51c2-410d-b32a-b230c8e77751" name="Script" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af412d0b-dbef-4bda-b07d-b56e17f9ba18" name="Success" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="936e62fa-197d-4f3e-83f6-a12d92330f02" name="Standards" type="Note"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

SharePoint File path: Document Repository/LCA CC/RPA/0.0 RPA Repositary/4.0 RPA Guideline Documents/Blue Prism Guidelines and References/Chanana.txt


