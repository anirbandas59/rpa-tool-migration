tid><display x="-375" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1531a80b-9d60-4f9d-aa41-f6cbe074eba0" name="ScriptLocation" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="-150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83543191-60c7-437e-920b-8a627789d33a" name="Script_Location" type="Data"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8ce8e52-a233-4c56-937d-841755a8c8ab" name="Upload File to Sharepoint With Metadata" type="SubSheetInfo"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><narrative>It will upload the file and update the  metadata.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="ecdbce0a-3e7b-4df2-8409-6de4a614b9c9" name="FilePath" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="712e4dfe-3571-4127-83f6-91b6e8b6212b" name="SP_Lib_Folder_Path" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-165" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aabfe97e-892a-4b00-83ef-73cc05db6826" name="Build Script" type="Calculation"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="-15" /><onsuccess>b4dbccfa-5d7d-4026-aa39-a9562f8a859f</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;Add-PnPFile -Folder &quot; &amp; Chr(34) &amp; [SP_Lib_Folder_Path] &amp; Chr(34) &amp; &quot; -Path &quot; &amp; Chr(34) &amp; [FilePath] &amp; Chr(34) &amp; &quot; -Values @{ &quot; &amp;[Filed&amp;Values]&amp; &quot;}&quot;" stage="Script" /></stage><stage stageid="b4dbccfa-5d7d-4026-aa39-a9562f8a859f" name="Generate_PnPScript" type="SubSheet"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>9e4bc377-d316-412a-9d31-0f629ea3c3e4</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="6d3568b4-104e-4bf3-838e-eeb0c3417717" name="SP_Site_URL" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7cab68eb-866d-44a5-a724-abcebe314e05" name="Filed&amp;Values" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-180" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5077ce82-fe9b-4193-95e4-e9a9e0517af1" name="Script" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-420" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1399c9b3-c4d1-42ec-9acc-f415ebbbbf75" name="Script_Loc" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c06ddbc7-a2eb-4a8e-bd9f-29dc88a166f6" name="Script Path" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-330" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8296b3d-f878-4462-991e-99a928e5ac26" name="Return Message" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-375" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f448ca20-3c48-408a-abcf-5a2918126a3d" name="Start" type="Start"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><narrative>Helps to upload file to sharepoint with Metadata.</narrative><display x="15" y="-195" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Field&amp;values" narrative="Provide Metadata Filed &amp; values ( Format ColumnName = &quot;Column value&quot; ; Column2 = &quot;Column2 Value&quot; ex:- TestDescription = &quot; I am a test case&quot;;D_date = &quot;7/17/2017&quot;)" stage="Filed&amp;Values" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>a9be0ff6-0d85-4d56-b52f-aa80adb56a13</onsuccess></stage><stage stageid="fa3abaf1-9705-4335-b903-85c277e0829c" name="End" type="End"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="465" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="9b849a6b-966c-4de7-99e4-dd834d418727" name="Run PnP_Script" type="SubSheet"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="195" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>13fc236c-a641-4e91-a8e1-7a634384ebf9</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="955f77c0-85f9-424d-99d6-2a7dab4ba53e" name="Delete_Script" type="Action"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="405" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>fa3abaf1-9705-4335-b903-85c277e0829c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="9e4bc377-d316-412a-9d31-0f629ea3c3e4" name="Check_Error" type="Decision"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="90" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c1335496-74fb-45a9-9243-ebd9c854d1c7</ontrue><onfalse>5a5bae23-8028-4489-97ef-00a2acd88089</onfalse></stage><stage stageid="c1335496-74fb-45a9-9243-ebd9c854d1c7" name="Exception while creating  Script" type="Exception"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="225" y="90" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="13fc236c-a641-4e91-a8e1-7a634384ebf9" name="Check Process_Exist" type="Action"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>d99ed36e-8b52-460f-9948-ecca55c7b2d0</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="d99ed36e-8b52-460f-9948-ecca55c7b2d0" name="ProcessExist?" type="Decision"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="300" /><decision expression="[Exists]=True" /><ontrue>c4928466-2039-4bc6-bcae-e478a0a6bdff</ontrue><onfalse>2dd13346-ee0e-4c13-9d71-33ae39dab792</onfalse></stage><stage stageid="2dd13346-ee0e-4c13-9d71-33ae39dab792" name="Anchor8" type="Anchor"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="120" y="300" w="10" h="10" /><onsuccess>73c81c3c-717a-489d-9d29-ba850b397835</onsuccess></stage><stage stageid="c4928466-2039-4bc6-bcae-e478a0a6bdff" name="Kill Process" type="Action"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="345" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>955f77c0-85f9-424d-99d6-2a7dab4ba53e</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="73c81c3c-717a-489d-9d29-ba850b397835" name="Anchor9" type="Anchor"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="120" y="405" w="10" h="10" /><onsuccess>955f77c0-85f9-424d-99d6-2a7dab4ba53e</onsuccess></stage><stage stageid="1489f403-612a-4588-ab62-eb4822017637" name="Error_Message" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-450" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06df08a2-92a2-4729-9d48-77daf116d18a" name="Exists" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-255" y="255" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6eff061-1caf-4b89-90c4-1d3aa2bf75ac" name="Input" type="Block"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-285" y="0" w="165" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="376762a2-bfb8-4fea-827e-78cd55012a98" name="Output" type="Block"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-510" y="0" w="180" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="78e7f192-57a1-4420-945e-40a638a7a64b" name="Inhouse" type="Block"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-510" y="225" w="375" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a006f4ae-d7bc-442c-8bc9-cde5ac955ce9" name="Unexpected exception recover" type="Recover"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="345" y="90" /><onsuccess>8b1699f4-913b-4f9d-914c-86d319df7540</onsuccess></stage><stage stageid="4a0c4123-09fc-4bc1-b7e2-953d70a34d79" name="Unexpected Exception" type="Exception"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="465" y="180" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="07394396-e341-4356-a2df-eb14a067cb22" name="Find_ListItem in SharePoint" type="SubSheetInfo"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Helps to Find List Item in SharePoint Library. Searches for item by provided column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="24a38c66-f65d-4852-8772-b7dab0782fa4" name="Start" type="Start"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-255" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder)" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Share thele to be searched. (Ex:- APIdoc.docx)" stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search for" stage="Find_Item_By" /><input type="flag" name="Is Case Sensitive" narrative="Default value is False. Mark it as true to have a CaseSensitive search" stage="Case_Sensitive" /></inputs><onsuccess>dce416ef-861c-48ef-9d95-118dc1cf1d43</onsuccess></stage><stage stageid="35ede6a1-4364-4288-a1d6-fb4e2aa896ce" name="End" type="End"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="540" /><outputs><output type="flag" name="List Item Found" narrative="Returns True if List item is in provided list" stage="Found" /><output type="text" name="Result" narrative="Item found details" stage="Run Report" /></outputs></stage><stage stageid="0fc6fcd7-bc45-4b8f-8db6-aee0bf35c5ae" name="Build Script" type="Calculation"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-105" /><onsuccess>de13ca19-f82c-43e0-abc9-e757264fde0e</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;  NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize 5000&quot; &amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot;Write-Host $item['ID'] $item['Title'] $item['&quot; &amp; [Find_Item_By] &amp; &quot;'] &#xA;&quot; &amp; NewLine() &amp; &quot;Exit &quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;NOT FOUND&quot; &amp; Chr(34)&#xA;" stage="Script" /></stage><stage stageid="a05dd916-9ae6-484f-b817-25ceef804bd7" name="Run PnP_Script" type="SubSheet"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>5c4ba2f9-fdcd-436d-8596-b1cbec6e1d53</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="dbe1eab4-3d16-4359-b8ae-c3ff99b664f0" name="Delete_Script" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3b79d6db-43ed-4487-baea-edfcc782db57</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="de13ca19-f82c-43e0-abc9-e757264fde0e" name="Generate_PnPScript" type="SubSheet"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Find&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>a790050a-c98d-4f43-be5b-11977b7eef90</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="a790050a-c98d-4f43-be5b-11977b7eef90" name="Check_Error" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-15" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>3bc90576-f1e4-47fc-ae43-89cac72d6a81</ontrue><onfalse>a05dd916-9ae6-484f-b817-25ceef804bd7</onfalse></stage><stage stageid="3bc90576-f1e4-47fc-ae43-89cac72d6a81" name="Exception while creating  Script" type="Exception"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="210" y="-15" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="082f05a8-fbf9-47a5-9934-12568db4cce9" name="Check Process_Exist" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>041f92a9-9fa7-4988-89be-82303082f606</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="041f92a9-9fa7-4988-89be-82303082f606" name="ProcessExist?" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="195" /><decision expression="[P_Exists]=True" /><ontrue>d5d80b3d-5ff3-4937-8050-d6e10911a428</ontrue><onfalse>fa7bafcb-907e-4714-a80e-1941c481a03b</onfalse></stage><stage stageid="fa7bafcb-907e-4714-a80e-1941c481a03b" name="Anchor8" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="195" w="10" h="10" /><onsuccess>629ac1b2-49c1-4e22-895d-6a7a22cdad00</onsuccess></stage><stage stageid="d5d80b3d-5ff3-4937-8050-d6e10911a428" name="Kill Process" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>dbe1eab4-3d16-4359-b8ae-c3ff99b664f0</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="629ac1b2-49c1-4e22-895d-6a7a22cdad00" name="Anchor9" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="300" w="10" h="10" /><onsuccess>dbe1eab4-3d16-4359-b8ae-c3ff99b664f0</onsuccess></stage><stage stageid="63c9cc5e-1871-4569-ac1d-30afc6b7f6be" name="SP_Site_URL" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-240" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2fbfd208-0ed6-487d-9e81-5e24ac810cb3" name="SP_Target_List" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="284d5307-c3b9-4190-b89a-e059ce2a4f4e" name="Item_To_Find" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>List item to retrieve</narrative><display x="-210" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="40886dc7-172a-4854-af05-ec44fa645de8" name="Input" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-270" y="-45" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1e18e6f1-fe74-47ec-a89d-7a73464b14d7" name="Output" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-270" y="105" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e8273f32-0a67-48ec-8029-768c8bee0afb" name="Inhouse" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-450" y="-45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7da4fbb6-b9a6-4ffa-82fa-901cd482484a" name="Script" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-420" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c7e65bfe-c738-4262-9d63-77a751d69ad4" name="Return Message" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bb18e513-509b-47ab-b901-c6d28207a554" name="Script Path" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="435a6586-6842-4128-8f96-3dc39c9dbc79" name="Error_Message" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06d4f65b-ceb9-4c96-8460-bb3e43b62ca9" name="Run Report" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b4cf6cc7-822e-45fa-9a55-25a7a6de3b74" name="P_Exists" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="25229ff3-f5a4-4979-abca-89f8e4304f52" name="Standards" type="Note"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://eu001-sp.shell.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="970ffc2f-60e6-4422-aeba-5258a5410c97" name="Unexpected exception recover" type="Recover"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="450" y="-120" /><onsuccess>64c81a00-1b29-449d-9df9-b22ed0cde5d8</onsuccess></stage><stage stageid="40f60ce7-4ecb-4719-ac1b-b7701043b413" name="Unexpected Exception" type="Exception"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="bd282adc-5793-48f8-90a6-0459834accd9" name="Script_Location" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="901c402a-fc7c-41c4-8495-112a610a11c3" name="Found" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="240" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="786e6fd0-8898-41f6-b81e-8046fc10681d" name="Check if found" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="450" /><decision expression="InStr(Trim(Lower([Run Report])), Trim(Lower([Item_To_Find])))&gt;0" /><ontrue>ec1ab617-8df1-45b5-a479-1e7c51a4ab02</ontrue><onfalse>8b8a8235-2706-4535-8399-d3966d80f136</onfalse></stage><stage stageid="ec1ab617-8df1-45b5-a479-1e7c51a4ab02" name="Assign True to Found" type="Calculation"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="495" /><onsuccess>35ede6a1-4364-4288-a1d6-fb4e2aa896ce</onsuccess><calculation expression="True" stage="Found" /></stage><stage stageid="8b8a8235-2706-4535-8399-d3966d80f136" name="Anchor14" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="450" w="10" h="10" /><onsuccess>2f8be2e1-8a10-43e2-8650-1f37734ec5cf</onsuccess></stage><stage stageid="2f8be2e1-8a10-43e2-8650-1f37734ec5cf" name="Anchor15" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="540" w="10" h="10" /><onsuccess>35ede6a1-4364-4288-a1d6-fb4e2aa896ce</onsuccess></stage><stage stageid="24dad516-ca24-4bd5-b0cb-404000daca07" name="Note3" type="Note"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

