.25</zoom></view></subsheet><subsheet subsheetid="3104f13b-652c-4d04-b4a4-0c5705056e03" type="Normal" published="True"><name>Change Font</name><view><camerax>0</camerax><cameray>-21</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="0012ec08-e226-4b95-86d9-fa2ae9f8e888" type="Normal" published="True"><name>Add Borders</name><view><camerax>0</camerax><cameray>42</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="fe22de88-3f3b-4066-a678-c3176a0afd97" type="Normal" published="True"><name>Get number of used Rows</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="68c476f9-efb2-4f8f-9d5d-178871f6e120" type="Normal" published="True"><name>Get Specific Column Address(Alphabet)</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="9c4db00b-c32e-4228-b636-43e22f267984" type="Normal" published="True"><name>Get Last Used Cell Address</name><view><camerax>0</camerax><cameray>-84</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="ecee8787-ddc3-4f3f-99f9-74ecaf8956e2" type="Normal" published="True"><name>Get Last Used Column Address(Alphabet)</name><view><camerax>0</camerax><cameray>-21</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="85e278a2-d900-4e62-874c-f1e33d9dfcf2" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>807dd9dc-1a15-491e-869a-55ccfa64c55b</onsuccess></stage><stage stageid="807dd9dc-1a15-491e-869a-55ccfa64c55b" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="364c37da-c187-4392-b347-8f089003e939" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>Microsoft.VisualBasic.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import><import>Microsoft.VisualBasic</import></imports><language>visualbasic</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="eda12a0b-157d-45c2-bc13-2b168952e1a2" name="Clean Up" type="SubSheetInfo"><subsheetid>241dac12-91d6-457a-9a2d-11c438748e4a</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="557741d4-91fe-4712-8090-6e8d56157d65" name="Start" type="Start"><subsheetid>241dac12-91d6-457a-9a2d-11c438748e4a</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>b130f9dc-c4ea-4a91-9fbf-cb94933222c3</onsuccess></stage><stage stageid="b130f9dc-c4ea-4a91-9fbf-cb94933222c3" name="End" type="End"><subsheetid>241dac12-91d6-457a-9a2d-11c438748e4a</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="d1ee9923-768c-4d38-976c-11245e020535" name="Note1" type="Note"><subsheetid>241dac12-91d6-457a-9a2d-11c438748e4a</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="85f3a9c4-6d72-41e7-89ad-871b55441d05" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="fb78f156-1e50-46c3-9c72-9df0923949ce" name="Write Queue Data into Excel" type="SubSheetInfo"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><narrative>Write data from collection into new excel sheet and save the file</narrative><display x="-390" y="-90" w="150" h="90" /></stage><stage stageid="e921cb30-5837-4093-ba5a-5933f661ce56" name="End" type="End"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><loginhibit /><display x="15" y="270" /></stage><stage stageid="389fc579-1d63-4f4b-8535-7a6e356b51d4" name="Create Instance" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="105" y="105" /><inputs><input type="flag" name="Enable Events" narrative="Flag to indicate that events should be enabled / disabled on the attached instance - defaulted to True" expr="" /></inputs><outputs><output type="number" name="handle" narrative="An integer which can be used to identify the created instance in subsequent actions" stage="handle" /></outputs><onsuccess>6c560f6e-6107-434d-8052-f71e8489707e</onsuccess><resource object="MS Excel VBO" action="Create Instance" /></stage><stage stageid="ba16b647-3818-437b-bb7c-0001e7c36524" name="Close all Instances" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="15" y="105" /><onsuccess>389fc579-1d63-4f4b-8535-7a6e356b51d4</onsuccess><resource object="MS Excel VBO" action="Close All Instances" /></stage><stage stageid="2a699fcb-39e2-4f7e-856f-d3308205dab4" name="Open WorkBook" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="285" y="165" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." expr="[Report Name]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="ReportName WB" /></outputs><onsuccess>9ef42c33-d325-4a6c-8637-5439cdf9f1bc</onsuccess><resource object="MS Excel VBO" action="Open Workbook" /></stage><stage stageid="6c560f6e-6107-434d-8052-f71e8489707e" name="Create Workbook" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="195" y="105" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be created. The default of zero indicates the currently active instance." expr="[handle]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name of the workbook that Excel has created - this can be changed using the &quot;Save Workbook As&quot; action" stage="Workbook Name" /></outputs><onsuccess>1ccbb89e-329f-4580-a051-0ae3d7e10972</onsuccess><resource object="MS Excel VBO" action="Create Workbook" /></stage><stage stageid="1ccbb89e-329f-4580-a051-0ae3d7e10972" name="Save as" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="285" y="105" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance for which the current workbook which should be saved. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The full path and file name to which the current workbook should be saved." expr="[Report Name]" /></inputs><outputs><output type="text" name="New Workbook Name" narrative="The new workbook name which Excel will use to identify the workbook." stage="ReportName WB" /></outputs><onsuccess>2a699fcb-39e2-4f7e-856f-d3308205dab4</onsuccess><resource object="MS Excel VBO" action="Save Current Workbook As" /></stage><stage stageid="9ef42c33-d325-4a6c-8637-5439cdf9f1bc" name="Write Collection" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="195" y="165" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the specified collection should be written. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook within which the data should be written. The default empty value indicates the current workbook within the specified instance." expr="[ReportName WB]" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet on which the given data should be written. The default empty value indicates the current sheet within the specified workbook." expr="&quot;Sheet1&quot;" /><input type="collection" name="Collection" narrative="The collection containing the data which should be written to the worksheet." expr="[Data_Collection]" /><input type="text" name="Cell Reference" narrative="The reference at which the collection should be written." expr="&quot;A1&quot;" /><input type="flag" name="Include Column Names" narrative="True to indicate that the column names from the collection should be written out as the first row; False to ignore the column names and just write out the data." expr="True" /></inputs><onsuccess>33290098-8032-41cb-bd65-7b5aa155c10e</onsuccess><resource object="MS Excel VBO" action="Write Collection" /></stage><stage stageid="33290098-8032-41cb-bd65-7b5aa155c10e" name="Save &amp; Close WorkBook" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="105" y="165" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be closed resides. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be closed." expr="[ReportName WB]" /><input type="flag" name="Save Data" narrative="True to save the data before closing the workbook; The default of False will discard any changes before closing the workbook." expr="True" /></inputs><onsuccess>5f04a45b-422b-4060-9be7-0b33053a02c6</onsuccess><resource object="MS Excel VBO" action="Close Workbook" /></stage><stage stageid="2effc2f6-c535-4569-99f7-5735925395af" name="Block16" type="Block"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-60" y="75" w="510" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6d7b0d63-d035-4bc6-ab73-a5e4f69080b6" name="Recover9" type="Recover"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="390" y="120" /><onsuccess>59d23539-f51f-4531-84cf-cfecd08fa5c8</onsuccess></stage><stage stageid="59d23539-f51f-4531-84cf-cfecd08fa5c8" name="Close all Instances" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="510" y="120" /><onsuccess>af7a498e-dcc9-4ae5-8773-5fbe391f9817</onsuccess><resource object="MS Excel VBO" action="Close All Instances" /></stage><stage stageid="af7a498e-dcc9-4ae5-8773-5fbe391f9817" name="Exception" type="Exception"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="615" y="120" w="90" h="60" /><exception localized="yes" type="System Exception" detail="" usecurrent="yes" /></stage><stage stageid="5f04a45b-422b-4060-9be7-0b33053a02c6" name="Close all Instances" type="Action"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="15" y="165" /><onsuccess>e921cb30-5837-4093-ba5a-5933f661ce56</onsuccess><resource object="MS Excel VBO" action="Close All Instances" /></stage><stage stageid="02abf4cb-3e22-47dd-a0be-b4c6a74d5ee4" name="Report Name" type="Data"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-390" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af9c3b14-6797-4c5b-904b-1c57ec235847" name="handle" type="Data"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-390" y="75" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="745074be-2b89-4419-9441-7af7a0aa6f72" name="ReportName WB" type="Data"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-390" y="120" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6468519c-617d-4c4f-8a88-e9d9dc5c1d51" name="Parameters" type="Block"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-495" y="-15" w="210" h="315" /><font family="Segoe UI" size="10" style="Regular" color="FF9900" /></stage><stage stageid="d084348f-0cb3-42c6-aea9-d2072b8b1379" name="Data_Collection" type="Collection"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-390" y="165" w="180" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="165b36e5-fa2d-44d1-9f23-a2ce533c9bd9" name="Workbook Name" type="Data"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="-390" y="210" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="77984834-dae0-4d19-b08c-fedaf94c69f0" name="Start" type="Start"><subsheetid>a9b7b70e-4c10-4c77-b939-0d79ed38fea9</subsheetid><display x="15" y="-120" /><inputs><input type="text" name="Queue Report Name" narrative="Name with Path of Report file" stage="Report Name" /><input type="collection" name="QueueData_Collection" narrative="Collection that has to be written into excel" stage="Data_Collection" /></inputs><onsuccess>dd6a17d1-9dc3-4b61-9dd2-f1eb2991207e</onsuccess></stage><stage stageid="9a8000c7-c29e-47cb-a349-5cb2c1ae442a" name="Rename Columns" type="SubSheetInfo"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><narrative>Change column names - provide a collection with current names as field names and new column names in a singlr row against the cloumn name (Check sample collection in the action)</narrative><display x="-315" y="-105" w="150" h="90" /></stage><stage stageid="81b05992-2c64-4097-a001-22ccdba92d64" name="End" type="End"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><loginhibit /><display x="-30" y="165" /></stage><stage stageid="b81d55de-8697-4faa-b9c9-0dc7910640fb" name="Start" type="Start"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><display x="-30" y="-120" /><inputs><input type="text" name="Filename" narrative="Name with Path of the  file" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="collection" name="New Column Names" narrative="Collection with new Column Names - " stage="New Column Names" /></inputs><onsuccess>77e0fbb1-7591-48ae-b90b-9b538e652fa8</onsuccess></stage><stage stageid="61dbc496-da29-49b2-a0db-d41626a6f83b" name="Parameters" type="Block"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><display x="-435" y="-15" w="210" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FF9900" /></stage><stage stageid="5a20675c-9e3f-467a-9a2e-ffdc3522f948" name="New Column Names" type="Collection"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><display x="-330" y="75" w="180" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="d698bb55-0cd4-4434-b2a0-bbb19682cfb9" name="Format Excel(Standard)" type="SubSheetInfo"><subsheetid>8601327e-ad90-403d-945f-8fe5ad239944</subsheetid><narrative>Add Border, Change Font, Adjust Column width and Row Height(Standard settings)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="418f2985-a7be-4594-b155-27bf36eac8ab" name="Start" type="Start"><subsheetid>8601327e-ad90-403d-945f-8fe5ad239944</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="File name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheet name" stage="Sheetname" /></inputs><onsuccess>21f278ec-735b-45ce-86c3-730a6c81b7da</onsuccess></stage><stage stageid="5848f11b-da96-4ef5-9545-edd8db75826a" name="End" type="End"><subsheetid>8601327e-ad90-403d-945f-8fe5ad239944</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="dfca0c59-444a-420b-9423-ef28f84f0549" name="Add Title to Table" type="SubSheetInfo"><subsheetid>10e69c82-70d2-4e9c-b80a-5d4f4020b606</subsheetid><narrative>Add title to the Table</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="718b298e-7d1e-4ad5-8739-ca21f1ec180f" name="End" type="End"><subsheetid>10e69c82-70d2-4e9c-b80a-5d4f4020b606</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="22ea6c03-ad13-4000-8350-a720a6b88d54" name="Sample Collection" type="Collection"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><display x="-330" y="150" w="180" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="BP_Queue" type="text" description="Column name" /><field name="BP_Exception_Reason" type="text" description="Column name" /></collectioninfo><initialvalue><row><field name="BP_Queue" type="text" value="Queue" /><field name="BP_Exception_Reason" type="text" value="Exception Reason" /></row></initialvalue></stage><stage stageid="77e0fbb1-7591-48ae-b90b-9b538e652fa8" name="Rename_Column" type="Code"><subsheetid>9b1a5a42-2e77-4a04-8436-cca5db5f4f47</subsheetid><loginhibit /><display x="-30" y="15" w="180" h="60" /><inputs><input type="collection" name="New_Coll" expr="[New Column Names]" /><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /></inputs><onsuccess>81b05992-2c64-4097-a001-22ccdba92d64</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object
Dim TotalColumns as Integer = New_Coll.Rows.Count
Dim iThisColumn as Integer = -1
Dim Col_Count As Object
Dim Cell_Addr As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)

For Each Column as DataColumn in New_Coll.Columns
	If iThisColumn >= TotalColumns Then Exit For
	iThisColumn = iThisColumn + 1
	'MsgBox(Column.Columnname)
	'MsgBox(New_Coll.Rows.Item(0).Item(iThisColumn))
	Col_Count = xl.Match(Column.Columnname, xlSheet1.Range("1:1"), 0)
	Cell_Addr = Replace(xlSheet1.Cells(1, Col_Count).Address(False, False), "1", "") 
	xlSheet1.Range(Cell_Addr & "1").Value = New_Coll.Rows.Item(0).Item(iThisColumn)

Next

xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="21f278ec-735b-45ce-86c3-730a6c81b7da" name="Format Excel1" type="Code"><subsheetid>8601327e-ad90-403d-945f-8fe5ad239944</subsheetid><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /></inputs><onsuccess>5848f11b-da96-4ef5-9545-edd8db75826a</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)

'Column Exception_Reason Address
'Dim ER = xl.Match("Exception_Reason", xlBook.Sheets("Sheet1").Range("1:1"), 0)
'Dim ER_col = Replace(xlSheet1.Cells(1, ER).Address(False, False), "1", "")

'Get last Coulm Addres
Dim LCol_Count = xlSheet1.Cells(1, xlSheet1.Columns.Count).End(-4159).Column
Dim LastCol = Replace(xlSheet1.Cells(1, LCol_Count).Address(False, False), "1", "") 

'Get last row count
Dim N_Rows = xlSheet1.Cells(xlSheet1.Rows.Count, 1).End(-4162).Row

'Row and column
xlSheet1.Range("A1:" & LastCol & "1").ColumnWidth = 30
'xlSheet1.Range(ER_col & "1").ColumnWidth = 80
xlSheet1.Range("A1:A" & N_Rows).RowHeight = 30
xlSheet1.Range("A1:" & LastCol & N_Rows).HorizontalAlignment = -4131

'Borders
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(7).LineStyle = 1
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(8).LineStyle = 1
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(9).LineStyle = 1
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(10).LineStyle = 1
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(11).LineStyle = 1
xlSheet1.Range("A1:" & LastCol & N_Rows).Borders(12).LineStyle = 1

'Column names
xlSheet1.Range("A1:" & LastCol & "1").Font.Size = 16 
xlSheet1.Range("A1:" & LastCol & "1").Font.Bold = True
xlSheet1.Range("A1:" & LastCol & "1").Font.Italic = True
xlSheet1.Range("A1:" & LastCol & "1").Font.Color = RGB(0, 0, 92)
xlSheet1.Range("A2:" & LastCol & N_Rows).Font.Size = 11 
xlSheet1.Range("A2:" & LastCol & N_Rows).Font.Name = "Calibri"


xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="b6228432-6f0d-4c14-8cf8-2ed0b7cba0b6" name="Add Title1" type="Code"><subsheetid>10e69c82-70d2-4e9c-b80a-5d4f4020b606</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /><input type="text" name="Title" expr="[Title]" /></inputs><onsuccess>718b298e-7d1e-4ad5-8739-ca21f1ec180f</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)

'Get last Coulm Addres
Dim LCol_Count = xlSheet1.Cells(1, xlSheet1.Columns.Count).End(-4159).Column
Dim LastCol = Replace(xlSheet1.Cells(1, LCol_Count).Address(False, False), "1", "") 

'Heading
xlSheet1.Range("A1").EntireRow.Insert
xlSheet1.Range("A1:" & LastCol & "1").Merge
xlSheet1.Range("A1").RowHeight = 60
xlSheet1.Range("A1").Value = Title
xlSheet1.Range("A1").Font.Bold = True
xlSheet1.Range("A1").Font.Color = RGB(128, 0, 0)
xlSheet1.Range("A1").Font.Size = 20 
xlSheet1.Range("A1").Font.Name = "Times New Roman"
xlSheet1.Range("A1").VerticalAlignment = -4108

xlBook.Save()
xlBook.close() 
xl.Quit()

]]></code></stage><stage stageid="d80ed8be-0054-4e22-8c5a-65132e811301" name="Start" type="Start"><subsheetid>10e69c82-70d2-4e9c-b80a-5d4f4020b606</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="File name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="text" name="Title" narrative="Title of the report" stage="Title" /></inputs><onsuccess>b6228432-6f0d-4c14-8cf8-2ed0b7cba0b6</onsuccess></stage><stage stageid="d6216d3a-ccdf-4716-8f29-8636318595da" name="Title" type="Data"><subsheetid>10e69c82-70d2-4e9c-b80a-5d4f4020b606</subsheetid><display x="-180" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b590c236-778b-44af-a42b-33e8289f4e2c" name="Row Height and Column Width" type="SubSheetInfo"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><narrative>Change row height and column width for the given range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="20fbdbb8-037e-4046-976b-edff0e9e1b5d" name="Start" type="Start"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="Name with path of the file" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="text" name="Cell Range" narrative="Cell Range" stage="Cell Range" /><input type="number" name="Column Width" narrative="Column Width" stage="Column Width" /><input type="number" name="Row Height" narrative="Row Height" stage="Row Height" /></inputs><onsuccess>621a9ed8-91eb-4120-87b7-f77c984126ac</onsuccess></stage><stage stageid="f38702a5-1cb9-4aae-aeca-64b9bf6466c9" name="End" type="End"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="65461171-dad9-49d6-8d4d-b64c7c051983" name="Cell Range" type="Data"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d509079f-9dda-40dc-b405-ae022209ea65" name="Column Width" type="Data"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f40a4be1-4414-4b2d-9339-ca5d594926ab" name="Row Height" type="Data"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="621a9ed8-91eb-4120-87b7-f77c984126ac" name="Change Column width and Row Height" type="Code"><subsheetid>522bfeb3-54df-4619-a148-6eb92a2f48cf</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /><input type="number" name="Column_Width" expr="[Column Width]" /><input type="number" name="Row_Height" expr="[Row Height]" /></inputs><onsuccess>f38702a5-1cb9-4aae-aeca-64b9bf6466c9</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)



'Row and column
xlSheet1.Range(Cell_Range).ColumnWidth = Column_Width
xlSheet1.Range(Cell_Range).RowHeight = Row_Height
xlSheet1.Range(Cell_Range).HorizontalAlignment = -4131


xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="b07e3439-0737-4a16-940a-6db1425d0f2e" name="Change Font" type="SubSheetInfo"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><narrative>Change font size, bold/Italic/Underline, Color, font name for the given cell range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e7042445-5dd0-4976-9901-8d644f7be631" name="Start" type="Start"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="File name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="number" name="Font_Size" narrative="Font_Size" stage="Font_Size" /><input type="flag" name="Font_Bold" narrative="Font_Bold" stage="Font_Bold" /><input type="flag" name="Font_Italic" narrative="Font_Italic" stage="Font_Italic" /><input type="flag" name="Font_Underline" narrative="Font_Underline" stage="Font_Underline" /><input type="number" name="Font_Color(R)" narrative="RGB Code for Red (0-255)" stage="Font_Color(R)" /><input type="number" name="Font_Color(G)" narrative="RGB Code for Green (0-255)" stage="Font_Color(G)" /><input type="number" name="Font_Color(B)" narrative="RGB Code for Blue (0-255)" stage="Font_Color(B)" /><input type="text" name="Font_Name" narrative="Font_Name" stage="Font_Name" /><input type="text" name="Cell Range" narrative="Cell Range" stage="Cell Range" /></inputs><onsuccess>a2c29e50-209c-4051-ba67-7caec4847d70</onsuccess></stage><stage stageid="e50bfcfa-ed6e-412e-a864-ce92a4b99b07" name="End" type="End"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="a2c29e50-209c-4051-ba67-7caec4847d70" name="Change Font" type="Code"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /><input type="number" name="Font_Size" expr="[Font_Size]" /><input type="flag" name="Font_Bold" expr="[Font_Bold]" /><input type="flag" name="Font_Italic" expr="[Font_Italic]" /><input type="flag" name="Font_Underline" expr="[Font_Underline]" /><input type="number" name="Font_Color_R" expr="[Font_Color(R)]" /><input type="number" name="Font_Color_G" expr="[Font_Color(G)]" /><input type="number" name="Font_Color_B" expr="[Font_Color(B)]" /><input type="text" name="Font_Name" expr="[Font_Name]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /></inputs><onsuccess>e50bfcfa-ed6e-412e-a864-ce92a4b99b07</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)


xlSheet1.Range(Cell_Range).Font.Size = Font_Size 
xlSheet1.Range(Cell_Range).Font.Bold = Font_Bold
xlSheet1.Range(Cell_Range).Font.Italic = Font_Italic
xlSheet1.Range(Cell_Range).Font.Underline = Font_Underline
xlSheet1.Range(Cell_Range).Font.Color = RGB(Font_Color_R,Font_Color_G,Font_Color_B) 
xlSheet1.Range(Cell_Range).Font.Name = Font_Name


xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="cd152ce9-0f1f-417b-a2ce-6df2626d04f4" name="Add Borders" type="SubSheetInfo"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><narrative>Add border lines (All 8 borders) for the given cell range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d56463e2-1934-445b-bacb-b22da9de4fec" name="End" type="End"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="db54ce38-99f3-4123-8981-7f3beb8f6025" name="Font_Size" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>number</datatype><initialvalue>12</initialvalue><private /><alwaysinit /></stage><stage stageid="c925f110-e7b4-423b-9f19-50c7b0bd03e3" name="Font_Bold" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="f3643072-3515-4da4-8501-03bf64d72c47" name="Font_Italic" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="18bdf34c-8c31-4615-87da-a97299c2ce75" name="Font_Underline" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="120" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="a4a32711-9ff7-4119-b505-e666a6b764b1" name="Font_Name" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="240" w="180" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Calibri</initialvalue><private /><alwaysinit /></stage><stage stageid="bf3decfb-9389-47b5-9e5d-a5c77ccaf9eb" name="Cell Range" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="270" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7db4ae61-5ed1-4627-9ec6-d35161b000f1" name="Font_Color(R)" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="150" w="180" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="f0038525-084b-4f6e-b187-4dfafdde6325" name="Font_Color(G)" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="180" w="180" h="30" /><datatype>number</datatype><initialvalue>255</initialvalue><private /><alwaysinit /></stage><stage stageid="08796a4e-78b7-4a33-8749-458e1b59c996" name="Font_Color(B)" type="Data"><subsheetid>3104f13b-652c-4d04-b4a4-0c5705056e03</subsheetid><display x="-195" y="210" w="180" h="30" /><datatype>number</datatype><initialvalue>56</initialvalue><private /><alwaysinit /></stage><stage stageid="6126c3e1-4c35-4d37-94e3-b10c24dd5c03" name="Add Borders" type="Code"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /><input type="flag" name="DiagonalDown" expr="[DiagonalDown]" /><input type="flag" name="DiagonalUp" expr="[DiagonalUp]" /><input type="flag" name="EdgeBottom" expr="[EdgeBottom]" /><input type="flag" name="EdgeLeft" expr="[EdgeLeft]" /><input type="flag" name="EdgeRight" expr="[EdgeRight]" /><input type="flag" name="EdgeTop" expr="[EdgeTop]" /><input type="flag" name="InsideHorizontal" expr="[InsideHorizontal]" /><input type="flag" name="InsideVertical" expr="[InsideVertical]" /></inputs><onsuccess>d56463e2-1934-445b-bacb-b22da9de4fec</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)


'Borders
If(DiagonalDown) Then
xlSheet1.Range(Cell_Range).Borders(5).LineStyle = 1
End If
If(DiagonalUp) Then
xlSheet1.Range(Cell_Range).Borders(6).LineStyle = 1
End If
If(EdgeLeft) Then
xlSheet1.Range(Cell_Range).Borders(7).LineStyle = 1
End If
If(EdgeTop) Then
xlSheet1.Range(Cell_Range).Borders(8).LineStyle = 1
End If
If(EdgeBottom) Then
xlSheet1.Range(Cell_Range).Borders(9).LineStyle = 1
End If
If(EdgeRight) Then
xlSheet1.Range(Cell_Range).Borders(10).LineStyle = 1
End If
If(InsideVertical) Then
xlSheet1.Range(Cell_Range).Borders(11).LineStyle = 1
End If
If(InsideHorizontal) Then
xlSheet1.Range(Cell_Range).Borders(12).LineStyle = 1
End If



xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="60475636-19ae-41f3-95ca-5f2bd44ed4c0" name="Get number of used Rows" type="SubSheetInfo"><subsheetid>fe22de88-3f3b-4066-a678-c3176a0afd97</subsheetid><narrative>Get row count</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8939898c-635f-407d-a200-1e2039b48203" name="End" type="End"><subsheetid>fe22de88-3f3b-4066-a678-c3176a0afd97</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="Row Count" narrative="Row Count" stage="Row Count" /></outputs></stage><stage stageid="e49e9ce4-5e2d-432e-80d7-57274dcc5f72" name="Get Specific Column Address(Alphabet)" type="SubSheetInfo"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><narrative>Get Column Address of the column  - just the alphabet (Ex:A, S, AXC....) 
{Column name required}</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="eae0cb40-c368-422b-bf60-5ea25a561e27" name="End" type="End"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Column Address" narrative="Column Address" stage="Col_Addr" /></outputs></stage><stage stageid="6605882d-23d6-441e-b492-6fac3c4247c6" name="Get Last Used Cell Address" type="SubSheetInfo"><subsheetid>9c4db00b-c32e-4228-b636-43e22f267984</subsheetid><narrative>Get last used cell address (Ex:S49)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7e1c7527-246c-4266-9885-5c9d32e61ee7" name="End" type="End"><subsheetid>9c4db00b-c32e-4228-b636-43e22f267984</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Last Cell Address" narrative="Last Cell Address" stage="Last_cell" /></outputs></stage><stage stageid="b423c3e4-e32e-47e4-883f-2af8abc9a252" name="Start" type="Start"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="Report name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheetname" stage="Sheetname" /><input type="flag" name="InsideHorizontal" narrative="InsideHorizontal Border Flag" stage="InsideHorizontal" /><input type="flag" name="InsideVertical" narrative="InsideVertical Border Flag" stage="InsideVertical" /><input type="flag" name="DiagonalDown" narrative="DiagonalDownl Border Flag" stage="DiagonalDown" /><input type="flag" name="DiagonalUp" narrative="DiagonalUpl Border Flag" stage="DiagonalUp" /><input type="flag" name="EdgeBottom" narrative="EdgeBottoml Border Flag" stage="EdgeBottom" /><input type="flag" name="EdgeLeft" narrative="EdgeLeftl Border Flag" stage="EdgeLeft" /><input type="flag" name="EdgeRight" narrative="EdgeRightl Border Flag" stage="EdgeRight" /><input type="flag" name="EdgeTop" narrative="EdgeTopl Border Flag" stage="EdgeTop" /></inputs><onsuccess>6126c3e1-4c35-4d37-94e3-b10c24dd5c03</onsuccess></stage><stage stageid="cf1d5c50-75a5-4f40-a01d-4c50f73ee855" name="DiagonalDown" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="60" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="abbc049f-e311-432f-8a7a-b493d8117a00" name="DiagonalUp" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="90" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="029acd9c-24e4-487c-b972-91cdda9af60d" name="Cell Range" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7d682da6-c521-4e30-b6ac-6de5ee98bead" name="EdgeLeft" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="120" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="f8a6ec4c-3965-4934-8824-17c61c28b0c3" name="EdgeTop" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="150" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="ac3342ff-31f2-4b69-96fb-cb127bf3f2ac" name="EdgeBottom" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="180" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="d2ffc723-e4ad-4d0e-8d73-a2ab4d23afba" name="EdgeRight" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="210" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="5c2d3ce3-0a36-47f2-97d0-0ec74e12c095" name="InsideVertical" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="240" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="484df29a-e2a2-455b-9f38-84a0bc7f3479" name="InsideHorizontal" type="Data"><subsheetid>0012ec08-e226-4b95-86d9-fa2ae9f8e888</subsheetid><loginhibit /><display x="-195" y="270" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="0aacb840-cd15-44e4-ba87-a9943ae032d2" name="Number of Rows" type="Code"><subsheetid>fe22de88-3f3b-4066-a678-c3176a0afd97</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /></inputs><outputs><output type="number" name="N_Rows" stage="Row Count" /></outputs><onsuccess>8939898c-635f-407d-a200-1e2039b48203</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)


'Get last row count
N_Rows = xlSheet1.Cells(xlSheet1.Rows.Count, 1).End(-4162).Row


xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="95c3304f-c88f-4df5-8143-a66367e33d67" name="Start" type="Start"><subsheetid>fe22de88-3f3b-4066-a678-c3176a0afd97</subsheetid><loginhibit /><preconditions><condition narrative="Add Border, Change Font, Adjust Column width and Row Height" /></preconditions><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="File name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheetname" stage="Sheetname" /></inputs><onsuccess>0aacb840-cd15-44e4-ba87-a9943ae032d2</onsuccess></stage><stage stageid="854bcd74-d6d9-46b9-b3d9-c44e541638b4" name="Row Count" type="Data"><subsheetid>fe22de88-3f3b-4066-a678-c3176a0afd97</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="59de4218-89e5-44f5-9ae2-cafce3a027e3" name="Column Address" type="Code"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /><input type="text" name="Column_name" expr="[Column Name]" /></inputs><outputs><output type="text" name="Col_Addr" stage="Col_Addr" /></outputs><onsuccess>eae0cb40-c368-422b-bf60-5ea25a561e27</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)

Dim Col_count = xl.Match(Column_name, xlSheet1.Range("1:1"), 0)
Col_Addr = Replace(xlSheet1.Cells(1, Col_count).Address(False, False), "1", "")


xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="51fc750d-833e-42c4-9c02-207f2aaa6285" name="Start" type="Start"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><loginhibit /><preconditions><condition narrative="Add Border, Change Font, Adjust Column width and Row Height" /></preconditions><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="Report name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheetname" stage="Sheetname" /><input type="text" name="Column Name" narrative="Column Name whose address to found" stage="Column Name" /></inputs><onsuccess>59de4218-89e5-44f5-9ae2-cafce3a027e3</onsuccess></stage><stage stageid="5c2dc937-4f5b-41f8-817b-e63b48f532f1" name="Column Name" type="Data"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9809e81a-45a5-437b-8ac0-ba8d6902af29" name="Col_Addr" type="Data"><subsheetid>68c476f9-efb2-4f8f-9d5d-178871f6e120</subsheetid><display x="-195" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7eec757e-4e3d-426c-ac35-5f879508079d" name="Cell Address" type="Code"><subsheetid>9c4db00b-c32e-4228-b636-43e22f267984</subsheetid><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="text" name="Sheetname" expr="[Sheetname]" /></inputs><outputs><output type="text" name="Last_cell" stage="Last_cell" /></outputs><onsuccess>7e1c7527-246c-4266-9885-5c9d32e61ee7</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(Filename) 
xlSheet1 = xlBook.WorkSheets(Sheetname)

'Get last Coulm Addres
Dim LCol_Count = xlSheet1.Cells(1, xlSheet1.Columns.Count).End(-4159).Column
Dim LastCol = Replace(xlSheet1.Cells(1, LCol_Count).Address(False, False), "1", "") 

'Get last row count
Dim N_Rows = xlSheet1.Cells(xlSheet1.Rows.Count, 1).End(-4162).Row

Last_cell = LastCol & N_Rows

xlBook.Save()
xlBook.close() 
xl.Quit()
]]></code></stage><stage stageid="9d9a9486-9666-40fc-a4a0-49275175d5be" name="Start" type="Start"><subsheetid>9c4db00b-c32e-4228-b636-43e22f267984</subsheetid><loginhibit /><preconditions><condition narrative="Add Border, Change Font, Adjust Column width and Row Height" /></preconditions><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="Fiel name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheetname" stage="Sheetname" /></inputs><onsuccess>7eec757e-4e3d-426c-ac35-5f879508079d</onsuccess></stage><stage stageid="1b9bb39e-62c3-4885-9178-d79030370d9b" name="Last_cell" type="Data"><subsheetid>9c4db00b-c32e-4228-b636-43e22f267984</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1ba2319-1e22-441b-b168-83b2257534b0" name="Get Last Used Column Address(Alphabet)" type="SubSheetInfo"><subsheetid>ecee8787-ddc3-4f3f-99f9-74ecaf8956e2</subsheetid><narrative>Get Last Used Column Address - Column name not required (Ex:Z, AD, GMM....)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="38e8c950-808c-42fd-83f2-3dcf078d2647" name="End" type="End"><subsheetid>ecee8787-ddc3-4f3f-99f9-74ecaf8956e2</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Last Column Address" narrative="Last Column Address" stage="Lcol_Addr" /></outputs></stage><stage stageid="ca847113-641d-4e01-97e7-3845ac987d9d" name="Start" type="Start"><subsheetid>ecee8787-ddc3-4f3f-99f9-74ecaf8956e2</subsheetid><loginhibit /><preconditions><condition narrative="Add Border, Change Font, Adjust Column width and Row Height" /></preconditions><display x="15" y="-105" /><inputs><input type="text" name="Filename" narrative="File name with path" stage="Filename" /><input type="text" name="Sheetname" narrative="Sheetname" stage="Sheetname" /></inputs><onsuccess>cff048db-eace-4210-8e5a-878fcdbef2d9</onsuccess></sta