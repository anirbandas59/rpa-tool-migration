="ScriptLocation" /><input type="text" name="Domain(Optional -Only For Testing)" narrative="Parameter to test with different Domain. By Default it is shell.com" stage="Domain" /></inputs><onsuccess>965f9b7a-75d0-4000-86c3-72b978cbb9eb</onsuccess></stage><stage stageid="5407b9a7-bffe-43f4-aec8-1e92d38c386f" name="SharePointURL" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-60" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="208d8281-bbed-4fa2-909e-c6e2b52eefcd" name="Input" type="Block"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-105" y="45" w="90" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="eadd5876-ac9e-496c-bd19-f28548099ee3" name="Output" type="Block"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-105" y="210" w="90" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6941e365-d1ce-438a-ad96-466421465d7d" name="Status" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-60" y="285" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="73c6f168-677b-47e0-9114-ba02a06788a3" name="Script_Path" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-225" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="208a5d88-9e79-494a-ba1f-0c5bff511bcb" name="Inhouse" type="Block"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-315" y="45" w="180" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="17fe3fe8-467b-4b36-bac0-62d7921ef2b5" name="Script_txt" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-225" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3a51614a-fe8e-466c-8305-bb78adfde748" name="UserNm" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-225" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="024d6161-952c-4348-a0b4-098d09db7d57" name="Assumptions " type="Note"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><narrative>Assuming all the systems are having Powershell_Ise.exe in the below path.
"C:\Windows\System32\WindowsPowerShell\v1.0\powershell_ise.exe"


SharePointURL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)</narrative><display x="-225" y="-30" w="180" h="150" /></stage><stage stageid="6b3f33d3-fa73-4eb7-a1d2-e0a93a123ab2" name="Return Message" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-225" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7429926d-8970-4cd2-aded-e1a2cf04d85a" name="ScriptLocation" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-60" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="594472c7-3f05-4b2d-b846-3a0388785738" name="Shell_Script_StatusBar" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-60" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07f3a477-04f3-4a49-93de-9fb071de9a30" name="Retry" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="-225" y="240" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="ed3906a0-5a74-48c0-bd82-a4f141962a8b" name="Process_Exist" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-225" y="270" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e39937d2-694e-4d16-b2f3-eb1776f79913" name="Domain" type="Data"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><display x="-225" y="150" /><datatype>text</datatype><initialvalue xml:space="preserve">shell.com</initialvalue><private /><alwaysinit /></stage><stage stageid="d44af9c8-15a7-46d9-bb5a-1710bf8cc496" name="End2" type="End"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><loginhibit /><display x="195" y="-60" /><outputs><output type="text" name="Run_status" narrative="Provide script run status." stage="Status" /></outputs></stage><stage stageid="1fcf3c1e-a1b5-497f-b2ac-50bc7c4f524d" name="Start" type="Start"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><preconditions><condition narrative="Make sure the script should be available." /></preconditions><display x="-15" y="-135" /><inputs><input type="text" name="Script_Path" narrative="Script Location" stage="Script_Path" /><input type="text" name="Application" narrative="Application.exe" stage="Application" /></inputs><onsuccess>d99ff84f-11d9-4b61-a8fc-57dff9851931</onsuccess></stage><stage stageid="abbefc43-e916-4631-8e25-2628dfc3969c" name="End" type="End"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-15" y="90" /><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Success_Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs></stage><stage stageid="d99ff84f-11d9-4b61-a8fc-57dff9851931" name="Run Power Shell Script1" type="Code"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-15" y="-60" /><inputs><input type="text" name="Script_Path" expr="[Script_Path]" /><input type="text" name="Application_nm" expr="[Application]" /></inputs><outputs><output type="text" name="S_MSG" stage="Success_Message" /><output type="text" name="E_MSG" stage="Error_Message" /></outputs><onsuccess>b13fc53f-248f-4b10-81c3-d137c27ed387</onsuccess><code><![CDATA[String Sc_Path;
S_MSG = "";
E_MSG = "";

Process process = new Process();
{
	try
		{
			string eOut = null;		
			Sc_Path = Script_Path;
			ProcessStartInfo startInfo = new ProcessStartInfo();
            startInfo.FileName = Application_nm;
            startInfo.Arguments = Sc_Path;     
            startInfo.RedirectStandardOutput = true;
            startInfo.RedirectStandardError = true;
            startInfo.UseShellExecute = false;
            startInfo.CreateNoWindow = true;
            
            process.StartInfo = startInfo;
            process.Start();
			StreamReader Response = process.StandardOutput;
			S_MSG= Response.ReadToEnd();
			E_MSG= process.StandardError.ReadToEnd();
			
			process.WaitForExit();
		}
	catch (Exception exp)
		{
			
			E_MSG = string.Format("",exp);
			
			
		}
