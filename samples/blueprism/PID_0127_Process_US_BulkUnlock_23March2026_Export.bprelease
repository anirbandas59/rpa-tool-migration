" /><outputs><output type="text" name="TempPath" stage="TempPath" /></outputs></stage><stage stageid="01891317-deac-47c9-af5e-edcef87a5d7f" name="Request Key" type="Data"><subsheetid>e6ae488c-dde5-47ac-a3cc-59954ff7af4b</subsheetid><loginhibit onsuccess="true" /><display x="-225" y="-90" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0503e573-828e-4f9c-a0ee-767e16b104e8" name="Item IDs" type="Collection"><subsheetid>e6ae488c-dde5-47ac-a3cc-59954ff7af4b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="45" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Item ID" type="text" description="The Item ID of the work queue item" /></collectioninfo></stage><stage stageid="53b65be4-6cf2-422d-8c3b-b271162a24df" name="Item Count" type="Data"><subsheetid>e6ae488c-dde5-47ac-a3cc-59954ff7af4b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5f089b70-3d61-4b45-8a91-e97c600099cb" name="Get Task Item Data" type="Action"><subsheetid>e6ae488c-dde5-47ac-a3cc-59954ff7af4b</subsheetid><loginhibit onsuccess="true" /><narrative>Get data relating to an item in a queue. You do not need to have a lock on the item to do this.</narrative><display x="135" y="75" w="90" h="30" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to get data from. An error will be raised if this item does not exist." expr="[Item IDs.Item ID]" /></inputs><outputs><output type="text" name="Key" narrative="The key value of the item." stage="Key" /><output type="number" name="Priority" narrative="The priority of the item" stage="" /><output type="text" name="Status" narrative="The status of the item." stage="Status" /><output type="number" name="Attempts" narrative="The number of attempts already made to work this item." stage="" /><output type="times