MinAccess:- Add_Edit( With out Delet)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8f1c8f8a-bff7-46df-b2d0-d74929eb3d51" name="Start" type="Start"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><preconditions><condition narrative="Item ID required for Identifying the List_Item. Use &quot;Get_ListItem_ID&quot; action to get Item ID." /></preconditions><display x="15" y="-180" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234" stage="SP_Site_URL" /><input type="text" name="SP_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Item_Updated_Values" narrative="Provide the Column name and Values to be updated in format &quot;Column1&quot;=&quot;Value&quot;;&quot;Column2&quot;=&quot;value2&quot; Ex:- &quot;Emp_Name&quot; =&quot;Abhi&quot;;&quot;Location&quot;=&quot;Chennai&quot;;&quot;DOB&quot; = &quot;03/05/1987&quot;;&quot;Dept&quot; = &quot;Sales&quot;;" stage="LIst_Item_Values" /><input type="text" name="Item_ID" narrative=" Item ID based on the Item Field value. " stage="Item_ID" /><input type="text" name="Temp_Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>b1f37d53-9d68-4eb8-934f-b85a05479527</onsuccess></stage><stage stageid="1fd28e39-91a9-46ae-b6d5-d48309f3ef45" name="Build Script" type="Calculation"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><display x="15" y="-15" /><onsuccess>5f1ef1fd-dfaa-48f2-901e-c9b16f931219</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK