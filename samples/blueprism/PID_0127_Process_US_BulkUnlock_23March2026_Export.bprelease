ge stageid="b73a4a3e-e9a4-494c-ae7f-fa67ec14bbde" name="Error_Message" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf163775-a12f-40cc-badd-6a883a49057c" name="Run Report" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fc30670d-ab41-48f7-8bd5-e768c920a6dc" name="P_Exists" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="de0193db-22d6-4a4c-a2ab-cef90f3dd3af" name="Standards" type="Note"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list.(Unique Column to be prefered )

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://abc-sp.xyz.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://abcsp.xyz.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="1288c89d-4813-4dc6-8aed-a4e6043caa21" name="Unexpected exception recover" type="Recover"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="450" y="-120" /><onsuccess>1537bde4-5e43-4ba6-9037-99127d8f8f05</onsuccess></stage><stage stageid="ccd4c31d-1da2-4d87-907e-b1b6e71ffcef" name="Unexpected Exception" type="Exception"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="a947ca06-1a3b-4e33-99b6-ba3ad5fef59a" name="Script_Location" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5a7585b-f735-4b27-a54c-25c4e2315905" name="Find_Item_By" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1537bde4-5e43-4ba6-9037-99127d8f8f05" name="Delete_Script" type="Action"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="450" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ccd4c31d-1da2-4d87-907e-b1b6e71ffcef</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="7bfd9519-ec7f-4181-acab-13784db53470" name="Validate Temp Script Path" type="SubSheet"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>7343a28c-d740-4eb8-8926-322361019db0</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="db5183d6-12d6-4263-84f6-f5eba72197da" name="Error Message?" type="Decision"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="90" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot;" /><ontrue>13d624a7-dff0-4a64-881d-9f2a467cf5d1</ontrue><onfalse>a1f2fd65-7463-46e1-9016-8dcbcd552250</onfalse></stage><stage stageid="13d624a7-dff0-4a64-881d-9f2a467cf5d1" name="Received exception after running the script" type="Exception"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="210" y="90" /><exception type="Business Exception" detail="[Error_Message]" /></stage><stage stageid="33022883-e977-492c-9731-5be1384a2949" name="Page Size" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-150" y="-15" /><datatype>number</datatype><initialvalue>5000</initialvalue><private /><alwaysinit /></stage><stage stageid="30cbfd22-c09a-4e11-a8a1-7887b8f745f3" name="Item_to_be_Retrieved" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-120" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9312df8-a466-48dc-b57a-1f7165e76709" name="Metadata_to_set" type="Data"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="-105" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="00c8ac55-1dc4-46f3-a9ce-4f7993412d2b" name="Set Lable to existing item" type="SubSheetInfo"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>Searched particular list item and updates the lable for the item</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f9d61bad-d8ba-414e-88c3-0b438849dad7" name="Start" type="Start"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name/Value of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="number" name="Page Size" narrative="(Optional)Specify the page size (Default: 5000)" stage="Page Size" /><input type="text" name="Label" narrative="Specify the metadata to be set" stage="Label" /></inputs><onsuccess>247d0926-c36d-461a-b42d-e2179276766d</onsuccess></stage><stage stageid="6c34e2c7-5d93-4972-9dc7-f2a316cee616" name="End" type="End"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Message" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="bc7d92ec-6ba8-48e8-8c31-6842ec7c1b78" name="Build Script" type="Calculation"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-105" /><onsuccess>98bc710a-65cc-4e99-a390-ae49a7b760a7</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;  NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize &quot;&amp;[Page Size]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot; Set-PnPListItem -List &quot;&amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp;&quot; -Identity $item -Label &quot;&amp;Chr(34)&amp;[Label]&amp;Chr(34)&amp;NewLine()&amp;&quot;Exit &quot; &amp; NewLine()&amp;&#xA; &quot;}&quot; &amp; NewLine() &amp; &#xA;&quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &#xA;&quot;Catch {&quot; &amp; NewLine() &amp;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="1047c814-d86a-4664-871b-38e42f0f2ec7" name="Run PnP_Script" type="SubSheet"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>013bbafc-a640-45ee-a229-56e71631348c</onsuccess><processid>7c20ffe9-31ed-4311