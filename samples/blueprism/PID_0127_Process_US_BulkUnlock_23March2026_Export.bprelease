Make Sure that Config file should contain the headers "AssetName" and "Value"</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1be68ce5-baf3-4f81-a70c-cbae4436f698" name="Start" type="Start"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="120" y="-75" /><inputs><input type="text" name="ConfigFileFullPath" narrative="Specify full path of the Config file" stage="ConfigFileFullPath" /><input type="text" name="ConfigFileSheetName" narrative="Specify sheet name of the Config file" stage="ConfigFileSheetName" /></inputs><onsuccess>b2a7e070-3e8b-4b84-9800-a3bfc72bf872</onsuccess></stage><stage stageid="da529383-35e2-4c8f-b666-142567b94545" name="End" type="End"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="60" y="210" /><outputs><output type="collection" name="ConfigFileData" narrative="Returns Config file as Collection (It will return Single row collection. i.e. Each AssetName as Header and Corresponding values as Row)" stage="ConfigFileData" /></outputs></stage><stage stageid="d7ec86d5-cf2a-4beb-8875-186b352c3e5e" name="Read Excel As Collection" type="SubSheet"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="330" y="-135" /><inputs><input type="text" name="fileName" narrative="Specify the Excel file name to read data" expr="[ConfigFileFullPath]" /><input type="text" name="sheetName" narrative="Specify the Excel sheet name to read data" expr="[ConfigFileSheetName]" /></inputs><outputs><output type="collection" name="DataCollection" narrative="Returns Excel data as Collection" stage="DataCollection" /></outputs><onsuccess>69562218-4b7c-44e8-a443-efa4ccc3fc9b</onsuccess><processid>eeeb6765-9d9f-4374-b7cd-d5ca8f3dfa61</processid></stage><stage stageid="f6ef9dae-0db2-48f9-992b-0e8f07f9d507" name="DataCollection" type="Collection"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><display x="-105" y="120" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="b0629fd9-4d21-4bd0-b03f-69ebe92bc8f4" name="Loop Coll Start" type="LoopStart"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="-75" /><onsuccess>131e56e4-a88d-41e8-8645-454ee2221ca1</onsuccess><groupid>cd63f3a9-f8fe-4b01-93e1-1a2430666292</groupid><looptype>ForEach</looptype><loopdata>DataCollection</loopdata></stage><stage stageid="916243a8-c885-42d5-8882-5b9aafb1c962" name="Loop Coll End" type="LoopEnd"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="225" /><onsuccess>7228abae-0668-4fbc-8304-2337a90e4a46</onsuccess><groupid>cd63f3a9-f8fe-4b01-93e1-1a2430666292</groupid></stage><stage stageid="69562218-4b7c-44e8-a443-efa4ccc3fc9b" name="Append {" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="-135" /><onsuccess>b0629fd9-4d21-4bd0-b03f-69ebe92bc8f4</onsuccess><calculation expression="&quot;{&quot;" stage="JSON String" /></stage><stage stageid="ce3c8945-75bc-4316-a27c-4f90cf7839ec" name="JSON String" type="Data"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="-180" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="131e56e4-a88d-41e8-8645-454ee2221ca1" name="Append AssetName to JSON String" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="-30" /><onsuccess>63dcd0ad-c394-4dfc-8111-f9c1e1c0cb2a</onsuccess><calculation expression="[JSON String] &amp; Chr(34) &amp; [DataCollection.AssetName] &amp; Chr(34)" stage="JSON String" /></stage><stage stageid="63dcd0ad-c394-4dfc-8111-f9c1e1c0cb2a" name="Append :" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="15" /><onsuccess>ea0aba9f-f289-4496-b0bb-4858acbca978</onsuccess><calculation expression="[JSON String] &amp; &quot;:&quot;" stage="JSON String" /></stage><stage stageid="b1ee4fba-f76d-4d06-a207-b28527877c52" name="Append AssetValue to JSON String" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="105" /><onsuccess>7bb08865-d955-4e9a-a07a-96c32b9ceb27</onsuccess><calculation expression="[JSON String] &amp; Chr(34) &amp; [EscapeString] &amp; Chr(34)" stage="JSON String" /></stage><stage stageid="7bb08865-d955-4e9a-a07a-96c32b9ceb27" name="Append ," type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="150" /><onsuccess>916243a8-c885-42d5-8882-5b9aafb1c962</onsuccess><calculation expression="[JSON String] &amp; &quot;,&quot;" stage="JSON String" /></stage><stage stageid="a5e2e0ce-7923-4513-9db6-bbea52a8a6a9" name="Append }" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="255" y="225" /><onsuccess>0213ca62-0f39-49d8-ae77-3faf00a0ac0d</onsuccess><calculation expression="[JSON String] &amp; &quot;}&quot;" stage="JSON String" /></stage><stage stageid="7228abae-0668-4fbc-8304-2337a90e4a46" name="Remove Last Comma" type="Calculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="345" y="225" /><onsuccess>a5e2e0ce-7923-4513-9db6-bbea52a8a6a9</onsuccess><calculation expression="Mid([JSON String] , 1, Len([JSON String] ) - 1)" stage="JSON String" /></stage><stage stageid="757b3c9b-ce2a-463f-8428-b53c08a48cb1" name="EscapeString" type="Data"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="-180" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea0aba9f-f289-4496-b0bb-4858acbca978" name="Replace Special Character" type="MultipleCalculation"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="420" y="60" /><onsuccess>b1ee4fba-f76d-4d06-a207-b28527877c52</onsuccess><steps><calculation expression="Replace([DataCollection.Value] , &quot;\&quot;, &quot;\\&quot;)" stage="EscapeString" /><calculation expression="Replace([EscapeString] , Chr(34), &quot;\&quot; &amp; Chr(34))" stage="EscapeString" /></steps></stage><stage stageid="0213ca62-0f39-49d8-ae77-3faf00a0ac0d" name="Json To Collection" type="Action"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="255" y="150" /><inputs><input type="text" name="json" expr="[JSON String]" /></inputs><outputs><output type="collection" name="Result" stage="ConfigFileData" /></outputs><onsuccess>1313a59f-ff82-4d2d-9fee-d4fdc2ebfcb3</onsuccess><breakpoint type="0"><condition></condition></breakpoint><resource object="Utility - JSON" action="JSON to Collection" /></stage><stage stageid="7a1547a2-3898-4845-a695-868629d64447" name="ConfigFileFullPath" type="Data"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><display x="-180" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6927c198-0b76-4460-9320-99df05eba5c7" name="ConfigFileSheetName" type="Data"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><display x="-105" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f72a6fe9-ff07-47e3-b494-529ba8b28538" name="Input Parameter" type="Block"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="-240" y="-45" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1047d64c-2132-4e9a-8ec5-4aedff9f4abc" name="DataItems" type="Block"><subsheetid>0ae53d56-2e70-4be0-9845-859a958ea4f4</subsheetid><loginhibit /><display x="-240" y="90" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="00FFFF" /></stage><stage stageid="6dbc4ce1-dd1f-45ec-8420-d8f24488f908" name="Output Parameter" type="Block"><subshee