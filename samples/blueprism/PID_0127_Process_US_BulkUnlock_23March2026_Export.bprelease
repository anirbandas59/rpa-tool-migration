Considering the file from "C:\Apps\Test.xlsx" to be uploaded to "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data)</narrative><display x="-450" y="-90" w="300" h="240" /></stage><stage stageid="0c76f22e-5dcc-4135-9709-fbd13384e4ad" name="Script Path" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-330" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8c83a6e8-2251-469b-9922-d4cba00e641c" name="Delete_Script" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="360" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>d1a4f59e-b859-4a3a-9fc9-3d40ca2532d4</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="412fd076-4280-427b-8cbb-f1e747efa29c" name="Generate_PnPScript" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>56e87b71-1782-4b52-b47d-c35895f7a9b2</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="01c6b367-09c5-4172-b793-115eabbda837" name="Input" type="Block"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-495" y=