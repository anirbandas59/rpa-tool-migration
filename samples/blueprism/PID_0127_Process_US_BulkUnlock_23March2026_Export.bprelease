53aeee79d</subsheetid><narrative>Remove List Item from SharePoint List based on Item ID.
MinAccess:- Add_Edit(With Delete)
On success "Line Item Removed Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="51292125-bd54-4256-b3c2-c007e2f90c16" name="Start" type="Start"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><preconditions><condition narrative="Item ID required for Identifying the List_Item. Use &quot;Get_ListItem_ID&quot; action to get Item ID." /></preconditions><display x="15" y="-165" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Target_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Item_ID" narrative="Item ID based on the Item Field value." stage="Item_ID" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>8c94b742-ce3d-47e8-8c8b-74cd1dab915a</onsuccess></stage><stage stageid="4b6a2ed7-d7f4-4390-9943-03b40b5aba15" name="Build Script" type="Calculation"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="-15" /><onsuccess>97c56b7a-eb1b-49bd-9ea0-3b6096aa030b</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;$List_Item=Remove-PnPListItem -List &quot; &amp;[SP_Target_List] &amp; &quot; -Identity &quot; &amp; [Item_ID] &amp; &quot; -Force -ErrorAction Stop&quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Line Item Removed Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="9c19af4b-af19-4bb3-bf22-de694f40217d" name="Run PnP_Script" type="SubSheet"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>69156824-abe1-4f16-a622-711d52d99198</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="f846d1a9-520e-4f1f-b2f6-a787b3ea2418" name="Delete_Script" type="Action"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>77549428-e6a4-4735-9ef6-59db46b5b98b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="97c56b7a-eb1b-49bd-9ea0-3b6096aa030b" name="Generate_PnPScript" type="SubSheet"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the sc