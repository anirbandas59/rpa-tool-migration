ext" name="Success Message" narrative="Success message if any" stage="Run Report" /><output type="text" name="ErrorMessage" narrative="Contains errors captured in powershell" stage="txt_ErrorMessage" /></outputs></stage><stage stageid="fd865a83-b2ea-4237-a582-2f8fd298ad3b" name="Build script" type="Calculation"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><loginhibit /><narrative>"$WarningPreference ="&amp;Chr(34)&amp;"SilentlyContinue"&amp;Chr(34)&amp;""&amp;NewLine()&amp;"</narrative><display x="15" y="-135" /><onsuccess>cc7fc901-3a49-4172-8235-71222455acec</onsuccess><calculation expression="&quot;$WarningPreference =&quot;&amp;Chr(34)&amp;&quot;SilentlyContinue&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [txt_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$item = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [txt_ListName] &amp; Chr(34) &amp;  &quot;-Id &quot; &amp; [num_ItemID] &amp; NewLine() &amp;  &quot;$filePath =&quot; &amp; Chr(34) &amp; [txt_Path] &amp; Chr(34) &amp; NewLine() &amp; &quot;$fileName = Split-Path $filePath -Leaf&quot; &amp; NewLine() &amp; &quot;$ctx = Get-PnPContext&quot; &amp; NewLine() &amp; &quot;$fileStream = New-Object IO.FileStream($filePath,[System.IO.FileMode]::Open)&quot; &amp; NewLine() &amp; &quot;$attachInfo = New-Object -TypeName Microsoft.SharePoint.Client.AttachmentCreationInformation&quot; &amp; NewLine() &amp; &quot;$attachInfo.FileName = $fileName&quot; &amp; NewLine() &amp; &quot;$attachInfo.ContentStream = $fileStream&quot; &amp; NewLine() &amp; &quot;$attFile = $item.attachmentFiles.add($attachInfo)&quot; &amp; NewLine() &amp; &quot;$ctx.load($attFile)&quot; &amp; NewLine() &amp; &quot;$ctx.ExecuteQuery()&quot;" stage="txt_PnPScript" /></stage><stage stageid="fb91b668-a3fc-43a3-9a2e-6c976b800064" name="txt_PnPScript" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-360" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="09d319db-c417-42e6-b24c-af0725113fbe" name="txt_URL" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-270" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="868ce292-de61-4be2-a5fd-b1fe900942ab" name="txt_ListName" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-330" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3bbaa503-b84c-423b-986d-a197ab8adc2c" name="num_ItemID" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-390" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0f0f987-f40b-4bf1-ac80-558bd385ac1c" name="txt_Path" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-270" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cfb0ee4-582c-4e00-9ef3-4715a26aa95a" name="txt_FolderPath" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-450" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="45c4ff74-76e4-4b5b-97b9-58e944a45120" name="txt_ErrorMessage" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-345" y="165" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d9c0dbf0-038d-490b-947d-e3a95a344ea2" name="txt_ScriptPath" type="Data"><subsheetid>3361fc47-d097-464e-b7d0-e5d0e6c70c8d</subsheetid><display x="-345" y="135" w="180" h="30" /><datatype>