 stageid="421b3680-70d4-4383-8036-c0b8a73c4863" name="Build_Script_calc" type="MultipleCalculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-135" w="90" h="30" /><onsuccess>e75b7c91-57b0-4fdd-9943-f1c4c7657bdc</onsuccess><steps><calculation expression="[Field_Qry]&amp; &quot;+&quot; &amp; Chr(34) &amp;  &quot;\n&quot; &amp; [Field_Names.Field_Names] &amp; &quot;:XXXXX:&quot; &amp; Chr(34) &amp; &quot;+&quot; &amp;&quot;$items.FieldValues[&quot; &amp; Chr(34) &amp; [Field_Names.Field_Names] &amp; Chr(34) &amp; &quot;]&quot;" stage="Field_Qry" /></steps></stage><stage stageid="891d07a1-85d6-44dd-8ee4-cf4281854a30" name="Field_Qry" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="-135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f11a377e-513a-430c-96d8-f26a9e15d24b" name="Fetch Result from Run Report" type="MultipleCalculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="225" w="90" h="30" /><onsuccess>08a62a6f-e122-4803-b300-f4abf20d2938</onsuccess><steps><calculation expression="Right([Run Report],Len([Run Report]) - InStr([Run Report], &quot;Metadata-&quot;) + 1)" stage="Result" /><calculation expression="Replace([Result], &quot;Metadata- \n&quot;, &quot;&quot;)" stage="Result" /></steps></stage><stage stageid="08a62a6f-e122-4803-b300-f4abf20d2938" name="Split Run Report" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="225" w="90" h="30" /><inputs><input type="text" name="Text to Split" narrative="The text to split" expr="[Result]" /><input type="text" name="Split Char" narrative="The split delimiter" expr="&quot;\n&quot;" /><input type="text" name="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Field&quot;" /></inputs><outputs><output type="collection" name="Split Values" narrative="The resulting collection containing the split values" stage="MetaData" /></outputs><onsuccess>adf92dd1-fad4-4675-8ce2-e08ce6398fd5</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="59a07fdf-6e3f-4ed4-b0eb-ce596969b885" name="Loop MetaData" type="LoopStart"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="270" w="90" h="30" /><onsuccess>9dda607a-c874-4ef5-bdd2-819193a93f82</onsuccess><groupid>05a6a3a3-a85e-47d2-9768-f5a3ef92c22c</groupid><looptype>ForEach</looptype><loopdata>MetaData</loopdata></stage><stage stageid="c0748131-653b-4939-9154-6b55cb186b8f" name="Loop MetaData" type="LoopEnd"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="360" w="90" h="30" /><onsuccess>efda88c5-d830-4e9f-95f4-472a28f4a1b1</onsuccess><groupid>05a6a3a3-a85e-47d2-9768-f5a3ef92c22c</groupid></stage><stage stageid="adf92dd1-fad4-4675-8ce2-e08ce6398fd5" name="Add Field Value to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="270" w="90" h="30" /><inputs><input type="collection" name="Collection" narrative="The collection to append a field to." expr="[MetaData]" /><input type="text" name="Field Name" narrative="The name of the new field." expr="&quot;Value&quot;" /><input type="text" name="Value" narrative="The value to be put in the new field." expr="" /></inputs><outputs><output type="collection" name="Appended Collection" narrative="The collection with field appended." stage="MetaData" /></outputs><onsuccess>59a07fdf-6e3f-4ed4-b0eb-ce596969b885</onsuccess><resource object="Utility - Collection Manipulation" action="Append Field (Text)" /></stage><stage stageid="9dda607a-c874-4ef5-bdd2-819193a93f82" name="Split Each value" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="315" w="90" h="30" /><inputs><input type="text" name="Text to Split" narrative="The text to split" expr="[MetaData.Field]" /><input type="text" name="Split Char" narrative="The split delimiter" expr="&quot;:XXXXX:&quot;" /><input type="text" name="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Value&quot;" /></inputs><outputs><output type="collection" name="Split Values" narrative="The resulting collection containing the split values" stage="Split Values" /></outputs><onsuccess>4378119d-7196-4334-b989-2ec52d0adbfc</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="a240aa2a-240a-47b1-b4a4-029ae973fad5" name="MetaData" type="Collection"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="60" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="51afdbbc-11f5-4596-9d9b-4e0bad6c2fee" name="Split Values" type="Collection"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="4378119d-7196-4334-b989-2ec52d0adbfc" name="Add Field Name to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="315" w="90" h="30" /><inputs><input type="number" name="Row Index" narrative="The row index within the collection to read from. The index is from 0 to N-1 (where N is the total number of rows in the collection)." expr="0" /><input type="collection" name="Collection" narrative="The collection to read." expr="[Split Values]" /><input type="text" name="Field Name" narrative="The field within the collection to read." expr="&quot;Value&quot;" /></inputs><outputs><output type="text" name="Value Read" narrative="The value of the requested field as text." stage="MetaData.Field" /></outputs><onsuccess>2fa9590f-3a67-4db4-945d-140169b8c60c</onsuccess><resource object="Utility - Collection Manipulation" action="Read Collection Field" /></stage><stage stageid="2fa9590f-3a67-4db4-945d-140169b8c60c" name="Add Field Value to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="360" w="90" h="30" /><inputs><input type="number" name="Row Index" narrative="The row index within the collection to read from. The index is from 0 to N-1 (where N is the total number of rows in the collection)." expr="1" /><input type="collection" name="Collection" narrative="The collection to read." expr="[Split Values]" /><input type="text" name="Field Name" narrative="The field within the collection to read." expr="&quot;Value&quot;" /></inputs><outputs><output type="text" name="Value Read" narrative="The value of the requested field as text." stage="MetaData.Value" /></outputs><onsuccess>c0748131-653b-4939-9154-6b55cb186b8f</onsuccess><resource object="Utility - Collection Manipulation" action="Read Collection Field" /></stage><stage stageid="f393cce1-98ae-4bcc-b709-f28903db2029" name="Result" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="95df95dd-49d8-43df-be3f-e5bbcb0da777" name="Remove additional '+'" type="Calculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="-90" w="90" h="30" /><onsuccess>80c37908-143e-4994-9903-abc151ae8a91</onsuccess><calculation expression="Right([Field_Qry], Len([Field_Qry]) - 1)" stage="Field_Qry" /></stage><stage stageid="21003a18-4e56-492e-9840-cd1c1b8344ae" name="Block12" type="Block"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-60" y="-300" w="285" h="675" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="217d7803-bb86-4628-9785-bbbe2fc03dd3" name="Create Power Shell Script" type="Code"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-45" y="75" /><inputs><input type="text" name="Script" expr="[Script]" /><input type="text" name="ScriptName" expr="[Script_Name]" /><input type="text" name="Script Directory" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="MSG" stage="Return Message" /><output type="text" name="ScriptPath" stage="ScriptPath" /></outputs><onsuccess>0f4714ab-8f19-43a2-8032-daed7cf00036</onsuccess><code><![CDATA[String fileName = "";
String Filepath = Script_Directory ;

MSG = "";
ScriptPath = "";
            try
            {
				fileName = ScriptName;
				
				//Check if Dir exist
				if (!System.IO.Directory.Exists(Filepath))

                    {                    
                        System.IO.Directory.CreateDirectory(Filepath);                    
                    } 
				
				
				// Create complete script path 
				Filepath = Filepath + @"\" + fileName + @".ps1";
				//ScriptPath = Filepath;
				 
					
					
                // Check if file already exists. If yes, delete it.     
                if (System.IO.File.Exists(Filepath))
                {
                    
					//System.IO.File.Delete(fileName);
                }

                // Create a new file     
                using (StreamWriter sw = new StreamWriter(File.Open(Filepath, FileMode.Create), Encoding.UTF8))
				{    
				sw.WriteLine(Script);     
				}

                
				ScriptPath = Filepath;
            }
            catch (Exception Ex)
            {
                MSG = Ex.ToString();
            }
			]]></code></stage><stage stageid="e5312272-a193-4074-ad2c-aa4880107717" name="Create New Library Folder" type="SubSheetInfo"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Create New Folder in a library.
MinAccess:- Add_Edit
On success "Folder Created Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="2bbe0469-0faf-44e0-a8a3-a9b6323c5194" name="Start" type="Start"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-210" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target Folder Name Ex:- PNP_Test_Lib/Unittesting" stage="SP_RelLib_Url" /><input type="text" name="New_Folder_Name" narrative="New Folder . Ex:- Test" stage="New_Foldername" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>158e88b6-b686-4969-946c-fb0d3f3ca12a</onsuccess></stage><stage stageid="dccd5738-1f0f-42d1-b35a-c50678078ae2" name="Build Script" type="Calculation"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-15" /><onsuccess>b48cb8ed-a1f8-4715-8542-6402e8a02085</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Add-PnPFolder -Name &quot; &amp;Chr(34) &amp; [New_Foldername]  &amp;Chr(34) &amp;  &quot; -Folder &quot; &amp;Chr(34) &amp;  [SP_RelLib_Url] &amp;Chr(34) &amp;  &quot; -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Folder Created  Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException]  { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="821c9172-5fd0-435a-88b5-2101585bb982" name="Run PnP_Script" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="165" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>0b22aaa2-3703-4ec6-a637-31773192f382</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="934c51e8-3921-442f-a503-5228a8bc3040" name="Delete_Script" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ec7b6214-d923-4732-9329-3cae273ab25a</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="b48cb8ed-a1f8-4715-8542-6402e8a02085" name="Generate_PnPScript" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_Folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>3a81f8ef-e854-4cbe-a077-7b8272cf356c</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="3a81f8ef-e854-4cbe-a077-7b8272cf356c" name="Check_Error" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>2ad22732-0bc7-43aa-8e5e-6dc16f229580</ontrue><onfalse>fe00f795-3298-4bf8-8c4f-756d479082ba</onfalse></stage><stage stageid="2ad22732-0bc7-43aa-8e5e-6dc16f229580" name="Exception while creating  Script" type="Exception"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="20a11f7c-4a74-4f22-a886-e08f2e752c09" name="Check Process_Exist" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="285" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>6c10463b-a8bc-41f6-bf0c-a219c485add7</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="6c10463b-a8bc-41f6-bf0c-a219c485add7" name="ProcessExist?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="330" /><decision expression="[P_Exists]=True" /><ontrue>c68a31c0-3ae4-4ba4-bb70-d633274bc328</ontrue><onfalse>cab351e2-386e-4dbe-92d0-e56c1e355818</onfalse></stage><stage stageid="cab351e2-386e-4dbe-92d0-e56c1e355818" name="Anchor8" type="Anchor"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="90" y="330" w="10" h="10" /><onsuccess>0c6a1db0-12e7-4f5c-bcc8-15abaff9a7d9</onsuccess></stage><stage stageid="c68a31c0-3ae4-4ba4-bb70-d633274bc328" name="Kill Process" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="375" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>934c51e8-3921-442f-a503-5228a8bc3040</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="0c6a1db0-12e7-4f5c-bcc8-15abaff9a7d9" name="Anchor9" type="Anchor"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="90" y="435" w="10" h="10" /><onsuccess>934c51e8-3921-442f-a503-5228a8bc3040</onsuccess></stage><stage stageid="75a48717-2ddb-425d-916e-2ff6a4b8b0ae" name="SP_Site_URL" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fded85c2-ef04-41be-a3d5-01ceb9f2160a" name="SP_RelLib_Url" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-285" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b764642c-0d64-4350-a560-50da9aebafaf" name="Output" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-285" y="225" w="105" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fc4bb500-eb71-4938-b7b2-5ae3f78a9699" name="Script" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c8c261a2-9494-49f6-9cff-b