285" y="45" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c5b57ea2-b8d0-4fc3-8875-b6feed8a0f40" name="Inhouse" type="Block"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="-465" y="45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="77549428-e6a4-4735-9ef6-59db46b5b98b" name="End" type="End"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="450" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Line Item Removed Successfully&#xA;&quot; will be displayed" stage="Run Report" /></outputs></stage><stage stageid="02049e6e-a3b5-4b5c-b41b-1046ef54b1d0" name="User Name" type="Data"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="-390" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07a949dd-fa2c-4d0a-b611-8f126ddfeeab" name="Item_ID" type="Data"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="-180" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5cae9d91-2895-4637-aec6-ebeb7da07ba0" name="Get_ListItem_Id" type="SubSheetInfo"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><narrative>Search Item based on Unique column value and returns ID for the list Item.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="4d747296-7b9d-46d6-bb44-b3561b139e21" name="Start" type="Start"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /></inputs><onsuccess>ad3112b0-563b-4e39-94fd-4051f6538be4</onsuccess></stage><stage stageid="681707d8-413d-4a38-8f87-bf3b81b1a8bc" name="End" type="End"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Item_ID" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="4603185b-5f4c-431d-a726-70596456a251" name="Build Script" type="Calculation"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="-105" /><onsuccess>255a304a-bf84-43c6-9461-67fda8781cee</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34)  &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize 5000&quot; &amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot;Write-Host $item['ID'] &quot; &amp; NewLine() &amp; &quot;Exit &quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &quot;Catch {&quot; &amp; NewLine() &amp; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &#xA;&quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="531b63d0-1e19-4c88-a41d-fe4edad48ae4" name="Run PnP_Script" type="SubSheet"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>052b1a8c-6428-4f29-97dc-d1e75321e89e</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="22dec3df-5bf1-4979-a4e7-0eef61ea98d8" name="Delete_Script" type="Action"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>681707d8-413d-4a38-8f87-bf3b81b1a8bc</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="255a304a-bf84-43c6-9461-67fda8781cee" name="Generate_PnPScript" type="SubSheet"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_ListItem_ID&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>e21beb10-05e5-4142-a2f4-f997cf813fe0</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="e21beb10-05e5-4142-a2f4-f997cf813fe0" name="Check_Error" type="Decision"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="-15" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>71f67248-28dc-4f33-a21f-9820464ca04d</ontrue><onfalse>531b63d0-1e19-4c88-a41d-fe4edad48ae4</onfalse></stage><stage stageid="71f67248-28dc-4f33-a21f-9820464ca04d" name="Exception while creating  Script" type="Exception"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="210" y="-15" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="aec14145-cae1-4928-9951-442d216db43e" name="Check Process_Exist" type="Action"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>0bbf4e92-1a89-40bf-b450-b77dcae3485c</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="0bbf4e92-1a89-40bf-b450-b77dcae3485c" name="ProcessExist?" type="Decision"><subsheetid>888484f6-9b86-43ed-9632-75893b16f1d8</subsheetid><display x="15" y="195" /><decision expression="[P_Exists]=True" /><ontrue>77bcc3dc-96df-4522-8bc8-5bb8aa280f04</ontrue><onfalse>8012159f-a1e1-4b26-acf9-2890ce6959cf</onfalse></stage><stage stageid="8012159f-a1e1-4b26-ac