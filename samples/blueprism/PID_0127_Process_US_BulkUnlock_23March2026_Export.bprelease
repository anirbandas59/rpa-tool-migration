le="Regular" color="7FB2E5" /></stage><stage stageid="d642909a-71f6-4c85-8ec2-166a4c27151c" name="Inhouse" type="Block"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="-465" y="-30" w="120" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c27f4665-b005-46c2-96f6-527d3337570e" name="End" type="End"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="465" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Line Items Removed Successfully&#xA;&quot; will be displayed" stage="Run Report" /></outputs></stage><stage stageid="6d0fe66f-2faa-40d5-9930-b1fafaa4b615" name="User Name" type="Data"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="-405" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eb61bd47-0dc8-4a20-92d4-bcbb895eff2a" name="Page_Size" type="Data"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="-240" y="0" w="90" h="30" /><datatype>number</datatype><initialvalue>500</initialvalue><private /><alwaysinit /></stage><stage stageid="7db66eac-5d0e-4cc6-a008-7d2f9c3b842a" name="List_Name" type="Data"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="-150" y="0" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c2135f5-f1c2-4f41-9183-d56a80d57546" name="Add List Items from CSV " type="SubSheetInfo"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><narrative>Add multiple row items to SharePoint list from CSV.
Place the entire table of data that is to be uploaded to the SharePoint list in a CSV file and pass the CSV path as input parameter (CSV_File_Path).
SP_URL: Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234
List Name: Provide the target list Name Ex:- PNP_Test_List
Column_name_values:Input header mapping from SharePoint to CSV.Chr(34)&amp;[Column Name in SP list]&amp;Chr(34)&amp;"=$Record.'Column Name in CSV';". More Info given in the note.
Temp_Script_Loc:(Optional)Temp script store location: ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)
CSV_File_Path:Mandate:Input CSV file path
Logs_CSV_FilePath:Mandate: Gives status of each list items. (Successful/ Exception)</narrative><display x="-315" y="-45" w="360" h="150" /></stage><stage stageid="175f509c-354d-48fc-b8f4-8d90add3c74a" name="Start" type="Start"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="-195" /><inputs><input type="text" name="SP_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234" stage="SP_Site_URL" /><input type="text" name="List Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Column_name_values" narrative="Input header mapping from SharePoint to CSV.Chr(34)&amp;[Column Name in SP list]&amp;Chr(34)&amp;&quot;=$Record.'Column Name in CSV';&quot;. More Info given in the note." stage="LIst_Item_Values" /><input type="text" name="Temp_Script_Loc" narrative="(Optional)Temp script store location ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="CSV_File_Path" narrative="Mandate:Input CSV file path" stage="CSV_File_Path" /><input type="text" name="Logs_CSV_FilePath" narrative="Mandate: Gives status of each list items. (Successful/ Exception)" stage="Logs_CSV_FilePath" /></inputs><onsuccess>9e99c118-9bc7-4707-899f-16b8df46c1ad</onsuccess></stage><stage stageid="1b3c07cd-7f6d-4798-90f5-dba198f6a6e4" name="Run PnP_Script" type="SubSheet"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="120" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>bbae97bd-a951-4517-a77f-038ad0d2d3aa</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="b3a0e155-f647-456e-bea1-23bf5088f0c4" name="Delete_Script" type="Action"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="345" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>65082087-ea11-4f91-ac7c-24037ac19b51</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="f2d9974b-0023-4883-b6ee-a6000318a7e0" name="Generate_PnPScript" type="SubSheet"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Add_List_Items&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>331de9ca-0eea-4f79-bfda-ad3378e74c9f</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="331de9ca-0eea-4f79-bfda-ad3378e74c9f" name="Check_Error" type="Decision"><subsheetid>8212f97a-daca-477b-bb6e-286e1ac31ed7</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>3fefe642-5a70-4f72-a00e-63e4a87f6501</ontrue><onfalse>1b3c07cd-7f6d-4798-90f5-dba198f6a6e4</onfalse></stage><stage stageid="3fefe642-5a70-4f72-a00e-63e4a87f6501" name="Exception while creating  Script" type="Exception">