ce object="Utility - General" action="Sleep" /></stage><stage stageid="8302aa7f-1513-47e7-8b04-8ba429e84055" name="IncrementCounter" type="Calculation"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-45" y="120" /><onsuccess>f3cdccff-fd8b-4a4d-9c96-20a0a2723c4b</onsuccess><calculation expression="[Counter] + 1" stage="Counter" /></stage><stage stageid="f3cdccff-fd8b-4a4d-9c96-20a0a2723c4b" name="Counter &gt; MaxAttempt" type="Decision"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-135" y="120" /><decision expression="[Counter] &gt; [MaxAttempt]" /><ontrue>69f7e46d-bbcc-42db-ad7b-29da5f4923f4</ontrue><onfalse>216fe34d-a7a4-4b5f-ab04-4ae70de3ae74</onfalse></stage><stage stageid="69f7e46d-bbcc-42db-ad7b-29da5f4923f4" name="Count&gt;Max Exception" type="Exception"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-255" y="120" /><breakpoint type="0"><condition></condition></breakpoint><exception type="System Exception" detail="&quot;Unable to Get the Files from SharePoint After Maximum Attempts&quot;" /></stage><stage stageid="95814ee7-a5b5-4829-8e73-af5d65d4d84b" name="Counter" type="Data"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-405" y="45" w="90" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="a7b8feec-9485-46ee-beae-fdaf35d7249e" name="MaxAttempt" type="Data"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-420" y="120" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0d86d7bb-9976-4787-8236-deaec569afe7" name="Split Values" type="Collection"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-375" y="195" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Value" type="text" /></collectioninfo></stage><stage stageid="c1cd084a-ee29-4263-84fa-8fa95b90dc86" name="ListLength" type="Data"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="-300" y="180" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ecdc5b49-5669-459d-86c2-7ba6cd347e77" name="Str &lt;&gt; Blank" type="Decision"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="45" y="120" /><decision expression="[Txt_FromRPATxtBox]&lt;&gt;&quot;&quot;" /><ontrue>8af72a79-f380-4e0b-b8cc-f201a6e6a0b0</ontrue><onfalse>8302aa7f-1513-47e7-8b04-8ba429e84055</onfalse></stage><stage stageid="25269d4b-602c-4b2f-92ee-bf2d6daedfe0" name="Sleep" type="Action"><subsheetid>13855d55-15e8-4f4d-9655-9face0a3192a</subsheetid><display x="45" y="-90" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /><inputs><input type="number" name="Sleep Time (Seconds)" narrative="The time (in seconds) for which to sleep" expr="1" /></inputs><onsuccess>81c0fcde-4951-4148-9c46-ec91c5dba38f</onsuccess><resource object="Utility - General" action="Sleep" /></stage><stage stageid="617d5893-eefb-43df-9004-a7c3ef8b667a" name="Anchor1" type="Anchor"><display x="750" y="585" w="10" h="10" /><onsuccess>fc6c0061-e9c1-4bbf-9d4c-48b65f9ef24a</onsuccess></stage><stage stageid="2f2c0f2a-690c-4c11-b64f-aa1b72191673" name="Anchor3" type="Anchor"><display x="750" y="675" w="10" h="10" /><onsuccess>617d5893-eefb-43df-9004-a7c3ef8b667a</onsuccess></stage><stage stageid="aaaeec8c-a2df-4b32-8c23-ceb0a8f008b1" name="Replace" type="MultipleCalculation"><display x="210" y="300" w="90" h="30" /><onsuccess>5a8fa841-258f-4b47-a8c0-f39d190bf1e3</onsuccess><steps><calculation expression="Replace(    [PowerShellGetAllFile_Template],  &quot;_RPA_SourceName_RPA_&quot; , [Item Data.BaseFolderURL])" stage="PowerShellGetAllFile" /><calculation expression="Replace(  [PowerShellGetAllFile] , &quot;_RPA_baseURL_RPA_&quot; , [Item Data.BaseConnection])" stage="PowerShellGetAllFile" /><calculation expression="Replace(  [PowerShellGetAllFile] ,  &quot;_RPA_outputfile_RPA_&quot; , &quot;C:\Users\&quot; &amp; [userName] &amp; &quot;\Documents\Result.txt&quot; )" stage="PowerShellGetAllFile" /></steps></stage><stage stageid="a563bd00-a9d0-40a8-b061-6323b4979a90" name="GetAllFiles_JS Template" type="Data"><display x="-570" y="705" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">//Add Text Area
var childElement = document.getElementById('RPAtextBox');
if(childElement){
	childElement.parentNode.removeChild(childElement);
}
var body = document.getElementsByTagName('Body')[0];
var textArea = document.createElement('div');
//textArea.setAttribute('type', 'text');
//textArea.setAttribute('value', '');
textArea.setAttribute('id', 'RPAtextBox');
textArea.setAttribute('style', 'width:200px');
body.appendChild(textArea);

var DELIMITER = "__RPA__"
var arrOfId = {};
var siteUrl =  "_RPA_siteUrl_RPA_" ;
var title =  "_RPA_title_RPA_" ;
var listURL = "_RPA_listURL_RPA_" ;
var siteFullURL = "_RPA_siteFullURL_RPA_" ;
var fileDetails = "File ID" + DELIMITER + "File Name" + DELIMITER+ "Relative Path" + "\n";

</initialvalue><private /><alwaysinit /></stage><stage stageid="5d22c97d-96b9-4ec7-9d84-866379d2fa76" name="Parent_Q" type="Collection"><subsheetid>22f0d39b-1a59-430e-bf16-5b227cd1c8aa</subsheetid><display x="-375" y="-45" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Sno" type="text" /><field name="URL" type="text" /><field name="BaseConnection" type="text" /><field name="BaseFolderURL" type="text" /><field name="SiteURL" type="text" /><field name="ListTitle" type="text" /></collectioninfo></stage><stage stageid="bc5de3ac-b489-4554-828b-4be9b0e515f6" name="Populate Queue - Child" type="SubSheet"><display x="210" y="585" w="90" h="30" /><inputs><input type="collection" name="QueCollection" narrative="QueCollection" expr="[Item Data]" /></inputs><outputs><output type="flag" name="ProcessStatus" stage="ProcessStatus" /><output type="text" name="ReturnMsg" stage="ReturnMsg" /></outputs><onsuccess>0c56bb03-9ce8-4b24-92f5-888f25481e2f</onsuccess><processid>22f0d39b-1a59-430e-bf16-5b227cd1c8aa</processid></stage><stage stageid="cfa01acc-464b-4876-b8a1-29d9050d999b" name="Get Child Item" type="Action"><narrative>This action gets the next item to be worked from the queue, returning its details and locking it so no other case can work it.

Items with higher priorities (lower numerical value) are processed first. Where the priority is the same, the next item is the one that has been in the queue the longest,  is not already locked, and is not already completed.

The Item ID returned is used to make further calls to update the work status for that item. It may be empty, in which case there are no items available. This can mean either a) the queue is empty, or b) the queue is not running. This mechanism can be used to cleanly stop all processes working a particular queue at the end of the next case. Items that have a 'deferred' time set will not be returned unless that time has been reached.</narrative><display x="210" y="825" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Queue Name" narrative="The name of the queue" expr="[ChildQName]" /><input type="text" name="Key Filter" narrative="Optionally, a key value to filter by. Only items with this key value will be considered." expr="" /><input type="text" name="Tag Filter" narrative="Optionally, a tag mask to filter by. This can consist of any number of tag searches - each term can be separated by a semi-colon and they are all applied to the search (ie. they are AND'ed terms not OR'ed terms). For example, &quot;Account: Joint; -Balance: Overdrawn; Card: *Visa*&quot; will include any items which match all the terms, ie. every item must have an 'Account: Joint' tag applied, no item can have a 'Balance: Overdrawn' tag applied, every item must have a tag applied which starts with 'Card: ' and then contains the text 'Visa'." expr="[Item Data.Sno]" /></inputs><outputs><output type="text" name="Item ID" narrative="The ID of the item retrieved - empty if there are none available." stage="Child Item ID" /><output type="collection" name="Data" narrative="The data associated with the item - a single collection row." stage="Child Item Data" /><output type="text" name="Status" narrative="The status of the item." stage="Child Item Status" /><output type="number" name="Attempts" narrative="The number of attempts already made to work this item." stage="Child Item Attempts" /></outputs><onsuccess>cb0de144-8c9e-439d-9d59-727f5cd4c4e8</onsuccess><breakpoint type="0"><condition></condition></breakpoint><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Next Item" /></stage><stage stageid="cb0de144-8c9e-439d-9d59-727f5cd4c4e8" name="Got Child Item?" type="Decision"><display x="210" y="885" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><breakpoint type="0"><condition></condition></breakpoint><decision expression="[Child Item ID]&lt;&gt;&quot;&quot;" /><ontrue>411139ac-02f0-445f-b232-0c259ddcac68</ontrue><onfalse>db6e274f-1c81-47fd-8008-c1505b6e41d1</onfalse></stage><stage stageid="eb3e332c-7038-4128-8624-a1f6d7d5c73c" name="Mark Item As Exception" type="SubSheet"><display x="1245" y="480" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" expr="[Item ID]" /><input type="text" name="Child ID" expr="&quot;&quot;" /><input type="flag" name="isParent" expr="True" /><input type="text" name="Completed without outcome msgs" friendlyname="Completed without outcome msgs" expr="&quot;&quot;" /></inputs><onsuccess>28ddba42-2190-4bd3-9a20-ab3ede61b3bb</onsuccess><processid>d599353b-a78b-40f4-ab04-255791b86a1a</processid></stage><stage stageid="a04432c6-6136-46ad-a3d9-9b5cb82242cd" name="Mark Item As Completed" type="SubSheet"><display x="435" y="1185" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" expr="[Child Item ID]" /></inputs><onsuccess>3b322dda-c6e4-4f43-9bc0-8097fd93b50c</onsuccess><processid>d31d1c11-61ad-4c49-91a4-44bbf0bf0725</processid></stage><stage stageid="4904cd47-8a27-43be-bcb7-84d134fc241a" name="Call Unlock" type="Data"><display x="-555" y="1035" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">document.getElementById('RPAtextBox').innerText = "";
createListItem(siteFullURL,'{"listUrl":"'+ siteUrl +"/"+ listURL + '","itemId":"' + "_RPA_key_RPA_" + '"}' ,"_RPA_key_RPA_", "_RPA_FileName_RPA_","_RPA_RelativeURL_RPA_");</initialvalue><private /><alwaysinit /></stage><stage stageid="b76a33d5-b2c7-428c-b898-43cdcd8e8d8f" name="Temp Call Unlock" type="Data"><display x="-375" y="990" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">document.getElementById('RPAtextBox').innerText = "";
createListItem(siteFullURL,'{"listUrl":"'+ siteUrl +"/"+ listURL + '","itemId":"' + "_RPA_key_RPA_" + '"}' ,"_RPA_key_RPA_", "_RPA_FileName_RPA_","_RPA_RelativeURL_RPA_");</initialvalue><private /><alwaysinit /></stage><stage stageid="7d1b2d94-6bab-44d1-99b2-11e4025e3349" name="CheckunlockCompleted" type="SubSheet"><display x="120" y="1095" /><inputs><input type="number" name="MaxAttempt" narrative="Max Attempt" expr="[MaxAttempt]" /></inputs><outputs><output type="text" name="Txt_FromRPATxtBox" stage="Txt_FromRPATxtBox" /></outputs><onsuccess>5dd7823c-cc20-4a56-bd67-a2ad40d89669</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>13855d55-15e8-4f4d-9655-9face0a3192a</processid></stage><stage stageid="86d3338d-1d7f-4812-8799-dddd9f791061" name="GenerateReport" type="SubSheet"><display x="885" y="975" w="90" h="30" /><inputs><input type="text" name="Request Key" narrative="The request key for which the task report is sent to user in email." expr="[Item Data.Sno]" /></inputs><outputs><output type="text" name="TempPath" stage="TempPath" /></outputs><onsuccess>c5db1b2d-14d2-49eb-97d4-9d325839be6b</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>e6ae488c-dde5-47ac-a3cc-59954ff7af4b</processid></stage><stage stageid="51224c9a-6afd-432b-b76f-0eb539eb3bcb" name="Upload Result File" type="SubSheet"><display x="885" y="885" w="90" h="30" /><inputs><input type="text" name="SharePoint Folder path" expr="[SharePointURIFolder]" /><input type="text" name="FilePath" expr="[TempPath]" /><input type="text" name="Sp_URL" expr="[SharePointURI]" /></inputs><onsuccess>aa9bcd64-5e6c-4a27-962b-1c9c246a6caa</onsuccess><processid>d64a5c4d-aa8a-4bbf-afdd-577c303c37fb</processid></stage><stage stageid="1d002d4f-7111-403e-a20f-c8234e796bd0" name="Mark Item As Completed" type="SubSheet"><display x="1155" y="915" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" expr="[Item ID]" /></inputs><onsuccess>6d5d6b99-5f71-4ff0-aa1a-2a838b4a9f91</onsuccess><processid>d31d1c11-61ad-4c49-91a4-44bbf0bf0725</processid></stage><stage stageid="aa9bcd64-5e6c-4a27-962b-1c9c246a6caa" name="Update Status" type="Action"><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="885" y="840" w="90" h="30" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;Completed&quot;" /></inputs><onsuccess>1972aa83-90d4-4553-913e-17e1da1a3311</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="a5a2d9bb-d626-4b9b-90dc-c759e5074e8b" name="Block10" type="Block"><display x="795" y="810" w="270" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0422da2a-d695-4740-9587-6cb65323c93c" name="Recover6" type="Recover"><display x="1005" y="975" /><onsuccess>ecf82708-ecf2-4de1-a53c-bb562f5478f0</onsuccess></stage><stage stageid="28f5a496-5133-4a40-8be9-5d5f179baa23" name="Resume5" type="Resume"><display x="1125" y="1035" /><onsuccess>fa110ffb-7692-4a9a-b811-c042c3da1ddf</onsuccess></stage><stage stageid="49fbf69e-57a3-48b2-a995-ef0311482f47" name="Mark Item As Exception" type="SubSheet"><display x="1290" y="900" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" expr="[Item ID]" /><input type="text" name="Child ID" expr="&quot;&quot;" /><input type="flag" name="isParent" expr="True" /><input type="text" name="Completed without outcome msgs" friendlyname="Completed without outcome msgs" expr="&quot;&quot;" /></inputs><onsuccess>6d5d6b99-5f71-4ff0-aa1a-2a838b4a9f91</onsuccess><processid>d599353b-a78b-40f4-ab04-255791b86a1a</processid></stage><stage stageid="fa110ffb-7692-4a9a-b811-c042c3da1ddf" name="Kill Excel" type="Action"><display x="1290" y="1035" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="&quot;Excel&quot;" /></inputs><onsuccess>49fbf69e-57a3-48b2-a995-ef0311482f47</onsuccess><resource object="Utility_Object_Generic_KillProcess" action="Kill Process" /></stage><stage stageid="c5db1b2d-14d2-49eb-97d4-9d325839be6b" name="FormatReport" type="Action"><display x="885" y="930" w="120" h="30" /><inputs><input type="text" name="Filename" narrative="File name with path" expr="[TempPath]" /><input type="text" name="Sheetname" narrative="Sheet name" expr="[Item Data.Sno]" /></inputs><onsuccess>51224c9a-6afd-432b-b76f-0eb539eb3bcb</onsuccess><resource object="Utility_Object_Format_Queue_Report" action="Format Excel(Standard)" /></stage><stage stageid="210d2449-3725-43e7-96fd-6fc7ce2bde2a" name="Is Connected" type="Action"><display x="465" y="885" w="90" h="30" /><outputs><output type="flag" name="Attached" stage="Attached" /></outputs><onsuccess>09f00544-61d2-4c62-934c-979127b977c3</onsuccess><resource object="Utility_Object_Generic_IE_SharePoint_CommonActions - Edge" action="Is Connected" /></stage><stage stageid="09f00544-61d2-4c62-934c-979127b977c3" name="is Connected?" type="Decision"><display x="465" y="960" w="90" h="30" /><decision expression="[Attached]" /><ontrue>d8d462e7-4c72-488b-9f5b-0deb8ff12e50</ontrue><onfalse>29f0085c-e041-4460-a03d-70188c79e50a</onfalse></stage><stage stageid="d8d462e7-4c72-488b-9f5b-0deb8ff12e50" name="Terminate Applciation" type="Action"><display x="705" y="960" w="90" h="30" /><onsuccess>015f3e29-d209-48f8-b755-56fba8ca853a</onsuccess><resource object="Utility_Object_Generic_IE_SharePoint_CommonActions - Edge" action="Terminate Application" /></stage><stage stageid="015f3e29-d209-48f8-b755-56fba8ca853a" name="Sleep" type="Action"><display x="705" y="1110" /><inputs><input type="number" name="Sleep Time (Seconds)" narrative="The time (in seconds) for which to sleep" expr="3" /></inputs><onsuccess>86d3338d-1d7f-4812-8799-dddd9f791061</onsuccess><resource object="Utility - General" action="Sleep" /></stage><stage stageid="29f0085c-e041-4460-a03d-70188c79e50a" name="Kill IE" type="Action"><display x="465" y="1110" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="&quot;msedge&quot;" /></inputs><onsuccess>015f3e29-d209-48f8-b755-56fba8ca853a</onsuccess><resource object="Utility_Object_Generic_KillProcess" action="Kill Process" /></stage><stage stageid="bc455fd7-d74c-43cc-940e-8142bdb71a8e" name="Update Parent Status" type="Action"><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="1245" y="555" w="90" h="30" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr=" [Exception Detail] " /></inputs><onsuccess>eb3e332c-7038-4128-8624-a1f6d7d5c73c</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="2bfe6e01-93f1-4b99-88f1-ed95e4021bd0" name="Block5" type="Block"><display x="-150" y="990" w="420" h="270" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3f4e04ff-9195-487a-a1a2-4fd726f957d6" name="Stop?" type="Decision"><display x="570" y="825" w="90" h="60" /><font family="Tahoma" size="10" style="Bold" color="FF0000" /><decision expression="IsStopRequested()" /><ontrue>210d2449-3725-43e7-96fd-6fc7ce2bde2a</ontrue><onfalse>1afe3419-4057-4bed-8948-3011cf0486eb</onfalse></stage><stage stageid="1afe3419-4057-4bed-8948-3011cf0486eb" name="Garbage Collection" type="Action"><display x="420" y="825" w="90" h="30" /><onsuccess>ac89a181-1242-4fc1-a40b-c6b3c9a8b502</onsuccess><resource object="Utility - Environment Extended" action="Garbage Collector" /></stage><stage stageid="ecf82708-ecf2-4de1-a53c-bb562f5478f0" name="GetException" type="MultipleCalculation"><display x="1125" y="975" /><onsuccess>28f5a496-5133-4a40-8be9-5d5f179baa23</onsuccess><steps><calculation expression="ExceptionDetail()" stage="Exception Detail" /><calculation expression="ExceptionType()" stage="Exception Type" /></steps></stage><stage stageid="6d5d6b99-5f71-4ff0-aa1a-2a838b4a9f91" name="Anchor4" type="Anchor"><display x="1290" y="840" w="10" h="10" /><onsuccess>bfa03336-87fc-4c4f-aa59-979656aaafbc</onsuccess></stage><stage stageid="28c5c30d-123f-48c5-bd46-e0178973c787" name="Release Item" type="Action"><narrative>Marks the item as deferred. It is unlocked, but it will not be made available for processing again until the specified time.

The attempts count for the item is reset to zero.</narrative><display x="960" y="195" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to defer" expr="[Item ID]" /><input type="datetime" name="Until" narrative="When to resume processing the case" expr="Now()" /></inputs><onsuccess>458762d9-7dd4-47c0-bbdc-55d193273d9c</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Defer" /></stage><stage stageid="37b934f3-0ddd-4af4-b17e-7eaec18e77c9" name="Recover2" type="Recover"><display x="15" y="1215" /><onsuccess>8de2e6d5-7962-4b5e-b761-3b0d6c3c8954</onsuccess><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="6b64234d-604c-473d-a007-8555d2ec78b6" name="Resume2" type="Resume"><display x="15" y="1335" /><onsuccess>c497e1fd-2941-4a69-bd7e-f8568e84ae9e</onsuccess></stage><stage stageid="8de2e6d5-7962-4b5e-b761-3b0d6c3c8954" name="GetException" type="MultipleCalculation"><display x="15" y="1290" /><onsuccess>6b64234d-604c-473d-a007-8555d2ec78b6</onsuccess><steps><calculation expression="ExceptionDetail()" stage="Exception Detail" /><calculation expression="ExceptionType()" stage="Exception Type" /></steps></stage><stage stageid="e63f9c86-ea2f-47ec-afc6-516534d0e095" name="Anchor10" type="Anchor"><display x="270" y="1545" w="10" h="10" /><onsuccess>0d3d9732-b813-47d2-aaa5-1cef0fae304b</onsuccess></stage><stage stageid="c497e1fd-2941-4a69-bd7e-f8568e84ae9e" name="Take ScreenShot" type="Action"><display x="120" y="1410" w="90" h="30" /><inputs><input type="text" name="SavePath" narrative="Where to save the scerenshot" expr="[ScreenShotPath]" /><input type="text" name="Name Prefix" narrative="Prefix for name. It will be appended with date and time." expr="&quot;FileNotFound&quot;" /></inputs><outputs><output type="flag" name="success" stage="success" /><output type="text" name="errormsg" stage="errormsg" /><output type="text" name="filename" stage="filename" /></outputs><onsuccess>477dd6c2-9ff5-4e29-ab93-d1ac474636c3</onsuccess><resource object="DWF Utility - Screenshot" action="Screenshot" /></stage><stage stageid="477dd6c2-9ff5-4e29-ab93-d1ac474636c3" name="CheckStatus" type="Decision"><display x="120" y="1470" w="90" h="60" /><decision expression="[success]" /><ontrue>660a53a9-5e85-4e95-8d9a-cc508b07a844</ontrue><onfalse>6e5799a7-018e-41d4-8313-55841072302e</onfalse></stage><stage stageid="660a53a9-5e85-4e95-8d9a-cc508b07a844" name="SendEmail" type="Action"><display x="120" y="1545" w="120" h="30" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" expr="[ProdEmailID]" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." expr="&quot;System Exception : Bulk Unlock Process&quot;" /><input type="text" name="Message" narrative="Optional, HTML or plain text" expr="&quot;Hi Team,&quot; &amp; NewLine() &amp; &quot;Please find the Exception Details below :&quot; &amp; NewLine() &amp; [Exception Detail] &amp; NewLine() &amp; NewLine() &amp; &quot;Thanks&quot; &amp; NewLine()  " /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." expr="[ScreenShotPath]&amp; &quot;\&quot;&amp; [filename]" /></inputs><onsuccess>e63f9c86-ea2f-47ec-afc6-516534d0e095</onsuccess><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="6e5799a7-018e-41d4-8313-55841072302e" name="SendEmail" type="Action"><display x="270" y="1470" w="120" h="30" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" expr="[ProdEmailID]" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." expr="&quot;System Exception : Bulk Unlock Process&quot;" /><input type="text" name="Message" narrative="Optional, HTML or plain text" expr="&quot;Hi Team,&quot; &amp; NewLine() &amp; &quot;Please find the Exception Details below :&quot; &amp; NewLine() &amp; [Exception Detail] &amp; NewLine() &amp; NewLine() &amp; &quot;Thanks&quot; &amp; NewLine()  " /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." expr="" /></inputs><onsuccess>0d3d9732-b813-47d2-aaa5-1cef0fae304b</onsuccess><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="a83e4c6e-f901-436a-b02b-b706c3036d2c" name="Recover4" type="Recover"><display x="45" y="1575" /><onsuccess>32564dc0-65aa-4577-a77b-c51aca55439e</onsuccess></stage><stage stageid="32564dc0-65aa-4577-a77b-c51aca55439e" name="Resume4" type="Resume"><display x="45" y="1650" /><onsuccess>cd255d53-03a2-4939-bd12-52795ebe9fb3</onsuccess></stage><stage stageid="cd255d53-03a2-4939-bd12-52795ebe9fb3" name="Anchor16" type="Anchor"><display x="270" y="1650" w="10" h="10" /><onsuccess>e63f9c86-ea2f-47ec-afc6-516534d0e095</onsuccess></stage><stage stageid="cab441d9-1d47-4d52-911f-652840e9c951" name="Block7" type="Block"><display x="-15" y="1380" w="405" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0d3d9732-b813-47d2-aaa5-1cef0fae304b" name="Mark Item As Exception" type="SubSheet"><display x="570" y="1545" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" expr="[Item ID]" /><input type="text" name="Child ID" expr="[Child Item ID]" /><input type="flag" name="isParent" expr="False" /><input type="text" name="Completed without outcome msgs" friendlyname="Completed without outcome msgs" expr="[ConfigFileData.Completed_without_outcome_msgs]" /></inputs><onsuccess>3b322dda-c6e4-4f43-9bc0-8097fd93b50c</onsuccess><processid>d599353b-a78b-40f4-ab04-255791b86a1a</processid></stage><stage stageid="8f57f36f-957d-4aa2-a843-e26ffc7e0a5e" name="Txt_FromRPATxtBox" type="Data"><display x="-540" y="990" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3b322dda-c6e4-4f43-9bc0-8097fd93b50c" name="Anchor5" type="Anchor"><display x="570" y="1245" w="10" h="10" /><onsuccess>43b7dc92-16af-417e-8545-f2674921294c</onsuccess></stage><stage stageid="5dd7823c-cc20-4a56-bd67-a2ad40d89669" name="CheckSuccesOrFailure" type="Decision"><display x="120" y="1140" w="90" h="30" /><decision expression="StartsWith([Txt_FromRPATxtBox], &quot;Success:&quot;)" /><ontrue>5e808699-68ae-483e-b5c6-58d545b2a84c</ontrue><onfalse>71b356ab-ce7d-41ea-87b9-4fbaaf618c85</onfalse></stage><stage stageid="5e808699-68ae-483e-b5c6-58d545b2a84c" name="Update Status" type="Action"><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="330" y="1140" w="90" h="30" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Child Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;Unlocking Confirmed&quot;" /></inputs><onsuccess>a04432c6-6136-46ad-a3d9-9b5cb82242cd</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="14e8b129-3cf8-4163-804e-026475eb7bf6" name="Update Status" type="Action"><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="375" y="1275" w="90" h="30" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Child Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;Fail to Unlock&quot;" /></inputs><onsuccess>5045e77d-0b8a-45b7-bc2b-63a1c502e2c8</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="5045e77d-0b8a-45b7-bc2b-63a1c502e2c8" name="GetException" type="MultipleCalculation"><display x="495" y="1275" /><onsuccess>0d3d9732-b813-47d2-aaa5-1cef0fae304b</onsuccess><steps><calculation expression="&quot;Fail to unlock&quot;" stage="Exception Detail" /><calculation expression="&quot;Business Exception&quot;" stage="Exception Type" /></steps></stage><stage stageid="1972aa83-90d4-4553-913e-17e1da1a3311" name="Delete Old File" type="Action"><display x="990" y="840" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[TempPath]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs><onsuccess>ce36a6bb-50d0-49f6-9cae-d0d05b0b989c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="38ed38c2-807a-4f77-ae39-2e21082ee3d9" name="variables" type="Block"><subsheetid>0cb78916-8a2f-49bc-937f-a4df839669a5</subsheetid><display x="-600" y="0" w="270" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="becb8724-9846-4bab-8228-705db86ccd99" name="Create Folder" type="Action"><display x="195" y="-330" w="90" h="30" /><inputs><input type="text" name="Directory Path" narrative="The path in which to create the directory" expr="[RequestFolderPath]" /><input type="flag" name="Error If Already Exists" narrative="True to generate an error if the directory already exists" expr="False" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs><onsuccess>7ea82288-884b-4637-9faf-53294b53f287</onsuccess><resource object="Utility - File Management" action="Create Directory" /></stage><stage stageid="6b9435a8-6c5d-4e9a-8f02-16e36e89c373" name="Parent_Q_SingleRow" type="Collection"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-255" y="105" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><singlerow /><field name="Sno" type="text" /><field name="URL" type="text" /><field name="BaseConnection" type="text" /><field name="BaseFolderURL" type="text" /><field name="SiteURL" type="text" /><field name="ListTitle" type="text" /></collectioninfo><initialvalue><singlerow /><row><field name="Sno" type="text" value="" /><field name="URL" type="text" value="" /><field name="BaseConnection" type="text" value="" /><field name="BaseFolderURL" type="text" value="" /><field name="SiteURL" type="text" value="" /><field name="ListTitle" type="text" value="" /></row></initialvalue></stage><stage stageid="5f51402e-9958-4d74-b6b8-378d4da3c15f" name="Loop ParentQ" type="LoopStart"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="45" /><onsuccess>271658b1-d83e-46a5-a343-ada091e043c2</onsuccess><groupid>0f7c1ef0-a7d6-48d1-b9f9-6ada5ee45cbe</groupid><looptype>ForEach</looptype><loopdata>Parent_Q</loopdata></stage><stage stageid="63d592f1-4ef9-4afc-b76c-11242aad75a9" name="Loop ParentQ" type="LoopEnd"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="15" y="240" /><onsuccess>fe5f11c4-5ed6-4179-953b-34102b684e62</onsuccess><groupid>0f7c1ef0-a7d6-48d1-b9f9-6ada5ee45cbe</groupid></stage><stage stageid="6a317b2c-9713-4030-8a53-6c3839c88b9e" name="AssignToSingleRow" type="MultipleCalculation"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="105" y="150" /><onsuccess>f80e5761-e77b-4443-b273-cbfdac70bb40</onsuccess><steps><calculation expression="[Parent_Q.BaseConnection]" stage="Parent_Q_SingleRow.BaseConnection" /><calculation expression="[Parent_Q.BaseFolderURL]" stage="Parent_Q_SingleRow.BaseFolderURL" /><calculation expression="[Parent_Q.ListTitle]" stage="Parent_Q_SingleRow.ListTitle" /><calculation expression="[Parent_Q.SiteURL]" stage="Parent_Q_SingleRow.SiteURL" /><calculation expression="[Parent_Q.Sno]" stage="Parent_Q_SingleRow.Sno" /><calculation expression="[Parent_Q.URL]" stage="Parent_Q_SingleRow.URL" /></steps></stage><stage stageid="230bf1fe-6269-4ea0-acfb-23d2fc44609b" name="Anchor6" type="Anchor"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-60" y="150" w="10" h="10" /><onsuccess>31c50f71-6e83-47e7-8b6e-e5685cec5cfe</onsuccess></stage><stage stageid="31c50f71-6e83-47e7-8b6e-e5685cec5cfe" name="Anchor7" type="Anchor"><subsheetid>278b483a-05df-407c-95d3-c39e0fbbaf26</subsheetid><display x="-60" y="240" w="10" h="10" /><onsuccess>63d592f1-4ef9-4afc-b76c-11242aad75a9</onsuccess></stage><stage stageid="5888423d-63c8-49ad-8323-1f8c458805ed" name="GetAllFilesPowerShell" type="SubSheetInfo"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="74aeb665-d8d9-45c8-b5ba-d10dacd44b2f" name="Start" type="Start"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="15" y="-255" /><inputs><input type="text" name="BaseURL" narrative="SharePoin BaseURL" stage="BaseURL" /><input type="text" name="PowerShellScript" narrative="GetAllFilesScript" stage="PowerShellScript" /><input type="text" name="ResultPath" narrative="Output text file path" stage="ResultPath" /><input type="number" name="WaitTimeForFileSize" narrative="WaitTimeForFileSize" stage="WaitTimeForFileSize" /></inputs><onsuccess>8a8359af-e3ba-4b24-b344-36376bf2054f</onsuccess></stage><stage stageid="c4443376-a9bc-4280-957f-31f691937407" name="End" type="End"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="15" y="615" /><outputs><output type="text" name="Run Report" stage="Run Report" /><output type="text" name="Error_Message" stage="Error_Message" /></outputs><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="492958e0-f1aa-4512-9eeb-4c46239cacac" name="PowerShellGetAllFile_Template" type="Data"><display x="-900" y="240" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$outputfile= "_RPA_outputfile_RPA_"
$SourceName= "_RPA_SourceName_RPA_"
$baseURL = "_RPA_baseURL_RPA_"
$temp = ""
Connect-PnPOnline -SPOManagementShell -Url $baseURL
if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }
Else{ New-Item $outputfile -ItemType File -ErrorAction stop }
Add-Content  $outputfile -Value "File ID__RPA__File Name__RPA__Relative Path"
Get-PnPListItem -List $SourceName -Fields("FSObjType","ID","FileLeafRef","FileDirRef").FieldValues -PageSize 500 -ScriptBlock { Param($items) foreach($itm in $items) { if($itm.FieldValues["FSObjType"] -eq "0"){ $str = $itm.FieldValues["ID"].ToString() + "__RPA__" + $itm.FieldValues["FileLeafRef"] + "__RPA__" +   $itm.FieldValues["FileDirRef"] ;  Add-Content  $outputfile $str ;  } } }</initialvalue><private /><alwaysinit /></stage><stage stageid="6c1c4b43-f04e-4558-b9a7-80ea6602034e" name="PowerShellGetAllFile" type="Data"><display x="-810" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a842d32-d6ab-487e-9ab2-23481c9d829c" name="BaseURL" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-345" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3604edca-79b6-412e-8bd2-43764503a83e" name="PowerShellScript" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-345" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c300086-1373-49bf-a1a4-fb0a588c7622" name="PNP Login" type="Action"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" expr="" /><input type="text" name="Site_URL" narrative="Site or Subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" expr="[BaseURL]" /></inputs><outputs><output type="text" name="Run_status" narrative="Provide script run status." stage="Run_status" /></outputs><onsuccess>e6289595-ecb3-4433-9b56-3e17baebc72f</onsuccess><resource object="Utility_Object_Generic_SharePoint_API_Common_Actions" action="SharePoint_Login" /></stage><stage stageid="42920aef-da0c-416e-b25f-a4ae7a1aa3fd" name="Run_status" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-240" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e6289595-ecb3-4433-9b56-3e17baebc72f" name="Get All Details with Retention Labels" type="Action"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="30" w="90" h="30" /><inputs><input type="text" name="SharePoint Site URL" friendlyname="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" expr="[Item Data.BaseConnection]" /><input type="text" name="ScriptLocation" friendlyname="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" expr="" /><input type="text" name="SourceName" friendlyname="SourceName" narrative="SourceName" expr="[Item Data.BaseFolderURL]" /><input type="text" name="Output_TxtFilePath" friendlyname="Output_TxtFilePath" narrative="Output_TxtFilePath" expr="[ResultPath]" /><input type="text" name="TimeOut" friendlyname="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" expr="" /></inputs><outputs><output type="text" name="Script_Run_Message" friendlyname="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Run_status" /><output type="text" name="Script_Error_Message" friendlyname="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs><onsuccess>a5399975-f53f-408c-8418-0b2b0bfd5034</onsuccess><resource object="Utility_Object_Generic_SharePoint_API_Common_Actions" action="Get All File Details with Retention Labels" /></stage><stage stageid="8ecfa1fc-f0df-4e93-b221-34fc4cedf451" name="Script_Path" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-345" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c50269dc-7f98-4f63-ae79-bc1f6482c0fb" name="Status_Message" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-345" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="73256ad0-b94b-43c0-b0ab-b1c99db61ca7" name="RunScript" type="Action"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><loginhibit /><display x="-90" y="240" w="90" h="30" /><inputs><input type="text" name="Script_Path" narrative="Script Location" expr="[DocumentPath] &amp; &quot;\&quot; &amp; [ScriptName] &amp; &quot;.ps1&quot;" /><input type="text" name="Application" narrative="Application.exe" expr="&quot;powershell.exe&quot;" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>a5399975-f53f-408c-8418-0b2b0bfd5034</onsuccess><resource object="Utility_Object_Generic_SharePoint_API_Common_Actions" action="Run PnP_Script" /></stage><stage stageid="877206bb-fefb-4fb0-b3da-c9ebbb99d067" name="ScriptName" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-240" y="0" /><datatype>text</datatype><initialvalue xml:space="preserve">GetAllFiles</initialvalue><private /><alwaysinit /></stage><stage stageid="e7a6afe0-c9cc-4e98-b5f7-6b1912e1e911" name="DocumentPath" type="Data"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="-240" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="000c652c-4246-4af9-b4a6-60454b0f396d" name="DocPath" type="Calculation"><subsheetid>46da21e4-9187-4bc3-896a-8ee1435a78f1</subsheetid><display x="15" y="-150" /><o