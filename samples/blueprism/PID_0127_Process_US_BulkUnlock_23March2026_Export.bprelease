alue /><private /><alwaysinit /></stage><stage stageid="1fde1946-c1c2-4e50-89db-574ba56aadee" name="Return Message" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07e5bd6e-a372-443a-8662-f11beea9e983" name="Script Path" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="22f2c2cc-3c63-407f-90bd-86059d358619" name="Error_Message" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="454330eb-1c31-4ed1-8d4c-6b3897fc6010" name="Run Report" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b76b4f8-4a99-4cf6-801b-33147447d78b" name="P_Exists" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5f83467-d234-4414-b1e8-8f954b567245" name="Standards" type="Note"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list.(Unique Column to be prefered )

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://abc-sp.xyz.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://abcsp.xyz.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="0f9dc2b1-8477-4c41-8941-cad040e92263" name="Unexpected exception recover" type="Recover"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="450" y="-120" /><onsuccess>69569712-9455-4f2f-bc67-661f31048cd6</onsuccess></stage><stage stageid="d759d976-f1e7-4cee-b673-2239c6438e23" name="Unexpected Exception" type="Exception"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="806f0cc0-e370-4324-9ee7-bf587f354f65" name="Script_Location" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="58f195ab-8702-4762-a7ea-3da9a60ae77c" name="Find_Item_By" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="69569712-9455-4f2f-bc67-661f31048cd6" name="Delete_Script" type="Action"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="450" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>d759d976-f1e7-4cee-b673-2239c6438e23</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="b4bd18ae-9003-49a0-af9a-39f6adf318e8" name="Validate Temp Script Path" type="SubSheet"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>72d5751a-5473-47b8-b17a-ee860b3294ea</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="7c43c11c-5abf-42c8-a28c-ffb289209897" name="Error Message?" type="Decision"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="90" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot;" /><ontrue>5e75d7dc-163f-43af-8a94-8b8c5a92fc9c</ontrue><onfalse>090e5198-cd60-4645-94b3-2a55dbc84fec</onfalse></stage><stage stageid="5e75d7dc-163f-43af-8a94-8b8c5a92fc9c" name="Received exception after running the script" type="Exception"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="210" y="90" /><exception type="Business Exception" detail="[Error_Message]" /></stage><stage stageid="2959255a-4964-4bc3-a27e-3b5d9e30e655" name="Page Size" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-150" y="-15" /><datatype>number</datatype><initialvalue>5000</initialvalue><private /><alwaysinit /></stage><stage stageid="c64f8abd-e43a-4625-93be-4be5e7e4c474" name="Item_to_be_Retrieved" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-120" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d3ba98ec-c37f-40c2-a5a7-1f0fa8791fb4" name="Set Metadata to existing item" type="SubSheetInfo"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><narrative>Searched particular list item and updates the specified meta data</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8fefa8fd-4f85-4d2f-b355-fbc4fd9057f9" name="Start" type="Start"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name/Value of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="number" name="Page Size" narrative="(Optional)Specify the page size (Default: 5000)" stage="Page Size" /><input type="text" name="Metadata_to_set" narrative="Specify the metadata to be set" stage="Metadata_to_set" /></inputs><onsuccess>eb14430a-2064-4793-a338-c637f10a85c8</onsuccess></stage><stage stageid="358bcce3-554a-493d-9fc8-a9684cfe41a5" name="End" type="End"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Message" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="7343a28c-d740-4eb8-8926-322361019db0" name="Build Script" type="Calculation"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="-105" /><onsuccess>6b6b5331-1a67-4394-9a9d-abe55664cb05</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize &quot;&amp;[Page Size]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot; Set-PnPListItem -List &quot;&amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp;&quot; -Identity $item -Values @{&quot;&amp;[Metadata_to_set]&amp;&quot;} &quot;&#xA;&amp;NewLine()&amp;&quot;Exit &quot; &amp; NewLine()&amp;&#xA; &quot;}&quot; &amp; NewLine() &amp; &#xA;&quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &#xA;&quot;Catch {&quot; &amp; NewLine() &amp;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="266a5105-aeea-43ae-bbb6-4e75da0dc86d" name="Run PnP_Script" type="SubSheet"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>db5183d6-12d6-4263-84f6-f5eba72197da</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="0c95c526-023a-4fc1-9482-a23da579e8fd" name="Delete_Script" type="Action"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="300" /><i