9b-36d8-4a59-9a99-f3ac2c26b96b" name="Library Name" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-450" y="255" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="843f4c23-1d43-4ee8-b818-9c27af4116d8" name="Make changes" type="MultipleCalculation"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="0" /><onsuccess>2a280cac-266e-417b-a756-0321aa0e4b4d</onsuccess><steps><calculation expression="Replace([Script], &quot;___RPA_LIBRARYNAME___&quot;, [Library Name])" stage="Script" /><calculation expression="Replace([Script], &quot;___RPA_LIBRARYPATH___&quot;, [SP_Lib_Folder_Path])" stage="Script" /></steps></stage><stage stageid="417cec70-6904-4c8c-8414-6a4ea038ac00" name="FieldName" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9a67109-0e36-4bb8-a3d1-70e62eca8d16" name="FieldValue" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-255" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63ac03d3-b415-44db-a205-ec92daa2c8b9" name="Get All Latest Files W.r.t File Creation Time" type="SubSheetInfo"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><narrative>Get All Latest File W.r.t File Creation time From Sharepoint</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="16af43c1-353c-4e48-bf02-93469eda186a" name="Create New Shell Document Set" type="SubSheetInfo"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><narrative>Create New Folder in a library.
MinAccess:- Add_Edit
On success "Folder Created Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f5fa8978-920d-42d7-b307-92bd9410dcf2" name="Start" type="Start"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target Folder Name Ex:- PNP_Test_Lib/Unittesting" stage="SP_RelLib_Url" /><input type="text" name="New_Folder_Name" narrative="New Folder . Ex:- Test" stage="New_Foldername" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Content_Type" narrative="Type of content that will be created, Ex: Shell Document Set" stage="Content_Type" /></inputs><onsuccess>2ea852c5-b49c-4947-baf4-8b3e4405ba49</onsuccess></stage><stage stageid="308b656b-a0a1-48a5-b822-8a5df4ccb185" name="Build Script" type="Calculation"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="-15" /><onsuccess>69073ef5-5580-49cf-8330-6fdf7e6b9759</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Add-PnPDocumentSet -Name &quot; &amp;Chr(34) &amp; [New_Foldername]  &amp;Chr(34) &amp;  &quot; -List &quot; &amp;Chr(34) &amp;  [SP_RelLib_Url] &amp;Chr(34) &amp; &quot; -ContentType &quot; &amp;Chr(34) &amp;  [Content_Type] &amp;Chr(34) &amp;   &quot; -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Folder Created  Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException]  { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="e19a6968-e862-40a5-85b5-958fba6daa71" name="Run PnP_Script" type="SubSheet"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>ae7e50fe-ff4b-4308-ae94-ad52ece75a1c</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d01e24a1-9e47-425a-a607-78b252787406" name="Delete_Script" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>909b4328-bf5e-4a80-9d1b-ecfb1ad232cd</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="69073ef5-5580-49cf-8330-6fdf7e6b9759" name="Generate_PnPScript" type="SubSheet"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_Folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>6a539153-71e4-4d9b-a3a5-11de8fdea14d</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="6a539153-71e4-4d9b-a3a5-11de8fdea14d" name="Check_Error" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>f8f549f0-2be3-47a1-b1a7-537289e05d08</ontrue><onfalse>e19a6968-e862-40a5-85b5-958fba6daa71</onfalse></stage><stage stageid="f8f549f0-2be3-47a1-b1a7-537289e05d08" name="Exception while creating  Script" type="Exception"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="d59ffd93-48b3-4f9e-b501-fc93b9575b8b" name="Check Process_Exist" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>1132821c-34f1-4c1a-9e35-4d7f7f061b9f</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="1132821c-34f1-4c1a-9e35-4d7f7f061b9f" name="ProcessExist?" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>3aff71a3-4f05-44c9