    Remove-Item $filePath 
}
$env:PNPPOWERSHELL_UPDATECHECK="false"
Connect-PnPOnline -Url $URL -AccessToken "__ACCESSTOKEN__" -WarningAction SilentlyContinue
$fields = Get-PnPField -List $listName

foreach($Column in $Columns){
    foreach($field in $fields){
        if($field.InternalName -eq $Column){
            if($field.GetType().Name -eq "FieldUser"){
               $field.Title + "_Email" + "," | Add-Content -Path $filePath -NoNewline
                $field.Title  + "_Value" + "," | Add-Content -Path $filePath -NoNewline 
            }
            else{
                $field.Title  + ","| Add-Content -Path $filePath -NoNewline
            }
            break
        }
    }
}
"" | Add-Content -Path $filePath
$listitems = Get-PnPListItem -List $listName -Query $query -PageSize $pagesize

$listColumn = [System.Collections.ArrayList]@()

foreach($listitem in $listitems ){
    
    foreach($Column in $Columns){
        if($listitem[$Column] -ne $null) {

            if($listitem[$Column].GetType() -ne $null){
                
                if($listitem[$Column].GetType().Name -eq "FieldUserValue"){
                   
                   """" + $listitem[$Column].Email + """" + ","| Add-Content -Path $filePath -NoNewline
                   """" + $listitem[$Column].LookupValue + """" + ","| Add-Content -Path $filePath -NoNewline 
                    
                }
                
                elseif($listitem[$Column].GetType().Name -eq "FieldLookupValue"){
                   
                     """" + $listitem[$Column].LookupValue + """" + ","| Add-Content -Path $filePath -NoNewline
                }
                elseif($listitem[$Column].GetType().Name -eq "String[]"){
                   
                     """" + ($listitem[$Column] -join "|") + """" + ","| Add-Content -Path $filePath -NoNewline
                }
				elseif($listitem[$Column].GetType().Name -eq "DateTime"){

                     """" + $listitem[$Column].ToLocalTime() + """" + ","| Add-Content -Path $filePath -NoNewline
                }
                
                else{

                     """" + $listitem[$Column] + """" + ","| Add-Content -Path $filePath -NoNewline
                }
            }
        }
      else{
        
          
                   "" + ","| Add-Content -Path $filePath -NoNewline
       
       }
    
    }
    "" | Add-Content -Path $filePath 
}

</initialvalue><private /><alwaysinit /></stage><stage stageid="9a77f3b3-eb19-4747-b48a-bfeba0e062dd" name="Script To Extract Vales" type="MultipleCalculation"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit /><display x="-165" y="-315" /><onsuccess>5300b123-0ad5-4c74-819d-dec5d9098985</onsuccess><steps><calculation expression="Replace([Script Template], &quot;__COLUMNS__&quot;, [Columns])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__FILEPATH__&quot;, [CSV FilePath] )" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__URL__&quot;, [SP_Site_URL])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__LISTNAME__&quot;, [SP_List])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__QUERY__&quot;, [Query])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__PAGESIZE__&quot;, [PageSize])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__ACCESSTOKEN__&quot; , [AccessToken]  )" stage="Script Template" /></steps></stage><stage stageid="f94a07ba-8c2b-4d8b-afc7-9d827db04c52" name="CSV FilePath" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-225" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b01dd37-706b-4304-bf8c-74e6f77f2efe" name="Query" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-315" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">&lt;View&gt;&lt;OrderBy&gt;&lt;FieldRef Name='ID' Ascending='TRUE'/&gt;&lt;/OrderBy&gt;&lt;/View&gt;</initialvalue><private /><alwaysinit /></stage><stage stageid="5d407976-43bd-4776-a8f4-28ab2d8f7d36" name="PageSize" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-165" w="150" h="30" /><datatype>number</datatype><initialvalue>1000</initialvalue><private /><alwaysinit /></stage><stage stageid="4bc5c184-2494-42d2-8cd0-a292291d90cf" name="Get FileName and Path" type="Action"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="-375" /><inputs><input type="text" name="File Path" friendlyname="File Path" narrative="The path to split" expr="[CSV FilePath]" /></inputs><outputs><output type="text" name="File Name" friendlyname="File Name" narrative="The filename" stage="File Name" /><output type="text" name="Folder" friendlyname="Folder" narrative="The folder" stage="Folder" /></outputs><onsuccess>9a77f3b3-eb19-4747-b48a-bfeba0e062dd</onsuccess><resource object="Utility - File Management_Extended" action="Split Path" /></stage><stage stageid="977768d2-2b13-4ee3-bb64-5c2a44a5b21b" name="File Name" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65e92234-1ec8-45dc-afab-612fb136d0d2" name="Folder" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e3c7c575-2a61-41ca-b5c6-8ba7d1d77a34" name="Script Path" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="14bcd6e3-ef09-45ad-b16b-370e17c160f7" name="Remove_Folder_From_Library" type="SubSheetInfo"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><narrative>Remove file from specific library/ sharepoint location.</narrative><display x="-75" y="-270" w="150" h="90" /></stage><stage stageid="fad799cf-fc4f-4172-aec5-032dfdf02e81" name="Start" type="Start"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><preconditions><condition narrative="&gt; Make sure SharePoint API is installed." /><condition narrative="&gt;Make sure you have atleast Edit access/contribute access to Site/Library to use this action." /></preconditions><postconditions><condition narrative="&gt; Get the output and create the success/failure condition." /></postconditions><display x="120" y="-330" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_Lib_Folder" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder/)" stage="SP_Target_Lib" /><input type="text" name="FolderName" narrative="Input the folder namer to be deleted (Ex:- Test)" stage="Folder" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>172db761-39e4-42fc-8122-9cba4b4140a2</onsuccess></stage><stage stageid="b9a9a1bd-618c-4ad5-98f4-98309a738965" name="End" type="End"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="300" /><outputs><output type="text" name="Script_Run_Message" narrative="returns Blank/Warning for software update." stage="Run Report" /><output type="text" name="Script_Error_Message" narrative="Returns error/exception details ( On error shares error details)" stage="Error_Message" /></outputs></stage><stage stageid="78cadce4-297b-4423-8efe-6f705070d96a" name="Build Script" type="Calculation"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-135" /><onsuccess>305020f3-3db9-4d28-a472-b4bf10d6dcda</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot; Remove-PnPFolder -Folder &#xA;&quot; &amp; Chr(34) &amp; [SP_Target_Lib]&amp;Chr(34)&amp;&quot; -Name &quot;&amp;Chr(34)&amp; [Folder]&amp; Chr(34) &amp;  &quot; -Force&quot;" stage="Script" /></stage><stage stageid="113b646f-aed3-4381-aa92-1d195e91ca9e" name="Run PnP_Script" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="15" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>54d72b98-3a45-44f7-a881-fcbcccfd87a9</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="bfb1c261-3562-4c96-b2cf-573065e2f9b3" name="Delete_Script" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="225" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b9a9a1bd-618c-4ad5-98f4-98309a738965</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="305020f3-3db9-4d28-a472-b4bf10d6dcda" name="Generate_PnPScript" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="1