 y="75" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="461e9d14-3867-4cba-8ccb-2d57cafcdf8f" name="ConsecutiveDelimiter" type="Data"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><display x="-345" y="-15" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="9768837f-0e0c-4492-9888-57fbfd9f5d13" name="OtherCondition" type="Data"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><display x="-345" y="75" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="d09f534d-0a8d-45cf-be51-a359f0f7db21" name="DestinationStartingCell" type="Data"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><display x="-345" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aa0751e9-0be3-46cf-b1fb-11838749fe72" name="TextToColumns - FixedWidth" type="Code"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><loginhibit /><display x="15" y="15" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Cell Reference]" /><input type="text" name="DelimiterCondition" expr="[DelimiterCondition]" /><input type="flag" name="ConsecutiveDelimiter" expr="[ConsecutiveDelimiter]" /><input type="flag" name="SemicolonCondition" expr="[SemicolonCondition]" /><input type="flag" name="SpaceCondition" expr="[SpaceCondition]" /><input type="flag" name="TabCondition" expr="[TabCondition]" /><input type="flag" name="CommaCondition" expr="[CommaCondition]" /><input type="flag" name="OtherCondition" expr="[OtherCondition]" /><input type="text" name="DestinationStartingCell" expr="[DestinationStartingCell]" /></inputs><outputs><output type="text" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>cd1ad0f2-ba89-4d59-984a-4f03b608844f</onsuccess><code><![CDATA[Dim wb as Object = GetWorkbook(Handle,Workbook)
Dim ws as Object = GetWorksheet(Handle,Workbook,Worksheet)
Dim matrix = New Integer(1, 1) {{3, 1}, {0, 1}}
Dim excel, sheet, range as Object

Try

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference) 	

excel.DisplayAlerts = False 

range.Select()
	range.TextToColumns(Destination:=sheet.Range(DestinationStartingCell),  DataType:=2,FieldInfo:=matrix, TrailingMinusNumbers:=True)

Success = True

Catch e As Exception

	Success = False
	Message = e.Message

Finally
	wb = Nothing
	Ws = Nothing
	excel = Nothing
	sheet = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="4f529739-e10a-4b92-9ad1-91ae22f1e827" name="Success" type="Data"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><display x="-345" y="180" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e1e57235-0656-4afb-8a42-d1447a81e9b6" name="Message" type="Data"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><display x="-210" y="180" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1010750a-c667-4af7-94c8-9c27e8a965c3" name="Block11" type="Block"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><loginhibit /><display x="-420" y="-75" w="285" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="bacc12be-fad7-435e-81d3-8889b0518eb9" name="Block12" type="Block"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><loginhibit /><display x="-420" y="150" w="285" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="bc1987a0-72ee-4f35-a424-f958fb870bb1" name="Filter ExcelRows - with Range" type="SubSheetInfo"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><narrative>Apply Filter excel based on Range</narrative><display x="-255" y="-90" w="150" h="90" /></stage><stage stageid="cffd91e3-0c7e-4560-92ab-eee2b6589a43" name="End" type="End"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="30431c1e-29fa-41ff-a078-a358e95ce8ce" name="handle" type="Data"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><display x="-255" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="539092a0-8a49-495c-bd28-0fcd8123d0c3" name="Workbook Name" type="Data"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><display x="-330" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0a4452b-e631-475a-84b8-1cbd95532664" name="Range" type="Data"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5a941b2e-f35b-4feb-899b-910e90a07104" name="worksheet name" type="Data"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><loginhibit /><display x="-300" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0c56fac8-2ffc-4938-9caf-3e19c5599ef4" name="Filter by selecting Range" type="Code"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="range" expr="[Range]" /></inputs><onsuccess>cffd91e3-0c7e-4560-92ab-eee2b6589a43</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Worksheets(worksheet).Range(range).AutoFilter
]]></code></stage><stage stageid="243a027c-88cb-43ca-a8ad-b17891c175a8" name="Activate Workbook" type="SubSheet"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook Name]" /></inputs><onsuccess>0c56fac8-2ffc-4938-9caf-3e19c5599ef4</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="bafc4351-8564-45c3-81bb-f3b34f54d34d" name="Start" type="Start"><subsheetid>af8661e9-ee59-4540-928b-a70824e4199d</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="handle to use for interacting with workbook" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="range" narrative="Range to apply the filter on" stage="Range" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /></inputs><onsuccess>243a027c-88cb-43ca-a8ad-b17891c175a8</onsuccess></stage><stage stageid="baf99359-418d-4855-9f41-18f26313738d" name="ChartCopyPaste" type="SubSheetInfo"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><narrative>Copy and paste a chart</narrative><display x="-210" y="-150" w="150" h="90" /></stage><stage stageid="57d2186f-abfa-4e86-9c3e-be66928dcca0" name="Start" type="Start"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><loginhibit /><display x="30" y="-240" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="WB" narrative="Specify workbook name" stage="WB" /><input type="text" name="WS" narrative="Specify the worksheet name" stage="WS" /><input type="text" name="SourceChartName" narrative="specify the chart name" stage="SourceChartName" /><input type="text" name="DestinationWorkbook" narrative="specify the destination workbook" stage="DestinationWorkbook" /><input type="text" name="DestinationSheet" narrative="specify the dest sheet" stage="DestinationSheet" /><input type="text" name="DestinationCell" narrative="sepcify the cell" stage="DestinationCell" /></inputs><onsuccess>bffb4cca-9a30-4f28-985a-70e61b739441</onsuccess></stage><stage stageid="3139651a-4a4c-4c21-a1fe-bc92f74a86e3" name="End" type="End"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><loginhibit /><display x="30" y="-90" /><outputs><output type="flag" name="Success" narrative="SucessCheck" stage="Success" /><output type="text" name="Message" narrative="Output MEssage" stage="Message" /></outputs></stage><stage stageid="b6f84713-afb6-4c4c-8e25-e0aff348afa5" name="handle" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-330" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2f4ca4d6-bca6-4f9a-9d29-aab4949e4809" name="WB" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-165" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bffb4cca-9a30-4f28-985a-70e61b739441" name="Copy Paste Chart" type="Code"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><loginhibit onsuccess="true" /><display x="30" y="-180" w="90" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[WB]" /><input type="text" name="Worksheet" expr="[WS]" /><input type="text" name="SourceChartName" expr="[SourceChartName]" /><input type="text" name="DestinationWorkbook" expr="[DestinationWorkbook]" /><input type="text" name="DestinationSheet" expr="[DestinationSheet]" /><input type="text" name="DestinationCell" expr="[DestinationCell]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>3139651a-4a4c-4c21-a1fe-bc92f74a86e3</onsuccess><code><![CDATA[Dim wb,ws,sheet,excel,dws,dwb As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
dwb = GetWorkbook(Handle, DestinationWorkbook)
dws = GetWorksheet(Handle, DestinationWorkbook, DestinationSheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
dwb.Activate()
dws.Activate()



sheet.ChartObjects(SourceChartName).Activate
    excel.ActiveChart.ChartArea.Copy
    dwb.Sheets(DestinationSheet).Activate
    dwb.Sheets(DestinationSheet).Range(DestinationCell).Select
    dwb.ActiveSheet.Paste


Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
               
End Try]]></code></stage><stage stageid="69458859-adb7-4b92-8d7c-13a806527f21" name="Success" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-165" y="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2888b187-b998-445d-aea9-a80e5b1f23d8" name="Message" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-300" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a3cbd73e-ab4e-46dc-ae0d-3798aa6632b3" name="WS" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-255" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1fdc00ef-d30f-443b-a53e-385797379c39" name="SourceChartName" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-375" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cfab62d5-5ffc-46d4-ad1c-17c8551c8f25" name="DestinationSheet" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-195" y="-60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e1737979-08dc-4895-ba0b-d0469b94d089" name="DestinationCell" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-315" y="-60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ec454933-78b5-484c-b307-43ae730c7aa2" name="DestinationWorkbook" type="Data"><subsheetid>e15aae44-6b93-429b-b5d3-25d8f34b699e</subsheetid><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9147b1b7-57c1-4266-8d6e-760804c36a3c" name="Unprotect workbook" type="SubSheetInfo"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><narrative>Unprotect worksheet from excel workbook</narrative><display x="-315" y="-120" w="150" h="90" /></stage><stage stageid="590939a2-d8c4-46ea-af40-c2cc98e8e13e" name="Start" type="Start"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="excel handle number" stage="handle" /><input type="text" name="workbook name" narrative="workbook name of the excel" stage="Workbook Name" /><input type="password" name="Password" narrative="worksheet password" stage="Password" /></inputs><onsuccess>e5766c49-ab0a-4439-9954-f64bc1832e90</onsuccess></stage><stage stageid="04c26d0a-8f13-47aa-8a47-ae7bf7b16556" name="End" type="End"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><loginhibit /><display x="15" y="30" /></stage><stage stageid="e2cf5aac-93f2-4318-bc8d-f5e27f1fea16" name="handle" type="Data"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><display x="-255" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2cba118a-d5f0-43bb-b72d-c33c530eb29c" name="Workbook Name" type="Data"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><display x="-330" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ff0b37e-cdd2-4c1a-9624-4fe2ae3e12d8" name="worksheet name" type="Data"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><loginhibit /><display x="-330" y="45" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="e5766c49-ab0a-4439-9954-f64bc1832e90" name="Unprotect workbook code" type="Code"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><loginhibit /><display x="15" y="-45" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="number" name="handle" expr="[handle]" /><input type="password" name="Password" expr="[Password]" /></inputs><onsuccess>04c26d0a-8f13-47aa-8a47-ae7bf7b16556</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Unprotect(Password)]]></code></stage><stage stageid="1880d97a-eab1-469c-9be8-ae9fa7d99bd8" name="Password" type="Data"><subsheetid>a041cc23-9b33-478c-9e5a-81ec400a77fa</subsheetid><display x="-255" y="45" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="8c07daf1-211a-4504-b87c-4876a36a5e62" name="Get Worksheet Range As Collection - Unicode" type="SubSheetInfo"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><narrative>Background : Certain characters were being read as '?' in the existing 'Get worksheet range as collection' action. So this action is made to handle the Unicode characters.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e0e0fe9b-0ee7-4829-9eb2-7def9e0f2f7e" name="End" type="End"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><loginhibit /><display x="135" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Data" narrative="The spreadsheet data from the specified range, as a collection" stage="worksheetcollection" /></outputs></stage><stage stageid="fc620d29-2855-41de-827f-3d344e44a109" name="handle" type="Data"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="-75" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="f2d0202f-a78a-49b0-8226-b443d60c9fd4" name="workbookname" type="Data"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="-75" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c82f723f-8a80-4356-aaff-87f4b8f75ce6" name="Start" type="Start"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><loginhibit /><display x="135" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="StartCell" narrative="The starting cell of the range of interest" stage="Start Cell" /><input type="text" name="EndCell" narrative="The end cell of the range of interest" stage="End Cell" /></inputs><onsuccess>39184401-d6b6-4fe9-a184-a7d2565673b1</onsuccess></stage><stage stageid="5e55e666-f639-40b9-9cab-9b32869a5fba" name="GetWorksheetRangeAsCollection - Unicode" type="Code"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><loginhibit /><display x="135" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Start Cell" expr="[Start Cell]" /><input type="text" name="End Cell" expr="[End Cell]" /></inputs><outputs><output type="collection" name="worksheetcollection" stage="worksheetcollection" /></outputs><onsuccess>e0e0fe9b-0ee7-4829-9eb2-7def9e0f2f7e</onsuccess><code><![CDATA[
	Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
	Dim r as Object
	r = ws.Range(Start_Cell & ":" & End_Cell)
	r.Select()
	r.Copy()

	Dim data As String = Clipboard.GetDataObject().GetData(DataFormats.UnicodeText, True)
	
	' The data split into rows
	Dim asRows() As String = Split(data, vbCrLf)
	
	Dim table As New DataTable()
	' Set a flag indicating the header row
	Dim isHeaderRow As Boolean = True
	
	For Each strRow As String In asRows
		If Not String.IsNullOrEmpty(strRow) Then
		
			Dim fields() As String = Split(strRow, vbTab)
			If isHeaderRow Then
			
				isHeaderRow = False
				For Each field As String in fields
					table.Columns.Add(field)
				Next
				
			Else

				Dim row as DataRow = table.NewRow()
				For i As Integer = 0 To fields.Length - 1
					If i < fields.Length Then
						row(i) = fields(i)
					Else
						row(i) = ""
					End If
				Next I
				table.Rows.Add(row)
				
			End If
				
		End If
		
	Next
	worksheetcollection = table]]></code></stage><stage stageid="39184401-d6b6-4fe9-a184-a7d2565673b1" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><loginhibit /><display x="135" y="-60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>5e55e666-f639-40b9-9cab-9b32869a5fba</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="1e6a0416-6ecc-45b4-b916-bd1180d9bb25" name="worksheetname" type="Data"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="-75" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b241cb0e-7e33-48ed-a837-cb00302731bf" name="worksheetcollection" type="Collection"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="345" y="-15" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a5cd38eb-30de-4272-a9a3-94abba8dacf5" name="Start Cell" type="Data"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="-225" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ccc781a5-cd76-481f-b6d4-280c3674ec7c" name="End Cell" type="Data"><subsheetid>c8796959-cc97-485b-bb2a-b1dbd5b61f47</subsheetid><display x="-300" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="840c304c-3f85-4af1-9da7-a35aa360d007" name="Convert Text to Any Format" type="SubSheetInfo"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><narrative>Convert Text to Any Format for any given cell range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="11324a03-2f28-4ca8-b6b1-17597cfe498b" name="handle" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><display x="-180" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5741cb94-3a04-499f-9166-937dc29110db" name="Workbook Name" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><display x="-180" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cdc3c3f3-b9c5-4021-b136-b70c28f89c31" name="WorkSheet Name" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><display x="-180" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c0b3cfab-c018-4a6d-8a25-486ee26dfd35" name="lastRow" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="-180" y="90" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b03c5748-6f40-4df7-9cc9-95c35ec6eb2d" name="Start_Cell" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="-180" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5a8eccdd-1d7d-4fb6-b5a2-d25e9c4d8d53" name="End_Cell" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="-180" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="55fa2919-a4d7-4c90-b1c7-1a9c873b2591" name="Start" type="Start"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="number" name="handle" narrative="Handle Instance" stage="handle" /><input type="text" name="Workbook Name" narrative="Name of the Workbook" stage="Workbook Name" /><input type="text" name="WorkSheet Name" narrative="Sheet Name in which Name conversion needs to be created" stage="WorkSheet Name" /><input type="text" name="Start_Cell" narrative="Start Cell Ref value" stage="Start_Cell" /><input type="text" name="End_Cell" narrative="End Cell Ref value" stage="End_Cell" /><input type="number" name="lastRow" narrative="last valid row number" stage="lastRow" /><input type="text" name="Any_Format" narrative="Any format eg. dd/mm/yyyy or 0.00%" stage="Any_Format" /></inputs><onsuccess>ff66c686-3154-4352-b7bf-4e0a320bbb9f</onsuccess></stage><stage stageid="7422a714-4f9a-4575-a428-0982ff704e7c" name="End" type="End"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="15" y="135" /></stage><stage stageid="ff66c686-3154-4352-b7bf-4e0a320bbb9f" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="15" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[Workbook Name]" /></inputs><onsuccess>6d57d73a-ed96-4171-b557-27d3ef0d359b</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="6d57d73a-ed96-4171-b557-27d3ef0d359b" name="Change Text to Any Format" type="Code"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="15" y="60" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[WorkSheet Name]" /><input type="number" name="lastRow" expr="[lastRow]" /><input type="text" name="Start_Cell" expr="[Start_Cell]" /><input type="text" name="End_Cell" expr="[End_Cell]" /><input type="text" name="Any_Format" expr="[Any_Format]" /></inputs><onsuccess>7422a714-4f9a-4575-a428-0982ff704e7c</onsuccess><code><![CDATA[Dim wb, ws, temp As Object


wb = GetWorkbook (Handle, Workbook)
ws = GetWorkSheet (Handle, Workbook, Worksheet)


With ws.Range((Start_Cell & ":" & End_Cell) & (lastRow))
            .NumberFormat = Any_Format
             temp = .Value 
            .Value = temp
        End With

wb = Nothing
ws = Nothing]]></code></stage><stage stageid="2024b09d-3e6d-4a41-81a7-b2c5699e0a70" name="Any_Format" type="Data"><subsheetid>ec619f71-7f21-408d-a886-63bc7dccc682</subsheetid><loginhibit /><display x="-195" y="180" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="71d59ad8-e30d-45b9-a303-614a4772433a" name="Create Name Range - Single cell - with Data Type Format" type="SubSheetInfo"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><narrative>To create name range to a set of cells using the values present in another set of cells. Also update the data type format of target cell</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="04330758-8832-48a5-8d55-54945dddc257" name="Start" type="Start"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="handle" stage="handle" /><input type="text" name="Workbook Name" stage="Workbook Name" /><input type="text" name="WorkSheet Name" stage="WorkSheet Name" /><input type="text" name="Start_Cell" stage="Start_Cell" /><input type="text" name="End_Cell" stage="End_Cell" /><input type="text" name="Target_Column" stage="Target_Column" /><input type="text" name="Data Type Format" stage="Any_Format" /></inputs><onsuccess>6bef8751-9191-454a-ba54-e8a2fbc136e3</onsuccess></stage><stage stageid="a06347e1-e7ae-44f7-aebf-6ec79f212726" name="End" type="End"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="a562084e-8a8e-4d5f-9034-cce897757df0" name="Create Name Range - Test" type="Code"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="15" y="15" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[WorkSheet Name]" /><input type="text" name="Start_Cell" expr="[Start_Cell]" /><input type="text" name="End_Cell" expr="[End_Cell]" /><input type="text" name="Target_Column" expr="[Target_Column]" /><input type="text" name="Any_Format" expr="[Any_Format]" /></inputs><onsuccess>a06347e1-e7ae-44f7-aebf-6ec79f212726</onsuccess><code><![CDATA[Dim wb, sh, temp As Object



wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)
Dim VisibleRng As Object

VisibleRng = sh.Range(Start_Cell & ":" & End_Cell).Rows.SpecialCells(12)


For Each rw In VisibleRng.Rows
    If rw.Value2 <> "" AND rw.Value2<>"Range Name Label" Then
        sh.Names.Add(Name:=rw.Value2,RefersTo:= sh.Range(Target_Column + CStr(rw.Row) + ":"& Target_Column + CStr(rw.Row)))
		sh.Range(Target_Column & CStr(rw.Row)).NumberFormat = Any_Format
		temp = sh.Range(Target_Column & CStr(rw.Row)).Value
		sh.Range(Target_Column & CStr(rw.Row)).Value = temp

    End If

Next



wb = Nothing
sh = Nothing]]></code></stage><stage stageid="6bef8751-9191-454a-ba54-e8a2fbc136e3" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[Workbook Name]" /></inputs><onsuccess>a562084e-8a8e-4d5f-9034-cce897757df0</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="56fae2b2-3e86-4763-a761-7aa8a859a5d3" name="handle" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><display x="-255" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2811d0a6-2151-4587-ba83-10c34e676722" name="Workbook Name" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><display x="-255" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c73201d5-4914-4372-844f-438fcc9f5965" name="WorkSheet Name" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><display x="-255" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="97501c1c-7695-4e4b-abc2-21ff485d9dc3" name="Start_Cell" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="-255" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e088101a-ee61-4062-94de-2731af2fd808" name="End_Cell" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="-255" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cbc9b07e-723b-406f-9bc6-5d53a184da45" name="Target_Column" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><loginhibit /><display x="-255" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6d65f2f8-35b4-4402-b916-8de2fa9ba6f8" name="Any_Format" type="Data"><subsheetid>ee82461e-b931-483b-89a6-a3220e0e909d</subsheetid><display x="-240" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9f2dd076-f7cd-4ea3-8340-4b7541a73ae8" name="Create Name Range - 2 Columns - with Data Type Format" type="SubSheetInfo"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><narrative>Create name range between 2 target column, and one column where name range names reside. Also update the Data type format of the name range columns.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="4b0c82f4-ddd5-4f4b-a2ca-777706a2f484" name="Start" type="Start"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="Handle Instance" stage="handle" /><input type="text" name="Workbook Name" narrative="Name of the Workbook" stage="Workbook Name" /><input type="text" name="WorkSheet Name" narrative="Sheet Name in which Name range needs to be created" stage="WorkSheet Name" /><input type="text" name="Start_Cell" narrative="Start Cell Ref value" stage="Start_Cell" /><input type="text" name="End_Cell" narrative="End Cell Ref value" stage="End_Cell" /><input type="text" name="Target_Column_1" narrative="Target column in which name range needs to be created" stage="Target_Column_1" /><input type="text" name="Target_Column_2" narrative="Target column in which name range needs to be created" stage="Target_Column_2" /><input type="text" name="Format" narrative="Data type format" stage="Any_Format" /><input type="text" name="ColumnQ" narrative="ColumnQ" stage="ColumnQ" /></inputs><onsuccess>f1fdbf15-7bdd-4411-bd22-8971cc7a4186</onsuccess></stage><stage stageid="564194a2-a2b6-49c1-923c-37339820d815" name="End" type="End"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="15" y="75" /></stage><stage stageid="4264e95c-80a8-4303-8bbe-928d9111d8af" name="Create Name Range-2 Columns - Copy" type="Code"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="15" y="15" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[WorkSheet Name]" /><input type="text" name="Any_Format" expr="[Any_Format]" /><input type="text" name="Start_Cell" expr="[Start_Cell]" /><input type="text" name="End_Cell" expr="[End_Cell]" /><input type="text" name="Target_Column_1" expr="[Target_Column_1]" /><input type="text" name="Target_Column_2" expr="[Target_Column_2]" /><input type="text" name="ColumnQ" expr="[ColumnQ]" /></inputs><onsuccess>564194a2-a2b6-49c1-923c-37339820d815</onsuccess><code><![CDATA[Dim wb, sh, temp As Object
Dim rng1 As Object
Dim rng2 As Object

wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)

 rng1 = sh.Range(Start_Cell & ":" & End_Cell).Rows.SpecialCells(12)

        For Each rng2 In rng1.Rows
		 If (Len(Trim(rng2.Value2)) > 0 And rng2.Value2 <> "Range Name Label") Then
			wb.Worksheets(sh.Name).Names.Add(Name:=rng2.Value2, RefersTo:="='" & sh.Name & "'!$" & Target_Column_1 & "$" & rng2.Row & ":$" & Target_Column_2 & "$" & rng2.Row)
			sh.Range(Target_Column_1 & rng2.Row & ":" & Target_Column_2 & rng2.Row).NumberFormat = Any_Format
			
			temp = sh.Range(Target_Column_1 & rng2.Row & ":" & Target_Column_2 & rng2.Row).Value
			sh.Range(Target_Column_1 & rng2.Row & ":" & Target_Column_2 & rng2.Row).Value = temp
			sh.Range(ColumnQ & CStr(rng2.Row)).NumberFormat = Any_Format
			
			temp = sh.Range(ColumnQ & CStr(rng2.Row)).Value
			sh.Range(ColumnQ & CStr(rng2.Row)).Value = temp
		End If
		Next

wb = Nothing
sh = Nothing

]]></code></stage><stage stageid="f1fdbf15-7bdd-4411-bd22-8971cc7a4186" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[Workbook Name]" /></inputs><onsuccess>4264e95c-80a8-4303-8bbe-928d9111d8af</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="7fd46e59-1f68-4e2e-8988-65bd3fc81f6f" name="handle" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><display x="-255" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc609feb-dfaf-4966-b712-65b91441bfa7" name="Workbook Name" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><display x="-255" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0769b57a-8fcf-4b3c-931c-af10f9752090" name="WorkSheet Name" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><display x="-255" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="723afbc0-0129-49fd-b863-b3e6b5ba0d9c" name="Start_Cell" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="-255" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7dcd7d21-65ce-4afa-a2df-267ea3593861" name="End_Cell" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="-255" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="71357a4c-0dad-460e-ba1f-8a2cad14bc6e" name="Target_Column_1" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="-255" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="700fb701-e0f5-4ca4-bb6d-e7b549fee416" name="Target_Column_2" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><loginhibit /><display x="-255" y="180" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5277c2fa-15a0-42a2-b97c-422eeb61bd0d" name="Any_Format" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><display x="-285" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="61162366-6b22-4d9e-9063-9c61bc577fc0" name="ColumnQ" type="Data"><subsheetid>b859d0e4-c739-47f0-a6c0-a33650777411</subsheetid><display x="-225" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0f17bdf8-1583-4d5c-9d50-db5059098b10" name="Find word in range" type="SubSheetInfo"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><narrative>Finds Word in the wb</narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="f583ab33-fe6c-4fbc-be8f-9a9b420c92aa" name="Start" type="Start"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-60" /><inputs><input type="number" name="handle " narrative="Handle" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="worksheet" narrative="Name of the worksheet" stage="worksheet name" /><input type="text" name="Range" narrative="Range of the adress" stage="Range" /><input type="text" name="Value" narrative="Value" stage="Value" /></inputs><onsuccess>c35a11a1-4750-4a4a-b2e7-2605d9db6414</onsuccess></stage><stage stageid="633639a7-4002-4d2e-a206-f7f968bb6a7a" name="End" type="End"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><loginhibit /><display x="15" y="75" /><outputs><output type="text" name="CellRef" stage="Cell Value" /></outputs></stage><stage stageid="14cd390c-8ecb-4528-a24f-d429583382b5" name="handle" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-300" y="75" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc194f23-51a6-4c05-ae86-80c1e42554ab" name="Workbook Name" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-300" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a74f9dd5-fab7-4607-9f73-45a10843df04" name="worksheet name" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><loginhibit /><display x="-300" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9b749020-420b-44ed-bcfe-fcb435364e90" name="Range" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-300" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="544369ea-6c44-4702-a8e0-b8f10b0fa06f" name="Value" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-300" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c35a11a1-4750-4a4a-b2e7-2605d9db6414" name="Excel Find Required Word in range" type="Code"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[worksheet name]" /><input type="text" name="Range" expr="[Range]" /><input type="text" name="Value" expr="Trim([Value])" /><input type="number" name="Handle" expr="[handle]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="FindCount" stage="Cell Value" /></outputs><onsuccess>633639a7-4002-4d2e-a206-f7f968bb6a7a</onsuccess><code><![CDATA[
FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range(Range).Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try

]]></code></stage><stage stageid="e4830876-05d5-46cf-a800-0633c24696c0" name="Success" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-135" y="15" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="92612aaa-ed48-435a-adc9-8d34f9e824a3" name="Message" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-135" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="29111893-63ed-40a9-935d-d410284e9f46" name="Cell Value" type="Data"><subsheetid>5b546b9f-d3d4-402d-8a18-d7ae201826dd</subsheetid><display x="-135" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="de97b781-0516-4604-9b0f-f1d43381965d" name="Create dropdown values in Excel range" type="SubSheetInfo"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><narrative>Creates a dropdown list in Excel file with the given values in the Excel range specified.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0f6a16cd-b1bd-4f31-a2f7-41e52fcd4489" name="Start" type="Start"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel instance handle" stage="handle" /><input type="text" name="Workbook name" narrative="Name of the workbook" stage="workbookname" /><input type="text" name="Worksheet name" narrative="Worksheet name" stage="WorksheetName" /><input type="text" name="Excel Range" narrative="Excel Range. Ex : A1:A5" stage="Range" /><input type="text" name="Dropdown values" narrative="Comma seperated values to be entered in Excel range. Ex : YES,No,NA" stage="Dropdown values" /></inputs><onsuccess>7f290dff-29d8-4383-99f4-4b9cb34b253f</onsuccess></stage><stage stageid="355283f8-ba30-49ff-9045-11ced14c48a8" name="End" type="End"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="d529bca9-55d4-48a2-adb5-e873f0015a1b" name="Create dropdown" type="Code"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><loginhibit /><display x="15" y="15" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbookname]" /><input type="text" name="Worksheet" expr="[WorksheetName]" /><input type="text" name="RangeAddress" expr="[Range]" /><input type="text" name="DropdownValues" expr="[Dropdown values]" /></inputs><onsuccess>355283f8-ba30-49ff-9045-11ced14c48a8</onsuccess><code><![CDATA[' Input Parameters:
' Handle
' Workbook
' WorksheetName: Name of the worksheet where you want to add the dropdown (e.g., "Sheet1")
' RangeAddress: The range where the dropdown will be applied (e.g., "A1")
' DropdownValues: The values to appear in the dropdown, separated by commas (e.g., "Yes,No,NA")

' Access the Excel Worksheet

Dim wb, sh As Object

wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)

' Define the range where you want the dropdown
Dim dropdownRange As Object
dropdownRange = sh.Range(RangeAddress)

' Create a dropdown (Data Validation List)
With dropdownRange.Validation
    .Delete ' Clear any existing validation
    .Add(Type:=3, AlertStyle:=1, Operator:=1, Formula1:=DropdownValues)
    .IgnoreBlank = True
    .InCellDropdown = True
    .ShowInput = True
    .ShowError = True
End With
]]></code></stage><stage stageid="138db08c-49e7-42f0-a17e-bed229b9556f" name="handle" type="Data"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><display x="-195" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="15ead2ba-bffc-45fc-9db1-8d346a9e328c" name="workbookname" type="Data"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><display x="-195" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7f290dff-29d8-4383-99f4-4b9cb34b253f" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>d529bca9-55d4-48a2-adb5-e873f0015a1b</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="1ca3fe4c-db58-45bd-bdca-5b7cee92aea4" name="WorksheetName" type="Data"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35e599af-7a16-45e4-9aae-86235c3c81bf" name="Range" type="Data"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><display x="-195" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8ebf8d5-da03-49b6-8306-1aefd27be187" name="Dropdown values" type="Data"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><display x="-195" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a458429-532b-49cd-8609-00b17c22da04" name="Inputs" type="Block"><subsheetid>d5105c39-f683-4fbc-a596-09b1af0424cf</subsheetid><loginhibit /><display x="-270" y="-30" w="165" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="865a1040-8c0e-49b0-9009-cc4c9ffcd8ab" name="Set Cell format(Fontname,size)" type="SubSheetInfo"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><narrative>Sets the Cell format for a given Excel range. 
Can be used to set Font name, size, strikethrough, and other properties
</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b7bf849c-c245-45de-bb04-3a674dbf3966" name="Start" type="Start"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel instance handle" stage="handle" /><input type="text" name="Workbook name" narrative="Name of the workbook" stage="workbookname" /><input type="text" name="Worksheet name" narrative="Worksheet name" stage="WorksheetName" /><input type="text" name="Excel Range" narrative="Excel Range. Ex : A1:A5" stage="Range" /><input type="text" name="FontName" narrative="Font name. Ex : Calibri" stage="FontName" /><input type="number" name="FontSize" narrative="Font size. Ex : 12" stage="FontSize" /><input type="flag" name="Strikethrough" narrative="Default value is False" stage="Strikethrough" /><input type="flag" name="Superscript" narrative="Default value is False" stage="Superscript" /><input type="flag" name="Subscript" narrative="Default value is False" stage="Subscript" /><input type="flag" name="OutlineFont" narrative="Default value is False" stage="OutlineFont" /><input type="flag" name="Shadow" narrative="Default value is False" stage="Shadow" /></inputs><onsuccess>b1385d76-861b-4d3b-9113-e72db5c6e548</onsuccess></stage><stage stageid="991e5b71-78f3-4744-af6a-00275a72bbeb" name="End" type="End"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="c9fb2c1e-5148-40c0-a831-4ec6021084f3" name="Set Cell Format" type="Code"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="15" y="15" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbookname]" /><input type="text" name="Worksheet" expr="[WorksheetName]" /><input type="text" name="RangeAddress" expr="[Range]" /><input type="text" name="FontName" expr="[FontName]" /><input type="number" name="FontSize" expr="[FontSize]" /><input type="flag" name="strikethrough" expr="[Strikethrough]" /><input type="flag" name="superscript" expr="[Superscript]" /><input type="flag" name="subscript" expr="[Subscript]" /><input type="flag" name="outlineFont" expr="[OutlineFont]" /><input type="flag" name="shadow" expr="[Shadow]" /></inputs><onsuccess>991e5b71-78f3-4744-af6a-00275a72bbeb</onsuccess><code><![CDATA[' Input Parameters:
' Handle
' Workbook
' WorksheetName: Name of the worksheet where you want to add the dropdown (e.g., "Sheet1")
' RangeAddress: The range where the dropdown will be applied (e.g., "A1")
' DropdownValues: The values to appear in the dropdown, separated by commas (e.g., "Yes,No,NA")

' Access the Excel Worksheet

Dim wb, sh As Object

wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)

' Define the range where you want the dropdown
Dim excelRange As Object
excelRange = sh.Range(RangeAddress)

' Create a dropdown (Data Validation List)
With excelRange.Font
        .Name = FontName
        .Size = FontSize
        .Strikethrough = strikethrough
        .Superscript = superscript
        .Subscript = subscript
        .OutlineFont = outlineFont
        .Shadow = shadow

End With
]]></code></stage><stage stageid="8e284dca-c5e6-448c-a23c-070766783c6a" name="handle" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b5548747-3079-492c-91d6-d5ad71081487" name="workbookname" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b1385d76-861b-4d3b-9113-e72db5c6e548" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>c9fb2c1e-5148-40c0-a831-4ec6021084f3</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="cd08f4c7-0618-45ea-8856-90bbabd38e61" name="WorksheetName" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5c372c5c-2779-4e89-8334-ae992dbdba4b" name="Range" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="659d6b83-b38e-46d7-88a2-ce815b8216c4" name="Inputs" type="Block"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-270" y="-30" w="165" h="405" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="acf3628c-b5d7-463a-bdb7-76b737fc4319" name="FontName" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dd1c434e-02f8-4da8-a464-44c503977fde" name="FontSize" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><display x="-195" y="150" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a41003da-bf82-4225-b994-3d7e4436bf2c" name="Strikethrough" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-195" y="180" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="794d89cd-0e5a-4a0b-94c0-62597b320b19" name="Superscript" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-195" y="210" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="1e359f4a-a330-4dd5-bca1-a08c06b655e0" name="OutlineFont" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-195" y="270" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="b3990576-113a-4798-ae79-d48936c6a988" name="Shadow" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-195" y="300" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="aec7bd4a-838f-4b1d-919e-23617d25b948" name="Subscript" type="Data"><subsheetid>695e5e3a-430e-4399-96ce-2fdf0bca60de</subsheetid><loginhibit /><display x="-195" y="240" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /></stage><stage stageid="06597e4e-85ea-418d-8bd4-327a2718e8d1" name="Pivot Table Remove All Filters" type="SubSheetInfo"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><narrative>column range should by syntax type e.g. A1:C1
column should be on which column it should be filtered based on where 1 is the first column 2 the second; e.g 1 on above example would filter on A1 

operator should be and if both should be compare or or if either if acceptable
value to filter  by should be the comparison operator and the value i.e "&lt;&gt; 10"</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="869b0d82-935e-4204-b27a-98e3ab3002e3" name="End" type="End"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="15" y="255" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="c25ba877-20b9-4717-a3aa-21842466efa7" name="handle" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="df617137-372e-4e4e-a3aa-a8c260afe6fe" name="workbookname" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9160fe60-355d-471e-a877-0e910c0cc5ba" name="Start" type="Start"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet which should be retrieved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which contains the sheet required. The default empty text indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="Pivot Table" narrative="Name of the Pivot table" stage="Pivot Table" /><input type="text" name="Pivot Column" narrative="Column Name of the pivot tabel to remove filter" stage="Pivot Column" /></inputs><onsuccess>a9ac7ce3-0903-4874-9628-4e849535af8a</onsuccess></stage><stage stageid="cbcd2a13-50fb-4ecf-817f-808f8dd86847" name="Update Pivot table to remove filter" type="Code"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="PivotTable" expr="[Pivot Table]" /><input type="text" name="PivotColumn" expr="[Pivot Column]" /></inputs><outputs><output type="flag" name="sheetexists" stage="sheetexists" /></outputs><onsuccess>8e8420f2-df9b-46c5-9dbf-4f67af534eb0</onsuccess><code><![CDATA[
	Dim ws as Object = _
	 GetWorksheet(handle, workbookname, worksheetname, False)

	' Do we have a sheet?
	sheetexists = ws IsNot Nothing
	' No sheet? No entry.
	If Not sheetexists Then Return
ws.PivotTables(PivotTable).PivotFields(PivotColumn).ClearAllFilters
]]></code></stage><stage stageid="a9ac7ce3-0903-4874-9628-4e849535af8a" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>cbcd2a13-50fb-4ecf-817f-808f8dd86847</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="8eeebe59-0a11-42a4-9976-d4de33dfb2e2" name="worksheetname" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8e8420f2-df9b-46c5-9dbf-4f67af534eb0" name="Sheet Exists?" type="Decision"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="15" y="165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[sheetexists]" /><ontrue>869b0d82-935e-4204-b27a-98e3ab3002e3</ontrue><onfalse>e2c81cb8-eff6-4143-a452-0543d2d49e53</onfalse></stage><stage stageid="e2c81cb8-eff6-4143-a452-0543d2d49e53" name="No Such Sheet" type="Exception"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="165" y="165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;No worksheet was found with the name '&quot; &amp; [worksheetname] &amp; &quot;' on the workbook '&quot; &amp; [workbookname] &amp; &quot;' within the instance with the handle: &quot; &amp; [handle]" /></stage><stage stageid="2dc756e1-67dd-485a-8314-d7b88881bd07" name="sheetexists" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3d85f861-9f66-42f8-90cf-f1365c9d81f8" name="Pivot Table" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="225" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c5348c7-ac52-43ee-80f9-bc4a6a2cf0ae" name="Pivot Column" type="Data"><subsheetid>7d899875-6ae6-4c28-9a53-cbbb6e2657c4</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27086149-49dc-4b43-af7a-025287b1f683" name="Pivot Table Add Filters - Single  value" type="SubSheetInfo"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><narrative>Add a single value to a filter</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="cead86ba-eae1-47e5-97b6-9d25004f8c06" name="End" type="End"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="15" y="255" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="4168e5f0-753e-491a-b12d-8449d7b830fb" name="handle" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="245d996d-6069-45cc-9441-11cbe11b75f2" name="workbookname" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b96dde3f-77a9-4518-af2b-f084e7b2ee4b" name="Start" type="Start"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet which should be retrieved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which contains the sheet required. The default empty text indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="Pivot Table" narrative="This info can be found in the Analyze - Pivot Table Name" stage="Pivot Table" /><input type="text" name="Pivot Column" narrative="This info can be found in the Analyze - Active Field field." stage="Pivot Column" /><input type="text" name="Values to Filter By" stage="Values to Filter" /></inputs><onsuccess>86dd2825-5746-4792-8a68-a7a3dc6f8e2e</onsuccess></stage><stage stageid="d864dad6-3346-4d8d-8413-1c77e6f5d4a2" name="Update Pivot table to add filter - Single value" type="Code"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="PivotTable" expr="[Pivot Table]" /><input type="text" name="PivotColumn" expr="[Pivot Column]" /><input type="text" name="ValuesToFilterBy" expr="[Values to Filter]" /></inputs><outputs><output type="flag" name="sheetexists" stage="sheetexists" /></outputs><onsuccess>441d142d-a45b-4e24-a294-4654abd66d42</onsuccess><code><![CDATA[
	Dim ws as Object = _
	 GetWorksheet(handle, workbookname, worksheetname, False)

	' Do we have a sheet?
	sheetexists = ws IsNot Nothing
	' No sheet? No entry.
	If Not sheetexists Then Return

ws.PivotTables(PivotTable).PivotFields(PivotColumn).ClearAllFilters()

'ws.PivotTables("PivotTable2").PivotFields("Month").PivotItems("4/1/2022").Visible = True
'ws.PivotTables(PivotTable).PivotFields(PivotColumn).PivotItems(ValuesToFilterBy).Visible = True


for each pvtItem as Object In ws.PivotTables(PivotTable).PivotFields(PivotColumn).PivotItems()
	If ValuesToFilterBy = pvtItem.Name Then
	ws.PivotTables(PivotTable).PivotFields(PivotColumn).PivotItems(pvtItem.Name).Visible = True
	Else 
	ws.PivotTables(PivotTable).PivotFields(PivotColumn).PivotItems(pvtItem.Name).Visible = False
	End If
Next]]></code></stage><stage stageid="86dd2825-5746-4792-8a68-a7a3dc6f8e2e" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>d864dad6-3346-4d8d-8413-1c77e6f5d4a2</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="8611bed7-f2d7-4c2c-9a25-e715b4f2f368" name="worksheetname" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="441d142d-a45b-4e24-a294-4654abd66d42" name="Sheet Exists?" type="Decision"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="15" y="165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[sheetexists]" /><ontrue>cead86ba-eae1-47e5-97b6-9d25004f8c06</ontrue><onfalse>ce596752-9066-438c-8b21-0c12e2af1bca</onfalse></stage><stage stageid="ce596752-9066-438c-8b21-0c12e2af1bca" name="No Such Sheet" type="Exception"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="165" y="165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;No worksheet was found with the name '&quot; &amp; [worksheetname] &amp; &quot;' on the workbook '&quot; &amp; [workbookname] &amp; &quot;' within the instance with the handle: &quot; &amp; [handle]" /></stage><stage stageid="d982369a-0754-4d1f-97d7-bfe86b810dad" name="sheetexists" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="19ee998d-a5cf-4d53-bc70-eb2e21562193" name="Pivot Table" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c17554b3-6032-4d48-a5e7-f5d8605cdd65" name="Pivot Column" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="300" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="18fd06bf-304e-4ad9-8fbc-b4a910db9238" name="Values to Filter" type="Data"><subsheetid>daef5339-cd94-40bf-862c-2c5ef54b1e03</subsheetid><display x="-195" y="225" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8931c3b9-34da-4ad5-af67-646540740109" name="Open Workbook - UpdateLinks" type="SubSheetInfo"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><narrative>
' Opens an Excel workbook with configurable link update behavior.
' Parameters:
'   filename     - Full path to the Excel file to open.
'   updateLinks  - Integer value indicating how Excel should handle external and remote links:
'                  0 = Do not update any links,
'                  1 = Update external links only,
'                  2 = Update remote links only,
'                  3 = Update all links (external and remote).
' Returns:
'   An Excel Workbook object (opened in the current Excel instance).</narrative><display x="-255" y="-165" w="360" h="150" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="287ecdce-1a96-4e12-8507-ef2c9f06fb2a" name="Start" type="Start"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /><input type="number" name="updateLinks" narrative="0 = Do not update any links, 1 = Update external links only, 2 = Update remote links only, 3 = Update all links (external and remote)." stage="updateLinks" /></inputs><onsuccess>cbd5e3f3-50d7-4266-aae1-36ec2dc48d90</onsuccess></stage><stage stageid="39be861a-db09-4a8b-b2f6-f9304d383e42" name="End" type="End"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="d68cb691-be5c-49a3-a0dd-62b5514510a8" name="Open Workbook - UpdateLinks" type="Code"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /><input type="number" name="handle" expr="[handle]" /><input type="number" name="updateLinks" expr="[updateLinks]" /></inputs><outputs><output type="text" name="workbookname" stage="workbookname" /></outputs><onsuccess>e7ca13eb-ee59-4401-92e1-dd9a793ef4b4</onsuccess><code><![CDATA[
Dim wb As Object = GetInstance(handle).Workbooks.Open(filename, UpdateLinks:=updateLinks)
 
workbookname = wb.Name
wb.Activate()]]></code></stage><stage stageid="633a6705-c2ff-426b-a8c2-e5749f7b43e0" name="handle" type="Data"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="011a38e3-e85d-4d29-9a87-883c46d8d137" name="filename" type="Data"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cbd5e3f3-50d7-4266-aae1-36ec2dc48d90" name="CheckInstanceHandle" type="SubSheet"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>aa2e2675-e6ee-4845-88b6-cbbe1a3336fd</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="aa2e2675-e6ee-4845-88b6-cbbe1a3336fd" name="VerifyFileExists" type="SubSheet"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>d68cb691-be5c-49a3-a0dd-62b5514510a8</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="415f5b3f-9f49-416b-b3e9-79fb6e2fced7" name="workbookname" type="Data"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc9d375e-f873-42e6-80d6-f48cc5162aae" name="Enable Events" type="Data"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="e7ca13eb-ee59-4401-92e1-dd9a793ef4b4" name="Set Events Enabled" type="SubSheet"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><loginhibit onsuccess="true" /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>39be861a-db09-4a8b-b2f6-f9304d383e42</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="58398738-2abc-47e7-9974-41f3030f443e" name="updateLinks" type="Data"><subsheetid>b0def40e-2022-4f07-92c1-692118e2624f</subsheetid><display x="-210" y="150" w="90" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="cb567cc0-56ac-4a52-bbfa-46af966bec8b" name="ClearFilter_AllWorksheets" type="SubSheetInfo"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><narrative>Clears all the filters in the workbook (All Worksheets)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5542662e-fee3-45d9-bd49-92a5c8984af8" name="Start" type="Start"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-90" /><inputs><input type="text" name="Workbook" narrative="Mandatory : Specify the workbook name to be used" stage="Workbook" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /></inputs><onsuccess>549578d2-207a-414a-b5e8-7a7152505311</onsuccess></stage><stage stageid="119f2ce7-0d25-435a-9a7e-12655620519b" name="End" type="End"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="549578d2-207a-414a-b5e8-7a7152505311" name="Clear Filters" type="Code"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook]" /><input type="number" name="handle" expr="[Handle]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>1d7a82df-af0a-4e33-8e29-81b570042da6</onsuccess><code><![CDATA[Dim wb As Object
Dim ws As Object

Try
    GetInstance(handle).DisplayAlerts = False
    wb = GetWorkbook(handle, workbook)

    wb.Activate()

    ' Loop through all worksheets in the workbook
    For Each ws In wb.Worksheets
        Try
            ws.Activate()
            ws.ShowAllData()
        Catch
            ' Do nothing — no filters to clear
        End Try
    Next

    Success = True

Catch e As Exception
    Success = False
    Message = e.Message

Finally
    wb = Nothing
End Try
]]></code></stage><stage stageid="bf1cfb99-b642-44a6-9da3-98339b782a91" name="Message" type="Data"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06512e2d-86c9-4235-92bb-e42614f2c59f" name="Success" type="Data"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1fafb47c-8dc0-4055-9497-fee5a439670e" name="Workbook" type="Data"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="70238e50-4232-4ec1-a99a-543339534322" name="Handle" type="Data"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="205b3a9a-8988-47dd-b358-9e9cf5e1d9b8" name="Stage3" type="Block"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-90" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2ee22f28-c7e7-4cef-827d-82349d441d39" name="Throw Exception" type="Exception"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="1d7a82df-af0a-4e33-8e29-81b570042da6" name="Check Success?" type="Decision"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>119f2ce7-0d25-435a-9a7e-12655620519b</ontrue><onfalse>2ee22f28-c7e7-4cef-827d-82349d441d39</onfalse></stage><stage stageid="ebb8704e-0005-4cf9-9d64-7697fd861107" name="Inputs" type="Block"><subsheetid>07043327-c5c0-4c8a-9156-ef857d22cbc5</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="02d6e577-e28b-455e-9d75-bfaa5f64fb89" name="Recover3" type="Recover"><subsheetid>99e648cc-a136-471c-8424-19071c0fd9e7</subsheetid><loginhibit /><display x="195" y="-120" /><onsuccess>3a90d903-08e8-4d15-91da-b6ce06191f69</onsuccess></stage><stage stageid="3a90d903-08e8-4d15-91da-b6ce06191f69" name="Resume2" type="Resume"><subsheetid>99e648cc-a136-471c-8424-19071c0fd9e7</subsheetid><loginhibit /><display x="285" y="-120" /><onsuccess>07cf052a-0b56-4f7f-9278-4036355f1dbb</onsuccess></stage><stage stageid="07cf052a-0b56-4f7f-9278-4036355f1dbb" name="Create Instance Late Binding" type="Code"><subsheetid>99e648cc-a136-471c-8424-19071c0fd9e7</subsheetid><loginhibit /><display x="285" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="handle" stage="handle" /></outputs><onsuccess>a13edde2-3883-4007-9719-92f0e1009ddd</onsuccess><code><![CDATA[
Dim excel as Object 
    excel = CreateObject("Excel.Application")

' Create a GUID with which we can kill the instance later
' if we have to play hardball to get rid of it.
excel.Caption = System.Guid.NewGuid().ToString().ToUpper()

handle = GetHandle(excel)]]></code></stage><stage stageid="4977b999-9e40-4613-9b55-c07c20d0203f" name="Handling Active Pop-up" type="Block"><subsheetid>99e648cc-a136-471c-8424-19071c0fd9e7</subsheetid><loginhibit /><display x="15" y="-150" w="225" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage></process></object>
        <object id="c28cdbe1-9417-4ded-80c1-19fc3f6ab7f0" name="MS Outlook Email VBO" xmlns="http://www.blueprism.co.uk/product/process"><process name="MS Outlook Email VBO" version="6.3.0.6190" bpversion="7.3.1.15031" narrative="Business Object for interacting with Microsoft Outlook email functions" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="MyBenefits-v1.0-FormEmail-v03"><id>f3b00b4d-4be0-4f04-9487-e6f10bf837b0</id><group name="Element1"><id>eb432f34-b608-4a9e-9e5a-7d6a721ea139</id></group><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element><apptypeinfo><id>Win32Launch</id><parameters><parameter><name>Path</name><value>C:\Program Files (x86)\Microsoft Office\Office14\WINWORD.EXE</value></parameter><parameter><name>CommandLineParams</name><value></value></parameter><parameter><name>WorkingDirectory</name><value></value></parameter><parameter><name>NonInvasive</name><value>True</value></parameter><parameter><name>ProcessMode</name><value>Internal</value></parameter><parameter><name>ExternalProcessTimeout</name><value>0</value></parameter><parameter><name>Options</name><value></value></parameter></parameters></apptypeinfo></appdef><view><camerax>-195</camerax><cameray>-84</cameray><zoom version="2">1.25</zoom></view><preconditions><condition narrative="The Object requires a MS interop runtime DLL &quot;Microsoft.Office.Interop.Outlook.dll&quot; to be installed in order to run. This DLL can be installed as an optional feature using the Blue Prism installer." /></preconditions><endpoint narrative="" /><subsheet subsheetid="810b21b7-6b6b-4c7b-be10-b0c5f2911afc" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>-182</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="e0b58522-643b-42ad-8fdd-4cb5246c5558" type="Normal" published="True"><name>Send Email</na