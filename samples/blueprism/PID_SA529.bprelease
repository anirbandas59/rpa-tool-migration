where N is the total number of rows in the collection)." expr="0" /></inputs><outputs><output type="text" name="Value Read" narrative="The value of the requested field as text." stage="Value Read" /></outputs><onsuccess>c2719216-4ca7-4c5d-82a7-26d8d72aa123</onsuccess><resource object="Utility - Collection Manipulation" action="Read Collection Field" /></stage><stage stageid="bfbea419-ebc6-40e4-a2df-c6923db21318" name="Value Read" type="Data"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6efbbe59-b032-40a2-b518-9ba8af3626ac" name="Variables" type="Block"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><loginhibit /><display x="-285" y="-45" w="195" h="270" /><font family="Segoe UI" size="10" style="Regular" color="FF9900" /></stage><stage stageid="c2719216-4ca7-4c5d-82a7-26d8d72aa123" name="Typecast to Number" type="Calculation"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><loginhibit /><display x="15" y="30" /><onsuccess>d24c8d8b-43c9-4399-a934-ee3111f380fa</onsuccess><calculation expression="[Value Read]" stage="Row No" /></stage><stage stageid="573fa180-d953-4689-864e-a2a65e580b94" name="Start" type="Start"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><loginhibit /><preconditions><condition narrative="Row count and Column count and Worksheet Name should be present" /></preconditions><display x="15" y="-120" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook name" narrative="Workbook name" stage="workbook name" /><input type="text" name="Worksheet name" narrative="Worksheet name" stage="worksheet name" /><input type="text" name="Cell Address" narrative="Cell Address (Ex: AK21 or $AK$21)" stage="Cell Address" /></inputs><onsuccess>60958083-697d-43ca-b663-2ce7d45c5685</onsuccess></stage><stage stageid="60958083-697d-43ca-b663-2ce7d45c5685" name="Get Row Alphabet" type="Action"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-60" /><inputs><input type="text" name="Regex Pattern" narrative="The regex pattern to apply" expr="&quot;(?&lt;Row&gt;\d{1,})&quot;" /><input type="text" name="Target String" narrative="The target string to which apply the pattern and extract values" expr="[Cell Address]" /><input type="collection" name="Named Values" narrative="A collection of named values to extract from the target string" expr="[Named Values]" /></inputs><outputs><output type="collection" name="Named Values" narrative="Results of the named values extracted from the regex" stage="Named Values" /></outputs><onsuccess>1089e1c5-a42d-4584-a20c-009bdc74e644</onsuccess><resource object="Utility - Strings" action="Extract Regex Values" /></stage><stage stageid="8b045442-d2e1-4aff-bf49-45200e887eeb" name="Convert Column From Text to Column{Delimited}" type="SubSheetInfo"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><narrative>This Page converts the  format as Text to Column for a specified Column Range And Paste the Formatted data in the Specified Column Range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="ec1eedd0-301c-4a51-818e-5a456b401cd9" name="Start" type="Start"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="135" y="-90" /><inputs><input type="text" name="workbook" narrative="(Mandatory)Workbook name" stage="workbook" /><input type="text" name="worksheet" narrative="(Mandatory)WorkSheet name of the Excel File" stage="worksheet" /><input type="number" name="handle" narrative="(Mandatory)handle of open excel" stage="handle" /><input type="text" name="Range" narrative="(Mandatory)Range From Which Convert From Text To Column Occurs. Ex: A1:A100" stage="Range" /><input type="text" name="Cell_Reference" narrative="(Mandatory)Start Cell Reference. Ex: A1" stage="Cell_Ref" /><input type="flag" name="Consecutive Delimiter" narrative="Consecutive Delimiter" stage="Consecutive Delimiter" /><input type="flag" name="Tab" narrative="Tab" stage="Tab" /><input type="flag" name="Semicolon" narrative="Semicolon" stage="Semicolon" /><input type="flag" name="Comma" narrative="Comma" stage="Comma" /><input type="flag" name="Space" narrative="Space" stage="Space" /><input type="flag" name="Other" narrative="Other" stage="Other" /><input type="flag" name="TrailingMinusNumbers" narrative="TrailingMinusNumbers" stage="TrailingMinusNumbers" /><input type="text" name="Other Delimiter if any" narrative="Other Delimiter if any" stage="Other Delimiter if any" /></inputs><onsuccess>4243c4dd-5f6d-4ee7-a06d-36aef8b3e867</onsuccess></stage><stage stageid="bcd92912-fed7-4236-a39c-4e91f8cd7477" name="End" type="End"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="135" y="135" /></stage><stage stageid="eecd937a-5267-4e5b-af8f-bc3415e693a6" name="workbook" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="acbd7bc3-0463-4e41-b225-88f1ae123f28" name="worksheet" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd668e1a-efeb-4458-8a8d-c2a2669d8005" name="handle" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="19812b48-0bd3-40f7-9874-329f9adc87d7" name="Range" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b9cbac4-92a3-452c-8746-8e3fe60ce65a" name="Cell_Ref" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3bd78cce-1a47-4478-8704-b07b1f287b87" name="Inputs" type="Block"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="-300" y="-15" w="210" h="480" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c4d636d0-96d3-4823-bad5-aafa9a65bf62" name="Convert Column From Text to Column{Delimited}1" type="Code"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="270" y="-15" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="Col_Range" expr="[Range]" /><input type="text" name="Cell_Ref" expr="[Cell_Ref]" /><input type="flag" name="ConsecutiveDelimiter" expr="[Consecutive Delimiter]" /><input type="flag" name="Tab" expr="[Tab]" /><input type="flag" name="Semicolon" expr="[Semicolon]" /><input type="flag" name="Comma" expr="[Comma]" /><input type="flag" name="Space" expr="[Space]" /><input type="flag" name="Other" expr="[Other]" /><input type="flag" name="TrailingMinusNumbers" expr="[TrailingMinusNumbers]" /></inputs><onsuccess>2bec46ac-b276-4d85-ad4e-76432418c740</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(Col_Range).TextToColumns( _
        Destination:=.Range(Cell_Ref), _
        DataType:= 1, _
        TextQualifier:=1, _
        ConsecutiveDelimiter:=ConsecutiveDelimiter, _
        Tab:= Tab, _
        Semicolon:=Semicolon, _
        Comma:=Comma, _
        Space:=Space, _
        Other:=Other, _
        TrailingMinusNumbers:=TrailingMinusNumbers)

End with

]]></code></stage><stage stageid="00659772-23a5-482f-b117-fb40a7f994b7" name="Consecutive Delimiter" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91b4e682-9d06-4fb8-86c0-efe9f90c114b" name="Tab" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6e526679-8879-4ab2-9252-eb4606658d1c" name="Semicolon" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9609cd7c-4f0c-4893-bc8f-ec1d1628aa54" name="Comma" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="285" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd802e24-02f7-49a3-b6f0-e0c2ee28e36b" name="Space" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="255" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5855015c-f179-4f83-9014-450bcfaebe76" name="Other" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="345" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0fe26acb-38f4-44b5-9c8a-bc26ac6e6b06" name="TrailingMinusNumbers" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="315" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="08d93612-26da-4750-bf0e-bcdc59405c0b" name="Other Delimiter if any" type="Data"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><display x="-195" y="375" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4243c4dd-5f6d-4ee7-a06d-36aef8b3e867" name="Other Delimiter?" type="Decision"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="135" y="-15" w="90" h="60" /><decision expression="[Other]" /><ontrue>a1755557-5dfc-42e9-95e9-47754f1f5e58</ontrue><onfalse>c4d636d0-96d3-4823-bad5-aafa9a65bf62</onfalse></stage><stage stageid="a1755557-5dfc-42e9-95e9-47754f1f5e58" name="Convert Column From Text to Column{Delimited}" type="Code"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="135" y="60" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="Col_Range" expr="[Range]" /><input type="text" name="Cell_Ref" expr="[Cell_Ref]" /><input type="flag" name="ConsecutiveDelimiter" expr="[Consecutive Delimiter]" /><input type="flag" name="Tab" expr="[Tab]" /><input type="flag" name="Semicolon" expr="[Semicolon]" /><input type="flag" name="Comma" expr="[Comma]" /><input type="flag" name="Space" expr="[Space]" /><input type="flag" name="Other" expr="[Other]" /><input type="flag" name="TrailingMinusNumbers" expr="[TrailingMinusNumbers]" /><input type="text" name="OtherDelimiter" expr="[Other Delimiter if any]" /></inputs><onsuccess>bcd92912-fed7-4236-a39c-4e91f8cd7477</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(Col_Range).TextToColumns( _
        Destination:=.Range(Cell_Ref), _
        DataType:= 1, _
        TextQualifier:=1, _
        ConsecutiveDelimiter:=ConsecutiveDelimiter, _
        Tab:= Tab, _
        Semicolon:=Semicolon, _
        Comma:=Comma, _
        Space:=Space, _
        Other:=Other, _
		OtherChar:=OtherDelimiter, _
        TrailingMinusNumbers:=TrailingMinusNumbers)

End with

]]></code></stage><stage stageid="2bec46ac-b276-4d85-ad4e-76432418c740" name="Anchor2" type="Anchor"><subsheetid>50b7c154-5b52-436e-9683-6cd9cf8cb5ff</subsheetid><loginhibit /><display x="270" y="135" w="10" h="10" /><onsuccess>bcd92912-fed7-4236-a39c-4e91f8cd7477</onsuccess></stage><stage stageid="09dd1581-b0e9-4aab-87df-d657c1fb5a09" name="Go To Next Visible Cell" type="SubSheetInfo"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><narrative>Activates the next visble cell that can be found on the mentioned direction of the active cell.

This can either activate that cell before returning, or just return the cell reference while leaving the active cell as it was.

Params:
- handle : Number : The integer handle identifying the Excel instance to use. The default of zero indicates the 'current' instance.
- Direction : Text : The direction in which to go, this should start with "U", "D", "L" or "R" (not case-sensitive) - the rest of the string is ignored, so you can use "Up", "DOWN" "left" and, indeed, "r"
- Activate Cell? : Flag : True to activate the found cell, False to just return the reference. Default is False.

Returns:
- Cell Reference : Text : The cell ID which represents the next empty cell in the required direction. This will be blank if no empty cell was found in the given direction.

Exceptions:
Invalid Direction Parameter : If the given direction parameter was invalid - ie. did not start with one of the (case-insensitive) letters "U", "D", "L" or "R".</narrative><display x="-240" y="-120" w="450" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="79227e1b-af14-443c-a0e2-913f326329bf" name="Start" type="Start"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="105" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Direction" narrative="The direction in which the next empty cell is required. This should start with any of &quot;U&quot;, &quot;D&quot;, &quot;L&quot; or &quot;R&quot; to find a cell up, down, left or right respectively. The direction parameter is not case-sensitive." stage="direction" /><input type="flag" name="Activate Cell?" narrative="True to activate the cell which is found; False to just return the reference and leave the active cell as it was before. Default is False." stage="activatecell" /></inputs><onsuccess>74491e4f-42bd-4492-bb39-c8f059781ac6</onsuccess></stage><stage stageid="72282afe-145d-42af-8a22-74c8f34008d5" name="End" type="End"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="105" y="285" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Cell Reference" narrative="The cell reference identifying the next empty cell from the active cell in the direction given. An empty value indicates that there were no empty cells between the active cell and a boundary." stage="cellref" /></outputs></stage><stage stageid="00c9218b-27dc-48aa-8164-aef357532e8a" name="direction" type="Data"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><display x="-300" y="75" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="68fc3a07-eb29-4bb8-a862-3aa12b82fe93" name="cellref" type="Data"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><display x="-300" y="105" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="74491e4f-42bd-4492-bb39-c8f059781ac6" name="Direction Valid?" type="Decision"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><narrative>Direction must start with one of the following:
- U : Indicates 'up'
- D : Indicates 'down'
- L : Indicates 'left'
- R : Indicates 'right'
Any other value (including empty text) is invalid</narrative><display x="105" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Len(Trim([direction]))&gt;0 AND InStr(&quot;UDLR&quot;,Upper(Left(Trim([direction]),1)))&lt;&gt;0" /><ontrue>f1c40a11-3952-4d71-b1dc-2641b65abd8b</ontrue><onfalse>cbd64b94-820e-490b-8b38-11c90a41a891</onfalse></stage><stage stageid="cbd64b94-820e-490b-8b38-11c90a41a891" name="Invalid Direction Parameter" type="Exception"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><display x="270" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Invalid Direction Parameter" detail="&quot;Direction: '&quot; &amp; [direction] &amp; &quot;' is invalid - it must start with 'U', 'D', 'L' or 'R' (up, down, left or right)&quot;" /></stage><stage stageid="25abe0cc-c834-4b7e-90af-e14cce7ed607" name="Find Next Visible Cell Left/Right" type="Code"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="15" y="120" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="direction" expr="[direction]" /></inputs><outputs><output type="text" name="cellref" stage="cellref" /></outputs><onsuccess>18ec6457-4fe2-424f-b3bf-5b511fe63533</onsuccess><code><![CDATA[
' The initial char of the direction (capitalised)
Dim strDir as String = direction.Trim().Substring(0,1).ToUpper()

' The excel instance
Dim excel as Object = GetInstance(handle)

' The excel enum representing the direction
' Note: setting to zero is just to nix a duff compiler warning
Dim dirn as Integer = 0

' xlDirection enum values from: 
' http://msdn.microsoft.com/en-us/library/bb241212.aspx

' Get the direction we need to go
Select Case strDir
	Case "U"
		dirn = -4162 ' Excel.XlDirection.xlToUp
	Case "D"
		dirn = -4121 ' Excel.XlDirection.xlToDown
	Case "L"
		dirn = -4159 ' Excel.XlDirection.xlToLeft
	Case "R"
		dirn = -4161 ' Excel.XlDirection.xlToRight
	Case Else
		Throw New ArgumentException("Invalid Direction: " & strDir)
End Select

Dim cell as Object = excel.ActiveCell

While True

	' First check the next one along - if that's blank then we're away..
	Dim nextCell as Object = GetNextCell(cell, strDir)

	' If the cell address is the same on moving - that indicates we're
	' at a limit (eg. 1st column going left, last row going down etc.)
	' Just return empty to indicate that there are no blank cells in
	' that direction.
	If cell.Address = nextCell.Address Then
		cellref = ""
		Return
	ElseIf nextCell.EntireColumn.Hidden = False Then ' We've found our blank
		cellref = nextCell.Address(False,False)
		Return
	End If
	
	cell = nextCell
	
	' Quick way (rather than plodding from one cell to the next)
	' is to effectively press the 'End' key - but this is highly
	' inconsistent in what it returns.
	' Go to the 'end' of the range - ie. the last filled cell
	' cell = cell.End(dirn)
	' Now we need to go one beyond, ie. to the next cell
	' cell = GetNextCell(cell, strDir)

End While
]]></code></stage><stage stageid="8cf24ee7-8d98-479f-9e61-d97aa40fa309" name="handle" type="Data"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><display x="-300" y="45" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="800f874a-ddbf-4f6f-9830-936388464ec1" name="activatecell" type="Data"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><display x="-300" y="135" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="c6260059-1fe0-4747-afd0-b9db5ef56d5c" name="Activate Cell?" type="Decision"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="105" y="225" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[activatecell]" /><ontrue>f9bdd041-43a6-49e3-8119-4ec1f2ca5e39</ontrue><onfalse>72282afe-145d-42af-8a22-74c8f34008d5</onfalse></stage><stage stageid="f9bdd041-43a6-49e3-8119-4ec1f2ca5e39" name="Go To Cell" type="SubSheet"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="255" y="225" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Cell Reference" expr="[cellref]" /></inputs><onsuccess>07fd3815-78be-4904-bf0b-981e2ef9a8a5</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="07fd3815-78be-4904-bf0b-981e2ef9a8a5" name="anchor2" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="255" y="285" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>72282afe-145d-42af-8a22-74c8f34008d5</onsuccess></stage><stage stageid="f1c40a11-3952-4d71-b1dc-2641b65abd8b" name="Right or Left?" type="Decision"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><narrative>Direction must start with one of the following:
- U : Indicates 'up'
- D : Indicates 'down'
- L : Indicates 'left'
- R : Indicates 'right'
Any other value (including empty text) is invalid</narrative><display x="105" y="60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="InStr(&quot;L&quot;,Upper(Left(Trim([direction]),1)))&gt;0 OR InStr(&quot;R&quot;,Upper(Left(Trim([direction]),1)))&gt;0" /><ontrue>a309ad98-dce5-40c8-9e45-560f2e769573</ontrue><onfalse>2242eb9a-07b9-438c-b4b3-7aa2b225ede5</onfalse></stage><stage stageid="4b900b0f-bb8e-47ed-a9e2-92b7647c1d40" name="Find Next Visible Cell Up/Down" type="Code"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="195" y="120" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="direction" expr="[direction]" /></inputs><outputs><output type="text" name="cellref" stage="cellref" /></outputs><onsuccess>6b6e0229-60bf-4abe-8ef5-9d80180af1a2</onsuccess><code><![CDATA[
' The initial char of the direction (capitalised)
Dim strDir as String = direction.Trim().Substring(0,1).ToUpper()

' The excel instance
Dim excel as Object = GetInstance(handle)

' The excel enum representing the direction
' Note: setting to zero is just to nix a duff compiler warning
Dim dirn as Integer = 0

' xlDirection enum values from: 
' http://msdn.microsoft.com/en-us/library/bb241212.aspx

' Get the direction we need to go
Select Case strDir
	Case "U"
		dirn = -4162 ' Excel.XlDirection.xlToUp
	Case "D"
		dirn = -4121 ' Excel.XlDirection.xlToDown
	Case "L"
		dirn = -4159 ' Excel.XlDirection.xlToLeft
	Case "R"
		dirn = -4161 ' Excel.XlDirection.xlToRight
	Case Else
		Throw New ArgumentException("Invalid Direction: " & strDir)
End Select

Dim cell as Object = excel.ActiveCell

While True

	' First check the next one along - if that's blank then we're away..
	Dim nextCell as Object = GetNextCell(cell, strDir)

	' If the cell address is the same on moving - that indicates we're
	' at a limit (eg. 1st column going left, last row going down etc.)
	' Just return empty to indicate that there are no blank cells in
	' that direction.
	If cell.Address = nextCell.Address Then
		cellref = ""
		Return
	ElseIf nextCell.EntireRow.Hidden = False Then ' We've found our blank
		cellref = nextCell.Address(False,False)
		Return
	End If
	
	cell = nextCell
	
	' Quick way (rather than plodding from one cell to the next)
	' is to effectively press the 'End' key - but this is highly
	' inconsistent in what it returns.
	' Go to the 'end' of the range - ie. the last filled cell
	' cell = cell.End(dirn)
	' Now we need to go one beyond, ie. to the next cell
	' cell = GetNextCell(cell, strDir)

End While
]]></code></stage><stage stageid="a309ad98-dce5-40c8-9e45-560f2e769573" name="Anchor4" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="15" y="60" w="10" h="10" /><onsuccess>25abe0cc-c834-4b7e-90af-e14cce7ed607</onsuccess></stage><stage stageid="2242eb9a-07b9-438c-b4b3-7aa2b225ede5" name="Anchor4" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="195" y="60" w="10" h="10" /><onsuccess>4b900b0f-bb8e-47ed-a9e2-92b7647c1d40</onsuccess></stage><stage stageid="18ec6457-4fe2-424f-b3bf-5b511fe63533" name="Anchor4" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="15" y="165" w="10" h="10" /><onsuccess>dc26ebf1-6ff1-4b68-9dab-0ea8b33a9520</onsuccess></stage><stage stageid="6b6e0229-60bf-4abe-8ef5-9d80180af1a2" name="Anchor4" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="195" y="165" w="10" h="10" /><onsuccess>dc26ebf1-6ff1-4b68-9dab-0ea8b33a9520</onsuccess></stage><stage stageid="dc26ebf1-6ff1-4b68-9dab-0ea8b33a9520" name="Anchor4" type="Anchor"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="105" y="165" w="10" h="10" /><onsuccess>c6260059-1fe0-4747-afd0-b9db5ef56d5c</onsuccess></stage><stage stageid="cd6b2522-fced-41a3-bef2-8e2aa902ddff" name="Input" type="Block"><subsheetid>780eed4b-ad9e-493d-9b89-fffba93090bd</subsheetid><loginhibit /><display x="-405" y="15" w="210" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6f628393-778b-4a18-809d-0ac57f6f868c" name="Fill Down Value" type="SubSheetInfo"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><narrative>Fill down values in a Column

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- Workbook : Text : workbook name
- Sheetname : Text : Work sheet name
- Cell Range : Text : Cell Range

NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="-285" y="-165" w="300" h="180" /></stage><stage stageid="ccc475ea-c387-4038-8660-5cf9bad6507b" name="Start" type="Start"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><loginhibit /><narrative>Fill visible rows of a column with a single value or single formula

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- Workbook : Text : workbook name
- Sheetname : Text : Work sheet name
- From_CellRef : Text : Cell reference from where value has to be filled
- Column Letter : Text : Column letter in which value has to be filled
- Value : Text : To set cell value
NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="15" y="-150" /><inputs><input type="number" name="handle" narrative="handle of opened workbook" stage="handle" /><input type="text" name="workbook" narrative="workbook name" stage="workbook" /><input type="text" name="Sheetname" narrative="Work sheet name" stage="Sheetname" /><input type="text" name="Cell Range" narrative="Cell Range" stage="Cell Range" /></inputs><onsuccess>9e5a564e-c33a-4c25-ab14-2f1cc8a5ef6b</onsuccess></stage><stage stageid="90a522e3-17f0-43dd-b67e-3d8a004c30b2" name="End" type="End"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="9e5a564e-c33a-4c25-ab14-2f1cc8a5ef6b" name="Activate Workbook" type="SubSheet"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>ecd34b46-a457-4c03-b627-14beb88cc5b6</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="ecd34b46-a457-4c03-b627-14beb88cc5b6" name="Fill Down" type="Code"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><loginhibit /><narrative>FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range("A1").Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try</narrative><display x="15" y="0" w="150" h="30" /><inputs><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[Sheetname]" /><input type="text" name="cell_range" expr="[Cell Range]" /><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>90a522e3-17f0-43dd-b67e-3d8a004c30b2</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, xlsheet1 As Object



wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
xlsheet1 = excel.ActiveSheet

ws.Range(cell_range).FillDown
]]></code></stage><stage stageid="e85607d3-7f40-4a82-8eb0-87c7c2f114f3" name="handle" type="Data"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><display x="-285" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="76107215-a90d-410e-827e-7310641b5f85" name="Sheetname" type="Data"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><display x="-285" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="96a943e7-3c32-490f-bf34-c91d53b382b4" name="workbook" type="Data"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><display x="-285" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27808635-d00d-4908-bf0e-440e15864cfa" name="Parameters" type="Block"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><loginhibit /><display x="-360" y="-60" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f053deae-fa8a-4f47-a9b4-be9b11f6e4aa" name="Cell Range" type="Data"><subsheetid>c7558f33-eb84-4ac2-a02f-f128af01644a</subsheetid><display x="-285" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7b5a49d7-6f34-442f-8032-b51e996fc308" name="Lock Cells" type="SubSheetInfo"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><narrative>Unlocks cells so it can be editted.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="89c7bcdf-efd6-418e-99cc-986b19bab7b2" name="End" type="End"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="823a18ab-a4f5-44af-85d0-cd4d82072e1a" name="Start" type="Start"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel instance." stage="intHandle" /><input type="text" name="Workbook" narrative="Workbook name." stage="txtWorkbook" /><input type="text" name="Worksheet" narrative="Name of worksheet." stage="txtWorksheetName" /><input type="flag" name="Used Range?" narrative="Set to TRUE if cells will be locked for used range." stage="isUsedRange" /><input type="text" name="Range" narrative="OPTIONAL.  This will be used if used range is set to FALSE." stage="txtRange" /></inputs><onsuccess>16a21034-9aa7-4d2d-a093-6cb267f6551a</onsuccess></stage><stage stageid="16a21034-9aa7-4d2d-a093-6cb267f6551a" name="Unlock Cells" type="Code"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="txtWorkbook" expr="[txtWorkbook]" /><input type="text" name="txtWorksheet" expr="[txtWorksheetName]" /><input type="number" name="intHandle" expr="[intHandle]" /><input type="flag" name="isUsedRange" expr="[isUsedRange]" /><input type="text" name="txtRange" expr="[txtRange]" /></inputs><onsuccess>89c7bcdf-efd6-418e-99cc-986b19bab7b2</onsuccess><code><![CDATA[Try
	With GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet)
		.Activate
		If isUsedRange Then
			.UsedRange.Cells.Locked = False
		Else
			.Range(txtRange).Cells.Locked = False
		End If
	End With
Catch ex As Exception
	Throw New Exception("Unable to unlock cells in worksheet " + txtWorksheet + ". Exception detail: " + ex.Message)
End Try]]></code></stage><stage stageid="fec29bd5-b517-4e12-ad8b-61f3e782f415" name="txtWorksheetName" type="Data"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b0b12914-3686-4f3b-b721-88ab50718f06" name="intHandle" type="Data"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><display x="-195" y="-15" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc7d4471-0543-4877-b6ab-598b29175eb4" name="txtWorkbook" type="Data"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><display x="-195" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6c30498f-cd75-43a7-8f32-bbae13b1c412" name="Input" type="Block"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><loginhibit /><display x="-300" y="-45" w="210" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ccc63dbc-3c54-41a1-aa79-d2d2f94cb245" name="txtRange" type="Data"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><display x="-195" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7439a9fa-12e4-4bbd-83c6-4e6d6a78c823" name="isUsedRange" type="Data"><subsheetid>efa8e42f-8787-47f2-8fb4-30a8db17cd15</subsheetid><display x="-195" y="75" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6aa9aa21-02a3-4a17-aebd-56651b7ef152" name="Find all Occurrences" type="SubSheetInfo"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><narrative>Finds all occurences of a value(Partial match or Exact match)   in Excel and returns the cell references in collection</narrative><display x="-195" y="-120" w="150" h="90" /></stage><stage stageid="8df2eb46-8b15-46ef-854f-b2918b9bcc88" name="End" type="End"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="105" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Collection" narrative="Cell references collection" stage="Collection" /><output type="flag" name="Success" narrative="True on success/False on Failure" stage="Success" /><output type="text" name="Message" narrative="Error message if any" stage="Message" /></outputs></stage><stage stageid="c7ee4d7f-b93b-493a-98ea-620827531d96" name="Handle" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef39f4d6-8fba-4621-9840-23b5e71452d3" name="Workbook" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="034c5ae9-9604-45ee-9361-34a6a0c1d2ac" name="Worksheet" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="de162970-ee69-42a3-87f4-ad2637b03a88" name="Start" type="Start"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><narrative>Finds all occurences of a value(Partial match or Exact match)   in Excel and returns the cell references in collection</narrative><display x="105" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Handle of opened workbook" stage="Handle" /><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet name" stage="Worksheet" /><input type="text" name="ValueToFind" narrative="Value to search in excel" stage="ValueToFind" /><input type="text" name="StartCell" narrative="Start of the range. (Ex: A1)" stage="StartCell" /><input type="text" name="EndCell" narrative="End of the range. (Ex: B10)" stage="EndCell" /><input type="flag" name="ExactMatch" narrative="Set as True then Exact match, Set as False then Partial match" stage="ExactMatch" /></inputs><onsuccess>fd6c5eee-bb65-4855-8e31-08a0f0cded4c</onsuccess></stage><stage stageid="fd6c5eee-bb65-4855-8e31-08a0f0cded4c" name="Find all Occurrence" type="Code"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="105" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="ValueToFind" expr="[ValueToFind]" /><input type="text" name="StartCell" expr="[StartCell]" /><input type="text" name="EndCell" expr="[EndCell]" /><input type="flag" name="ExactMatch" expr="[ExactMatch]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="collection" name="Collection" stage="Collection" /></outputs><onsuccess>8df2eb46-8b15-46ef-854f-b2918b9bcc88</onsuccess><code><![CDATA[Dim wb, ws, Rng1,rRng As Object
Dim table As New DataTable()


Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()

Rng1 = ws.Range(StartCell,EndCell)

table.Columns.Add("Cell Reference")

For each rRng in Rng1.Cells
	if ExactMatch  then
		if Trim(rRng.Value) = Trim(ValueToFind) then
			table.Rows.Add(rRng.Address(False,False))
		end if
	Else
		if InStr(UCase(Trim(rRng.Value)),Ucase(Trim(ValueToFind)))>0 then
			table.Rows.Add(rRng.Address(False,False))
		end if
	End if
	
Next

Success = True
Collection=table

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                ws = Nothing
              
End Try]]></code></stage><stage stageid="2f1424c2-4eb3-4841-9aa2-60821d916a7c" name="Success" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="345" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7f661dad-a886-41a9-b5f3-ab03b45d37a1" name="Message" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="345" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7735bb09-5adf-4d43-aae1-bb5bb063d4e1" name="ValueToFind" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="595f36a6-46fe-433e-8c90-134449988dae" name="Collection" type="Collection"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><display x="345" y="45" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="95c481fd-1f4e-40c9-a259-dc6c7f396626" name="Inputs" type="Block"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit /><display x="-195" y="-60" w="180" h="255" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="541fcf05-d24a-4b07-b4f0-1a2604a5a736" name="Outputs" type="Block"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit /><display x="255" y="-60" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="FF99CC" /></stage><stage stageid="151542e2-a707-49e3-b679-fa4ff7bdccbc" name="StartCell" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e52ac68e-a2c5-4fe6-91e4-8cd28b46b873" name="EndCell" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="90" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7baa27ff-c0e7-4a31-8216-2d7f38fbfc31" name="ExactMatch" type="Data"><subsheetid>a048f585-77f1-4e48-bec2-b8849004e1de</subsheetid><display x="-105" y="150" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3e99f97a-aca1-4092-9674-81a851cfce04" name="Open Workbook - InvariantCulture" type="SubSheetInfo"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><narrative>Opens a workbook using the instance specified in the given handle, opening the book represented by the given filename.

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.

Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="613c40af-ef43-4567-8bad-132e6f320089" name="Start" type="Start"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /></inputs><onsuccess>efba7df8-fa93-40f7-8813-a9852ee6770d</onsuccess></stage><stage stageid="0f761ff4-7f73-4780-a361-b0f40544c280" name="End" type="End"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="d36b0fae-3078-419f-a037-eee75a89e4bf" name="Open Workbook - InvariantCulture" type="Code"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="text" name="name" stage="workbookname" /></outputs><onsuccess>898a8b14-6bcf-4b85-bbe8-6ede826645e5</onsuccess><code><![CDATA[
Dim wb as Object = GetInstance(handle).Workbooks.Open(filename)
name = wb.Name
wb.Activate()]]></code></stage><stage stageid="ddcb4387-f85a-4051-b481-5f2e59e3b9b1" name="handle" type="Data"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="8c2e8234-46e7-4b22-ac07-178e96ca191f" name="filename" type="Data"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="efba7df8-fa93-40f7-8813-a9852ee6770d" name="CheckInstanceHandle" type="SubSheet"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>b1ded846-df6e-4c72-bd0c-ade16b614c1f</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="b1ded846-df6e-4c72-bd0c-ade16b614c1f" name="VerifyFileExists" type="SubSheet"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>d36b0fae-3078-419f-a037-eee75a89e4bf</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="ca78d0e9-f0bb-411e-b4c4-184919682456" name="workbookname" type="Data"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4112637b-4442-4a57-93bc-d931226a221d" name="Enable Events" type="Data"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><display x="-210" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="898a8b14-6bcf-4b85-bbe8-6ede826645e5" name="Set Events Enabled" type="SubSheet"><subsheetid>7e204cd3-e43c-495d-b4a7-9f3787d25833</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>0f761ff4-7f73-4780-a361-b0f40544c280</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="afdc7f5d-5ea9-4eac-8e25-973f51d57d74" name="TextToColumns" type="SubSheetInfo"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><narrative>Convert given Text to Column using fixed lenath </narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="c1c6b557-ca57-4bb6-bc9e-ae515c7dbb50" name="Start" type="Start"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Workbook Name" narrative="workbook name after opening workbook" stage="Workbook Name" /><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="Range" narrative="Range to convert text to column" stage="Range" /><input type="text" name="Worksheet Name" narrative="Sheet Name to convert text to column" stage="Worksheet Name" /></inputs><onsuccess>f9361f13-87ec-41f8-b988-e6b21cd2a5bc</onsuccess></stage><stage stageid="fa69227b-7375-43fb-93c3-a02c067fc74e" name="End" type="End"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><loginhibit /><display x="15" y="30" /><outputs><output type="text" name="Message" narrative="Error Message if any" stage="Message" /><output type="flag" name="Success" narrative="Passed/Failed" stage="Success" /></outputs></stage><stage stageid="f9361f13-87ec-41f8-b988-e6b21cd2a5bc" name="TextToColumns" type="Code"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><loginhibit /><narrative>Convert Text To Columns Fixed Width</narrative><display x="15" y="-45" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[Workbook Name]" /><input type="text" name="worksheetname" expr="[Worksheet Name]" /><input type="text" name="range" expr="[Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>fa69227b-7375-43fb-93c3-a02c067fc74e</onsuccess><code><![CDATA[Dim wb as Object = GetWorkbook(handle,workbookname)
Dim ws as Object = GetWorksheet(handle,workbookname,worksheetname)
Dim excel as Object = wb.Application 

Try

wb.Activate()
ws.Activate()
excel.DisplayAlerts = False 

ws.Range(range).TextToColumns(,2 , , , , , , , , , , , ,)
Success = True

Catch e As Exception

Success = False
Message = e.Message

End Try]]></code></stage><stage stageid="9c482815-e095-461f-8483-987012700a0e" name="handle" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-240" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ec1d9287-d759-473b-96c7-e1a05c2b4c50" name="Workbook Name" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="351ea4f4-0276-44c6-a066-04802a3fb7b3" name="Success" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-180" y="75" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="72786810-2be4-4cfe-8bd0-4b1c6449925d" name="Message" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-255" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="083b0fb0-7943-4541-9308-1d726d854d7e" name="Worksheet Name" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-180" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4e9534cc-e03e-4b24-ba68-92243337839f" name="Range" type="Data"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-255" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0192ed47-64b8-49b4-8450-3bb65e8bc040" name="Parameters" type="Block"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><display x="-300" y="-45" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="44b02f0f-2630-4177-860f-294cba96dc1d" name="TextToColumns" type="Block"><subsheetid>0a0d31c5-bf94-413f-9554-fec5ccbb59c5</subsheetid><loginhibit /><display x="-45" y="-75" w="180" h="75" /><font family="Segoe UI" size="10"