name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Cell Reference]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="flag" name="Flag" stage="Flag" /></outputs><onsuccess>7dea9517-f710-4a6e-b441-e1025f076f3c</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object
Dim Temp

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference)
'For Each o In sheet
'       o.DrawingObjects.Select
  '      Excel.Selection.Delete
   ' Next o
'ws.Shapes.SelectAll()
Temp = ws.Pictures.Count
'MsgBox(Temp)

if Temp>0 then
                ws.Shapes.SelectAll()
                Excel.Selection.Delete
                Flag = true
else
                Flag = false
end if

Success = True

Catch e As Exception
Success = False
Message = e.Message
Finally
wb = Nothing
ws = Nothing
excel = Nothing
sheet = Nothing
range = Nothing
End Try]]></code></stage><stage stageid="0e6a93b0-5884-4f39-aa86-74df314f44a7" name="End" type="End"><subsheetid>0ea22ff7-36c1-4644-a2ea-399bd9497c90</subsheetid><loginhibit onsuccess="true" /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Flag" narrative="Returns 'True' if the objects were removed successfully; 'False' in case of failure." stage="Flag" /></outputs></stage><stage stageid="7dea9517-f710-4a6e-b441-e1025f076f3c" name="Success?" type="Decision"><subsheetid>0ea22ff7-36c1-4644-a2ea-399bd9497c90</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>0e6a93b0-5884-4f39-aa86-74df314f44a7</ontrue><onfalse>54ad433f-bdbe-4b67-b552-8e1ef766a85c</onfalse></stage><stage stageid="54ad433f-bdbe-4b67-b552-8e1ef766a85c" name="Exception" type="Exception"><subsheetid>0ea22ff7-36c1-4644-a2ea-399bd9497c90</subsheetid><loginhibit onsuccess="true" /><display x="120" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Failed to select row: &quot; &amp; [Message]" /></stage><stage stageid="6468f621-efa2-473c-9b44-3a0fff7df759" name="Handle" type="Data"><subsheetid>0ea22ff7-36c1-4644-a2ea-399bd9497c90</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcaf4c52-0c64-4e6e-9961-255870756820" name="Workbook" type="Data"><subsheetid>0ea22ff7-36c1-4644-a2ea-399bd9497c90</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="900463c7-5