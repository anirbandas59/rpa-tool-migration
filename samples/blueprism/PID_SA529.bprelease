"Start"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="-135" /><inputs><input type="collection" name="Input Collection 1" narrative="Collection 1 Name" stage="input_collection1" /><input type="collection" name="Input Collection 2" narrative="Collection 2 Name" stage="input_collection2" /><input type="text" name="Column Name" narrative="Name of the column to be compared " stage="Column_Name" /></inputs><onsuccess>1dd85246-bfe0-4e11-b89a-5d7cb6cfa845</onsuccess></stage><stage stageid="aaf083a7-4c98-4356-9baf-7a459d18d0ff" name="End" type="End"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="60" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection Name" stage="output_collection" /></outputs></stage><stage stageid="1dd85246-bfe0-4e11-b89a-5d7cb6cfa845" name="Compare Collection" type="Code"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="-45" w="90" h="60" /><inputs><input type="collection" name="input_collection1" expr="[input_collection1]" /><input type="collection" name="input_collection2" expr="[input_collection2]" /><input type="text" name="column_name" expr="[Column_Name]" /></inputs><outputs><output type="collection" name="output_collection" stage="output_collection" /></outputs><onsuccess>aaf083a7-4c98-4356-9baf-7a459d18d0ff</onsuccess><code><![CDATA[Dim aRowData As String

Dim bRowData As String

Dim temp As Integer 

output_collection = new DataTable()

output_collection.Columns.Add(column_name, GetType(String))

For Each aRow as DataRow In input_Collection1.Rows
temp = 0
aRowData = CStr(aRow(column_name))

For Each bRow As DataRow In input_collection2.Rows

bRowData = CStr(bRow(column_name))

If bRowData.contains(aRowData) Then
temp = 1
end if

Next
If temp = 0 then
output_collection.Rows.Add(new Object() {aRowData})
end if


Next

]]></code></stage><stage stageid="741b8493-626d-4f3d-a856-8f79d652ee58" name="output_collection" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><display x="-60" y="0" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="d49c6a3b-a373-415b-aeb8-44c54be436bb" name="input_collection1" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-225" y="-15" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="66be3f08-3928-4c7d-bfcb-797cecbce10c" name="input_collection2" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-225" y="30" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="e61c44c5-6eb4-47a2-95bd-f6132f39a224" name="Column_Name" type="Data"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><display x="-225" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="87010318-e5a5-4750-be07-0835ba6d112e" name="Input Parameters" type="Block"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-285" y="-45" w="135" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="66b424f5-547f-4352-a19b-b55eb216ecfb" name="Output Parameters" type="Block"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-120" y="-45" w="120" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="64a31e51-f13b-43cb-8567-0ccb5176a8fc" name="Recover" type="Recover"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-405" y="-30" /><onsuccess>e0bc8874-0327-43b4-ac05-5f1f4ead9e7a</onsuccess></stage><stage stageid="e0bc8874-0327-43b4-ac05-5f1f4ead9e7a" name="Exception" type="Exce