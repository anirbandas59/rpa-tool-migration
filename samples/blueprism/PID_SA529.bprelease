b8acfbdcc" name="Input Parameters" type="Block"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><loginhibit /><display x="-585" y="-150" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9fdd1ea2-ad2b-4f92-bf4e-f1c26e5d81a5" name="Output Parameters" type="Block"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><loginhibit /><display x="-585" y="30" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="89533d36-872a-4335-9623-1c45bb763e86" name="Recover" type="Recover"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><loginhibit /><display x="-105" y="-195" /><onsuccess>87bf348d-d238-4df1-abb7-8996e207453f</onsuccess></stage><stage stageid="87bf348d-d238-4df1-abb7-8996e207453f" name="Exception" type="Exception"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><display x="-105" y="-150" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="e956e4bb-adb3-49f7-939d-8b18c746d9e0" name="Fill empty cells" type="Code"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><loginhibit /><display x="-255" y="-165" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[Handle]" /><input type="text" name="workbookname" expr="[Workbook]" /><input type="text" name="worksheetname" expr="[Worksheet]" /><input type="text" name="range" expr="[Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>c171f44f-30f4-4070-a81f-2451f0b93ae2</onsuccess><code><![CDATA[Dim ws as object
Try
ws  = GetWorkSheet(handle,workbookname,worksheetname,False)
ws.Range(range).SpecialCells(4).FormulaR1C1 = "=R[-1]C" 
Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
	ws = Nothing
End Try]]></code></stage><stage stageid="702bfad6-52e3-44ec-9e24-2098e8a99679" name="Workbook" type="Data"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><display x="-495" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="36900ba7-27f0-48bb-bf3b-1aa29ea82af8" name="Worksheet" type="Data"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><display x="-495" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="03fadbde-d881-4f07-b4f6-87cfe1aca0b0" name="Range" type="Data"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><display x="-495" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="85734dca-7852-45c7-bf37-1ec8bc5d4e1e" name="Update Pivot Input - Slicer" type="SubSheetInfo"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><narrative>Custom command for inputting Pivot Slicer input</narrative><display x="-210" y="-150" w="150" h="90" /></stage><stage stageid="0ac6830e-83a6-4165-96af-a484f0ace59e" name="Start" type="Start"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><loginhibit /><display x="30" y="-240" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="WB" narrative="WB" stage="WB" /><input type="text" name="WS" narrative="WS" stage="WS" /><input type="text" name="Code" narrative="Pivot Input Code" stage="Code" /></inputs><onsuccess>3a72e60a-ead4-4a68-8dbc-9a2ec7ca04e2</onsuccess></stage><stage stageid="7a5ffdd8-cd76-435d-a2ba-566e4e663733" name="End" type="End"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><loginhibit /><display x="30" y="-90" /><outputs><output type="flag" name="Success" narrative="SucessCheck" stage="Success" /><output type="text" name="Message" narrative="Output MEssage" stage="Message" /></outputs></stage><stage stageid="e73d18c9-c2cc-4089-98f0-77ebfd602e2e" name="handle" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="15" y="-315" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0f7523c5-9791-4c7a-bc07-c25e44cfb6e1" name="WB" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="90" y="-315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9ca189c5-5896-440a-b99f-8ccd065e0ba2" name="Code" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="-105" y="-315" w="150" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3a72e60a-ead4-4a68-8dbc-9a2ec7ca04e2" name="Update Pivot Inputs" type="Code"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><loginhibit onsuccess="true" /><display x="30" y="-180" w="90" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[WB]" /><input type="text" name="Worksheet" expr="[WS]" /><input type="text" name="Code" expr="[Code]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>7a5ffdd8-cd76-435d-a2ba-566e4e663733</onsuccess><code><![CDATA[Dim wb,ws,sheet,excel,mod1 As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

mod1 = wb.VBProject.VBComponents.Add(1)
mod1.CodeModule.AddFromString(Code)

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
               
End Try]]></code></stage><stage stageid="2da312fb-0a0e-4776-98cd-c803580a44a0" name="Success" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="120" y="-180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b9646350-b4dd-4d50-a387-450d05974b12" name="Message" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="-60" y="-180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="398807e7-1db3-4f4c-9bfd-75e967a29b39" name="WS" type="Data"><subsheetid>621023c0-2900-4758-af11-e5efc528c054</subsheetid><display x="165" y="-315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0090a20f-8c82-47cb-a260-381a79e04a49" name="Remove empty rows - fast" type="SubSheetInfo"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><narrative>removes the rows using fast method from code</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="9a7215fe-1f05-4f12-8a4b-e1f264a4ae4e" name="Start" type="Start"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="specify the handle" stage="handle" /></inputs><onsuccess>a43aa3d8-8b16-49bd-9b1d-4f15c4736741</onsuccess></stage><stage stageid="d9e6e406-5c75-4dba-94fe-ee4307c6fbf1" name="End" type="End"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="a43aa3d8-8b16-49bd-9b1d-4f15c4736741" name="Remove rows - fast" type="Code"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>d9e6e406-5c75-4dba-94fe-ee4307c6fbf1</onsuccess><code><![CDATA[Dim worksheet As Object
worksheet = GetWorkbook(handle,Nothing).ActiveSheet

Try
Const xlCellTypeBlanks As Integer = 4
worksheet.Columns("A:A").SpecialCells(xlCellTypeBlanks).EntireRow.Delete
Catch e As Exception
End Try]]></code></stage><stage stageid="d20ee6cc-06e8-4dec-89a1-6370a71f26d9" name="handle" type="Data"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><display x="-285" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ee206a54-52ef-4b3b-965b-9aec28c12265" name="Block13" type="Block"><subsheetid>444c4c29-a9d7-45a8-9b17-dd0ac7951e7a</subsheetid><loginhibit /><display x="-345" y="-15" w="105" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="101d0741-e1c8-4bec-bde4-93014567ab81" name="Convert text to Number " type="SubSheetInfo"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><narrative>To convert the rows to general in which numeric values are present</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e0112a83-9e3f-4ba5-9a0a-3c0949a76c20" name="Start" type="Start"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="135" y="-105" /><inputs><input type="number" name="handle" narrative="Handle Instance" stage="handle" /><input type="text" name="Workbook Name" narrative="Name of the Workbook" stage="Workbook Name" /><input type="text" name="WorkSheet Name" narrative="Sheet Name in which Name conversion needs to be created" stage="WorkSheet Name" /><input type="text" name="Start_Cell" narrative="Start Cell Ref value" stage="Start_Cell" /><input type="text" name="End_Cell" narrative="End Cell Ref value" stage="End_Cell" /><input type="number" name="lastRow" narrative="last valid row number" stage="lastRow" /></inputs><onsuccess>7815e1d3-1856-4c01-adc1-836f706c6579</onsuccess></stage><stage stageid="1dcc5f6d-488b-4926-aa40-641d7a37b7c9" name="End" type="End"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="135" y="90" /></stage><stage stageid="9c5cc422-a0f3-44fb-9886-e6b12ffd6768" name="Change text to number" type="Code"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="135" y="15" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[WorkSheet Name]" /><input type="number" name="lastRow" expr="[lastRow]" /><input type="text" name="Start_Cell" expr="[Start_Cell]" /><input type="text" name="End_Cell" expr="[End_Cell]" /></inputs><onsuccess>1dcc5f6d-488b-4926-aa40-641d7a37b7c9</onsuccess><code><![CDATA[Dim wb, ws, temp As Object


wb = GetWorkbook (Handle, Workbook)
ws = GetWorkSheet (Handle, Workbook, Worksheet)


With ws.Range((Start_Cell & ":" & End_Cell) & (lastRow))
            .EntireColumn.NumberFormat = "General"
             temp = .Value
			.Value = temp
        End With

wb = Nothing
ws = Nothing]]></code></stage><stage stageid="fe171e80-0814-4866-b3eb-7b0a35f5530e" name="handle" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><display x="-195" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7312c28-cd87-4e78-b1be-461c7f33000b" name="Workbook Name" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><display x="-195" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="349b5348-ddf0-4c4d-aaba-b658d130956f" name="WorkSheet Name" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aaa1ee15-6cda-4f4a-898c-f343e98a2439" name="lastRow" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="-195" y="90" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="16a4a17e-5af2-4707-a76e-2d35aa59925f" name="Start_Cell" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="-195" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="db3c114a-80e4-4d62-b5d7-f9bab1f83612" name="End_Cell" type="Data"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="-195" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7815e1d3-1856-4c01-adc1-836f706c6579" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>38758fe9-81b9-4d24-8106-500a62bf9d12</subsheetid><loginhibit /><display x="135" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer represent