Dim rng1 As Object
Dim rng2 As Object

wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)

 rng1 = sh.Range((Start_Cell & ":" & End_Cell) & (lastRow))
        For Each rng2 In rng1.Rows
		If (Len(Trim(rng2.Value2)) > 0 And rng2.Value2 <> "Range Name Label") Then
		wb.Worksheets(sh.Name).Names.Add(Name:=rng2.Value2, RefersTo:="='" & sh.Name & "'!$" & Target_Column_1 & "$" & rng2.Row & ":$" & Target_Column_2 & "$" & rng2.Row)
		End If
         Next

wb = Nothing
sh = Nothing]]></code></stage><stage stageid="ddcc6e89-d5c6-45fb-a93e-5829d85ae154" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="0" y="-60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[Workbook Name]" /></inputs><onsuccess>7e712536-365e-4612-8ab6-773f6dc55d0c</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="4ae2fd38-a991-4923-9a4f-3e7e16b2e978" name="Start" type="Start"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="0" y="-120" /><inputs><input type="number" name="handle" narrative="Specify handle" stage="handle" /><input type="text" name="Workbook Name" narrative="Specify Workbook Name" stage="Workbook Name" /><input type="text" name="WorkSheet Name" narrative="Specify WorkSheet Name" stage="WorkSheet Name" /><input type="text" name="Start_Cell" narrative="Specify the start cell" stage="Start_Cell" /><input type="text" name="End_Cell" narrative="Specify the end cell" stage="End_Cell" /><input type="text" name="Target_Column_1" narrative="Specify Target_Column_1" stage="Target_Column_1" /><input type="text" name="Target_Column_2" narrative="Specify Target_Column_2" stage="Target_Column_2" /><input type="number" name="lastRow" narrative="Specify the last row" stage="lastRow" /></inputs><onsuccess>ddcc6e89-d5c6-45fb-a93e-5829d85ae154</onsuccess></stage><stage stageid="1e93fbdb-c320-476e-92ec-1c361758b662" name="TextToColumn - Fixed Width" type="SubSheetInfo"><subsheetid>f087429c-f9c7-4cca-84b4-6610f74569c6</subsheetid><narrative>TextToColumn - Fixed Width</narrative><display x="-285" y="-165" w="270" h="90" />