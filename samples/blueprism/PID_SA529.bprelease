rrative="The name of the file to check" expr="[Output File Path]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the file exists" stage="File_Exist" /></outputs><onsuccess>cba5c658-969e-49c8-b217-bff510967f52</onsuccess><resource object="Utility - File Management" action="File Exists" /></stage><stage stageid="5d1c9edd-e039-4735-a06b-1ef12ea384ce" name="File_Exist" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-600" y="30" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9ceab511-f5f7-4870-a4b3-10c85bedd637" name="Set_Error Message" type="Calculation"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="225" /><onsuccess>6a73bf5f-576a-44df-85eb-1c0a44bf5da4</onsuccess><calculation expression="&quot;Downloaded Failed.Check if you have access and File is available in location &quot; &amp; [Error_Message]" stage="Error_Message" /></stage><stage stageid="955b63ab-0f56-418f-9543-d042b004bdf1" name="ScriptLocation" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="-135" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8381072e-b489-40ef-8bea-4782aab8102c" name="Delete_Script" type="Action"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="105" y="225" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>534f9f38-edcd-4cce-827d-a499969e71d5</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="aa232148-5fba-4a97-8d87-26cb4f2833c9" name="File Path" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><narrative>Downloaded File complete path</narrative><display x="-435" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="72a0d09d-b17b-4568-8e0b-5e9270199d32" name="Get Default Script Path" type="SubSheet"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="-180" w="90" h="30" /><inputs><input type="text" name="Script_Loc" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="Default Script Path" stage="ScriptLocation" /></outputs><onsuccess>4ba7a52e-911a-43a2-ba2a-1fd18992e688</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="38f28c91-46e0-42f1-9320-88cc7e63364d" name="Output File Path" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="-45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="80209940-cae5-4631-84c1-0dde37f9ba46" name="PowerShellGetAllFile" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><loginhibit /><display x="-435" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$outputfile= "_RPA_outputfile_RPA_"
$baseURL = "_RPA_baseURL_RPA_"
$FolderServerRelativeURL = "_RPA_Relative URLRPA_"

Connect-PnPOnline -AccessToken "__ACCESSTOKEN__" -Url $baseURL 

if($FolderServerRelativeURL.Contains("/Forms/AllItems.aspx"))
{$SourceName=$FolderServerRelativeURL.Replace("/Forms/AllItems.aspx", "")
$Folder = $SourceName}
else{
$Folder = Get-PnPFolder -Url $FolderServerRelativeURL -Includes ListItemAllFields.ParentList
$SourceName = $Folder.ListItemAllFields.ParentList}

if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }
Else{ New-Item $outputfile -ItemType File -ErrorAction stop }
Add-Content  $outputfile -Value "File ID,File Name,Relative Path,Created,Modified"

Get-PnPListItem -List $SourceName -Fields("FSObjType","ID","FileLeafRef","FileDirRef","Created","Modified").FieldValues -PageSize 500 -ScriptBlock { 
Param($items) foreach($itm in $items) {
$ParentFolder=Split-Path -Path $itm.FieldValues["FileDirRef"] -Leaf 
$ParentFolder=Split-Path -Path $itm.FieldValues["FileDirRef"] -Leaf 
if($itm.FieldValues["FSObjType"] -eq "0" -and $itm.FieldValues["FileDirRef"].Contains($Folder.Name))
{ 
$str = $itm.FieldValues["ID"].ToString() + "," + $itm.FieldValues["FileLeafRef"] + "," +   $itm.FieldValues["FileDirRef"]+ "," +   $itm.FieldValues["Created"] + "," +   $itm.FieldValues["Modified"] ;  Add-Content  $outputfile $str ;}}}

</initialvalue><private /><alwaysinit /></stage><stage stageid="4ba7a52e-911a-43a2-ba2a-1fd18992e688" name="Replace" type="MultipleCalculation"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="-120" w="90" h="30" /><onsuccess>1eb7ac0e-1dc8-4aa8-a25e-440fa1f4c5f7</onsuccess><steps><calculation expression="Replace([PowerShellGetAllFile],  &quot;_RPA_Relative URLRPA_&quot; , [Folder Relative URL])" stage="PowerShellGetAllFile" /><calculation expression="Replace(  [PowerShellGetAllFile] , &quot;_RPA_baseURL_RPA_&quot; , [Base URL])" stage="PowerShellGetAllFile" /><calculation expression="Replace(  [PowerShellGetAllFile] ,  &quot;_RPA_outputfile_RPA_&quot; , [Output File Path] )" stage="PowerShellGetAllFile" /><calculation expression="Replace(  [PowerShellGetAllFile] ,  &quot;__ACCESSTOKEN__&quot; , [AccessToken] )" stage="PowerShellGetAllFile" /><calculation expression="[PowerShellGetAllFile]" stage="Script" /></steps></stage><stage stageid="177c9291-ce95-42ae-9f0f-e1f98223dd29" name="Base URL" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="985e9898-9b73-4e4b-aac5-02fbbc6d9707" name="Folder Relative URL" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="-75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="384faac0-1a20-414f-9802-e0bec151fb95" name="Block1" type="Block"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><loginhibit /><display x="-285" y="30" w="315" h="495" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="64e973a0-0e23-427f-b174-7497cc2b0aba" name="Input" type="Block"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><loginhibit /><display x="-510" y="-165" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f2f91780-1c87-4483-a783-564fc3bc0cb2" name="Standards" type="Note"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><narrative>This action downloads all the files form th under folder  recursively including sub folder files

Considering to download the files from "https://eu001-sp.shell.com/sites/AAFAA4973/TMST/Operations/Wireline"

Folder Relative URL: Includes Library and sub folder ( Example:- Operations/Wireline)

Base URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAFAA4973/TMST)

************************************************************************************************
To Download the all the files at the Library level please append the "/Forms/AllItems.aspx" to the libraray

Example :Operations/Forms/AllItems.aspx

</narrative><display x="-810" y="-45" w="240" h="240" /><font family="Segoe UI" size="10" style="Regular" color="0000FF" /></stage><stage stageid="8c8aa634-0eeb-4d2d-86fa-6eb1dc86baa1" name="Script" type="Block"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><loginhibit /><display x="-510" y="0" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1ed4b881-9f4a-4b88-acd2-55fb7a4f0776" name="Delete all files in folder including Subfolders (Recursive)" type="SubSheetInfo"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><narrative>Deletes the entire folder structure including sub-folders and files</narrative><display x="-270" y="-105" w="150" h="90" /></stage><stage stageid="7b0f5b74-da02-45ac-8cd8-4f297eeb9c9a" name="Start" type="Start"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="15" y="-210" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location." stage="SP_Lib_Folder_Path" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Folders to Omit" narrative="Specify folders that need to be omitted from the deletion of files within it. Specify &quot;,&quot; as a seperator between each folder" stage="Folder to Omit" /></inputs><onsuccess>623cf50f-9961-406a-a10c-b3b107ac2e83</onsuccess></stage><stage stageid="91587cca-33a6-4931-83f4-1332e76b51f9" name="End" type="End"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="435" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="4442aa8a-84d0-4d08-bdcc-f7375927ea4f" name="Return Message" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-285" y="180" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f371f382-8cee-43f3-9cfd-55e1969a6fe4" name="Build Script" type="Calculation"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="-15" /><onsuccess>8b7059dd-f46b-4d65-a621-16426c0b9fe5</onsuccess><calculation expression="&quot;#Parameters&quot;&amp;NewLine()&amp;&quot;&#xA;$SiteURL = &quot;&amp;Chr(34)&amp;[SP_Site_URL]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FolderSiteRelativeURL = &quot;&amp;Chr(34)&amp;[SP_Lib_Folder_Path]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$folders_to_omit = &quot;&amp;Chr(34)&amp;[Folder to Omit]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$folderarray = $folders_to_omit.Split(',')&quot;&amp;NewLine()&amp;&quot;&#xA;#Connect to the Site&quot;&amp;NewLine()&amp;&quot;&#xA;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -URL $SiteURL -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&quot;&#xA;#Get the web &amp; folder&quot;&amp;NewLine()&amp;&quot;&#xA;$Web = Get-PnPWeb&quot;&amp;NewLine()&amp;&quot;&#xA;$Folder = Get-PnPFolder -Url $FolderSiteRelativeURL&quot;&amp;NewLine()&amp;&quot;&#xA;#Function to delete all Files and sub-folders from a Folder&quot;&amp;NewLine()&amp;&quot;&#xA;Function Empty-PnPFolder([Microsoft.SharePoint.Client.Folder]$Folder)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;    #Get the site relative path of the Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    If($Web.ServerRelativeURL -eq '/')&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        $FolderSiteRelativeURL = $Folder.ServerRelativeUrl&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    Else&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;    &#xA;        $FolderSiteRelativeURL = $Folder.ServerRelativeUrl.Replace($Web.ServerRelativeURL,[string]::Empty)&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    #Delete all files in the Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    $Files = Get-PnPFolderItem -FolderSiteRelativeUrl $FolderSiteRelativeURL -ItemType File&quot;&amp;NewLine()&amp;&quot;&#xA;    ForEach ($File in $Files)&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        #Delete File&quot;&amp;NewLine()&amp;&quot;&#xA;        Remove-PnPFile -ServerRelativeUrl $File.ServerRelativeURL -Force -Recycle&quot;&amp;NewLine()&amp;&quot;       &#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;    #Process all Sub-Folders&quot;&amp;NewLine()&amp;&quot;&#xA;    $SubFolders = Get-PnPFolderItem -FolderSiteRelativeUrl $FolderSiteRelativeURL -ItemType Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    Foreach($SubFolder in $SubFolders)&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        #Exclude requried folders&quot;&amp;NewLine()&amp;&quot;&#xA;        If(($folderarray -notcontains $SubFolder.Name))&quot;&amp;NewLine()&amp;&quot;&#xA;        {&quot;&amp;NewLine()&amp;&quot;&#xA;            #Call the function recursively&quot;&amp;NewLine()&amp;&quot;&#xA;            Empty-PnPFolder -Folder $SubFolder&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;        }&quot;&amp;NewLine()&amp;&quot; &#xA;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;#Call the function to empty folder&quot;&amp;NewLine()&amp;&quot;&#xA;Empty-PnPFolder -Folder $Folder&quot;&#xA; &#xA;" stage="Script" /></stage><stage stageid="27d0cad1-1d93-4c26-88d0-7f4df66fe043" name="Script" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6d21891d-aebc-4a97-b269-44c56cacdf36" name="SP_Site_URL" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><narrative>Link for site or subsite.</narrative><display x="-285" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eeeb0c3b-7414-46ee-a6d5-eed36050d329" name="SP_Lib_Folder_Path" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-285" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="20bedc73-67b0-449b-a544-b06cc54b62be" name="Run PnP_Script" type="SubSheet"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="165" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>09148024-3273-4bed-9890-260d43e53a40</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="0787340a-9f43-41b8-aafd-eef16424bbae" name="Script Path" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-180" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5d2bb354-e56b-421a-bc1b-8e1303476607" name="Delete_Script" type="Action"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="375" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>91587cca-33a6-4931-83f4-1332e76b51f9</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="8b7059dd-f46b-4d65-a621-16426c0b9fe5" name="Generate_PnPScript" type="SubSheet"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_delete_files&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>20cf1c1a-90f6-4f1b-9bc3-1945f7a7574c</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="f1157214-6738-44d0-a6ed-165be2217cb1" name="Input" type="Block"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-345" y="-45" w="120" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0a75a0ab-49d8-40df-b553-7b4e7ff36c5e" name="Output" type="Block"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-345" y="135" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0ede3e2b-8546-4eeb-8657-94dbb1a6d51d" name="Inhouse" type="Block"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-210" y="-45" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="20cf1c1a-90f6-4f1b-9bc3-1945f7a7574c" name="Check_Error" type="Decision"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="105" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>f9007db8-4992-4c74-a74a-0c093060e9f5</ontrue><onfalse>20bedc73-67b0-449b-a544-b06cc54b62be</onfalse></stage><stage stageid="f9007db8-4992-4c74-a74a-0c093060e9f5" name="Exception while creating  Script" type="Exception"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="135" y="105" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="09148024-3273-4bed-9890-260d43e53a40" name="Check Process_Exist" type="Action"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="210" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>4cef26eb-5ad2-4856-957b-b930b417c601</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="209c17df-8a32-4905-aa46-e3b7e9446f1f" name="Exists" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-135" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cef26eb-5ad2-4856-957b-b930b417c601" name="ProcessExist?" type="Decision"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="270" /><decision expression="[Exists]=True" /><ontrue>e1fee55d-c3b0-494e-bc70-fc16e3999b99</ontrue><onfalse>90f85652-497d-4a50-913f-88a3e3e6d298</onfalse></stage><stage stageid="dc75d58f-8feb-4d04-a6dc-531bb798db2d" name="Temp_Retry" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-180" y="75" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="90f85652-497d-4a50-913f-88a3e3e6d298" name="Anchor8" type="Anchor"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="120" y="270" w="10" h="10" /><onsuccess>6e604d42-4ddb-4698-973d-45e1e6bb23bb</onsuccess></stage><stage stageid="e1fee55d-c3b0-494e-bc70-fc16e3999b99" name="Kill Process" type="Action"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="315" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>5d2bb354-e56b-421a-bc1b-8e1303476607</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="6e604d42-4ddb-4698-973d-45e1e6bb23bb" name="Anchor9" type="Anchor"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="120" y="375" w="10" h="10" /><onsuccess>5d2bb354-e56b-421a-bc1b-8e1303476607</onsuccess></stage><stage stageid="4560f0ac-6edc-400e-a3aa-ba491d0a51db" name="Run_Status" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-180" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a08ec48-4c58-4afd-af25-89cc997e25a8" name="Error_Message" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-300" y="240" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be58248e-923c-40ed-aa5a-cf36675db5bc" name="Unexpected exception recover" type="Recover"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="345" y="195" /><onsuccess>3d94bda5-3143-40a9-859b-5615f95179e4</onsuccess></stage><stage stageid="ce94f545-b880-4352-a3ed-685b499d29bb" name="Unexpected Exception" type="Exception"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="495" y="195" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="c5612a58-2b49-4a78-948e-06791dd8c73b" name="Script_Loc" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-120" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3d94bda5-3143-40a9-859b-5615f95179e4" name="Delete_Script" type="Action"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="420" y="195" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ce94f545-b880-4352-a3ed-685b499d29bb</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="faab997d-d0e8-4939-972b-d822d50aab98" name="Validate Temp Script Path" type="SubSheet"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>f371f382-8cee-43f3-9cfd-55e1969a6fe4</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="1a3a099b-e4e1-43ae-902d-f15491b048c9" name="Remove / in URL" type="SubSheet"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="URL" friendlyname="URL" narrative="URL" expr="[SP_Lib_Folder_Path]" /></inputs><outputs><output type="text" name="URL" friendlyname="URL" narrative="URL" stage="SP_Lib_Folder_Path" /></outputs><onsuccess>faab997d-d0e8-4939-972b-d822d50aab98</onsuccess><processid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</processid></stage><stage stageid="31d76df8-ee8b-45ce-800e-42ca05b379f3" name="Folder to Omit" type="Data"><subsheetid>9c0d3b1a-daf9-4598-89bf-9db913cbdca3</subsheetid><display x="-285" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1f3705e-be56-4d3e-944b-ee9769ef234e" name="Get All Latest Files W.r.t File Created Time Large data" type="SubSheetInfo"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><narrative>Get All Latest Files W.r.t File Created Time Large data</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="5cd30db5-4e11-4643-a975-06d460ca4cbc" name="Return Message" type="Data"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-300" y="270" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="737c3da3-f198-43ba-9bbc-a24c428af581" name="Generate Script" type="Calculation"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-45" y="-105" /><onsuccess>f3c5381c-92d1-4bcd-8197-3965f79c150b</onsuccess><calculation expression="&quot;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url &quot;&quot;&quot; &amp;[SharePoint URL]&amp;Chr(34)&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&quot;&#xA;$results = @()&quot;&amp;NewLine()&amp;&quot;&#xA;$ExportFile = &quot;&quot;&quot;&amp;[Destination Latest Excel Name Folder Path]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$now= (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;').AddDays(&quot;&amp;[AddDays]&amp;&quot;).AddHours(&quot;&amp;[AddHours]&amp;&quot;).AddMinutes(&quot;&amp;[AddMinutes]&amp;&quot;).AddSeconds(&quot;&amp;[AddSeconds]&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;')&quot;&amp;NewLine()&amp;&quot;    &#xA;        $allItems = Get-PnPListItem -List '&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;' -PageSize 500 &quot;&amp;NewLine()&amp;&quot;&#xA;    &#xA;    foreach($item in $allItems){&quot;&amp;NewLine()&amp;&quot;&#xA;if ($item -ne $null)&#xA; {&quot;&amp;NewLine()&amp;&quot;&#xA;    if ($item[&quot;&quot;FileLeafRef&quot;&quot;] -like &quot;&quot;*.*&quot;&quot; -and ([DateTime]$item[&quot;&quot;Created&quot;&quot;] -gt $now -And [DateTime]$item[&quot;&quot;Created&quot;&quot;] -lt $currentDt)) &quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        $results += [PSCustomObject][ordered]@{&quot;&amp;NewLine()&amp;&quot;&#xA;            FileName    = $item[&quot;&quot;FileLeafRef&quot;&quot;] &quot;&amp;NewLine()&amp;&quot;&#xA;                       TimeCreated = [DateTime]$item[&quot;&quot;Created&quot;&quot;]&quot;&amp;NewLine()&amp;&quot;&#xA;            &#xA;            FilePath    = $item[&quot;&quot;FileRef&quot;&quot;]&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$results | Select FileName, TimeCreated | ConvertTo-Csv -NoTypeInformation | Select-Object -Skip 1 |Set-Content -Path $ExportFile &quot;" stage="Script" /></stage><stage stageid="3befc555-0739-42a4-8bf5-a93adadf093b" name="Script" type="Data"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-300" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3a670174-efbf-4a2b-b4fc-80679c310af4" name="Success" type="Data"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-300" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2784e1f-9fa0-4b98-a45e-7f0e0c662ec6" name="Standards" type="Note"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

 

