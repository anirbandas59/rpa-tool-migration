alue /><private /><alwaysinit /></stage><stage stageid="1fde1946-c1c2-4e50-89db-574ba56aadee" name="Return Message" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07e5bd6e-a372-443a-8662-f11beea9e983" name="Script Path" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="22f2c2cc-3c63-407f-90bd-86059d358619" name="Error_Message" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="454330eb-1c31-4ed1-8d4c-6b3897fc6010" name="Run Report" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b76b4f8-4a99-4cf6-801b-33147447d78b" name="P_Exists" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5f83467-d234-4414-b1e8-8f954b567245" name="Standards" type="Note"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list.(Unique Column to be prefered )

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://abc-sp.xyz.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://abcsp.xyz.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="0f9dc2b1-8477-4c41-8941-cad040e92263" name="Unexpected exception recover" type="Recover"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="450" y="-120" /><onsuccess>69569712-9455-4f2f-bc67-661f31048cd6</onsuccess></stage><stage stageid="d759d976-f1e7-4cee-b673-2239c6438e23" name="Unexpected Exception" type="Exception"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="806f0cc0-e370-4324-9ee7-bf587f354f65" name="Script_Location" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="58f195ab-8702-4762-a7ea-3da9a60ae77c" name="Find_Item_By" type="Data"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="69569712-9455-4f2f-bc67-661f31048cd6" name="Delete_Script" type="Action"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="450" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>d759d976-f1e7-4cee-b673-2239c6438e23</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="b4bd18ae-9003-49a0-af9a-39f6adf318e8" name="Validate Temp Script Path" type="SubSheet"><subsheetid>b92