70-b0d4-e6eb24ce85de" name="Start" type="Start"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Bold" color="000000" /><onsuccess>cd0ad315-143b-4883-a816-32f2d8be3525</onsuccess></stage><stage stageid="df5f0f39-28d3-4bfa-9f8d-96f455521614" name="End" type="End"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="15" y="135" /><font family="Tahoma" size="10" style="Bold" color="000000" /></stage><stage stageid="cd0ad315-143b-4883-a816-32f2d8be3525" name="Read Attached" type="Read"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="15" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>7a3c440e-a319-4b91-ac96-af0c0cc8c406</onsuccess><step stage="flg_Attached"><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>IsConnected</id></action></step></stage><stage stageid="7a3c440e-a319-4b91-ac96-af0c0cc8c406" name="Attached?" type="Decision"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="15" y="15" /><font family="Tahoma" size="10" style="Bold" color="FF00FF" /><decision expression="[flg_Attached]" /><ontrue>b72f78b1-242a-4145-a7f8-d1a3fc273d50</ontrue><onfalse>81a8f397-3360-4730-9641-82ebdc3de3c3</onfalse></stage><stage stageid="81a8f397-3360-4730-9641-82ebdc3de3c3" name="Attach" type="Navigate"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="105" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>911276d5-e927-4d79-863b-8fd8e4c97ffa</onsuccess><step><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>AttachApplication</id><arguments><argument><id>WindowTitlesCollection</id><value></value></argument><argument><id>WindowTitle</id><value></value></argument><argument><id>ProcessName</id><value>"outlook"</value></argument><argument><id>ChildIndex</id><value>0</value></argument><argument><id>ProcessID</id><value></value></argument><argument><id>Username</id><value></value></argument></arguments></action></step></stage><stage stageid="6a7c2d9b-2c6f-4363-996d-f90a8a07c036" name="Err Block" type="Block"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="75" y="-15" w="60" h="105" /><font family="Tahoma" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b72f78b1-242a-4145-a7f8-d1a3fc273d50" name="Note3" type="Note"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><narrative>No need to attach</narrative><display x="15" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>df5f0f39-28d3-4bfa-9f8d-96f455521614</onsuccess></stage><stage stageid="b723c9cb-e727-4dee-87a7-9d0a16ca90d6" name="Attach Failed" type="Exception"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><display x="105" y="-105" /><exception type="System Exception" detail="&quot;Attach Failed&quot;" /></stage><stage stageid="3bca3531-f213-4759-b40c-d20b72a1f219" name="Recover" type="Recover"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="105" y="75" /><onsuccess>78eed05b-186c-4a93-b160-90e96cea9acf</onsuccess></stage><stage stageid="78eed05b-186c-4a93-b160-90e96cea9acf" name="Resume" type="Resume"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="195" y="75" /><onsuccess>911276d5-e927-4d79-863b-8fd8e4c97ffa</onsuccess></stage><stage stageid="930f2a1f-a3aa-4b30-b668-cea76db9515d" name="num_Try Count" type="Data"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><display x="-150" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="75ed2ab1-ee9b-41ab-b910-0a87ea2f6a61" name="num_Max Try" type="Data"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><display x="-150" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>20</initialvalue><private /><alwaysinit /></stage><stage stageid="8a7861ab-f8e6-481f-973c-dfdd5493d185" name="Go" type="WaitEnd"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="180" y="-45" w="30" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>28345e5b-b59b-4ffd-a6f5-e051da8a6a0a</onsuccess><groupid>3c514e13-3693-43a6-bea3-caebc152e0b0</groupid></stage><stage stageid="fb109580-b346-4b13-a995-3987f3801ea3" name="XS" type="WaitStart"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="210" y="-45" w="30" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><groupid>3c514e13-3693-43a6-bea3-caebc152e0b0</groupid><choices /><timeout>[GLOBAL Timeout - XS]</timeout></stage><stage stageid="911276d5-e927-4d79-863b-8fd8e4c97ffa" name="Count" type="Calculation"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="195" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>fb109580-b346-4b13-a995-3987f3801ea3</onsuccess><calculation expression="[num_Try Count] + 1" stage="num_Try Count" /></stage><stage stageid="28345e5b-b59b-4ffd-a6f5-e051da8a6a0a" name="End Try?" type="Decision"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="105" y="-45" /><font family="Segoe UI" size="10" style="Bold" color="FF00FF" /><decision expression="[num_Try Count] &gt; [num_Max Try]" /><ontrue>b723c9cb-e727-4dee-87a7-9d0a16ca90d6</ontrue><onfalse>cd0ad315-143b-4883-a816-32f2d8be3525</onfalse></stage><stage stageid="8954b5a9-bdda-4085-865e-b0ffa18d1a57" name="Variable" type="Block"><subsheetid>1df384cf-a51b-46de-8c99-d5278b0f57a3</subsheetid><loginhibit /><display x="-225" y="-45" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FFCC00" /></stage><stage stageid="21a2e9f4-13d2-45cc-b290-a1a0a204b9b5" name="Attach" type="SubSheet"><subsheetid>b670896b-0fcc-42eb-8ab3-c06e1079e258</subsheetid><loginhibit /><display x="45" y="105" /><font family="Segoe UI" size="10" style="Bold" color="0000FF" /><onsuccess>77e8b0b8-f550-421b-a927-dc1e8207e686</onsuccess><processid>1df384cf-a51b-46de-8c99-d5278b0f57a3</processid></stage><stage stageid="bdd2a6d6-6fc5-4927-b98d-07e53d7bdc5d" name="flg_Attached" type="Data"><loginhibit /><display x="-390" y="15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><alwaysinit /></stage><stage stageid="8ccc6ae7-bb83-480d-801b-4b61ea384c88" name="Variable" type="Block"><loginhibit /><display x="-465" y="-225" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="FFCC00" /></stage><stage stageid="8d390f63-6c4c-415a-a249-b98be96b7c11" name="GLOBAL Timeout - XXS" type="Data"><loginhibit /><display x="-390" y="-195" w="150" h="30" /><datatype>number</datatype><initialvalue>0.5</initialvalue><alwaysinit /></stage><stage stageid="8a8e5c77-108f-40cc-b524-c4a1ce386950" name="GLOBAL Timeout - XS" type="Data"><loginhibit /><display x="-390" y="-165" w="150" h="30" /><datatype>number</datatype><initialvalue>1</initialvalue><alwaysinit /></stage><stage stageid="7010fc6e-4422-4edc-8080-b4a82092a93b" name="GLOBAL Timeout - S" type="Data"><loginhibit /><display x="-390" y="-135" w="150" h="30" /><datatype>number</datatype><initialvalue>5</initialvalue><alwaysinit /></stage><stage stageid="bd7b9753-6bd0-4673-9e4d-00e9898a6715" name="GLOBAL Timeout - M" type="Data"><loginhibit /><display x="-390" y="-105" w="150" h="30" /><datatype>number</datatype><initialvalue>10</initialvalue><alwaysinit /></stage><stage stageid="93ac78c3-e52f-4ac1-91d6-0ec753ffe565" name="GLOBAL Timeout - L" type="Data"><loginhibit /><display x="-390" y="-75" w="150" h="30" /><datatype>number</datatype><initialvalue>30</initialvalue><alwaysinit /></stage><stage stageid="6e76d293-4673-4e5c-be40-763b9cadcfa6" name="GLOBAL Timeout - XL" type="Data"><loginhibit /><display x="-390" y="-45" w="150" h="30" /><datatype>number</datatype><initialvalue>60</initialvalue><alwaysinit /></stage><stage stageid="77c8fd8d-a31a-433c-acdb-74cc9f19a1c9" name="GLOBAL Timeout - XXL" type="Data"><loginhibit /><display x="-390" y="-15" w="150" h="30" /><datatype>number</datatype><initialvalue>120</initialvalue><alwaysinit /></stage><stage stageid="e013838c-eb0d-4627-80fb-b151f08707c4" name="Get Manager ID from Alias ID" type="SubSheetInfo"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><narrative>Fetch the Manager Alias ID of the given Alias ID</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="2b5a742f-6f23-4a86-8255-2210e6f4bbc8" name="Start" type="Start"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><loginhibit /><display x="15" y="-75" /><inputs><input type="text" name="AliasID" narrative="Alias ID of the person to fetch Manager Alias ID" stage="AliasID" /></inputs><onsuccess>966a0737-528d-457f-ad91-48bc33e64cc2</onsuccess></stage><stage stageid="21f933e0-b6fc-453d-913f-c710dcaba810" name="End" type="End"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><loginhibit /><display x="15" y="120" /><outputs><output type="text" name="Manager AliasID" narrative="manager alias id from Aliasid" stage="Manager AliasID" /><output type="flag" name="Sucess?" narrative="Found or not found" stage="Success" /><output type="text" name="Error Message" narrative="Description in any error" stage="ErrorMsg" /></outputs></stage><stage stageid="966a0737-528d-457f-ad91-48bc33e64cc2" name="Get Manager ID from Alias ID" type="Code"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><loginhibit /><display x="15" y="15" w="90" h="30" /><font family="Segoe UI" size="11" style="Regular" color="000000" /><inputs><input type="text" name="AliasID" expr="[AliasID]" /></inputs><outputs><output type="text" name="MAliasID" stage="Manager AliasID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="ErrorMsg" stage="ErrorMsg" /></outputs><onsuccess>21f933e0-b6fc-453d-913f-c710dcaba810</onsuccess><code><![CDATA[Dim ToAddr = AliasID
 
Try
    Dim ol = CreateObject("Outlook.Application")
    Dim mail = ol.CreateItem(0)
    Dim recipient = mail.Recipients.Add(ToAddr)
 
    Dim oAE = recipient.AddressEntry
    Dim ExchangeUser =  oAE.GetExchangeUser

    If (ExchangeUser is Nothing)
        Success = False
        AliasID = "Null"
    Else
        MAliasID = ExchangeUser.Manager.ALIAS
        Success = True
        ErrorMSg = Nothing
    End If
 
    recipient.delete
    oAE = Nothing
    recipient = Nothing
    ol = Nothing
 
Catch ex as System.Exception
    Success = False
    ErrorMsg = ex.Message
End Try]]></code></stage><stage stageid="c7b8ac72-35e1-4a71-9b26-261f0a959428" name="AliasID" type="Data"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8ba6b78b-d595-4fab-b45b-790d7295b00c" name="ErrorMsg" type="Data"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><display x="-195" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="99dc5302-d4fc-4762-bc76-25ca942e0f3d" name="Success" type="Data"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><display x="-195" y="105" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c352ef50-e161-452a-b5f6-69091fbdd57f" name="Input" type="Block"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="e1908126-4995-4df0-ad54-822b3d54a403" name="Output" type="Block"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><loginhibit /><display x="-270" y="30" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="027c20eb-af05-4a54-8b83-4d9737d65565" name="Manager AliasID" type="Data"><subsheetid>1681b2f8-088b-4fd5-b2d9-33f5f0b504fa</subsheetid><display x="-195" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2bd20282-aa56-436f-90f4-c86d37d8b270" name="Internal_Get Items - HTML" type="SubSheetInfo"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="cd7cd60e-052e-47f9-b6d4-07f2333dc1c0" name="Start" type="Start"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="number" name="Outlook Folder ID" narrative="Mandatory. Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent" stage="Outlook Folder ID" /><input type="text" name="Sub Folder" narrative="Optional, default blank. The inbox sub folder to look in." stage="Sub Folder" /></inputs><onsuccess>b3ff1f27-c537-4adb-bfb0-55c61dbf44fb</onsuccess></stage><stage stageid="f47fe19f-2abc-46dc-a589-9a120d95e451" name="End" type="End"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="b3ff1f27-c537-4adb-bfb0-55c61dbf44fb" name="Get Items - HTML" type="Code"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="number" name="Outlook Folder ID" expr="[Outlook Folder ID]" /><input type="text" name="Sub Folder" expr="[Sub Folder]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>f47fe19f-2abc-46dc-a589-9a120d95e451</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim folder = _nameSpace.GetDefaultFolder(Outlook_Folder_ID)

If Sub_Folder <> "" Then
	For each name as string in Sub_Folder.Split("\")
	folder = folder.Folders(name)
	Next
End If

'See https://msdn.microsoft.com/en-us/library/office/aa210946(v=office.11).aspx
'for mail item properties
Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
	If Not TypeOf item Is MailItem Then Continue For
	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.HTMLBody
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("Unread") = item.Unread
	dataTable.Rows.Add(row)
	Item_Count += 1
Next
Items = dataTable]]></code></stage><stage stageid="09c7e226-58c8-468b-9346-ca9cb269fc05" name="Item Count" type="Data"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><display x="-195" y="180" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb3bfe05-8672-4009-a906-4115e9935ecd" name="Filter Expression" type="Data"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="868fc7ec-0565-4279-9665-2a5cfa8801f0" name="Outlook Folder ID" type="Data"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="c26c8c8d-582a-4da5-8df3-82059c3b8458" name="Sub Folder" type="Data"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="57177300-a6de-4748-8bd5-719d21b92b19" name="Items" type="Collection"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><display x="-195" y="135" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="63eb8ab2-c47b-4e05-8069-b86caed395e3" name="Note2" type="Note"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="7f45e714-66b0-41ab-b160-e133fd83eba3" name="Input" type="Block"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="563c9ebb-9ffe-4d0b-a155-2cd4cef4ee73" name="Output" type="Block"><subsheetid>9c4f3977-e757-47cc-b584-877e2fccccd8</subsheetid><loginhibit /><display x="-270" y="90" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="e9b8ff6d-ee1e-4f90-9e1f-dbd7de8e1d2f" name="Get Received Items (Basic) - HTML" type="SubSheetInfo"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><narrative>Lists Inbox items matching the parameters provided.
This provides the mail body by also inclduing the underlying HTML tags</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="560e3aac-fedc-4da9-b202-d85ca41066e2" name="Item Count" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="240" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2f5a752d-7dda-4845-a6e9-388fe7ebb090" name="Internal_Get Items" type="SubSheet"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="420" /><inputs><input type="text" name="Filter Expression" friendlyname="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="number" name="Outlook Folder ID" friendlyname="Outlook Folder ID" narrative="Mandatory. Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent" expr="[Outlook Folder ID]" /><input type="text" name="Sub Folder" friendlyname="Sub Folder" narrative="Optional, default blank. The inbox sub folder to look in." expr="[Sub Folder]" /></inputs><outputs><output type="collection" name="Items" friendlyname="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" friendlyname="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>84cf641d-fe03-476a-b692-ea3f0303df36</onsuccess><processid>9c4f3977-e757-47cc-b584-877e2fccccd8</processid></stage><stage stageid="7c59f5c4-0337-437f-a283-496895291543" name="Outlook Folder ID" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="993f3e01-9e7c-4115-9648-cc90001eeb5b" name="Sub Folder" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="84cf641d-fe03-476a-b692-ea3f0303df36" name="End" type="End"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="480" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="19d6a926-da7b-4f4b-970d-676bc5e93a1e" name="Subject" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="da6d135c-b527-4cfc-86c7-323882092f07" name="Start" type="Start"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sender Name" narrative="Optional. The From display name, which might be a name (eg John Smith) or email address (eg admin@client.com). Asterisk wildcard permitted, eg *John Smith* for any mail where the text 'John Smith' appears in the From field." stage="Sender Name" /><input type="text" name="Sender Email" narrative="Optional. The sender email address." stage="Sender Email" /><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Sub Folder" /></inputs><onsuccess>9e480af7-58c6-449f-aa56-32af04a10f8e</onsuccess></stage><stage stageid="f20ff4b7-d616-4288-8511-692663558043" name="Received Earliest" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bdbe9dc7-6207-47bd-b58c-733e066887cc" name="Received Latest" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33370221-85fa-4199-9c49-688f38e12f2b" name="Filter Expression" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9e480af7-58c6-449f-aa56-32af04a10f8e" name="Sender Name?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="-45" /><decision expression="[Sender Name]&lt;&gt;&quot;&quot;" /><ontrue>ff328471-e907-47f2-93b2-9f1d8ad2f240</ontrue><onfalse>e55b21ee-9094-4d70-9f0e-2ce30616fdf8</onfalse></stage><stage stageid="ff328471-e907-47f2-93b2-9f1d8ad2f240" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="-45" /><onsuccess>e55b21ee-9094-4d70-9f0e-2ce30616fdf8</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:sendername LIKE '&quot;&amp;Replace([Sender Name], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="9797bd42-a526-40c0-9ce9-4e4bbd346b20" name="Clean Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="330" /><onsuccess>ec61c0ad-c1c2-44f1-9720-d41ceba29c14</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="7950bfd6-85b0-483c-be20-d937a43adc34" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>cd2597ae-2975-4f08-9219-76954ff509d0</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="6c67b991-f20d-4108-8b25-68b9378707fa" name="Subject?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="45" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>7950bfd6-85b0-483c-be20-d937a43adc34</ontrue><onfalse>cd2597ae-2975-4f08-9219-76954ff509d0</onfalse></stage><stage stageid="e55b21ee-9094-4d70-9f0e-2ce30616fdf8" name="Sender Email?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="0" /><decision expression="[Sender Email]&lt;&gt;&quot;&quot;" /><ontrue>ea9794b1-c3e0-460c-b24c-27e0c2c39243</ontrue><onfalse>6c67b991-f20d-4108-8b25-68b9378707fa</onfalse></stage><stage stageid="ea9794b1-c3e0-460c-b24c-27e0c2c39243" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="0" /><onsuccess>6c67b991-f20d-4108-8b25-68b9378707fa</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:senderemail LIKE '&quot;&amp;Replace([Sender Email], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="623266e7-d5cf-4922-93ac-158ce749ba5d" name="Sender Name" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4fd705c5-9875-4d94-902d-fee96f070092" name="Sender Email" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ec61c0ad-c1c2-44f1-9720-d41ceba29c14" name="Filter Expression?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="375" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>319f354a-8f47-4a52-9714-b1b13e239caa</ontrue><onfalse>2f5a752d-7dda-4845-a6e9-388fe7ebb090</onfalse></stage><stage stageid="319f354a-8f47-4a52-9714-b1b13e239caa" name="Prepend" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="375" /><onsuccess>2f5a752d-7dda-4845-a6e9-388fe7ebb090</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="be0219cf-7e0b-4470-9afe-302107f1da57" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="270" /><onsuccess>9797bd42-a526-40c0-9ce9-4e4bbd346b20</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="c47d26f0-0db5-428f-ac1c-e8fcfcdd3484" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="135" /><onsuccess>97e213c8-99bc-46e8-be51-7c182349f992</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="fd9c8c2b-5d4a-4b90-a833-cde9baad8f70" name="Earliest?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="135" /><decision expression="IsDate([Received Earliest])" /><ontrue>c47d26f0-0db5-428f-ac1c-e8fcfcdd3484</ontrue><onfalse>97e213c8-99bc-46e8-be51-7c182349f992</onfalse></stage><stage stageid="97e213c8-99bc-46e8-be51-7c182349f992" name="Latest" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="IsDate([Received Latest])" /><ontrue>48b8a61a-7d20-4e91-9365-479477ee6bfd</ontrue><onfalse>aff62493-e550-4fe6-b527-084851995fc8</onfalse></stage><stage stageid="48b8a61a-7d20-4e91-9365-479477ee6bfd" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="180" /><onsuccess>aff62493-e550-4fe6-b527-084851995fc8</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="6e68d742-468c-4d5a-9640-ab660ca9e8c2" name="Include Unread" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="bf4a8ea1-236c-4347-8ad1-8878aad10830" name="Include Read" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="aff62493-e550-4fe6-b527-084851995fc8" name="Unread Only?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="225" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>be0219cf-7e0b-4470-9afe-302107f1da57</ontrue><onfalse>0eedf148-542c-414f-b3f8-fe6dfdc2ecd1</onfalse></stage><stage stageid="0eedf148-542c-414f-b3f8-fe6dfdc2ecd1" name="Read Only?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="225" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>31d4bbe0-cd52-431a-92d8-8f86638dcb28</ontrue><onfalse>1c057c48-d08a-4830-9b3d-0828044194ae</onfalse></stage><stage stageid="31d4bbe0-cd52-431a-92d8-8f86638dcb28" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="270" /><onsuccess>ef218da4-c584-4b72-9e33-d987addb4a2f</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="1c057c48-d08a-4830-9b3d-0828044194ae" name="Anchor1" type="Anchor"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="150" y="225" w="10" h="10" /><onsuccess>59c2d4db-cd21-4cf0-b922-16260af359f8</onsuccess></stage><stage stageid="59c2d4db-cd21-4cf0-b922-16260af359f8" name="Anchor1" type="Anchor"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="150" y="330" w="10" h="10" /><onsuccess>ef218da4-c584-4b72-9e33-d987addb4a2f</onsuccess></stage><stage stageid="ef218da4-c584-4b72-9e33-d987addb4a2f" name="Anchor1" type="Anchor"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="330" w="10" h="10" /><onsuccess>9797bd42-a526-40c0-9ce9-4e4bbd346b20</onsuccess></stage><stage stageid="c91d479a-10c2-41d0-8fbe-8156fc4abce0" name="Items" type="Collection"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="-195" y="195" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="48952c64-5153-45dc-bab4-ca2578c40ce9" name="Filter Expression" type="Calculation"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="90" y="90" /><onsuccess>fd9c8c2b-5d4a-4b90-a833-cde9baad8f70</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="cd2597ae-2975-4f08-9219-76954ff509d0" name="Message?" type="Decision"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="15" y="90" /><decision expression="[Message]&lt;&gt;&quot;&quot;" /><ontrue>48952c64-5153-45dc-bab4-ca2578c40ce9</ontrue><onfalse>fd9c8c2b-5d4a-4b90-a833-cde9baad8f70</onfalse></stage><stage stageid="a13b7861-4df0-4066-94ee-24e7b0f3e121" name="Message" type="Data"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><display x="240" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fc2ae728-36ec-49ed-b391-6bba339a5821" name="Input" type="Block"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2e28cac7-e404-47cf-acde-cfb5c7b99d86" name="Output" type="Block"><subsheetid>796fb673-dead-455d-8a9d-091ec78d415d</subsheetid><loginhibit /><display x="-270" y="150" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="b464b8f2-93e4-459d-b39a-9e77b3ada697" name="Code1" type="Code"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="180" y="90" w="90" h="30" /><font family="Segoe UI" size="11" style="Regular" color="000000" /><inputs><input type="text" name="EmailID" expr="[EmailID]" /></inputs><outputs><output type="text" name="AliasID" stage="AliasID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="ErrorMsg" stage="ErrorMsg" /></outputs><onsuccess>cc5fede0-35a8-4764-8266-69aea9a4c2a5</onsuccess><code><![CDATA[Dim ToAddr = EmailID

Try
	Dim ol = CreateObject("Outlook.Application")
	Dim mail = ol.CreateItem(0)
	Dim recipient = mail.Recipients.Add(ToAddr)

	Dim oAE = recipient.AddressEntry
	Dim ExchangeUser =  oAE.GetExchangeUser
	
	If (ExchangeUser is Nothing)
		Success = False
		AliasID = "Null"
	Else
		AliasID =  oAE.GetExchangeUser.Name
		Success = True
		ErrorMSg = Nothing
	End If

	recipient.delete
	oAE = Nothing
	recipient = Nothing
	ol = Nothing

Catch ex as System.IO.IOException
	Success = False
	ErrorMsg = ex.Message
End Try]]></code></stage><stage stageid="5c2f42f9-b6b7-4ee2-86a0-f04a45450d94" name="Copy Mail from GroupMailBox to other GroupMailbox" type="SubSheetInfo"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><narrative>Forward Email to recipients (To/CC/BCC) including (Message) as input parameters.
Forwards the email with source format
The &lt;Forward Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-195" y="-45" w="150" h="150" /></stage><stage stageid="c17522aa-94f5-4660-8016-84ef99414850" name="Start" type="Start"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><loginhibit /><display x="435" y="15" /><inputs><input type="text" name="in_ToMailBoxName" narrative="Dest mailbox name" stage="ToMailBoxName" /><input type="text" name="in_ToSubFolder" narrative="dest sub folder name" stage="ToSubFolder" /><input type="text" name="in_FromMailBoxName" narrative="source mailbox name" stage="FromMailBoxName" /><input type="text" name="in_FromSubFolder" narrative="source folder name" stage="FromSubFolder" /><input type="text" name="EntryID" narrative="entry id of email" stage="EntryID" /></inputs><onsuccess>88672fe9-f45c-4d79-af36-22313c34c2c7</onsuccess></stage><stage stageid="4b1beaa3-3b85-4c7d-bc76-3f9e8aa8dfa2" name="End" type="End"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><loginhibit /><display x="435" y="210" /><outputs><output type="number" name="Item_Count" narrative="count of mail copied" stage="Item Count" /><output type="text" name="copiedItem" narrative="new entry id" stage="copiedItem" /></outputs></stage><stage stageid="88672fe9-f45c-4d79-af36-22313c34c2c7" name="Copy Mail from GroupMailBox to other GroupMailbox" type="Code"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><loginhibit /><display x="435" y="120" w="120" h="30" /><inputs><input type="text" name="FromMailBoxName" expr="[FromMailBoxName]" /><input type="text" name="FromSubFolder" expr="[FromSubFolder]" /><input type="text" name="ToMailBoxName" expr="[ToMailBoxName]" /><input type="text" name="ToSubFolder" expr="[ToSubFolder]" /><input type="text" name="EntryID" expr="[EntryID]" /></inputs><outputs><output type="number" name="Item Count" stage="Item Count" /><output type="text" name="CopiedEntryID" stage="copiedItem" /></outputs><onsuccess>4b1beaa3-3b85-4c7d-bc76-3f9e8aa8dfa2</onsuccess><code><![CDATA[Dim app, _nameSpace
Dim folder, folder1, SubFolder, SubFolder1
Dim folderItems, item, newItem
Dim name
Dim movedItem
app = CreateObject("Outlook.Application")
_nameSpace = app.GetNamespace("MAPI")

' Navigate to source folder
folder = _nameSpace.Folders(FromMailBoxName)
SubFolder = FromSubFolder
If SubFolder <> "" Then
    For Each name In Split(SubFolder, "\")
        folder = folder.Folders(name)
    Next
End If

' Navigate to destination folder
folder1 = _nameSpace.Folders(ToMailBoxName)
SubFolder1 = ToSubFolder
If SubFolder1 <> "" Then
    For Each name In Split(SubFolder1, "\")
        folder1 = folder1.Folders(name)
    Next
End If

' Get item by EntryID
item = _nameSpace.GetItemFromID(EntryID)


' Copy and move the item
On Error Resume Next
newItem = item.Copy
movedItem = newItem.Move(folder1)

If Not movedItem Is Nothing Then
    CopiedEntryID = movedItem.EntryID  ' This is the correct new EntryID
    Item_Count = Item_Count + 1
End If
On Error GoTo 0
]]></code></stage><stage stageid="191c2d0d-9ec8-4eb7-ae09-86cfb4033a96" name="Item Count" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="195" y="195" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd349822-3bfc-4453-b80e-d308ba7d8b44" name="FromMailBoxName" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="255" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3185a74f-fbb5-46f4-9ba8-38eb1376b747" name="FromSubFolder" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="240" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="de9bfc55-68c9-4f2e-b9ea-8a77c1cc9a81" name="ToMailBoxName" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="180" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd65598e-b6e6-488b-bc42-5bb92ce9366e" name="ToSubFolder" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="165" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e809537b-00be-488e-9d0b-e9ca9307e97d" name="EntryID" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="90" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bf3526af-d3ec-4afd-8714-598e56b370c8" name="copiedItem" type="Data"><subsheetid>97b79d06-9ad7-404f-9649-d5e6b56eece1</subsheetid><display x="75" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
