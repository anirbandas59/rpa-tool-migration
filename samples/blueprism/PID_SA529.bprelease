ve><display x="-300" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="101abf33-b567-44b6-8544-3b84baf2edad" name="Standards" type="Note"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><narrative>
Folder Name:- Folder to be Deleted (Example:- Test)

