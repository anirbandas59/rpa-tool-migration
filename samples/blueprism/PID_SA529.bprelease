Inst.DisplayAlerts = False
GetWorkbook(handle,Nothing).ActiveSheet.AutoFilter.Range.Offset(1,0).Rows.Delete()
Inst.DisplayAlerts = True]]></code></stage><stage stageid="0122a656-243e-41a9-979b-eacd090ee75f" name="Activate Workbook" type="SubSheet"><subsheetid>2b1bfac8-7cf7-40b4-b6bc-843abd082c73</subsheetid><loginhibit onsuccess="true" /><display x="90" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>c8327234-eadb-4393-85b3-53ac501b4a65</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="1d0c8c30-7928-45aa-916c-380f03dc33d2" name="Recover" type="Recover"><subsheetid>2b1bfac8-7cf7-40b4-b6bc-843abd082c73</subsheetid><loginhibit /><display x="-180" y="-15" /><onsuccess>170ef3ae-727b-4d75-83be-13974cbfaf60</onsuccess></stage><stage stageid="170ef3ae-727b-4d75-83be-13974cbfaf60" name="Exception" type="Exception"><subsheetid>2b1bfac8-7cf7-40b4-b6bc-843abd082c73</subsheetid><display x="-180" y="75" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="83002c5e-b9e8-4f1d-8cba-374cba04999f" name="Align Columns" type="SubSheetInfo"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><narrative>Align Entire Column to right, left or center

</narrative><display x="-360" y="-105" w="210" h="90" /></stage><stage stageid="fd682f40-7086-4988-aef6-f01909e7c40a" name="Align Column" type="Code"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="105" y="-15" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Colname Range" expr="[Column Name]" /><input type="number" name="Align" expr="[Align]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>916c3191-7afd-4753-b2fc-6b85dafd7e4e</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try


xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)


'Align entire column
xlSheet1.Range(Colname_Range).HorizontalAlignment = Align

Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="36e4950e-c938-45ee-bb1e-169bfacb7238" name="Start" type="Start"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><loginhibit /><display x="105" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle created" stage="handle" /><input type="text" name="Work Book Name" narrative="Opened Work book name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work sheet name to access" stage="Worksheet" /><input type="text" name="Column Name Range" narrative="(Ex: A:D, A:A, C:F etc.)" stage="Column Name" /><input type="number" name="Align" narrative="Alignment criteria (Pass -4131 for left, -4152 for right, -4108 for center and 1 for General)" stage="Align" /></inputs><onsuccess>fd682f40-7086-4988-aef6-f01909e7c40a</onsuccess></stage><stage stageid="916c3191-7afd-4753-b2fc-6b85dafd7e4e" name="End" type="End"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><loginhibit /><display x="105" y="75" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /></outputs></stage><stage stageid="fb397bea-345e-44a4-b969-d4f56362d6f5" name="handle" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-135" y="-105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32d02ede-00e6-4207-8519-cca65d8a2049" name="Workbook" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-135" y="-60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="16cc3b51-faa6-4e85-a7de-416cbc3c4503" name="Worksheet" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-135" y="-15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7c3487ce-192d-4ada-9255-99cc636a4664" name="Column Name" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-135" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac39a138-07c7-4019-af6c-4280a0baefad" name="Success" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-360" y="0" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="217e7b6f-78fb-4bb2-8f51-7b70891176fd" name="Message" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-360" y="60" w="180" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ed1d6d40-107a-4d49-b28c-2566763a3f14" name="Input parameters" type="Block"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><loginhibit /><display x="-240" y="-135" w="210" h="240" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="47cf4397-32ff-4d56-a357-939f242f9923" name="Output Parameters" type="Block"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><loginhibit /><display x="-465" y="-45" w="210" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="67ca68fb-5015-45c5-ae49-daaeb001e4d6" name="Align" type="Data"><subsheetid>3a09efd8-b9a8-4a5f-b832-adfb5adf93b2</subsheetid><display x="-135" y="75" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9a0aa482-026c-4c87-a883-5407f4d5a3b9" name="Set Cell Formula" type="SubSheetInfo"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><narrative>Sets the specified Formula to the given value.
This has the side-effect of setting the active cell to that which is specified here.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="12caabcb-756e-4a11-bf4f-8f15048c1ccf" name="Start" type="Start"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><loginhibit /><display x="15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." stage="cellref" /><input type="text" name="Formula" narrative="The value to which the specified cell should be set." stage="Formula" /></inputs><onsuccess>a8d31e76-b0ca-4c50-92da-6a406b32c4f3</onsuccess></stage><stage stageid="733e3a02-f6b8-4f29-ae26-1d62c9d5698e" name="End" type="End"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><loginhibit /><display x="15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="c0638d6d-ca7f-40ee-b6bb-0eaad26a3002" name="cellref" type="Data"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a9f093cc-b486-4c1e-b153-6ae777c2877f" name="Formula" type="Data"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><display x="-195" y="60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="587303d3-986e-421d-805a-c159e1c9dbe9" name="Set Cell Formula" type="Code"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="cellref" expr="[cellref]" /><input type="text" name="Formula" expr="[Formula]" /></inputs><onsuccess>733e3a02-f6b8-4f29-ae26-1d62c9d5698e</onsuccess><code><![CDATA[GetInstance(handle).ActiveCell.Formula = Formula]]></code></stage><stage stageid="a8d31e76-b0ca-4c50-92da-6a406b32c4f3" name="Go To Cell" type="SubSheet"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Cell Reference" expr="[cellref]" /></inputs><onsuccess>587303d3-986e-421d-805a-c159e1c9dbe9</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="4e74ba48-5516-436f-8b5a-38c2385b4686" name="handle" type="Data"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="eb537390-abb2-4b1d-9e15-c10829fa7cde" name="Recover3" type="Recover"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><loginhibit /><display x="270" y="-90" /><onsuccess>18f173cc-9d53-4a0d-ad5c-5bfc410acc36</onsuccess></stage><stage stageid="18f173cc-9d53-4a0d-ad5c-5bfc410acc36" name="Exception1" type="Exception"><subsheetid>0e84d5b8-666f-4458-9c1b-add847707347</subsheetid><display x="270" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="8d7d3153-77d8-4e2d-80dd-3c3f18f4dc37" name="Unprotect sheet" type="SubSheetInfo"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><narrative>Unprotect worksheet from excel workbook</narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="b054e0f9-4d49-45fb-8117-68d04c37a471" name="Start" type="Start"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="excel handle number" stage="handle" /><input type="text" name="workbook name" narrative="workbook name of the excel" stage="Workbook Name" /><input type="text" name="worksheet name" narrative="excel sheet name to unprotect" stage="worksheet name" /><input type="password" name="Password" narrative="worksheet password" stage="Password" /></inputs><onsuccess>004b2dab-4a97-4793-a5b1-779b173af7e7</onsuccess></stage><stage stageid="0daa3ce0-767a-4d26-9814-a5571e5f19cb" name="End" type="End"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="c262f098-ade2-49ed-8b98-cf29eb34602d" name="handle" type="Data"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><display x="-255" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23b5fb85-4749-4ff0-bb59-68f361b1d294" name="Workbook Name" type="Data"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><display x="-330" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="28ef45fb-e770-47fe-a8d7-1f5bd4552096" name="worksheet name" type="Data"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><loginhibit /><display x="-330" y="45" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="004b2dab-4a97-4793-a5b1-779b173af7e7" name="Unprotect Sheet" type="Code"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="password" name="Password" expr="[Password]" /></inputs><onsuccess>0daa3ce0-767a-4d26-9814-a5571e5f19cb</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Sheets(worksheet).Unprotect(Password)]]></code></stage><stage stageid="14cef810-767f-4b34-bdd7-94139f88f527" name="Password" type="Data"><subsheetid>eecd1a9a-3b89-4f78-ae60-bf602c2a6c60</subsheetid><display x="-255" y="45" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="3d231a14-a70d-4211-88a3-0fd0e1595f49" name="Hide Columns" type="SubSheetInfo"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><narrative>Hides single or range of specified columns</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="dd6312e0-097a-437a-9767-ec4aa18b9e55" name="End" type="End"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="6c38d7e4-3118-4d1e-8862-0fad0968243e" name="Hide Column" type="Code"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="range" expr="[range]" /></inputs><onsuccess>dd6312e0-097a-437a-9767-ec4aa18b9e55</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Sheets(worksheet).Columns(range).Hidden=True]]></code></stage><stage stageid="def0e36c-f5d8-4c3a-bed3-675347c7446d" name="handle" type="Data"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="48944450-5d98-4b0e-9ffd-f7fb4cd8dc86" name="Workbook Name" type="Data"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9eeb98cf-6d54-439a-9e97-1f3a4260c4fb" name="worksheet name" type="Data"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><loginhibit /><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12f3e00b-f8ef-4927-b0f3-d85b27c577e8" name="range" type="Data"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><loginhibit /><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0af3e17-7e2b-4486-91d8-cced860b3388" name="Start" type="Start"><subsheetid>8647fe13-1a45-47f3-9995-2096dd22d91a</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="handle " narrative="Handle" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="range" narrative="Range of columns to be hidden(eg:&quot;D:H&quot; will hide the columns D through H)" stage="range" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /></inputs><onsuccess>6c38d7e4-3118-4d1e-8862-0fad0968243e</onsuccess></stage><stage stageid="3ffa59a9-0401-4296-b347-f920b04ca5a3" name="Create Worksheet Before / After" type="SubSheetInfo"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><narrative>Creates a new worksheet in the specified workbook with the given name, before or after an existing reference worksheet. If a sheet with the given name already exists, this will activate that sheet.

Params:
- handle : Number : The number identifying the instance required.
- Workbook Name : Text : The name of the workbook to add it to. An empty string (the default) indicates the active workbook in the instance.
- Worksheet Name To Create : Text : The name of the worksheet that is required. Note that if the name matches a worksheet already in the workbook a new worksheet will not be created, but that worksheet will be activated.
- Reference Worksheet Name : Text :  Name of the existing work sheet to be used as reference for before / after position.
- Before Reference Worksheet : Flag :  Used to determine the placement position of the new work sheet that is being created.

Exceptions: 
- Bad Handle : If the given handle did not correspond to an instance.
- Workbook Not Found : If the given workbook did not exist on the specified instance.</narrative><display x="-375" y="-165" w="420" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="eb2064b8-d4f7-446d-930c-6e28fefd154d" name="Start" type="Start"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><loginhibit /><display x="-30" y="-240" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet should be created. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook in which the sheet should be created - The default empty value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="worksheetnametocreate" narrative="The name of the worksheet to be created." stage="worksheetnametocreate" /><input type="text" name="referenceworksheetname" narrative="The name of the sheet which should be activated. The default empty text value indicates that the currently active sheet should be, er, activated, making this a no-op." stage="referenceworksheetname" /><input type="flag" name="beforereferenceworksheet?" narrative="Flag value used as default reference to determine the placement position of the work sheet being created." stage="beforereferenceworksheet" /></inputs><onsuccess>9ae68232-b1db-4575-896b-c3b638ad5d14</onsuccess></stage><stage stageid="6148431b-8e17-4535-a828-708bb0c0f0ed" name="End" type="End"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><loginhibit /><display x="-30" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="9ae68232-b1db-4575-896b-c3b638ad5d14" name="CreateWorkSheet" type="Code"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><loginhibit /><display x="-30" y="-120" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetnametocreate" expr="[worksheetnametocreate]" /><input type="text" name="referenceworksheetname" expr="[referenceworksheetname]" /><input type="flag" name="beforereferenceworksheet" expr="[beforereferenceworksheet]" /><input type="flag" name="createifmissing" expr="[createifmissing]" /></inputs><outputs><output type="flag" name="sheetexists" stage="sheetexists" /></outputs><onsuccess>6148431b-8e17-4535-a828-708bb0c0f0ed</onsuccess><code><![CDATA[Dim sBook,wsSheets As Object

sBook = GetWorkbook(handle, workbookname) 
wsSheets = sBook.Sheets
Dim ws as Object = GetWorksheet(handle,workbookname,referenceworksheetname,createifmissing)
sheetexists = ws IsNot Nothing 
If sheetexists then ws.Activate()
if beforereferenceworksheet=True then
wsSheets.Add(Before:=ws).Name = worksheetnametocreate
Else
wsSheets.Add(After:=ws).Name = worksheetnametocreate
End if ]]></code></stage><stage stageid="9337665c-de77-4c6e-b212-902c2ee1f6dd" name="handle" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-495" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="0ea946c0-c2b7-4485-95b6-b38229a7cf2e" name="workbookname" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-495" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="787d8a0e-3c71-46e5-bcd1-5aedb42660e2" name="worksheetnametocreate" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-375" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a1f398b-be7c-41ee-9b6f-4fb2a5bb27df" name="createifmissing" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-375" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="84074a58-870e-45f8-9c82-9ef334a4165b" name="sheetexists" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-495" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9bc7fb14-f3bd-4864-99c5-e772da16e19b" name="referenceworksheetname" type="Data"><subsheetid>066903ff-0381-43f2-ab8d-884ab5f3eabe</subsheetid><display x="-240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9e8cdc25-0