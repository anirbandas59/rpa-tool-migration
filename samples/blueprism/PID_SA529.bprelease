te /><alwaysinit /></stage><stage stageid="7a471d3f-6ae7-45b1-a7f4-bc7843479e7b" name="Target_Column" type="Data"><subsheetid>83a9d304-6f4c-4504-8a4b-78e340ecb55c</subsheetid><loginhibit /><display x="-330" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8803700-59b6-4e46-a9fc-ed596eb70dba" name="Create Name Range" type="Code"><subsheetid>83a9d304-6f4c-4504-8a4b-78e340ecb55c</subsheetid><loginhibit /><display x="15" y="-60" w="150" h="30" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[WorkSheet Name]" /><input type="text" name="Start_Cell" expr="[Start_Cell]" /><input type="text" name="End_Cell" expr="[End_Cell]" /><input type="text" name="Target_Column" expr="[Target_Column]" /></inputs><onsuccess>10fd799a-bdeb-4dda-8e14-02c6ec7f7227</onsuccess><code><![CDATA[Dim wb, sh As Object
Dim rng1 As Object
Dim rng2 As Object

wb = GetWorkbook (Handle, Workbook)
sh = GetWorkSheet (Handle, Workbook, Worksheet)

 rng1 = sh.Range(Start_Cell & ":" & End_Cell)
        For Each rng2 In rng1.Rows
		If (Len(Trim(rng2.Value2)) > 0 And rng2.Value2 <> "Range Name Label") Then
		wb.Worksheets(sh.Name).Names.Add(Name:=rng2.Value2, RefersTo:="='" & sh.Name & "'!$" & Target_Column & "$" & rng2.Row & ":$" & Target_Column & "$" & rng2.Row)
		 End If

         Next


wb = Nothing
sh = Nothing]]></code></stage><stage stageid="b75f5263-4b4a-49ff-854d-2d6b90eed84c" name="End" type="End"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="0" y="75" /></stage><stage stageid="edb3faf0-c7dc-4cb7-ad11-9f35eb5acfba" name="handle" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><display x="-225" y="-30" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2856f1c-cc18-4788-9271-f7cbcaae0ef2" name="Workbook Name" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><display x="-225" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="02f329f9-6969-4279-8959-27d3a38d0363" name="WorkSheet Name" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><display x="-225" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e17d68b9-4dd2-4b8b-98a2-8ae2b1d72340" name="Start_Cell" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="-225" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="34dd66d7-08dc-44a1-9f8f-5e0952e1d6d0" name="End_Cell" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="-225" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="80a4d88d-e37b-47a2-ab5c-3450980c6482" name="Target_Column_1" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><display x="-225" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65a48d83-57fc-4400-adcd-80fd76164c46" name="Target_Column_2" type="Data"><subsheetid>43fce96f-7b96-4ed8-881f-8570fa80e9c6</subsheetid><loginhibit /><displ