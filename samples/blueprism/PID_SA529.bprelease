a-4191-a071-a12d713fdec6" name="File_Name" type="Data"><subsheetid>68fd8a79-2cef-49df-bcb1-d88a7aa08f14</subsheetid><display x="-180" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1a4ee114-eb8b-4e3d-bcdb-c4b0d4305075" name="Get List Items to CSV - Query" type="SubSheetInfo"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><narrative>Exports provided columns of given list to a csv file including EmailIds and VlookUp Values</narrative><display x="-405" y="-405" w="150" h="90" /></stage><stage stageid="9e437b9b-1ea2-4705-96d2-a104b4ab8d95" name="Return Message" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9e59256-e16a-4d26-a511-3e0482e54790" name="SP_Site_URL" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-255" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38d3a951-ea1e-40fa-b4ea-f88dbfbfbd1e" name="Unexpected exception recover" type="Recover"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="30" y="-225" /><onsuccess>32f0bf8e-1404-4fd5-a0e7-77c62f439dbd</onsuccess></stage><stage stageid="a1bcf8b5-d7c1-4031-9497-51b7a11ba90c" name="Unexpected Exception" type="Exception"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="30" y="-105" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="63613486-06e6-4e93-8932-644e88edc5bd" name="Start" type="Start"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><preconditions><condition narrative="Required Proper Calm Query, Valid CSV FilePath, List Internal Column Names" /></preconditions><postconditions><condition narrative="Generates Output csv" /></postconditions><display x="-165" y="-510" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_List" narrative="Name of Sharepoint list to be exported." stage="SP_List" /><input type="text" name="CalmQuery" narrative="CAML is an XML-based query language. Default Value : &quot;&lt;View&gt;&lt;OrderBy&gt;&lt;FieldRef Name='ID' Ascending='TRUE'/&gt;&lt;/OrderBy&gt;&lt;/View&gt;&quot;. It will fetch all the list Items. provide required query to limit the items" stage="Query" /><input type="number" name="PageSize" narrative="(Optional) default value is 1000. It is required when we exporting large set of items from SharePoint List(Max Value : 5000)" stage="PageSize" /><input type="text" name="CSV FilePath" narrative="CSV full file path to export the list" stage="CSV FilePath" /><input type="text" name="Columns" narrative="Internal column names to be exported provided as a text values separated by comma e.g. Title,Created Date" stage="Columns" /></inputs><onsuccess>d2f174a4-d635-4df0-9a1b-cf3bd812be0f</onsuccess></stage><stage stageid="450608da-f385-412c-bf9e-f392b9599b06" name="End" type="End"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="165" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="43debb62-94d7-4cbe-9c70-3f1712c8dc1f" name="Run PnP_Script" type="SubSheet"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-165" y="-135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path