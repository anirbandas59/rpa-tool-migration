><initialvalue /><private /><alwaysinit /></stage><stage stageid="d5d30a9a-1a70-44f1-8739-ef06936dc9ad" name="Set Window Zoom" type="SubSheetInfo"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><narrative>Sets the window Zoom of the specified instance.</narrative><display x="-195" y="-105" w="180" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="77281444-2c8b-44f2-9816-735078200ec5" name="Start" type="Start"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><loginhibit /><display x="-15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle specifying the instance on which the bounds should be changed." stage="handle" /><input type="number" name="Zoom" narrative="Zoom Percentage to be set for each sheet" stage="Zoom" /><input type="text" name="WorkbookName" narrative="WorkbookName" stage="WorkbookName" /></inputs><onsuccess>ee316a2b-f4cd-43a7-854d-636544a862e8</onsuccess></stage><stage stageid="7ad819ef-1a1f-475a-a581-08dd94a07991" name="End" type="End"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><loginhibit /><display x="-15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="83c0f7d1-8473-4fe0-af80-9a3270ce262b" name="handle" type="Data"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><display x="-240" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="ee316a2b-f4cd-43a7-854d-636544a862e8" name="CheckInstanceHandle" type="SubSheet"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><loginhibit /><display x="-15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" friendlyname="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[WorkbookName]" /></inputs><onsuccess>57a263d6-f68a-4429-bf02-f8c631d3142f</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="57a263d6-f68a-4429-bf02-f8c631d3142f" name="SetWindowZoom" type="Code"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><loginhibit /><display x="-15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="zoom" expr="[Zoom]" /><input type="text" name="WorkbookName" expr="[WorkbookName]" /></inputs><onsuccess>7ad819ef-1a1f-475a-a581-08dd94a07991</onsuccess><code><![CDATA['Dim excel as Object = GetInstance(handle)
'excel.ActiveWindow.Zoom = zoom

Dim excel As Object = GetInstance(handle)
Dim wb As Object = GetWorkbook(Handle, WorkbookName)
Dim sheets as Object = wb.Sheets
If sheets IsNot Nothing Then
For Each sheet as Object in sheets
	sheet.Activate()
	excel.ActiveWindow.Zoom = zoom
Next
End If]]></code></stage><stage stageid="ec889d35-fcc0-4b77-a783-7b451f5bfef5" name="Zoom" type="Data"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><display x="-150" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0eb1b166-21b6-4689-8ac0-3e4eac332e38" name="WorkbookName" type="Data"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><display x="-240" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="37c3f652-3780-4de5-ac17-ffa64a25140a" name="Block10" type="Block"><subsheetid>e48eed6e-115e-49d6-b83d-b69c9d849526</subsheetid><loginhibit /><display x="-300" y="-45" w="195" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d4f671c3-7253-42bf-b214-5e1e258aeee0" name="Text to Columns with Text Qualifier" type="SubSheetInfo"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><narrative>This Page converts the  format as Text to Column for a specified Column with text Qualifier Range And Paste the Formatted data in the Specified Column Range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="28cc26cf-d469-4fd8-816b-a5032a49e629" name="Start" type="Start"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="135" y="-90" /><inputs><input type="text" name="workbook" narrative="(Mandatory)Workbook name" stage="workbook" /><input type="text" name="worksheet" narrative="(Mandatory)WorkSheet name of the Excel File" stage="worksheet" /><input type="number" name="handle" narrative="(Mandatory)handle of open excel" stage="handle" /><input type="text" name="Range" narrative="(Mandatory)Range From Which Convert From Text To Column Occurs. Ex: A1:A100" stage="Range" /><input type="text" name="Cell_Reference" narrative="(Mandatory)Start Cell Reference. Ex: A1" stage="Cell_Ref" /><input type="flag" name="Consecutive Delimiter" narrative="Consecutive Delimiter" stage="Consecutive Delimiter" /><input type="flag" name="Tab" narrative="Tab" stage="Tab" /><input type="flag" name="Semicolon" narrative="Semicolon" stage="Semicolon" /><input type="flag" name="Comma" narrative="Comma" stage="Comma" /><input type="flag" name="Space" narrative="Space" stage="Space" /><input type="flag" name="Other" narrative="Other" stage="Other" /><input type="flag" name="TrailingMinusNumbers" narrative="TrailingMinusNumbers" stage="TrailingMinusNumbers" /><input type="text" name="Other Delimiter if any" narrative="Other Delimiter if any" stage="Other Delimiter if any" /><input type="number" name="TextQualifier" narrative="TextQualifier_Number" stage="TextQualifier" /><input type="text" name="txt_TextQualifier" narrative="txt_TextQualifier" stage="txt_TextQualifier" /></inputs><onsuccess>8465c6dc-0abb-48bf-863a-196ebfaa67b2</onsuccess></stage><stage stageid="e43d3ae4-64f3-42e6-8391-d72bde0ab969" name="End" type="End"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="135" y="135" /></stage><stage stageid="15344155-b36a-4918-aec4-b7edde5f432a" name="workbook" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="726b0717-3e21-4e79-a790-5ce8bb5a202e" name="worksheet" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc9a826e-4adb-4158-85d5-a8aed758eca2" name="handle" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8b0fb93-0677-4aca-9ce1-8bd263cf7833" name="Range" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1de1a5c5-a827-4a8c-8f84-a60d2dc80731" name="Cell_Ref" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b87c1cfa-5d7e-4533-a93c-8b7cd54e95a2" name="Inputs" type="Block"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="-300" y="-15" w="210" h="480" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a518dd63-811b-4a8b-9972-eb60a95d6946" name="Convert Column From Text to Column{Text Qualifier_-4142" type="Code"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="270" y="-15" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="Col_Range" expr="[Range]" /><input type="text" name="Cell_Ref" expr="[Cell_Ref]" /><input type="flag" name="ConsecutiveDelimiter" expr="[Consecutive Delimiter]" /><input type="flag" name="Tab" expr="[Tab]" /><input type="flag" name="Semicolon" expr="[Semicolon]" /><input type="flag" name="Comma" expr="[Comma]" /><input type="flag" name="Space" expr="[Space]" /><input type="flag" name="Other" expr="[Other]" /><input type="flag" name="TrailingMinusNumbers" expr="[TrailingMinusNumbers]" /><input type="number" name="Number" expr="[TextQualifier]" /></inputs><onsuccess>079eebb5-fe72-409a-ab0d-6d64da99c42f</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(Col_Range).TextToColumns( _
        Destination:=.Range(Cell_Ref), _
        DataType:= 1, _
        TextQualifier:= Number, _
        ConsecutiveDelimiter:=ConsecutiveDelimiter, _
        Tab:= Tab, _
        Semicolon:=Semicolon, _
        Comma:=Comma, _
        Space:=Space, _
        Other:=Other, _
        TrailingMinusNumbers:=TrailingMinusNumbers)

End with

]]></code></stage><stage stageid="0abc2e16-7426-4485-9beb-1469dab2f1a0" name="Consecutive Delimiter" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8cf71ab5-033c-4c76-8176-9c60430e19ad" name="Tab" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="089b1cfe-2754-4c29-a9de-6ab204f86f6f" name="Semicolon" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8686bbd8-de31-4b8e-aca9-7704be0e81e6" name="Comma" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="285" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5fe98332-189e-4f84-978f-54466596dd05" name="Space" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="255" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8c090cb-906a-4056-8365-ad4b4ef6d0b2" name="Other" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="345" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6778861d-1526-470e-a38e-8590f28ce692" name="TrailingMinusNumbers" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="315" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="02197f6d-be26-49d0-9f30-466e2570bdb5" name="Other Delimiter if any" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-195" y="375" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8465c6dc-0abb-48bf-863a-196ebfaa67b2" name="Check TextQualifier" type="Decision"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="135" y="-15" w="90" h="60" /><decision expression="[txt_TextQualifier]=&quot;&quot;" /><ontrue>a518dd63-811b-4a8b-9972-eb60a95d6946</ontrue><onfalse>e4570877-6ee8-4e06-a730-3aab4e6a680c</onfalse></stage><stage stageid="079eebb5-fe72-409a-ab0d-6d64da99c42f" name="Anchor2" type="Anchor"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="270" y="135" w="10" h="10" /><onsuccess>e43d3ae4-64f3-42e6-8391-d72bde0ab969</onsuccess></stage><stage stageid="bd897c20-c744-4bd0-a8df-b86c6cf3b3a8" name="TextQualifier" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="15" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83077d93-2730-4249-b94a-b4a72ea98786" name="txt_TextQualifier" type="Data"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><display x="-45" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4570877-6ee8-4e06-a730-3aab4e6a680c" name="Text Qualifer _Text(None-xlNone)" type="Code"><subsheetid>085aeabc-b4e6-4d1e-b648-14d83bb27d15</subsheetid><loginhibit /><display x="135" y="60" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="Col_Range" expr="[Range]" /><input type="text" name="Cell_Ref" expr="[Cell_Ref]" /><input type="flag" name="ConsecutiveDelimiter" expr="[Consecutive Delimiter]" /><input type="flag" name="Tab" expr="[Tab]" /><input type="flag" name="Semicolon" expr="[Semicolon]" /><input type="flag" name="Comma" expr="[Comma]" /><input type="flag" name="Space" expr="[Space]" /><input type="flag" name="Other" expr="[Other]" /><input type="flag" name="TrailingMinusNumbers" expr="[TrailingMinusNumbers]" /><input type="text" name="Text" expr="[txt_TextQualifier]" /></inputs><onsuccess>e43d3ae4-64f3-42e6-8391-d72bde0ab969</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(Col_Range).TextToColumns( _
        Destination:=.Range(Cell_Ref), _
        DataType:= 1, _
        TextQualifier:= Text, _
        ConsecutiveDelimiter:=ConsecutiveDelimiter, _
        Tab:= Tab, _
        Semicolon:=Semicolon, _
        Comma:=Comma, _
        Space:=Space, _
        Other:=Other, _
        TrailingMinusNumbers:=TrailingMinusNumbers)

End with

]]></code></stage><stage stageid="cc74d14d-477d-4277-ad17-dbe2e9f81b0b" name="Autofit Row" type="SubSheetInfo"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><narrative>Change row height and column width for the given range</narrative><display x="-195" y="-150" w="150" h="90" /></stage><stage stageid="76bdaa8e-2387-46de-a41a-23920812d84e" name="Start" type="Start"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Handle" narrative="The integer handle identifying the instance to be closed. Zero indicates the currently active instance." stage="Handle" /><input type="text" name="Workbook" narrative="MS Excel Workbook name" stage="Workbook" /><input type="text" name="Worksheet" narrative="MS Excel Worksheet Name" stage="Worksheet" /></inputs><onsuccess>abd3d05f-a640-4ff9-b849-8945c411f02f</onsuccess></stage><stage stageid="2b5053ea-a80f-4580-ba1c-dca38159c6ac" name="End" type="End"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" narrative="returns error message" stage="Message" /><output type="flag" name="Success" narrative="returns true or false" stage="Success" /></outputs></stage><stage stageid="abd3d05f-a640-4ff9-b849-8945c411f02f" name="Autofiit Row" type="Code"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>0b3d523f-8638-4160-8bd1-09dd4371a030</onsuccess><code><![CDATA[Dim ws as Object

Try
ws = GetWorksheet(Handle,Workbook,Worksheet)
ws.Cells.Select
'ws.Cells.EntireColumn.Autofit
ws.Cells.EntireRow.Autofit


Success = True
Message =""

Catch e as Exception
   Success = False
   Message = e.Message

Finally
   ws = Nothing
End Try ]]></code></stage><stage stageid="b47ba74e-265c-4900-9cbe-34b295276911" name="Handle" type="Data"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea7cdf24-b12a-41fd-88e1-4a8fdf36e9c4" name="Workbook" type="Data"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="-165" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="21462762-e59d-49bf-bb92-116096eba147" name="Worksheet" type="Data"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcb1e2ca-6ddc-4162-a4f4-695fcc73082a" name="Success" type="Data"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="210" y="-30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="ae3339b8-285d-4c8e-948e-867032985fe3" name="Message" type="Data"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="210" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="41bc7ebe-cae5-4389-8604-13d966e3c113" name="Inputs" type="Block"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="-210" y="-45" w="90" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="976e1035-a7f0-4d08-b036-551b71ea065f" name="Outputs" type="Block"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="165" y="-60" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0b3d523f-8638-4160-8bd1-09dd4371a030" name="Success" type="Decision"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><loginhibit /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>2b5053ea-a80f-4580-ba1c-dca38159c6ac</ontrue><onfalse>dfc5d64d-e970-415d-b2df-09d18f953431</onfalse></stage><stage stageid="dfc5d64d-e970-415d-b2df-09d18f953431" name="Throw" type="Exception"><subsheetid>a0ca82c9-e441-404a-98af-8b57a6faa5d7</subsheetid><display x="105" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="910a3f39-9fbe-4c2d-b610-11ee5070bda0" name="Set Cell Formula - Formula2R1C1" type="SubSheetInfo"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><narrative>Sets the specified Formula to the given value.
This has the side-effect of setting the active cell to that which is specified here.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="0b9d44a5-8421-4d91-8151-0bf6fe75c35b" name="Start" type="Start"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><loginhibit /><display x="15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." stage="cellref" /><input type="text" name="Formula" narrative="The value to which the specified cell should be set." stage="Formula" /></inputs><onsuccess>1d67756c-8075-439f-859b-ba9168ba99d7</onsuccess></stage><stage stageid="0510c667-a285-4d3f-8dfd-5aef72a6a7fc" name="End" type="End"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><loginhibit /><display x="15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="fa8cd779-5313-41d5-8344-5c7761ee6ace" name="cellref" type="Data"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2936a79-4d05-403e-a7bd-315f90bc1eca" name="Formula" type="Data"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><display x="-195" y="60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="403fc0be-b747-4e55-87c6-42630388bece" name="Set Cell Formula  - Formula2R1C1" type="Code"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="cellref" expr="[cellref]" /><input type="text" name="Formula" expr="[Formula]" /></inputs><onsuccess>0510c667-a285-4d3f-8dfd-5aef72a6a7fc</onsuccess><code><![CDATA[GetInstance(handle).ActiveCell.Formula2R1C1 = Formula]]></code></stage><stage stageid="1d67756c-8075-439f-859b-ba9168ba99d7" name="Go To Cell" type="SubSheet"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Cell Reference" expr="[cellref]" /></inputs><onsuccess>403fc0be-b747-4e55-87c6-42630388bece</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="44b61e63-f522-43c6-8369-1ade2ff11d2c" name="handle" type="Data"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="d76c5efd-1ee5-410c-8f26-e88dcccf21a9" name="Recover3" type="Recover"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><loginhibit /><display x="270" y="-90" /><onsuccess>160fb1f3-7103-4a60-a65f-86c146609392</onsuccess></stage><stage stageid="160fb1f3-7103-4a60-a65f-86c146609392" name="Exception1" type="Exception"><subsheetid>909215c2-3dfc-49b9-a434-92ee4ce07ef9</subsheetid><display x="270" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="c9d43c71-1058-42e9-ba2e-daca3b934a27" name="Fill empty cells with previous non-empty value" type="SubSheetInfo"><subsheetid>9f3032ff-4df1-40ae-9315-1d176dc46811</subsheetid><narrative>Fill empty cells with previous non-empty value

