5b" name="Workbook Name" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-300" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="528c4b5c-9625-4740-a603-87374966f01f" name="worksheet name" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><loginhibit /><display x="-300" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9f4fac82-5d5a-4c46-a717-165a649aaa57" name="Range" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-300" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b08e7a71-8254-45dc-bd07-cd8fbecc17de" name="Value" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-300" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82097644-1901-493c-95c3-e86fa2550a77" name="Excel Find Required Word" type="Code"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="Worksheet" expr="[worksheet name]" /><input type="text" name="Range" expr="[Range]" /><input type="text" name="Value" expr="Trim([Value])" /><input type="number" name="Handle" expr="[handle]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="FindCount" stage="Cell Value" /></outputs><onsuccess>a948ea76-73c9-45e3-9553-23c0ca194477</onsuccess><code><![CDATA[
FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range("A1").Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try

]]></code></stage><stage stageid="b8688305-1c5b-4d03-bd32-2080e584a050" name="Success" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-135" y="15" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b85b4b3c-7938-491c-9d70-3168fea67621" name="Message" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-135" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fe8243d5-c1d5-4cc3-8556-6303618afd92" name="Cell Value" type="Data"><subsheetid>59043dec-68ec-49ba-a550-4e71f5de4f37</subsheetid><display x="-135" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="69d355bf-67dc-434e-a85c-e1e9c791aefe" name="Apply Two Filters in Single Column" type="SubSheetInfo"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><narrative>Apply Two Filters in Single Column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="21cbc992-22c4-48de-8c25-d4d3d467e173" name="Start" type="Start"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Excel Name" stage="Workbook" /><input type="text" name="Worksheet" narrative="Excel Worksheet Name" stage="Worksheet" /><input type="number" name="Handle" narrative="Handle Number" stage="Handle" /><input type="number" name="Field" narrative="Column Name" stage="vField" /><input type="text" name="vCriteria1" narrative="Filter Value1" stage="vCriteria1" /><input type="text" name="vCriteria2" narrative="Filter Value2" stage="vCriteria2" /><input type="number" name="vOperator" narrative="Operator Value (Example - 2)" stage="vOperator" /><input type="text" name="Reference" narrative="Range - cell reference" stage="Reference" /></inputs><onsuccess>2af3f4a9-4212-48b3-bf49-e7d6184e7c17</onsuccess></stage><stage stageid="65e288fd-7025-4081-96a5-27956cbe5a53" name="End" type="End"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="2af3f4a9-4212-48b3-bf49-e7d6184e7c17" name="Apply multi filter - range - code" type="Code"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="vField" expr="[vField]" /><input type="text" name="vCriteria1" expr="[vCriteria1]" /><input type="text" name="vCriteria2" expr="[vCriteria2]" /><input type="number" name="vOperator" expr="[vOperator]" /><input type="text" name="Reference" expr="[Reference]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>d041c22f-acb3-4885-8427-4210354ad057</onsuccess><code><![CDATA[Dim wb,ws,sheet,excel,range As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
sheet.Range(Reference).AutoFilter(Field:=vField, Criteria1:= "=" & vCriteria1, Operator:=vOperator, Criteria2:= "=" &vCriteria2)

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try]]></code></stage><stage stageid="f4a1a4a3-5a7f-4120-a6a4-c1485e2b6ad1" name="Message" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3f29766d-b967-43f4-a09e-c631d4822774" name="Success" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b6fd8fc9-109a-487c-a309-fedb7577eaad" name="Workbook" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f4edd829-050c-4b34-be58-b871d28524f9" name="Handle" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7d806f24-47b9-45a6-ae70-9ea79f265f5a" name="Worksheet" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="457ae1df-d548-4214-8568-4831f0f9b190" name="vField" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="77745053-a14e-4ef9-9270-54b7b6d43ac1" name="vCriteria1" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52358d1d-e689-4385-954f-d3ffb0691284" name="Reference" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fca2ebcb-4d5f-484d-9471-3d1a71e2b3ed" name="Inputs" type="Block"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-270" y="-30" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="b5681a05-7de0-4fb3-8849-852a9d85abae" name="Stage3" type="Block"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-90" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8afb7cd0-6866-4e43-9859-7e75af42fe34" name="Throw Exception" type="Exception"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="d041c22f-acb3-4885-8427-4210354ad057" name="Check Success?" type="Decision"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>65e288fd-7025-4081-96a5-27956cbe5a53</ontrue><onfalse>8afb7cd0-6866-4e43-9859-7e75af42fe34</onfalse></stage><stage stageid="06b71170-85ad-4a1d-b6eb-b842aaf11b91" name="vCriteria2" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fe5185dd-9381-4037-b999-3e642818f685" name="vOperator" type="Data"><subsheetid>ff30e618-1a15-4676-817b-2765bbdedc0b</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="210" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="197fad1c-d389-4f9a-bf60-7e28c161142d" name="Excel to Word (Retaining Format)" type="SubSheetInfo"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><narrative>Object to Copy Excel Cell to Word bookmark retaining the format</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="426f9f37-bf3a-4a86-94bc-32db889fd054" name="Start" type="Start"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Workbook Name" narrative="Excel Workbook to Open" stage="Workbook_Name" /><input type="text" name="Column Name" narrative="Excel Column to Find Last Row" stage="Column_Name" /><input type="number" name="Cell Value" narrative="Cell to be copied" stage="Cell_Value" /><input type="text" name="Document Name" narrative="Word Document to Open" stage="Document_Name" /><input type="text" name="Bookmark Name" narrative="Word Bookmark to paste from clipboard" stage="Bookmark_Name" /><input type="text" name="Sheet Name" narrative="Sheet Name" stage="Sheet_Name" /></inputs><onsuccess>cd0a297c-cc51-4b72-8060-35262ea4c9fb</onsuccess></stage><stage stageid="519553e2-3ec1-4ecc-a74e-e42ad73e05f7" name="End" type="End"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="15" y="120" /></stage><stage stageid="cd0a297c-cc51-4b72-8060-35262ea4c9fb" name="Excel - Copy Cell to Clipboard" type="Code"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="60" /><inputs><input type="text" name="WorkbookName" expr="[Workbook_Name]" /><input type="text" name="ColumnName" expr="[Column_Name]" /><input type="text" name="CellValue" expr="[Cell_Value]" /><input type="text" name="SheetName" expr="[Sheet_Name]" /></inputs><onsuccess>8fcaeea2-f3c5-4533-9f3c-8d67f4373efc</onsuccess><code><![CDATA[
Dim wb, ws As Object
'Dim sn as Object
Dim excel, sheet, range as Object

My.Computer.Clipboard.Clear()

wb = CreateObject("Excel.application")
wb.Visible = True
ws = wb.Workbooks.Open(WorkbookName)
'sn = ws.Worksheets(SheetName).Select



excel = ws.Application
sheet = excel.Worksheets(SheetName)
Sheet.select 

range = sheet.Range(ColumnName & CellValue, ColumnName & CellValue)
range.Select()
range.Copy()
wb.DisplayAlerts = False
wb.Quit()
wb.DisplayAlerts = True



]]></code></stage><stage stageid="247cfc90-3eb6-4427-82f4-5dfedd15e66e" name="Workbook_Name" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="255" y="-60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e11767c3-4ec7-4f56-a8d4-9832e5288653" name="Column_Name" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="255" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8fcaeea2-f3c5-4533-9f3c-8d67f4373efc" name="Word- Paste Copied Cell from Clipboard to Bookmark" type="Code"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="15" y="30" w="150" h="60" /><inputs><input type="text" name="DocumentName" expr="[Document_Name]" /><input type="text" name="BookmarkName" expr="[Bookmark_Name]" /></inputs><onsuccess>519553e2-3ec1-4ecc-a74e-e42ad73e05f7</onsuccess><code><![CDATA[Dim wd As Object
Dim doc As Object

wd = CreateObject("Word.application")
wd.Visible = True
doc = wd.Documents.Open(DocumentName)

doc.Bookmarks.Item(BookmarkName).Select
wd.selection.PasteSpecial(,)
doc.SaveAs(DocumentName)
doc.close()
wd.Quit()

doc=nothing
wd=nothing



    ]]></code></stage><stage stageid="d9f7c545-522b-4c99-bd5f-24c5db01d988" name="Bookmark_Name" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="420" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12037fb0-99cb-486c-a971-fb92f7b46227" name="Document_Name" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="420" y="-60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="390e3c30-8dee-4f55-8a5c-d68ea80be583" name="Cell_Value" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="255" y="75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4e92f5af-85a5-4621-97a5-fd3ddaf3846e" name="Sheet_Name" type="Data"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="255" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7127af3b-9024-4965-826e-103b08e76e18" name="Excel Inputs" type="Block"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="195" y="-105" w="120" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="125435e8-9e1e-4d05-9ca3-268f3050f7ff" name="Word Inputs" type="Block"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="360" y="-105" w="120" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2ad47869-5ef0-456b-83c5-5aa7ef8c0007" name="Recover" type="Recover"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><loginhibit /><display x="-225" y="30" /><onsuccess>a5bf0103-6fba-4964-b673-559d1445cfac</onsuccess></stage><stage stageid="a5bf0103-6fba-4964-b673-559d1445cfac" name="Exception" type="Exception"><subsheetid>14dcaf2d-1a45-45bc-aa21-ef9deae49b00</subsheetid><display x="-225" y="120" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="e02992c2-6061-4cbc-9e8e-2bf6ee1fcbf0" name="Excel to Word (Retaining Format)" type="SubSheetInfo"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><narrative>Object to Copy Excel Range to Word bookmark retaining the format</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="80b50b42-52d0-40f2-a208-9f8d9a44c23c" name="Start" type="Start"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Workbook Name" narrative="Excel Workbook to Open" stage="Workbook_Name" /><input type="text" name="Column Name" narrative="Excel Column to Find Last Row" stage="Column_Name" /><input type="number" name="Row_Start" narrative="Start Value of Cell to be Copied" stage="Row_Start" /><input type="text" name="Document Name" narrative="Word Document to Open" stage="Document_Name" /><input type="text" name="Bookmark Name" narrative="Word Bookmark to paste from clipboard" stage="Bookmark_Name" /><input type="text" name="Sheet Name" narrative="Sheet Name" stage="Sheet_Name" /></inputs><onsuccess>8b82446a-851e-4140-85a6-3295fd32acfd</onsuccess></stage><stage stageid="f97adbb0-c62e-4d26-a71f-98fc2b1d44da" name="End" type="End"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="15" y="120" /></stage><stage stageid="8b82446a-851e-4140-85a6-3295fd32acfd" name="Excel - Copy Range to Clipboard" type="Code"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="60" /><inputs><input type="text" name="WorkbookName" expr="[Workbook_Name]" /><input type="text" name="ColumnName" expr="[Column_Name]" /><input type="text" name="RowStart" expr="[Row_Start]" /><input type="text" name="SheetName" expr="[Sheet_Name]" /></inputs><onsuccess>e46d73c7-c241-4704-aaf9-c5ba4fd9fcd6</onsuccess><code><![CDATA[
Dim wb, ws As Object
'Dim sn as Object
Dim excel, sheet, range as Object
Dim rowcount as object

'My.Computer.Clipboard.Clear()

wb = CreateObject("Excel.application")
wb.Visible = True
ws = wb.Workbooks.Open(WorkbookName)
'sn = ws.Worksheets(SheetName).Select



excel = ws.Application
sheet = excel.Worksheets(SheetName)
Sheet.select 
'rowcount = sn.Cells.Find("*", , , , , 2).Row
rowcount = sheet.UsedRange.Rows.Count

range = sheet.Range(ColumnName & RowStart, ColumnName & (rowcount+3))
range.Select()
range.Copy()
wb.DisplayAlerts = False
wb.Quit()
wb.DisplayAlerts = True



]]></code></stage><stage stageid="943b377b-0ebd-472d-a1f6-d1297af3a83c" name="Workbook_Name" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="255" y="-60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0fb165e1-49f7-4581-8961-a85341ca7471" name="Column_Name" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="255" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e46d73c7-c241-4704-aaf9-c5ba4fd9fcd6" name="Word- Paste from Clipboard to Bookmark" type="Code"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="15" y="30" w="150" h="60" /><inputs><input type="text" name="DocumentName" expr="[Document_Name]" /><input type="text" name="BookmarkName" expr="[Bookmark_Name]" /></inputs><onsuccess>f97adbb0-c62e-4d26-a71f-98fc2b1d44da</onsuccess><code><![CDATA[Dim wd As Object
Dim doc As Object

wd = CreateObject("Word.application")
wd.Visible = True
doc = wd.Documents.Open(DocumentName)

doc.Bookmarks.Item(BookmarkName).Select
wd.selection.PasteSpecial(,)
doc.SaveAs(DocumentName)
doc.close()
wd.Quit()

doc=nothing
wd=nothing



    ]]></code></stage><stage stageid="f722bb0f-7ae5-4a60-a1b0-3fe0dacf7ae7" name="Bookmark_Name" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="420" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c405bf51-c9b8-470a-a7fe-840870f02f15" name="Document_Name" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="420" y="-60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0af6ef6e-7073-419f-873a-a5c43602fa71" name="Row_Start" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="255" y="75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d18f3f11-6fb9-4d33-b4b3-0b3e003102a8" name="Sheet_Name" type="Data"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="255" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1c148e93-656a-4fd2-a617-6f73f9555c6c" name="Excel Inputs" type="Block"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="195" y="-105" w="120" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="af580917-a294-42ec-a616-4aeed7cc4342" name="Word Inputs" type="Block"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="360" y="-105" w="120" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e387b40c-2b5b-4423-a121-b004218a5886" name="Recover" type="Recover"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><loginhibit /><display x="-225" y="30" /><onsuccess>ef2328de-ed59-426e-8517-2dab77e3d373</onsuccess></stage><stage stageid="ef2328de-ed59-426e-8517-2dab77e3d373" name="Exception" type="Exception"><subsheetid>f8fa49e4-a62a-4eb1-a31b-5a1cf07f389a</subsheetid><display x="-225" y="120" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="610e8277-1251-4aa8-b745-536042baab83" name="Rename worksheet - (with parameters)" type="SubSheetInfo"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><narrative>Activates / Creates the worksheet specified by the given parameters 

Params:
- handle : Number : The instance handle;
- Workbook Name : Text : is the name of the workbook on which the sheet resides / should be created;
- Sheet name : Text : The name of the worksheet
- Create If Missing? : Flag : Indicates if the worksheet should be created if one with that name doesn't exist on the workbook - if missing, it will *not* create it.

Exceptions: 
- Bad Handle : If the given handle did not correspond to an instance.
- Workbook Not Found : If the given workbook did not exist on the specified instance.
- Worksheet Not Found : If the given worksheet did not exist on the specified workbook.</narrative><display x="-285" y="-165" w="420" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="cd5713b8-583c-4a47-8066-f96d1255b9c2" name="End" type="End"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="39601fc0-1938-4827-8e0f-a7e413983754" name="handle" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-300" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="57452c62-b5a6-4b9c-8c5c-d0a41bf0496e" name="workbookname" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-300" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="36f19f11-e0d8-4401-82d7-b2147d10602e" name="Start" type="Start"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-225" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet which should be activated resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook in which the sheet exists - The default empty value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the sheet which should be activated. The default empty text value indicates that the currently active sheet should be, er, activated, making this a no-op." stage="worksheetname" /><input type="flag" name="Create If Missing?" narrative="True to create the sheet if it isn't present on the specified workbook; False to not do so." stage="createifmissing" /><input type="text" name="NewName" stage="newName" /></inputs><onsuccess>ab98d6f0-a7ae-4125-86d6-32a1b180ab6f</onsuccess></stage><stage stageid="777542f5-5f26-4c7e-bf92-bcb95c3dd3c8" name="Rename Custom Worksheet" type="Code"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="flag" name="createifmissing" expr="[createifmissing]" /><input type="text" name="newName" expr="[newName]" /></inputs><outputs><output type="flag" name="sheetexists" stage="sheetexists" /></outputs><onsuccess>fd2458d4-15c6-4cb7-80d2-ddfd354e896f</onsuccess><code><![CDATA[
Dim ws as Object = GetWorksheet(handle,workbookname,worksheetname,createifmissing)
sheetexists = ws IsNot Nothing 
If sheetexists then ws.Activate()
wS.Name = newName]]></code></stage><stage stageid="ab98d6f0-a7ae-4125-86d6-32a1b180ab6f" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-165" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>777542f5-5f26-4c7e-bf92-bcb95c3dd3c8</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="4597fe50-9b94-42fe-a45e-7a6b62303316" name="worksheetname" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c0c9aa8d-5c69-41a8-8faf-377453bb296c" name="createifmissing" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="5cc1ae4c-8f07-4633-bfbd-abab6e4938fc" name="sheetexists" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd2458d4-15c6-4cb7-80d2-ddfd354e896f" name="Sheet Existed?" type="Decision"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[sheetexists]" /><ontrue>cd5713b8-583c-4a47-8066-f96d1255b9c2</ontrue><onfalse>6ad14b18-f459-489e-9218-e67730a3d04f</onfalse></stage><stage stageid="6ad14b18-f459-489e-9218-e67730a3d04f" name="No Such Sheet" type="Exception"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="150" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Worksheet Not Found" detail="&quot;No worksheet was found with the name '&quot; &amp; [worksheetname] &amp; &quot;' on the workbook '&quot; &amp; [workbookname] &amp; &quot;' within the instance with the handle: &quot; &amp; [handle]" /></stage><stage stageid="2553fa9e-434b-4869-a097-0dfd5fa04410" name="newName" type="Data"><subsheetid>a5ed4bbf-0612-4321-86c9-351763c7e44b</subsheetid><loginhibit onsuccess="true" /><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b1938567-664c-493f-a9a1-b9dbf5b764c9" name="Filter Multiple Wildcard" type="SubSheetInfo"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><narrative>Apply Multiple Value Filtering in single Column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a9f8b474-e690-45e5-b014-8f844e876cb1" name="Start" type="Start"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-105" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="workbookName" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookName" /><input type="text" name="startCell" narrative="Cell Reference From Which Filter Should Apply" stage="startCell" /><input type="number" name="coloumn" narrative="Column Number To which Filter Should Apply" stage="coloumn" /><input type="text" name="filterValues" narrative="Values to fileter seprated by Comma ','" stage="filterValues" /><input type="number" name="xlAutoFilterOperator" narrative="xlAutoFilterOperator" stage="xlAutoFilterOperator" /></inputs><onsuccess>0074a7ec-79e6-4a87-b261-9c4a5084f366</onsuccess></stage><stage stageid="2838b746-74fd-4c6c-964c-25d968765c19" name="End" type="End"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="75" y="30" /><outputs><output type="flag" name="success" narrative="Whether the operation was performed successfully" stage="success" /><output type="text" name="message" narrative="Error Message If Any" stage="message" /></outputs></stage><stage stageid="0074a7ec-79e6-4a87-b261-9c4a5084f366" name="FilterMultiple Wildcard Values" type="Code"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-60" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbookName]" /><input type="number" name="column" expr="[coloumn]" /><input type="text" name="StartCell" expr="[startCell]" /><input type="text" name="filterValues" expr="[filterValues]" /><input type="number" name="xlAutoFilterOperator" expr="[xlAutoFilterOperator]" /></inputs><outputs><output type="flag" name="Success" stage="success" /><output type="text" name="Message" stage="message" /></outputs><onsuccess>e27f5edf-9f9d-4203-b924-745fa44fda32</onsuccess><code><![CDATA[Dim wb, excel, range As Object
'Dim arrFilter = tblFilter.AsEnumerable().[Select](Function(row) row.Field(Of String)(columnName)).ToArray()
'Dim arrFilter As String() = New String() {"X1", "X2"}

'Dim lstFilter As String() = tblFilter.ToArray()
'for each (DataRow dr in tblFilter.Enumurarble()

'Dim arrFilter As String() =BPCodeUtility.CodeUtility.ConvertDataTableToArray(tblFilter,"Values")
Dim arrFilter As String() = filterValues.Split(","C)
Try

wb = GetWorkbook(Handle, Workbook)
excel = wb.Application
range = excel.Selection
excel.Range(StartCell).Select()
'excel.Selection.AutoFilter(Field:=Column,Criteria1:=criteria1)
excel.Selection.AutoFilter(Field:=Column,Criteria1:=arrFilter,Operator:=xlAutoFilterOperator)
Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try ]]></code></stage><stage stageid="2a71f439-1ce5-41ac-a716-bbf766281f22" name="handle" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-225" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6579ad1b-80ad-4831-b230-b1e78ea7f70b" name="workbookName" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="911db8b4-0d0a-4d8d-ae32-abc658ddbc28" name="message" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="390" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4e3441df-e673-4a6d-874e-72e2054cf1fc" name="success" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="315" y="-60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e636c854-d28b-4f3b-ad14-742afc97c8bc" name="filterValues" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f2a5c277-e70a-4f2d-8970-1805bcf82b02" name="coloumn" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e27f5edf-9f9d-4203-b924-745fa44fda32" name="Success?" type="Decision"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[success]" /><ontrue>2838b746-74fd-4c6c-964c-25d968765c19</ontrue><onfalse>62c33fcd-436e-4036-ade5-27b93faf30d0</onfalse></stage><stage stageid="62c33fcd-436e-4036-ade5-27b93faf30d0" name="Exception" type="Exception"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="180" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Business Exception" detail="[message]" /></stage><stage stageid="990609b9-6ebb-4ecf-9b63-e44579dc4be6" name="startCell" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be4daca5-888c-4b45-88a1-5547185f1478" name="xlAutoFilterOperator" type="Data"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="30" /><datatype>number</datatype><initialvalue>7</initialvalue><private /><alwaysinit /></stage><stage stageid="92a84ff2-adaf-404a-8ca3-0c6e4255bb0a" name="Inputs" type="Block"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit /><display x="-300" y="-45" w="285" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="89813912-604d-4dfc-b5a4-20f47580674b" name="Output" type="Block"><subsheetid>4e0edc17-586f-43d5-889c-c84088b56a52</subsheetid><loginhibit /><display x="270" y="-90" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="78c5eb72-52d3-4900-94c7-d03146261a9b" name="Color Range" type="SubSheetInfo"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><narrative>Coloring of cells with color index as input</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5681f725-211c-47a8-88c0-29400db259b2" name="End" type="End"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="90" /></stage><stage stageid="e4cfc684-c076-45cb-8fb8-b9bdc45645a9" name="Font Color Range" type="Code"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Reference]" /><input type="text" name="CI" expr="[Color Index]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>b7e615c3-a08f-411c-9d11-89d79f78bb34</onsuccess><code><![CDATA[Dim wb,ws,excel,range As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

ws.Range(Reference).Font.ColorIndex  = CI

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="519ac4b9-498e-4cc3-8e23-0b7ef2482569" name="Throw Exception" type="Exception"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="b7e615c3-a08f-411c-9d11-89d79f78bb34" name="Check Success?" type="Decision"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>5681f725-211c-47a8-88c0-29400db259b2</ontrue><onfalse>519ac4b9-498e-4cc3-8e23-0b7ef2482569</onfalse></stage><stage stageid="9cfc8d8b-dbd2-4eab-a6aa-e8664e8b12ef" name="Color Index" type="Data"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6bf4752b-7b33-482d-b805-18fee413232e" name="Message" type="Data"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a0768b5c-3bd2-489b-a6b4-96648ee3157e" name="Success" type="Data"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d3293c88-8a2c-48da-80b9-e5cebbfe7638" name="Workbook" type="Data"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0ea50b3a-83fb-4541-a0e9-47feb142b6ca" name="Handle" type="Data"><subsheetid>ccd55dce-6047-4ef8-ae90-e65bf66930d8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" /><datatype>number</datatype><initialvalue />