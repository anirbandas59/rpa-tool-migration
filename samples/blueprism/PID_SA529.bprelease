]]></code></stage><stage stageid="fdc4af19-968c-4c4e-8ee9-752877a40a33" name="handle" type="Data"><subsheetid>9e3ab9b7-bf72-4d14-a839-e0e56de7aeaf</subsheetid><display x="-135" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="74912bf6-c232-4052-9a10-ad6941723f28" name="workbookname" type="Data"><subsheetid>9e3ab9b7-bf72-4d14-a839-e0e56de7aeaf</subsheetid><display x="-135" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6c5ec5f8-ae9a-4809-9c05-c0181275630b" name="Row Range" type="Data"><subsheetid>9e3ab9b7-bf72-4d14-a839-e0e56de7aeaf</subsheetid><display x="-135" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea980d71-a2e4-4303-ae13-4b1f40ffab0f" name="SheetName" type="Data"><subsheetid>9e3ab9b7-bf72-4d14-a839-e0e56de7aeaf</subsheetid><display x="-270" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3be59c89-a522-49a3-9b18-abfade4aea5a" name="HideRows?" type="Data"><subsheetid>9e3ab9b7-bf72-4d14-a839-e0e56de7aeaf</subsheetid><loginhibit /><display x="-135" y="135" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /></stage><stage stageid="03cb3ae5-49e4-446a-aa5a-62641400efe6" name="Get Worksheet Names" type="SubSheetInfo"><subsheetid>9555cc99-77e3-4ff6-98dc-c5c01124e290</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="5af5fcf4-aac5-4a05-a837-6ee549692b0c" name="End" type="End"><subsheetid>9555cc99-77e3-4ff6-98dc-c5c01124e290</subsheetid><loginhibit /><display x="150" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Row Number" stage="Row Number" /></outputs></stage><stage stageid="9e5855fa-21bb-4771-918e-66d904b2f8c0" name="Start" type="Start"><subsheetid>9555cc99-77e3-4ff6-98dc-c5c01124e290</subsheetid><loginhibit /><preconditions><condition narrative="This Object will find on a Range and then gert the row number" /></preconditions><display x="150" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet" narrative="Name of Worksheet" stage="Worksheet" /><input type="text" name="Search String" narrative="String to find in range" stage="strSearch" /><input type="text" name="Range" narrative="Worksheet Range" stage="Range" /></inputs><onsuccess>0bdf1b9c-cdc0-46cb-847d-d39cc66d1a1f</onsuccess></stage><stage stageid="0bdf1b9c-cdc0-46cb-847d-d39cc66d1a1f" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>9555cc99-77e3-4ff6-98dc-c5c01124e290</subsheetid><loginhibit /><display x="150" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>a3fe2022-9906-4b0b-883b-669eba6745ae</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="a3fe2022-9906-4b0b-883b-669eba6745ae" name="FindRow" type="Code"><subsheetid>9555cc99-77e3-4ff6-98dc-c5c01124e290</subsheetid><loginhibit /><display x="150" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="SheetName" expr="[Worksheet]" /><input type="text" name="strSearch" expr="[strSearch]" /><input type="text" name="Range" expr="[Range]" /></inputs><outputs><output type="number" name="Row Number" stage="Row Number" /></outputs><onsuccess>5af5fcf4-aac5-4a05-a837-6ee549692b0c</onsuccess><code><![CDATA[Dim wb As Object = GetWorkbook(Handle, WorkbookName)
Dim sheets as Object = wb.Sheets(SheetName)
Dim rng1 As Object
    
    
    rng1 = sheets.Range(Range).Find(strSearch, , -4163, 1)
    If Not rng1 Is Nothing Then
        Row_Number= rng1.Offset(0, 0).Row
