ws.Activate()
ws.Range(CellRef,CellRef).Activate()]]></code></stage><stage stageid="d8e8a236-74e6-49c9-b9ab-b97dbb27b9f8" name="worksheetname" type="Data"><subsheetid>df18b1b2-f7ef-41ab-932c-09138dc3bc41</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a5c709b-0ce6-461c-aee7-6801457ca029" name="cellRef" type="Data"><subsheetid>df18b1b2-f7ef-41ab-932c-09138dc3bc41</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="98c76125-9d26-4226-87ae-809f3e812f15" name="Merged cell range" type="SubSheetInfo"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><narrative>Merging cell range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="412312f0-4742-4321-b9c8-babaa92d5ce5" name="Start" type="Start"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="workbookname" narrative="workbookname" stage="workbookname" /><input type="text" name="worksheetname" narrative="worksheetname" stage="worksheetname" /><input type="text" name="Range" narrative="Range" stage="Range" /></inputs><onsuccess>2ba15076-2d33-48d8-8da1-3b9a59dd28ab</onsuccess></stage><stage stageid="c029e3b8-7719-4508-aab7-02f0f524c0e2" name="End" type="End"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="15" y="90" /><outputs><output type="flag" name="Success" narrative="Success flag" stage="Success " /></outputs></stage><stage stageid="2ba15076-2d33-48d8-8da1-3b9a59dd28ab" name="MergecellRange" type="Code"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Cell_Range" expr="[Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success " /></outputs><onsuccess>c029e3b8-7719-4508-aab7-02f0f524c0e2</onsuccess><code><![CDATA['Dim ws as Object = GetWorksheet(handle,workbookname,worksheetname)
'MA = ws.Range(Range1).MergeArea.Rows.count
Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
Const xlCenter = -4108
ws.Activate()

Try

GetInstance(handle).DisplayAlerts = False
ws.Range(Cell_Range).Select()
ws.Range(Cell_Range).Merge()
ws.Range(Cell_Range).HorizontalAlignment = xlCenter

GetInstance(handle).DisplayAlerts = True

Success = True



Catch e As Exception

                Success = False

                'Message = e.Message

                

End Try
]]></code></stage><stage stageid="a8cab997-25af-46ea-ac44-f95746b3b951" name="handle" type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eef855e1-8d9f-4ce5-91a6-794de8a0167b" name="workbookname" type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="-120" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0add1d26-6c33-4282-b860-c48b84634c64" name="worksheetname" type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f8e2d4a8-d926-45bb-9f17-248067683685" name="Range" type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="974965ed-ac9b-4e6f-85f6-17961c0742ac" name="MA" type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><loginhibit onsuccess="true" /><display x="225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="030c672c-b6f6-4c51-b2bd-4c8ca3eb7e10" name="Success " type="Data"><subsheetid>f36f861d-4b74-4dcb-bf9d-fefd08858c71</subsheetid><display x="255" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c8b65adc-adf3-43f2-8f5b-6cdb840e2e79" name="Copy Filtered Rows" type="SubSheetInfo"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><narrative>Pastes the filtered values into destination active cell</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="863b49b7-0524-4461-9176-00dc3c69b62a" name="Start" type="Start"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="number" name="Handle" narrative="Handle" stage="Handle" /><input type="text" name="Workbook1" narrative="Workbookof source" stage="Workbook1" /><input type="text" name="Worksheet1" narrative="worksheet of source" stage="Worksheet1" /><input type="text" name="Workbook2" narrative="destination workbook" stage="Workbook2" /><input type="text" name="Worksheet2" narrative="destination worksheet" stage="Worksheet2" /></inputs><onsuccess>aacd48dd-2df1-4880-b95e-28a0a7cb3025</onsuccess></stage><stage stageid="c2e15598-8c6c-40ea-8ae9-d96a3319bed9" name="End" type="End"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="aacd48dd-2df1-4880-b95e-28a0a7cb3025" name="Copy filtered rows code" type="Code"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook1" expr="[Workbook1]" /><input type="text" name="Worksheet1" expr="[Worksheet1]" /><input type="text" name="Workbook2" expr="[Workbook2]" /><input type="text" name="Worksheet2" expr="[Worksheet2]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>5d7d1913-67cd-43f5-8977-f63adc8581d4</onsuccess><code><![CDATA[Dim wb1, ws1, wb2, ws2 As Object
Dim excel, sheet, range As Object

Try
	
wb1 = GetWorkbook(Handle, Workbook1)
ws1 = GetWorksheet(Handle, Workbook1, Worksheet1)

wb2 = GetWorkbook(Handle, Workbook2)
ws2 = GetWorksheet(Handle, Workbook2, Worksheet2)

wb1.Activate()
ws1.Activate()

excel = ws1.Application
sheet = excel.ActiveSheet
range = sheet.UsedRange.select

range = sheet.UsedRange.Copy
	
wb2.Activate()
ws2.activate()
ws2.paste()
	
My.Computer.Clipboard.Clear()

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb1 = Nothing		
	ws1 = Nothing

	wb2 = Nothing		
	ws2 = Nothing

	excel = Nothing
	sheet = Nothing
	range = Nothing
End Try
]]></code></stage><stage stageid="da729e26-7fb7-4f77-84cf-f050d0ac2d2c" name="Success" type="Data"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="240" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8e416bb7-8afd-47b5-902a-ae84b1edeae8" name="Message" type="Data"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="240" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7206c89a-0e7a-4dc8-8c48-f2e265435322" name="Handle" type="Data"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="-135" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="475053ad-19e0-4c23-be9a-0cffff54ee14" name="Throw Exception" type="Exception"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="5d7d1913-67cd-43f5-8977-f63adc8581d4" name="Check Success?" type="Decision"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>c2e15598-8c6c-40ea-8ae9-d96a3319bed9</ontrue><onfalse>475053ad-19e0-4c23-be9a-0cffff54ee14</onfalse></stage><stage stageid="cf45ab77-550c-4356-a722-cecb0bf402ce" name="Workbook1" type="Data"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="-135" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="db6237ff-3587-49cf-85cb-03bf17665b1a" name="Worksheet1" type="Data"><subsheetid>126b8264-c142-4e8a-bbde-92bcf16c72b1</subsheetid><loginhibit onsuccess="true" /><display x="-135" y="60" /><datatype>text</datatype><initialvalue /><priv