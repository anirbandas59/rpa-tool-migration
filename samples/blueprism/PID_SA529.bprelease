0cd5bd1b</subsheetid><display x="-390" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac4d2f22-a5a9-4322-b5e3-ac77a00b9879" name="Item_ID" type="Data"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><display x="-180" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1740f6b-6a87-450e-82a7-81241aee777c" name="Case_Sensitive" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-150" y="-15" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="3b79d6db-43ed-4487-baea-edfcc782db57" name="Check_CaseSensitivity = False" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="375" /><decision expression="[Case_Sensitive]= False" /><ontrue>786e6fd0-8898-41f6-b81e-8046fc10681d</ontrue><onfalse>2a7d9377-42b1-463d-bb38-f546895112c1</onfalse></stage><stage stageid="2a7d9377-42b1-463d-bb38-f546895112c1" name="Anchor11" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="180" y="375" w="10" h="10" /><onsuccess>4be42f72-8084-43bc-808a-43879adc37f9</onsuccess></stage><stage stageid="4be42f72-8084-43bc-808a-43879adc37f9" name="Check if found" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="180" y="450" /><decision expression="InStr([Run Report], [Item_To_Find])&gt;0" /><ontrue>c0953fd8-0dfa-44e0-9080-08e18037e6e6</ontrue><onfalse>8b8a8235-2706-4535-8399-d3966d80f136</onfalse></stage><stage stageid="c0953fd8-0dfa-44e0-9080-08e18037e6e6" name="Anchor17" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="180" y="495" w="10" h="10" /><onsuccess>ec1ab617-8df1-45b5-a479-1e7c51a4ab02</onsuccess></stage><stage stageid="9c085219-625e-4552-a749-908eda4df7d5" name="Remove_List_item" type="SubSheetInfo"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><narrative>Remove List Item from SharePoint List based on Item ID.
MinAccess:- Add_Edit(With Delete)
On success "Line Item Removed Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="51292125-bd54-4256-b3c2-c007e2f90c16" name="Start" type="Start"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><preconditions><condition narrative="Item ID required for Identifying the List_Item. Use &quot;Get_ListItem_ID&quot; action to get Item ID." /></preconditions><display x="15" y="-165" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Target_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Item_ID" narrative="Item ID based on the Item Field value." stage="Item_ID" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>8c94b742-ce3d-47e8-8c8b-74cd1dab915a</onsuccess></stage><stage stageid="4b6a2ed7-d7f4-4390-9943-03b40b5aba15" name="Build Script" type="Calculation"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="-15" /><onsuccess>97c56b7a-eb1b-49bd-9ea0-3b6096aa030b</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;$List_Item=Remove-PnPListItem -List &quot; &amp;[SP_Target_List] &amp; &quot; -Identity &quot; &amp; [Item_ID] &amp; &quot; -Force -ErrorAction Stop&quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Line Item Removed Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="9c19af4b-af19-4bb3-bf22-de694f40217d" name="Run PnP_Script" type="SubSheet"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>69156824-abe1-4f16-a622-711d52d99198</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="f846d1a9-520e-4f1f-b2f6-a787b3ea2418" name="Delete_Script" type="Action"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>77549428-e6a4-4735-9ef6-59db46b5b98b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="97c56b7a-eb1b-49bd-9ea0-3b6096aa030b" name="Generate_PnPScript" type="SubSheet"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Remove_List_Item&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>838b88d6-7e7f-45ed-b652-425fe31f08e0</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="838b88d6-7e7f-45ed-b652-425fe31f08e0" name="Check_Error" type="Decision"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>8eddede6-d9dd-43a2-b238-7cbeddb5cfec</ontrue><onfalse>9c19af4b-af19-4bb3-bf22-de694f40217d</onfalse></stage><stage stageid="8eddede6-d9dd-43a2-b238-7cbeddb5cfec" name="Exception while creating  Script" type="Exception"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="a5f50f82-68ff-49d9-b304-079d1cb73b51" name="Check Process_Exist" type="Action"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>0d500f4e-e8a5-415a-a265-aeeb2cb432af</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="0d500f4e-e8a5-415a-a265-aeeb2cb432af" name="ProcessExist?" type="Decision"><subsheetid>d5a4e22a-4903-4d15-be8a-3ee53aeee79d</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>03171f07-116f-4245-a302-72cf14e7ca4e</ontrue><onfalse>8a8aa76c-f154-4a7e-aa1f-1e5aad7885af</onfalse></stage><stage stageid="8a8aa76c-f154-4a7e-aa1f