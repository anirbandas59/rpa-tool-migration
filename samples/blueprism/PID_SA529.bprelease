cess" /></outputs></stage><stage stageid="c9114ad5-33ca-485e-bf6e-f3f2df78ea20" name="Script_Loc" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="-120" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e3820ef-3fc0-4814-9c5a-07970c67cb79" name="Error_Message" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="15" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c5d68624-bba1-443b-b157-7afe38060494" name="Exists" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="255" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a40c0f7a-9b85-4fbd-b3f1-85d9a2531221" name="Record Type" type="Data"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-420" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3e528bea-e968-49ca-8c3b-f1dfd0af91ab" name="Clear Entire List Items" type="SubSheetInfo"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><narrative>This code clears the entire items of a given list within mentioned Page size.
List_Name: The target SharePoint list name
SP_Site_URL: SharePoint URL
Page_Size: The SharePoint Page Size to be considered. By default set to 500.
</narrative><display x="-195" y="-105" w="210" h="90" /></stage><stage stageid="7aac4de5-18bf-4399-8c9b-ef4e3a790623" name="Start" type="Start"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="-165" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="List_Name" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="number" name="Page_Size" narrative="Maximum page size to be considered (Default value is 500)" stage="Page_Size" /></inputs><onsuccess>6f6c36c2-e570-4942-8de0-00dd1d91c10c</onsuccess></stage><stage stageid="77327ad1-a97e-4e64-9ac8-0f8d7ed67ea4" name="Build Script" type="Calculation"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="0" /><onsuccess>cb442292-4437-4512-9b6a-fcc6053238c3</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;  NewLine() &amp; &#xA;&quot;$items =Get-PnPListItem -List &quot;&amp;Chr(34)&amp;[List_Name]&amp;Chr(34)&amp;&quot; -PageSize &quot;&amp;Chr(34)&amp;[Page_Size]&amp;Chr(34)&amp; NewLine() &amp; &#xA;&quot;foreach ($item in $items)&quot;&amp; NewLine() &amp; &#xA;&quot;{&quot;&amp; NewLine() &amp; &#xA;&quot;Remove-PnPListItem -List &quot;&amp;Chr(34)&amp;[List_Name]&amp;Chr(34)&amp;&quot; -Identity $item.Id -Force&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Line Items Removed Successfully&quot; &amp; Chr(34)  &amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;&#xA;" stage="Script" /></stage><stage stageid="fbf8226e-2b68-460e-8814-d364cd56a1cc" name="Run PnP_Script" type="SubSheet"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>e98c739a-b0c0-4c42-b281-f6db059a4d06</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="0472ef00-0e99-440a-8aca-92a19e238c54" name="Delete_Script" type="Action"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="405" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>c27f4665-b005-46c2-96f6-527d3337570e</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="cb442292-4437-4512-9b6a-fcc6053238c3" name="Generate_PnPScript" type="SubSheet"><subsheetid>f071133f-5d6f-4227-aea4-326ef47c7c4e</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Scrip