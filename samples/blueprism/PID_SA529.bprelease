Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()

'SearchOrder:=xlByColumns,SearchDirection:=xlPrevious
    
ColCount = GetWorksheet(handle,Workbook,Worksheet).Cells.Find("*", , , , 2, 2).Column

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
            
End Try


]]></code></stage><stage stageid="1323454d-415b-442b-9ba6-dd3ffdc8d66f" name="Handle" type="Data"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e96ce2f9-7711-4e1f-9205-922ceb19e402" name="Workbook" type="Data"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="48a397f9-943a-461c-aa7a-4c9be31d1b90" name="Worksheet" type="Data"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a941ca5e-b0f8-432d-b616-2328f532a166" name="Success" type="Data"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="240" y="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="483c0a14-24a4-466c-91d0-feeda11e7996" name="Message" type="Data"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="240" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4f1cb4f8-e748-411d-a25c-e91f364f1639" name="Success?" type="Decision"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="0" /><decision expression="[Success]" /><ontrue>7a84aa0d-d406-40c0-aaff-32b4e295948d</ontrue><onfalse>4e6b1522-9fc5-4cb7-89d8-1e8c12b4a8fd</onfalse></stage><stage stageid="4e6b1522-9fc5-4cb7-89d8-1e8c12b4a8fd" name="Throw Exception" type="Exception"><subsheetid>4748774d-ef1b-497e-91a9-dc29064bed5e</subsheetid><loginhibit onsuccess="true" /><display x="135" y="0" /><e