lt;&gt;&quot;&quot; OR InStr(Lower([Run Report]), &quot;error&quot;)&gt;0" /><ontrue>e244e6ee-f54d-461e-b4f4-f2e30d2ed5f8</ontrue><onfalse>45772628-5b82-4eda-a4e8-e671c7c4b8a9</onfalse></stage><stage stageid="e244e6ee-f54d-461e-b4f4-f2e30d2ed5f8" name="Received exception after running the script" type="Exception"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="210" y="225" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="d9b25072-c77a-4506-ac99-063d0e6cf5ad" name="Input" type="Block"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="-315" y="45" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="642d43d0-0321-4936-84a3-7163762a91f0" name="Inhouse" type="Block"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="-495" y="45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="13e4caa7-4e24-4560-bb89-ca1b79636e5e" name="LIst_Item_Values" type="Data"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="-180" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="77f9e516-b9dd-433e-b3ae-304862214269" name="End" type="End"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="15" y="495" /><outputs><output type="text" name="Success_Message" stage="Run Report" /></outputs></stage><stage stageid="b2cdd946-098c-43db-afd5-9dec1308d6d1" name="User Name" type="Data"><subsheetid>4b302f80-1763-40d4-8c53-e68bc97d6bb7</subsheetid><display x="-420" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e95c39f-8e07-4b32-b18a-ba7def2780a5" name="Current_User_name" type="Action"><subsheetid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</subsheetid><display x="15" y="-30" /><outputs><output type="text" name="User Name" narrative="The name of the logged in user in the current system" stage="User Name" /></outputs><onsuccess>1f56b03e-64b0-4d41-a82e-c9f5f87ebfd8</onsuccess><resource object="Utility - Environment" action="Get User Name" /></stage><stage stageid="936a8510-135c-41e1-9fb0-dc90ae923548" name="Update_ListItem" type="SubSheetInfo"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><narrative>Update list item values based on Item ID. Update Modified by to current authenticated user.
MinAccess:- Add_Edit( With out Delet)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8f1c8f8a-bff7-46df-b2d0-d74929eb3d51" name="Start" type="Start"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><preconditions><condition narrative="Item ID required for Identifying the List_Item. Use &quot;Get_ListItem_ID&quot; action to get Item ID." /></preconditions><display x="15" y="-180" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234" stage="SP_Site_URL" /><input type="text" name="SP_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="Item_Updated_Values" narrative="Provide the Column name and Values to be updated in format &quot;Column1&quot;=&quot;Value&quot;;&quot;Column2&quot;=&quot;value2&quot; Ex:- &quot;Emp_Name&quot; =&quot;Abhi&quot;;&quot;Location&quot;=&quot;Chennai&quot;;&quot;DOB&quot; = &quot;03/05/1987&quot;;&quot;Dept&quot; = &quot;Sales&quot;;" stage="LIst_Item_Values" /><input type="text" name="Item_ID" narrative=" Item ID based on the Item Field value. " stage="Item_ID" /><input type="text" name="Temp_Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>b1f37d53-9d68-4eb8-934f-b85a05479527</onsuccess></stage><stage stageid="1fd28e39-91a9-46ae-b6d5-d48309f3ef45" name="Build Script" type="Calculation"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><display x="15" y="-15" /><onsuccess>5f1ef1fd-dfaa-48f2-901e-c9b16f931219</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;$List_Item=Set-PnPListItem -List &quot; &amp;[SP_Target_List] &amp; &quot; -Identity &quot; &amp; [Item_ID] &amp; &quot; -Values @{&quot; &amp; [LIst_Item_Values]&amp; &quot;} -ErrorAction Stop&quot; &amp; NewLine() &amp; &#xA;&quot;If ($List_Item.ID -gt 0)&quot; &amp; NewLine() &amp;&#xA;&quot;{&quot; &amp; NewLine() &amp;&#xA;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;Item ID-&quot;&amp; Chr(34) &amp; &quot;$List_Item.ID&quot; &amp; Chr(34) &amp; &quot; Successfully Updated &quot;&amp; Chr(34)  &amp; NewLine() &amp;&#xA;&#xA;&#xA; &quot;}&quot; &amp; NewLine() &amp;&#xA;&#xA;&quot;Else&quot; &amp; NewLine() &amp;&#xA;&quot;{ Write-Host &quot; &amp; Chr(34) &amp; &quot; ERROR:- Check List Name&quot; &amp; Chr(34) &amp; &quot;}}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="d2d752ed-6056-4834-a187-c695b543af83" name="Run PnP_Script" type="SubSheet"><subsheetid>904ff81d-0d1f-48d6-bb29-48490cd5bd1b</subsheetid><display x="15" y="180" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>dd719530-bcc0-4ad4-9510-5776621a62d0</onsuccess><processid>7c20ffe9-31ed-4311-