5" y="180" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>9e96e8eb-a83e-482a-9344-75edf99d2ed6</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d992d434-d56d-45ce-a156-bc8b5d1b4302" name="Delete_Script" type="Action"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-75" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>9d84c7e4-cc61-4858-b009-ed2544204335</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="e57ff7da-23d2-414a-8d5e-78486c167493" name="Generate_PnPScript" type="SubSheet"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-75" y="75" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_Latest_files&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>e5671d22-0f7f-4ddf-a4da-3fe2a5f6bf4b</onsuccess><processid