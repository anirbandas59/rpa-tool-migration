]]></code></stage><stage stageid="e0eacad9-6529-42f1-a12d-83b40e522dc3" name="Set Events Enabled" type="SubSheet"><subsheetid>e747993d-88b1-4018-8146-d81647fb81ac</subsheetid><loginhibit onsuccess="true" /><display x="75" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>f26ccb4a-4884-412b-b5bb-f18581a03073</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="05fb1f04-6a77-499a-8652-0fcf88a8d710" name="Get Row &amp; Column No" type="SubSheetInfo"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><narrative>Returns Row number &amp; Column number of a given cell reference</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="efe01812-4d37-4256-8120-c48831767361" name="End" type="End"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><loginhibit /><display x="15" y="135" /><outputs><output type="number" name="Row No" narrative="Row No" stage="Row No" /><output type="number" name="Column No" narrative="Column No" stage="Column No" /></outputs></stage><stage stageid="4c9f1706-f792-4f3d-ba9c-d76ece2111d4" name="Cell Address" type="Data"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1255457e-4572-416d-822b-ae63a346b4a5" name="Named Values" type="Collection"><subsheetid>6f95bf66-8ddd-4007-a662-a2029997cbe8</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><