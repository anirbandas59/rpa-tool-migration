tid><narrative>Searched particular list item and updates the lable for the item</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f9d61bad-d8ba-414e-88c3-0b438849dad7" name="Start" type="Start"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name/Value of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="number" name="Page Size" narrative="(Optional)Specify the page size (Default: 5000)" stage="Page Size" /><input type="text" name="Label" narrative="Specify the metadata to be set" stage="Label" /></inputs><onsuccess>247d0926-c36d-461a-b42d-e2179276766d</onsuccess></stage><stage stageid="6c34e2c7-5d93-4972-9dc7-f2a316cee616" name="End" type="End"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Message" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="bc7d92ec-6ba8-48e8-8c31-6842ec7c1b78" name="Build Script" type="Calculation"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-105" /><onsuccess>98bc710a-65cc-4e99-a390-ae49a7b760a7</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;  NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize &quot;&amp;[Page Size]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot; Set-PnPListItem -List &quot;&amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp;&quot; -Identity $item -Label &quot;&amp;Chr(34)&amp;[Label]&amp;Chr(34)&amp;NewLine()&amp;&quot;Exit &quot; &amp; NewLine()&amp;&#xA; &quot;}&quot; &amp; NewLine() &amp; &#xA;&quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &#xA;&quot;Catch {&quot; &amp; NewLine() &amp;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="1047c814-d86a-4664-871b-38e42f0f2ec7" name="Run PnP_Script" type="SubSheet"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>013bbafc-a640-45ee-a229-56e71631348c</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d09963e7-293d-4280-8ada-66c441199bd7" name="Delete_Script" type="Action"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>6c34e2c7-5d93-4972-9dc7-f2a316cee616</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="98bc710a-65cc-4e99-a390-ae49a7b760a7" name="Generate_PnPScript" type="SubSheet"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_ListItem_ID&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>8e9f1bca-3da5-43b7-84b2-b52971c745cb</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="8e9f1bca-3da5-43b7-84b2-b52971c745cb" name="Check_Error" type="Decision"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-15" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>d4b4915b-bd4c-4ced-96e9-f03cebfd84d7</ontrue><onfalse>1047c814-d86a-4664-871b-38e42f0f2ec7</onfalse></stage><stage stageid="d4b4915b-bd4c-4ced-96e9-f03cebfd84d7" name="Exception while creating  Script" type="Exception"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="210" y="-15" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="0c794fdf-a5b7-4708-8ad1-57beb622dbc7" name="Check Process_Exist" type="Action"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>a9d2009f-d76d-48d0-a27b-8a753bc1af03</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="a9d2009f-d76d-48d0-a27b-8a753bc1af03" name="ProcessExist?" type="Decision"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="195" /><decision expression="[P_Exists]=True" /><ontrue>5c41edde-6d99-491b-814d-b709733b350c</ontrue><onfalse>2775539c-be05-458d-8aa4-b8d18645c649</onfalse></stage><stage stageid="2775539c-be05-458d-8aa4-b8d18645c649" name="Anchor8" type="Anchor"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="120" y="195" w="10" h="10" /><onsuccess>ef619bf7-f8cf-49f6-80f8-6df34403b8aa</onsuccess></stage><stage stageid="5c41edde-6d99-491b-814d-b709733b350c" name="Kill Process" type="Action"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d09963e7-293d-4280-8ada-66c441199bd7</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="ef619bf7-f8cf-49f6-80f8-6df34403b8aa" name="Anchor9" type="Anchor"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="120" y="300" w="10" h="10" /><onsuccess>d09963e7-293d-4280-8ada-66c441199bd7</onsuccess></stage><stage stageid="04826791-448f-44ff-9075-a8f3b6bc9602" name="SP_Site_URL" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-240" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d4241fc6-ecb1-49a6-9051-1d851822847f" name="SP_Target_List" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8f7516ca-c9a5-4c39-8638-eafa8326354b" name="Item_To_Find" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>List item to retrieve</narrative><display x="-210" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b8fac929-b9f6-46f9-8580-211e5961a82b" name="Input" type="Block"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-270" y="-45" w="210" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="db496a47-5c9a-4292-a3e9-618bd07c4834" name="Output" type="Block"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-270" y="105" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="731e1529-2be4-47f3-9f04-dda31797ae76" name="Inhouse" type="Block"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-450" y="-45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ccd9b0ff-0d2d-4a8b-9973-5994ae7f5df7" name="Script" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-420" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b31245d-96bc-4db8-81e9-ec6a58f41cf3" name="Return Message" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5c957f3d-e705-4ed0-95c3-35d4714c8ff0" name="Script Path" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="108f9900-f931-49a4-9909-88d6d604489d" name="Error_Message" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f4ed466c-1f3b-49b7-8efe-4eec4323d1a5" name="Run Report" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2902a891-2603-4383-a281-3c31221fbdb2" name="P_Exists" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6df71628-7138-4a0b-906a-68f5c04296ba" name="Standards" type="Note"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list.(Unique Column to be prefered )

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://abc-sp.xyz.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://abcsp.xyz.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="ec1a260f-ead4-4c1c-8ccc-8a9ff78a92c4" name="Unexpected exception recover" type="Recover"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="450" y="-120" /><onsuccess>d7022dcf-e391-4d73-9466-05af71897be5</onsuccess></stage><stage stageid="6d499182-8180-4e9f-a275-9ea93ed4109c" name="Unexpected Exception" type="Exception"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="96dcc6a6-3f41-4e7c-ae74-d69f7e5bbdf2" name="Script_Location" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="937ae43e-cfb5-44dd-9d3e-d2d463cd9941" name="Find_Item_By" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7022dcf-e391-4d73-9466-05af71897be5" name="Delete_Script" type="Action"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="450" y="-15" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>6d499182-8180-4e9f-a275-9ea93ed4109c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="7d0d4c33-6266-4898-b935-9c680c22bb57" name="Validate Temp Script Path" type="SubSheet"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="15" y="-150" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>bc7d92ec-6ba8-48e8-8c31-6842ec7c1b78</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="013bbafc-a640-45ee-a229-56e71631348c" name="Error Message?" type="Decision"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="90" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot;" /><ontrue>8f009a3b-2b8a-408b-894d-50ee27bd6c26</ontrue><onfalse>0c794fdf-a5b7-4708-8ad1-57beb622dbc7</onfalse></stage><stage stageid="8f009a3b-2b8a-408b-894d-50ee27bd6c26" name="Received exception after running the script" type="Exception"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="210" y="90" /><exception type="Business Exception" detail="[Error_Message]" /></stage><stage stageid="1c2b9098-7635-463e-a6c9-4021f54a8905" name="Page Size" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-150" y="-15" /><datatype>number</datatype><initialvalue>5000</initialvalue><private /><alwaysinit /></stage><stage stageid="6220b43b-9eae-4ef6-8d54-a13106af672b" name="Item_to_be_Retrieved" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-120" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="40127507-5adc-49bc-98d2-cdfaf8334e97" name="Label" type="Data"><subsheetid>aa7dbc80-b364-4bd1-bbeb-c5a7b4c443ee</subsheetid><display x="-105" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="626fecef-cd46-481c-826a-b9be9eb8bef3" name="Get all lists or Libraries in site" type="SubSheetInfo"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><narrative>Get all lists or libraries from a site
