ct="Utility - File Management" action="Delete File" /></stage><stage stageid="a5c7635b-28b5-42eb-b018-b2521b5fd133" name="Delete_Script" type="Action"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="390" y="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>f3987f96-d8e8-429b-b062-e68920c320e4</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="493f5432-5337-4cbd-b10d-dd3b595f63e0" name="Find_Item_By" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Column name to find the list item by</narrative><display x="-180" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e75a3dcb-d7aa-4c3d-a548-7d2a03955e4b" name="Results" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-150" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83d8571c-5f38-41b3-a283-c7755e80fefc" name="Download All Files in a Folder From SharePoint" type="SubSheetInfo"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><narrative>Help to Download all files from Sharepoint library/folder with a leverage of filtering the download based on the file extension</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="62276e33-3313-4982-85ea-6b3514c3f9fe" name="Return Message" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-420" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3b13cff1-c813-40d9-b619-45be79ccf1a9" name="Script" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-600" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9e260e29-171b-4b38-99f8-ebdc1f3d4109" name="SP_Site_URL" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-420" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="015d90d5-18d4-457f-9086-7162d62d3176" name="Sp_Lib_Folder" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-420" y="-75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="baa403ec-6819-465c-8ab4-d61109ed917b" name="Dest_Directory" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-420" y="-45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="222e27de-6ba2-4339-8ba1-e007621d8611" name="Standards" type="Note"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><narrative>Dest_Directory: destination directory where the file will be downloadedC:\Apps

Create_Dir:- To check if Directory is not there whether to create or not.

Share_Lib_File_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

File Format :  What type of the file you ar etrying to downlaod . Ex .xlsx/.xls etc



************************************************************************************************
Considering the file from "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data/Test.xlsx" to be downloaded to "C:\Apps"
</narrative><display x="-525" y="-285" w="300" h="150" /></stage><stage stageid="931e9125-cb02-4ce9-b73c-acef24908732" name="Unexpected exception recover" type="Recover"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="30" y="300" /><onsuccess>ee6fbc2d-d130-447d-86e6-7e1fd2318bf8</onsuccess></stage><stage stageid="4eb00d68-16fe-42e9-9d3b-3cf4456ea8cc" name="Unexpected Exception" type="Exception"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="195" y="300" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="843fd855-794b-45fc-bd22-2311c0ce91af" name="IsDirExist" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-600" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="25c07bb6-8ba5-447f-a979-54c12f2c3bde" name="Script Path" type="Data"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-600" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dac503e5-1c83-4e48-84b8-193a89390955" name="Start" type="Start"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="-585" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_Lib_File_Location" narrative="Library with folder and File details. (Ex:- Document/PID1/Test.txt)" stage="Sp_Lib_Folder" /><input type="text" name="Destination" narrative="Folder Location to download(Ex:- C:\Apps\PID1)" stage="Dest_Directory" /><input type="flag" name="Create_Dir" narrative="If Dir is not there Bot to create?" stage="Create_Dir" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="ScriptLocation" /><input type="text" name="File_Format" narrative="Type of file you need Ex:- (.xlsx/.xls etc)" stage="File_Format" /></inputs><onsuccess>c2335e77-bc65-4df7-af7d-f271d4c12e41</onsuccess></stage><stage stageid="867a1b2f-67d5-4956-bd0d-830bfa89d6fe" name="End" type="End"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="360" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="5a1ab08d-e63c-4866-9bfd-1b27ec3e7813" name="Build Script" type="Calculation"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="-210" /><onsuccess>e8046af9-ee39-4021-b380-9209d8435997</onsuccess><calculation expression="&quot;$sourceListName= &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp;  Chr(34)  &amp; NewLine() &amp;&#xA;&quot;$sourceLibPath=&quot; &amp; Chr(34) &amp;  [Sp_Lib_Folder] &amp; Chr(34)  &amp;  NewLine() &amp;&#xA;&quot;$F_ext =&quot; &amp; Chr(34) &amp; [File_Format] &amp; Chr(34)  &amp;  NewLine() &amp;&#xA;&quot;$Dest_loc=&quot; &amp; Chr(34) &amp;  [Dest_Directory] &amp; Chr(34)  &amp;  NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&#xA;&quot;Connect-PnPOnline -Url $sourceListName  -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot; &amp;  NewLine() &amp;&#xA;&quot;$sourceItems=Get-PnPFolderItem -FolderSiteRelativeUrl $sourceLibPath -ItemType &quot; &amp; Chr(34)  &amp;  &quot;File&quot;&amp; Chr(34) &amp;   NewLine() &amp;&#xA;&quot;foreach($sourceitem in $sourceItems)&quot;&amp;  NewLine() &amp; &#xA;&quot;{&quot; &amp;  NewLine() &amp; &#xA;&quot;$sourceFileUrl=  $sourceLibPath + '/' + $sourceitem.name&quot; &amp;  NewLine() &amp;&#xA;&quot;if (-not  ([string]::IsNullOrEmpty($F_ext))) &quot; &amp; NewLine()  &amp;&#xA;&quot;   {&quot; &amp; NewLine() &amp;&#xA;&quot;      If ($sourceitem.Name -like &quot; &amp; Chr(34)  &amp;  &quot;*&quot; &amp; Chr(34)  &amp;  &quot;+$F_ext )&quot; &amp;  NewLine() &amp;&#xA;&quot;            {&quot; &amp;  NewLine() &amp;&#xA;&quot;                 try &quot; &amp;  NewLine() &amp;&#xA;&quot;                      {&quot; &amp; NewLine() &amp;&#xA;&quot;                         Get-PnPFile -Url $sourceFileUrl -Path $Dest_loc  -AsFile -Filename $sourceItem.Name -Force&quot; &amp;  NewLine() &amp;&#xA;&quot;                         Write-Output $sourceItem.Name&quot; &amp;  NewLine() &amp;&#xA;&quot;                       }&quot;&amp;  NewLine() &amp;&#xA;&quot;                   catch&quot; &amp; NewLine() &amp; &#xA;&quot;                       {&quot;&amp;  NewLine() &amp;&#xA;&quot;                         Write-Host &quot; &amp; Chr(34)  &amp;  &quot;An error occurred while downloading  document&quot; &amp; Chr(34) &amp;  &quot; + $sourceitem.name&quot; &amp;  NewLine() &amp;&#xA;&quot;                       }&quot;&amp;  NewLine() &amp;&#xA;&quot;              }&quot; &amp;  NewLine() &amp;&#xA;&quot;   }&quot; &amp; NewLine() &amp;&#xA;&quot;   ELSE&quot; &amp; NewLine() &amp;&#xA;&quot;            {&quot; &amp;  NewLine() &amp;&#xA;&quot;                 try &quot; &amp;  NewLine() &amp;&#xA;&quot;                      {&quot; &amp; NewLine() &amp;&#xA;&quot;                         Get-PnPFile -Url $sourceFileUrl -Path $Dest_loc  -AsFile -Filename $sourceItem.Name -Force&quot; &amp;  NewLine() &amp;&#xA;&quot;                         Write-Output $sourceItem.Name&quot; &amp;  NewLine() &amp;&#xA;&quot;                       }&quot;&amp;  NewLine() &amp;&#xA;&quot;                   catch&quot; &amp; NewLine() &amp; &#xA;&quot;                       {&quot;&amp;  NewLine() &amp;&#xA;&quot;                         Write-Host &quot; &amp; Chr(34)  &amp;  &quot;An error occurred while downloading  document&quot; &amp; Chr(34) &amp;  &quot; + $sourceitem.name&quot; &amp;  NewLine() &amp;&#xA;&quot;                       }&quot;&amp;  NewLine() &amp;&#xA;&quot;              }&quot; &amp;  NewLine() &amp;&#xA;&quot;   }&quot; &amp; NewLine() &amp;       &#xA;&#xA;&quot;$ItemExist=$null&quot;" stage="Script" /></stage><stage stageid="9d345223-1da3-49d8-9700-bd174fdf724a" name="Run PnP_Script" type="SubSheet"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="-30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>e0f47ad0-cdea-484b-a52c-24cb233e80a6</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="9a3ff1ec-cedb-407f-afee-3724a36affb1" name="Delete_Script" type="Action"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>867a1b2f-67d5-4956-bd0d-830bfa89d6fe</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="e8046af9-ee39-4021-b380-9209d8435997" name="Generate_PnPScript" type="SubSheet"><subsheetid>4de6d347-f4ab-41f1-8684-bf01a35d52dc</subsheetid><display x="-165" y="-150"