-f19e-4504-ae79-4a48d1e058c7</onsuccess><processid>8043916d-2ef9-45b8-ab66-f4c20ef1b8e3</processid></stage><stage stageid="0a3dac83-755e-4921-b274-abb2fcac0e0f" name="Move_Directory" type="SubSheetInfo"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><narrative>Move all the files from Source folder to destination folder</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="cf94f65d-c057-46e1-9ba2-283bc01da533" name="Start" type="Start"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><loginhibit /><display x="0" y="-135" /><inputs><input type="text" name="sourceDirPath" narrative="Specify the Source Path" stage="sourceDirPath" /><input type="text" name="destinationDirPath" narrative="Specify the Destination Path" stage="destinationDirPath" /></inputs><onsuccess>1b903881-c2bb-4045-9b83-10f118505b50</onsuccess></stage><stage stageid="f2991cef-e581-471a-85c0-6c0f8f0b3026" name="End" type="End"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><loginhibit /><display x="0" y="60" /><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs></stage><stage stageid="1b903881-c2bb-4045-9b83-10f118505b50" name="Move Directory" type="Code"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="text" name="sourceDirPath" expr="[sourceDirPath]" /><input type="text" name="destinationDirPath" expr="[destinationDirPath]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>f2991cef-e581-471a-85c0-6c0f8f0b3026</onsuccess><code><![CDATA[Try
FileIO.FileSystem.MoveDirectory(sourceDirPath, destinationDirPath, true)
	Success = True
	Message = ""
Catch e As Exception
	Success = False
	Message = e.Message
End Try
]]></code></stage><stage stageid="1646a139-1e35-4318-bae1-4efa1f445716" name="sourceDirPath" type="Data"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="42f83fe9-2678-478d-b7f5-9a3739291378" name="destinationDirPath" type="Data"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0cce3de8-0111-4ee1-813d-f56469d52bf0" name="Inputs" type="Block"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><loginhibit /><display x="-270" y="-15" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b42166cd-38d2-49e0-b53c-4ed72acec856" name="Success" type="Data"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><display x="-165" y="60" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="754cf63d-f6cc-43af-afc4-b767b7d763f7" name="Message" type="Data"><subsheetid>b1203f3b-285c-4a1e-869d-facb95d00d64</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd4c46c6-6c56-49cf-a76e-380e962e4001" name="Get New FileName" type="SubSheetInfo"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><narrative>Returns the New filename if file already exists in the given folder</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="28058914-5c3c-4f12-a1db-e86ee58e6855" name="Start" type="Start"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="text" name="fullPath" narrative="Specify the Full path of the File. Example : C:\Apps\File.txt" stage="fullPath" /></inputs><onsuccess>59cd7ff1-ce9f-4714-ad66-4ca19abd80ff</onsuccess></stage><stage stageid="0b7c81e0-501a-4f2d-a0f4-934c45da3c5c" name="End" type="End"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><loginhibit /><display x="0" y="135" /><outputs><output type="text" name="NewPath" narrative="Returns the new filename if file already exists in the destination folder" stage="NewPath" /></outputs></stage><stage stageid="59cd7ff1-ce9f-4714-ad66-4ca19abd80ff" name="NewFileName" type="Code"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><loginhibit /><display x="0" y="15" /><inputs><input type="text" name="fullPath" expr="[fullPath]" /></inputs><outputs><output type="text" name="NewPath" stage="NewPath" /></outputs><onsuccess>0b7c81e0-501a-4f2d-a0f4-934c45da3c5c</onsuccess><code><![CDATA[Dim count as long = 1
Dim fileNameOnly  as string = IO.Path.GetFileNameWithoutExtension(fullPath)
Dim extension as string = IO.Path.GetExtension(fullPath)
Dim path as string = IO.Path.GetDirectoryName(fullPath)
Dim newFullPath as string = fullPath
Dim tempFileName as string
While File.Exists(newFullPath)

	tempFileName  = String.Format("{0}({1})", fileNameOnly, count)
	count=count+1
	newFullPath = IO.Path.Combine(path, tempFileName + extension)

End While 
NewPath = newFullPath

]]></code></stage><stage stageid="cc59a06f-6b99-4a97-a7a1-2d3dc6b92f25" name="fullPath" type="Data"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><display x="-285" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0bfe3f5f-15a2-4c8c-a24b-109a83cacefb" name="NewPath" type="Data"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><display x="-285" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="11ce053e-706f-4c0e-930e-f9d01180434c" name="Inputs" type="Block"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><loginhibit /><display x="-345" y="0" w="105" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5c37117f-77b4-4e69-b128-89d876b6035f" name="Outputs" type="Block"><subsheetid>2bba0f73-f292-44f7-bbe6-01c947825d71</subsheetid><loginhibit /><display x="-345" y="75" w="105" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="10c37f1f-9673-4d97-922f-50d54b295e0b" name="Move_Directory" type="SubSheetInfo"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><narrative>Copy Folder  from Source folder to destination folder(INI405)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a2ef1af6-f97d-42d2-b08d-7e7502af7890" name="Start" type="Start"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><loginhibit /><display x="0" y="-135" /><inputs><input type="text" name="Source Folder" narrative="Specify the Source Path" stage="sourceDirPath" /><input type="text" name="Destination Folder" narrative="Specify the Destination Path" stage="destinationDirPath" /></inputs><onsuccess>5c87f192-ffe9-4f7a-a160-e8691c12ffbc</onsuccess></stage><stage stageid="06f606db-b6de-4881-9157-2cb663c1af78" name="End" type="End"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><loginhibit /><display x="0" y="60" /><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs></stage><stage stageid="5c87f192-ffe9-4f7a-a160-e8691c12ffbc" name="Copy Directory" type="Code"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="text" name="sourceDirPath" expr="[sourceDirPath]" /><input type="text" name="destinationDirPath" expr="[destinationDirPath]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>06f606db-b6de-4881-9157-2cb663c1af78</onsuccess><code><![CDATA[Try
Dim SourcePath As String = sourceDirPath
Dim DestinationPath As String = destinationDirPath
Dim newDirectory As String = System.IO.Path.Combine(DestinationPath, Path.GetFileName(Path.GetDirectoryName(SourcePath)))
If Not (Directory.Exists(newDirectory)) Then
     Directory.CreateDirectory(newDirectory)
End If
FileIO.FileSystem.CopyDirectory(SourcePath, newDirectory)
'FileIO.FileSystem.MoveDirectory(sourceDirPath, destinationDirPath, true)
	Success = True
	Message = ""
Catch e As Exception
	Success = False
	Message = e.Message
End Try
]]></code></stage><stage stageid="1b7fa4f9-0b27-4d22-aab4-ad803e35d838" name="sourceDirPath" type="Data"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9a83d50e-ba7f-40c2-b1bc-99f62ee5de57" name="destinationDirPath" type="Data"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="54b955c7-2dd7-4e5c-8f76-5648b5d97494" name="Inputs" type="Block"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><loginhibit /><display x="-270" y="-15" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cf81d170-d4ad-48df-8ac9-4d3d1cb35ba8" name="Success" type="Data"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><display x="-165" y="60" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="acff6adf-c1e3-48b3-8151-3bdc2ad4bb70" name="Message" type="Data"><subsheetid>d504f828-c20e-4328-aca6-5e8d95265d85</subsheetid><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e00ac5d5-41b1-4d23-821e-af61900e35cd" name="File IsReadOnly" type="SubSheetInfo"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><narrative>Checks If File Is Read Only. File Existance has to be checked separately.</narrative><display x="-195" y="-90" w="150" h="60" /></stage><stage stageid="9b73ce42-5585-4544-b359-3b2dfaa9ae98" name="Start" type="Start"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><loginhibit /><preconditions><condition narrative="File Exists" /></preconditions><display x="-45" y="-105" /><inputs><input type="text" name="In_FilePath" narrative="File full path" stage="In_FilePath" /></inputs><onsuccess>bdda81ef-488d-4721-954c-cffcfde324b7</onsuccess></stage><stage stageid="3e94d5b8-1418-4c29-a7db-0ef628183686" name="End" type="End"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><loginhibit /><display x="-45" y="15" /><outputs><output type="flag" name="Out_IsReadOnly" narrative="Is read only" stage="Out_IsReadOnly" /></outputs></stage><stage stageid="304f3fd1-516d-4dc5-83f0-2eb37d3543e8" name="Input" type="Block"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="45" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6e849ba7-4c48-4409-a7b5-07d5cb08e185" name="Output" type="Block"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><loginhibit /><display x="-270" y="15" w="150" h="45" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="479b3beb-75dd-40c9-93a9-17e54ac58bbc" name="Out_IsReadOnly" type="Data"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><display x="-195" y="45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="1e91eb85-f7d3-47bf-b59b-1fedef12d93c" name="In_FilePath" type="Data"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><display x="-195" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bdda81ef-488d-4721-954c-cffcfde324b7" name="IsReadOnly" type="Code"><subsheetid>5aa01a5a-c2a4-4e23-b209-fa720f6be36a</subsheetid><loginhibit /><display x="-45" y="-45" /><inputs><input type="text" name="In_FilePath" expr="[In_FilePath]" /></inputs><outputs><output type="flag" name="Out_IsReadOnly" stage="Out_IsReadOnly" /></outputs><onsuccess>3e94d5b8-1418-4c29-a7db-0ef628183686</onsuccess><code><![CDATA[Try
	Using StrReader As New StreamReader(In_FilePath)
		StrReader.Close()
	End Using
	Using InStream As FileStream = File.Open(In_FilePath, FileMode.Open, FileAccess.ReadWrite, FileShare.None)
		InStream.Close()
		Out_IsReadOnly = False
	End Using
Catch Ex As Exception
	Out_IsReadOnly = True
End Try]]></code></stage><stage stageid="41b673cb-e6b2-47f7-b2e3-6ab1f3713771" name="GetFileName" type="SubSheetInfo"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><narrative>Get File name from full file path</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="4e05507a-7540-4724-b518-e11bc99e3084" name="Start" type="Start"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="FilePath" narrative="File Path" stage="FilePath" /></inputs><onsuccess>ccbb1154-b7aa-49b1-b052-83589c6334fd</onsuccess></stage><stage stageid="70f645d3-4188-4605-a40a-d2aca63573b7" name="End" type="End"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="FileName" narrative="File Name" stage="FileName" /></outputs></stage><stage stageid="c8cab17e-f9c0-4e2e-a2d3-074ea1fc4890" name="FilePath" type="Data"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e5c8d7a-fb7f-41d8-83d7-e2d94806498b" name="FileName" type="Data"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><display x="-105" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ccbb1154-b7aa-49b1-b052-83589c6334fd" name="File Name" type="Code"><subsheetid>67fc6b45-9610-4def-9121-19269b34e800</subsheetid><loginhibit /><display x="15" y="-30" /><inputs><input type="text" name="path" expr="[FilePath]" /></inputs><outputs><output type="text" name="name" stage="FileName" /></outputs><onsuccess>70f645d3-4188-4605-a40a-d2aca63573b7</onsuccess><code><![CDATA[name = System.IO.Path.GetFileName(path)]]></code></stage><stage stageid="c9913789-5b3e-414c-9f9f-3116d938514f" name="Write Text (EncodingFormat)" type="SubSheetInfo"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><narrative>Writes text to a file With Encoding format.</narrative><display x="-195" y="-120" w="150" h="60" /></stage><stage stageid="20fa8e05-74ca-4866-be05-52e6a67c10f7" name="Write Text (EncodingFormat)" type="Code"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><display x="30" y="-60" /><inputs><input type="text" name="File Name" expr="[File Name]" /><input type="text" name="Text" expr="[Text]" /><input type="text" name="EncodingFormat" expr="[EncodingFormat]" /><input type="flag" name="AppendText" expr="[AppendText]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>5105025d-9c25-452a-a699-092387cfe79d</onsuccess><code><![CDATA[Try
	Dim encoding as Object = Nothing
	if LCase(EncodingFormat)  = LCase("u7") then
		encoding = System.Text.Encoding.UTF7
	Else if  LCase(EncodingFormat)  = LCase("u8") then
		encoding = System.Text.Encoding.UTF8
	Else if LCase(EncodingFormat)  = LCase("u16LE") then 
		encoding = System.Text.Encoding.Unicode
	Else if LCase(EncodingFormat)  = LCase("u16BE") then 
	encoding = System.Text.Encoding.BigEndianUnicode
	Else if LCase(EncodingFormat)  = LCase("u32")  then 
	encoding = System.Text.Encoding.UTF32
	Else
	Throw new Exception ("Could not able to find Encoding mthod " & EncodingFormat)
	End if
	Using sw As StreamWriter = New StreamWriter(File_Name, AppendText, encoding)
    sw.Write(Text)
    sw.Close()
	End Using
	Success = True
	Message = ""
Catch e As Exception
	Success = False
	Message = e.Message
End Try]]></code></stage><stage stageid="f9597e9c-5400-4f65-adc0-bc3138c43203" name="Success" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><display x="-195" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="6cac4c81-9c1e-4144-b359-063bf982d5f4" name="Message" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><display x="-195" y="45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12cb8509-f541-4e18-97e1-b8b52eb25ed8" name="Text" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><display x="-195" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a24efce2-7c4b-4e0f-939f-01ebed62d9ef" name="File Name" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><display x="-195" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7f31514-ce87-4df2-810b-0995b09b0cbf" name="Start" type="Start"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><preconditions><condition narrative="There must be sufficient disk space to accommodate the new data." /></preconditions><postconditions><condition narrative="The supplied text will have been written to the destination file." /></postconditions><display x="30" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="File Name" narrative="The full path to the file to write the text to" stage="File Name" /><input type="text" name="Text" narrative="The text to write to the file" stage="Text" /><input type="text" name="EncodingFormat" narrative="Supported encoding formats u7, u8, u16LE, u16BE and u32. u7 -&gt; UTF7, u8 -&gt; UTF8, u16LE, -&gt; Unicode, u16BE -&gt; BigEndianUnicode, u32 -&gt; UTF32" stage="EncodingFormat" /><input type="flag" name="AppendText?" narrative="True if files needs to append or False for overwrite" stage="AppendText" /></inputs><onsuccess>20fa8e05-74ca-4866-be05-52e6a67c10f7</onsuccess></stage><stage stageid="5105025d-9c25-452a-a699-092387cfe79d" name="End" type="End"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><display x="30" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs></stage><stage stageid="f8c645bd-942d-4dac-8e5b-f2f7e6c52ca2" name="EncodingFormat" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="031a35f4-3f3d-486f-a0cf-429040f35b56" name="AppendText" type="Data"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="9983c44f-2371-4231-a5d6-919a5ad3ad77" name="Variables" type="Block"><subsheetid>b4b2c242-0e64-41cb-b0fd-32507280060c</subsheetid><loginhibit /><display x="-270" y="-60" w="150" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3b4eb149-e9db-41d6-a749-37b93b871051" name="Get FileName and Extension" type="SubSheetInfo"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><narrative>Get FileName and Extension</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7842820e-e8ce-45e0-8308-736d15355b88" name="Start" type="Start"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="FilePath" narrative="Provide Full Path Of File or Full File Name" stage="FilePath" /></inputs><onsuccess>615d5621-8d78-4d58-9364-ecda1b8eb756</onsuccess></stage><stage stageid="29578822-cde5-4a8d-88e5-8d1c311b7b44" name="End" type="End"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><loginhibit /><display x="15" y="-15" /><outputs><output type="text" name="FullFileName" narrative="FullFileName" stage="FullFileName" /><output type="text" name="FileExtension" narrative="FileExtension" stage="FileExtension" /><output type="text" name="FileNameWithoutExtension" narrative="FileNameWithoutExtension" stage="FileNameWithoutExtension" /></outputs></stage><stage stageid="615d5621-8d78-4d58-9364-ecda1b8eb756" name="Get FileName and Extension" type="Code"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><loginhibit /><display x="15" y="-75" /><inputs><input type="text" name="FilePath" expr="[FilePath]" /></inputs><outputs><output type="text" name="FullFileName" stage="FullFileName" /><output type="text" name="FileExtension" stage="FileExtension" /><output type="text" name="FileNameWithoutExtension" stage="FileNameWithoutExtension" /></outputs><onsuccess>29578822-cde5-4a8d-88e5-8d1c311b7b44</onsuccess><code><![CDATA[FileExtension = System.IO.Path.GetExtension(FilePath)
FullFileName = System.IO.Path.GetFileName(FilePath)
FileNameWithoutExtension = system.IO.Path.GetFileNameWithoutExtension(FilePath)]]></code></stage><stage stageid="35ea1465-a75e-4f22-83b5-7ed7e3339669" name="FilePath" type="Data"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="16c4c534-082c-4a92-8551-dafa51cc7672" name="FullFileName" type="Data"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c5b59d4-3202-4829-90a5-727e1ff4b3e0" name="FileExtension" type="Data"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c4116d62-365a-47a7-8d0d-bccb7fb32af0" name="FileNameWithoutExtension" type="Data"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af528dc2-c829-4189-8ee7-ca886e2d8dc5" name="Variables" type="Block"><subsheetid>31ca7ec3-0cff-421b-943d-c775bdd9bb7f</subsheetid><loginhibit /><display x="-270" y="-30" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="71525abf-c5e8-4690-ac9c-9fa4268cbd42" name="Get File Size - Extended" type="SubSheetInfo"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><narrative>Gets the size of the specified file.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="72b2a579-ca10-4ca3-bd23-7b6247855be1" name="End" type="End"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><loginhibit /><display x="15" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Size" narrative="The size of the file in bytes" stage="Bytes" /></outputs></stage><stage stageid="28cdd1de-dea0-4663-8a7a-d695bfeb3218" name="Start" type="Start"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><loginhibit /><preconditions><condition narrative="The specified file must exist." /></preconditions><postconditions><condition narrative="The file size will have been determined." /></postconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="File Path" narrative="Full path to the file to get the file size" stage="File Path" /></inputs><onsuccess>afc18cb1-d644-4b9f-8bcf-309a29562ed9</onsuccess></stage><stage stageid="682c441b-bdeb-407b-ac7e-d94c8f62a377" name="File Path" type="Data"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="afc18cb1-d644-4b9f-8bcf-309a29562ed9" name="Get Byte Count Extended" type="Code"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><loginhibit /><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="File Path" expr="[File Path]" /></inputs><outputs><output type="number" name="Bytes" stage="Bytes" /></outputs><onsuccess>72b2a579-ca10-4ca3-bd23-7b6247855be1</onsuccess><code><![CDATA[Try

	'Bytes = File.ReadAllBytes(File_Path).Length
Bytes=FileLen(File_Path)
Catch e As Exception
	Bytes = 0
End Try]]></code></stage><stage stageid="c2b3d9d3-3b60-4052-9871-119ff375096e" name="Bytes" type="Data"><subsheetid>5c3ab964-2281-48a3-a422-86c7066a337d</subsheetid><display x="-195" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f99c8af9-22f5-45fe-b26c-f8a15e8d71e1" name="Select File" type="SubSheetInfo"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><narrative>Displays the Select File dialog box</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="5b016351-1e66-4197-9821-94ab8f20517c" name="Start" type="Start"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Filter Description" narrative="Default All" stage="Filter Description" /><input type="text" name="Filter Value" narrative="Default *.*" stage="Filter Value" /><input type="text" name="Start Folder" narrative="Start Folder" stage="Start Folder" /><input type="text" name="Window Title" narrative="Window Title" stage="Window Title" /></inputs><onsuccess>82d65a76-cb28-4b4d-a89c-b825617e6079</onsuccess></stage><stage stageid="2a710ee2-9f38-44b4-a5db-086273cae15d" name="End" type="End"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="File Path" narrative="File Path" stage="Path" /></outputs></stage><stage stageid="82d65a76-cb28-4b4d-a89c-b825617e6079" name="Select File" type="Code"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><loginhibit /><display x="15" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Filter Description" expr="[Filter Description]" /><input type="text" name="Filter Value" expr="[Filter Value]" /><input type="text" name="Start Folder" expr="[Start Folder]" /><input type="text" name="Window Title" expr="[Window Title]" /></inputs><outputs><output type="text" name="Path" stage="Path" /></outputs><onsuccess>2a710ee2-9f38-44b4-a5db-086273cae15d</onsuccess><code><![CDATA[Dim d As New System.Windows.Forms.OpenFileDialog

d.Filter = Filter_Description + "|" + Filter_Value

If Window_Title <> "" Then
   d.Title = Window_Title
End If

If Start_Folder <> "" Then
   d.InitialDirectory = Start_Folder
End If

If d.ShowDialog = System.Windows.Forms.DialogResult.OK Then
   Path = d.FileName
End If]]></code></stage><stage stageid="c24e675a-0e92-48f4-b715-46cf089a127f" name="Path" type="Data"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><display x="-195" y="90" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab01e64a-e076-4b42-9a66-1deec454e1ca" name="Note1" type="Note"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><loginhibit /><narrative>Check the reference to System.Windows.Forms.dll on the Initialise page if this does not work</narrative><display x="150" y="-15" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="5eb92382-a073-427e-ae33-1381426554d6" name="Filter Description" type="Data"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue xml:space="preserve">All</initialvalue><private /><alwaysinit /></stage><stage stageid="edaa7423-12e5-4e73-8809-0f389b1499fe" name="Filter Value" type="Data"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue xml:space="preserve">*.*</initialvalue><private /><alwaysinit /></stage><stage stageid="9d2ae1a1-a641-4296-9c1b-59c1ca2d56f2" name="Window Title" type="Data"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><display x="-195" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5addf424-37c6-4794-940d-028d87796373" name="Start Folder" type="Data"><subsheetid>50fb8ba7-a682-45a9-8f41-37d8184bccaa</subsheetid><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="77ab9261-cd9d-43a7-aa62-d1d1bafb3a00" name="Decode Base64 text to binary" type="SubSheetInfo"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><narrative>Decodes Base64 text to binary</narrative><display x="-195" y="-180" w="150" h="90" /></stage><stage stageid="993d2dcc-5517-45ba-a256-535faa4a526f" name="Start" type="Start"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><loginhibit /><display x="-60" y="-210" /><inputs><input type="text" name="base64String" narrative="Base64 encoded text" stage="base64String" /></inputs><onsuccess>e4adcfc1-77fb-4a3b-9cbe-37b42f739577</onsuccess></stage><stage stageid="3959e490-4f32-42c5-bb78-d7c4a57fec32" name="End" type="End"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><loginhibit /><display x="-60" y="-90" /><outputs><output type="binary" name="bytes" narrative="Bytes" stage="bytes" /></outputs></stage><stage stageid="e4adcfc1-77fb-4a3b-9cbe-37b42f739577" name="Decode" type="Code"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><loginhibit /><display x="-60" y="-150" /><inputs><input type="text" name="base64String" expr="[base64String]" /></inputs><outputs><output type="binary" name="bytes" stage="bytes" /></outputs><onsuccess>3959e490-4f32-42c5-bb78-d7c4a57fec32</onsuccess><code><![CDATA[bytes = System.Convert.FromBase64String(base64String)]]></code></stage><stage stageid="47567d00-1c22-4d93-a164-1819afc5bc3a" name="base64String" type="Data"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><display x="105" y="-195" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6d5e5b0-0f2e-4d9c-85db-ee83b916aabf" name="bytes" type="Data"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><display x="105" y="-105" w="120" h="30" /><datatype>binary</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff27dae5-d2c3-45ad-8139-dac35f20f328" name="Input" type="Block"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><loginhibit onsuccess="true" /><narrative>Variables, that come into the subpage (are passed through Start stage) from outside.</narrative><display x="30" y="-225" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="3366FF" /></stage><stage stageid="3c0d7919-c21c-4b77-bb77-890b47eea252" name="Output" type="Block"><subsheetid>28dd2f74-97ab-4f75-9298-55c0f48c4a69</subsheetid><loginhibit onsuccess="true" /><narrative>Variables, that go outside of the subpage (are passed through End stage).</narrative><display x="30" y="-135" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="339966" /></stage><stage stageid="65d0e3bd-e944-48b4-967c-64cbda6e5cdc" name="Encode binary to Base64 text" type="SubSheetInfo"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><narrative>Decodes Base64 text to binary</narrative><display x="-465" y="-240" w="150" h="90" /></stage><stage stageid="fb1e9544-5975-43d9-a392-019b3ef5f5a5" name="Start" type="Start"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><loginhibit /><display x="-315" y="-270" /><inputs><input type="binary" name="bytes" narrative="Bytes" stage="bytes" /></inputs><onsuccess>53746413-bdbd-409b-8584-6367f57d8613</onsuccess></stage><stage stageid="360c76d4-c1fe-4b27-8de4-d48a49c2d3db" name="End" type="End"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><loginhibit /><display x="-315" y="-150" /><outputs><output type="text" name="base64String" narrative="Base64 encoded text" stage="base64String" /></outputs></stage><stage stageid="53746413-bdbd-409b-8584-6367f57d8613" name="Encode" type="Code"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><loginhibit /><display x="-315" y="-210" /><inputs><input type="binary" name="bytes" expr="[bytes]" /></inputs><outputs><output type="text" name="base64String" stage="base64String" /></outputs><onsuccess>360c76d4-c1fe-4b27-8de4-d48a49c2d3db</onsuccess><code><![CDATA[base64String = System.Convert.ToBase64String(bytes)]]></code></stage><stage stageid="53d19657-70c9-4dd3-b3cf-d98ca528c804" name="base64String" type="Data"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><display x="-165" y="-165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f40046bb-2f57-4ba3-a394-1aca9eeaa0c0" name="bytes" type="Data"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><display x="-165" y="-255" w="120" h="30" /><datatype>binary</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32f46e37-21f2-490f-854d-a45f003fedab" name="Input" type="Block"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><loginhibit onsuccess="true" /><narrative>Variables, that come into the subpage (are passed through Start stage) from outside.</narrative><display x="-240" y="-285" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="3366FF" /></stage><stage stageid="cfda73d8-4e5a-418c-9be6-1049c87aa873" name="Output" type="Block"><subsheetid>63542d68-ddcd-4bfd-8afa-10ab836e43c5</subsheetid><loginhibit onsuccess="true" /><narrative>Variables, that go outside of the subpage (are passed through End stage).</narrative><display x="-240" y="-195" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="339966" /></stage><stage stageid="e9e38c42-0b1a-48d8-aab2-69b11360d720" name="Move File - SpecialFileNames" type="SubSheetInfo"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><narrative>Moves the specified file to a new location.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="166a7633-4c6d-42aa-b1d7-884ec5af8113" name="Start" type="Start"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><preconditions><condition narrative="The file to be moved must exist. There must be sufficient disk space to move the file." /></preconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="File Path" narrative="The full path to the file to move" stage="File Path" /><input type="text" name="Destination Path" narrative="The path to the folder to move the file to" stage="Destination Path" /></inputs><onsuccess>8942c80c-7233-4748-8077-a2698ed87c84</onsuccess></stage><stage stageid="d196c90e-3ae7-4f72-83c6-042a1d26d096" name="End" type="End"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><display x="15" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Message" /></outputs></stage><stage stageid="3add9c0b-a2f3-40b1-bab4-4257194f697d" name="Success" type="Data"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><display x="-195" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="0c728c42-3eae-47e8-b68f-0d9b4c68b5fa" name="Message" type="Data"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><display x="-195" y="75" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8942c80c-7233-4748-8077-a2698ed87c84" name="Move File" type="Code"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><display x="15" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="File Path" expr="[File Path]" /><input type="text" name="Destination" expr="[Destination Path]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>fa7d81ce-cd51-43e9-884a-863cc13a6bb9</onsuccess><code><![CDATA[Try
    ' Parse source parts safely
    Dim sSourceFolder As String = Path.GetDirectoryName(File_Path)
    Dim sSourceFileName As String = Path.GetFileName(File_Path)  ' can be a wildcard pattern too

    If String.IsNullOrEmpty(sSourceFolder) Then
        Throw New ArgumentException("Source folder could not be determined from File_Path.")
    End If

    ' Determine destination kind (folder vs specific file path)
    Dim sDestinationFolder As String = Nothing
    Dim sDestinationFile As String = Nothing

    If Directory.Exists(Destination) Then
        sDestinationFolder = Destination
        ' Normalize trailing slash with Path.Combine rather than manually appending
    Else
        sDestinationFile = Destination
        Dim destDir As String = Path.GetDirectoryName(sDestinationFile)
        If String.IsNullOrEmpty(destDir) Then
            Throw New ArgumentException("Destination must be an existing folder or a full file path.")
        End If
        ' Ensure the destination directory exists (optional, create it)
        If Not Directory.Exists(destDir) Then
            Directory.CreateDirectory(destDir)
        End If
    End If

    ' Enumerate files (supports patterns like *.pdf) safely
    Dim aFiles As FileInfo()
    Dim objDirectoryInfo As New DirectoryInfo(sSourceFolder)
    aFiles = objDirectoryInfo.GetFiles(sSourceFileName, SearchOption.TopDirectoryOnly)

    If aFiles Is Nothing OrElse aFiles.Length = 0 Then
        Throw New FileNotFoundException($"No files match '{sSourceFileName}' in '{sSourceFolder}'.")
    End If

    For Each oFile As FileInfo In aFiles
        Dim targetPath As String
        If String.IsNullOrEmpty(sDestinationFolder) Then
            ' Destination is a specific file path: only valid if moving a single file
            If aFiles.Length > 1 Then
                Throw New InvalidOperationException("Destination is a single file path, but multiple source files matched.")
            End If
            targetPath = sDestinationFile
        Else
            ' Destination is a folder: build destination file path using Path.Combine
            targetPath = Path.Combine(sDestinationFolder, oFile.Name)
        End If

        ' Optional: ensure target directory exists when destination is a folder
        Dim targetDir As String = Path.GetDirectoryName(targetPath)
        If Not Directory.Exists(targetDir) Then
            Directory.CreateDirectory(targetDir)
        End If

        ' Move (overwrite handling optional)
        If File.Exists(targetPath) Then
            ' Decide what to do if the file exists; here we overwrite by deleting first.
            File.Delete(targetPath)
        End If

        oFile.MoveTo(targetPath)
    Next

    Success = True
    Message = ""
Catch ex As Exception
       Success = False
    Message = ex.Message
End Try]]></code></stage><stage stageid="577f66f4-e372-4cd1-a07c-ccd9309e415a" name="File Path" type="Data"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c24fa7f-5b5e-4c2e-8b1d-ab70e4f42b56" name="Destination Path" type="Data"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><display x="-195" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa7d81ce-cd51-43e9-884a-863cc13a6bb9" name="Raise Exception If Appropriate" type="SubSheet"><subsheetid>4bc24036-e40f-48ed-b8bd-6b8dad26d051</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="flag" name="Success" narrative="Flag indicating success or otherwise" expr="[Success]" /><input type="text" name="Error Message" narrative="The message detailing the lack of success, empty if the current state indicates success" expr="[Message]" /></inputs><onsuccess>d196c90e-3ae7-4f72-83c6-042a1d26d096</onsuccess><processid>8043916d-2ef9-45b8-ab66-f4c20ef1b8e3</processid></stage><stage stageid="de7fb311-c824-4ec4-aced-cf625effc410" name="Convert Read-only to Editable File" type="SubSheetInfo"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><narrative>Change a file from read only to editbale mode</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="4eb517ff-65e3-4973-b127-e8c037cec881" name="Start" type="Start"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><loginhibit /><display x="15" y="-120" /><inputs><input type="text" name="In_txt_FilePath" narrative="Path of the file to convert" stage="In_txt_FilePath" /></inputs><onsuccess>e626cb6c-9b2a-450d-9fc0-e81542cd79ea</onsuccess></stage><stage stageid="0597a275-34a4-45d7-b912-a3cce82d4d7e" name="In_txt_FilePath" type="Data"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e626cb6c-9b2a-450d-9fc0-e81542cd79ea" name="Convert Read-Only to Editable file" type="Code"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="In_txt_FilePath" expr="[In_txt_FilePath]" /></inputs><outputs><output type="flag" name="Success" stage="Out_flg_Sucess" /><output type="text" name="Message" stage="Out_txt_ErrorMessage" /></outputs><onsuccess>7803fd35-861b-4203-85f7-b37035e9e294</onsuccess><code><![CDATA[Dim fso, file
fso = CreateObject("Scripting.FileSystemObject")

Try
	file = fso.GetFile(In_txt_FilePath)

	' Remove ReadOnly attribute
	file.Attributes = file.Attributes And Not 1

	Success = True
	Message = ""

	Catch e As Exception
		Success = False
		Message = e.Message
End Try]]></code></stage><stage stageid="64557493-8f53-4da9-83bf-4eb0361792c2" name="Out_flg_Sucess" type="Data"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="386499fc-f0da-4180-9bbb-f32a583a50aa" name="Out_txt_ErrorMessage" type="Data"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="22a5d980-1471-402d-a76d-6c2013aaae86" name="Convert Editable to Read-only File" type="SubSheetInfo"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><narrative>Change a file from editable to read-only mode</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e198745f-2fcc-4f4e-afdf-d9044e397798" name="Start" type="Start"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><loginhibit /><display x="15" y="-120" /><inputs><input type="text" name="In_txt_FilePath" narrative="Path of the file to convert" stage="In_txt_FilePath" /></inputs><onsuccess>dfed6bca-1c39-4556-bf8d-ab621a8180f7</onsuccess></stage><stage stageid="7fc0f1b4-8061-4700-8c29-f4e08f320fd8" name="In_txt_FilePath" type="Data"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dfed6bca-1c39-4556-bf8d-ab621a8180f7" name="Convert Editable to Read-Only file" type="Code"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="In_txt_FilePath" expr="[In_txt_FilePath]" /></inputs><outputs><output type="flag" name="Success" stage="Out_flg_Sucess" /><output type="text" name="Message" stage="Out_txt_ErrorMessage" /></outputs><onsuccess>1d2105bd-3cd9-4467-aa87-d03a9c507741</onsuccess><code><![CDATA[Dim fso, file
fso = CreateObject("Scripting.FileSystemObject")

Try
	file = fso.GetFile(In_txt_FilePath)

	' Remove ReadOnly attribute
	file.Attributes = 1

	Success = True
	Message = ""

	Catch e As Exception
		Success = False
		Message = e.Message
End Try]]></code></stage><stage stageid="22c721a5-a54b-40a1-a9cd-1160da387d05" name="Out_flg_Sucess" type="Data"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="953e198f-5c05-4edf-af05-79700cec97a7" name="Out_txt_ErrorMessage" type="Data"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7803fd35-861b-4203-85f7-b37035e9e294" name="End" type="End"><subsheetid>4687aa51-f759-4a68-9629-12ad7a0d89f3</subsheetid><loginhibit /><display x="15" y="0" /><outputs><output type="flag" name="Out_flg_Sucess" stage="Out_flg_Sucess" /><output type="text" name="Out_txt_ErrorMessage" stage="Out_txt_ErrorMessage" /></outputs></stage><stage stageid="1d2105bd-3cd9-4467-aa87-d03a9c507741" name="End" type="End"><subsheetid>b1d357b4-8b2c-47b2-9cc6-8aabadcd6af7</subsheetid><loginhibit /><display x="15" y="0" /><outputs><output type="flag" name="Out_flg_Sucess" stage="Out_flg_Sucess" /><output type="text" name="Out_txt_ErrorMessage" stage="Out_txt_ErrorMessage" /></outputs></stage></process></object>
