subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="number" name="handle" narrative="handle of open excel" stage="handle" /><input type="text" name="Worksheet" narrative="Name of worksheet" stage="Worksheet" /><input type="text" name="Range" narrative="Search Range" stage="Range" /><input type="text" name="Value" narrative="Keyword to search" stage="Value" /></inputs><onsuccess>cad41d61-cff3-41c8-aa8b-ee34e7be800c</onsuccess></stage><stage stageid="97cf506a-3588-443b-bcd5-0cf831737dda" name="End" type="End"><subsheetid>76274c95-8704-417e-9ff8-9a38a9b0172f</subsheetid><loginhibit /><display x="15" y="135" /><outputs><output type="text" name="Cell Value" narrative="Search Value from Excel" stage="Cell Value" /><output type="text" name="Message" narrative=" Message" stage="Message" /><output type="flag" name="Success" narrative="Success Flag" stage="Success" /></outputs></stage><stage stageid="cad41d61-cff3-41c8-aa8b-ee34e7be800c" name="Excel Find Required Word 12" type="Code"><subsheetid>76274c95-8704-417e-9ff8-9a38a9b0172f</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Range" expr="[Range]" /><input type="text" name="Value" expr="[Value]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="FindCount" stage="Cell Value" /></outputs><onsuccess>97cf506a-3588-443b-bcd5-0cf831737dda</onsuccess><breakpoint type="0"><condition></condition></breakpoint><code><![CDATA[Try

'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
FindCount = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Range(Range).Find(Value,lookin:=-4163,LookAt:=2).Address

Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
End Try

