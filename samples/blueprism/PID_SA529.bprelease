ad57-4d58-964f-f50e58e7ef7f" name="Check In file to Sharepoint" type="SubSheetInfo"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><narrative>This action is used to check in the specified file to sharepoint including Check-in comments</narrative><display x="-345" y="-105" w="150" h="90" /></stage><stage stageid="8e7b3bab-7fa4-4b0c-b434-a1d57dbe727c" name="Start" type="Start"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="-345" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_Lib_File_Location" narrative="Library with folder (Ex:- sites/AAAAB2827/)  Note: It should start from sites  " stage="Sp_Lib_Folder" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="File name to checkin" narrative="Exact file name to be checked in" stage="File Name" /><input type="text" name="Check-in Comments" narrative="Check-in Comments " stage="Comments" /></inputs><onsuccess>77187ef1-8e48-421e-a770-46c671847465</onsuccess></stage><stage stageid="c8b3436c-0994-4319-aebf-b1a6fc900a98" name="SP_Site_URL" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-360" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c936a766-3804-46da-b646-27e5075093bb" name="Sp_Lib_Folder" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-255" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12237426-2af3-4ec9-8c05-8518cf2e91f6" name="File Name" type="Data"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-375" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aa50ee28-8ae8-4c17-9c10-907c2520d405" name="Block7" type="Block"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="-405" y="-15" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3885de0d-a5e5-4fc1-80e8-dd14edd70f82" name="End" type="End"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="285" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="7d1d8940-0134-4ad1-86d5-b39a8771b16e" name="Build Script" type="Calculation"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="-135" /><onsuccess>e9f7a678-2d79-493b-bfcf-d839b3c2c0a5</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34)&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;Set-PnPFileCheckedIn -Url &quot;&amp; Chr(34) &amp;[Sp_Lib_Folder]&amp;&quot;/&quot;&amp;[File Name]&amp;Chr(34)&amp;&quot; -CheckinType MinorCheckin -Comment &quot;&amp;Chr(34)&amp;[Comments]&amp;Chr(34)" stage="Script" /></stage><stage stageid="a1c97eb8-6578-4f3d-80cd-61b22b5f41e2" name="Run PnP_Script" type="SubSheet"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="15" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>10f3ef40-514f-4c9e-9c85-81e3fd3a47b8</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="cdf32e52-8e2e-46e7-9aae-68af0210934d" name="Delete_Script" type="Action"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="225" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3885de0d-a5e5-4fc1-80e8-dd14edd70f82</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="e9f7a678-2d79-493b-bfcf-d839b3c2c0a5" name="Generate_PnPScript" type="SubSheet"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="-90" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="Trim([Script])" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_checkin&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>3043cf58-1a1c-4417-bd83-11a65cab2856</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="3043cf58-1a1c-4417-bd83-11a65cab2856" name="Check_Error" type="Decision"><subsheetid>09a7febc-2265-423c-aec9-865220978612</subsheetid><display x="75" y="-45" /><decisio