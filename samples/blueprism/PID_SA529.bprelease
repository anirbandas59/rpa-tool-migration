846c064</subsheetid><loginhibit /><display x="15" y="-75" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="Reference" expr="[cell Reference]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>fffe444c-0df7-4905-ab44-b86742bfd0e3</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object

Try

wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference)
range.Select()
ws.Selection.CopyPicture
Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	ws = Nothing
	excel = Nothing
	sheet = Nothing
	range = Nothing
End Try
]]></code></stage><stage stageid="c543e8b3-a4ef-40d4-aaff-854b46b97da6" name="handle" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-165" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33377b93-0f8b-466d-b946-de769b7a6595" name="workbook" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-195" y="75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="08dc50cc-1183-45f3-a259-4cafb60c8f9f" name="worksheet" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-210" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7cbe9d0a-7b94-4c67-aea1-cc41637a80af" name="Success" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-315" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="44c376ac-a583-4b4f-a4a0-37b106eccd67" name="Message" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-210" y="120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82d0025d-b482-4a49-aaae-f00af717c599" name="cell Reference" type="Data"><subsheetid>10cfbf9d-c934-4ac2-8989-49fb5846c064</subsheetid><display x="-105" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aa404be7-40fa-