goe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8c938a31-7ab9-4c17-9218-4b5986c042aa" name="Output Parameters" type="Block"><subsheetid>f7fc6beb-b075-40a2-bfbd-d32f49410bd1</subsheetid><loginhibit /><display x="-585" y="105" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="91ce39f0-a41a-458b-b0e6-de677994ff62" name="Recover" type="Recover"><subsheetid>f7fc6beb-b075-40a2-bfbd-d32f49410bd1</subsheetid><loginhibit /><display x="180" y="-60" /><onsuccess>6b687866-a37d-428e-9677-42149cbcb05a</onsuccess></stage><stage stageid="6b687866-a37d-428e-9677-42149cbcb05a" name="Exception" type="Exception"><subsheetid>f7fc6beb-b075-40a2-bfbd-d32f49410bd1</subsheetid><display x="180" y="45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="f17a2fd9-02fd-4740-b218-99e811d7af77" name="Excel Delete Old Data" type="Code"><subsheetid>f7fc6beb-b075-40a2-bfbd-d32f49410bd1</subsheetid><loginhibit onsuccess="true" /><narrative>Filtter rows, delete rows and clear filter</narrative><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="N_Rows" expr="[NoOfRows]" /><input type="number" name="column_num" expr="[Column Number]" /><input type="date" name="last_date" expr="[Last Date]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>b488c0bb-942b-4fab-badc-6dd7595d04a2</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, xlSheet1, range As Object
Dim j as object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
excel = wb.Application

wb.Activate()
ws.Activate()
excel = ws.Application
xlSheet1 = excel.ActiveSheet

'Clear Filters
xlSheet1.AutoFilterMode = false


'Delete Rows If Date is Less than Particular Date
For j = N_Rows To 2 Step -1
    If xlSheet1.Cells(j, column_num).Value < last_date Then
    xlSheet1.Cells(j, column_num).Entirerow.Delete
    End If
Next j


'Clear Filters
xlSheet1.AutoFilterMode = false

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	excel = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="34ccbbd8-ec4d-4e84-ac65-15cc36629c5e" name="Auto Fit" type="SubSheetInfo"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><narrative>Action to auto adjust column width</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="c87157b3-e1c2-4f65-b1f0-93277048cb6b" name="Start" type="Start"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Handle" narrative="The integer handle identifying the instance to be closed. Zero indicates the currently active instance." stage="Handle" /><input type="text" name="Workbook" narrative="MS Excel Workbook name" stage="Workbook" /><input type="text" name="Worksheet" narrative="MS Excel Worksheet Name" stage="Worksheet" /></inputs><onsuccess>655e5c98-9be8-4f7d-80ec-5e9fee073aff</onsuccess></stage><stage stageid="f38dcbb5-5fad-43b4-984c-7993f12574f4" name="End" type="End"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs></stage><stage stageid="655e5c98-9be8-4f7d-80ec-5e9fee073aff" name="Autofit Column Width" type="Code"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>5ee6cb25-5877-4440-b02a-b9d355b9458c</onsuccess><code><![CDATA[Dim ws as Object

Try
ws = GetWorksheet(Handle,Workbook,Worksheet)
ws.Cells.Select
ws.Cells.EntireColumn.Autofit
ws.Cells.EntireRow.Autofit

Success = True
Message =""

Catch e as Exception
   Success = False
   Message = e.Message

Finally
   ws = Nothing
End Try ]]></code></stage><stage stageid="6793a393-b8b4-4f5d-9876-eefc778bafbd" name="Handle" type="Data"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7a193bed-c99b-4bfd-a480-0d8ac3a2ec41" name="Workbook" type="Data"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="-165" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="607680cf-2abf-4ae2-a2a2-8c8ba210378d" name="Worksheet" type="Data"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fb2459fd-5a29-41f3-b808-42b272789878" name="Success" type="Data"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="210" y="-30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="260e455d-1d18-4af8-9dca-37e41bead944" name="Message" type="Data"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="210" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="85d51cf9-1dfc-4c4e-804e-a08f45cc3184" name="Inputs" type="Block"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="-210" y="-45" w="90" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8fc6609d-159e-46f7-9bdd-67c5e0d25323" name="Outputs" type="Block"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="165" y="-60" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5ee6cb25-5877-4440-b02a-b9d355b9458c" name="Success" type="Decision"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><loginhibit /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>f38dcbb5-5fad-43b4-984c-7993f12574f4</ontrue><onfalse>ac3050c9-47ce-4a61-af9b-013c4122fd9b</onfalse></stage><stage stageid="ac3050c9-47ce-4a61-af9b-013c4122fd9b" name="Throw" type="Exception"><subsheetid>5daa82fa-472f-4240-aea4-d7eb96390ff5</subsheetid><display x="105" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="0ffbdf34-9c20-4880-aff8-6f288cc0ef73" name="Copy Filtered Rows to Clipboard" type="SubSheetInfo"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><narrative>Copies Filtered Rows to Clipboard</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="85ec6ce0-03d7-4301-90ed-7e2a052188b1" name="End" type="End"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" narrative="Output Message" stage="Message" /><output type="flag" name="Success" narrative="Sucess Flag" stage="Success" /></outputs></stage><stage stageid="06faac4f-72e5-47c1-b84b-05c15f3d7996" name="Start" type="Start"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><preconditions><condition narrative="None" /></preconditions><postconditions><condition narrative="None" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel Handle" stage="Handle" /><input type="text" name="Workbook" narrative="Name of the excel Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Name of the excel Worksheet" stage="Worksheet" /></inputs><onsuccess>15bcb649-ff52-4f90-956e-517a6adbae43</onsuccess></stage><stage stageid="2addbe53-2e39-4152-9ab5-da6bbaf8cf06" name="Handle" type="Data"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="-495" y="-105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bda15466-a21c-44cb-83f1-d0cec1d39715" name="Workbook" type="Data"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="-495" y="-75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="418b7153-6b32-45e2-a189-db759de4e637" name="Worksheet" type="Data"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="-495" y="-45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="492122bd-b61c-482f-9942-59e401deadf7" name="Success" type="Data"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="-495" y="75" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="306ebf47-5498-4b44-a096-7b8a27ee0112" name="Message" type="Data"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="-495" y="105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="29c5f7dd-8b64-439c-9b83-804e034183e9" name="Input Parameters" type="Block"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><display x="-585" y="-150" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9c2de24d-6cf3-4662-94d5-769de2771c49" name="Output Parameters" type="Block"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><display x="-585" y="30" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="2ac3c7e6-ee2c-4e7c-83d0-9182786569b0" name="Recover" type="Recover"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><display x="180" y="-60" /><onsuccess>cd12fa16-427f-41ec-8352-7f9a7a320751</onsuccess></stage><stage stageid="cd12fa16-427f-41ec-8352-7f9a7a320751" name="Exception" type="Exception"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><display x="180" y="45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="15bcb649-ff52-4f90-956e-517a6adbae43" name="Copy Filtered Rows to Clipboard" type="Code"><subsheetid>5c229149-dd3d-4570-abd7-54c9f76db65f</subsheetid><loginhibit /><display x="15" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>85ec6ce0-03d7-4301-90ed-7e2a052188b1</onsuccess><code><![CDATA[

Dim wb, ws As Object
Dim excel, xlSheet1 As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
excel = wb.Application

wb.Activate()
ws.Activate()
excel = ws.Application
xlSheet1 = excel.ActiveSheet

xlSheet1.usedrange.specialcells(12).copy

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	excel = Nothing
End Try
]]></code></stage><stage stageid="7cb6cc41-81c6-456d-b640-df74dccf414e" name="Refresh Pivot Table" type="SubSheetInfo"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><narrative>Refreshes Pivot Table</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b278191c-19aa-4cc5-85f6-b898fe09e0b5" name="End" type="End"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" narrative="Output Message" stage="Message" /><output type="flag" name="Success" narrative="Sucess Flag" stage="Success" /></outputs></stage><stage stageid="b87101c3-98a9-40d2-8a2a-fa6765c43122" name="Start" type="Start"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><preconditions><condition narrative="None" /></preconditions><postconditions><condition narrative="None" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel Handle" stage="Handle" /><input type="text" name="Pivot Table Name" narrative="Name of the Pivot to Refresh" stage="Pivot Table Name" /></inputs><onsuccess>981b15a1-907e-49a0-bfa5-73f331b9bd9b</onsuccess></stage><stage stageid="e7bc100b-d243-48ae-b1d5-6de98e411bc5" name="Handle" type="Data"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><display x="-495" y="-105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc86db6a-4d82-41ae-b2f7-ba216c1b16cd" name="Success" type="Data"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><display x="-495" y="75" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b5b5588-0a3a-4794-b567-d29b15c40522" name="Message" type="Data"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><display x="-495" y="105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3dff3476-4afd-424e-af44-6e94e2900a5f" name="Input Parameters" type="Block"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><display x="-585" y="-150" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="07253c93-2dcd-4f38-bfc8-461274558182" name="Output Parameters" type="Block"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><display x="-585" y="30" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="1bc78583-9e5b-4796-967d-aa036e70d280" name="Recover" type="Recover"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><display x="180" y="-60" /><onsuccess>7e956183-560a-4b60-8b2b-6d39282bdc0a</onsuccess></stage><stage stageid="7e956183-560a-4b60-8b2b-6d39282bdc0a" name="Exception" type="Exception"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><display x="180" y="45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="981b15a1-907e-49a0-bfa5-73f331b9bd9b" name="Refresh Pivot Table" type="Code"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[Handle]" /><input type="text" name="Pivot_Name" expr="[Pivot Table Name]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>b278191c-19aa-4cc5-85f6-b898fe09e0b5</onsuccess><code><![CDATA[Try

GetWorkbook(handle, "").ActiveSheet.PivotTables(Pivot_Name).RefreshTable
Success = True

Catch e As Exception
	Success = False
	Message = e.Message

End Try]]></code></stage><stage stageid="8fbe3da9-d9da-4912-9fe1-e6e8ee95c6ad" name="Pivot Table Name" type="Data"><subsheetid>8268a66f-b302-4cc5-b472-335beba09c72</subsheetid><display x="-495" y="-75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="490f8dff-fb45-4869-8bc8-48a0440ed151" name="Convert Excel Headers From R1C1 Format To A1 Format" type="SubSheetInfo"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><narrative>This action is used to Convert Excel Headers From R1C1 Format To A1 Format. Reference Style As Enumeration = 1 for "xlA1" and -4150 for "R1C1"</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e948ea5b-30ea-486b-ae40-6c9c580ff9f4" name="Start" type="Start"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="The handle of excel instance" stage="handle" /><input type="number" name="Reference Style As Enumeration" narrative="Reference Style As Enumeration. 1 for &quot;xlA1&quot; and -4150 for &quot;R1C1&quot;" stage="Reference Style As Enumeration" /></inputs><onsuccess>c48c799a-2d5d-479b-a937-710fa5461b4f</onsuccess></stage><stage stageid="bee500f8-e8a0-469a-ba77-1c83fbcaf8b5" name="End" type="End"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="c48c799a-2d5d-479b-a937-710fa5461b4f" name="Convert Excel Headers From R1C1 Format To A1 Format" type="Code"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="Reference Style As Enumeration" expr="[Reference Style As Enumeration]" /></inputs><onsuccess>bee500f8-e8a0-469a-ba77-1c83fbcaf8b5</onsuccess><code><![CDATA[GetInstance(handle).ReferenceStyle = Reference_Style_As_Enumeration

]]></code></stage><stage stageid="93ff8dce-62c2-4146-9d63-c1f9c26577d8" name="handle" type="Data"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><loginhibit /><display x="-210" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be82785d-1905-4685-b934-7e8e04863bca" name="Reference Style As Enumeration" type="Data"><subsheetid>b01393d0-b7d2-4f38-8b8c-5bd3e4c8c0a9</subsheetid><loginhibit /><display x="-210" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0068b69b-15c1-4fd7-8cd4-76090f4cb615" name="Convert Entire Column From Text to Column" type="SubSheetInfo"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><narrative>This Page converts the  format as Text to Column for a specified Column Range And Paste the Formatted data in the Specified Column Range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f91c0745-8f97-48ad-a87e-a348d6f2bf8e" name="Start" type="Start"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="135" y="-90" /><inputs><input type="text" name="workbook" narrative="(Mandatory)Workbook name" stage="workbook" /><input type="text" name="worksheet" narrative="(Mandatory)WorkSheet name of the Excel File" stage="worksheet" /><input type="number" name="handle" narrative="(Mandatory)handle of open excel" stage="handle" /><input type="text" name="Range" narrative="(Mandatory)Range From Which Convert From Text To Column Occurs. Ex: A1:A100" stage="Range" /><input type="text" name="Cell_Reference" narrative="(Mandatory)Start Cell Reference. Ex: A1" stage="Cell_Ref" /></inputs><onsuccess>c83a6d30-b811-4e7e-b300-f04f167906b4</onsuccess></stage><stage stageid="8290bd02-3867-4b63-a119-8831f2b7de26" name="End" type="End"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="135" y="180" /></stage><stage stageid="d8ef1dbc-506d-425b-8925-46831a162344" name="workbook" type="Data"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="-240" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b35125e-fa04-4cd3-ac8e-b80d4a5076ec" name="worksheet" type="Data"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="-105" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b1dc5b3-6560-4f80-b403-56874740ca57" name="handle" type="Data"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="-165" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bac8cda5-49d3-44dc-8ef9-645ed0f93a23" name="Range" type="Data"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="-45" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c83a6d30-b811-4e7e-b300-f04f167906b4" name="Convert Entire Column From Text to Column" type="Code"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="135" y="30" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="text" name="Col_Range" expr="[Range]" /><input type="text" name="Cell_Ref" expr="[Cell_Ref]" /></inputs><onsuccess>8290bd02-3867-4b63-a119-8831f2b7de26</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(Col_Range).TextToColumns( _
        Destination:=.Range(Cell_Ref), _
        DataType:= 1, _
        TextQualifier:=1, _
        ConsecutiveDelimiter:=False)
        'TAB:=False, _
        'Semicolon:=False, _
        'Comma:=False, _
        'Space:=True, _
        'Other:=False, _
        'TrailingMinusNumbers:=False)

End with

]]></code></stage><stage stageid="f625ad51-fbd5-4a53-aef0-de5d9977c05a" name="Cell_Ref" type="Data"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="-225" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a1fccf7-621e-40f2-9a3a-1d8ff62de72c" name="Inputs" type="Block"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="-300" y="-15" w="315" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e4c90a94-5f6b-4191-bd06-ce54ac69e4c5" name="Convert Entire Column From Text to Column" type="Block"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="60" y="-15" w="225" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="65a411d8-533a-4323-bd0a-363d4856cf25" name="Throw : SE : Error in Convert Entire Column From Text to Column" type="Exception"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><display x="345" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Convert Entire Column From Text to Column| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="cec49a0e-4674-4fb3-bce3-7326d357681d" name="Recover2" type="Recover"><subsheetid>bdb747d3-22e8-439d-99d7-0cb60149d09c</subsheetid><loginhibit /><display x="240" y="30" /><onsuccess>65a411d8-533a-4323-bd0a-363d4856cf25</onsuccess></stage><stage stageid="cfcb9b56-865a-43cc-93e6-92b260ac87c7" name="Get Cell Formula" type="SubSheetInfo"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><narrative>Gets the formula of the specified cell - note that if the cell has some formatting set in it, this does *not* return the formatted value - See "Get Formatted Cell Value".
Note also that this has the side-effect of making the specified cell active.</narrative><display x="-195" y="-105" w="270" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="087ae2e7-05a4-4246-ba14-77f7b11cebbd" name="Start" type="Start"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance from which the required cell value should be retrieved. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Cell Reference" narrative="The cell reference indicating which cell's value should be retrieved. An empty value indicates that the currently active cell's value should be retrieved." stage="cellref" /></inputs><onsuccess>ff774586-6893-4bda-97bf-3d715df0f0dc</onsuccess></stage><stage stageid="603a792c-c9b7-466b-af50-d148a8a838bd" name="End" type="End"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Value" narrative="The (unformatted) value from the required cell." stage="value" /></outputs></stage><stage stageid="bc6d4454-3ece-4b39-b585-03c3b4566b23" name="cellref" type="Data"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8f2a32a5-e738-4eb6-9eab-b529824e0d26" name="value" type="Data"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><display x="-195" y="60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b1f0eda7-af5e-4505-a5f5-bf47fba873f5" name="Get Cell Formula" type="Code"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="cellref" expr="[cellref]" /></inputs><outputs><output type="text" name="value" stage="value" /></outputs><onsuccess>603a792c-c9b7-466b-af50-d148a8a838bd</onsuccess><code><![CDATA[
	Dim cellVal as String = GetInstance(handle).ActiveCell.Formula
	value = IIf(cellVal Is Nothing, "", cellVal)]]></code></stage><stage stageid="4de4b75b-2961-44b4-b680-8b6483b76477" name="Go To Cell" type="SubSheet"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be navigated to. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" narrative="The cell reference on the currently active sheet within the specified instance which should be navigated to." expr="[cellref]" /></inputs><onsuccess>b1f0eda7-af5e-4505-a5f5-bf47fba873f5</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="2e88d0ea-be26-4ba5-a398-e8da40ba7d47" name="handle" type="Data"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="ff774586-6893-4bda-97bf-3d715df0f0dc" name="cellref empty?" type="Decision"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="15" y="-90" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[cellref]=&quot;&quot;" /><ontrue>9772fab9-715c-4609-b9e6-2f5a1ac7cf26</ontrue><onfalse>4de4b75b-2961-44b4-b680-8b6483b76477</onfalse></stage><stage stageid="9772fab9-715c-4609-b9e6-2f5a1ac7cf26" name="anchor3" type="Anchor"><subsheetid>420b247a-f4e7-4d37-97db-f5c6c3b01204</subsheetid><loginhibit /><display x="105" y="-90" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>1e115618-227d-4607-939a-f7b85e047fb5</onsuccess></stage><stage stageid="1e