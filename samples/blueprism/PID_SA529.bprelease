"10" style="Regular" color="7FB2E5" /></stage><stage stageid="f8b5e088-5918-4a34-9dde-0e13ff557611" name="Inhouse" type="Block"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="-465" y="45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4789b3d9-0ade-4826-bd20-bf979343ad87" name="End" type="End"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="450" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Folder renamed Successfully&#xA;&quot; will be displayed" stage="Run Report" /></outputs></stage><stage stageid="661c09d0-be27-47c1-860e-d495aed27ee7" name="User Name" type="Data"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="-390" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="efc2c0ff-f0f0-4526-adca-2f1b3c57c8de" name="New_Foldername" type="Data"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="-180" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="47951046-066b-4ac3-90bd-2ea5a2b96ab0" name="GetField_InternalName" type="SubSheetInfo"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><narrative>Get internal Field names for a list or library.
This action is to help developer for using other actions where column/field names plays vital role.</narrative><display x="-195" y="-165" w="150" h="90" /></stage><stage stageid="deb3244f-cc12-40e1-b845-fdcbd0160c26" name="Start" type="Start"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="-300" /><inputs><input type="text" name="Sp_Url" narrative="SharePoint URL " stage="SP_Site_URL" /><input type="text" name="Sp_LIb/List" narrative="SP_Library or List name" stage="SP_RelLib_Url" /><input type="text" name="Script_Location" narrative="Temporary Script Location.(Optional.Default location C:\users\&lt;user&gt;\Documents)" stage="Script_Location" /><input type="text" name="Result_File_location" narrative="Location to share the output(Ex:- C:\Apps).(Optional. If not provided,It will share the result in C:\users\&lt;user&gt;\Documents" stage="Result_File_location" /></inputs><onsuccess>b4a5694d-1d92-4d2b-9900-f0ef6b0cdd70</onsuccess></stage><stage stageid="2a898e4c-93e3-48af-a714-4dba18ccd7f4" name="Export_ListLibrary_CSV_byColumns" type="SubSheetInfo"><subsheetid>fb2f5d95-347a-48e6-a9d7-9a6c1e54e22e</subsheetid><narrative>Export List or library Items to a CSV file.
Please make sure you are passing correct Field names . You can use "GetField_InternalName" to chekc the fields before you use.</narrative><display x="-390" y="-60" w="150" h="90" /></stage><stage stageid="1e40298f-41b9-462f-a4e3-82bd4d78565b" name="Start" type="Start"><subsheetid>fb2f5d95-347a-48e6-a9d7-9a6c1e54e22e</subsheetid><display x="15" y="-480" /><inputs><input type="collection" name="Column_names" narrative="Collection of all header/ fields need to be extracted." stage="Field_Names" /><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="List/Lib_Name" narrative="List or library name" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /><input type="text" name="Result_File_Loc" narrative="result File Location(optional)" stage="Result_File_location" /></inputs><onsuccess>a6d97120-df66-481f-8ba6-08995369f379</onsuccess></stage><stage stageid="bb778773-af82-408e-affd-add0b26bff0f" name="Build Script" type="Calculation"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="-135" /><onsuccess>2dfe3d89-02a9-4a01-bb47-6c134656886f</onsuccess><calculation expression="&quot;$outputfile= &quot; &amp; Chr(34)  &amp;[Result_File_location] &amp; &quot;\Result.txt&quot;&amp; Chr(34) &amp; NewLine() &amp; &#xA;&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;if (Test-Path $outputfile -PathType Leaf)&quot;&amp; NewLine() &amp; &#xA;&quot;    {&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;        Remove-Item $outputfile -Force&quot;&amp; NewLine() &amp; &#xA;        &#xA;&quot;    }&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else { New-Item $outputfile -ItemType File -ErrorAction Stop }&quot;&amp; NewLine() &amp; &#xA;&quot;Get-PnPField -List $SourceName -ErrorAction Stop &gt;$outputfile&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Write-Host &quot; &amp; Chr(34) &amp;  &quot;Output file&quot;&amp; Chr(34) &amp; &quot; $outputfile &quot; &amp; Chr(34) &amp; &quot;created.&quot;&amp; Chr(34) &amp; NewLine() &amp;&#xA;&#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="121cfca3-de10-43bf-9ec5-fcca984d2ca3" name="Run PnP_Script" type="SubSheet"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="15" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>8bb6fda3-9dc2-4368-b45f-b0ef1ad99d1f</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="82456cb9-9447-44da-b2b9-3afb22c53f2b" name="Delete_Script" type="Action"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="270" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>118ae09e-5596-48a7-a93e-66c62e8dc0b8</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="2dfe3d89-02a9-4a01-bb47-6c134656886f" name="Generate_PnPScript" type="SubSheet"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="-90" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;FieldInternal_Name&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>1855953e-dc28-4089-86df-14657abfc8bc</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="1855953e-dc28-4089-86df-14657abfc8bc" name="Check_Error" type="Decision"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="-45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c6f06449-102c-437a-9a72-be1fe4d18d49</ontrue><onfalse>121cfca3-de10-43bf-9ec5-fcca984d2ca3</onfalse></stage><stage stageid="c6f06449-102c-437a-9a72-be1fe4d18d49" name="Exception while creating  Script" type="Exception"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="405" y="-45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="1568cb40-cd27-49f3-b4ab-fe6110b74ebf" name="Check Process_Exist" type="Action"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="120" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>f06741ae-f80c-4508-96c0-f5647063a4f7</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="f06741ae-f80c-4508-96c0-f5647063a4f7" name="ProcessExist?" type="Decision"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="165" /><decision expression="[P_Exists]=True" /><ontrue>f45ba604-502f-44da-bacf-0d5b8b281ee6</ontrue><onfalse>3e4d6e6a-55d8-48ec-b317-7396bfa08121</onfalse></stage><stage stageid="3e4d6e6a-55d8-48ec-b317-7396bfa08121" name="Anchor8" type="Anchor"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="285" y="165" w="10" h="10" /><onsuccess>9232a2dc-713f-4a1f-a1d6-c401b6697885</onsuccess></stage><stage stageid="f45ba604-502f-44da-bacf-0d5b8b281ee6" name="Kill Process" type="Action"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="210" y="210" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>82456cb9-9447-44da-b2b9-3afb22c53f2b</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="9232a2dc-713f-4a1f-a1d6-c401b6697885" name="Anchor9" type="Anchor"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="285" y="270" w="10" h="10" /><onsuccess>82456cb9-9447-44da-b2b9-3afb22c53f2b</onsuccess></stage><stage stageid="4658e84f-22bf-4ba0-84c7-e10c5c2b15b6" name="SP_Site_URL" type="Data"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="-45" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="798548f5-0acc-4c87-8320-4ff2c8152070" name="SP_RelLib_Url" type="Data"><subsheetid>be8dad0a-d314-449d-a8e3-1224e657ea65</subsheetid><display x="-30" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="34090f58-4d03-4bcd-a20f-d7ac1881cad6" nam