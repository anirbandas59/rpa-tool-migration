="Status" /></outputs></stage><stage stageid="1fcf3c1e-a1b5-497f-b2ac-50bc7c4f524d" name="Start" type="Start"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><preconditions><condition narrative="Make sure the script should be available." /></preconditions><display x="-15" y="-135" /><inputs><input type="text" name="Script_Path" narrative="Script Location" stage="Script_Path" /><input type="text" name="Application" narrative="Application.exe" stage="Application" /></inputs><onsuccess>d99ff84f-11d9-4b61-a8fc-57dff9851931</onsuccess></stage><stage stageid="abbefc43-e916-4631-8e25-2628dfc3969c" name="End" type="End"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-15" y="90" /><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Success_Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs></stage><stage stageid="d99ff84f-11d9-4b61-a8fc-57dff9851931" name="Run Power Shell Script1" type="Code"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-15" y="-60" /><inputs><input type="text" name="Script_Path" expr="[Script_Path]" /><input type="text" name="Application_nm" expr="[Application]" /></inputs><outputs><output type="text" name="S_MSG" stage="Success_Message" /><output type="text" name="E_MSG" stage="Error_Message" /></outputs><onsuccess>b13fc53f-248f-4b10-81c3-d137c27ed387</onsuccess><code><![CDATA[String Sc_Path;
S_MSG = "";
E_MSG = "";

Process process = new Process();
{
	try
		{
			string eOut = null;		
			Sc_Path = Script_Path;
			ProcessStartInfo startInfo = new ProcessStartInfo();
            startInfo.FileName = Application_nm;
            startInfo.Arguments = Sc_Path;     
            startInfo.RedirectStandardOutput = true;
            startInfo.RedirectStandardError = true;
            startInfo.UseShellExecute = false;
            startInfo.CreateNoWindow = true;
            
            process.StartInfo = startInfo;
            process.Start();
			StreamReader Response = process.StandardOutput;
			S_MSG= Response.ReadToEnd();
			E_MSG= process.StandardError.ReadToEnd();
			
			process.WaitForExit();
		}
	catch (Exception exp)
		{
			
			E_MSG = string.Format("",exp);
			
			
		}
}]]></code></stage><stage stageid="e1a22dbc-206f-479b-861f-ed1ec346b685" name="Success_Message" type="Data"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="89284397-0e57-48fd-ba70-74cf117c2c99" name="Script_Path" type="Data"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-225" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e19fb2e-9030-4323-9327-b7d9640b2179" name="Application" type="Data"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><narrative>Hardcoded to powershell.exe </narrative><display x="-225" y="-15" /><datatype>text</datatype><initialvalue xml:space="preserve">powershell.exe</initialvalue><private /><alwaysinit /></stage><stage stageid="a95164db-9fe7-4130-8664-ed60ecb461d6" name="Error_Message" type="Data"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><display x="-225" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b13fc53f-248f-4b10-81c3-d137c27ed387" name="Forbidden error?" type="Decision"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><loginhibit /><display x="-15" y="-15" /><decision expression="(InStr([Error_Message], &quot;403&quot;))&gt;0 AND (InStr(Lower([Error_Message]), &quot;forbidden&quot;))&gt;0" /><ontrue>551fa2ce-a172-4443-88d9-6c075df67817</ontrue><onfalse>0228d111-cedf-4a8b-bee9-8be76501b5c1</onfalse></stage><stage stageid="0e8f1c2a-26e5-4270-b271-c8a46bccb4f9" name="Time Out1" type="WaitEnd"><subsheetid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</subsheetid><loginhibit /><display x="120" y="-15" w="30" h="30" /><onsuccess>c252b095-2ff6-47bf-9424-892bc9a2a662</onsuccess><groupid>da4f9eab-ce44-4feb-b643-f9266f37b6eb</groupid></stage><stage stageid="551fa2ce-a172-4443-88d9-6c075df67817" name="Wait1" type="WaitStart"><subsheetid>7c20ffe9-31ed-4311