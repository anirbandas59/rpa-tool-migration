An Exception will occur if access to the credentials is not allowed, based on the running Resource, Process and User.</narrative><display x="15" y="75" /><inputs><input type="text" name="Credentials Name" narrative="The name of the credentials to get" expr="[RPA_Sharepoint_Credential_Name]" /></inputs><outputs><output type="text" name="Username" narrative="The user name" stage="" /><output type="password" name="Password" narrative="The password" stage="Client_Secret" /><output type="date" name="Expiry Date" narrative="The expiry date" stage="" /><output type="text" name="Status" narrative="The status" stage="" /></outputs><onsuccess>dfa437f4-85aa-4467-914a-bfb7a7a5bdfa</onsuccess><resource object="Blueprism.Automate.clsCredentialsActions" action="Get" /></stage><stage stageid="9a5f5f29-b77a-4718-ac3f-fc3b3fbb2771" name="RPA_Sharepoint_Credential_Name" type="Data"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-360" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Sharepoint_API_Credential</initialvalue><exposure>Environment</exposure><alwaysinit /></stage><stage stageid="3b78cd68-147d-44d3-8fb4-677c5174ae24" name="RPA_Sharepoint_URL" type="Data"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-360" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><alwaysinit /></stage><stage stageid="7234031b-f113-46af-99af-afcb68c547c8" name="RPA_Sharepoint_Bearer_Token" type="Data"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-360" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><alwaysinit /></stage><stage stageid="ece318e4-71bf-4719-a07e-192799831e89" name="Client_Secret" type="Data"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-360" y="180" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysini