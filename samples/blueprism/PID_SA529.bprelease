3678c68c</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7b5022cd-9738-43cf-800f-77adb4a4bafb" name="End" type="End"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="4ed909f0-cdc9-429e-a7e9-f654e42441d8" name="Start" type="Start"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="handle of opened workbook" stage="handle" /><input type="text" name="From_CellReference" narrative="First Cell address from where the values to be converted" stage="from_cellref" /><input type="text" name="To_CellReference" narrative="Last Cell address till where the values to be converted" stage="to_cellref" /></inputs><onsuccess>6d76c7d7-c06f-474a-b671-d20ce12779e4</onsuccess></stage><stage stageid="6d76c7d7-c06f-474a-b671-d20ce12779e4" name="Activate Workbook" type="SubSheet"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>5ef38816-aeb6-4b16-a2bb-97076128a583</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="bd4396ee-46da-4c05-8e60-6f5facfd342f" name="handle" type="Data"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="04db655b-6ee8-4d88-a611-5332ce63f407" name="from_cellref" type="Data"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0dc63a17-ea43-4c93-b7c9-4c2c3246bb71" name="to_cellref" type="Data"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ef38816-aeb6-4b16-a2bb-97076128a583" name="Convert Text to Columns" type="Code"><subsheetid>da043e01-c5a3-4439-baf8-24d33678c68c</subsheetid><loginhibit /><narrative>Set rng = [C7]
    Set rng = Range(rng, Cells(Rows.Count, rng.Column).End(xlUp))

Range(Selection, Selection.End(xlDown)).Select
Selection.TextToColumns Destination:=Range("O6"), DataType:=xlDelimited, _
    TextQualifier:=xlDoubleQuote, ConsecutiveDelimiter:=False, Tab:=True, _
    Semicolon:=False, Comma:=False, Space:=False, Other:=False, FieldInfo _
    :=Array(1, 1), TrailingMinusNumbers:=True</narrative><display x="15" y="15" w="150" h="30" /><inputs><input type="text" name="from_cellref" expr="[from_cellref]" /><input type="text" name="to_cellref" expr="[to_cellref]" /><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>7b5022cd-9738-43cf-800f-77adb4a4bafb</onsuccess><code><![CDATA['GetWorkbook(handle, "").ActiveSheet.Range(from_cellref,from_cellref).TextToColumns(Destination:=rng, DataType:=xlDelimited)
'xlSheet1.Range(Col_Addr & "2:" & Col_Addr & "3").AutoFill(Destination:=xlSheet1.Range(Col_Addr & "2:" & Col_Addr & RowCount), Type:=0)
GetWorkbook(handle, "").ActiveSheet.Range("D1:D4747").TextToColumns(Destination:=GetWorkbook(handle, "").ActiveSheet.Range("D1:D4747"), DataType:=2,  TrailingMinusNumbers:=True)]]></code></stage><stage stageid="2d76d7f3-382c-45af-a5d0-c2bf650b3cb5" name="Get Column Count" type="SubSheetInfo"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><narrative>Returns Column count of mentioned column</narrative><display x="-195" y="-150" w="150" h="90" /></stage><stage stageid="d32979ce-8546-4b88-b0e4-237fe483646b" name="End" type="End"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="Column Count" narrative="Column Count" stage="Col_count" /></outputs></stage><stage stageid="20e7e2ae-46b2-4799-8c19-5cdcbae19eaf" name="Start" type="Start"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-165" /><inputs><input type="number" name="handle" stage="handle" /><input type="text" name="workbook" stage="Workbook" /><input type="text" name="worksheet" stage="Worksheet" /><input type="text" name="Column Name" stage="Column Name" /></inputs><onsuccess>3b19bc24-24b0-436e-bcd0-1d2d6633b925</onsuccess></stage><stage stageid="2c5b69bb-4ca6-4236-b864-513b40ca47fb" name="Workbook" type="Data"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="29b2eb80-d255-4b8b-b437-831439bae71f" name="Worksheet" type="Data"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="51448672-18b6-4cfc-9faf-04f25795ab1c" name="handle" type="Data"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><display x="-195" y="-75" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3b19bc24-24b0-436e-bcd0-1d2d6633b925" name="Activate Workbook" type="SubSheet"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit /><display x="15" y="-90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>7388d806-509a-40f3-870a-74d9b7e60445</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="7388d806-509a-40f3-870a-74d9b7e60445" name="Get Column Count" type="Code"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><loginhibit /><narrative>GetObject( , "Excel.Application")
</narrative><display x="15" y="0" w="150" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Column_name" expr="[Column Name]" /></inputs><outputs><output type="number" name="Col_count" stage="Col_count" /></outputs><onsuccess>d32979ce-8546-4b88-b0e4-237fe483646b</onsuccess><code><![CDATA[Col_count = GetObject( , "Excel.Application").Match(Column_name, GetWorkbook(handle, "").ActiveSheet.Range("1:1"), 0)]]></code></stage><stage stageid="8f835104-af39-421e-a65e-53bafbb66e0c" name="Col_count" type="Data"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a1d8228d-3f77-487b-b3dd-8351a5adf39e" name="Column Name" type="Data"><subsheetid>9411e595-49ca-4231-9d50-8933bec4ef26</subsheetid><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="80b8e682-6c62-4ed6-9f1d-857ee95c1bdb" name="Find Next Non Empty Cell" type="SubSheetInfo"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><narrative>Searches for the next non empty cell in the direction given.
This can either activate that cell before returning, or just return the cell reference while leaving the active cell as it was.

Params:
- handle : Number : The integer handle identifying the Excel instance to use. The default of zero indicates the 'current' instance.
- Direction : Text : The direction in which to go, this should start with "U", "D", "L" or "R" (not case-sensitive) - the rest of the string is ignored, so you can use "Up", "DOWN" "left" and, indeed, "r"
- Activate Cell? : Flag : True to activate the found cell, False to just return the reference. Default is False.

Returns:
- Cell Reference : Text : The cell ID which represents the next empty cell in the required direction. This will be blank if no empty cell was found in the given direction.

Exceptions:
Invalid Direction Parameter : If the given direction parameter was invalid - ie. did not start with one of the (case-insensitive) letters "U", "D", "L" or "R".</narrative><display x="-300" y="-195" w="450" h="270" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="d164f666-2f7d-48cc-a605-2efa6b39d71c" name="Start" type="Start"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="-15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Direction" narrative="The direction in which the next empty cell is required. This should start with any of &quot;U&quot;, &quot;D&quot;, &quot;L&quot; or &quot;R&quot; to find a cell up, down, left or right respectively. The direction parameter is not case-sensitive." stage="direction" /><input type="flag" name="Activate Cell?" narrative="True to activate the cell which is found; False to just return the reference and leave the active cell as it was before. Default is False." stage="activatecell" /></inputs><onsuccess>1aa56474-b3c2-4618-a170-2c4557b0afba</onsuccess></stage><stage stageid="5cdcc3a0-d9bd-480c-bce8-8010cbdc7d2e" name="End" type="End"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="-15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Cell Reference" narrative="The cell reference identifying the next empty cell from the active cell in the direction given. An empty value indicates that there were no empty cells between the active cell and a boundary." stage="cellref" /></outputs></stage><stage stageid="848a0254-cdbf-452a-902b-5a3c0a715b8c" name="direction" type="Data"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><display x="-240" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4aa8dfe2-efd2-442a-9101-1e9f25391e0c" name="cellref" type="Data"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><display x="-150" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1aa56474-b3c2-4618-a170-2c4557b0afba" name="Direction Valid?" type="Decision"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><narrative>Direction must start with one of the following:
- U : Indicates 'up'
- D : Indicates 'down'
- L : Indicates 'left'
- R : Indicates 'right'
Any other value (including empty text) is invalid</narrative><display x="-15" y="-75" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="Len(Trim([direction]))&gt;0 AND InStr(&quot;UDLR&quot;,Upper(Left(Trim([direction]),1)))&lt;&gt;0" /><ontrue>b850da6d-cba9-44aa-8f8c-af7fd7b65f2e</ontrue><onfalse>b4c2019c-e567-4399-a582-c3b2a6effa96</onfalse></stage><stage stageid="b4c2019c-e567-4399-a582-c3b2a6effa96" name="Invalid Direction Parameter" type="Exception"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><display x="150" y="-75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Invalid Direction Parameter" detail="&quot;Direction: '&quot; &amp; [direction] &amp; &quot;' is invalid - it must start with 'U', 'D', 'L' or 'R' (up, down, left or right)&quot;" /></stage><stage stageid="b850da6d-cba9-44aa-8f8c-af7fd7b65f2e" name="Find Non Empty Cell" type="Code"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="-15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="direction" expr="[direction]" /></inputs><outputs><output type="text" name="cellref" stage="cellref" /></outputs><onsuccess>4b0d1107-ebe9-47bb-b59b-cab3b9358776</onsuccess><code><![CDATA[
' The initial char of the direction (capitalised)
Dim strDir as String = direction.Trim().Substring(0,1).ToUpper()

' The excel instance
Dim excel as Object = GetInstance(handle)

' The excel enum representing the direction
' Note: setting to zero is just to nix a duff compiler warning
Dim dirn as Integer = 0

' xlDirection enum values from: 
' http://msdn.microsoft.com/en-us/library/bb241212.aspx

' Get the direction we need to go
Select Case strDir
	Case "U"
		dirn = -4162 ' Excel.XlDirection.xlToUp
	Case "D"
		dirn = -4121 ' Excel.XlDirection.xlToDown
	Case "L"
		dirn = -4159 ' Excel.XlDirection.xlToLeft
	Case "R"
		dirn = -4161 ' Excel.XlDirection.xlToRight
	Case Else
		Throw New ArgumentException("Invalid Direction: " & strDir)
End Select

Dim cell as Object = excel.ActiveCell

While True

	' First check the next one along - if that's blank then we're away..
	Dim nextCell as Object = GetNextCell(cell, strDir)

	' If the cell address is the same on moving - that indicates we're
	' at a limit (eg. 1st column going left, last row going down etc.)
	' Just return empty to indicate that there are no blank cells in
	' that direction.
	If cell.Address = nextCell.Address Then
		cellref = ""
		Return
	ElseIf nextCell.Value <> Nothing Then ' We've found our blank
		cellref = nextCell.Address(False,False)
		Return
	End If
	
	cell = nextCell
	
	' Quick way (rather than plodding from one cell to the next)
	' is to effectively press the 'End' key - but this is highly
	' inconsistent in what it returns.
	' Go to the 'end' of the range - ie. the last filled cell
	' cell = cell.End(dirn)
	' Now we need to go one beyond, ie. to the next cell
	' cell = GetNextCell(cell, strDir)

End While
]]></code></stage><stage stageid="bfbf0f37-9f71-4a2a-9c26-fff69c4d70ce" name="handle" type="Data"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><display x="-240" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c80460eb-ede8-4df1-b1a7-7c1b0b6fdc96" name="activatecell" type="Data"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><display x="-150" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="4b0d1107-ebe9-47bb-b59b-cab3b9358776" name="Activate Cell?" type="Decision"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="-15" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[activatecell]" /><ontrue>b0a81b2b-56d8-47b1-b238-2f6ee9a95bfd</ontrue><onfalse>5cdcc3a0-d9bd-480c-bce8-8010cbdc7d2e</onfalse></stage><stage stageid="b0a81b2b-56d8-47b1-b238-2f6ee9a95bfd" name="Go To Cell" type="SubSheet"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="135" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Cell Reference" expr="[cellref]" /></inputs><onsuccess>6aec45fd-3c9b-4435-8f13-e75db36a05ba</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="6aec45fd-3c9b-4435-8f13-e75db36a05ba" name="anchor2" type="Anchor"><subsheetid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</subsheetid><loginhibit /><display x="135" y="105" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>5cdcc3a0-d9bd-480c-bce8-8010cbdc7d2e</onsuccess></stage><stage stageid="aaa89494-faaa-4472-a6a2-c725f4540ca8" name="Go To Next Non Empty Cell Left" type="SubSheetInfo"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><narrative>Activates the next non empty cell that can be found on the left of the active cell.</narrative><display x="-210" y="-105" w="210" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="da07e6eb-8649-4cd0-b42a-cf8541e7c188" name="Start" type="Start"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><loginhibit /><display x="-30" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be found. The default of zero indicates the currently active instance." stage="handle" /></inputs><onsuccess>c8b77cb2-37eb-47aa-9638-1a99cd01db8a</onsuccess></stage><stage stageid="b40febe4-27b4-4c9e-b024-9c65e7cd55fc" name="End" type="End"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><loginhibit /><display x="-30" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Cell Reference" narrative="The reference of the cell which has been found to be empty - an empty value indicates that no empty cells were found." stage="cellref" /></outputs></stage><stage stageid="c8b77cb2-37eb-47aa-9638-1a99cd01db8a" name="Find Next Non Empty Cell" type="SubSheet"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><loginhibit /><display x="-30" y="-60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Direction" narrative="The direction in which the next empty cell is required. This should start with any of &quot;U&quot;, &quot;D&quot;, &quot;L&quot; or &quot;R&quot; to find a cell up, down, left or right respectively. The direction parameter is not case-sensitive." expr="&quot;L&quot;" /><input type="flag" name="Activate Cell?" narrative="True to activate the cell which is found; False to just return the reference and leave the active cell as it was before. Default is False." expr="True" /></inputs><outputs><output type="text" name="Cell Reference" narrative="The cell reference identifying the next empty cell from the active cell in the direction given. An empty value indicates that there were no empty cells between the active cell and a boundary." stage="cellref" /></outputs><onsuccess>b40febe4-27b4-4c9e-b024-9c65e7cd55fc</onsuccess><processid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</processid></stage><stage stageid="2d85c37c-f416-4b59-8590-b2ccc4218b4f" name="handle" type="Data"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="b30c1cfe-150b-47b9-95e5-47d25b74a9fa" name="cellref" type="Data"><subsheetid>9a25317d-e769-4b77-b946-8476741c4477</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="710fd2da-e785-48f8-b5fd-4bbe1117fd8e" name="Find value" type="SubSheetInfo"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><narrative>Finds the value in Excel and returns the cell reference</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="39911ca4-c9f5-4299-baa7-a265d7e1e978" name="End" type="End"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="105" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="cellRef" narrative="Cell Address of the found text" stage="CellRef" /></outputs></stage><stage stageid="504a06a9-237b-46a3-92d0-a02b3ad5e8d6" name="Handle" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="665606fa-8409-4a8a-91c4-0b16af9b05e9" name="Workbook" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7d04bb5f-2be2-4c00-89a9-fe1d159ede56" name="Worksheet" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3f95cc22-16b4-4fcd-8ef9-4804f50c0512" name="Start" type="Start"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="105" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Handle" stage="Handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Cell Reference" stage="Cell Reference" /><input type="text" name="valueToFind" narrative="valueToFind" stage="valueToFind" /></inputs><onsuccess>0be09077-dd9f-47ae-98fc-5c25ef1780bd</onsuccess></stage><stage stageid="4b89f9f3-afa0-4e4d-bbda-eb47ce74add2" name="Cell Reference" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0be09077-dd9f-47ae-98fc-5c25ef1780bd" name="Find Value Exact" type="Code"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="105" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Cell Reference]" /><input type="text" name="valueToFind" expr="[valueToFind]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="FindValue1" stage="CellRef" /></outputs><onsuccess>eddece73-85e7-4802-9403-aa6487621d01</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object
dim FindValue as object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference)
FindValue=range.Find(What:=valueToFind, _
                  LookIn:=-4123, _
                  LookAt:=1, _
				  SearchOrder:=1, _
			      SearchDirection:=1, _
				  MatchCase:=True, _
				  SearchFormat:=False)
       

 FindValue1=FindValue.Address(False,False)
range.Select()

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                ws = Nothing
                excel = Nothing
                sheet = Nothing
                range = Nothing
End Try]]></code></stage><stage stageid="eddece73-85e7-4802-9403-aa6487621d01" name="Success?" type="Decision"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="105" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>39911ca4-c9f5-4299-baa7-a265d7e1e978</ontrue><onfalse>dbc18b9b-7262-4b6d-b462-585e6d00d5f2</onfalse></stage><stage stageid="dbc18b9b-7262-4b6d-b462-585e6d00d5f2" name="Exception" type="Exception"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="210" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to select row: &quot; &amp; [Message]" /></stage><stage stageid="159836a2-3567-4fc1-9a45-06b704a84850" name="Success" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3170ade1-452c-49e2-9c96-4e361bcc0bfa" name="Message" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2175001-ae29-4bb3-9d00-5ae84cad0078" name="CellRef" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="345" y="-30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b63b7458-497e-4663-b231-12a7b23b5ff4" name="valueToFind" type="Data"><subsheetid>28e249cc-96a8-4307-a64a-f080cea867bf</subsheetid><loginhibit onsuccess="true" /><display x="345" y="15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5bf75cd-88fd-4fe8-aeb9-094c6e984916" name="Go To Next Non Empty Cell Right" type="SubSheetInfo"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><narrative>Activates the next non empty cell that can be found on the right of the active cell.</narrative><display x="-210" y="-105" w="210" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="8bf95964-60f2-4061-9af1-1dac97e1316f" name="Start" type="Start"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><loginhibit /><display x="-30" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be found. The default of zero indicates the currently active instance." stage="handle" /></inputs><onsuccess>5870e9de-b0ed-4d1b-a277-c53a6b41b529</onsuccess></stage><stage stageid="d1a6a4f9-b115-41b4-82b0-c94e4da283f9" name="End" type="End"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><loginhibit /><display x="-30" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Cell Reference" narrative="The reference of the cell which has been found to be empty - an empty value indicates that no empty cells were found." stage="cellref" /></outputs></stage><stage stageid="5870e9de-b0ed-4d1b-a277-c53a6b41b529" name="Find Next Non Empty Cell" type="SubSheet"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><loginhibit /><display x="-30" y="-60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Direction" narrative="The direction in which the next empty cell is required. This should start with any of &quot;U&quot;, &quot;D&quot;, &quot;L&quot; or &quot;R&quot; to find a cell up, down, left or right respectively. The direction parameter is not case-sensitive." expr="&quot;R&quot;" /><input type="flag" name="Activate Cell?" narrative="True to activate the cell which is found; False to just return the reference and leave the active cell as it was before. Default is False." expr="True" /></inputs><outputs><output type="text" name="Cell Reference" narrative="The cell reference identifying the next empty cell from the active cell in the direction given. An empty value indicates that there were no empty cells between the active cell and a boundary." stage="cellref" /></outputs><onsuccess>d1a6a4f9-b115-41b4-82b0-c94e4da283f9</onsuccess><processid>f1fbdaf5-5b3a-42b3-9327-cd6d03c4a55e</processid></stage><stage stageid="6eb50774-8636-4d41-ba63-60dfec513d3d" name="handle" type="Data"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c5524123-7fdd-4ea9-8031-0ab1f792bec0" name="cellref" type="Data"><subsheetid>2201209a-f19a-45c6-8140-8e46814c1661</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3cc87e97-89d2-4bff-9966-adc3c8739faf" name="Go To Next Non Empty Cell Up" type="SubSheetInfo"><subsheetid>abe36f7d-aa08-4325-bfbc-095e5afc9d67</subsheetid><narrative>Activates the next non empty cell that can be found above the active cell.</narrative><display x="-210" y="-105" w="210" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></st