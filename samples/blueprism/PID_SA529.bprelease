]=True" /><ontrue>96108b3b-79aa-408a-9865-6a7c43e20ba0</ontrue><onfalse>6b9455c4-e6c9-4631-8798-ad788b4267ec</onfalse></stage><stage stageid="6b9455c4-e6c9-4631-8798-ad788b4267ec" name="Anchor8" type="Anchor"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="225" y="120" w="10" h="10" /><onsuccess>3ad5eb41-fdce-4577-ab41-f2615953c8c1</onsuccess></stage><stage stageid="96108b3b-79aa-408a-9865-6a7c43e20ba0" name="Kill Process" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="165" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>bfb1c261-3562-4c96-b2cf-573065e2f9b3</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="3ad5eb41-fdce-4577-ab41-f2615953c8c1" name="Anchor9" type="Anchor"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="225" y="225" w="10" h="10" /><onsuccess>bfb1c261-3562-4c96-b2cf-573065e2f9b3</onsuccess></stage><stage stageid="d4fb9d3c-e93a-48bd-9296-9e30fbdb8fe7" name="SP_Site_URL" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-105" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b6b5c7cb-b9ad-47ff-ba07-b106c4803ec7" name="SP_Target_Lib" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-105" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56812c14-dc99-4a10-b49e-6dedb0193035" name="Folder" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-30" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07daa41e-c268-4aad-9bc1-cdf433197880" name="Input" type="Block"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-165" y="-75" w="180" h="135" /><font family=