Location to create script(Ex:- C:\Apps\PID1)" stage="ScriptLocation" /><input type="text" name="Record type(List/ Library)" narrative="If list write100 , if library 101" stage="Record Type" /><input type="text" name="Output file path in csv" narrative="Enter the name of the file that is created to save the output" stage="Output File Path" /></inputs><onsuccess>7fad490e-fb17-4285-a6a9-b4069a108924</onsuccess></stage><stage stageid="ce308c5f-643c-4c86-99cc-01b6a6790887" name="End" type="End"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-165" y="495" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /><output type="text" name="File Path" narrative="Returns downloaded file complete file path" stage="Output File Path" /></outputs></stage><stage stageid="52cadeee-5568-4e85-a9ae-13d19e7b80b9" name="Build Script" type="Calculation"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-165" y="-120" /><onsuccess>c3ba908f-0db2-42d8-b64c-1a182d5c91f8</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;&#xA;$ExportFile = &quot;&amp; Chr(34) &amp; [Output File Path] &amp; Chr(34) &amp;  NewLine() &amp; &quot;&#xA;if (Test-Path $ExportFile -PathType Leaf)&#xA;    {&#xA;        Remove-Item $ExportFile -Force&#xA;    }&quot;&amp;  NewLine() &amp; &quot;&#xA;#Get the Libraries(code 101) , Lists (code 100)&quot;&amp;  NewLine() &amp; &quot;&#xA;$ListItems = Get-PnPList | Where-Object {$_.BaseTemplate -eq &quot;&amp;[Record Type]&amp;&quot; -and $_.Hidden -eq $false} &quot;&amp;  NewLine() &amp; &quot;&#xA;#Export the result Array to CSV file&quot;&amp;  NewLine() &amp; &quot;&#xA;$ListItems |Select Title, DefaultViewURL, ItemCount | Export-CSV $ExportFile -NoTypeInformation&quot;" stage="Script" /></stage><stage stageid="a837b27b-ee78-4d77-bf53-fe35275648e4" name="Run PnP_Script" type="SubSheet"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-165" y="60" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>97c65e1d-aa54-4e07-a597-618369b63e28</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="9d401912-ac1f-4e36-8a8a-2c9087800130" name="Delete_Script" type="Action"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-165" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ce308c5f-643c-4c86-99cc-01b6a6790887</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="c3ba908f-0db2-42d8-b64c-1a182d5c91f8" name="Generate_PnPScript" type="SubSheet"><subsheetid>078fde3c-0bcf-4c56-b873-aa0398439d79</subsheetid><display x="-165" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><i