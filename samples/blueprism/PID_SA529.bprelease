>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eec4a7f0-58f4-40d4-80e7-d344817dfee4" name="Worksheet" type="Data"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d86189bd-3575-4c61-8f5a-a86d9139d993" name="Start" type="Start"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="excel handle" stage="Handle" /><input type="text" name="Workbook" narrative="workbook name of the excel" stage="Workbook" /><input type="text" name="Worksheet" narrative="worksheet name of the excel sheet" stage="Worksheet" /><input type="text" name="ColName" narrative="Column name Ex: A1,B1" stage="Cell Reference" /></inputs><onsuccess>095f9f3e-37dd-4a55-b1f8-c42117f8e04c</onsuccess></stage><stage stageid="0d4f7e73-94b5-4479-b528-ee4a98c7b95b" name="Cell Reference" type="Data"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="-195" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="095f9f3e-37dd-4a55-b1f8-c42117f8e04c" name="Hide Column in excel sheet" type="Code"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><loginhibit /><narrative>Hides the entire Column</narrative><display x="15" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Cell Reference]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>654c48fe-7c19-4e69-9725-ed2bb8d96606</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object
Try
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference)
range.EntireColumn.Hidden = True
Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	ws = Nothing
	excel = Nothing
	sheet = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="654c48fe-7c19-4e69-9725-ed2bb8d96606" name="Success?" type="Decision"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><loginhibit /><display x="15" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>64054eef-77f4-47a2-8926-3a5bf3d6e7bd</ontrue><onfalse>b132fc3f-6f21-4959-80ae-1e437bc327c8</onfalse></stage><stage stageid="b132fc3f-6f21-4959-80ae-1e437bc327c8" name="Exception" type="Exception"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="120" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to select row: &quot; &amp; [Message]" /></stage><stage stageid="f5912d6b-f470-4387-b4d2-35f4303cc89b" name="Success" type="Data"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="-195" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="61905d52-df79-4aa0-877e-a46f6a342400" name="Message" type="Data"><subsheetid>9c16ac82-3e78-49d4-bf61-7fde329e8d36</subsheetid><display x="-195" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eed0621f-02c9-45bd-beea-69b3f577bbaf" name="Update Pivot Filters" type="SubSheetInfo"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><narrative>Update Pivot Filters</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="6b598aa8-8058-425e-9615-589a0d28662e" name="End" type="End"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" narrative="Output Message" stage="Message" /><output type="flag" name="Success" narrative="Sucess Flag" stage="Success" /></outputs></stage><stage stageid="52490e2d-3784-4b0f-9667-75bede0c0830" name="Start" type="Start"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><preconditions><condition narrative="Workbook should be open and Worksheet should be activated" /></preconditions><postconditions><condition narrative="None" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel Handle" stage="Handle" /><input type="text" name="Pivot Table Name" narrative="Name of the Pivot to Refresh" stage="Pivot Table Name" /><input type="text" name="Filter Name" narrative="Filter Name to update value" stage="Filter Name" /><input type="text" name="Value" narrative="Value to be updated in Filter" stage="Value" /></inputs><onsuccess>d00b5546-a661-4fae-95ee-b06c13ce1d19</onsuccess></stage><stage stageid="bb60b3c2-8bd1-4955-9554-72f20142c237" name="Handle" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="0" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6af0d38c-01df-4abc-b0da-1b0c37d5983c" name="Success" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="195" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="babb15ab-9bf2-4c58-9dd2-43964548a889" name="Message" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="225" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd90379a-0999-4e13-83b9-7fd79af04384" name="Input Parameters" type="Block"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><display x="-270" y="-30" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fd959193-f3e5-4b08-94f0-0a3ad426785a" name="Output Parameters" type="Block"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><display x="-270" y="150" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="02d0d833-fca6-4bfa-b8d6-9b6d3df42fe4" name="Recover" type="Recover"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><display x="180" y="-60" /><onsuccess>16cfbcfe-ffc0-4412-b4a5-9be3f89eeed1</onsuccess></stage><stage stageid="16cfbcfe-ffc0-4412-b4a5-9be3f89eeed1" name="Exception" type="Exception"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="180" y="45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="d00b5546-a661-4fae-95ee-b06c13ce1d19" name="Update Pivot Filters" type="Code"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[Handle]" /><input type="text" name="Pivot_Name" expr="[Pivot Table Name]" /><input type="text" name="Filter_Name" expr="[Filter Name]" /><input type="text" name="value" expr="[Value]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>6b598aa8-8058-425e-9615-589a0d28662e</onsuccess><code><![CDATA[Dim ws as object
Dim excel as object

Try

excel = GetWorkbook(handle, "").application
excel.ScreenUpdating = False

ws = GetWorkbook(handle, "").ActiveSheet
ws.PivotTables(Pivot_Name).ManualUpdate = True
ws.PivotTables(Pivot_Name).PivotFields(Filter_Name).ClearAllFilters
ws.PivotTables(Pivot_Name).PivotFields(Filter_Name).CurrentPage = value

ws.PivotTables(Pivot_Name).ManualUpdate = True
excel.ScreenUpdating = True

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
	ws = nothing
	excel= nothing
End Try]]></code></stage><stage stageid="6b55746a-c1b3-4051-b328-188c335844fe" name="Pivot Table Name" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="db0d1737-c9ca-4419-af54-dcc51a246d5e" name="Filter Name" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="90" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f832a589-190e-4e37-9497-7a2c6189d64c" name="Value" type="Data"><subsheetid>3c7cfc24-af80-4a41-9df3-717f1dce0153</subsheetid><display x="-180" y="60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8a59afb5-8c83-4371-bd14-b647747a60a2" name="Insert Column" type="SubSheetInfo"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><narrative>Insert Column in worksheet</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="716a67e8-57f6-4506-8ff0-9a37c59f2bf9" name="End" type="End"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="120" y="195" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="36a9cfde-eec5-4e24-aa45-5f2bbae49112" name="Handle" type="Data"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23e5b36b-6864-45fb-aa09-a3e10109349e" name="Workbook" type="Data"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d24e0b89-093a-4bfe-99ce-60d6e891df9e" name="Start" type="Start"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="handle of the workbook" stage="Handle" /><input type="text" name="Workbook" narrative="Workbook Name" stage="Workbook" /><input type="text" name="Shift (Left or Right)" narrative="Shift Left or Right the entire content ex: (Left) or (Right)" stage="Shift" /><input type="text" name="Worksheet" narrative="name of the worksheet" stage="Worksheet" /><input type="text" name="Range" narrative="Range to be inserted Ex:(A:A) or (B:B)" stage="Range" /></inputs><onsuccess>e8a7ef65-7abf-4ca6-b033-cd6ab8d6656f</onsuccess></stage><stage stageid="e3792028-9867-46fd-880f-c2924dfd0209" name="Insert Column" type="Code"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="120" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Shift_Type" expr="[Shift Type]" /><input type="password" name="Worksheet" expr="[Worksheet]" /><input type="text" name="RangeValue" expr="[Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>febf51a7-f7b6-4d62-9603-d5b76dfd058e</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object
Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
excel = wb.Application

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(RangeValue)
range.Select()
range.Insert (Shift:=Shift_Type, CopyOrigin:=0)


Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	excel = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="febf51a7-f7b6-4d62-9603-d5b76dfd058e" name="Success?" type="Decision"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="120" y="120" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>716a67e8-57f6-4506-8ff0-9a37c59f2bf9</ontrue><onfalse>cf22f35a-fa01-4bc0-bdef-d1a28a7d0a3d</onfalse></stage><stage stageid="cf22f35a-fa01-4bc0-bdef-d1a28a7d0a3d" name="Exception" type="Exception"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="225" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to delete selection: &quot; &amp; [Message]" /></stage><stage stageid="c46f9866-afd4-47ae-8523-79e5cfc0d982" name="Success" type="Data"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33d7e500-8e22-49bb-8d1a-7094442d0ad7" name="Message" type="Data"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="625a5ef3-b457-4144-b3ef-285ad7720209" name="Shift" type="Data"><subsheetid>8027a3d3-ebe3-4e4b-986e-fc029b2812a5</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8a7ef65-7abf-4ca6-b033-cd6ab8d6656f" name="Shift Left?" type="Decision"><subsheetid>8027a3d3-e