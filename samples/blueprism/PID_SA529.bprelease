 h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in creating Random Sheet | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="2b60f35e-f664-4126-a374-5b22a1327d1b" name="Create Rand Sheet" type="Code"><subsheetid>836930df-9597-48f0-9e2e-248c3890e5f7</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="text" name="RndSheet" stage="RndSheet" /></outputs><onsuccess>b69117b8-03e6-4be7-977e-41cc9d4fc70b</onsuccess><code><![CDATA['Create rand sheet
Dim xlSheet2 As Object
xlSheet2 = getinstance(handle).Workbooks(Workbook).WorkSheets.Add(,getinstance(handle).Workbooks(Workbook).Worksheets(getinstance(handle).Workbooks(Workbook).Worksheets.Count))
RndSheet = Rnd
xlSheet2.Name = RndSheet
getinstance(handle).Workbooks(Workbook).Save()]]></code></stage><stage stageid="0d5b5dd6-6d03-4304-9903-6cdd4eb92c31" name="Workbook" type="Data"><subsheetid>836930df-9597-48f0-9e2e-248c3890e5f7</subsheetid><display x="-270" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4d26d0ea-88d3-4f00-82c3-bc847c1fd2ee" name="handle" type="Data"><subsheetid>836930df-9597-48f0-9e2e-248c3890e5f7</subsheetid><display x="-210" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="adaf0c03-4b12-4a06-8f3e-e9b4565a331f" name="RndSheet" type="Data"><subsheetid>836930df-9597-48f0-9e2e-248c3890e5f7</subsheetid><display x="-255" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9a23de6c-f1c5-404a-b4a5-2a9256eedde6" name="Outputs" type="Block"><subsheetid>836930df-9597-48f0-9e2e-248c3890e5f7</subsheetid><loginhibit /><display x="-345" y="75" w="240" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f7c969e2-00d9-41ea-aac3-97d257ab2d55" name="Search Keyword" type="SubSheetInfo"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><narrative>Copy required set of data in to temp sheet</narrative><display x="-210" y="-120" w="150" h="90" /></stage><stage stageid="d0f6e651-de11-4edd-bbeb-b154350526ea" name="Start" type="Start"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="number" name="handle" narrative="handle of open excel" stage="handle" /><input type="text" name="Worksheet" narrative="Name of worksheet" stage="Worksheet" /><input type="text" name="RowNos" narrative="Number of rows to copy" stage="RowNos" /><input type="text" name="KeyWord" narrative="Keyword to search" stage="KeyWord" /><input type="text" name="PasteType" narrative="Keyword for paste (Normal : -4163, Paste Special : -4104)" stage="PasteType" /><input type="text" name="Direction" narrative="Direction of copy (1 - up, 2 - Down)" stage="Direction" /></inputs><onsuccess>c064316b-c3fe-40cd-bd1b-6e88a1ca0e25</onsuccess></stage><stage stageid="235e7a70-79e9-46bf-85e6-19eb0962aad5" name="End" type="End"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="15" y="135" /><outputs><output type="text" name="RndSheet" narrative="Temp sheet name" stage="RndSheet" /></outputs></stage><stage stageid="1fe005a8-5b7c-4cb6-be5a-cbca26eed9dc" name="Inputs" type="Block"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="-345" y="-60" w="240" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5b5ed066-a489-42d8-bdb3-9c72281aee1f" name="Outputs" type="Block"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="-345" y="120" w="240" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a9a45c22-bdfa-44d1-9d50-937e2a198912" name="Get Cell Value" type="Block"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="-60" y="-15" w="195" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3f4b0445-523f-4cb7-8909-5431d2eeb4ea" name="Recover" type="Recover"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="90" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>c826fbb5-f4fe-483e-80df-2e9f05933e7e</onsuccess></stage><stage stageid="c826fbb5-f4fe-483e-80df-2e9f05933e7e" name="Throw : SE : Error in copy data to temp sheet" type="Exception"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="210" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in copy data to temp sheet | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="090334b5-964e-4120-8b11-c45dbc5885cd" name="RndSheet" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-285" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e809a702-5283-4a19-a01e-e6395cb2586c" name="Workbook" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c6fa57a0-b36b-4334-a1b1-3d0fd945b1ad" name="Worksheet" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-285" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2b239330-c248-4b8e-adc6-55a0f379ce2b" name="handle" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-285" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1d448b30-0ff5-43dd-872f-3f8d5b214c55" name="KeyWord" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-225" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="54f56086-fa91-4bf0-a08b-54620cd409ad" name="PasteType" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-165" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a68268c-afb4-453c-9ffc-3ac258ad7ec5" name="Direction" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27f4dd73-e1b2-4ed4-b7b9-a9ea065574fd" name="RowNos" type="Data"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><display x="-285" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c064316b-c3fe-40cd-bd1b-6e88a1ca0e25" name="Get Required Data in Temp1" type="Code"><subsheetid>ceac273f-48a5-499d-9424-7b50b0d0557e</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="KeyWord" expr="[KeyWord]" /><input type="text" name="Direction" expr="[Direction]" /><input type="text" name="RowNos" expr="[RowNos]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="PasteType" expr="[PasteType]" /></inputs><outputs><output type="number" name="RndSheet" stage="RndSheet" /></outputs><onsuccess>235e7a70-79e9-46bf-85e6-19eb0962aad5</onsuccess><code><![CDATA[Dim xlSheet2 As Object
Const xlCellTypeLastCell As integer = 11
Dim FirstRow As Integer = 1
Dim xlPasteAll As integer = PasteType
Dim EmpresaRow As integer
Dim EmpresaCoumnNum As integer
Dim EmpresaCoumnTxt As String
Dim EmpresaAddress As String
Dim MyCount as integer
Dim LastColumn as integer
Dim LastCol as integer

'Select & copy target data
'1.Get last column
LastColumn  = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells.SpecialCells(xlCellTypeLastCell).Column

'2.Get last col
LastCol = Split(getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells(1, LastColumn).Address, "$")(1)

'Action Get_Number_Of_Occurences(Workbook,Worksheet,Keyword)
MyCount = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells.Find(What:=KeyWord, SearchDirection:=Direction, lookin:=-4123,LookAt:=2).Count

'
EmpresaRow  = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells.Find(What:=KeyWord, SearchDirection:=Direction, lookin:=-4123,LookAt:=2).Row
EmpresaCoumnNum  = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells.Find(What:=KeyWord, SearchDirection:=Direction, lookin:=-4123,LookAt:=2).Column
EmpresaCoumnTxt = Split(getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells(1, EmpresaCoumnNum).Address, "$")(1)

EmpresaAddress = EmpresaCoumnTxt & EmpresaRow

getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Range(EmpresaAddress & ":" & LastCol & EmpresaRow+RowNos).Copy

'Create rand sheet
xlSheet2 = getinstance(handle).Workbooks(Workbook).WorkSheets.Add(,getinstance(handle).Workbooks(Workbook).Worksheets(getinstance(handle).Workbooks(Workbook).Worksheets.Count))
RndSheet = Rnd
xlSheet2.Name = RndSheet
xlSheet2.Range("A1").PasteSpecial(Paste:=xlPasteAll, Transpose:=True)


'Copy data into rand sheet
xlSheet2.Activate
For i As Integer = EmpresaCoumnNum To FirstRow Step -1
	If xlSheet2.Application.CountA(xlSheet2.Rows(i)) = 0 Then
		xlSheet2.Rows(i).Delete
	End If
Next]]></code></stage><stage stageid="04a27e5c-7c19-4184-aec2-b64af471e362" name="Uppercase Cell" type="SubSheetInfo"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><narrative>Make given cell as Upper Case</narrative><display x="-210" y="-120" w="150" h="90" /></stage><stage stageid="5c0cd0d6-ef11-4377-9409-e9ff57d701c0" name="Start" type="Start"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="number" name="handle" narrative="handle of open excel" stage="handle" /><input type="text" name="Worksheet" narrative="Name of worksheet" stage="Worksheet" /><input type="number" name="Col" narrative="Column No" stage="Col" /><input type="number" name="Row" narrative="Row No" stage="Row" /></inputs><onsuccess>60191e85-ff3e-4716-b44f-90788fe02475</onsuccess></stage><stage stageid="8d207d6c-57dd-4261-b270-fb29f1099bd6" name="End" type="End"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="15" y="135" /></stage><stage stageid="60191e85-ff3e-4716-b44f-90788fe02475" name="Upper Case" type="Code"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="handle" expr="[handle]" /><input type="number" name="Col" expr="[Col]" /><input type="number" name="Row" expr="[Row]" /></inputs><onsuccess>8d207d6c-57dd-4261-b270-fb29f1099bd6</onsuccess><breakpoint type="0"><condition></condition></breakpoint><code><![CDATA[
getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells(Row,Col).Value = UCase(getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Cells(Row,Col).Value)]]></code></stage><stage stageid="5115d5e5-d4d6-49f4-ae2a-76a5b9d9674a" name="Workbook" type="Data"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><display x="-225" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e7ebfc1b-56c0-4572-908c-4b5a152c4130" name="Worksheet" type="Data"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><display x="-165" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1bec178d-7407-471a-b366-97c02830ce9f" name="Inputs" type="Block"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="-345" y="-60" w="240" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="bd037ffe-51e9-4b76-a92b-173d0ddc9b77" name="Get Cell Value" type="Block"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="-60" y="-15" w="195" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="76d94d67-0108-4b44-adc1-f342b09d8a83" name="Recover" type="Recover"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><display x="90" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>33b299ab-ec4d-4855-a0fb-a0a3b5e669bb</onsuccess></stage><stage stageid="33b299ab-ec4d-4855-a0fb-a0a3b5e669bb" name="Throw : SE : Error in making Uppercase" type="Exception"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><display x="210" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in making Uppercase | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="4d8f3357-b0a5-4321-a102-0cfc49c64a67" name="handle" type="Data"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="-285" y="-30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f1baa44-eb75-499e-bd7d-94a65e7bc22e" name="Col" type="Data"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="-285" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc8abcab-ab19-472a-9c74-b4daf1ca66c4" name="Row" type="Data"><subsheetid>8762e44e-5e97-4ab5-9a4b-663fd74793b1</subsheetid><loginhibit /><display x="-225" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aec7609a-4af7-44f1-a5a8-148382e4e132" name="Get Number of Visible Rows" type="SubSheetInfo"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><narrative>Get Number of Visible Rows -  Can be used to count filtered rows</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="30703f84-3c6b-420c-996c-c75c770650a8" name="End" type="End"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Number of rows" narrative="The number of rows." stage="rowcount" /></outputs></stage><stage stageid="3ea03d56-069c-48b9-abc9-107ffd38d8c6" name="Start" type="Start"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet on which the number of rows is required. The default empty text value indicates the currently active sheet on the specified workbook." stage="worksheetname" /></inputs><onsuccess>64cca333-1258-4e91-976d-5c7aa4833664</onsuccess></stage><stage stageid="64cca333-1258-4e91-976d-5c7aa4833664" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>865f9cf3-24c4-4db5-a08f-a484a8d6226e</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="865f9cf3-24c4-4db5-a08f-a484a8d6226e" name="Count Visble Rows" type="Code"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><loginhibit /><display x="15" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /></inputs><outputs><output type="number" name="rowcount" stage="rowcount" /></outputs><onsuccess>30703f84-3c6b-420c-996c-c75c770650a8</onsuccess><code><![CDATA[
' enum - Excel.XlSearchDirection.xlPrevious=2
rowcount = GetWorkbook(handle, "").ActiveSheet.usedrange.columns(1).specialcells(12).count]]></code></stage><stage stageid="cca575e7-6ced-4d66-9caa-0d49ea22d563" name="handle" type="Data"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><display x="-270" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e51ea245-020f-4288-bfb6-296ac065ad98" name="workbookname" type="Data"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><display x="-270" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f9857ce6-ee0d-4bc8-8231-ac5fa46a9e2a" name="worksheetname" type="Data"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><display x="-270" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="89f5e205-16fd-42dc-915b-52b0dcdc1206" name="rowcount" type="Data"><subsheetid>ba9575fe-c1de-46e3-a223-d7130266ee2f</subsheetid><display x="-150" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7e46fc86-54e2-4ed9-a2f2-5318727a8980" name="Get Number Of Rows" type="SubSheetInfo"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><narrative>Returns number of rows</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="63c230a8-888e-42d4-8c87-8fcd83e6b836" name="End" type="End"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="number" name="Number of rows" narrative="The number of columns" stage="colcount" /></outputs></stage><stage stageid="8c91732b-2553-4238-ba1c-cc1d23dad1c3" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><loginhibit /><display x="15" y="-75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>7054f3df-3d19-4f13-8eb4-2e14873e1d4a</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="bc0dd685-bcae-489b-aa90-2217865b8f0a" name="handle" type="Data"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><display x="-270" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="7118c602-2c7d-44a3-b5fc-7b7f465742cc" name="workbookname" type="Data"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><display x="-270" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c990a080-18aa-4882-aba1-7d3ca0ba387d" name="worksheetname" type="Data"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><display x="-270" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7054f3df-3d19-4f13-8eb4-2e14873e1d4a" name="Count column" type="Code"><subsheetid>0beaf323-acbc-4c5e-86fa-288e137706b9</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /></inputs><outputs><output type="number" name="colcount" stage="colcount" /></outputs><onsuccess>63c230a8-888e-42d4-8c87-8fcd83e6b836</onsuccess><code><![CDATA[
' enum - Excel.XlSearchDirection.xlPrevious=2
