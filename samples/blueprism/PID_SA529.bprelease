</narrative><display x="-525" y="-285" w="300" h="150" /></stage><stage stageid="2c725609-1371-4dc9-b245-9532176970e2" name="Unexpected exception recover" type="Recover"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-255" y="390" /><onsuccess>7ffe2791-f0d4-48b9-992a-c4552038ce6d</onsuccess></stage><stage stageid="c40f1f06-947a-4ec0-adc0-fae02823267c" name="Unexpected Exception" type="Exception"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-420" y="390" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="46fe6cb9-9feb-415f-9575-b6d3a47ecad4" name="IsDirExist" type="Data"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-600" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b956abb-5d4a-4729-b294-1aa8f846fe90" name="Script Path" type="Data"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-600" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="79ae8d72-1aa0-41a0-9e6f-a6467ccd31ed" name="Start" type="Start"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-165" y="-600" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="ScriptLocation" /><input type="text" name="SourceName" narrative="SourceName" stage="SourceName" /><input type="text" name="Output_TxtFilePath" narrative="Output_TxtFilePath" stage="Output_TxtFilePath" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>72b30b12-3e0b-4e03-a727-2ec5d95369aa</onsuccess></stage><stage stageid="116665ac-2f40-4628-a966-9853ecb74b29" name="End" type="End"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-165" y="510" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="c2d8b59b-571d-4f12-b463-7e358d39c3ef" name="Build Script" type="Calculation"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-165" y="-450" /><onsuccess>37774888-d4a9-4394-9b0a-e28d2d47c64a</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine()&amp; &quot;$outputfile= &quot;&amp;Chr(34)&amp;[Output_TxtFilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;$SourceName= &quot;&amp;Chr(34)&amp;[SourceName]&amp;Chr(34)&amp;NewLine()&amp;&quot; if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }&quot;&amp;NewLine()&amp;&quot;Else{ New-Item $outputfile -ItemType File -ErrorAction stop }&quot;&amp;NewLine()&amp;&quot;Add-Content  $outputfile -Value &quot;&amp;Chr(34)&amp;&quot;File ID__RPA__File Name__RPA__Relative Path&quot;&amp;Chr(34)&amp;NewLine()&amp; &quot; $AllItems = Get-PnPListItem -List $SourceName -PageSize 500  -Fields &quot;&amp;Chr(34)&amp;&quot;FSObjType&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;ID&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;FileLeafRef&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;FileDirRef&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;_ComplianceTag&quot;&amp;Chr(34)&amp;NewLine()&amp;&#xA;&quot; foreach ($itm in $AllItems)&quot;&amp;NewLine()&amp;&quot;{$fsObjType=$itm[&quot;&amp;Chr(34)&amp;&quot;FSObjType&quot;&amp;Chr(34)&amp;&quot;]&quot;&amp;NewLine()&amp;&quot;$recordStatus=$itm[&quot;&amp;Chr(34)&amp;&quot;_ComplianceTag&quot;&amp;Chr(34)&amp;&quot;]&quot;&amp;NewLine()&amp;&quot;if($fsObjType -eq 0 -and $recordStatus.Trim() -ne &quot;&amp;Chr(34)&amp;Chr(34)&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;{$fsObjType = $itm[&quot;&amp;Chr(34)&amp;&quot;FSObjType&quot;&amp;Chr(34)&amp;&quot;]&quot;&amp;NewLine()&amp;&quot;$recordStatus=$itm[&quot;&amp;Chr(34)&amp;&quot;_ComplianceTag&quot;&amp;Chr(34)&amp;&quot;]&quot;&amp;NewLine()&amp;&quot; $str = $itm[&quot;&amp;Chr(34)&amp;&quot;ID&quot;&amp;Chr(34)&amp;&quot;].ToString() + &quot;&amp;Chr(34)&amp;&quot;__RPA__&quot;&amp;Chr(34)&amp;&quot; + $itm[&quot;&amp;Chr(34)&amp;&quot;FileLeafRef&quot;&amp;Chr(34)&amp;&#xA;&quot;] + &quot;&amp;Chr(34)&amp;&quot;__RPA__&quot; &amp;Chr(34)&amp;&quot;+ $itm[&quot;&amp;Chr(34)&amp;&quot;FileDirRef&quot;&amp;Chr(34)&amp;&quot;]&quot;&amp;NewLine()&amp;&quot;Add-Content -Path $outputfile -Value $str}}&quot;&#xA;&#xA;" stage="Script" /></stage><stage stageid="9baea0cc-d664-4ac6-9e91-1b00e6b96c3c" name="Run PnP_Script" type="SubSheet"><subsheetid>1af354b2-6d32-487d-aad6-8ee913f9f220</subsheetid><display x="-165" y="-225" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>ac018cb0-6604-4171-a1e9-4e03c15a4399</onsuccess><processid>7c20ffe9-31e