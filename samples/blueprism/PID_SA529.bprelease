ther List - (SameSchema)" type="SubSheetInfo"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><narrative>Move item from one List to Another List - (SameSchema)</narrative><display x="-405" y="-405" w="150" h="90" /></stage><stage stageid="93171755-ccae-4193-8bd3-b192095ce7e6" name="Return Message" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="096a101f-789e-47f4-927c-a71a1cee4fc8" name="SP_Site_URL" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="-255" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6d6601a2-e83c-4461-8311-92fce0c8f700" name="Unexpected exception recover" type="Recover"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="30" y="-225" /><onsuccess>73ebce78-731b-4cc2-93e4-cac45c7d7444</onsuccess></stage><stage stageid="03c3651e-b490-4a7f-9f1b-4b41c798254b" name="Unexpected Exception" type="Exception"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="30" y="-105" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="69c3a9d2-b0b8-4bc5-970e-19624c3e92d2" name="Start" type="Start"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><preconditions><condition narrative="Required Proper Calm Query, Valid CSV FilePath, List Internal Column Names" /></preconditions><postconditions><condition narrative="Generates Output csv" /></postconditions><display x="-165" y="-480" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_Source_List" narrative="Name of Sharepoint list to be exported." stage="SP_Source_List" /><input type="text" name="SP_Dest_List" narrative="desti list name" stage="SP_Dest_List" /><input type="text" name="ItemID" narrative="item to move" stage="ItemID" /><input type="text" name="ColNames" narrative="list of col names to copy" stage="ColNames" /></inputs><onsuccess>35837067-0c4d-4d8b-a14b-b2079113c2dc</onsuccess></stage><stage stageid="1eb5551e-ff67-46f9-a8f5-939a9fddeef8" name="End" type="End"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="165" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="fc30492d-1b22-433b-ad29-ec863c5a8bff" name="Run PnP_Script" type="SubSheet"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="-135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>1437b3a4-7d82-4828-b942-e2c2d76590cb</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="6dba36fe-1fb3-4dbb-8e7a-4c1d25dcc4a3" name="Delete_Script" type="Action"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="105" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>1eb5551e-ff67-46f9-a8f5-939a9fddeef8</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="fd6d4998-4490-470b-a774-8d1c66be1890" name="Generate_PnPScript" type="SubSheet"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="-255" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script Template]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;MoveItem&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="&quot;C:\Users\&quot;&amp; [txt_SystemUserName] &amp;&quot;\Documents\&quot;" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>9d8b676d-2052-434c-ac04-63b32e0e9257</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="9d8b676d-2052-434c-ac04-63b32e0e9257" name="Check_Error" type="Decision"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="-195" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>17a2eb33-3ed2-4675-91ca-60907fb4bf7b</ontrue><onfalse>fc30492d-1b22-433b-ad29-ec863c5a8bff</onfalse></stage><stage stageid="17a2eb33-3ed2-4675-91ca-60907fb4bf7b" name="Exception while creating  Script" type="Exception"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-75" y="-195" /><exception type="System Exception" detail="[Return Message]" /></stage><stage stageid="1437b3a4-7d82-4828-b942-e2c2d76590cb" name="Check Process_Exist" type="Action"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="-75" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Process_Exists" /></outputs><onsuccess>a7fbeef5-c102-4ceb-ba6c-b388b91893ae</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="a7fbeef5-c102-4ceb-ba6c-b388b91893ae" name="ProcessExist?" type="Decision"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="-15" /><decision expression="[Process_Exists]=True" /><ontrue>28e8a227-e128-4845-b60c-0a83ab66f5e7</ontrue><onfalse>0f60c0ad-edfb-44c7-abd0-819c19d3bae3</onfalse></stage><stage stageid="0f60c0ad-edfb-44c7-abd0-819c19d3bae3" name="Anchor8" type="Anchor"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-105" y="-15" w="10" h="10" /><onsuccess>d0c5ced8-e4c7-4e79-a4ba-b129d195f166</onsuccess></stage><stage stageid="28e8a227-e128-4845-b60c-0a83ab66f5e7" name="Kill Process" type="Action"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-165" y="45" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>6dba36fe-1fb3-4dbb-8e7a-4c1d25dcc4a3</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="d0c5ced8-e4c7-4e79-a4ba-b129d195f166" name="Anchor9" type="Anchor"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-105" y="105" w="10" h="10" /><onsuccess>6dba36fe-1fb3-4dbb-8e7a-4c1d25dcc4a3</onsuccess></stage><stage stageid="5d059d33-b92d-4e4d-bcd8-6267cfa80e51" name="Input" type="Block"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-510" y="-345" w="180" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="afb0bfec-8045-4da6-bc18-25880143c083" name="OutPut" type="Block"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-480" y="-135" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b8b71483-c6a0-40a7-a083-8a1633d3ce51" name="Inhouse" type="Block"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-480" y="-30" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0088c317-7122-4ca9-b242-caad79bb3f45" name="Process_Exists" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="120" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="abd7f964-ad5e-4b30-9fbe-af577d231078" name="Error_Message" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="-105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="73ebce78-731b-4cc2-93e4-cac45c7d7444" name="Delete_Script" type="Action"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="30" y="-165" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>03c3651e-b490-4a7f-9f1b-4b41c798254b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="b781549b-c989-4993-894c-5b93eb5d2b11" name="Script Template" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><loginhibit /><display x="-405" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$ItemID = "__ITEMID__"
$URL = "__URL__"
$DestlistName =  "__LISTNAME1__"
$SrclistName =  "__LISTNAME__"
$AccessToken = "__ACCESSTOKEN__"
$colnames =__COLNAMES__

$env:PNPPOWERSHELL_UPDATECHECK = "false"

# Connect to SharePoint
Connect-PnPOnline -Url $URL -AccessToken $AccessToken -WarningAction SilentlyContinue

# Get the item
$sourceItem = Get-PnPListItem -List $SrclistName -Id $ItemID -ErrorAction Stop

$itemValues = @{}

for ($i = 0; $i -le $colnames.Length-1; $i++) 
{
    $itemValues[$colnames[$i]] = $sourceItem[$colnames[$i]]
}

    $destitem=Add-PnPListItem -List $DestlistName -Values $itemValues -ErrorAction Stop
    $destitemid=$destitem.Id
    $attachments = Get-PnPProperty -ClientObject $sourceItem -Property "AttachmentFiles"

foreach ($attachment in $attachments) {
    $fileName = $attachment.FileName
    $fileUrl = $attachment.ServerRelativeUrl

    # Get the file stream
    $fileStream = (Get-PnPFile -Url $fileUrl -AsFileObject).OpenBinaryStream()
    Invoke-PnPQuery
    $stream = $fileStream.Value

    # Upload the stream to the destination item
    Add-PnPListItemAttachment -List $DestListName -Identity $DestItemId -FileName $fileName -Stream $stream
}
Remove-PnPListItem -List $SrclistName -Identity $ItemID -Force
</initialvalue><private /><alwaysinit /></stage><stage stageid="0edc1cf4-9d08-4b79-a558-53d477645666" name="Script To Extract Vales" type="MultipleCalculation"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><loginhibit /><narrative>$ItemID = "_ITEMID_"
$URL = "__URL__"
$DestlistName =  "__LISTNAME1__"
$SrclistName =  "__LISTNAME__"
$AccessToken = "_ACCESSTOKEN_"</narrative><display x="-165" y="-315" /><onsuccess>2a40d541-c328-49ab-addc-b378c2a1a930</onsuccess><steps><calculation expression="Replace([Script Template],&quot;__ITEMID__&quot;,[ItemID])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__URL__&quot;, [SP_Site_URL])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__LISTNAME1__&quot;, [SP_Dest_List])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__LISTNAME__&quot;, [SP_Source_List])" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__ACCESSTOKEN__&quot; , [AccessToken]  )" stage="Script Template" /><calculation expression="Replace([Script Template], &quot;__COLNAMES__&quot; , [ColNames])" stage="Script Template" /></steps></stage><stage stageid="8e5ea917-4b44-4f85-9eb2-ce017f53ec3b" name="Query" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="-315" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">&lt;View&gt;&lt;OrderBy&gt;&lt;FieldRef Name='ID' Ascending='TRUE'/&gt;&lt;/OrderBy&gt;&lt;/View&gt;</initialvalue><private /><alwaysinit /></stage><stage stageid="43596295-9d6d-49a4-8fe1-e3f9672810ff" name="File Name" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f5758ce-4ff5-4ad1-822d-64eb7327afc2" name="Folder" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="162a80a8-27cf-43af-b9e2-b8960dd0321a" name="Script Path" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35837067-0c4d-4d8b-a14b-b2079113c2dc" name="Get Access Token" type="SubSheet"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><loginhibit /><display x="-165" y="-405" /><onsuccess>0edc1cf4-9d08-4b79-a558-53d477645666</onsuccess><processid>fe0cf63f-9dc6-4f40-a487-34b9e6ecafd8</processid></stage><stage stageid="a281c73c-feab-45d5-9e40-4a75a67bd782" name="SP_Dest_List" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-405" y="-180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea09cf9f-4fbb-47e1-9fe6-79c554601c56" name="ItemID" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-420" y="-225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c0a85834-ea3b-433b-9c65-228b860eeecd" name="SP_Source_List" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-390" y="-285" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a40d541-c328-49ab-addc-b378c2a1a930" name="Get User Name" type="Action"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><narrative>Gets the Current User Name</narrative><display x="-240" y="-285" /><outputs><output type="text" name="User Name" narrative="The name of the logged in user in the current system" stage="txt_SystemUserName" /></outputs><onsuccess>fd6d4998-4490-470b-a774-8d1c66be1890</onsuccess><resource object="Utility - Environment" action="Get User Name" /></stage><stage stageid="de3239ff-e268-44b7-91b0-590ef94761fc" name="txt_SystemUserName" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-375" y="-210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4589efd2-d065-4169-af69-f02c24a493f9" name="ColNames" type="Data"><subsheetid>d9dca446-7482-4040-8d7f-89a6140a91ea</subsheetid><display x="-465" y="-180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8a55e4d3-905d-4401-9f42-d1fa55c09797" name="Get All Files From Folder sorted (File Created Time)" type="SubSheetInfo"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><narrative>Get All Files From Folder sorted (File Created Time)</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="a7524a41-a72c-46ac-886a-ba4d7723b019" name="Return Message" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="270" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5a330e65-180e-414d-93f4-5314cb6f073c" name="Generate Script" type="Calculation"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="-105" /><onsuccess>ed69a262-e762-4333-954a-6a97b375656a</onsuccess><calculation expression="&quot;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url &quot;&quot;&quot; &amp;[SharePoint URL]&amp;Chr(34)&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&#xA;&quot;$FolderPath = &quot;&amp;&quot;&quot;&quot;&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;# Adjust as needed&quot;&amp;NewLine()&amp;&#xA;&quot;$CsvPath = &quot;&amp;&quot;&quot;&quot;&quot;&amp;[Csv Path]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;# Path to save the CSV&quot;&amp;NewLine()&amp;&#xA;&#xA;&quot;try {&quot;&amp;NewLine()&amp;&#xA;    &quot;# Get all files in the folder&quot;&amp;NewLine()&amp;&#xA;    &quot;$Files = Get-PnPFolderItem -FolderSiteRelativeUrl $FolderPath -ItemType File&quot;&amp;NewLine()&amp;&#xA;&#xA;    &quot;if ($Files.Count -gt 0) {&quot;&amp;NewLine()&amp;&#xA;        &quot;Write-Host &quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot;File Available&quot;&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&#xA;&#xA;        &quot;# Prepare file details with fallback for missing TimeCreated&quot;&amp;NewLine()&amp;&#xA;        &quot;$FileDetails = $Files | ForEach-Object {&quot;&amp;NewLine()&amp;&#xA;            &quot;$created = if ($_.TimeLastModified) { $_.TimeLastModified } else { [datetime]&quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot;1900-01-01&quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot; }&quot;&amp;NewLine()&amp;&#xA;            &quot;[PSCustomObject]@{&quot;&amp;NewLine()&amp;&#xA;                &quot;Name        = $_.Name&quot;&amp;NewLine()&amp;&#xA;                &quot;TimeCreated = if ($_.TimeLastModified) { $_.TimeLastModified} else { &quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot;N/A&quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot; }&quot;&amp;NewLine()&amp;&#xA;                &quot;SortKey     = $created&quot;&amp;NewLine()&amp;&#xA;            &quot;}&quot;&amp;NewLine()&amp;&#xA;        &quot;}&quot;&amp;NewLine()&amp;&#xA;&#xA;        &quot;# Sort by fallback-safe key and remove SortKey before export&quot;&amp;NewLine()&amp;&#xA;        &quot;$FileDetails |&quot;&amp;NewLine()&amp;&#xA;            &quot;Sort-Object SortKey |&quot;&amp;NewLine()&amp;&#xA;            &quot;Select-Object Name |&quot;&amp;NewLine()&amp;&#xA;            &quot;Export-Csv -Path $CsvPath -NoTypeInformation -Encoding UTF8&quot;&amp;NewLine()&amp;&#xA;    &quot;} else {&quot;&amp;NewLine()&amp;&#xA;        &quot;Write-Host &quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot;File Not Available&quot;&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&#xA;    &quot;}&quot;&amp;NewLine()&amp;&#xA;&quot;}&quot;&amp;NewLine()&amp;&#xA;&quot;catch {&quot;&amp;NewLine()&amp;&#xA;    &quot;Write-Host &quot;&amp;&quot;&quot;&quot;&quot;&amp;&quot;Error retrieving files: $_&quot;&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&#xA;&quot;}&quot; &#xA;" stage="Script" /></stage><stage stageid="e10bb5a4-abec-471d-8fe5-6f8bdbc642c9" name="Script" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c263f479-e408-489c-a21d-daf1cefa72df" name="Success" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="331593b1-323c-4e8e-af25-407b3af2db3b" name="Standards" type="Note"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

 

SharePoint File path: Document Repository/LCA CC/RPA/0.0 RPA Repositary/4.0 RPA Guideline Documents/Blue Prism Guidelines and References/Chanana.txt

 



FolderPath: C:\Apps\</narrative><display x="390" y="-75" w="180" h="150" /></stage><stage stageid="fa72d801-10e3-4c4e-9cc3-ee1b145b09d6" name="SharePoint URL" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="-135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a21bb4b6-ef35-4a2c-8051-cea749ebeac7" name="Share_Lib_Folder_Path" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd053084-e3d5-4c85-8bc1-9e30dc9e2603" name="Input" type="Block"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-390" y="-165" w="180" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="396c3e23-a6f2-4008-9b7a-ff681887b930" name="Input_script path" type="Block"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-390" y="45" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fd54f625-aeee-4b00-b5da-60ee4ee4cb72" name="Output_Sccess or Failure" type="Block"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-390" y="195" w="180" h="270" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9ac4b8fe-104f-440c-bf98-30f523d5cdfa" name="Output_script" type="Block"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-390" y="120" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="dae5a643-7820-4e2b-91ea-91aa126cbaf4" name="Run Report" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="315" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="17a14ea6-34d9-42dc-88a6-64b00de4760f" name="Run PnP_Script" type="SubSheet"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="105" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>f5c546b3-87e8-4853-a966-d07d83bab508</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="41182eb7-94d5-4b12-bb87-69122981a561" name="Delete_Script" type="Action"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="360" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>14a21fdf-ad9a-4b56-be15-850740a39b46</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ed69a262-e762-4333-954a-6a97b375656a" name="Generate_PnPScript" type="SubSheet"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="-45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_All_Files_From_Folder_sorted&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>d239005b-3265-4c87-9851-1414a4936cff</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="d239005b-3265-4c87-9851-1414a4936cff" name="Check_Error" type="Decision"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>2f2b4ad8-16c8-472e-91f8-460b753398cd</ontrue><onfalse>17a14ea6-34d9-42dc-88a6-64b00de4760f</onfalse></stage><stage stageid="2f2b4ad8-16c8-472e-91f8-460b753398cd" name="Exception while creating  Script" type="Exception"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="150" y="45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="ef0093ed-9fbc-48f7-95fe-2626e6e8e5f5" name="Check Process_Exist" type="Action"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="210" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>066ecf48-299a-4bca-9af3-d063ed9caaa5</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="066ecf48-299a-4bca-9af3-d063ed9caaa5" name="ProcessExist?" type="Decision"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="255" /><decision expression="[Exists]=True" /><ontrue>ac41252d-7fe8-489c-b924-42b13207fef9</ontrue><onfalse>b0e88121-4d83-45a2-a8e2-42bdf4b1ccc9</onfalse></stage><stage stageid="b0e88121-4d83-45a2-a8e2-42bdf4b1ccc9" name="Anchor8" type="Anchor"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="60" y="255" w="10" h="10" /><onsuccess>2240f8dc-6b40-46a4-9b8f-0bede7c5314a</onsuccess></stage><stage stageid="ac41252d-7fe8-489c-b924-42b13207fef9" name="Kill Process" type="Action"><su