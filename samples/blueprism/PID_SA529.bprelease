</narrative><display x="-315" y="-165" w="300" h="150" /></stage><stage stageid="6548feca-e814-459c-928e-e78adcb0abfb" name="Unexpected exception recover" type="Recover"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="480" y="-45" /><onsuccess>1b8c84e4-84fd-478c-ba34-29b014a811c5</onsuccess></stage><stage stageid="b5702135-2f02-4cb6-9f21-0758b17d091e" name="Unexpected Exception" type="Exception"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="690" y="-45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="2224d8a8-a3aa-4499-8601-4bcac4a85816" name="Script_Location" type="Data"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="-30" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b8c84e4-84fd-478c-ba34-29b014a811c5" name="Delete_Script" type="Action"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="585" y="-45" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b5702135-2f02-4cb6-9f21-0758b17d091e</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="9fdd1d06-a440-4767-a288-448b8e8753d0" name="Validate Temp Script Path" type="SubSheet"><subsheetid>92d41df1-2405-4791-b4af-ff5a8232daa5</subsheetid><display x="120" y="-180" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>78cadce4-297b-4423-8efe-6f705070d96a</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="fe88019b-6076-4cf4-8aad-0b604571b5bf" name="Publish a File" type="SubSheetInfo"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Publish a File to Sharepoint library.</narrative><display x="-255" y="-120" w="150" h="90" /></stage><stage stageid="8a9e0f23-b0c3-41b2-92f5-66a3eec9e259" name="Start" type="Start"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="-15" y="-345" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="SP_Lib_Folder_Path" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Publish Comment" narrative="Comment while publishing" stage="Publish Comment" /></inputs><onsuccess>49533fea-ceeb-47d0-a1d5-934e6e507e20</onsuccess></stage><stage stageid="77500ab4-58cf-4404-b899-3405ef7ec17d" name="End" type="End"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="300" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="99337576-f0c9-4a13-8af0-0c011062b11f" name="Return Message" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-540" y="210" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6fecc824-0547-4fff-acdb-a3589e1b5a6a" name="Build Script" type="Calculation"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="-120" /><onsuccess>9a2359e8-c195-4bad-8c86-b4b55ac202e8</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;&#xA;# Get Context&quot; &amp; NewLine() &amp; &quot;&#xA;&#xA;$clientContext = Get-PnPContext&quot; &amp; NewLine() &amp; &quot;&#xA;# -Url: relative path of the file&quot; &amp; NewLine() &amp; &quot;&#xA;# -AsListItem: Retrieves the file and returns it as a ListItem object&quot; &amp; NewLine() &amp; &quot;&#xA;$ListItem = Get-PnPFile -Url &quot;&amp; Chr(34) &amp; [SP_Lib_Folder_Path] &amp; Chr(34) &amp;&quot; -AsListItem&quot; &amp; NewLine() &amp; &quot;&#xA;# Get the File object&quot; &amp; NewLine() &amp; &quot;&#xA;$targetFile = $ListItem.File&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.Load($targetFile)&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.ExecuteQuery()&quot; &amp; NewLine() &amp; &quot;&#xA;# Publish content and provide comment&quot; &amp; NewLine() &amp; &quot;&#xA;# You cannot perform this action on a checked out document.&quot; &amp; NewLine() &amp; &quot;&#xA;$targetFile.Publish(&quot;&amp; Chr(34) &amp; [Publish Comment] &amp; Chr(34) &amp;&quot;)&quot; &amp; NewLine() &amp; &quot;&#xA;$clientContext.ExecuteQuery()&quot; &amp; NewLine() &amp; &quot;&#xA;Disconnect-PnPOnline&quot;" stage="Script" /></stage><stage stageid="f9f8e271-b18b-43d4-b7d4-8285464c091c" name="Script" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-420" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9393d711-de46-4fc0-afc9-e944af925082" name="SP_Site_URL" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Link for site or subsite.</narrative><display x="-540" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56c29a08-5638-46c3-bf3f-861a68308775" name="SP_Lib_Folder_Path" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-540" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="110fa089-2987-4dc8-8b40-81469cbd014f" name="FilePath" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>File Location to upload the file.</narrative><display x="-540" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0253ada1-6e4f-4635-b13c-4fd69afd2202" name="Run PnP_Script" type="SubSheet"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>6b20b05c-eb33-4012-b455-32aeff37fbb5</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="62bdd158-bf43-4e39-b20b-eee2177a8635" name="Note3" type="Note"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><narrative>Publish Comment : "Published by PNP"


Share_Lib_Folder_Path: Includes Library and sub folder and file name ( Example:- Documents/FO/Data.xlsx)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

****************************************************************************************************
</narrative><display x="-555" y="-210" w="300" h="240" /></stage><stage stageid="37897e0f-5069-4be5-bc00-8c6b5c5a0f55" name="Script Path" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-420" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c16b1c35-3c1a-49d8-905d-0e035c74e63c" name="Delete_Script" type="Action"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="240" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>77500ab4-58cf-4404-b899-3405ef7ec17d</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="9a2359e8-c195-4bad-8c86-b4b55ac202e8" name="Generate_PnPScript" type="SubSheet"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="-75" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_publish&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>0327f201-7e94-47da-b586-5d1e85d46139</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="b3d3971f-62d6-4046-98b1-65a6207ad3f4" name="Input" type="Block"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-600" y="15" w="120" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7386c317-a553-4539-a888-82bb70e80863" name="Output" type="Block"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-600" y="165" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f0736144-f7a3-43bf-a646-e17d927488cd" name="Inhouse" type="Block"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-465" y="15" w="150" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0327f201-7e94-47da-b586-5d1e85d46139" name="Check_Error" type="Decision"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="-30" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>ac27634d-75a2-429b-b49f-4381f6cbe3e6</ontrue><onfalse>0253ada1-6e4f-4635-b13c-4fd69afd2202</onfalse></stage><stage stageid="ac27634d-75a2-429b-b49f-4381f6cbe3e6" name="Exception while creating  Script" type="Exception"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="180" y="-30" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="6b20b05c-eb33-4012-b455-32aeff37fbb5" name="Check Process_Exist" type="Action"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="75" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>540611dc-8127-4295-8611-4ef1312216ee</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="3171d287-7633-499d-88a0-1190618075b3" name="Exists" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-360" y="210" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="540611dc-8127-4295-8611-4ef1312216ee" name="ProcessExist?" type="Decision"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="135" /><decision expression="[Exists]=True" /><ontrue>4fb6990a-f115-4f80-95fa-ccf0a3aa8520</ontrue><onfalse>c0b5c154-121e-456c-9c39-b8a7fc4d79d0</onfalse></stage><stage stageid="baa7412c-eba1-4853-93a2-3b1b3f37ae22" name="Temp_Retry" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-360" y="255" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c0b5c154-121e-456c-9c39-b8a7fc4d79d0" name="Anchor8" type="Anchor"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="90" y="135" w="10" h="10" /><onsuccess>fdbb8df0-bab8-456d-a243-864cb674de14</onsuccess></stage><stage stageid="4fb6990a-f115-4f80-95fa-ccf0a3aa8520" name="Kill Process" type="Action"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="180" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>c16b1c35-3c1a-49d8-905d-0e035c74e63c</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="fdbb8df0-bab8-456d-a243-864cb674de14" name="Anchor9" type="Anchor"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="90" y="240" w="10" h="10" /><onsuccess>c16b1c35-3c1a-49d8-905d-0e035c74e63c</onsuccess></stage><stage stageid="0f99c84d-d671-499a-9263-4a9d7b19051b" name="Run_Status" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-420" y="210" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcfa2372-f860-41a7-a734-76eb30aeea53" name="Error_Message" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-540" y="255" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ad705c73-7b72-414c-9aae-ec5d26f5ab46" name="Unexpected exception recover" type="Recover"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="315" y="30" /><onsuccess>52a9052e-d9e1-4a9c-90e2-d3a895c4e244</onsuccess></stage><stage stageid="84d4a641-ef61-4693-998f-b37bbe94f3a5" name="Unexpected Exception" type="Exception"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="465" y="30" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="0100d33e-a1ee-469b-94db-013a7188bd69" name="Script_Loc" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-360" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52a9052e-d9e1-4a9c-90e2-d3a895c4e244" name="Delete_Script" type="Action"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="390" y="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>84d4a641-ef61-4693-998f-b37bbe94f3a5</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="06217533-c8d5-4750-a4f3-2522bc3c758f" name="Validate Temp Script Path" type="SubSheet"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-15" y="-165" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>6fecc824-0547-4fff-acdb-a3589e1b5a6a</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="2edd88f1-0933-4a6d-9449-1d95cea161c2" name="Publish Comment" type="Data"><subsheetid>a607b6c4-1f56-4e90-a2c8-c9a3dd39ac33</subsheetid><display x="-420" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="50fbffd4-7072-4b53-8912-0680d6d962c2" name="SharePoint_Login" type="SubSheetInfo"><subsheetid>eee9e80c-0301-410f-97a7-f43a4aad6761</subsheetid><narrative>Initiate force login by clearing the cookies and login by using current user profile.</narrative><display x="-240" y="-165" w="150" h="90" /></stage><stage stageid="4c705480-ac78-40b0-a5df-c5d8b99956de" name="Download attachment from list item" type="SubSheetInfo"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><narrative>action to download an attachment in a specific SP list item</narrative><display x="-270" y="-180" w="150" h="90" /></stage><stage stageid="f094b61a-e9d2-4b6c-b03a-adbdbb9937f0" name="Start" type="Start"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="15" y="-255" /><inputs><input type="text" name="txt_URL" narrative="URL of the SP site" stage="txt_URL" /><input type="text" name="txt_ListName" narrative="ListName of the SP list" stage="txt_ListName" /><input type="number" name="num_ListID" narrative="ID of the list item in SP list" stage="num_ListID" /><input type="text" name="txt_FolderPath" narrative="Location to drop the downloaded file" stage="txt_FolderPath" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /><input type="text" name="Script_Location" narrative="(optional) Location to store temporary PowerShell file" stage="Script_Location" /></inputs><onsuccess>88883b65-bd7d-4741-ad4a-5f7be346ef56</onsuccess></stage><stage stageid="f62cec4b-1031-4ba3-983b-653fdd02826a" name="End" type="End"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><display x="15" y="405" /><outputs><output type="text" name="Success Message" narrative="Success Message" stage="Run Report" /><output type="text" name="Error Message" narrative="Contains errors captured in the powershell" stage="txt_ErrorMsg" /></outputs></stage><stage stageid="4a05ac51-1531-4248-b8c1-d6be94d0a4df" name="Build script" type="Calculation"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><loginhibit /><narrative>"$WarningPreference ="&amp;Chr(34)&amp;"SilentlyContinue"&amp;Chr(34)&amp;""&amp;NewLine()&amp;"</narrative><display x="15" y="-120" /><onsuccess>2c6f6f10-f910-4482-8430-539718296538</onsuccess><calculation expression="&quot;$WarningPreference =&quot;&amp;Chr(34)&amp;&quot;SilentlyContinue&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [txt_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$listitem = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [txt_ListName] &amp; Chr(34) &amp;  &quot;-Id &quot; &amp; [num_ListID] &amp; NewLine() &amp;  &quot;$attachments = ForEach-Object{Get-PnPProperty -ClientObject $listitem -Property &quot; &amp; Chr(34) &amp; &quot;AttachmentFiles&quot; &amp; Chr(34) &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;$attachments | ForEach-Object { Get-PnPFile -Url $_.ServerRelativeUrl -FileName $_.FileName -Path &quot; &amp; Chr(34) &amp; [txt_FolderPath] &amp; Chr(34) &amp; &quot; -AsFile}&quot;" stage="txt_PnPScript" /></stage><stage stageid="996b079d-91c2-4618-9407-9dc5d587fc2a" name="txt_PnPScript" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-300" y="-75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab026cd1-cba1-4a8e-8b0d-5a6fb81a18e7" name="txt_URL" type="Data"><subsheetid>376867eb-4829-4c13-896c-7060f925bc8b</subsheetid><display x="-285" y="-30" /><datatype>text</dat