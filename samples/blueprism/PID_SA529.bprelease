tid>6be4b85e-a36f-4c11-a158-9524ad27b1e3</subsheetid><loginhibit /><display x="30" y="-30" w="90" h="30" /><outputs><output type="collection" name="Workbooks" stage="Workbooks" /></outputs><onsuccess>e2321302-deae-44e6-9cc1-ebd24de297de</onsuccess><code><![CDATA[Dim objExcel 
Dim objWorkBook
Dim dt as New DataTable
objExcel = System.Runtime.InteropServices.Marshal.GetActiveObject("Excel.Application")
objWorkBook = objExcel.Workbooks
    Dim totalWorkBooks As Integer = objExcel.Workbooks.Count
	'dt.Columns.Add("Path", GetType(String))
	dt.Columns.Add("WorkbookName", GetType(String))
    For i As Integer = 1 To totalWorkBooks			
			objWorkBook = objExcel.Workbooks(i)  
			dt.Rows.Add(objWorkBook.Name)  
			'objWorkBook.FullName, 
	Next

	Workbooks = dt]]></code></stage><stage stageid="b1d5a624-0280-4bcb-b5ee-1675dc3e2c1c" name="Workbooks" type="Collection"><subsheetid>6be4b85e-a36f-4c11-a158-9524ad27b1e3</subsheetid><display x="150" y="-30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="6315c8a3-ace3-454f-b1f3-a0762a99a155" name="Block1" type="Block"><subsheetid>6be4b85e-a36f-4c11-a158-9524ad27b1e3</subsheetid><loginhibit /><display x="-120" y="-60" w="210" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8af6439a-6010-40b5-a6e2-ef13a77bd691" name="Recover1" type="Recover"><subsheetid>6be4b85e-a36f-4c11-a158-9524ad27b1e3</subsheetid><loginhibit /><display x="-75" y="-30" /><onsuccess>dfefe74e-325e-4f95-8f1a-26eb0c542247</onsuccess></stage><stage stageid="dfefe74e-325e-4f95-8f1a-26eb0c542247" name="Resume1" type="Resume"><subsheetid>6be4b85e-a36f-4c11-a158-9524ad27b1e3</subsheetid><loginhibit /><display x="-75" y="90" /><onsuccess>e2321302-deae-44e6-9cc1-ebd24de297de</onsuccess></stage><stage stageid="7b271415-c920-4f62-90c3-34d1e00ca933" name="Filter ExcelRows" type="SubSheetInfo"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><narrative>Filter excel based on Criteria</narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="79536062-5188-4947-ac12-9462d72afc43" name="Sort Single Column" type="SubSheetInfo"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><narrative>Filter excel based on Criteria</narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="a9d0b1c6-7c31-49e5-871f-7954ab8a3026" name="Start" type="Start"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " stage="handle" /><input type="text" name="Workbook name" stage="Workbook Name" /><input type="text" name="Range" stage="Range" /><input type="text" name="Worksheet name" stage="worksheet name" /><input type="text" name="Column To Sort" stage="Column To Sort" /></inputs><onsuccess>87d65691-27af-4a6d-8b39-d282f01a0020</onsuccess></stage><stage stageid="6a7c9eca-4c87-4b36-9634-b7da0b028ab9" name="End" type="End"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="0ee25cda-d226-41b1-a0ac-17c25fa9ca99" name="handle" type="Data"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><display x="-255" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="73fa3c2e-7a18-44e2-b79e-f1c00e5d0407" name="Workbook Name" type="Data"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><display x="-330" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="357f5c54-e8aa-44b3-82c3-31b76c81eeba" name="Range" type="Data"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8cf015d6-b9e7-485b-87e3-c2e1c9e479fc" name="worksheet name" type="Data"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><loginhibit /><display x="-300" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="87d65691-27af-4a6d-8b39-d282f01a0020" name="Sort" type="Code"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="range" expr="[Range]" /><input type="text" name="sortCol" expr="[Column To Sort]" /></inputs><onsuccess>6a7c9eca-4c87-4b36-9634-b7da0b028ab9</onsuccess><breakpoint type="0"><condition></condition></breakpoint><code><![CDATA[dim ws

ws= GetWorksheet(handle,workbook,worksheet)
ws.Range(range).Sort(key1:=ws.Range(sortCol), order1:=1, Header:=1)


]]></code></stage><stage stageid="74fa1930-3943-4190-a716-4d33d61d9945" name="Column To Sort" type="Data"><subsheetid>1468901a-66ff-453a-a07b-d787b81f604d</subsheetid><display x="-195" y="-75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e951e0b2-71b4-4c59-ba14-78cfa9ebbb41" name="Cut Entire Row" type="SubSheetInfo"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0c61e811-6b0e-4131-adc1-d7a857dad569" name="End" type="End"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><loginhibit /><display x="15" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ddfec766-35bb-457f-8282-d7a2556622fd" name="Start" type="Start"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><loginhibit /><display x="15" y="-75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet on which the number of rows is required. The default empty text value indicates the currently active sheet on the specified workbook." stage="worksheetname" /><input type="number" name="RowNumber" stage="RowNumber" /><input type="number" name="Destination" stage="Destination" /></inputs><onsuccess>4292cf04-da7a-43c6-9a7c-d888d9872ff1</onsuccess></stage><stage stageid="4292cf04-da7a-43c6-9a7c-d888d9872ff1" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><loginhibit /><display x="15" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>fad4cfef-c28c-43df-995c-14b0144a52ef</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="fad4cfef-c28c-43df-995c-14b0144a52ef" name="Cut Row" type="Code"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><loginhibit /><display x="15" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="number" name="RowNumber" expr="[RowNumber]" /><input type="text" name="Destination" expr="[Destination]" /></inputs><onsuccess>0c61e811-6b0e-4131-adc1-d7a857dad569</onsuccess><code><![CDATA[

GetWorksheet(handle,workbookname,worksheetname).Cells(RowNumber,RowNumber).EntireRow.Cut 
GetWorksheet(handle,workbookname,worksheetname).Rows(Destination & ":" & Destination).Insert(Shift:=-4121)

]]></code></stage><stage stageid="59252465-8a78-4a1f-aff8-7189a129fd16" name="handle" type="Data"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-270" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="86d219cf-bbac-469b-b897-e73f56703b45" name="workbookname" type="Data"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-270" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9d4c2fe0-0d66-46e9-9101-d6916eda3acb" name="worksheetname" type="Data"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-270" y="120" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="78293f1b-533c-4a3b-9632-af3bb691a896" name="RowNumber" type="Data"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-150" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="57067bfc-36b3-4e3d-a278-d24506f751d9" name="Destination" type="Data"><subsheetid>d4bc96a7-9942-4909-8068-4618140b7447</subsheetid><display x="-150" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><alwaysinit /></stage><stage stageid="c9dc635b-795a-4e59-8e59-d731625ce55c" name="Add Column" type="SubSheetInfo"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b14a7ba0-7a2f-459c-b7ad-ad4cbb033fbf" name="Start" type="Start"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><loginhibit /><display x="15" y="-180" /><inputs><input type="text" name="workbook" stage="workbook" /><input type="text" name="worksheet" stage="worksheet" /><input type="number" name="handle" stage="handle" /></inputs><onsuccess>b820e0b1-7b59-48e2-b8d2-070bde3ea73a</onsuccess></stage><stage stageid="dbf71cd6-787a-4a58-8ad2-bd7bced47c2f" name="End" type="End"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="b820e0b1-7b59-48e2-b8d2-070bde3ea73a" name="Add Columns" type="Code"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /></inputs><onsuccess>dbf71cd6-787a-4a58-8ad2-bd7bced47c2f</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Sheets(worksheet).Cells(1,21).EntireColumn.Insert]]></code></stage><stage stageid="5955f55e-d4ca-431f-ab25-c08aa5b34ee5" name="workbook" type="Data"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><display x="-315" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="62dad16a-cf42-44d8-a633-88b88da19676" name="worksheet" type="Data"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><display x="-180" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8389e646-04b8-4e7f-b6d7-74172c2427f5" name="handle" type="Data"><subsheetid>de808839-fd2d-4656-ab70-6f65ef552730</subsheetid><display x="-240" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1dd3f55-3cf2-45cb-ad06-62a24ff98285" name="Open Workbook From Sharepoint" type="SubSheetInfo"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><narrative>Opens a workbook from sharepoint

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.

Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="431844b5-3d66-4290-9598-d5ca27aeccfc" name="Start" type="Start"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><loginhibit /><display x="15" y="-165" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="URL" narrative="The URL from  sharepoint." stage="URL" /></inputs><onsuccess>b68171cf-5939-4d69-bb2e-7f023e3698ce</onsuccess></stage><stage stageid="f9a7ec05-b654-443e-aaa2-d5b18fe40381" name="End" type="End"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><loginhibit /><display x="15" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="b68171cf-5939-4d69-bb2e-7f023e3698ce" name="Open URL" type="Code"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="URL" expr="[URL]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="text" name="name" stage="workbookname" /></outputs><onsuccess>f9a7ec05-b654-443e-aaa2-d5b18fe40381</onsuccess><code><![CDATA[

Dim wb as Object = GetInstance(handle).Workbooks.Open(URL)
name = wb.Name
wb.Activate()
]]></code></stage><stage stageid="bedf4efe-05db-4f61-a7b6-0d187266fdd6" name="handle" type="Data"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><display x="-210" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="fbf0293a-83c1-4a46-a5a5-c73a75a12e28" name="URL" type="Data"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9ea328c-cb89-41f3-9229-9bcd12a58477" name="workbookname" type="Data"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><loginhibit /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ddd6f9b6-a183-4f44-b0e8-80beca0b885f" name="Success" type="Data"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><display x="-210" y="90" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7b450069-c9fb-4806-80b3-4f8390015673" name="Message" type="Data"><subsheetid>0b9d6914-7b65-43f5-bfc3-f7a4abcd79f5</subsheetid><display x="-210" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5d633394-1a94-40fa-8e00-438c731d8d17" name="Save Workbook As with different File Format" type="SubSheetInfo"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="14af53d9-5416-4f87-90cd-4d537c9ce37f" name="End" type="End"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="15" y="255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="New Workbook Name" narrative="The new workbook name which Excel will use to identify the workbook within the instance." stage="newworkbookname" /></outputs></stage><stage stageid="2e654f06-1001-40b9-a6e4-de1c473e4c15" name="filename" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><display x="-195" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="766b74dc-4e21-4913-8fd6-57d9679652b6" name="handle" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><display x="-195" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="3f2ad33f-dd66-4cc7-a7c6-ba0c7bf19ff0" name="Start" type="Start"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be saved" stage="workbookname" /><input type="text" name="Filename" narrative="The full path and filename to which the workbook should be saved." stage="filename" /><input type="number" name="Enumeration No" narrative="Enumeration No for file format(Excel Constant)" stage="enumeration_no" /></inputs><onsuccess>0251789c-4d58-4b7d-8d54-415789a5f5ce</onsuccess></stage><stage stageid="981a2ad0-fefc-4ba4-9d5d-1845e513e2da" name="workbookname" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><display x="-195" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac0bbe1d-f537-42c5-a281-e6a93ccc95d7" name="SaveWorkbookAs with FileFormat" type="Code"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="15" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="filename" expr="[filename]" /><input type="number" name="enumeration_no" expr="[enumeration_no]" /></inputs><outputs><output type="text" name="newworkbookname" stage="workbookname" /></outputs><onsuccess>e2720166-29a9-4777-b7b6-a2d5e21feaf6</onsuccess><code><![CDATA[
Dim wb as Object = GetWorkbook(handle,workbookname)
Dim excel as Object = wb.Application

excel.DisplayAlerts = False
wb.SaveAs(filename,enumeration_no)
excel.DisplayAlerts = True

]]></code></stage><stage stageid="0251789c-4d58-4b7d-8d54-415789a5f5ce" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>ac0bbe1d-f537-42c5-a281-e6a93ccc95d7</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="7ec90021-aecc-48ea-87d4-aa039be8beaf" name="newworkbookname" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><narrative>The new workbook name assigned by Excel after saving the book</narrative><display x="-195" y="135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0b215ce-81e0-495e-a09c-4551f0ff3f32" name="enumeration_no" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="-195" y="180" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2720166-29a9-4777-b7b6-a2d5e21feaf6" name="New Workbook name" type="Code"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><loginhibit /><display x="15" y="135" w="120" h="30" /><outputs><output type="text" name="newworkbookname" stage="newworkbookname" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>14af53d9-5416-4f87-90cd-4d537c9ce37f</onsuccess><code><![CDATA[Dim objXL, WB, strMessage As Object


objXL = GetObject(, "Excel.Application")
WB = objXL.ActiveWorkbook

If Not TypeName(objXL) = "Empty" Then
    If Not TypeName(WB) = "Nothing" Then
    strMessage = "Excel Running - " & objXL.ActiveWorkbook.Name & " is active"
    Else
    strMessage = "Excel Running - no workbooks open"
    End If
Else
    strMessage = "Excel NOT Running"
End If
newworkbookname = objXL.ActiveWorkbook.Name
Message = strMessage]]></code></stage><stage stageid="9333d16d-ba28-44e8-bbdb-b9d46a1145ca" name="Message" type="Data"><subsheetid>302e6fa7-57d2-42b6-91b0-c07d69433ce2</subsheetid><display x="-195" y="225" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0429f766-4888-4661-aef0-ed25d6468fa9" name="Copy and Paste Vaue and Number Formatting Worksheet Range" type="SubSheetInfo"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="a210a123-b77c-4872-83c1-dd575e28b0f8" name="Start" type="Start"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" stage="Handle" /><input type="text" name="Source Workbook" stage="Source Workbook" /><input type="text" name="Source Worksheet" stage="Source Worksheet" /><input type="text" name="Source Range" stage="Source Range" /><input type="text" name="Destination Workbook" stage="Destination Workbook" /><input type="text" name="Destination Worksheet" stage="Destination Worksheet" /><input type="text" name="Destination Range" stage="Destination Range" /></inputs><onsuccess>e84bcf3c-5544-4b3f-bc16-dd51653a95cb</onsuccess></stage><stage stageid="1694bd6d-e854-4e55-9268-643235b967c9" name="Source Workbook" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1f79a2d-acd6-4d2c-b68e-13a27d04ff8b" name="Source Worksheet" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b2ef0ceb-f637-4885-b609-3a67cc669a3c" name="Destination Workbook" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="531e25dd-2e2f-41e6-8664-1dbd290dbb78" name="Worksheet Exists" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="210" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e84bcf3c-5544-4b3f-bc16-dd51653a95cb" name="Paste value  Worksheet" type="Code"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><loginhibit /><display x="15" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Source Workbook" expr="[Source Workbook]" /><input type="text" name="Source Worksheet" expr="[Source Worksheet]" /><input type="text" name="Source Range" expr="[Source Range]" /><input type="text" name="Destination Workbook" expr="[Destination Workbook]" /><input type="text" name="Destination Worksheet" expr="[Destination Worksheet]" /><input type="text" name="Destination Range" expr="[Destination Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>cf2f6f4b-da28-4d0f-8e9b-a8a9444b3912</onsuccess><code><![CDATA[Dim sw, dw As Object
Dim ss, ds As Object
Dim excel, sheet, source, destination, cells, cell As Object

Try

sw = GetWorkbook(Handle, Source_Workbook)
dw = GetWorkbook(Handle, Destination_Workbook)

ss = GetWorksheet(Handle, Source_Workbook, Source_Worksheet)
ds = GetWorksheet(Handle, Destination_Workbook, Destination_Worksheet)

sw.Activate()
ss.Activate()
excel = ss.Application
sheet = excel.ActiveSheet
cell = excel.ActiveCell

If Source_Range="" Then
	cells = sheet.Cells
	Destination_Range = "A1"
Else
	cells = sheet.Range(Source_Range)
End If

cells.Select()
source = excel.Selection
source.Copy()
cell.Select()

dw.Activate()
ds.Activate()
sheet = excel.ActiveSheet
cell = excel.ActiveCell
destination = sheet.Range(Destination_Range)
'destination = sheet.Range("A1")
destination.Select()
destination.PasteSpecial(Paste:=12)
cell.Select()

My.Computer.Clipboard.Clear()

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	sw = Nothing
	ss = Nothing
	dw = Nothing
	ds = Nothing
	excel = Nothing
	sheet = Nothing
	source = Nothing
	destination = Nothing
	cells = Nothing
	cell = Nothing
End Try]]></code></stage><stage stageid="0877b347-2773-42b0-aaec-0591e1772bc4" name="End2" type="End"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><loginhibit /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="990f8633-59bc-42f2-b45f-0df39fb02fa7" name="Success" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="240" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c3c6b887-d2b9-48e5-a345-0ddee78e76ee" name="Message" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="270" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf2f6f4b-da28-4d0f-8e9b-a8a9444b3912" name="Success?" type="Decision"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><loginhibit /><display x="15" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>0877b347-2773-42b0-aaec-0591e1772bc4</ontrue><onfalse>0e7aba97-f12a-4a16-bfd9-c1e2198be6c4</onfalse></stage><stage stageid="0e7aba97-f12a-4a16-bfd9-c1e2198be6c4" name="Exception" type="Exception"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="120" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to copy worksheet: &quot; &amp; [Message]" /></stage><stage stageid="1c5beb4b-efdf-44bf-9b48-df036fcae1a1" name="Destination Worksheet" type="Data"><subsheetid>364e0ba0-ba2c-41fe-a959-365f765d6752</subsheetid><display x="-195" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit