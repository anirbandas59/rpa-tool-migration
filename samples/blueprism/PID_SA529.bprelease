tid><display x="-375" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1531a80b-9d60-4f9d-aa41-f6cbe074eba0" name="ScriptLocation" type="Data"><subsheetid>3c1c469d-4e04-4618-b135-ef011178edf4</subsheetid><display x="-420" y="-150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83543191-60c7-437e-920b-8a627789d33a" name="Script_Location" type="Data"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8ce8e52-a233-4c56-937d-841755a8c8ab" name="Upload File to Sharepoint With Metadata" type="SubSheetInfo"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><narrative>It will upload the file and update the  metadata.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="ecdbce0a-3e7b-4df2-8409-6de4a614b9c9" name="FilePath" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="712e4dfe-3571-4127-83f6-91b6e8b6212b" name="SP_Lib_Folder_Path" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-165" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aabfe97e-892a-4b00-83ef-73cc05db6826" name="Build Script" type="Calculation"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="-15" /><onsuccess>b4dbccfa-5d7d-4026-aa39-a9562f8a859f</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;Add-PnPFile -Folder &quot; &amp; Chr(34) &amp; [SP_Lib_Folder_Path] &amp; Chr(34) &amp; &quot; -Path &quot; &amp; Chr(34) &amp; [FilePath] &amp; Chr(34) &amp; &quot; -Values @{ &quot; &amp;[Filed&amp;Values]&amp; &quot;}&quot;" stage="Script" /></stage><stage stageid="b4dbccfa-5d7d-4026-aa39-a9562f8a859f" name="Generate_PnPScript" type="SubSheet"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>9e4bc377-d316-412a-9d31-0f629ea3c3e4</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="6d3568b4-104e-4bf3-838e-eeb0c3417717" name="SP_Site_URL" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7cab68eb-866d-44a5-a724-abcebe314e05" name="Filed&amp;Values" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-180" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5077ce82-fe9b-4193-95e4-e9a9e0517af1" name="Script" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-420" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1399c9b3-c4d1-42ec-9acc-f415ebbbbf75" name="Script_Loc" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-240" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c06ddbc7-a2eb-4a8e-bd9f-29dc88a166f6" name="Script Path" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-330" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8296b3d-f878-4462-991e-99a928e5ac26" name="Return Message" type="Data"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="-375" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f448ca20-3c48-408a-abcf-5a2918126a3d" name="Start" type="Start"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><narrative>Helps to upload file to sharepoint with Metadata.</narrative><display x="15" y="-195" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location (Example:-SharePointAPI Testing/TestFolder12)" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Field&amp;values" narrative="Provide Metadata Filed &amp; values ( Format ColumnName = &quot;Column value&quot; ; Column2 = &quot;Column2 Value&quot; ex:- TestDescription = &quot; I am a test case&quot;;D_date = &quot;7/17/2017&quot;)" stage="Filed&amp;Values" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>a9be0ff6-0d85-4d56-b52f-aa80adb56a13</onsuccess></stage><stage stageid="fa3abaf1-9705-4335-b903-85c277e0829c" name="End" type="End"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="465" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="9b849a6b-966c-4de7-99e4-dd834d418727" name="Run PnP_Script" type="SubSheet"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="195" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>13fc236c-a641-4e91-a8e1-7a634384ebf9</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="955f77c0-85f9-424d-99d6-2a7dab4ba53e" name="Delete_Script" type="Action"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="405" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>fa3abaf1-9705-4335-b903-85c277e0829c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="9e4bc377-d316-412a-9d31-0f629ea3c3e4" name="Check_Error" type="Decision"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="90" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c1335496-74fb-45a9-9243-ebd9c854d1c7</ontrue><onfalse>5a5bae23-8028-4489-97ef-00a2acd88089</onfalse></stage><stage stageid="c1335496-74fb-45a9-9243-ebd9c854d1c7" name="Exception while creating  Script" type="Exception"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="225" y="90" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="13fc236c-a641-4e91-a8e1-7a634384ebf9" name="Check Process_Exist" type="Action"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>d99ed36e-8b52-460f-9948-ecca55c7b2d0</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="d99ed36e-8b52-460f-9948-ecca55c7b2d0" name="ProcessExist?" type="Decision"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="15" y="300" /><decision expression="[Exists]=True" /><ontrue>c4928466-2039-4bc6-bcae-e478a0a6bdff</ontrue><onfalse>2dd13346-ee0e-4c13-9d71-33ae39dab792</onfalse></stage><stage stageid="2dd13346-ee0e-4c13-9d71-33ae39dab792" name="Anchor8" type="Anchor"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="120" y="300" w="10" h="10" /><onsuccess>73c81c3c-717a-489d-9d29-ba850b397835</onsuccess></stage><stage stageid="c4928466-2039-4bc6-bcae-e478a0a6bdff" name="Kill Process" type