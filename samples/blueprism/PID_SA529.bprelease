a" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Pasting data with transpose | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="5dd6cab9-dfb1-452f-8d9b-1a83bf8f3b2e" name="Paste Transpose" type="Code"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="handle" expr="[handle]" /><input type="number" name="PasteType" expr="[PasteType]" /><input type="text" name="Range" expr="[Range]" /></inputs><onsuccess>0eae8321-af0b-4e89-b4c3-38c1fd41b312</onsuccess><code><![CDATA[getinstance(handle).Workbooks(Workbook).Sheets(Worksheet).Range(Range).PasteSpecial(Paste:=PasteType, Transpose:=True)
'getinstance(handle).Workbooks(Workbook).Save()]]></code></stage><stage stageid="306069dd-d856-4ba8-939b-9a5bf86e7bd5" name="Workbook" type="Data"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><display x="-225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4a70f7b-6a97-474b-ac38-46dcb45854e7" name="Worksheet" type="Data"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><display x="-285" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cce06ace-1d1e-4b15-971a-c3860c97b36a" name="handle" type="Data"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><display x="-165" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1188e8d-1c2c-4032-9515-b09f577299fe" name="PasteType" type="Data"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b6bd9e23-412f-4ac5-a7e3-7efe00ce9f5b" name="Range" type="Data"><subsheetid>ea521dd7-3a68-484a-9286-b0e70c41e946</subsheetid><display x="-255" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e8f830c-c680-4665-b6b6-5c947176fb46" name="Get Column Number - Text" type="SubSheetInfo"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><narrative>Get Column Position from the Text to be searched</narrative><display x="-255" y="-120" w="150" h="90" /></stage><stage stageid="d95dc8d1-b049-4202-ac13-e6eef362c79c" name="Start" type="Start"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="number" name="handle" narrative="handle of open excel" stage="handle" /><input type="text" name="Worksheet" narrative="Name of worksheet" stage="Worksheet" /><input type="text" name="TextToFind" narrative="TextToFind" stage="TextToFind" /></inputs><onsuccess>be4cfb8b-bbc0-4e9a-bc76-ff62901721b4</onsuccess></stage><stage stageid="55865e33-b7eb-457d-929c-d4474db5c2e6" name="End" type="End"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="15" y="180" /><outputs><output type="number" name="ColumnPosition" narrative="Position of the Column" stage="ColumnPosition" /></outputs></stage><stage stageid="a41c9271-a2fb-48b3-bca4-9705fa85ca40" name="Inputs" type="Block"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="-345" y="-60" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3810b502-8ffb-47fd-b279-2de5ae8f2db8" name="Outputs" type="Block"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="-345" y="75" w="240" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="782a70d2-e050-4a37-a66d-96db936c36e2" name="Get Cell Value" type="Block"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="-60" y="-15" w="195" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="be4cfb8b-bbc0-4e9a-bc76-ff62901721b4" name="Get Col Position" type="Code"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="TextToFind" expr="[TextToFind]" /></inputs><outputs><output type="number" name="ColumnPosition" stage="ColumnPosition" /></outputs><onsuccess>55865e33-b7eb-457d-929c-d4474db5c2e6</onsuccess><code><![CDATA[

Dim wb, ws As Object
Dim excel, sheet, range As Object

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range("A1")
Try
ColumnPosition=range.Find(What:= TextToFind, _
                  LookIn:=-4123, _
                  LookAt:=1, _
				  SearchOrder:=1, _
			      SearchDirection:=1, _
				  MatchCase:=True, _
				  SearchFormat:=False).Column
      range.Select()

Catch e As Exception
                
				ColumnPosition=0
Finally
                wb = Nothing
                ws = Nothing
                excel = Nothing
                sheet = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="6131981a-55f1-473b-8622-be4f0adadd58" name="Workbook" type="Data"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="-225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd22edfd-0997-46ab-ab87-c8c0fbb4d592" name="Worksheet" type="Data"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="-285" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="28eb98c4-c94e-4d4b-ad69-e2801b133fe1" name="handle" type="Data"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="-165" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6a48578e-05d9-4554-8f5b-4c7f5228bfff" name="ColumnPosition" type="Data"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="-225" y="105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67fc1099-9273-49d0-af78-0805c251aacb" name="TextToFind" type="Data"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="-225" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5205a9f0-14b6-4904-a3fd-ba1d3ee276ab" name="Throw : SE : Error in getting Column Text from Number" type="Exception"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><display x="195" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in getting Column Number from Text | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="04fb1596-0a5f-4b1b-bfbe-f3f93744dfe6" name="Recover2" type="Recover"><subsheetid>e4bf5dd9-6e2f-4aaa-85cb-61a7e2f4ecd4</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>5205a9f0-14b6-4904-a3fd-ba1d3ee27