ccess>3236dfcd-d224-4d30-b9a8-7333aaadb7e3</onsuccess></stage><stage stageid="3fecca48-eb12-45ae-b687-186f25db27ee" name="Anchor26" type="Anchor"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="135" y="210" w="10" h="10" /><onsuccess>8f2800cc-4ab8-4c7a-abf1-54f7405cfe04</onsuccess></stage><stage stageid="c7c9ca66-7094-413f-a3a9-588f0e4f849a" name="Exists" type="Data"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-510" y="225" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dd89ce81-72f6-4cf8-91be-a0c842b9cd79" name="End" type="End"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-45" y="405" /><outputs><output type="flag" name="Latest Files check Success" narrative="Latest Files check Status" stage="Success" /></outputs></stage><stage stageid="6bf11482-35c6-433c-a1d6-06cba2f0e191" name="Start" type="Start"><subsheetid>d27ca775-2cf6-4856-9e03-482312570937</subsheetid><display x="-45" y="-270" /><inputs><input type="text" name="SharePoint URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SharePoint URL" /><input type="text" name="Share_Lib_Folder_Path" narrative="Folder Path in Sharepoint From Which u want Latest Files" stage="Share_Lib_Folder_Path" /><input type="text" name="Destination Latest Excel Name Folder Path" narrative="Destination Excel File Name Folder Path  (Example:- C:\Apps\Temp\latest.xlsx)" stage="Destination Latest Excel Name Folder Path" /><input type="text" name="AddDays" narrative="AddDays Range From Current Time to get latest files" stage="AddDays" /><input type="text" name="AddHours" narrative="AddHours Range From Current Time to get latest files" stage="AddHours" /><input type="text" name="AddMinutes" narrative="AddMinutes Range From Current Time to get latest files" stage="AddMinutes" /><input type="text" name="AddSeconds" narrative="AddSeconds Range From Current Time to get latest files" stage="AddSeconds" /><input type="text" name="Current Date and Time" narrative="Current Date and Time to get latest files" stage="Current Date and Time" /><input type="text" name="Script_Loc" narrative="Location of the script to be generated" stage="Script_Loc" /></inputs><onsuccess>349428f8-baff-46d3-96fc-983e4dd0c30b</onsuccess></stage><stage stageid="46d93b1e-eca1-490b-be53-0975b9ebaa2a" name="Get Latest File that starts with" type="SubSheetInfo"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><narrative>For the given Site and folder location, the name of the oldest file (as per the modifed date) is given as output</narrative><display x="-390" y="-75" w="180" h="60" /></stage><stage stageid="ecc9c7ec-41dc-431e-aea4-06deba52778d" name="Start" type="Start"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="List/Lib_Name" narrative="List or library name" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /><input type="text" name="File Name Start" narrative="Word appearing in the start of  a file" stage="txt_FileNameStartWith" /></inputs><onsuccess>f97779e5-8e49-4087-b942-3dff245513b6</onsuccess></stage><stage stageid="7a24d60a-b4bc-4841-b3fd-fe275accb79f" name="Build Script" type="Calculation"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="-45" w="90" h="30" /><onsuccess>d3d0cb86-7808-4f41-aeb2-00301b5f54cf</onsuccess><calculation expression="&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$items=(Get-PnPFolderItem $SourceName -ErrorAction Stop -WarningAction silentlyContinue) &quot;&amp; NewLine() &amp; &#xA;&quot;$items = $items | Where-Object { $_.Name -like '&quot;&amp;[txt_FileNameStartWith]&amp;&quot;*' }|Sort-Object -Property {$_.TimeLastModified} -Descending&quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount = $items.Count&quot;&amp; NewLine() &amp;&#xA;&quot;$FileName = ''&quot;&amp; NewLine() &amp; &#xA;&quot;$emptyStr = ''&quot; &amp; NewLine() &amp; &#xA;&#xA;&quot;If ($itemsCount -gt 0){ &quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;foreach($itm in $items) {&quot;&amp; NewLine() &amp; &#xA;&quot;If ($itm.GetType().Name -eq 'File') { &quot;&amp; NewLine() &amp; &#xA;&quot;$FileName = $itm.Name&quot;&amp; NewLine() &amp; &#xA;&quot;Break&quot;&amp; NewLine() &amp; &#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;Else { continue}}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;If ( $FileName -eq $emptyStr) {&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('No files found')&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Else{ &quot;&amp; NewLine() &amp; &#xA;&quot;Write-Host 'FILE NAME: '$FileName}&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else{&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('Folder is empty')&quot;&amp; NewLine() &amp; &#xA;&quot;}}&quot;&amp; NewLine() &amp; &#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="39974e8b-9ea5-4eea-a215-4b7c94f7ad7d" name="Run PnP_Script" type="SubSheet"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="90" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>09f16f5f-d280-4fbc-a434-c921a39d3260</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d3911887-4d08-48b6-8134-deca654f9363" name="Delete_Script" type="Action"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="240" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>abe923e1-2915-439a-911b-1c1e86f53cc3</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="d3d0cb86-7808-4f41-aeb2-00301b5f54cf" name="Generate_PnPScript" type="SubSheet"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_Latest_File_with_startname_in_folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>5fa9f2bd-0e06-434d-99c3-072b5d34fa9a</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="5fa9f2bd-0e06-434d-99c3-072b5d34fa9a" name="Check_Error" type="Decision"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>14856ae8-bac2-44ae-9f2e-6f242e303466</ontrue><onfalse>39974e8b-9ea5-4eea-a215-4b7c94f7ad7d</onfalse></stage><stage stageid="14856ae8-bac2-44ae-9f2e-6f242e303466" name="Exception while creating  Script" type="Exception"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="255" y="45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="a5b54f52-e0c9-4bf6-94a8-98a8c1ecc2b8" name="Check Process_Exist" type="Action"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="180" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>ce596aac-01e9-4317-ab4a-9622831c95bb</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="ce596aac-01e9-4317-ab4a-9622831c95bb" name="ProcessExist?" type="Decision"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="135" y="180" /><decision expression="[P_Exists]=True" /><ontrue>b0a7da69-170b-4cd0-8415-547a14be69a8</ontrue><onfalse>d3911887-4d08-48b6-8134-deca654f9363</onfalse></stage><stage stageid="b0a7da69-170b-4cd0-8415-547a14be69a8" name="Kill Process" type="Action"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="135" y="240" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d3911887-4d08-48b6-8134-deca654f9363</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="35571b6e-9ab0-48c5-aefe-d45fa158bca7" name="SP_Site_URL" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-195" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eef75af3-18ca-4ecf-a436-4bcaca3d3d3f" name="SP_RelLib_Url" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b1eaf68-f07d-4e1f-a653-32d1811ff7ce" name="Output" type="Block"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-285" y="60" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="71b6efea-7f34-49f1-b3ab-3eb05f04102c" name="Script" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af8937bd-4229-4734-a3d1-c9db695a0a23" name="Return Message" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="30b77bc6-2dca-4750-80a3-a6035dd9b131" name="Script Path" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6401d681-8795-4e1b-bac0-261f88f114e6" name="Error_Message" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fb328a41-fc18-4dc6-ac4b-c92f8d27676e" name="Run Report" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="240" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b4a9048-2a8d-433c-8cee-1ef56c43060f" name="P_Exists" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><narrative>Process exist or not</narrative><display x="-390" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb150f1e-e132-4c0d-8bbb-07ab5a8b982b" name="Unexpected exception recover" type="Recover"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="150" y="-90" /><onsuccess>f03ceb12-d036-4551-bfe2-386806def945</onsuccess></stage><stage stageid="0075064c-902f-4bbf-bbca-9b742fb487bf" name="Unexpected Exception" type="Exception"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="255" y="-45" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="b2c11426-af7e-4eed-add4-7fe6edc70d95" name="Script_Location" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f03ceb12-d036-4551-bfe2-386806def945" name="Delete_Script" type="Action"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="255" y="-90" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>0075064c-902f-4bbf-bbca-9b742fb487bf</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="834afa8e-2ea3-450b-9505-94d13aa00572" name="Validate Temp Script Path" type="SubSheet"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="-90" w="90" h="30" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>7a24d60a-b4bc-4841-b3fd-fe275accb79f</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="09f16f5f-d280-4fbc-a434-c921a39d3260" name="Error Message?" type="Decision"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="135" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>1de669fb-2eba-4dd0-8336-2842de697b81</ontrue><onfalse>a5b54f52-e0c9-4bf6-94a8-98a8c1ecc2b8</onfalse></stage><stage stageid="f63a4cc7-038c-4c5e-8da3-d932886aa583" name="Received exception after running the script" type="Exception"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="255" y="180" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="624efa5d-a3b2-497b-8f9f-bdf83e489955" name="Input" type="Block"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-285" y="-105" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1c7cd044-9e18-48fb-8d1c-55a7205e0ddc" name="Inhouse" type="Block"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-480" y="-30" w="180" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="928e2683-07b2-4971-982c-5ce755069c3b" name="End" type="End"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="345" /><outputs><output type="text" name="Oldest File Name" narrative="Name of the oldest file in the specified folderq" stage="FileName" /></outputs></stage><stage stageid="8541c9eb-f97a-43fe-a546-0c58a42a7316" name="User Name" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e95d06c-a6bf-4c37-959d-967802ed4bda" name="Count" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="120" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="abe923e1-2915-439a-911b-1c1e86f53cc3" name="Extract Filename" type="MultipleCalculation"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="15" y="285" w="90" h="30" /><onsuccess>928e2683-07b2-4971-982c-5ce755069c3b</onsuccess><steps><calculation expression="InStr([Run Report], &quot;FILE NAME:  &quot;)+Len(&quot;FILE NAME:  &quot;)" stage="NameStartPoint" /><calculation expression="Mid([Run Report],[NameStartPoint], Len([Run Report]) - [NameStartPoint])" stage="FileName" /></steps></stage><stage stageid="1f8a22af-0e23-4160-b128-501baee1ec71" name="NameStartPoint" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-390" y="150" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8db41d20-15bc-4140-83b5-73c2d4effa32" name="FileName" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-195" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e1aee484-042d-4868-83f1-390c0f5b8044" name="Block10" type="Block"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-60" y="-120" w="255" h="435" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1de669fb-2eba-4dd0-8336-2842de697b81" name="Delete_Script" type="Action"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="255" y="135" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>f63a4cc7-038c-4c5e-8da3-d932886aa583</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="dec10085-ddc0-4dea-b4fc-5ac3a82f359f" name="Remove / in URL" type="SubSheet"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><loginhibit /><display x="15" y="-150" /><inputs><input type="text" name="URL" friendlyname="URL" narrative="URL" expr="[SP_RelLib_Url]" /></inputs><outputs><output type="text" name="URL" friendlyname="URL" narrative="URL" stage="SP_RelLib_Url" /></outputs><onsuccess>834afa8e-2ea3-450b-9505-94d13aa00572</onsuccess><processid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</processid></stage><stage stageid="e86fc538-8662-4db9-96dc-b6d3f88c9df8" name="txt_FileNameStartWith" type="Data"><subsheetid>112ca2fc-ab20-4908-9135-7d9915f037d3</subsheetid><display x="-195" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a90d3fda-8114-473d-b987-9a4728ed8846" name="Download all files in folder including Subfolders (Recursive)" type="SubSheetInfo"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><narrative>Downloads the entire folder structure including sub-folders and files
Please note that the downloaded files will follow the Sharepoint folder structure starting from library name</narrative><display x="-270" y="-105" w="150" h="90" /></stage><stage stageid="08eab2d9-c5bb-4431-94c8-75baadd1a49e" name="Start" type="Start"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="15" y="-225" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="File Path" narrative="File path to download the files and sub-folders" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /></inputs><onsuccess>374a9ad1-51cb-472b-b05e-21ba99faf105</onsuccess></stage><stage stageid="f71d4a2a-d378-468e-b86c-60741569c449" name="End" type="End"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="435" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="b704e0c9-c41d-452f-90b1-6f188ee68ed2" name="Return Message" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-285" y="180" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35040e67-b8bc-4126-a1f4-ee354ed5475a" name="Build Script" type="Calculation"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="-15" /><onsuccess>ecff8cb1-c98b-4e5a-bd6a-a282f285c2f6</onsuccess><calculation expression="&quot;Function Download-SPOFolder([Microsoft.SharePoint.Client.Folder]$Folder, $DestinationFolder)&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;    #Get the Folder's Site Relative URL&quot;&amp;NewLine()&amp;&quot;&#xA;    $FolderURL = $Folder.ServerRelativeUrl.Substring($Folder.Context.Web.ServerRelativeUrl.Length)&quot;&amp;NewLine()&amp;&quot;&#xA;    $LocalFolder = $DestinationFolder + ($FolderURL -replace '/','\')&quot;&amp;NewLine()&amp;&quot;&#xA;    #Create Local Folder, if it doesn't exist&quot;&amp;NewLine()&amp;&quot;&#xA;    If (!(Test-Path -Path $LocalFolder)) {&quot;&amp;NewLine()&amp;&quot;&#xA;            New-Item -ItemType Directory -Path $LocalFolder | Out-Null&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    #Get all Files from the folder&quot;&amp;NewLine()&amp;&quot;&#xA;    $FilesColl = Get-PnPFolderItem -FolderSiteRelativeUrl $FolderURL -ItemType File&quot;&amp;NewLine()&amp;&quot;&#xA;    #Iterate through each file and download Sourcefile&quot;&amp;NewLine()&amp;&quot;&#xA;    Foreach($File in $FilesColl)&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        Get-PnPFile -ServerRelativeUrl $File.ServerRelativeUrl -Path $LocalFolder -FileName $File.Name -AsFile -force&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    #Get Subfolders of the Folder and call the function recursively&quot;&amp;NewLine()&amp;&quot;&#xA;    $SubFolders = Get-PnPFolderItem -FolderSiteRelativeUrl $FolderURL -ItemType Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    Foreach ($Folder in $SubFolders | Where {$_.Name -ne 'Forms'})&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        Download-SPOFolder $Folder $DestinationFolder&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&amp;NewLine()&amp;&quot;&#xA;#Set Parameters&quot;&amp;NewLine()&amp;&quot;&#xA;$SiteURL = &quot;&amp;Chr(34)&amp;[SP_Site_URL]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FolderSiteRelativeURL = &quot;&amp;Chr(34)&amp;[SP_Lib_Folder_Path]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$DownloadPath =&quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;#Connect to PnP Online&quot;&amp;NewLine()&amp;&quot;&#xA;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url $SiteURL -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&quot;&#xA;#Get the folder to download&quot;&amp;NewLine()&amp;&quot;&#xA;$Folder = Get-PnPFolder -Url $FolderSiteRelativeURL&quot;&amp;NewLine()&amp;&quot;&#xA;#Call the function to download all files from a folder&quot;&amp;NewLine()&amp;&quot;&#xA;Download-SPOFolder $Folder $DownloadPath&quot;" stage="Script" /></stage><stage stageid="51c35aa1-8db1-4fac-bd57-1350ea6d801b" name="Script" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1501b5f3-c4d4-416a-bbb5-8fb9ab572183" name="SP_Site_URL" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><narrative>Link for site or subsite.</narrative><display x="-285" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8873171-5d08-45ef-888f-b58153105349" name="SP_Lib_Folder_Path" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-285" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1275694c-b991-4a9b-8c73-3fcb256f7729" name="Run PnP_Script" type="SubSheet"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="165" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>8a4647e0-cbf9-4fbf-9f1f-9ef0590e5324</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="ddeb8be1-56f7-4d06-ab29-f3f09e04b752" name="Script Path" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-180" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="141c7631-6839-4296-aeaf-3584d752be96" name="Delete_Script" type="Action"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="375" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>f71d4a2a-d378-468e-b86c-60741569c449</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ecff8cb1-c98b-4e5a-bd6a-a282f285c2f6" name="Generate_PnPScript" type="SubSheet"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_download&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>85a4734f-87a3-45f2-876e-5ffc0865ee5a</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="329d3315-dd60-4200-958c-1a4ccd64552c" name="Input" type="Block"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-345" y="-45" w="120" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cecde75d-483c-46b4-abdb-f2a21430e4d7" name="Output" type="Block"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-345" y="135" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3138b2cc-cbb3-4512-947c-f59c6b287db5" name="Inhouse" type="Block"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-210" y="-45" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="85a4734f-87a3-45f2-876e-5ffc0865ee5a" name="Check_Error" type="Decision"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="105" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>fde2be85-b0d9-4560-a252-ccafb6161c15</ontrue><onfalse>1275694c-b991-4a9b-8c73-3fcb256f7729</onfalse></stage><stage stageid="fde2be85-b0d9-4560-a252-ccafb6161c15" name="Exception while creating  Script" type="Exception"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="135" y="105" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="8a4647e0-cbf9-4fbf-9f1f-9ef0590e5324" name="Check Process_Exist" type="Action"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="210" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>231af078-f149-41e5-9b59-e97297fee88d</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="81d33de4-da3b-4234-a627-7f4c1310c9f0" name="Exists" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-135" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="231af078-f149-41e5-9b59-e97297fee88d" name="ProcessExist?" type="Decision"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="270" /><decision expression="[Exists]=True" /><ontrue>fe8490f2-f9c6-4f7a-9265-31bdc96e5c8b</ontrue><onfalse>33988e6f-ee3d-4072-b42c-eb767749c4b4</onfalse></stage><stage stageid="bb09f741-815d-4689-9c43-a94a5374c149" name="Temp_Retry" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-120" y="105" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="33988e6f-ee3d-4072-b42c-eb767749c4b4" name="Anchor8" type="Anchor"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="120" y="270" w="10" h="10" /><onsuccess>35c2214f-5b70-41f0-98ff-ba44465dd305</onsuccess></stage><stage stageid="fe8490f2-f9c6-4f7a-9265-31bdc96e5c8b" name="Kill Process" type="Action"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="315" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>141c7631-6839-4296-aeaf-3584d752be96</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="35c2214f-5b70-41f0-98ff-ba44465dd305" name="Anchor9" type="Anchor"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="120" y="375" w="10" h="10" /><onsuccess>141c7631-6839-4296-aeaf-3584d752be96</onsuccess></stage><stage stageid="269cf1c8-bf42-4bad-b2e1-d42716577fb6" name="Run_Status" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-180" y="45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bff0c7e2-cc69-4531-9023-03ea9eaee870" name="Error_Message" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-300" y="240" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0c5a6375-e7aa-498d-9386-44aada76ca80" name="Unexpected exception recover" type="Recover"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="345" y="195" /><onsuccess>e4a436fb-4811-40b4-8331-b506543df350</onsuccess></stage><stage stageid="bef16be3-5a8d-4b46-833e-c22f91e71373" name="Unexpected Exception" type="Exception"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="495" y="195" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="04900b15-b23b-406b-a22e-14cc9208bf20" name="Script_Loc" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-120" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4a436fb-4811-40b4-8331-b506543df350" name="Delete_Script" type="Action"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="420" y="195" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>bef16be3-5a8d-4b46-833e-c22f91e71373</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="62c6a054-fd66-4c4a-84a1-d3b95e74c18e" name="Validate Temp Script Path" type="SubSheet"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>35040e67-b8bc-4126-a1f4-ee354ed5475a</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="0c49edb4-c987-4bfc-9c3a-ff55f6b5a627" name="Remove / in URL" type="SubSheet"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="URL" friendlyname="URL" narrative="URL" expr="[SP_Lib_Folder_Path]" /></inputs><outputs><output type="text" name="URL" friendlyname="URL" narrative="URL" stage="SP_Lib_Folder_Path" /></outputs><onsuccess>62c6a054-fd66-4c4a-84a1-d3b95e74c18e</onsuccess><processid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</processid></stage><stage stageid="36307b6f-f04b-4ed5-81a1-ac3ac5003a0e" name="FilePath" type="Data"><subsheetid>ed63d0d3-f604-4b62-82e5-f7dceb2af6a3</subsheetid><display x="-285" y="60" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8d2a6b8c-4c68-433f-abd3-83ab4c3deb3b" name="Upload folder structure to SharePoint" type="SubSheetInfo"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><narrative>This action uploads the complete folder structure including nested sub folders and files</narrative><display x="-285" y="-105" w="150" h="90" /></stage><stage stageid="1fe8b6fb-4e7d-4bb4-b2c7-37c19aaa14e8" name="Start" type="Start"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="0" y="-195" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="Local FolderPath" narrative="Complete folder path to be uploaded  (Example:- C:\Apps\Temp). All the sub folders and file inside Temp will be uploaded" stage="FolderPath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /></inputs><onsuccess>3925fe68-d7f9-479c-9ded-a121d514d48a</onsuccess></stage><stage stageid="d770a31d-e105-4002-aecc-1fcd3472c9dc" name="End" type="End"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="480" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="ca532524-9d8d-40e5-a12b-b82ec5f5db4c" name="Return Message" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-300" y="195" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="66ac52b7-376f-4f9b-9e6a-06f46655dcfc" name="Build Script" type="Calculation"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="0" /><onsuccess>bd0045bb-3598-4a58-ad53-83b6c6b32b72</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$SiteURL = &quot;&amp;Chr(34)&amp;[SP_Site_URL]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$LocalFolderPath = &quot;&amp;Chr(34)&amp;[FolderPath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$TargetFolderURL = &quot;&amp;Chr(34)&amp;[SP_Lib_Folder_Path]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine()&amp;&quot;&#xA;#Function to upload all files from a local folder to SharePoint Online Folder&quot;&amp;NewLine()&amp;&quot;&#xA;Function Upload-PnPFolder($LocalFolderPath, $TargetFolderURL)&quot;&amp;NewLine()&amp;&quot;&#xA;{&#xA;    #Get All files and SubFolders from the local disk&quot;&amp;NewLine()&amp;&quot;&#xA;    $Files = Get-ChildItem -Path $LocalFolderPath -File&quot;&amp;NewLine()&amp;&quot;&#xA;    #Ensure the target folder&quot;&amp;NewLine()&amp;&quot;&#xA;    Resolve-PnPFolder -SiteRelativePath $TargetFolderURL | Out-Null&quot;&amp;NewLine()&amp;&quot;&#xA;    #Upload All files from the local folder to SharePoint Online Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    ForEach ($File in $Files)&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        Add-PnPFile -Path &quot;&amp;Chr(34)&amp;&quot;$($File.Directory)\$($File.Name)&quot;&amp;Chr(34)&amp;&quot; -Folder $TargetFolderURL -Values @{'Title' = $($File.Name)} | Out-Null&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&amp;NewLine()&amp;&quot;&#xA;#Call the function to upload the Root Folder&quot;&amp;NewLine()&amp;&quot;&#xA;Upload-PnPFolder -LocalFolderPath $LocalFolderPath -TargetFolderURL $TargetFolderURL&quot;&amp;NewLine()&amp;&quot;&#xA;#Get all Folders from given source path&quot;&amp;NewLine()&amp;&quot;&#xA;Get-ChildItem -Path $LocalFolderPath -Recurse -Directory | ForEach-Object {&quot;&amp;NewLine()&amp;&quot;&#xA;$FolderToUpload = ($TargetFolderURL+$_.FullName.Replace($LocalFolderPath,[string]::Empty)).Replace('\','/')&quot;&amp;NewLine()&amp;&quot;&#xA;Upload-PnPFolder -LocalFolderPath $_.FullName -TargetFolderURL $FolderToUpload&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;" stage="Script" /></stage><stage stageid="311db9d2-cb75-4029-bd76-d4de89344198" name="Script" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-180" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3fd199cf-876b-4634-92b4-420aff9040bb" name="SP_Site_URL" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><narrative>Link for site or subsite.</narrative><display x="-300" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c95c581-894a-411d-9a86-68af5f83aa44" name="SP_Lib_Folder_Path" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-300" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="619f9a7c-5cbd-40b6-94ee-18b5afaa1538" name="Run PnP_Script" type="SubSheet"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="210" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>1d9130e3-adb8-428c-9ec3-322195a377f2</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="5b957503-c87e-4525-9f85-4cd1ed17fcba" name="Script Path" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-195" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b8195046-bbf3-44b4-a7a8-a4dbab5e3585" name="Delete_Script" type="Action"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="420" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>d770a31d-e105-4002-aecc-1fcd3472c9dc</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="bd0045bb-3598-4a58-ad53-83b6c6b32b72" name="Generate_PnPScript" type="SubSheet"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>30255bdb-d014-4c38-9485-2d6990969adf</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="f0cbe677-3935-416c-9c87-8697d71627e8" name="Input" type="Block"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-360" y="-30" w="120" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e936dd5b-49bc-4c62-acd3-13b18970b574" name="Output" type="Block"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-360" y="150" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ef062a1c-fb74-47ad-b2fe-ed409a688ecd" name="Inhouse" type="Block"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-225" y="-30" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="30255bdb-d014-4c38-9485-2d6990969adf" name="Check_Error" type="Decision"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="150" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>16be3ac4-e09b-4764-b18a-6167f5253e8e</ontrue><onfalse>619f9a7c-5cbd-40b6-94ee-18b5afaa1538</onfalse></stage><stage stageid="16be3ac4-e09b-4764-b18a-6167f5253e8e" name="Exception while creating  Script" type="Exception"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="195" y="150" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="1d9130e3-adb8-428c-9ec3-322195a377f2" name="Check Process_Exist" type="Action"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="255" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>f41bb874-84d1-4b27-9ad2-f6ef7dea3231</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="dddc57ae-c82c-4afa-959a-8184ac638398" name="Exists" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-150" y="60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f41bb874-84d1-4b27-9ad2-f6ef7dea3231" name="ProcessExist?" type="Decision"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="315" /><decision expression="[Exists]=True" /><ontrue>2b5950dc-f4cd-40c1-99d3-21f2096e409f</ontrue><onfalse>0a1650c0-14ad-483d-bb85-b45377cc9604</onfalse></stage><stage stageid="d7c5b12b-0007-48c3-b070-da1fb5462aee" name="Temp_Retry" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-135" y="120" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="0a1650c0-14ad-483d-bb85-b45377cc9604" name="Anchor8" type="Anchor"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="105" y="315" w="10" h="10" /><onsuccess>134f0f37-d996-4a5c-9ba1-337b52b64671</onsuccess></stage><stage stageid="2b5950dc-f4cd-40c1-99d3-21f2096e409f" name="Kill Process" type="Action"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="360" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>b8195046-bbf3-44b4-a7a8-a4dbab5e3585</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="134f0f37-d996-4a5c-9ba1-337b52b64671" name="Anchor9" type="Anchor"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="105" y="420" w="10" h="10" /><onsuccess>b8195046-bbf3-44b4-a7a8-a4dbab5e3585</onsuccess></stage><stage stageid="578130ad-e89a-426c-9850-becceee29bc2" name="Run_Status" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-195" y="60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8d3cb62c-0678-4acd-9f12-01a9cf6c5aea" name="Error_Message" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-315" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f21eb092-0b5d-4062-8171-b66b76383af9" name="Unexpected exception recover" type="Recover"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="330" y="210" /><onsuccess>4a368d1a-cf19-48cc-95d4-d149fc8f7e91</onsuccess></stage><stage stageid="0df517d7-24bf-4bec-8f3e-d988f1a7fc39" name="Unexpected Exception" type="Exception"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="480" y="210" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="e2b4a455-25cd-487f-82d7-54224cf6b7fe" name="Script_Loc" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-135" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a368d1a-cf19-48cc-95d4-d149fc8f7e91" name="Delete_Script" type="Action"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="405" y="210" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>0df517d7-24bf-4bec-8f3e-d988f1a7fc39</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="7a7637fe-6974-4eb9-badc-ac578312563c" name="Validate Temp Script Path" type="SubSheet"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="0" y="-45" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>66ac52b7-376f-4f9b-9e6a-06f46655dcfc</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="a466c2da-b1bb-432c-87c4-25a5b4397176" name="Remove / in URL" type="SubSheet"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><loginhibit /><display x="0" y="-90" /><inputs><input type="text" name="URL" friendlyname="URL" narrative="URL" expr="[SP_Lib_Folder_Path]" /></inputs><outputs><output type="text" name="URL" friendlyname="URL" narrative="URL" stage="SP_Lib_Folder_Path" /></outputs><onsuccess>7a7637fe-6974-4eb9-badc-ac578312563c</onsuccess><processid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</processid></stage><stage stageid="77d02d1e-f1e1-4541-94da-2e6c19df3f4a" name="FolderPath" type="Data"><subsheetid>e5ab72df-9f86-4e44-a30c-5e626e223b95</subsheetid><display x="-300" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3a20ac96-80ce-4c28-b50d-a6988efcaf8d" name="Upload folder structure to SharePoint - Large data" type="SubSheetInfo"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><narrative>This action uploads the complete folder structure including nested sub folders and files
There is a limitation with PnP Powershell wherein it cannot upload more than 250MB. This action resolves that by uploading in chunks
</narrative><display x="-285" y="-105" w="150" h="90" /></stage><stage stageid="191489ad-63bd-46f7-b1a7-508032e0a149" name="Start" type="Start"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="0" y="-180" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="Local FolderPath" narrative="Complete folder path to be uploaded  (Example:- C:\Apps\Temp). All the sub folders and file inside Temp will be uploaded" stage="FolderPath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Library Name" narrative="Library Name" stage="Library Name" /></inputs><onsuccess>364f9052-a79a-44af-891e-a3901db52337</onsuccess></stage><stage stageid="4fcc3ec4-1478-41dd-893a-c48b6b10877b" name="End" type="End"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="450" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="53158172-5f07-4e7d-b2fb-c50d437f2cc7" name="Return Message" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-300" y="195" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cb72b26-bd9a-4720-abba-dae08cbbe9c3" name="Build Script" type="Calculation"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="15" /><onsuccess>63a10bbc-278f-4736-9ea3-ddcab047379d</onsuccess><calculation expression="&quot;$SiteURL = &quot;&amp;Chr(34)&amp;[SP_Site_URL]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$LocalFolderPath = &quot;&amp;Chr(34)&amp;[FolderPath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$TargetFolderURL = &quot;&amp;Chr(34)&amp;[SP_Lib_Folder_Path]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$LibraryName = &quot;&amp;Chr(34)&amp;[Library Name]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$Libraryurl = $TargetFolderURL.Split('/')[0]&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;&#xA;&#xA;Function Upload-LargeFile($FilePath, $LibraryName, $FileChunkSize=10)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;    Try {&quot;&amp;NewLine()&amp;&quot;&#xA;        #Get File Name&quot;&amp;NewLine()&amp;&quot;&#xA;        $FileName = [System.IO.Path]::GetFileName($FilePath)&quot;&amp;NewLine()&amp;&quot;&#xA;        $UploadId = [GUID]::NewGuid()&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;        #Get the folder to upload&quot;&amp;NewLine()&amp;&quot;&#xA;        $Library = $Ctx.Web.Lists.GetByTitle($LibraryName)&quot;&amp;NewLine()&amp;&quot;&#xA;        $Ctx.Load($Library)&quot;&amp;NewLine()&amp;&quot;&#xA;        $Ctx.Load($Library.RootFolder)&quot;&amp;NewLine()&amp;&quot;&#xA;        $Ctx.ExecuteQuery()&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;        $BlockSize = $FileChunkSize * 1024 * 1024&quot;&amp;NewLine()&amp;&quot;  &#xA;        $FileSize = (Get-Item $FilePath).length&quot;&amp;NewLine()&amp;&quot;&#xA;        If($FileSize -le $BlockSize)&quot;&amp;NewLine()&amp;&quot;&#xA;        {&quot;&amp;NewLine()&amp;&quot;&#xA;            #Regular upload&quot;&amp;NewLine()&amp;&quot;&#xA;            $FileStream = New-Object IO.FileStream($FilePath,[System.IO.FileMode]::Open)&quot;&amp;NewLine()&amp;&quot;&#xA;            $FileCreationInfo = New-Object Microsoft.SharePoint.Client.FileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;            $FileCreationInfo.Overwrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;            $FileCreationInfo.ContentStream = $FileStream&quot;&amp;NewLine()&amp;&quot;&#xA;            $FileCreationInfo.URL = $FileName&quot;&amp;NewLine()&amp;&quot;&#xA;            $Upload = $Library.RootFolder.Files.Add($FileCreationInfo)&quot;&amp;NewLine()&amp;&quot;&#xA;            $ctx.Load($Upload)&quot;&amp;NewLine()&amp;&quot;&#xA;            $ctx.ExecuteQuery()&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;        Else&quot;&amp;NewLine()&amp;&quot;&#xA;        {&quot;&amp;NewLine()&amp;&quot;&#xA;            #Large File Upload in Chunks&quot;&amp;NewLine()&amp;&quot;&#xA;            $ServerRelativeUrlOfRootFolder = $Library.RootFolder.ServerRelativeUrl&quot;&amp;NewLine()&amp;&quot;&#xA;            [Microsoft.SharePoint.Client.File]$Upload&quot;&amp;NewLine()&amp;&quot;&#xA;            $BytesUploaded = $null &quot;&amp;NewLine()&amp;&quot;&#xA;            $Filestream = $null&quot;&amp;NewLine()&amp;&quot;&#xA;            $Filestream = [System.IO.File]::Open($FilePath, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)&quot;&amp;NewLine()&amp;&quot;&#xA;            $BinaryReader = New-Object System.IO.BinaryReader($Filestream)&quot;&amp;NewLine()&amp;&quot;&#xA;            $Buffer = New-Object System.Byte[]($BlockSize)&quot;&amp;NewLine()&amp;&quot;&#xA;            $LastBuffer = $null&quot;&amp;NewLine()&amp;&quot;&#xA;            $Fileoffset = 0&quot;&amp;NewLine()&amp;&quot;&#xA;            $TotalBytesRead = 0&quot;&amp;NewLine()&amp;&quot;&#xA;            $BytesRead&quot;&amp;NewLine()&amp;&quot;&#xA;            $First = $True&quot;&amp;NewLine()&amp;&quot;&#xA;            $Last = $False&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;            #Read data from the file in blocks&quot;&amp;NewLine()&amp;&quot;&#xA;            While(($BytesRead = $BinaryReader.Read($Buffer, 0, $Buffer.Length)) -gt 0)&quot;&amp;NewLine()&amp;&quot;&#xA;            {&quot;&amp;NewLine()&amp;&quot;&#xA;                $TotalBytesRead = $TotalBytesRead + $BytesRead&quot;&amp;NewLine()&amp;&quot;&#xA;                If ($TotalBytesRead -eq $FileSize)&quot;&amp;NewLine()&amp;&quot;&#xA;                {&quot;&amp;NewLine()&amp;&quot;&#xA;                    $Last = $True&quot;&amp;NewLine()&amp;&quot;&#xA;                    $LastBuffer = New-Object System.Byte[]($BytesRead)&quot;&amp;NewLine()&amp;&quot;&#xA;                    [Array]::Copy($Buffer, 0, $LastBuffer, 0, $BytesRead)&quot;&amp;NewLine()&amp;&quot;&#xA;                }&quot;&amp;NewLine()&amp;&quot;&#xA;                If($First)&quot;&amp;NewLine()&amp;&quot;&#xA;                { &quot;&amp;NewLine()&amp;&quot;&#xA;                    #Create the File in Target&quot;&amp;NewLine()&amp;&quot;&#xA;                    $ContentStream = New-Object System.IO.MemoryStream&quot;&amp;NewLine()&amp;&quot;&#xA;                    $FileCreationInfo = New-Object Microsoft.SharePoint.Client.FileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;                    $FileCreationInfo.ContentStream = $ContentStream&quot;&amp;NewLine()&amp;&quot;&#xA;                    $FileCreationInfo.Url = $FileName&quot;&amp;NewLine()&amp;&quot;&#xA;                    $FileCreationInfo.Overwrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;                    $Upload = $Library.RootFolder.Files.Add($FileCreationInfo)&quot;&amp;NewLine()&amp;&quot;&#xA;                    $Ctx.Load($Upload)&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;                    #Start FIle upload by uploading the first slice&quot;&amp;NewLine()&amp;&quot;&#xA;                    $s = new-object System.IO.MemoryStream(, $Buffer)&quot;&amp;NewLine()&amp;&quot;&#xA;                    $BytesUploaded = $Upload.StartUpload($UploadId, $s)&quot;&amp;NewLine()&amp;&quot;&#xA;                    $Ctx.ExecuteQuery()&quot;&amp;NewLine()&amp;&quot;&#xA;                    $fileoffset = $BytesUploaded.Value&quot;&amp;NewLine()&amp;&quot;&#xA;                    $First = $False&quot;&amp;NewLine()&amp;&quot;&#xA;                } &quot;&amp;NewLine()&amp;&quot;&#xA;                Else&quot;&amp;NewLine()&amp;&quot;&#xA;                {&quot;&amp;NewLine()&amp;&quot;&#xA;                    #Get the File Reference&quot;&amp;NewLine()&amp;&quot;&#xA;                    $Upload = $ctx.Web.GetFileByServerRelativeUrl($Library.RootFolder.ServerRelativeUrl + [System.IO.Path]::AltDirectorySeparatorChar + $FileName);&quot;&amp;NewLine()&amp;&quot;&#xA;                    If($Last)&quot;&amp;NewLine()&amp;&quot;&#xA;                    {&quot;&amp;NewLine()&amp;&quot;&#xA;                        $s = [System.IO.MemoryStream]::new($LastBuffer)&quot;&amp;NewLine()&amp;&quot;&#xA;                        $Upload = $Upload.FinishUpload($UploadId, $fileoffset, $s)&quot;&amp;NewLine()&amp;&quot;&#xA;                        $Ctx.ExecuteQuery()&quot;&amp;NewLine()&amp;&quot;&#xA;                       &#xA;                    }&quot;&amp;NewLine()&amp;&quot;&#xA;                    Else&quot;&amp;NewLine()&amp;&quot;&#xA;                    {&quot;&amp;NewLine()&amp;&quot;&#xA;                        #Update fileoffset for the next slice&quot;&amp;NewLine()&amp;&quot;&#xA;                        $s = [System.IO.MemoryStream]::new($buffer)&quot;&amp;NewLine()&amp;&quot;&#xA;                        $BytesUploaded = $Upload.ContinueUpload($UploadId, $fileoffset, $s)&quot;&amp;NewLine()&amp;&quot;&#xA;                        $Ctx.ExecuteQuery()&quot;&amp;NewLine()&amp;&quot;&#xA;                        $fileoffset = $BytesUploaded.Value&quot;&amp;NewLine()&amp;&quot;&#xA;                    }&#xA;                }&#xA;            }&#xA;        }&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    Catch {&quot;&amp;NewLine()&amp;&quot;&#xA;        Write-Host $_.Exception.Message -ForegroundColor Red&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;    Finally {&quot;&amp;NewLine()&amp;&quot;&#xA;        If($Filestream -ne $null)&#xA;        {&quot;&amp;NewLine()&amp;&quot;&#xA;            $Filestream.Dispose()&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;    }&#xA;}&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;#Function to upload all files from a local folder to SharePoint Online Folder&quot;&amp;NewLine()&amp;&quot;&#xA;Function Upload-PnPFolder($LocalFolderPath, $TargetFolderURL)&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;    #Get All files and SubFolders from the local disk&quot;&amp;NewLine()&amp;&quot;&#xA;    $Files = Get-ChildItem -Path $LocalFolderPath -File&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;    #Ensure the target folder&quot;&amp;NewLine()&amp;&quot;&#xA;    Resolve-PnPFolder -SiteRelativePath $TargetFolderURL | Out-Null&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;    #Upload All files from the local folder to SharePoint Online Folder&quot;&amp;NewLine()&amp;&quot;&#xA;    ForEach ($File in $Files)&quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        if(($File.Length/1MB) -le 250){&quot;&amp;NewLine()&amp;&quot;&#xA;        Add-PnPFile -Path &quot;&amp;Chr(34)&amp;&quot;$($File.Directory)\$($File.Name)&quot;&amp;Chr(34)&amp;&quot; -Folder $TargetFolderURL -Values @{'Title' = $($File.Name)} | Out-Null&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;        else {&quot;&amp;NewLine()&amp;&quot;&#xA;        Upload-LargeFile -FilePath &quot;&amp;Chr(34)&amp;&quot;$($File.Directory)\$($File.Name)&quot;&amp;Chr(34)&amp;&quot; -LibraryName $LibraryName&quot;&amp;NewLine()&amp;&quot;&#xA;        Move-PnPFile -SiteRelativeUrl &quot;&amp;Chr(34)&amp;&quot;$Libraryurl/$($File.Name)&quot;&amp;Chr(34)&amp;&quot; -TargetUrl &quot;&amp;Chr(34)&amp;&quot;$TargetFolderURL/$($File.Name)&quot;&amp;Chr(34)&amp;&quot; -Force -Overwrite&quot;&amp;NewLine()&amp;&quot;&#xA;      }&#xA;}}&quot;&amp;NewLine()&amp;&quot;&#xA;#Call the function to upload the Root Folder&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -Url $SiteURL -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine()&amp;&quot;&#xA;$Ctx = Get-PnPContext&quot;&amp;NewLine()&amp;&quot;&#xA;Upload-PnPFolder -LocalFolderPath $LocalFolderPath -TargetFolderURL $TargetFolderURL&quot;&amp;NewLine()&amp;&quot;&#xA; &#xA;#Get all Folders from given source path&quot;&amp;NewLine()&amp;&quot;&#xA;Get-ChildItem -Path $LocalFolderPath -Recurse -Directory | ForEach-Object {&quot;&amp;NewLine()&amp;&quot;&#xA;    $FolderToUpload = ($TargetFolderURL+$_.FullName.Replace($LocalFolderPath,[string]::Empty)).Replace('\','/')&quot;&amp;NewLine()&amp;&quot;&#xA;    Upload-PnPFolder -LocalFolderPath $_.FullName -TargetFolderURL $FolderToUpload&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;" stage="Script" /></stage><stage stageid="f254ce21-3252-4c38-ab59-a86d142e0e2a" name="Script" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-180" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be7da743-2b4d-4bc5-80ec-50b211559c2e" name="SP_Site_URL" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><narrative>Link for site or subsite.</narrative><display x="-300" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ad6ff4f1-15dc-4257-a5e4-1473fb5b44a3" name="SP_Lib_Folder_Path" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-300" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a68e9c85-8961-4fab-bf1b-e02405de441f" name="Run PnP_Script" type="SubSheet"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="180" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>58ea7b52-4199-49d5-8766-206477047dac</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="ab601c5e-b099-44db-95d6-c1b804e3f4cb" name="Script Path" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-195" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0ef1472b-6dd3-4c60-9580-b24880da2c9d" name="Delete_Script" type="Action"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>4fcc3ec4-1478-41dd-893a-c48b6b10877b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="63a10bbc-278f-4736-9ea3-ddcab047379d" name="Generate_PnPScript" type="SubSheet"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="75" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload_largefiles&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>cadf7ef4-f6fe-4656-b124-039b9163acba</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="848702e0-ab9c-498f-a820-25317b2526c8" name="Input" type="Block"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-360" y="-30" w="120" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="17f09d19-b218-4776-a59f-cf36d9f2c41b" name="Output" type="Block"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-360" y="150" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4f2b6585-075a-42ce-a7c3-b634604dadae" name="Inhouse" type="Block"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-225" y="-30" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cadf7ef4-f6fe-4656-b124-039b9163acba" name="Check_Error" type="Decision"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="120" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c3c3d07a-da37-4ab0-a440-431b1a54ddf2</ontrue><onfalse>a68e9c85-8961-4fab-bf1b-e02405de441f</onfalse></stage><stage stageid="c3c3d07a-da37-4ab0-a440-431b1a54ddf2" name="Exception while creating  Script" type="Exception"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="195" y="120" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="58ea7b52-4199-49d5-8766-206477047dac" name="Check Process_Exist" type="Action"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="225" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>12c16acb-3154-4b58-b685-2d7f749d0acd</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="58656d36-f5ad-4207-a34e-4bd9c13f6218" name="Exists" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-150" y="60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12c16acb-3154-4b58-b685-2d7f749d0acd" name="ProcessExist?" type="Decision"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="285" /><decision expression="[Exists]=True" /><ontrue>56ac353a-e8e8-4a2d-af54-24ceb2e7b527</ontrue><onfalse>14c54889-28dc-4db5-b35b-99025bc0d76c</onfalse></stage><stage stageid="b298cc7f-73bc-434b-bd56-b6f39757535c" name="Temp_Retry" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-135" y="120" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="14c54889-28dc-4db5-b35b-99025bc0d76c" name="Anchor8" type="Anchor"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="105" y="285" w="10" h="10" /><onsuccess>caee59cd-c003-4abb-bb79-84fb63957576</onsuccess></stage><stage stageid="56ac353a-e8e8-4a2d-af54-24ceb2e7b527" name="Kill Process" type="Action"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="330" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>0ef1472b-6dd3-4c60-9580-b24880da2c9d</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="caee59cd-c003-4abb-bb79-84fb63957576" name="Anchor9" type="Anchor"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="105" y="390" w="10" h="10" /><onsuccess>0ef1472b-6dd3-4c60-9580-b24880da2c9d</onsuccess></stage><stage stageid="1fc5305b-e434-4c2f-8e2d-807f741931a3" name="Run_Status" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-195" y="60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc503c4d-d011-4599-b8b2-b58ba06b6c00" name="Error_Message" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-315" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5584b29d-7502-4aa3-a965-ecee37f34215" name="Unexpected exception recover" type="Recover"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="330" y="210" /><onsuccess>f302b8b5-39a8-4212-814c-a2abd8f0c7e0</onsuccess></stage><stage stageid="b5a0d3fc-9137-46db-8f29-094d74b59b3f" name="Unexpected Exception" type="Exception"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="480" y="210" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="c3d75dbf-fb6c-47ca-b561-511740a50311" name="Script_Loc" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-135" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f302b8b5-39a8-4212-814c-a2abd8f0c7e0" name="Delete_Script" type="Action"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="405" y="210" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b5a0d3fc-9137-46db-8f29-094d74b59b3f</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="29675409-5452-4bea-8828-5008361a4353" name="Validate Temp Script Path" type="SubSheet"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="0" y="-30" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>4cb72b26-bd9a-4720-abba-dae08cbbe9c3</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="374e2362-1e89-44b3-b216-bf49c5009c56" name="Remove / in URL" type="SubSheet"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><loginhibit /><display x="0" y="-75" /><inputs><input type="text" name="URL" friendlyname="URL" narrative="URL" expr="[SP_Lib_Folder_Path]" /></inputs><outputs><output type="text" name="URL" friendlyname="URL" narrative="URL" stage="SP_Lib_Folder_Path" /></outputs><onsuccess>29675409-5452-4bea-8828-5008361a4353</onsuccess><processid>0f7d7655-623c-4dfd-bf26-886a6c66a8fc</processid></stage><stage stageid="0ded529a-6be2-4b0a-8185-393a213fc2d9" name="FolderPath" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-300" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="815649be-c134-4cfa-a7e5-c6c8fa5af1cf" name="Library Name" type="Data"><subsheetid>b9490419-e858-4f7b-87b4-c9c117c025b7</subsheetid><display x="-300" y="105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d96b05ec-55d4-4251-acda-f426f38d4ee7" name="Export List to Excel by Columns" type="SubSheetInfo"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><narrative>Exports provided columns of given list to a xlsx  file</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="b54474e5-0e2e-4ca5-abc7-01202e113f39" name="Return Message" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-435" y="345" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1d74d9dd-a622-4ddd-9401-c0c378d3c848" name="Script" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-600" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7dfdda0c-d103-471b-a368-3588c62be490" name="SP_Site_URL" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-420" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7315c4d5-31e5-4b3b-9b35-8c9b20996318" name="Dest_Directory" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-420" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7ee90187-b8be-425c-8035-1c92e848a984" name="Standards" type="Note"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><narrative>Dest_Directory: destination directory where the file will be downloaded e.g. C:\Apps

Create_Dir:- To check if Directory is not there whether to create or not.

SP_List: name of the list to be exported.

Column_IDs: List of column IDs to be exported. Should be provided as text enclosed in apostrophe and separated by comma e.g. 'Title','Created By'

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)
XLSX File name: Filename of the xlsx where the list is to be exported

Note: Columns - "RowError, RowState,Table, ItemArray, HasError" are getting generated by default </narrative><display x="-525" y="-285" w="300" h="150" /></stage><stage stageid="1fe27ad9-1fbf-4d2f-af68-e99b2658cf80" name="Unexpected exception recover" type="Recover"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="180" y="-180" /><onsuccess>af9ae261-6a4a-4be0-8f6e-68a4ef69d189</onsuccess></stage><stage stageid="3bc72ee1-d4bc-4f8f-adcb-0da8ca462c18" name="Unexpected Exception" type="Exception"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="390" y="-180" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="0634e62e-a50c-4ee6-be9b-a2b844924e62" name="IsDirExist" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-600" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcfbeb12-1701-41e1-b0fb-ab70fda21233" name="Script Path" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-600" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="00f8437d-0dda-48c9-9b97-88151bff356b" name="Start" type="Start"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><preconditions><condition narrative="Dest_Directory: destination directory where the file will be downloaded e.g. C:\Apps" /><condition narrative="Create_Dir:- To check if Directory is not there whether to create or not." /><condition narrative="SP_List: name of the list to be exported." /><condition narrative="Column_IDs: List of column IDs to be exported. Should be provided as text enclosed in apostrophe and separated by comma e.g. 'Title','Created By'" /><condition narrative="SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" /><condition narrative="XLSX File name: Filename of the xlsx where the list is to be exported" /><condition narrative="Note: Columns - &quot;RowError, RowState,Table, ItemArray, HasError&quot; are getting generated by default " /></preconditions><display x="-165" y="-495" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_List" narrative="Name of Sharepoint list to be exported." stage="SP_List" /><input type="text" name="Destination" narrative="Folder Location to download(Ex:- C:\Apps\PID1)" stage="Dest_Directory" /><input type="flag" name="Create_Dir" narrative="If Dir is not there Bot to create?" stage="Create_Dir" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="ScriptLocation" /><input type="text" name="XLSX Filename" narrative="XLSX filename to export the list to" stage="XLSX Filename" /><input type="text" name="Columns" narrative="Columns to be exported provided as a text values separated by comma e.g. 'Title','Created Date'" stage="Columns" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>bdbdb4e6-4430-4fe7-ad88-bce235471a55</onsuccess></stage><stage stageid="61c5e2b3-4648-4a5d-9668-8b7451cf91b4" name="End" type="End"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="240" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="a4065bc6-3b2f-436a-a15b-86d4de014bf4" name="Build Script" type="Calculation"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="-240" /><onsuccess>0318f550-9646-4ed4-9a1a-c479e762f69d</onsuccess><calculation expression="&quot;Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force &quot;&amp;NewLine() &amp;&quot;Connect-PnPOnline -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34)  &amp; NewLine() &amp; &#xA;&quot;$listContent = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_List] &amp; Chr(34) &amp; &quot;-Fields &quot; &amp; [Columns] &amp;&quot;-Pagesize 500&quot;&amp; NewLine() &amp;&#xA;&quot;$columnsToRetrieve = &quot; &amp; [Columns] &amp; NewLine() &amp;&#xA;&#xA;&quot;$filePath =&quot;&amp;Chr(34) &amp; [Dest_Directory]&amp; &quot;\&quot; &amp; [XLSX Filename] &amp; Chr(34) &amp; NewLine() &amp; NewLine() &amp; &#xA; &#xA;&quot;If (Test-Path($filePath)) {&quot; &amp; NewLine() &amp;&#xA;&quot;Remove-Item $filePath&#xA;}&quot; &amp; NewLine() &amp; NewLine() &amp;&#xA;&quot;$dataTable = New-Object System.Data.DataTable&quot; &amp; NewLine() &amp;&#xA;&quot;foreach ($column in $columnsToRetrieve) {&quot; &amp; NewLine() &amp;&#xA;&quot;$dataTable.Columns.Add($column)&#xA;}&quot; &amp; NewLine() &amp; NewLine() &amp;&#xA;&quot;foreach ($item in $listContent) {&quot; &amp; NewLine() &amp;&#xA;&quot;$row = $dataTable.NewRow()&quot; &amp; NewLine() &amp;&#xA;&quot;foreach ($column in $columnsToRetrieve) {&quot; &amp; NewLine() &amp;&#xA;&quot;$row[$column] = $item[$column]&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot; &amp; NewLine() &amp;&#xA;&quot;$dataTable.Rows.Add($row)&#xA;}&quot; &amp; NewLine() &amp; NewLine() &amp;&#xA;&#xA;&quot;$dataTable | Export-Excel -Path $filePath -AutoSize&quot;" stage="Script" /></stage><stage stageid="74cf03e0-7809-43ad-9345-5bdc9bd38293" name="Run PnP_Script" type="SubSheet"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="-30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>cbbbcb96-087b-4be4-8de1-9433c42c6e14</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="3db7b73c-9b8f-40a6-9447-2beb9925d0d1" name="Delete_Script" type="Action"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="180" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>61c5e2b3-4648-4a5d-9668-8b7451cf91b4</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="0318f550-9646-4ed4-9a1a-c479e762f69d" name="Generate_PnPScript" type="SubSheet"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="-195" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_download&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>77c00a79-5dce-449e-a7e8-271f8df78a9b</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="77c00a79-5dce-449e-a7e8-271f8df78a9b" name="Check_Error" type="Decision"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="-150" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>aa0d2c2c-7805-46a6-8663-208d7da92ade</ontrue><onfalse>b81e2d9d-06f7-4b48-8f1a-557b7b2add88</onfalse></stage><stage stageid="aa0d2c2c-7805-46a6-8663-208d7da92ade" name="Exception while creating  Script" type="Exception"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="75" y="-150" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="cbbbcb96-087b-4be4-8de1-9433c42c6e14" name="Check Process_Exist" type="Action"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="15" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Process_Exists" /></outputs><onsuccess>0db5471c-78f9-4bed-abd8-3a03bf6212f4</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="0db5471c-78f9-4bed-abd8-3a03bf6212f4" name="ProcessExist?" type="Decision"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="60" /><decision expression="[Process_Exists]=True" /><ontrue>73806a91-f0cc-42ed-b0cb-1e65ead658af</ontrue><onfalse>8e36ca94-b1a9-4a79-bf30-8610742b6e87</onfalse></stage><stage stageid="8e36ca94-b1a9-4a79-bf30-8610742b6e87" name="Anchor8" type="Anchor"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-60" y="60" w="10" h="10" /><onsuccess>521f99ee-5ced-48ad-9d0f-958712cec0e6</onsuccess></stage><stage stageid="73806a91-f0cc-42ed-b0cb-1e65ead658af" name="Kill Process" type="Action"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-165" y="120" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" exp