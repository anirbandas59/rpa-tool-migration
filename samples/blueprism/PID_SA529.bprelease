alue" type="Code"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="45" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Range" expr="[Range]" /><input type="text" name="Value" expr="[Value]" /></inputs><outputs><output type="text" name="CellRef" stage="CellRef" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>46e5ee1b-e324-4030-9602-762c5bc9ce92</onsuccess><code><![CDATA[Dim excel, sheet As Object

Try

sheet = GetWorksheet(Handle, Workbook, Worksheet)
excel = sheet.Application

If Range="" Then
Message = "No Range provided"
Else
sheet.Activate
sheet.Range(Range).Find(What:=Value, LookIn:= _
-4163, LookAt:=1, SearchOrder:=1, SearchDirection:= _
1, MatchCase:=False,SearchFormat:=False).Activate
CellRef = excel.ActiveCell.Address

End If

Catch e As Exception
Message = "Value Not Found"
Finally
excel = Nothing
sheet = Nothing
End Try]]></code></stage><stage stageid="67dc3663-d0e3-4e4c-a3de-6a97011362f2" name="CellRef" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dc1c90b8-c2c7-47be-81cd-d6a9cff7aabf" name="Message" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="180" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9429d7db-e8e5-471a-94a6-4e857b3c0c74" name="Workbook" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e2363612-06ce-4e9b-b1b4-1c31a4740bb8" name="Worksheet" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fea023c4-598a-48fc-9921-4952456bacc9" name="Range" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="105" /><datatype>text</datatype><initialvalue xml:space="preserve">$A$1:$XFD$10</initialvalue><private /></stage><stage stageid="6f17e880-15d9-4ef6-8f3f-a47a33c43b65" name="Value" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" /><datatype>text</datatype><initialvalue xml:space="preserve">PTD Cost</initialvalue><private /><alwaysinit /></stage><stage stageid="ca28d18d-9af9-4640-be20-77910d992418" name="handle" type="Data"><subsheetid>8acac2f9-fcb7-4da8-bec4-c1fa3fafdc09</subsheetid><loginhibit onsuccess="true" /><display x="195" y="-60" w="90" h="30" /><font family="Tahoma" size="10" style="Regula