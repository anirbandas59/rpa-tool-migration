age="Workbook" /><input type="text" name="Worksheet" narrative="Mandatory : Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /><input type="text" name="Reference" narrative="Mandatory : Range - cell reference ex :(A1:B1) or Column name (ex;B1)" stage="Reference" /><input type="number" name="Red value" narrative="Mandatory : 0-255" stage="R value" /><input type="number" name="Green value" narrative="Mandatory : 0-255" stage="G Value" /><input type="number" name="Blue value" narrative="Mandatory : 0-255" stage="B Value" /><input type="number" name="Sort_Order" narrative="Mandatory : 1 for ascending order and 2 for descending order" stage="Sort_Order" /></inputs><onsuccess>d01908d9-3b32-4817-ac7e-d17d15ba9274</onsuccess></stage><stage stageid="75df32a8-c282-4c30-83d4-965c240a2803" name="End" type="End"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="d99dce38-a2ae-4857-90a5-4c8d3e286e76" name="Message" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8f292f2f-bf2f-42c1-8f2d-d0509127227a" name="Success" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="59669e4a-01bd-4e90-83c7-19027e625af8" name="Workbook" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="22541381-aed5-4822-b659-aa4de2cfc28a" name="Handle" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subshee