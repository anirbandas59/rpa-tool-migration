or message if unsuccessful" stage="" /></outputs><onsuccess>a1bcf8b5-d7c1-4031-9497-51b7a11ba90c</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="56adf2de-41e9-4316-8fbb-85b1eb650fb2" name="SP_List" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-285" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b5348a53-fbb1-4225-8ec9-5c2cfbfabc8e" name="Columns" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><display x="-405" y="-195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d934582f-e634-48ee-80d8-353c1f49fb7b" name="Script Template" type="Data"><subsheetid>289defa5-3183-4174-986a-353a199b1fb6</subsheetid><loginhibit /><display x="-405" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">$Columns = "__COLUMNS__"
$Columns = $Columns.Split(",")
$filePath = "__FILEPATH__"
$URL = "__URL__"
$listName =  "__LISTNAME__"
$query = "__QUERY__"
$pagesize = __PAGESIZE__
