End Try


]]></code></stage><stage stageid="4512119d-b89c-4de5-9892-a8d9230f8dd6" name="Paste Option" type="Data"><subsheetid>adc22c49-e651-481d-9a72-f9d30dbd6a4f</subsheetid><display x="-195" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff4d1f56-4258-409f-94ed-8f50243385a7" name="Worksheet" type="Data"><subsheetid>adc22c49-e651-481d-9a72-f9d30dbd6a4f</subsheetid><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1811f009-8cb2-4766-9459-08aba3c0d25f" name="Clear Range" type="SubSheetInfo"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="09a79a16-ceef-44aa-955a-a24aba14abd9" name="End" type="End"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="4d60fcae-cb65-4bfe-b5e5-f8fa2c929ea9" name="Handle" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8b43b5df-6ca1-40b7-aea0-1ea863c79041" name="Workbook" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a1a3feef-c149-463a-981f-50420a06580a" name="Start" type="Start"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><loginhibit /><preconditions><condition narrative="Range and worksheet name should be present" /></preconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" stage="Handle" /><input type="text" name="Workbook" stage="Workbook" /><input type="flag" name="Values Only" stage="Values Only" /><input type="text" name="worksheet name" stage="worksheet name" /><input type="text" name="range" stage="range" /></inputs><onsuccess>d2c704a1-6286-4ca0-938c-1430e9efc9a3</onsuccess></stage><stage stageid="dcc93795-7671-4d6e-a488-9b93ffffca79" name="Success" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-225" y="150" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d694fd0e-9b38-4bc4-8b73-3cde34d6d89b" name="Message" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-225" y="180" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d2c704a1-6286-4ca0-938c-1430e9efc9a3" name="Clear Contents" type="Code"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet Name" expr="[worksheet name]" /><input type="text" name="Range" expr="[range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>09a79a16-ceef-44aa-955a-a24aba14abd9</onsuccess><code><![CDATA[getinstance(Handle).Workbooks(Workbook).Worksheets(Worksheet_Name).Range(range).ClearContents
]]></code></stage><stage stageid="7e79a113-6e7c-4f46-9986-bba33b1d509c" name="Values Only" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="3c3854f1-6f19-4983-988e-ee0c07dd8dd5" name="Range" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="405" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3a614c37-3138-4134-a371-fca34d9388bd" name="Worksheet Name" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="390" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd6c51a5-63f9-4792-b2b0-a824f1ee5a99" name="range" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-210" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef0ea374-67e7-46bb-9398-47dcd3c4f3be" name="worksheet name" type="Data"><subsheetid>dc474627-3a2f-43c7-8036-cc2806647819</subsheetid><display x="-210" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9cde1ec6-307c-489f-9f91-5dd70545e2e1" name="Autofill Column" type="SubSheetInfo"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><narrative>Autofill Column using values selected from one cell/ two cells and fill till the given range.

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- First Selected Cell : Text : the cell reference of first selected cell
- Second Selected Cell : Text : the cell reference of second selected cell (If no second cell selected, imput same cell ref as first selected cell)
- To_CellReference : Text : the cell reference of last cell till where the values to be AutoFilled.

NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="-285" y="-165" w="300" h="180" /></stage><stage stageid="97458324-32ed-43d6-b666-100fab25b8b1" name="Start" type="Start"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><loginhibit /><display x="15" y="-150" /><inputs><input type="number" name="handle" narrative="handle of opened workbook" stage="handle" /><input type="text" name="First Selected Cell" narrative="Address of first cell selected in order to autofill" stage="selectedcellref1" /><input type="text" name="Second Selected Cell" narrative="Address of second cell selected in order to autofill(If first cell is enough, input first select cell address)" stage="selectedcellref2" /><input type="text" name="To_CellReference" narrative="Last Cell address till the values to be autofilled" stage="to_cellref" /></inputs><onsuccess>119e313b-b830-47e9-bcf2-898e4da3a2a3</onsuccess></stage><stage stageid="622c485b-5c2d-4422-9194-7814c52768a2" name="End" type="End"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="119e313b-b830-47e9-bcf2-898e4da3a2a3" name="Activate Workbook" type="SubSheet"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><loginhibit /><display x="15" y="-90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>2fdbea51-312f-4c56-8ef5-f100d14b0411</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="2fdbea51-312f-4c56-8ef5-f100d14b0411" name="Autofill values for given range in Column" type="Code"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><loginhibit /><narrative>FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range("A1").Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try</narrative><display x="15" y="0" w="150" h="30" /><inputs><input type="text" name="selectedcellref1" expr="[selectedcellref1]" /><input type="text" name="selectedcellref2" expr="[selectedcellref2]" /><input type="text" name="to_cellref" expr="[to_cellref]" /><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>622c485b-5c2d-4422-9194-7814c52768a2</onsuccess><code><![CDATA[
selectedcellref1 = Replace(selectedcellref1,"$","")
selectedcellref2 = Replace(selectedcellref2,"$","")
to_cellref = Replace(to_cellref,"$","")

If selectedcellref2 = "" Then
	selectedcellref2 = selectedcellref1
End If

If (selectedcellref2<>to_cellref AND selectedcellref1<>to_cellref) Then
	GetWorkbook(handle, "").ActiveSheet.Range(selectedcellref1,selectedcellref2).AutoFill(Destination:= GetWorkbook(handle, "").ActiveSheet.Range(selectedcellref1, to_cellref), Type:=0)
	'xlSheet1.Range(Col_Addr & "2:" & Col_Addr & "3").AutoFill(Destination:=xlSheet1.Range(Col_Addr & "2:" & Col_Addr & RowCount), Type:=0)
End If

]]></code></stage><stage stageid="1624ad41-a9a3-432b-b434-09e3b9030025" name="selectedcellref1" type="Data"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><display x="-285" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3c599323-3e03-4ee1-b9e2-ebe7c24f9d6b" name="to_cellref" type="Data"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><display x="-285" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e3ad57d0-1f3e-425d-ac8f-f143af215d7a" name="selectedcellref2" type="Data"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><display x="-285" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63a84a46-d8aa-4a2b-ab6e-6850ff5c045e" name="handle" type="Data"><subsheetid>1f62ffbf-15c8-4b7e-b0a0-72f6cfbbce48</subsheetid><display x="-285" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="64fb49b4-ab40-44cd-b867-7e8b3cac1fa9" name="Get Last Empty Cell of Column" type="SubSheetInfo"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><narrative>Get Last Empty Row of provided Column</narrative><display x="-240" y="-120" w="150" h="60" /></stage><stage stageid="93646c57-ceee-4e2d-8b8e-86eea3efb0c6" name="Start" type="Start"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="15" y="-165" /><inputs><input type="text" name="Excel File Path" narrative="Full excel file path" stage="Excel File Path" /><input type="text" name="Worksheet" narrative="Sheet Name" stage="Worksheet" /><input type="text" name="ColLtr" narrative="Column name (eg. J)" stage="ColLtr" /></inputs><onsuccess>5dc26b78-707c-4aef-b21d-305a4723c64e</onsuccess></stage><stage stageid="44975a7b-3959-4042-970c-8ecaf63b4cc6" name="End" type="End"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="lRow" narrative="Last empty row for provided column" stage="lRow" /></outputs></stage><stage stageid="31ce8f38-34fb-4538-b4a0-6b189a68853f" name="Get Last Empty Row1" type="Code"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="WorkBookPath" expr="[Excel File Path]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="ColLtr" expr="[ColLtr]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="number" name="lRow" stage="lRow" /></outputs><onsuccess>bbca0e18-1fe8-4f9a-a093-b0fbd3523587</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet As Object

Dim ColNo As Long

Try


xl = CreateObject("Excel.Application")
xlBook  = xl.Workbooks.Open(WorkBookPath)
xlSheet = xlBook.WorkSheets(Worksheet) 
xl.DisplayAlerts = False

xl.Visible = true

ColNo = xlSheet.Range(ColLtr & 1).Column

lRow = xlSheet.Cells(xlSheet.Rows.Count, ColNo).End(-4162).Row
lRow = lRow+1

'Next


'xlBook.save()
'xlBook.close()
'xl.DisplayAlerts = True
xl.Quit()
Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
	xlSheet = nothing
    xlBook = nothing
    xl = nothing
End Try

]]></code></stage><stage stageid="2421442b-6c49-4398-a71a-adb0cd400db7" name="lRow" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-210" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b3268007-ef99-4795-89b5-c9337985f0a5" name="Message" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-180" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="98842a77-4c0e-4939-89f8-53d691ca828c" name="Success" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-270" y="75" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="675d8716-1360-4b8a-a6b9-27572b184535" name="Excel File Path" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="-270" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="15a1e6db-6672-4a6e-814c-cdca1bcb16f6" name="Worksheet" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-210" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="03eb1af8-d7d6-4368-880c-233e44c56e82" name="ColLtr" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="-135" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1cca03e5-a2c7-4b20-9c67-8d2f55c70cc7" name="Parameters" type="Block"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-315" y="-75" w="240" h="105" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="ba9def66-909d-4483-8e0b-d90d01159919" name="Data Items" type="Block"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-315" y="45" w="210" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="e62a4d26-f28e-48b5-8a6b-2170129e7014" name="Get Last Empty Row" type="Block"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="-45" y="-75" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2a6645e1-8aa1-41f9-ad99-da1f183e1975" name="Throw : BE : Error in getting last empty row of column" type="Exception"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="330" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Business Exception" detail="&quot;Excels &gt;&gt; Get Last Empty Cell of Column &gt;&gt; Error in accessing File - &quot;&amp; [Excel File Path]&amp;&quot;, Please make sure this file is closed properly &amp; not accessed by anyone - skiping this run for now| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="54dc3da1-5247-4191-ac58-518dfe5f59c1" name="Recover" type="Recover"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="90" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>3128086e-7c58-4fde-a0d8-81edcb18c1ee</onsuccess></stage><stage stageid="f28d6111-949b-4174-9863-14c18f942e8e" name="Resume" type="Resume"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="135" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>e637d6c1-44a4-49d7-8d6a-ff5d37eff095</onsuccess></stage><stage stageid="213302c7-ff67-4204-961b-52379ec0b988" name="Count" type="Calculation"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="225" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>f28d6111-949b-4174-9863-14c18f942e8e</onsuccess><calculation expression="[Retry Count]+1" stage="Retry Count" /></stage><stage stageid="3128086e-7c58-4fde-a0d8-81edcb18c1ee" name="Retry?" type="Decision"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="225" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Retry Count]&lt;[Retry Limit] AND (Lower(ExceptionType())=&quot;system exception&quot; OR Lower(ExceptionType())=&quot;internal&quot;)" /><ontrue>213302c7-ff67-4204-961b-52379ec0b988</ontrue><onfalse>2a6645e1-8aa1-41f9-ad99-da1f183e1975</onfalse></stage><stage stageid="5dc26b78-707c-4aef-b21d-305a4723c64e" name="Anchor3" type="Anchor"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><loginhibit /><display x="15" y="-105" w="10" h="10" /><onsuccess>31ce8f38-34fb-4538-b4a0-6b189a68853f</onsuccess></stage><stage stageid="a2703028-e925-411b-8853-59ad0c97e8b6" name="Retry Limit" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-240" y="165" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="293b3046-0051-44e3-8996-ddbfd6903672" name="Retry Count" type="Data"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-255" y="195" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="e24482c7-6e24-44fa-9902-0c08da71637d" name="Configration " type="Block"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="-315" y="135" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="C0C0C0" /></stage><stage stageid="e637d6c1-44a4-49d7-8d6a-ff5d37eff095" name="Close all Excel Instances" type="Action"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="60" y="-105" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="&quot;EXCEL&quot;" /></inputs><onsuccess>5dc26b78-707c-4aef-b21d-305a4723c64e</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="bbca0e18-1fe8-4f9a-a093-b0fbd3523587" name="Close all Excel Instances" type="Action"><subsheetid>215f557e-6494-44d8-910c-39bd4b640257</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="&quot;EXCEL&quot;" /></inputs><onsuccess>44975a7b-3959-4042-970c-8ecaf63b4cc6</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="0f8db993-fa46-44d3-b710-e0931e8098ba" name="Copy selected range values" type="SubSheetInfo"><subsheetid>712ec9c0-58cc-4b9a-8ba2-422b7d624005</subsheetid><narrative>Copies cell value between the given range</narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="c2201947-e1ea-4765-902a-61e81865c706" name="Start" type="Start"><subsheetid>712ec9c0-58cc-4b9a-8ba2-422b7d624005</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-60" /><inputs><input type="number" name="handle " narrative="Handle" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /><input type="text" name="Start Cell" narrative="Start cell from where data has to be copied(eg: J8)" stage="Start Cell" /><input type="text" name="End Cell" narrative="Last cell till where data has to be copied(eg: P8)" stage="End Cell" /></inputs><onsuccess>a954ec36-1849-416c-8446-6448900e149a</onsuccess></stage><stage stageid="fe2179a8-2a2a-49f3-88b6-c40d9b6e77d3" name="End" type="End"><subsheetid>712ec9c0-58cc-4b9a-8ba2-422b7d624005</subsheetid