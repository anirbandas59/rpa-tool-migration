"Decision"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><display x="-15" y="15" /><decision expression="Trim([TimeOut]) = &quot;&quot;" /><ontrue>e36c0ea2-cf16-409b-8fd1-888f490eeb05</ontrue><onfalse>ccc68980-5c30-40fb-8938-57d1f00ced4c</onfalse></stage><stage stageid="ccc68980-5c30-40fb-8938-57d1f00ced4c" name="Utility_RunPowerShellScript_WithTimeOut::Run Script with TimeOut" type="Action"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><loginhibit onsuccess="true" /><display x="-120" y="15" /><inputs><input type="text" name="Application" friendlyname="Application" narrative="Application" expr="[Application_nm]" /><input type="text" name="Arguments" friendlyname="Arguments" narrative="Arguments for the Application" expr="[Script Path]" /><input type="number" name="Timeout" friendlyname="Timeout" narrative="Timeout" expr="ToNumber([TimeOut])" /></inputs><outputs><output type="text" name="Success_Message" friendlyname="Success_Message" narrative="Success_Message" stage="Return Message" /><output type="text" name="Error_Message" friendlyname="Error_Message" narrative="Error_Message" stage="Error_Message" /></outputs><onsuccess>c6da14c9-71d1-4d3c-ba4b-e2b8ec29d485</onsuccess><resource object="Utility_RunPowerShellScript_WithTimeOut" action="Run Script with TimeOut" /></stage><stage stageid="c6da14c9-71d1-4d3c-ba4b-e2b8ec29d485" name="Anchor31" type="Anchor"><subsheetid>563862fc-44d9-49eb-a5c5-46e6a0617a3c</subsheetid><loginhibit /><display x="-120" y="120" w="10" h="10" /><onsuccess>5a689a9a-c43b-4fc1-86a5-818c5673a04c</onsuccess></stage><stage stageid="cc9605b0-e0ac-4885-a6ec-264110d81466" name="Pass_Custom_Command" type="SubSheetInfo"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><narrative>You can now pass custom Sharepoit Commands with this action</narrative><display x="-210" y="-75" w="150" h="90" /></stage><stage stageid="a765ebbe-c323-4373-96fa-b104d0361691" name="Start" type="Start"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><preconditions><condition narrative="Ensure the commands are compatible with PowerShell before trying with this object in IDE" /></preconditions><display x="15" y="-150" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234" stage="SP_Site_URL" /><input type="text" name="Temp_Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="CustomCommand" narrative="Pass you command here for Sharepoint" stage="CustomCommand" /></inputs><onsuccess>9b9bac2f-a317-433c-a40b-516057eee792</onsuccess></stage><stage stageid="5938795f-6e90-449d-afbb-2fb2c1edf324" name="Build Script" type="Calculation"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="-15" /><onsuccess>5b11c3d7-3d07-4113-8b80-2e307700b5d2</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &#xA;&amp;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;[CustomCommand]&amp;NewLine()&#xA;&#xA;&#xA;&amp;&quot;}&quot;&#xA;&amp; NewLine() &amp; &quot;Catch { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="e9b6a940-a30a-4c51-b00a-63208593004d" name="Run PnP_Script" type="SubSheet"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Script_Path" friendlyname="Script_Path" narrative="Script Location" expr="[Script Path]" /><input type="text" name="Application" friendlyname="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /></inputs><outputs><output type="text" name="Run Report" friendlyname="Run Report" narrative="Return  run report From Power Shell" stage="" /><output type="text" name="Error_Message" friendlyname="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>9aa6af14-a60a-4d6c-9904-325548685f99</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="7e960f92-968e-4cfd-acfe-45d2700c207b" name="Delete_Script" type="Action"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>e483e2ab-b811-40c9-947c-823f9af8965e</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="e1071816-63a6-449b-a045-2b928ac4cd9a" name="Check_Error" type="Decision"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>91f60b19-9a38-4901-b78a-c38bfacf6d11</ontrue><onfalse>e9b6a940-a30a-4c51-b00a-63208593004d</onfalse></stage><stage stageid="91f60b19-9a38-4901-b78a-c38bfacf6d11" name="Exception while creating  Script" type="Exception"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="cb007954-cda2-4c7c-af3b-0fba84678142" name="Check Process_Exist" type="Action"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>4ac41b2f-50ad-426d-a74f-44ad17d350c0</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="4ac41b2f-50ad-426d-a74f-44ad17d350c0" name="ProcessExist?" type="Decision"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>fb3853e1-19f5-4d59-88ab-c9ca2e5d0720</ontrue><onfalse>7b2e36f0-51a9-431c-aba4-5b3484939f34</onfalse></stage><stage stageid="7b2e36f0-51a9-431c-aba4-5b3484939f34" name="Anchor8" type="Anchor"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="90" y="285" w="10" h="10" /><onsuccess>57df5bec-e78e-4b6c-9d04-06775401eb11</onsuccess></stage><stage stageid="fb3853e1-19f5-4d59-88ab-c9ca2e5d0720" name="Kill Process" type="Action"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="15" y="330" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>7e960f92-968e-4cfd-acfe-45d2700c207b</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="57df5bec-e78e-4b6c-9d04-06775401eb11" name="Anchor9" type="Anchor"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="90" y="390" w="10" h="10" /><onsuccess>7e960f92-968e-4cfd-acfe-45d2700c207b</onsuccess></stage><stage stageid="c6086d70-a97a-44f8-a651-e106d61b1681" name="SP_Site_URL" type="Data"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid><display x="-210" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="440189e1-3232-4fe5-8e13-01671f132e65" name="SP_Target_List" type="Data"><subsheetid>32e6ea8c-a054-4a7a-929d-02ba06267cda</subsheetid