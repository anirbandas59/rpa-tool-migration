rror?" type="Decision"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><loginhibit /><display x="30" y="135" /><decision expression="(InStr([Success_Message], &quot;403&quot;))&gt;0 AND (InStr(Lower([Success_Message]), &quot;forbidden&quot;))&gt;0" /><ontrue>b1106996-a50c-409b-8ab0-87dd5cb0eaf1</ontrue><onfalse>81e66c31-826d-4e63-a17e-d20ae2e6fb0f</onfalse></stage><stage stageid="b1106996-a50c-409b-8ab0-87dd5cb0eaf1" name="Anchor10" type="Anchor"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><loginhibit /><display x="120" y="135" w="10" h="10" /><onsuccess>fa31ed79-dc7c-4a53-8bff-e98e0c8a466e</onsuccess></stage><stage stageid="9f9d2f70-1604-40de-af90-5b1ad077ed43" name="End" type="End"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><display x="405" y="-60" /><outputs><output type="text" name="Success_Message" narrative="Success_Message" stage="Success_Message" /><output type="text" name="Error_Message" narrative="Error_Message" stage="Error_Message" /></outputs></stage><stage stageid="952441db-b2db-4483-b013-9515df03e7aa" name="Store" type="MultipleCalculation"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><loginhibit /><display x="30" y="0" /><onsuccess>e99405ee-10c7-467e-9961-6ff4fffd3fc6</onsuccess><steps><calculation expression="Left([Output], InStr([Output],&quot;___RPA___&quot;)-1)" stage="Success_Message" /><calculation expression="Mid([Output],InStr([Output],&quot;___RPA___&quot;)+9,Len([Output]))" stage="Error_Message" /></steps></stage><stage stageid="db63b6ab-db2b-4d58-a142-c6c342ae0c6b" name="Input" type="Block"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3c9787ae-bb9e-4898-bbab-e81dd74764e8" name="Output" type="Block"><subsheetid>dcba4fe5-1400-4ed7-a688-e91cbbbdd11c</subsheetid><loginhibit /><display x="-270" y="90" w="150" h="105" />