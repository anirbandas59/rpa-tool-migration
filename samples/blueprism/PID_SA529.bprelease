Next]]></code></stage><stage stageid="7c92face-955a-4e89-a825-f571d01aeb0d" name="Save Workbook" type="SubSheet"><subsheetid>5874a109-77d8-4bc1-82ca-2813173b4002</subsheetid><loginhibit /><display x="15" y="195" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be saved" expr="[Workbook]" /></inputs><onsuccess>7519f1a9-9c79-4b1e-b779-9994947a58af</onsuccess><processid>6e7cb0ad-5910-4065-aab2-2919726bae39</processid></stage><stage stageid="f73f80a7-9cbf-4545-b5b4-0a1248aff95a" name="Split Column values into different rows by demiliter" type="SubSheetInfo"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><narrative>Specified column values will be split and made as separate rows.
All other column's value in the sheet will be same for the new rows created
Ex:
Input:
ColA	ColB
1	123,456
2	789
---------------
Output:
ColA	ColB
1	123
1	456
2	789</narrative><display x="-390" y="30" w="210" h="240" /></stage><stage stageid="96a41902-46a5-4f0c-bcb0-2a350be0cde9" name="Start" type="Start"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><loginhibit /><display x="105" y="-15" /><inputs><input type="number" name="Handle" narrative="Handle created" stage="handle" /><input type="text" name="Work Book Name" narrative="Opened Work book name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work sheet name to access" stage="Worksheet" /><input type="text" name="Column Name" narrative="Letter of the column (Ex: A)" stage="Column Name" /><input type="text" name="Delimiting Character" narrative="Demiliting Character to split the column on" stage="Delimiter" /></inputs><onsuccess>9c0caaef-f02d-4b0d-900d-29d0b97a81b7</onsuccess></stage><stage stageid="d5474082-9e94-4a55-a1d9-cf6b7375f971" name="End" type="End"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><loginhibit /><display x="105" y="165" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /></outputs></stage><stage stageid="14e86d4c-aea7-4ea8-af50-6a6c88b65405" name="handle" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-165" y="-60" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef4b7f6a-c2a7-4d7c-9717-96f9749816c9" name="Workbook" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-165" y="-15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b41823a-1df8-4f35-bd1c-3b0e551d48a1" name="Worksheet" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-165" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f28a865a-4856-4b05-9c1a-6c8636cbc857" name="Column Name" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-165" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ba8582d-1fb6-4a1c-ac4c-4af0b946c2fd" name="Delimiter" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-165" y="120" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f2c7a53-566d-4ca5-941e-73230b8b0c07" name="Success" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-390" y="210" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="84601f90-c2e5-4c57-a294-b826d41516d6" name="Message" type="Data"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="-180" y="210" w="210" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c0caaef-f02d-4b0d-900d-29d0b97a81b7" name="Split and add as new rows" type="Code"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><display x="105" y="75" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="ColName" expr="[Column Name]" /><input type="text" name="Delimiter" expr="[Delimiter]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>d5474082-9e94-4a55-a1d9-cf6b7375f971</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object
Dim intCount As Integer
Dim Count As Integer
Dim Nextcell As Object
Dim Replace_Cell As Object
Dim Cellvalue As Object
Dim strarr() As String

Try
'xl = GetInstance(handle)
xlBook  = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = xlSheet1.Application

'Get row count
Dim RowCount = xlSheet1.UsedRange.Rows(xlSheet1.UsedRange.Rows.Count).Row

'Row Counetr
intCount = 2

'loop over column cells (not icluding the column names row - 1st row) 
While (intCount <= RowCount)
	Nextcell = ColName & intCount
	Cellvalue = xlSheet1.Range(Nextcell).value
	If  Cellvalue <> "" Then
         
		'split cell value if it contains the delimiter
		If Cellvalue.Contains(Delimiter) Then
			strarr = Cellvalue.Split(Delimiter)
			Count = 1

			'loop over values after splitting
			For Each s As String In strarr
				If Count = 1 Then
					'Replace the current cell with only one value - First value
					xlSheet1.Range(Nextcell).value = TRIM(s)
					Count = Count+1

				Else
					If (TRIM(s) <> "") Then
					'Copy the row, insert the new row and paste
						xlSheet1.Rows(intCount).Copy
						xlSheet1.Rows(intCount).Resize(1).Insert
						intCount = intCount+1
					'Replace the cell value with the next split value
						Replace_Cell = ColName & intCount
						xlSheet1.Range(Replace_Cell).value = TRIM(s)				
					End If	
					Count = Count+1
				End if
			Next
			'MessageBox.Show("Counter is currently: " + CStr(Cellvalue))
		End if
	End If

'Get updated row count
RowCount = xlSheet1.UsedRange.Rows(xlSheet1.UsedRange.Rows.Count).Row

'Increment row counter
intCount = intCount+1
      
End While

xlBook.Save()

Success = True
Catch e As Exception
	Success = False
	Message = e.Message
Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing
End Try]]></code></stage><stage stageid="7a1ba6d0-c2b5-4e50-858d-4175694155fe" name="Input parameters" type="Block"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><loginhibit /><display x="-270" y="-90" w="210" h="240" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="64156043-86f4-44d8-81c2-52535e6a8336" name="Output Parameters" type="Block"><subsheetid>358f60c5-5d65-4bb4-b2ec-a1a665d90a70</subsheetid><loginhibit /><display x="-495" y="165" w="435" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="e6275e92-20bc-4f31-abdb-1111474d168e" name="Format Entire Column" type="SubSheetInfo"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><narrative>Format the entire column with the required format

</narrative><display x="-360" y="-105" w="210" h="90" /></stage><stage stageid="d2250eb0-990c-46da-98e8-dda02ec48366" name="Format entire column" type="Code"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="105" y="-15" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Colname" expr="[Column Name]" /><input type="text" name="Format" expr="[Format]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>82fc0653-4eec-4fc5-a997-e4872bd7f698</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try
'xl = GetInstance(handle)
xlBook  = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = xlSheet1.Application

'format entire column
xlSheet1.Range(Colname + ":" + Colname).NumberFormat = Format

Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="48da1d4a-ca67-4a1d-acf7-e1ba48f5f0b0" name="Start" type="Start"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><loginhibit /><display x="105" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle created" stage="handle" /><input type="text" name="Work Book Name" narrative="Opened Work book name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work sheet name to access" stage="Worksheet" /><input type="text" name="Column Name" narrative="Letter of the column (Ex: A)" stage="Column Name" /><input type="text" name="Format" narrative="Format type required" stage="Format" /></inputs><onsuccess>d2250eb0-990c-46da-98e8-dda02ec48366</onsuccess></stage><stage stageid="82fc0653-4eec-4fc5-a997-e4872bd7f698" name="End" type="End"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><loginhibit /><display x="105" y="75" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /></outputs></stage><stage stageid="97add03c-5236-4648-9ae3-deecfc613997" name="handle" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-135" y="-105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f7dcb4b-fccd-4dde-ba28-81725061a31c" name="Workbook" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-135" y="-60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="19d2e0af-bd62-4608-aa09-e0bf891e4217" name="Worksheet" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-135" y="-15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="798480a4-3c31-426e-af20-99941b3c50bb" name="Column Name" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-135" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa18aa53-babc-49a8-bfaa-305e9d855473" name="Format" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-135" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf9f83e5-5632-4db1-b0e6-1344bb4c3335" name="Success" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-360" y="0" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7863567f-880b-499b-a0de-987b6473996f" name="Message" type="Data"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><display x="-360" y="60" w="180" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="60a576fd-44bd-4ec9-b143-bcf5cb0cbeb3" name="Input parameters" type="Block"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><loginhibit /><display x="-240" y="-135" w="210" h="240" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="f1b2d448-0aac-4d1c-8027-46889f5cc590" name="Output Parameters" type="Block"><subsheetid>46fb7f3f-26fb-43b9-923f-5cfe51f25faf</subsheetid><loginhibit /><display x="-465" y="-45" w="210" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="bbd965b1-1de1-423b-ab80-42a424252e52" name="Get Column Letter" type="SubSheetInfo"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><narrative>Code stage returns the column letter for the cell with the given value</narrative><display x="-165" y="-120" w="420" h="90" /></stage><stage stageid="384323fe-c2fd-4d97-ae4a-23d4ec23bd39" name="Get Column Letter for given value" type="Code"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="180" y="-30" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="ColValue" expr="[Column Value]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="Column Letter" stage="Column Letter" /></outputs><onsuccess>9f55dbef-2115-4baf-8b9f-2af01b8c32f8</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try
'xl = GetInstance(handle)
xlBook  = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = xlSheet1.Application

'Get column address
Dim Col_Count = xl.Match(ColValue, xlBook.Sheets(Worksheet).Range("1:1"), 0)
Column_Letter = Replace(xlSheet1.Cells(1, Col_Count).Address(False, False), "1", "")

Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="ad48b68e-011a-46a4-b484-b360b6295d7e" name="Start" type="Start"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><loginhibit /><display x="180" y="-120" /><inputs><input type="number" name="Handle" stage="handle" /><input type="text" name="Work Book Name" stage="Workbook" /><input type="text" name="Work Sheet Name" stage="Worksheet" /><input type="text" name="Column Name" stage="Column Value" /></inputs><onsuccess>384323fe-c2fd-4d97-ae4a-23d4ec23bd39</onsuccess></stage><stage stageid="e7bcace1-ed14-4536-9a2f-3e39856da64a" name="handle" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-60" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b168f8af-0e94-422f-8ab2-f259a4b78103" name="Workbook" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-60" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a2b0417f-ea9b-4262-96d4-cd8c8dbbdbb7" name="Worksheet" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-60" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8ae9aede-dad0-44ad-8959-b35794b1596c" name="Column Value" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-60" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b002a773-e121-425f-a111-a8de23f38dff" name="Success" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-285" y="-15" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8f1380d0-1eef-4a20-a68a-86428ebc45d3" name="Message" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-285" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a2f5e20a-9868-416a-9036-62ca48feb921" name="Input parameters" type="Block"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><loginhibit /><display x="-165" y="-60" w="210" h="195" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="07b69a88-3ef6-4f95-ae6e-d6ed35e346c3" name="Output Parameters" type="Block"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><loginhibit /><display x="-390" y="-60" w="210" h="165" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="9f55dbef-2115-4baf-8b9f-2af01b8c32f8" name="End" type="End"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><loginhibit /><display x="180" y="60" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /><output type="text" name="Column Letter" narrative="Name of the column (Letter/ text) " stage="Column Letter" /></outputs></stage><stage stageid="f4b7b051-04c8-4cbb-b49f-03484619aa1c" name="Column Letter" type="Data"><subsheetid>fd501d94-1802-40c9-ae23-d9e3fd8b201b</subsheetid><display x="-285" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8c81b5ec-2aa7-42d9-a4c2-d25e0dd208aa" name="Add Column at Position" type="SubSheetInfo"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><narrative>This Page will Add a new column to the specified position.
Column A is position 1, so if you want to add column at 3rd position which is C , Pass position as 3.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b5211592-bde5-4360-b45f-063639469cf7" name="Start" type="Start"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><loginhibit /><display x="0" y="-105" /><inputs><input type="text" name="workbook" stage="workbook" /><input type="text" name="worksheet" stage="worksheet" /><input type="number" name="handle" stage="handle" /><input type="number" name="position" stage="position" /></inputs><onsuccess>5a89b982-60db-4475-a49e-c49f9700e58b</onsuccess></stage><stage stageid="407f042b-a2ec-4d71-ade5-b74a59239a62" name="End" type="End"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><loginhibit /><display x="0" y="165" /></stage><stage stageid="5a89b982-60db-4475-a49e-c49f9700e58b" name="Add Columns at position" type="Code"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><loginhibit /><display x="0" y="15" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="number" name="position" expr="[position]" /></inputs><onsuccess>407f042b-a2ec-4d71-ade5-b74a59239a62</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).Sheets(worksheet).cells(1,position).EntireColumn.Insert]]></code></stage><stage stageid="1edbed15-73e4-484b-b58c-6c4f6f7d51a2" name="workbook" type="Data"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><display x="-330" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd6c4ad0-2e5b-4475-9003-39280e752dff" name="worksheet" type="Data"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3309544f-9e04-4ca1-b4e6-2a140295d0fb" name="handle" type="Data"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><display x="-255" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38fa7a9a-b970-4be0-9eeb-643275eb6fd3" name="position" type="Data"><subsheetid>4c62c42c-f139-45c3-b087-4081e2acd2c8</subsheetid><display x="-255" y="135" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b7f813ef-0068-4cda-b17e-31757266fae8" name="Get Column Position W.r.t Cell Reference" type="SubSheetInfo"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><narrative>Get Column Position from the Text to be searched With Respect To the Cell Reference</narrative><display x="-255" y="-120" w="150" h="90" /></stage><stage stageid="d704913a-bf9f-4c0a-a32d-f3a84fbdc0f2" name="Start" type="Start"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /><input type="number" name="handle" narrative="handle of open excel" stage="handle" /><input type="text" name="Worksheet" narrative="Name of worksheet" stage="Worksheet" /><input type="text" name="TextToFind" narrative="TextToFind" stage="TextToFind" /><input type="text" name="Cell_Reference" narrative="Cell_Reference" stage="Cell_Reference" /></inputs><onsuccess>4ddd51f0-2297-4b43-91cb-7bc9670c01aa</onsuccess></stage><stage stageid="5e912121-5d84-40ae-b2f6-75f61e8cad2e" name="End" type="End"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="15" y="180" /><outputs><output type="number" name="ColumnPosition" narrative="Position of the Column" stage="ColumnPosition" /></outputs></stage><stage stageid="7211c16c-c97b-4628-b9ab-5357b3989100" name="Inputs" type="Block"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="-345" y="-60" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cc4997ed-0656-4360-8460-4b36a1840017" name="Outputs" type="Block"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="-345" y="75" w="240" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7af13556-1a92-4b02-9ac9-ed199c9905a7" name="Get Cell Value" type="Block"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="-60" y="-15" w="195" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4ddd51f0-2297-4b43-91cb-7bc9670c01aa" name="Get Col Position w.r.t Cell Reference" type="Code"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="15" y="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="TextToFind" expr="[TextToFind]" /><input type="text" name="Cell Reference" expr="[Cell_Reference]" /></inputs><outputs><output type="number" name="ColumnPosition" stage="ColumnPosition" /></outputs><onsuccess>5e912121-5d84-40ae-b2f6-75f61e8cad2e</onsuccess><code><![CDATA[

Dim wb, ws As Object
Dim excel, sheet, range As Object

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Cell_Reference)
Try
ColumnPosition=range.Find(What:= TextToFind, _
                  LookIn:=-4123, _
                  LookAt:=1, _
				  SearchOrder:=1, _
			      SearchDirection:=1, _
				  MatchCase:=True, _
				  SearchFormat:=False).Column
      range.Select()

Catch e As Exception
                
				ColumnPosition=0
Finally
                wb = Nothing
                ws = Nothing
                excel = Nothing
                sheet = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="c9613174-1877-4596-b9c2-d47e57cf6f37" name="Workbook" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-225" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7cae513f-90f9-4a76-80be-a4de70bb9aee" name="Worksheet" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-285" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="03918936-2b18-4c21-b4e3-1ca80e7f87da" name="handle" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-165" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a64817b3-be31-438b-8288-f8abba22a875" name="ColumnPosition" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-225" y="105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5c67ddf4-b26f-48ab-860b-628d00e0bcf2" name="TextToFind" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-225" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cee0e6b8-12b3-4c65-860d-04724ab03d6e" name="Throw : SE : Error in getting Column Text from Number" type="Exception"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="195" y="45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in getting Column Number from Text | (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="a4b5ab33-3d2c-4889-8658-ff07607acadf" name="Recover2" type="Recover"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>cee0e6b8-12b3-4c65-860d-04724ab03d6e</onsuccess></stage><stage stageid="3c334d1a-b7c7-4cab-a28e-19b5ca58f7cb" name="Cell_Reference" type="Data"><subsheetid>fc5a2308-a07d-4a36-9bbb-c3698e92e6a4</subsheetid><display x="-165" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b996d5f9-9adb-4452-9757-003f1e0e99e6" name="Convert Text to Column" type="SubSheetInfo"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><narrative>This Page converts the  format as Text to Column for a specified Column Range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="309ce431-c10a-49ae-a234-d38ff1799d5d" name="Start" type="Start"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><loginhibit /><display x="135" y="-90" /><inputs><input type="text" name="workbook" stage="workbook" /><input type="text" name="worksheet" stage="worksheet" /><input type="number" name="handle" stage="handle" /><input type="number" name="position" stage="position" /></inputs><onsuccess>3d54ed57-4a8e-488c-9fb8-0cb66f7eb70f</onsuccess></stage><stage stageid="16ef547f-4709-4f8d-b0ce-7b71544fafd3" name="End" type="End"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><loginhibit /><display x="135" y="180" /></stage><stage stageid="3d54ed57-4a8e-488c-9fb8-0cb66f7eb70f" name="Convert Text to Column1" type="Code"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><loginhibit /><display x="135" y="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="number" name="position" expr="[position]" /></inputs><onsuccess>16ef547f-4709-4f8d-b0ce-7b71544fafd3</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet As Object

'Const xlTextQualifierDoubleQuote = 1

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with Sheet
.Columns(position).TextToColumns( _
        Destination:=.Cells(1,2), _
        DataType:= 1, _
        TextQualifier:=1, _
        ConsecutiveDelimiter:=False)
        'TAB:=False, _
        'Semicolon:=False, _
        'Comma:=False, _
        'Space:=True, _
        'Other:=False, _
        'TrailingMinusNumbers:=False)

End with

]]></code></stage><stage stageid="cf023f9d-88d7-4152-aac2-7f2fb541734a" name="workbook" type="Data"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><display x="-195" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="443f41d6-adb1-43fc-8243-3cb9af41a9b5" name="worksheet" type="Data"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><display x="-60" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2fd28553-4b32-439c-b7f0-2e06fa8c0ed9" name="handle" type="Data"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><display x="-120" y="105" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0eb8c7b4-b1b0-43e5-b57c-f530264b9b02" name="position" type="Data"><subsheetid>e967adb1-57d3-4e9b-890a-dce0e6625027</subsheetid><display x="30" y="105" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f2d9609-1d4e-450a-aa44-6b7988a4ed6a" name="Custom Sort for 2 Columns" type="SubSheetInfo"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><narrative>This Page is designed to Sort Excel data for Two columns.
Fo Eg: Column A , sort A to Z
Column B Sort Z to A , at once and not seperately.

For Ascending SortType=1 and Descending = 2</narrative><display x="-195" y="-180" w="150" h="90" /></stage><stage stageid="e1d66ba7-8ce8-4d53-bf1d-6305e4bd15af" name="Start" type="Start"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-45" /><inputs><input type="number" name="handle " narrative="handle " stage="handle" /><input type="text" name="Workbook name" narrative="Workbook name" stage="Workbook Name" /><input type="text" name="Worksheet name" narrative="Worksheet name" stage="worksheet name" /><input type="text" name="Column1Range" narrative="Range for Column 1" stage="Column1Range" /><input type="text" name="Column2Range" narrative="Range for Column 2" stage="Column2Range" /><input type="text" name="SheetRange" narrative="Reference of the Range(A1 for whole sheet)" stage="SortRange" /><input type="number" name="SortTypeCol1" narrative="Sort Type : For Ascending=1, Descending = 2" stage="SortTypeCol1" /><input type="number" name="SortTypeCol2" narrative="Sort Type : For Ascending=1, Descending = 2" stage="SortTypeCol2" /></inputs><onsuccess>c72c2270-91ed-4e8b-a368-7cf6033061e3</onsuccess></stage><stage stageid="c3893fc7-ce1a-458a-9c18-e373a03563ad" name="End" type="End"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><display x="15" y="75" /></stage><stage stageid="bbb5a050-99d8-407f-96b4-1f6cf6beac35" name="handle" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="-75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa627da2-552a-40f2-b134-708175bec886" name="Workbook Name" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="-45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="abb3e43d-d907-456e-87fc-843e9dbcdb4b" name="worksheet name" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><display x="-195" y="-15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c72c2270-91ed-4e8b-a368-7cf6033061e3" name="Sort 2 columns" type="Code"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><display x="15" y="15" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="RangeCol1" expr="[Column1Range]" /><input type="text" name="RangeCol2" expr="[Column2Range]" /><input type="text" name="SortRange" expr="[SortRange]" /><input type="number" name="SortTypeCol1" expr="[SortTypeCol1]" /><input type="number" name="SortTypeCol2" expr="[SortTypeCol2]" /></inputs><onsuccess>c3893fc7-ce1a-458a-9c18-e373a03563ad</onsuccess><code><![CDATA[
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort.SortFields.clear
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort.SortFields.Add (Key:=getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(RangeCol1), SortOn:=0, Order:=SortTypeCol1, DataOption:=0)
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort.SortFields.Add (Key:=getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(RangeCol2), SortOn:=0, Order:=SortTypeCol2, DataOption:=0)
   With getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort
    .SetRange (getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(SortRange))
      .Header = 1
        .MatchCase = False
        .Orientation = 1
        .SortMethod = 1
      .Apply
    End With




]]></code></stage><stage stageid="e644e56b-3a0d-42bb-bae1-472b2ae52007" name="SortRange" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="135" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ed5e1f1d-b17e-4d2c-bf9f-f12aa26b041e" name="SortTypeCol1" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef4913a4-2a99-4e6a-b5cf-152f1be3825b" name="SortTypeCol2" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8930606f-1bbd-4269-a345-e9e1e5679093" name="Column1Range" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2baef64a-8077-418e-9554-498c1f5a88bc" name="Column2Range" type="Data"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="-195" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e6b34bbb-8d9b-4f27-8699-4ecf9e03c1cc" name="Block2" type="Block"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><display x="-45" y="-15" w="195" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="521e0f54-7403-439a-b819-d371e197ab62" name="Recover" type="Recover"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="105" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>3aaefd8f-e7bc-4c04-9f8f-2634e4edab58</onsuccess></stage><stage stageid="3aaefd8f-e7bc-4c04-9f8f-2634e4edab58" name="Throw : SE : Error in Sorting" type="Exception"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><display x="225" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Sorting| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="43f57761-5925-428e-bbac-f5aa75f5ae3a" name="Input" type="Block"><subsheetid>b12514a5-38ee-4d5e-929a-05393ea66470</subsheetid><loginhibit /><display x="-270" y="-105" w="165" h="270" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="bf78dff7-845c-49d9-8cef-b687d515be49" name="Delimit Date" type="SubSheetInfo"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><narrative>This Page converts the  format as Text to Column for a specified Column Range 
Delimiting Sortformat : 1=General, 2=Text, 3=MDY, 4=DMY, 5=YMD, 6=MYD, 7=DYM, 8=YDM, 9=ColumnNotParsed, 10=EMD where M=Month D=Date Y=year</narrative><display x="-195" y="-120" w="180" h="120" /></stage><stage stageid="5d351c6f-ec9b-4c48-9f03-8055ad4632f4" name="Start" type="Start"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><loginhibit /><narrative>Delimiting Sortformat : 1=General, 2=Text, 3=MDY, 4=DMY, 5=YMD, 6=MYD, 7=DYM, 8=YDM, 9=ColumnNotParsed, 10=EMD where M=Month D=Date Y=year</narrative><display x="45" y="-75" /><inputs><input type="text" name="workbook" narrative="workbook" stage="workbook" /><input type="text" name="worksheet" narrative="worksheet" stage="worksheet" /><input type="number" name="handle" narrative="handle" stage="handle" /><input type="number" name="position" narrative="Column Position(A=1)" stage="position" /><input type="text" name="Column" narrative="Column Letter(A,B)" stage="Column" /><input type="number" name="SortFormat" narrative="Delimiting format : 1=General, 2=Text, 3=MDY, 4=DMY, 5=YMD, 6=MYD, 7=DYM, 8=YDM, 9=ColumnNotParsed, 10=EMD where M=Month D=Date Y=year" stage="SortFormat" /></inputs><onsuccess>2122e9c6-0627-408f-b081-524760072153</onsuccess></stage><stage stageid="ccaef6a2-bb0d-486a-8cb5-2082d2d6fbef" name="End" type="End"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><loginhibit /><display x="45" y="45" /></stage><stage stageid="2122e9c6-0627-408f-b081-524760072153" name="Delimited Date" type="Code"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><loginhibit /><display x="45" y="-15" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[worksheet]" /><input type="number" name="position" expr="[position]" /><input type="text" name="Column" expr="[Column]&amp;1" /><input type="number" name="SortFormat" expr="[SortFormat]" /></inputs><onsuccess>ccaef6a2-bb0d-486a-8cb5-2082d2d6fbef</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, sheet As Object
Dim i As integer
i=Convert.ToInt32(SortFormat)

wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

with sheet
.Columns(position).TextToColumns( _
        Destination:=.Range(Column), _
        DataType:=1, _
        TextQualifier:=1, _
        ConsecutiveDelimiter:=False, _
        TAB:=False, _ 
        Semicolon:=False, _
        Comma:=False, _
        Space:=False, _
        Other:=False, _
        FieldInfo:={1,i}, _
        TrailingMinusNumbers:=True)
End With





]]></code></stage><stage stageid="4d78835a-b5ec-48a0-87c1-36fd67e04fe7" name="workbook" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fca4b146-71cc-4e49-8aaf-d19f3c983132" name="worksheet" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="58137c5c-7254-40a9-b619-83c4c35bd3c0" name="handle" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="acca7087-ef2b-47f5-81f3-edbc6560ac9e" name="position" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3d38fba7-6e78-47b3-8f55-d52e5f1b9f13" name="Column" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="135" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="873e501c-1c08-489d-9927-db2d2d0d06bb" name="SortFormat" type="Data"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="-195" y="105" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7f44adae-0e1a-4d85-a40b-497ba932c416" name="Recover" type="Recover"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="135" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>ddf6e907-c053-4c97-be84-d794d6c9949b</onsuccess></stage><stage stageid="ddf6e907-c053-4c97-be84-d794d6c9949b" name="Throw : SE : Error in Delimiting Date" type="Exception"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><display x="255" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Delimiting Date| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="a41e7f96-d4fe-496f-b97c-973080f8ed70" name="Block3" type="Block"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><loginhibit /><display x="-15" y="-45" w="210" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="eca7277b-8bd3-45b9-b105-cc774ed1dd05" name="Input" type="Block"><subsheetid>72d05e8a-1625-4d8c-9a80-67e605cfc98c</subsheetid><loginhibit /><display x="-270" y="-45" w="165" h="210" /><font family="Segoe UI" size="10" style="Regular" color="FF99CC" /></stage><stage stageid="deb3d491-1207-4bdc-8108-e71e9e63084b" name="Add Borders" type="SubSheetInfo"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><narrative>Add border lines (All 8 borders) for the given cell range</narrative><display x="-210" y="-165" w="150" h="90" /></stage><stage stageid="a41a0d5b-f734-4486-b68b-5a0cf2a38fea" name="End" type="End"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="39c7385c-65d2-4e71-b844-d083acf2e595" name="Add Borders" type="Code"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><narrative>Add border lines (All 8 borders) for the given cell range</narrative><display x="15" y="-15" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[Sheetname]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /><input type="flag" name="DiagonalDown" expr="[DiagonalDown]" /><input type="flag" name="DiagonalUp" expr="[DiagonalUp]" /><input type="flag" name="EdgeBottom" expr="[EdgeBottom]" /><input type="flag" name="EdgeLeft" expr="[EdgeLeft]" /><input type="flag" name="EdgeRight" expr="[EdgeRight]" /><input type="flag" name="EdgeTop" expr="[EdgeTop]" /><input type="flag" name="InsideHorizontal" expr="[InsideHorizontal]" /><input type="flag" name="InsideVertical" expr="[InsideVertical]" /></inputs><onsuccess>a41a0d5b-f734-4486-b68b-5a0cf2a38fea</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, xlsheet1 As Object
wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
xlsheet1 = excel.ActiveSheet

'Borders
If(DiagonalDown) Then
xlSheet1.Range(Cell_Range).Borders(5).LineStyle = 1
End If
If(DiagonalUp) Then
xlSheet1.Range(Cell_Range).Borders(6).LineStyle = 1
End If
If(EdgeLeft) Then
xlSheet1.Range(Cell_Range).Borders(7).LineStyle = 1
End If
If(EdgeTop) Then
xlSheet1.Range(Cell_Range).Borders(8).LineStyle = 1
End If
If(EdgeBottom) Then
xlSheet1.Range(Cell_Range).Borders(9).LineStyle = 1
End If
If(EdgeRight) Then
xlSheet1.Range(Cell_Range).Borders(10).LineStyle = 1
End If
If(InsideVertical) Then
xlSheet1.Range(Cell_Range).Borders(11).LineStyle = 1
End If
If(InsideHorizontal) Then
xlSheet1.Range(Cell_Range).Borders(12).LineStyle = 1
End If
]]></code></stage><stage stageid="9805754f-f507-4134-8d26-e0a3f9df882d" name="Start" type="Start"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><narrative>Add border lines (All 8 borders) for the given cell range</narrative><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="Worksheet" narrative="WorkSheet Name" stage="Sheetname" /><input type="text" name="workbook" narrative="workbook Name" stage="workbook" /><input type="flag" name="InsideHorizontal" narrative="If True adds Border InsideHorizontal Cells when muliple cells Selected" stage="InsideHorizontal" /><input type="flag" name="InsideVertical" narrative="If True adds Border InsideVertcal Cells when muliple cells Selected" stage="InsideVertical" /><input type="flag" name="DiagonalDown" narrative="If True adds Diagonal Down Border for selected cells (/)" stage="DiagonalDown" /><input type="flag" name="DiagonalUp" narrative="If True adds Diagonal UpBorder for selected cells (\)" stage="DiagonalUp" /><input type="flag" name="EdgeBottom" narrative="If True Adds Border to the bottom of selected cells" stage="EdgeBottom" /><input type="flag" name="EdgeLeft" narrative="If True Adds Border to the Left of selected cells" stage="EdgeLeft" /><input type="flag" name="EdgeRight" narrative="If True Adds Border to the Right of selected cells" stage="EdgeRight" /><input type="flag" name="EdgeTop" narrative="If True Adds Border to the Top of selected cells" stage="EdgeTop" /><input type="text" name="Range" narrative="Range of cells  to apply  (Ex: A1:L10) add borders to A1 until L10" stage="Cell Range" /></inputs><onsuccess>39c7385c-65d2-4e71-b844-d083acf2e595</onsuccess></stage><stage stageid="df4a63bd-5f22-4789-83c5-d9c2e5f9d52a" name="DiagonalDown" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="60" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="2673967e-deb3-4b5e-81d4-616570499797" name="DiagonalUp" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="90" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="2a52c5be-13f2-4804-b984-2a61bf43c756" name="Cell Range" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="08a93a88-55b6-488d-adbf-98ab6a42cf70" name="EdgeLeft" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="120" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="331cc196-eb78-493f-8436-b9ae57c64661" name="EdgeTop" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="150" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="2090534b-ea5a-4f4d-9afc-207b66bc9a6a" name="EdgeBottom" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="180" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="d7a3bde4-0655-4f91-a2c7-323e65d24542" name="EdgeRight" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="210" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="48023ac6-8dc5-44ae-833b-be8faedfccce" name="InsideVertical" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="240" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="bf8de2f9-dbf5-47a0-a485-63c6703f8f5f" name="InsideHorizontal" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-195" y="270" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="0217efa2-c698-4083-9998-af50aada2200" name="Sheetname" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67c02f27-8d0d-46f1-94b2-5603c7856109" name="handle" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><display x="-195" y="-60" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="46957f61-bf52-4bc8-b112-ead1dd4c575a" name="workbook" type="Data"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b34c498d-f0da-4d2d-b6e8-7a2c0626de99" name="Recover" type="Recover"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><display x="120" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>3c2f6db7-7a36-4c8e-a9dc-13e0dc2204d2</onsuccess></stage><stage stageid="3c2f6db7-7a36-4c8e-a9dc-13e0dc2204d2" name="Throw : SE" type="Exception"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><display x="240" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Adding Borders| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="028aed91-46f3-4260-b9df-beb6e840e27b" name="Recover" type="Block"><subsheetid>ef6d41f9-99be-47ee-839f-3c684d9782cc</subsheetid><loginhibit /><display x="-60" y="-45" w="225" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2a52343a-bc22-4028-89e0-e25b12205491" name="Set Row Height and Column Width" type="SubSheetInfo"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><narrative>Change row height and column width for the given range</narrative><display x="-195" y="-150" w="150" h="90" /></stage><stage stageid="271a40bb-c197-4e01-aed9-064aa2cf6d6e" name="Start" type="Start"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><loginhibit /><narrative>Change row height and column width for the given range, Zero for AutoFit</narrative><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="text" name="workbook" narrative="workbook" stage="workbook" /><input type="text" name="Cell Range" narrative="Cell Range" stage="Cell Range" /><input type="number" name="Column Width" narrative="Column Width, Numeric Zero for AutoFit" stage="Column Width" /><input type="number" name="Row Height" narrative="Row Height,Numeric Zero for AutoFit" stage="Row Height" /></inputs><onsuccess>eeb3453a-9723-48a9-a16f-ba26af67b1f5</onsuccess></stage><stage stageid="ed07262d-aeea-4452-8be9-3c830d935010" name="End" type="End"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="8802a5f0-a49a-4c77-863a-809a06e704d8" name="Cell Range" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a6c3580c-24c4-4fd3-bc14-25cf741c4352" name="Column Width" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4e92917-7b96-478a-bd2d-9f55781c59e8" name="Row Height" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eeb3453a-9723-48a9-a16f-ba26af67b1f5" name="Change Column width and Row Height" type="Code"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><narrative>Change row height and column width for the given range, Zero for AutoFit</narrative><display x="15" y="-15" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="worksheet" expr="[Sheetname]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /><input type="number" name="Column_Width" expr="[Column Width]" /><input type="number" name="Row_Height" expr="[Row Height]" /></inputs><onsuccess>ed07262d-aeea-4452-8be9-3c830d935010</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, xlsheet1 As Object
wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
xlsheet1 = excel.ActiveSheet
'Row and column
If ((Column_Width=0)and (Row_Height=0))
xlSheet1.Range(Cell_Range).Columns.AutoFit
xlSheet1.Range(Cell_Range).Rows.AutoFit
else
xlSheet1.Range(Cell_Range).ColumnWidth = Column_Width
xlSheet1.Range(Cell_Range).RowHeight = Row_Height
'xlSheet1.Range(Cell_Range).HorizontalAlignment = -4131
end if


]]></code></stage><stage stageid="cc7ebed3-113f-4a3a-935a-8a1ad1713427" name="Sheetname" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="78303518-5ddc-4041-855a-ee0fa266981f" name="handle" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="-60" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9b670d49-c0b2-49da-bab0-a60e8aa0f52e" name="workbook" type="Data"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b1ad3d1-ff13-4ffa-8ac0-3bff8983de58" name="Recover" type="Recover"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="120" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>72b85714-d26c-4bea-a618-97c0c42c7ff8</onsuccess></stage><stage stageid="72b85714-d26c-4bea-a618-97c0c42c7ff8" name="Throw : SE" type="Exception"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><display x="240" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Formatting Row Column Height and Width| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="f993ea92-7e5f-40ec-b8a0-38d0b051b2d8" name="Recover" type="Block"><subsheetid>e80b4e82-233e-4cbf-8e75-91b5665ca193</subsheetid><loginhibit /><display x="-60" y="-60" w="225" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f8ec848f-9da9-4607-abfe-b235e3de5afc" name="Format to Bold-Italic-Underline" type="SubSheetInfo"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><narrative>Formats to Bold Italic and Undeline for a given range</narrative><display x="-195" y="-60" w="150" h="90" /></stage><stage stageid="5ce4ad0b-9f19-492f-8da3-3adac30ce0a8" name="Start" type="Start"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><loginhibit /><narrative>Formats to Bold Italic and Undeline for a given range</narrative><display x="15" y="-15" /><inputs><input type="number" name="handle" narrative="handle" stage="handle" /><input type="text" name="Sheetname" narrative="Sheet Name" stage="Sheetname" /><input type="text" name="workbook" narrative="workbook" stage="workbook" /><input type="flag" name="Bold" narrative="Bold" stage="Bold" /><input type="flag" name="Italic" narrative="Italic" stage="Italic" /><input type="flag" name="Underline" narrative="Underline" stage="Underline" /><input type="text" name="CellRange" narrative="CellRange" stage="Cell Range" /></inputs><onsuccess>d962722e-bed5-43fe-8852-7b6c5bc01995</onsuccess></stage><stage stageid="cc39a3fb-7375-4e73-b459-7a28d45d35e1" name="End" type="End"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><loginhibit /><display x="15" y="180" /></stage><stage stageid="24c81253-3de1-4f23-9d1e-4a7553b32c86" name="Cell Range" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="120" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d962722e-bed5-43fe-8852-7b6c5bc01995" name="Format to Bold/Italic/Underline" type="Code"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><narrative>Formats to Bold Italic and Undeline for a given range</narrative><display x="15" y="75" w="90" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="worksheet" expr="[Sheetname]" /><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="Cell_Range" expr="[Cell Range]" /><input type="flag" name="Bold_Flag" expr="[Bold]" /><input type="flag" name="Italic_Flag" expr="[Italic]" /><input type="flag" name="Underline_Flag" expr="[Underline]" /></inputs><onsuccess>cc39a3fb-7375-4e73-b459-7a28d45d35e1</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, xlsheet1 As Object
wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
xlsheet1 = excel.ActiveSheet
'Bold
If (Bold_Flag) Then
xlSheet1.Range(Cell_Range).Font.Bold = True
End If
'Italic
If (Italic_Flag) Then
xlSheet1.Range(Cell_Range).Font.Italic = True
End If
'Underline
If (Underline_Flag) Then
xlSheet1.Range(Cell_Range).Font.Underline = 2
End If





]]></code></stage><stage stageid="7b7a735d-30d1-46f2-a395-ec600eeab643" name="Sheetname" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e5938dc-e4b5-44bd-a932-a2881f7c5fc1" name="handle" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dc876029-f273-44b5-8fc1-2c29db37fe0f" name="workbook" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3659e3ee-1a44-49f9-b7cf-c2266f94009a" name="Bold" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="150" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="e41a5c26-ca20-47eb-a8a9-75354fad52a5" name="Italic" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="210" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="d26a20ed-5ff6-43bb-88ff-66e3eac3a8a8" name="Underline" type="Data"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="-195" y="180" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="1e39245c-2706-4eaa-a2cb-0aca6a032252" name="Recover" type="Recover"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="120" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>0342c6e6-3a67-49fe-aa13-35808e11f9ca</onsuccess></stage><stage stageid="0342c6e6-3a67-49fe-aa13-35808e11f9ca" name="Throw : SE" type="Exception"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><display x="240" y="75" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Formatting to Bold.Italic and Underline| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="c5b4cd7e-7480-499c-9e02-1d2903e6e8f8" name="Recover" type="Block"><subsheetid>da5c4c58-6c40-419e-95fb-e1850e62e243</subsheetid><loginhibit /><display x="-60" y="45" w="225" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="01ace245-ed2d-4c3d-80c7-f9224985397d" name="Delete StrikeThrough Rows" type="SubSheetInfo"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><narrative>Deletes all the rows that contains strikethrough cell values</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5ceb119a-13a6-437d-8491-ca2d181e0e14" name="End" type="End"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="c8bb19eb-4484-4547-919d-4d8743633be8" name="Start" type="Start"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="Delete rows that contains strikethrough values" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="Handle" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /></inputs><onsuccess>72639758-69f7-4350-93d6-41f67706958c</onsuccess></stage><stage stageid="0fe92486-b13c-432a-b5d0-5ecd84de306b" name="Workbook Name" type="Data"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><display x="-225" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23f53279-4cfa-44c4-83de-74dbddda5971" name="worksheet name" type="Data"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><loginhibit /><display x="-225" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="72639758-69f7-4350-93d6-41f67706958c" name="Delete Strikethrough Rows" type="Code"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><loginhibit /><display x="15" y="-30" w="180" h="60" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>5ceb119a-13a6-437d-8491-ca2d181e0e14</onsuccess><code><![CDATA[Dim xl,xlSheet1,var as object
Dim RowCount as Long
Dim J as integer

xl=GetObject(, "Excel.Application")
xlSheet1=getinstance(handle).Workbooks(workbook).Sheets(worksheet)

	RowCount = xlSheet1.usedrange.rows.count
	For J = RowCount To 2 Step -1
		xlSheet1.Rows(J).select
		xl.FindFormat.Font.Strikethrough=True
		var=xlSheet1.Range(Cstr(J)&":"&Cstr(J)).Find(What:="", LookIn:=-4123, LookAt _
	        :=2, SearchOrder:=2, SearchDirection:=1, MatchCase:= _
	        False, SearchFormat:=True)
		if Not var is nothing then
			xlSheet1.Rows(J).EntireRow.Delete
		end If
	Next J
]]></code></stage><stage stageid="4cef463a-f5f4-473b-a4ac-d2fc1323d720" name="handle" type="Data"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><display x="-225" y="90" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c841d253-28d9-4e50-8d33-8ec3f634d25b" name="Block5" type="Block"><subsheetid>87bbf6b5-de1d-4ef7-bcaa-bcbc885a8264</subsheetid><loginhibit /><display x="-315" y="0" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="0b6e744c-8d3e-473d-9340-d1fa0ec5a57b" name="Open Workbook - DontUpdateLinks" type="SubSheetInfo"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><narrative>Opens a workbook using the instance specified in the given handle, opening the book represented by the given filename and do not update links if any

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.

Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="3ac00aa0-dbd1-4d6f-afa2-9ea7534d8232" name="Start" type="Start"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /></inputs><onsuccess>5678504e-19b7-4d88-a86d-9ef564aa2951</onsuccess></stage><stage stageid="92c73fc4-7254-4cd2-8558-5184e78329d3" name="End" type="End"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="1d88a0c7-0e00-4f17-8452-0fbee98536c8" name="Open Workbook - Dont update links" type="Code"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="text" name="workbookname" stage="workbookname" /></outputs><onsuccess>8e829aa5-002f-4e26-87eb-ceec2202b486</onsuccess><code><![CDATA[
Dim wb as Object = GetInstance(handle).Workbooks.Open(filename,False)
workbookname = wb.Name
wb.Activate()]]></code></stage><stage stageid="d85ab1c8-ad75-4913-b55d-fcf43c3da202" name="handle" type="Data"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="94f9941f-3151-46ab-8cd6-bae6b9fa3716" name="filename" type="Data"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5678504e-19b7-4d88-a86d-9ef564aa2951" name="CheckInstanceHandle" type="SubSheet"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>902caa2c-f631-4908-b622-04574b3ad646</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="902caa2c-f631-4908-b622-04574b3ad646" name="VerifyFileExists" type="SubSheet"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>1d88a0c7-0e00-4f17-8452-0fbee98536c8</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="45f5b1a0-8473-4293-b0ab-eb7499b88459" name="workbookname" type="Data"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0470a7ad-80d3-472d-849e-1719c913b118" name="Enable Events" type="Data"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="8e829aa5-002f-4e26-87eb-ceec2202b486" name="Set Events Enabled" type="SubSheet"><subsheetid>119f1173-12fc-4122-a3a0-8f6ba9301f51</subsheetid><loginhibit onsuccess="true" /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>92c73fc4-7254-4cd2-8558-5184e78329d3</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="9138f2e4-c4b2-4a91-aa16-8a4175330405" name="Open Workbook With Corrupt Load " type="SubSheetInfo"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><narrative>Opens a workbook using the instance specified in the given handle, opening the book represented by the given filename.

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.
- CorruptLoad : 0 =Normal Load , 1= Repair File ,2 = Extract Data
Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="579575fe-610d-4658-8ea0-8b6033575e2f" name="Start" type="Start"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /><input type="number" name="CorruptLoad" narrative="0 =Normal Load , 1= Repair File ,2 = Extract Data" stage="CorruptLoad" /></inputs><onsuccess>456efb38-1836-4e57-8760-c80692cea494</onsuccess></stage><stage stageid="ab4c6ce4-d2c8-4295-95bb-e5351c650b91" name="End" type="End"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="0e638083-d296-40f7-a163-146f846be0fa" name="Open Workbook With CorruptLoad" type="Code"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /><input type="number" name="handle" expr="[handle]" /><input type="number" name="corruptLoad" expr="[CorruptLoad]" /></inputs><outputs><output type="text" name="name" stage="workbookname" /></outputs><onsuccess>7d7b0c54-9302-43c4-b7f8-1f524a82dd49</onsuccess><code><![CDATA[
Dim wb as Object = GetInstance(handle).Workbooks.Open(Filename:=filename,CorruptLoad:=corruptLoad)
name = wb.Name
wb.Activate()]]></code></stage><stage stageid="5789f6bd-b217-461a-b75a-a882071cbae0" name="handle" type="Data"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="7cc863e1-1668-4db3-946a-034e465b55ec" name="filename" type="Data"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="456efb38-1836-4e57-8760-c80692cea494" name="CheckInstanceHandle" type="SubSheet"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>883c800f-36f8-4e03-987e-ee8a00ae50f7</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="883c800f-36f8-4e03-987e-ee8a00ae50f7" name="VerifyFileExists" type="SubSheet"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>0e638083-d296-40f7-a163-146f846be0fa</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="356c852b-b398-4083-92c2-3879a131e4c4" name="workbookname" type="Data"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="94ef8556-4709-4d27-8817-5e2cbef5ea46" name="Enable Events" type="Data"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><display x="-210" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="7d7b0c54-9302-43c4-b7f8-1f524a82dd49" name="Set Events Enabled" type="SubSheet"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>ab4c6ce4-d2c8-4295-95bb-e5351c650b91</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="7a4f7045-4e22-4279-ab6e-a421bc5ef5eb" name="CorruptLoad" type="Data"><subsheetid>d6cc14f4-25bc-4334-ace2-e474304fc758</subsheetid><display x="-330" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7e1cf22c-573c-4659-9639-c0c871184b02" name="Insert Object To Sheet" type="SubSheetInfo"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><narrative>This action will attempt to insert a file into an excel worksheet.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="80c1f3ca-c62e-48e9-a7af-be6b3911a4bc" name="Start" type="Start"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel instance." stage="intHandle" /><input type="text" name="Workbook" narrative="Workbook name." stage="txtWorkbook" /><input type="text" name="Worksheet" narrative="Name of worksheet." stage="txtWorksheetName" /><input type="text" name="File Name" narrative="File to insert (full path to file)." stage="txtFileName" /><input type="flag" name="Display As Icon?" narrative="Indicator whether object will be saved as icon" stage="isIcon" /></inputs><onsuccess>c0f30a68-20bc-4487-a724-4df23a93cb33</onsuccess></stage><stage stageid="288bb28e-f8c6-4935-aa15-60abde292ebd" name="End" type="End"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="c0f30a68-20bc-4487-a724-4df23a93cb33" name="Insert Object To Worksheet" type="Code"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="txtWorkbook" expr="[txtWorkbook]" /><input type="text" name="txtWorksheet" expr="[txtWorksheetName]" /><input type="number" name="intHandle" expr="[intHandle]" /><input type="text" name="txtFileName" expr="[txtFileName]" /><input type="flag" name="isIcon" expr="[isIcon]" /></inputs><onsuccess>288bb28e-f8c6-4935-aa15-60abde292ebd</onsuccess><code><![CDATA[Try
	GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet).OLEObjects.Add(FileName:=txtFileName, Link:=False, DisplayAsIcon:=isIcon)
Catch ex As Exception
	Throw New Exception("Unable to insert file " + txtFileName + " to worksheet " + txtWorksheet + ". Exception detail: " + ex.Message)
End Try]]></code></stage><stage stageid="6c4c52c9-71e6-4f2b-8bf3-d7af91f301a9" name="txtWorksheetName" type="Data"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><display x="-210" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8715c3c3-cc30-4d70-941e-90804ba96c41" name="intHandle" type="Data"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><display x="-210" y="-15" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4aec6c41-3f52-48b4-a5d5-35fd1e6fee2d" name="txtWorkbook" type="Data"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><display x="-210" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c063e604-a33f-42f1-9283-4b1e736d2415" name="Input" type="Block"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><loginhibit /><display x="-315" y="-45" w="210" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4e5b7f20-4ab8-4ae6-addf-46f8b1119abe" name="txtFileName" type="Data"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><display x="-210" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c75a3486-8012-4e12-9793-0382522e9a0b" name="isIcon" type="Data"><subsheetid>40d01701-56c3-4f9c-8178-ce2da1d3bee4</subsheetid><display x="-210" y="105" w="180" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="7ddec1a5-db96-4c05-bfbf-c03c234105df" name="UnFilter ExcelRows" type="SubSheetInfo"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><narrative>This turns off auto filter mode in excel. Use Remove filter action to clear filters. </narrative><display x="-360" y="-135" w="150" h="90" /></stage><stage stageid="f4e0217d-6284-4e68-ab2a-e8f1be91729b" name="Start" type="Start"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="Excel Instance Handle" stage="handle" /><input type="text" name="workbook name" narrative="Excel Workbook name" stage="Workbook Name" /><input type="text" name="worksheet name" narrative="Excel Worksheet name" stage="worksheet name" /></inputs><onsuccess>5459c867-8ea6-4790-91e3-7ec5e80493ac</onsuccess></stage><stage stageid="3458554c-752b-4ef6-8ef9-8c20d6be5c1a" name="End" type="End"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="flag" name="Success" narrative="Success Flag" stage="Success" /></outputs></stage><stage stageid="19a305a6-02ba-4266-8c4b-c9bd9769e524" name="handle" type="Data"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><display x="-210" y="-30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb29f77d-517d-4311-afa0-1a5b99766879" name="Workbook Name" type="Data"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><display x="-135" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="093a8a93-b2d2-4803-a57b-e45f9eaad4a6" name="worksheet name" type="Data"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><loginhibit /><display x="-285" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5459c867-8ea6-4790-91e3-7ec5e80493ac" name="UnFilter Excel Rows" type="Code"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>3458554c-752b-4ef6-8ef9-8c20d6be5c1a</onsuccess><code><![CDATA[Try
getinstance(handle).Workbooks(workbook).Sheets(worksheet).AutoFilterMode = False
success = true
Catch ex as exception
success = false
End Try]]></code></stage><stage stageid="efb78fb9-5f1d-4e85-89a6-dae353d5f233" name="Recover" type="Recover"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><loginhibit /><display x="195" y="-90" /><onsuccess>4eeed151-788a-4e14-bfb7-8a17208d6840</onsuccess></stage><stage stageid="4eeed151-788a-4e14-bfb7-8a17208d6840" name="Exception" type="Exception"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><display x="195" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="4ac039a6-f397-4fce-a380-e56621081a8b" name="Success" type="Data"><subsheetid>0d36972b-0477-4979-af6a-d0c5cc882e48</subsheetid><display x="-375" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b01f84b-990b-4170-9474-7c26eb40704b" name="Open Password Protected wb (no alerts)" type="SubSheetInfo"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><narrative>Opens a workbook using the instance specified in the given handle, opening the book represented by the given filename.

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.

Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="46eddf63-e1c6-4583-bbfe-852a4f5c7bcf" name="Start" type="Start"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /><input type="password" name="Password" narrative="The Password to open the Excel file" stage="Password" /></inputs><onsuccess>1d486731-1c52-46c7-9593-d686da30e8b4</onsuccess></stage><stage stageid="41bb4422-e1dc-45a3-9d78-1c2203fbd604" name="End" type="End"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="599e3125-9528-4154-996a-fa69c49ceff6" name="Open protected workbook" type="Code"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /><input type="number" name="handle" expr="[handle]" /><input type="password" name="Password" expr="[Password]" /></inputs><outputs><output type="text" name="name" stage="workbookname" /></outputs><onsuccess>e9097e89-d603-4098-9c5f-72aadbec33a4</onsuccess><code><![CDATA[
Dim wb as Object = GetInstance(handle).Workbooks.Open(filename,False,False , ,Password, , True)
name = wb.Name
wb.Activate()

]]></code></stage><stage stageid="edd2c2c1-71ca-4c95-b432-cc0786a6d5f5" name="handle" type="Data"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="8f7056ca-6490-4979-9156-4968bea5ab9f" name="filename" type="Data"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1d486731-1c52-46c7-9593-d686da30e8b4" name="CheckInstanceHandle" type="SubSheet"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>ddc7c900-6858-4967-b586-456344ce68f6</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="ddc7c900-6858-4967-b586-456344ce68f6" name="VerifyFileExists" type="SubSheet"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>599e3125-9528-4154-996a-fa69c49ceff6</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="24edd96a-8f2c-42a6-a2a9-6f2666ed8708" name="workbookname" type="Data"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2280434f-ac12-4219-afaf-dce60b9f1fec" name="Enable Events" type="Data"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><display x="-210" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="e9097e89-d603-4098-9c5f-72aadbec33a4" name="Set Events Enabled" type="SubSheet"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>41bb4422-e1dc-45a3-9d78-1c2203fbd604</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="75391fea-2ef8-48bc-89b4-455f3d78ca02" name="Password" type="Data"><subsheetid>c529bbf0-b166-49ee-b2fb-f71900b9d7b7</subsheetid><loginhibit /><display x="-225" y="150" w="90" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="b3ead13c-72c7-4f1a-bd5c-38b9b506afe9" name="Disable DisplayAlerts" type="SubSheetInfo"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><narrative>Opens a workbook using the instance specified in the given handle, opening the book represented by the given filename.

Params :
- handle : Number : The handle to the instance in which the workbook should be opened. The default value of zero indicates the current instance.
- File name : Text : The path to the file which should be opened.

Outputs:
- Workbook Name : Text : The name of the workbook that Excel uses to identify it.

Exceptions:
- Bad Handle : If the given handle did not correspond to an instance.
- File Not Found : If the given file does not exist or is not a file.</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="1cd4b3f4-01f0-4e5c-b2be-fc6771ead2e4" name="Start" type="Start"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><loginhibit /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /></inputs><onsuccess>c61d8664-4d64-432e-be20-dc3d4e4f5da4</onsuccess></stage><stage stageid="b826b026-eaa1-4cd2-a967-8e47d3e55db0" name="End" type="End"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="3e5b1572-3d2e-418a-9388-81b3c5930c6d" name="Disable DisplayAlerts" type="Code"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><loginhibit /><display x="15" y="-150" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>b826b026-eaa1-4cd2-a967-8e47d3e55db0</onsuccess><code><![CDATA[GetInstance(handle).DisplayAlerts = false]]></code></stage><stage stageid="9641ceb1-36a7-4a96-8243-9757ae18268c" name="handle" type="Data"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c61d8664-4d64-432e-be20-dc3d4e4f5da4" name="CheckInstanceHandle" type="SubSheet"><subsheetid>5b7026ce-1b5a-461c-90ad-d02d365a289b</subsheetid><loginhibit /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>3e5b1572-3d2e-418a-9388-81b3c5930c6d</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="57d6b8ea-bbb1-4442-a281-4117f65860ed" name="Save As PDF/XPS" type="SubSheetInfo"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><narrative>VBO Action to save Excel as PDF/XPS file, built using the reference using the reference https://docs.microsoft.com/en-us/office/vba/api/excel.workbook.exportasfixedformat.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f6001aa1-f5dd-4c5c-9e54-dc34ec8f3cca" name="Start" type="Start"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><narrative>VBO Action to save Excel as PDF/XPS file, built using the reference using the reference https://docs.microsoft.com/en-us/office/vba/api/excel.workbook.exportasfixedformat.

1) Filename (mandatory) : Full path including the drive and folder location (where the new PDF file is to be saved) and .pdf file extension.

2) IncludeDocProperties (mandatory): Default value is False.

3) OpenAfterPublish (mandatory): Default value is False. If you want the PDF file to launch automatically, immediately after conversion, set the value to True.

4) IgnorePrintAreas (mandatory): Default value is True. If set to True, ignores any print areas set when publishing. If set to False, uses the print areas set when publishing.

5) workbookname (mandatory): Name of the Excel workbook which is being saved as PDF.

6) handle (mandatory): Handle of the Excel Instance related to the workbookname.

7) worksheet (mandatory): Name of the worksheet which should be Saved As PDF file.

8) XlFixedFormatType (mandatory): Input value as 0 for "PDF" - Portable Document Format file (.pdf). Input value as 1 for "XPS" - XPS Document (.xps). Default / Initial value is 0.

9) XlFixedFormatQuality (mandatory): Input value as 0 for Standard Quality. Input value as 1 for Minimum Quality. Default / Initial value is 0.</narrative><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="Mandatory: Excel workbook handle." stage="handle" /><input type="text" name="workbookname" narrative="Mandatory: Excel workbook name" stage="workbookname" /><input type="text" name="Filename" narrative="Mandatory: Filename with full path, of the pdf to be saved. Full path including the drive and folder location (where the new PDF file is to be saved) and .pdf file extension." stage="Filename" /><input type="flag" name="IgnorePrintAreas" narrative="Mandatory: If set to True, ignores any print areas set when publishing. If set to False, uses the print areas set when publishing." stage="IgnorePrintAreas" /><input type="flag" name="IncludeDocProperties" narrative="Mandatory: Set to True to indicate that document properties should be included, or set to False to indicate that they are omitted." stage="IncludeDocProperties" /><input type="flag" name="OpenAfterPublish" narrative="Mandatory: If set to True, displays the file in the viewer after it is published. If set to False, the file is published but not displayed." stage="OpenAfterPublish" /><input type="text" name="worksheetname" narrative="Mandatory: Name of the worksheet which should be Saved As PDF file." stage="worksheetname" /><input type="number" name="XlFixedFormatType" narrative="Mandatory: Input value as 0 for &quot;PDF&quot; - Portable Document Format file (.pdf). Input value as 1 for &quot;XPS&quot; - XPS Document (.xps). Default / Initial value is 0." stage="XlFixedFormatType" /><input type="number" name="XlFixedFormatQuality" narrative="Mandatory: Input value as 0 for Standard Quality. Input value as 1 for Minimum Quality. Default / Initial value is 0." stage="XlFixedFormatQuality" /></inputs><onsuccess>36716d37-2a50-42ff-8ab3-c80eec074298</onsuccess></stage><stage stageid="438d1c87-3079-42f8-a56a-986722d6d36c" name="End" type="End"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="flag" name="Success" narrative="True if success, else false." stage="Success" /><output type="text" name="Message" narrative="Blank is success, else message appears." stage="Message" /></outputs></stage><stage stageid="36716d37-2a50-42ff-8ab3-c80eec074298" name="Save As PDF/XPS" type="Code"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><narrative>Save Worksheet as PDF/XPS.</narrative><display x="15" y="0" /><inputs><input type="text" name="Filename" expr="[Filename]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="flag" name="OpenAfterPublish" expr="[OpenAfterPublish]" /><input type="flag" name="IncludeDocProperties" expr="[IncludeDocProperties]" /><input type="flag" name="IgnorePrintAreas" expr="[IgnorePrintAreas]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="number" name="XlFixedFormatType" expr="[XlFixedFormatType]" /><input type="number" name="XlFixedFormatQuality" expr="[XlFixedFormatQuality]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>438d1c87-3079-42f8-a56a-986722d6d36c</onsuccess><code><![CDATA[Dim wb as Object = GetWorkbook(handle,workbookname)
Dim ws as Object = GetWorksheet(handle,workbookname,worksheetname)
Dim excel as Object = wb.Application 

Try

wb.Activate()
ws.Activate()
excel.DisplayAlerts = False 
wb.ActiveSheet.ExportAsFixedFormat(Type:=XlFixedFormatType,Filename:=Filename,Quality:=XlFixedFormatQuality,IncludeDocProperties:=IncludeDocProperties,IgnorePrintAreas:=IgnorePrintAreas,OpenAfterPublish:=OpenAfterPublish)
excel.DisplayAlerts = False
Success = True
Catch e As Exception

Success = False
Message = e.Message

End Try]]></code></stage><stage stageid="53bb8904-0065-4206-b62a-ee254abea228" name="handle" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-285" y="-15" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="db061d1b-739f-40cb-85b9-910bb7388ed6" name="IncludeDocProperties" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-150" y="-15" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="17bc31a4-20de-47bc-a3d9-1f175a72435e" name="IgnorePrintAreas" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-285" y="75" w="120" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="8f6a96e3-81f0-45cf-b4e9-5db462fd295c" name="Filename" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-285" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="10dfd30f-0733-4035-aed2-4db83cbba53a" name="OpenAfterPublish" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-150" y="30" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="92129435-3459-4344-a39e-0c28295b92e8" name="workbookname" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-150" y="75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bfd72f1b-33ca-4fd1-a3e7-afcf3c026f59" name="Input Parameters" type="Block"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-360" y="-45" w="285" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a1477e5f-8c28-4aac-b2f5-d998ec02f162" name="Output Parameters" type="Block"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-360" y="225" w="285" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e9f34906-18fa-4261-8d29-99f35179a58d" name="Success" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-285" y="255" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="549a8054-2edb-473e-80c6-80c24532e8ea" name="Message" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><loginhibit /><display x="-150" y="255" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7b93077d-a87d-4647-8be6-46855cd68bb9" name="worksheetname" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><display x="-150" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6841f9a4-a25d-46b7-95e9-a188c50c1057" name="XlFixedFormatType" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><display x="-285" y="120" w="120" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="8b9ff3ca-7391-4d74-a064-fa26899ee623" name="XlFixedFormatQuality" type="Data"><subsheetid>35a496f2-138e-494f-ae92-4a99d3841637</subsheetid><display x="-285" y="165" w="120" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="d3c752b6-28b1-40a6-bd88-cb92d09da495" name="Insert Image To Sheet" type="SubSheetInfo"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><narrative>Action will insert an image to a worksheet.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="534790de-c62d-4441-acb8-6c0c812a1740" name="End" type="End"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><loginhibit /><display x="30" y="90" /><outputs><output type="text" name="Exception Message" narrative="If blank, no exception encountered." stage="txtException" /></outputs></stage><stage stageid="4f8874a8-62e5-4c0b-91ca-1d29e7b6924b" name="Start" type="Start"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><loginhibit /><display x="30" y="-75" /><inputs><input type="number" name="Handle" narrative="(Mandatory field) Excel instance." stage="intHandle" /><input type="number" name="Position Left" narrative="Position (in pixels) from the left of the sheet. If Range (Cell Reference) is specified,  input the value as 0." stage="intLeft" /><input type="number" name="Position Top" narrative="Position (in pixels) from the top of the sheet. If Range (Cell Reference) is specified, input the value as 0." stage="intTop" /><input type="text" name="Workbook" narrative="(Mandatory field) Workbook name." stage="txtWorkbook" /><input type="text" name="Worksheet" narrative="(Mandatory field) Name of worksheet." stage="txtWorksheetName" /><input type="text" name="File Name" narrative="(Mandatory field) Path to image." stage="txtImagePath" /><input type="number" name="Width" narrative="Width (in pixels) of shape range." stage="intWidth" /><input type="number" name="Height" narrative="Height (in pixels) of shape range." stage="intHeight" /><input type="text" name="Range" narrative="Cell reference where image will be inserted. Leave this field blank if image is to be pasted with reference to Position Left and Position Top." stage="txtRange" /></inputs><onsuccess>937ac421-3ac6-4752-9710-89a6187d92ad</onsuccess></stage><stage stageid="937ac421-3ac6-4752-9710-89a6187d92ad" name="Insert Image To Sheet" type="Code"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><loginhibit /><display x="30" y="15" /><inputs><input type="text" name="txtWorkbook" expr="[txtWorkbook]" /><input type="text" name="txtWorksheet" expr="[txtWorksheetName]" /><input type="number" name="intHandle" expr="[intHandle]" /><input type="text" name="txtImgPath" expr="[txtImagePath]" /><input type="number" name="intWidth" expr="[intWidth]" /><input type="number" name="intHeight" expr="[intHeight]" /><input type="number" name="intPosLeft" expr="[intLeft]" /><input type="number" name="intPosTop" expr="[intTop]" /><input type="text" name="txtRange" expr="[txtRange]" /></inputs><outputs><output type="text" name="txtException" stage="txtException" /></outputs><onsuccess>534790de-c62d-4441-acb8-6c0c812a1740</onsuccess><code><![CDATA[Const msoTrue = -1
Const msoFalse = 0

Dim objImg As Object

Try
	objImg = GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet).Shapes.AddPicture(txtImgPath,msoFalse,msoTrue,intPosLeft,intPosTop, intWidth, intHeight)
	If txtRange <> "" Then
		With objImg
			.Left = GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet).Range(txtRange).Left
			.Top = GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet).Range(txtRange).Top
		End With
	End If
Catch ex As Exception
	txtException = "Unable to insert image " + txtImgPath + " to worksheet " + txtWorksheet + ". Exception detail: " + ex.Message
End Try]]></code></stage><stage stageid="b8e958f3-4bc3-4eb9-80e8-5beded2308ff" name="txtWorksheetName" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e7c20e9c-43be-4a71-9832-29764564b7d8" name="intHandle" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="-15" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33e4844e-80e5-40e1-97a9-90684722bcb8" name="txtWorkbook" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="da86b0cd-251e-458b-b906-42c0ffe826f1" name="Input" type="Block"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><loginhibit /><display x="-300" y="-45" w="210" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9f3b2f54-01bb-4b3e-a99d-8d73b844343e" name="txtImagePath" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c800ea6b-1957-47ac-8ab5-e92bdb51003a" name="intHeight" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="316870d8-80e7-4ff3-a18c-cc1444a795c4" name="intWidth" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="135" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c3dc13fa-db86-4c40-ad59-2abb2d981684" name="intLeft" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="195" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5efe92de-075d-4536-a0ca-1caccec7c64c" name="intTop" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="165" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="333fa95a-7a62-440e-8546-c52a9d43b2fc" name="txtRange" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="225" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3477251a-1241-408c-b8b5-3e08464cba9a" name="txtException" type="Data"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><display x="-195" y="300" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="adf5cdda-b81c-4c03-87ce-fc6aae915574" name="Output" type="Block"><subsheetid>fa5e77cb-e184-49ba-ab22-b0b7635cde63</subsheetid><loginhibit /><display x="-300" y="270" w="210" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="14268486-a161-4e49-a57a-c7b5e6c48e87" name="Run Macro With Parameter And TimeOut" type="SubSheetInfo"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><narrative>Runs the specified macro.

Depending on how the macro has been created the name will be one of the following:

A. Just the macro name
e.g. MyMacro

B. The workbook and macro name
e.g. MyWorkbook.xls!MyMacro

C. The workbook, worksheet and the macro name
e.g. 'MyWorkbook.xls!'MyWorksheet.MyMacro</narrative><display x="-225" y="-195" w="180" h="210" /></stage><stage stageid="6a57dacd-58cc-46d4-b0c8-671e04847107" name="Start" type="Start"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="The integer handle identifying the instance that contains the macro. The default of zero indicates the currently active instance." stage="Handle" /><input type="text" name="Macro Name" narrative="The name of the macro to run" stage="Macro Name" /><input type="text" name="Parameter" narrative="The parameter value that needs to be passed for the macro" stage="Parameter" /><input type="number" name="Timeout" narrative="The timeout period in seconds for the macro to run" stage="Timeout" /></inputs><onsuccess>65fd13c4-755c-4228-bab6-027ace5b99c1</onsuccess></stage><stage stageid="367414d1-d402-445b-a324-e6034597e6e1" name="End" type="End"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="65fd13c4-755c-4228-bab6-027ace5b99c1" name="Run Macro With Parameter And TimeOut" type="Code"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Macro Name" expr="[Macro Name]" /><input type="text" name="Parameter" expr="[Parameter]" /><input type="number" name="Timeout" expr="[Timeout]" /></inputs><onsuccess>367414d1-d402-445b-a324-e6034597e6e1</onsuccess><code><![CDATA[ExecWithTimeoutParam(Timeout, "Run Macro With Parameter And TimeOut",
Function()
    GetInstance(Handle).Run(Macro_Name, Parameter)
	Return True
End Function)]]></code></stage><stage stageid="2563a4c7-9441-4aff-97a7-7375b3422175" name="Handle" type="Data"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="-195" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c1df90cd-d966-4824-a1dd-2da5273d3f59" name="Macro Name" type="Data"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="-195" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7e5ed923-ca74-48aa-9521-b9b6a1eb270c" name="Parameter" type="Data"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><loginhibit /><display x="-195" y="90" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d869aaf7-2173-45d9-8172-30319970e75c" name="Timeout" type="Data"><subsheetid>7694a10f-fc0c-4650-a0df-f96c3e91bb38</subsheetid><display x="-195" y="45" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1a3ac0b5-b2bb-444a-a5b0-33c9343d1175" name="Unmerge Cells" type="SubSheetInfo"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><narrative>unmerge cells in given range</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="aad640f4-2797-4594-9c5e-ea83fec83e3c" name="Start" type="Start"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Mandatory : Specify the workbook name to be used" stage="Workbook" /><input type="text" name="Worksheet" narrative="Mandatory : Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /><input type="text" name="Reference" narrative="Mandatory : Range - cell reference ex :(A1:B1)" stage="Reference" /></inputs><onsuccess>873248d9-5864-4198-862e-0aa7fb8b7679</onsuccess></stage><stage stageid="5da97099-cec2-4a8a-ac23-1d5bbd3a1172" name="End" type="End"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="873248d9-5864-4198-862e-0aa7fb8b7679" name="Unmerge cell" type="Code"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="range" expr="[Reference]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>9225312c-5d80-4fb4-913a-6a11d2afb989</onsuccess><code><![CDATA[Dim wb,ws,xlSheet1,xl As Object

Try
GetInstance(handle).DisplayAlerts = false
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
xl = ws.Application
xlSheet1 = xl.ActiveSheet

xlSheet1.Range(range).Unmerge


Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                xl = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="b6a54553-0940-4099-8f22-3996a32a8fcb" name="Message" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="147ac577-36cd-45f3-81d2-146c348fb6c9" name="Success" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c36ac647-3924-40c7-9faf-e6c5fc0b5bed" name="Workbook" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="59bd85b2-983e-4082-ae3b-af57377df6ae" name="Handle" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="84b0d314-0c9d-4272-a2a9-fb64a3a2ce5b" name="Worksheet" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e35337f4-7340-42ad-9fe8-28c1870be9d5" name="Reference" type="Data"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="090225e3-ffce-434d-8786-3957e69ea282" name="Inputs" type="Block"><subsheetid>f063c689-6ad9-4966-be1c-e53ebf47d2f8</subsheetid><loginhibit onsuccess="true" /><display x="-270" y="-30" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="d6312c2d-61e5-400a-bd73-0