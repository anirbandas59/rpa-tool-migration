d>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1994934c-ad2e-48c5-9083-7dec0ebd6afe" name="G Value" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82f644da-4b60-48f6-8a3e-629939eb2982" name="B Value" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="210" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ddedf012-0e83-44cb-b8d9-9b8e9e45b691" name="Sort_Order" type="Data"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><display x="-195" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d01908d9-3b32-4817-ac7e-d17d15ba9274" name="Color Sort" type="Code"><subsheetid>48d37ec0-3f71-41e5-b697-5f322877b897</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Reference]" /><input type="number" name="R" expr="[R value]" /><input type="number" name="G" expr="[G Value]" /><input type="number" name="B" expr="[B Value]" /><input type="number" name="Sort_Order" expr="[Sort_Order]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>ad7b5201-53eb-4153-a972-314a1e9dc6af</onsuccess><code><![CDATA[Dim wb,ws,xlSheet1,xl,range As Object

Try
GetInstance(handle).DisplayAlerts = false
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
xl = ws.Application
xlSheet1 = xl.ActiveSheet


If(xlSheet1.AutoFilterMode=False)then
xl.selection.AutoFilter
End If

xlSheet1.AutoFilter.Sort.SortFields.Clear
xlSheet1.AutoFilter.Sort.SortFields.Add(Key:=xlSheet1.Range( _
        Reference),SortOn:=1,Order:=Sort_Order,DataOption:=0).SortOnValue.Color _
        = RGB(R,G,B)
xlSheet1.AutoFilter.Sort.Header = 1
xlSheet1.AutoFilter.Sort.MatchCase = False
xlSheet1.AutoFilter.Sort.Orientation = 1
xlSheet1.AutoFilter.Sort.SortMethod = 1
xlSheet1.AutoFilter.Sort.Apply

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                xl = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="6a177b0f-1047-4651-9b12-d5810cb55baf" name="Sort by Column Name" type="SubSheetInfo"><subsheetid>8a7fbefa-469a-4f93-87b2-5ddbe84bad47</subsheetid><loginhibit onsuccess="true" /><narrative>applying the sort based on value of one column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d99d35dd-9efb-494f-a2c1-80b87223817e" name="Start" type="Start"><subsheetid>8a7fbefa-469a-4f93-87b2-5ddbe84bad47</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Mandatory : Specify the workbook name to be used" stage="Workbook" /><input type="text" name="Worksheet" narrative="Mandatory : Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /><input type="text" name="ColumnToSort" narrative="Mandatory : name of the column to be sorted (eg: A1)" stage="ColumnToSort" /><input type="number" name="Sort_Order" narrative="Mandatory : 1 for ascending order and 2 for descending order" stage="Sort_Order" /></inputs><onsuccess>689a83f3-e831-4e42-9f32-3dc19532715e</onsuccess></stage><stage stageid="7e3be936-3f09-40ec-8b12-d7089d7fa3c8" name="End" type="End"><subsheetid>8a7fbefa-469a-4f93-87b2-5ddbe84bad47</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="230458a5-4985-4a97-9d92-a9f307021bdb" name="Message" type="Data"><subsheetid>8a7fbefa-469a-4f93-87b2-5ddbe84bad47</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="effc4e71-07a7-4f95-9338-1ffc4c2fcc54" name="Success" type="Data"><subsheetid>8a7fbefa-469a-4f93-87b2-5ddbe84bad47</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf169417-16eb-45d2-81d8-173fc43