4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name/Value of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="number" name="Page Size" narrative="(Optional)Specify the page size (Default: 5000)" stage="Page Size" /><input type="text" name="Metadata_to_set" narrative="Specify the metadata to be set" stage="Metadata_to_set" /></inputs><onsuccess>eb14430a-2064-4793-a338-c637f10a85c8</onsuccess></stage><stage stageid="358bcce3-554a-493d-9fc8-a9684cfe41a5" name="End" type="End"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Message" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="7343a28c-d740-4eb8-8926-322361019db0" name="Build Script" type="Calculation"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="-105" /><onsuccess>6b6b5331-1a67-4394-9a9d-abe55664cb05</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize &quot;&amp;[Page Size]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot; Set-PnPListItem -List &quot;&amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp;&quot; -Identity $item -Values @{&quot;&amp;[Metadata_to_set]&amp;&quot;} &quot;&#xA;&amp;NewLine()&amp;&quot;Exit &quot; &amp; NewLine()&amp;&#xA; &quot;}&quot; &amp; NewLine() &amp; &#xA;&quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &#xA;&quot;Catch {&quot; &amp; NewLine() &amp;&#xA; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="266a5105-aeea-43ae-bbb6-4e75da0dc86d" name="Run PnP_Script" type="SubSheet"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>db5183d6-12d6-4263-84f6-f5eba72197da</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="0c95c526-023a-4fc1-9482-a23da579e8fd" name="Delete_Script" type="Action"><subsheetid>560e4ae1-d9c4-47ed-9ee0-034b2364f3f6</subsheetid><display x="15" y="300" /><i