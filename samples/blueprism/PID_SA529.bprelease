bce9" name="Activate Row" type="SubSheet"><subsheetid>2a62b945-02eb-4fcb-adc4-1176600e5b7d</subsheetid><loginhibit /><display x="30" y="-60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="" /></inputs><onsuccess>a48ce7e4-95ab-46aa-9440-13352a3a5825</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="43fa5184-35a2-48b4-8bc1-87d27a19782c" name="handle" type="Data"><subsheetid>2a62b945-02eb-4fcb-adc4-1176600e5b7d</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="a48ce7e4-95ab-46aa-9440-13352a3a5825" name="Delete Row OLD" type="Code"><subsheetid>2a62b945-02eb-4fcb-adc4-1176600e5b7d</subsheetid><loginhibit /><display x="30" y="0" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="rowNum" expr="[RowNum]" /></inputs><onsuccess>1e71de01-60e1-4033-8aec-a017f3d27d16</onsuccess><code><![CDATA[Dim worksheet As Object
worksheet = GetWorkbook(handle,Nothing).ActiveSheet

worksheet.Rows(rowNum).Delete
]]></code></stage><stage stageid="565b81b7-ff58-4441-9806-55d8b9e87864" name="RowNum" type="Data"><subsheetid>2a62b945-02eb-4fcb-adc4-1176600e5b7d</subsheetid><display x="-195" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="809064ca-ab30-4d66-a67c-cf55910e6bd3" name="csvToXlsx" type="SubSheetInfo"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><narrative>Converts CSV Files to .XLSX Files</narrative><display x="-195" y="-120" w="150" h="90" /></stage><stage stageid="3629e0cc-f1ad-4581-b36a-2d6ead06ed5c" name="Start" type="Start"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><loginhibit /><preconditions><condition narrative=".csv files should be accesible" /></preconditions><display x="0" y="-210" /><inputs><input type="text" name="CSV FilePath" narrative="File Path of CSV file to be converted" stage="CSV FilePath" /><input type="text" name="Destination FilePath" narrative="File Path where xlsx should be placed" stage="Destination Filepath" /></inputs><onsuccess>83ff7b6f-9da2-420d-9991-cfacbaa1ebd1</onsuccess></stage><stage stageid="6430564e-fa3d-40b7-bcc2-8ad3c2b01c5a" name="End" type="End"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><loginhibit /><display x="0" y="150" /></stage><stage stageid="a592d874-1db4-4c67-8821-787ce64058be" name="handle" type="Data"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><display x="-240" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="41f6ef73-c4f6-43ad-ad6c-8d06d527e488" name="Workbook Name" type="Data"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><display x="-225" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2e21b510-805c-4ff6-985b-194a41b86a1c" name="CsvToXlsx" type="Code"><subsheetid>91bd81cd-66be-4f3f-b779-daa9056d1abf</subsheetid><loginhibit /><disp