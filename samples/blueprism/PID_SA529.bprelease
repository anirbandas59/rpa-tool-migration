ubsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><loginhibit onsuccess="true" /><display x="135" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Success" narrative="Success Flag" stage="Success" /><output type="text" name="Message" narrative="Error Message" stage="Message" /></outputs></stage><stage stageid="1bb2d947-108d-47ab-ae65-8807de62b12f" name="handle" type="Data"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4f63161f-1942-443f-949d-fdd4822c5fb1" name="workbook" type="Data"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><loginhibit onsuccess="true" /><display x="-225" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c31c2a73-6e2d-419f-b1cb-c4194b256cf2" name="worksheet" type="Data"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><loginhibit onsuccess="true" /><display x="-150" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f1f3c303-ef6f-4ff7-924e-8eda16531de0" name="Open Object" type="Code"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><loginhibit onsuccess="true" /><display x="135" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbook]" /><input type="text" name="Worksheet" expr="[worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>36777442-b470-4fce-a90a-4d3d12bdf4b9</onsuccess><code><![CDATA[Dim wb, ws As Object, obj As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
wb.Activate()
ws.Activate()
For Each obj In ws.OLEObjects 
obj.Verb()
Next

Success = True

Catch e As Exception

Success = False
Message = e.Message

End Try]]></code></stage><stage stageid="99d058c3-7bcf-4966-a065-812375139b76" name="Success" type="Data"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><display x="-165" y="105" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f9c3aafd-d2a0-4429-b961-f4a00350368c" name="Message" type="Data"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><display x="-240" y="105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="abf596a9-18b9-4eea-a9a6-c20685640f01" name="Parameters" type="Block"><subsheetid>53f1a5f8-4c55-4325-8b66-d28037d286c8</subsheetid><display x="-285" y="-15" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="9394a4cf-63c2-4f34-834e-dfc0955cc33b" name="Start" type="Start"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-30" y="-225" /><inputs><input type="number" name="handle" narrative="handle of opened workbook" stage="handle" /><input type="text" name="Source_Range" narrative="Source_Range" stage="Source_Range" /><input type="text" name="Destination_range" narrative="Destination_range" stage="Destination_range" /></inputs><onsuccess>af421f3a-83e8-4682-b29d-3e929354285d</onsuccess></stage><stage stageid="b74f1a7f-beb7-4345-b3b5-9e1c6db75be1" name="End" type="End"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-30" y="90" /></stage><stage stageid="a8002545-8613-475a-8425-721330f1f741" name="Activate Workbook" type="SubSheet"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-30" y="-60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>d74e0501-db2c-4637-ba15-81e574268be8</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="d854f78e-6613-4ef3-bdd8-00ed8288abfe" name="handle" type="Data"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><display x="-330" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>1</initialvalue><private /><alwaysinit /></stage><stage stageid="d74e0501-db2c-4637-ba15-81e574268be8" name="Autofill values for given range1" type="Code"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><narrative>FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range("A1").Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try</narrative><display x="-30" y="15" w="150" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Source_range" expr="[Source_Range]" /><input type="text" name="Destination_range" expr="[Destination_range]" /></inputs><onsuccess>b74f1a7f-beb7-4345-b3b5-9e1c6db75be1</onsuccess><code><![CDATA[GetWorkbook(handle, "").ActiveSheet.Range(Source_range).AutoFill(Destination:= GetWorkbook(handle, "").ActiveSheet.Range(Destination_range), Type:=0)]]></code></stage><stage stageid="524c066d-23e3-4b4c-9cf6-80b244ff262c" name="Source_Range" type="Data"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><display x="-330" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5f8621d3-7a17-4496-b1ee-cfc05b2fa502" name="Destination_range" type="Data"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><display x="-330" y="15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b2c60d60-1d0f-4e9f-a2bf-700d1deade22" name="Variables" type="Block"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-405" y="-75" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7416dd1b-a24c-43b4-aba3-b74aa0d07812" name="Range same as Source Range?" type="Decision"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><narrative>InStr([Destination_range], ":")-1</narrative><display x="-30" y="-120" /><decision expression="([Source_Range] = Left([Destination_range], InStr([Destination_range], &quot;:&quot;)-1)) AND &#xA;([Source_Range] = Right([Destination_range], Len([Destination_range])- InStr([Destination_range], &quot;:&quot;)))" /><ontrue>84390efd-420e-458d-91d0-21939cd720f8</ontrue><onfalse>a8002545-8613-475a-8425-721330f1f741</onfalse></stage><stage stageid="af421f3a-83e8-4682-b29d-3e929354285d" name="Contains&quot;:&quot;?" type="Decision"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-30" y="-165" /><decision expression="InStr([Destination_range], &quot;:&quot;) &gt;0" /><ontrue>7416dd1b-a24c-43b4-aba3-b74aa0d07812</ontrue><onfalse>cd771abf-f154-4a97-9781-53eb93e92f0d</onfalse></stage><stage stageid="84390efd-420e-458d-91d0-21939cd720f8" name="Anchor5" type="Anchor"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-135" y="-120" w="10" h="10" /><onsuccess>61c10a90-8cff-4f3c-9b25-dd42e0588381</onsuccess></stage><stage stageid="61c10a90-8cff-4f3c-9b25-dd42e0588381" name="Anchor6" type="Anchor"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="-135" y="90" w="10" h="10" /><onsuccess>b74f1a7f-beb7-4345-b3b5-9e1c6db75be1</onsuccess></stage><stage stageid="cd771abf-f154-4a97-9781-53eb93e92f0d" name="Anchor7" type="Anchor"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="75" y="-165" w="10" h="10" /><onsuccess>9991f1c9-c798-4309-8b55-9a9daaa523df</onsuccess></stage><stage stageid="9991f1c9-c798-4309-8b55-9a9daaa523df" name="Anchor8" type="Anchor"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><loginhibit /><display x="75" y="-60" w="10" h="10" /><onsuccess>a8002545-8613-475a-8425-721330f1f741</onsuccess></stage><stage stageid="02f74582-2d5b-429c-8b9f-9003beedd111" name="Copy and Paste Filtered Range Rows" type="SubSheetInfo"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><narrative>This will Copy and Paste Filtered Rows with range input variable</narrative><display x="-270" y="-120" w="150" h="90" /></stage><stage stageid="00cce86b-fb6f-471e-b672-2ece1e61f6ef" name="Start" type="Start"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="135" y="-150" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." stage="Handle" /><input type="text" name="Source Workbook" narrative="Name of source workbook" stage="Source Workbook" /><input type="text" name="Source Worksheet" narrative="Name of workheet" stage="Source Worksheet" /><input type="text" name="Source Range" narrative="Worksheet range ex. &quot;A1:Z100&quot;" stage="Source Range" /><input type="text" name="Destination Workbook" narrative="Destination workbook name" stage="Destination Workbook" /><input type="text" name="Destination Worksheet" narrative="Destination worksheet name" stage="Destination Worksheet" /><input type="text" name="Destination Range" narrative="Worksheet range destination ex. &quot;A1&quot;" stage="Destination Range" /></inputs><onsuccess>2e76d76a-6c84-4696-bbf9-14367a60caf4</onsuccess></stage><stage stageid="06e972e2-cba7-4770-8c5c-1c3b71d22702" name="Source Workbook" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e051ddca-8f52-4cbe-a4f1-0b187035f833" name="Source Worksheet" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0eac64f7-2ff1-4e89-986e-09016976b657" name="Destination Workbook" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3ef72d83-f644-4c9f-9965-a9b56e739f14" name="Worksheet Exists" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="165" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2e76d76a-6c84-4696-bbf9-14367a60caf4" name="Copy Filtered" type="Code"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="135" y="-75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Source Workbook" expr="[Source Workbook]" /><input type="text" name="Source Worksheet" expr="[Source Worksheet]" /><input type="text" name="Source Range" expr="[Source Range]" /><input type="text" name="Destination Workbook" expr="[Destination Workbook]" /><input type="text" name="Destination Worksheet" expr="[Destination Worksheet]" /><input type="text" name="Destination Range" expr="[Destination Range]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>b629cc42-1a55-4be6-8bfc-ef668e1a525b</onsuccess><code><![CDATA[Dim sw, dw As Object
Dim ss, ds As Object
Dim excel, sheet, source, destination, cells, cell As Object

Try

sw = GetWorkbook(Handle, Source_Workbook)
dw = GetWorkbook(Handle, Destination_Workbook)

ss = GetWorksheet(Handle, Source_Workbook, Source_Worksheet)
ds = GetWorksheet(Handle, Destination_Workbook, Destination_Worksheet)

sw.Activate()
ss.Activate()
excel = ss.Application
sheet = excel.ActiveSheet
cell = excel.ActiveCell

If Source_Range="" Then
	cells = sheet.Cells
	Destination_Range = "A1"
Else
	cells = sheet.Range(Source_Range)
End If

cells.Select()
source = excel.Selection
source.SpecialCells(12).Copy()
'cell.Select()

dw.Activate()
ds.Activate()
sheet = excel.ActiveSheet
cell = excel.ActiveCell
destination = sheet.Range(Destination_Range)
destination.Select()
'sheet.Paste()
'cell.Select()

destination.PasteSpecial(Paste:=-4163, Operation:=-4142, SkipBlanks:=False, Transpose:=False)


My.Computer.Clipboard.Clear()

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	sw = Nothing
	ss = Nothing
	dw = Nothing
	ds = Nothing
	excel = Nothing
	sheet = Nothing
	source = Nothing
	destination = Nothing
	cells = Nothing
	cell = Nothing
End Try]]></code></stage><stage stageid="7908822c-58c1-422e-8b98-46696b295372" name="End2" type="End"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="135" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ca863589-7012-4e2a-923b-399246c705a1" name="Success" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="195" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac97562e-7074-46d5-83b1-1fb2d9101a8c" name="Message" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="225" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b629cc42-1a55-4be6-8bfc-ef668e1a525b" name="Success?" type="Decision"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="135" y="-15" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>7908822c-58c1-422e-8b98-46696b295372</ontrue><onfalse>7772a5c6-10cd-4ac9-8e66-2afcb8efe766</onfalse></stage><stage stageid="7772a5c6-10cd-4ac9-8e66-2afcb8efe766" name="System Exception" type="Exception"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="240" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Failed to copy worksheet: &quot; &amp; [Message]" /></stage><stage stageid="b66ef6e7-3c85-42c6-b2ce-5b5c01a6f595" name="Destination Worksheet" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="90" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="94405672-7135-45d9-9319-1ba4335b4476" name="Handle" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="-75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c59fcc77-bc0b-4536-b522-48987248b039" name="Source Range" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="16a09da9-ead1-4dee-8a67-4874e192635b" name="Destination Range" type="Data"><subsheetid>72d872b2-6015-4f3c-ad82-0507bf1fdb20</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b7d85432-f4d5-4058-81c9-5b8f9a5e2027" name="Get Worksheet Range As Collection - No header" type="SubSheetInfo"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><narrative>this action will add headers by default and no excel headers will be added unless range is given to get headers</narrative><display x="-195" y="-120" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="af782ee5-9d9a-4caa-a985-0a5e707e2d5f" name="End" type="End"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><loginhibit /><display x="135" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Data" narrative="The spreadsheet data from the specified range, as a collection" stage="worksheetcollection" /></outputs></stage><stage stageid="205d9a75-6aab-4142-9da5-557802159849" name="handle" type="Data"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="-75" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="e0b7cde2-d447-4552-ba0b-93619a41155e" name="workbookname" type="Data"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="-75" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8a78b859-c9d2-4f82-9a82-684021ac9b1c" name="Start" type="Start"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><loginhibit /><display x="135" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="StartCell" narrative="The starting cell of the range of interest" stage="Start Cell" /><input type="text" name="EndCell" narrative="The end cell of the range of interest" stage="End Cell" /></inputs><onsuccess>3b8edd94-b4e7-4f9e-aad5-d8b87d945e25</onsuccess></stage><stage stageid="ecc98912-8538-45a4-8f91-332fb4bfdb0c" name="GetWorksheetRangeAsCollection - No header" type="Code"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><loginhibit /><display x="135" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Start Cell" expr="[Start Cell]" /><input type="text" name="End Cell" expr="[End Cell]" /></inputs><outputs><output type="collection" name="worksheetcollection" stage="worksheetcollection" /></outputs><onsuccess>af782ee5-9d9a-4caa-a985-0a5e707e2d5f</onsuccess><code><![CDATA[
	Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
	Dim r as Object
	r = ws.Range(Start_Cell & ":" & End_Cell)
	r.Select()
	r.Copy()

	Dim data As String = Clipboard.GetDataObject().GetData(DataFormats.Text, True)
	
	' The data split into rows
	Dim asRows() As String = Split(data, vbCrLf)
	
	Dim table As New DataTable()
	
	Dim Count as Integer = 0
    Dim isHeaderRow as boolean = True

	For Each strRow as String in asRows
	If Not String.IsNullOrEmpty(strRow) Then
		
			Dim fields() As String = Split(strRow, vbTab)
			If isHeaderRow Then
			
				isHeaderRow = False
				For Each field As String in fields
					table.Columns.Add("Column"&Count)
					Count = Count + 1 
				Next
            End if
    End if
    
    Next

	For Each strRow As String In asRows
		If Not String.IsNullOrEmpty(strRow) Then
				Dim fields() As String = Split(strRow, vbTab)
				Dim row as DataRow = table.NewRow()
				For i As Integer = 0 To fields.Length - 1 
					If i < fields.Length Then
						row(i) = fields(i)
					Else
						row(i) = ""
					End If
				Next I
				table.Rows.Add(row)
				
		End If
		
	Next
	worksheetcollection = table]]></code></stage><stage stageid="3b8edd94-b4e7-4f9e-aad5-d8b87d945e25" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><loginhibit /><display x="135" y="-60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>ecc98912-8538-45a4-8f91-332fb4bfdb0c</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="524684dc-1281-4475-a33b-69e7b0d902ac" name="worksheetname" type="Data"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="-75" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6efb6aaf-2678-42dc-a6cb-2c3423234c2a" name="worksheetcollection" type="Collection"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="345" y="-15" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="052ae055-df84-4972-b891-929dc7e32c31" name="Start Cell" type="Data"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="-225" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5882656-bc57-46ca-b7fb-4c5985d0d5fa" name="End Cell" type="Data"><subsheetid>3ec32939-6dc3-4c7e-8397-37f0377a49db</subsheetid><display x="-300" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="71c353fc-0c25-475d-b8c6-42a31490fe3b" name="Run Macro With TimeOut" type="SubSheetInfo"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><narrative>Runs the specified macro.

Depending on how the macro has been created the name will be one of the following:

A. Just the macro name
e.g. MyMacro

B. The workbook and macro name
e.g. MyWorkbook.xls!MyMacro

C. The workbook, worksheet and the macro name
e.g. 'MyWorkbook.xls!'MyWorksheet.MyMacro</narrative><display x="-435" y="-210" w="180" h="210" /></stage><stage stageid="13a3e689-354d-4e50-82d6-06f772832f50" name="Start" type="Start"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="The integer handle identifying the instance that contains the macro. The default of zero indicates the currently active instance." stage="Handle" /><input type="text" name="Macro Name" narrative="The name of the macro to run" stage="Macro Name" /><input type="number" name="Timeout" narrative="The timeout period in seconds for the macro to run" stage="Timeout" /></inputs><onsuccess>718f8a4e-6df6-42e4-a179-fc4cb0d3b631</onsuccess></stage><stage stageid="303855ff-88a8-46f7-96be-1b05b3e1d4dc" name="End" type="End"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="718f8a4e-6df6-42e4-a179-fc4cb0d3b631" name="Run Macro With TimeOut" type="Code"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Macro Name" expr="[Macro Name]" /><input type="number" name="Timeout" expr="[Timeout]" /></inputs><onsuccess>303855ff-88a8-46f7-96be-1b05b3e1d4dc</onsuccess><code><![CDATA[ExecWithTimeoutParam(Timeout, "Run Macro With TimeOut",
Function()
    GetInstance(Handle).Run(Macro_Name)
	Return True
End Function)]]></code></stage><stage stageid="cf0bfb30-df5c-4224-99c6-16c04be507d1" name="Handle" type="Data"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><loginhibit /><display x="-195" y="-45" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c7d83859-2541-4b58-853e-de0948fac85d" name="Macro Name" type="Data"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><loginhibit /><display x="-195" y="0" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="08d58665-b9e7-433c-b274-59677b3247c6" name="Timeout" type="Data"><subsheetid>8c44036f-bea5-479c-80cb-7daaac98ff19</subsheetid><display x="-195" y="45" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4e384877-1055-459f-ba1f-ae8455bd09c8" name="csvToXlsx - Without Close All Instances" type="SubSheetInfo"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><narrative>Converts CSV Files to .XLSX Files. This is Duplicate of csvToXlsx action and created to test if RPC errors are resolved by not using Close All Instances Action</narrative><display x="-195" y="-120" w="150" h="90" /></stage><stage stageid="d1213cbf-be53-4299-8d08-259e2a67c3c7" name="Start" type="Start"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><preconditions><condition narrative=".csv files should be accesible" /></preconditions><display x="0" y="-165" /><inputs><input type="text" name="CSV FilePath" narrative="File Path of CSV file to be converted" stage="CSV FilePath" /><input type="text" name="Destination FilePath" narrative="File Path where xlsx should be placed" stage="Destination Filepath" /></inputs><onsuccess>c995cb5c-c237-4888-bb03-c365b7595924</onsuccess></stage><stage stageid="288353c8-4d40-4e08-ba24-8920922486f9" name="End" type="End"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="195" /></stage><stage stageid="959122d8-4f5d-4b6c-b516-c417e406562a" name="handle" type="Data"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><display x="-255" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="802b3184-5ff4-4978-8dc5-ffd9b77a376f" name="Workbook Name" type="Data"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><display x="-255" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fa11fa99-ebb2-480f-82e0-b35eed6eaca4" name="CsvToXlsx -without Close All Instances" type="Code"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="45" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="destination_filepath" expr="[Destination Filepath]" /></inputs><onsuccess>04357c63-7614-4bff-a250-8e897a16cb20</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).SaveAs(destination_filepath,51)]]></code></stage><stage stageid="c995cb5c-c237-4888-bb03-c365b7595924" name="Create Instance" type="SubSheet"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="-120" /><inputs><input type="flag" name="Enable Events" narrative="Flag to indicate that events should be enabled / disabled on the attached instance - defaulted to True" expr="" /></inputs><outputs><output type="number" name="handle" narrative="An integer which can be used to identify the created instance in subsequent actions" stage="handle" /></outputs><onsuccess>959a0a8d-8ea4-4f18-989a-f7dcb83e11d7</onsuccess><processid>99e648cc-a136-471c-8424-19071c0fd9e7</processid></stage><stage stageid="959a0a8d-8ea4-4f18-989a-f7dcb83e11d7" name="Open Workbook" type="SubSheet"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." expr="[CSV FilePath]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="Workbook Name" /></outputs><onsuccess>7d6b868a-c3fe-4106-8cf9-cfb130c43b9c</onsuccess><processid>2fb01e3f-e275-43bc-83eb-579001da335b</processid></stage><stage stageid="7d6b868a-c3fe-4106-8cf9-cfb130c43b9c" name="Show Workbook" type="SubSheet"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="-15" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance which should have its window displayed. The default of zero indicates the currently active instance." expr="[handle]" /></inputs><onsuccess>fa11fa99-ebb2-480f-82e0-b35eed6eaca4</onsuccess><processid>268628ce-c0f3-492a-be5c-87b432e16d1d</processid></stage><stage stageid="c53fa8e3-e6f9-438b-b53e-08f5a68049ba" name="Destination Filepath" type="Data"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="-255" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="befd4cc0-9b4e-43ba-88e0-31c643146f83" name="CSV FilePath" type="Data"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><display x="-255" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2393a3ed-3033-4cc7-844c-8c1ef98cba07" name="Close Instance" type="SubSheet"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="150" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance to be closed. Zero indicates the currently active instance." expr="[handle]" /><input type="flag" name="Save Changes" friendlyname="Save Changes" narrative="True to save the changes to the open workbooks on the instance, False to discard any changes. Default is False." expr="True" /></inputs><onsuccess>288353c8-4d40-4e08-ba24-8920922486f9</onsuccess><processid>6ec3006a-6553-4526-b522-32526c4aa3cc</processid></stage><stage stageid="bb311394-b9c9-41ea-9d0a-badafe3ba4e8" name="Time Out1" type="WaitEnd"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="45" y="90" w="30" h="30" /><onsuccess>2393a3ed-3033-4cc7-844c-8c1ef98cba07</onsuccess><groupid>9a206149-c34e-4a0f-8aab-d7d84c6656bf</groupid></stage><stage stageid="04357c63-7614-4bff-a250-8e897a16cb20" name="Wait1" type="WaitStart"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><loginhibit /><display x="0" y="90" w="30" h="30" /><groupid>9a206149-c34e-4a0f-8aab-d7d84c6656bf</groupid><choices /><timeout>[Seconds]</timeout></stage><stage stageid="4de2f586-be22-403e-8e56-9b29f2845f2b" name="Seconds" type="Data"><subsheetid>8c078e13-e0d2-4516-999c-ea2726a274d0</subsheetid><display x="-255" y="105" w="150" h="30" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="b3c207ea-c4f2-454b-9262-b2dc48defcdc" name="Refresh All" type="SubSheetInfo"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><narrative>Refreshes Excel workbook</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0de817a6-04f7-4266-9e86-117ba8dc9627" name="End" type="End"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="30" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="flag" name="Success" narrative="True on success/False on Failure" stage="Success" /><output type="text" name="Message" narrative="Error message if any" stage="Message" /></outputs></stage><stage stageid="179e7baa-f2df-40db-9b49-fd63054bf7e0" name="Handle" type="Data"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="14573576-3dc8-4bb8-88de-c9643671a73a" name="Workbook" type="Data"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67bb0a83-c02d-4ec3-8fc7-1337110b81f5" name="Start" type="Start"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><preconditions><condition narrative="NA" /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Refreshes Excel Workbook</narrative><display x="30" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Handle of opened workbook" stage="Handle" /><input type="text" name="Workbook" narrative="Workbook name" stage="Workbook" /></inputs><onsuccess>3a08dbcd-2709-4b1f-a724-ca2d7b020178</onsuccess></stage><stage stageid="3a08dbcd-2709-4b1f-a724-ca2d7b020178" name="Refresh All" type="Code"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="30" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>0de817a6-04f7-4266-9e86-117ba8dc9627</onsuccess><code><![CDATA[Dim wb As Object

Try

wb = GetWorkbook(Handle, Workbook)

wb.Activate()
wb.RefreshAll

Success = True


Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                         
End Try]]></code></stage><stage stageid="5bf80af9-ed09-49de-aa3c-6c113882cf99" name="Success" type="Data"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="270" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef6e4e1f-d686-47b5-aeca-da5dbd66eb4a" name="Message" type="Data"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit onsuccess="true" /><display x="270" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="25f6862a-9799-416c-bd4d-9570fbeec1cc" name="Inputs" type="Block"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit /><display x="-270" y="-45" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="bb4252bc-d24f-41b9-b252-a56653091f1b" name="Outputs" type="Block"><subsheetid>17bc969b-d64b-4d47-979b-a16cbf7dd182</subsheetid><loginhibit /><display x="180" y="-45" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="FF99CC" /></stage><stage stageid="f5c436f3-af47-498d-b02e-966c2e37da6b" name="Run Macro with 2 Parameters" type="SubSheetInfo"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><narrative>Runs the specified macro.

Depending on how the macro has been created the name will be one of the following:

A. Just the macro name
e.g. MyMacro

B. The workbook and macro name
e.g. MyWorkbook.xls!MyMacro

C. The workbook, worksheet and the macro name
e.g. 'MyWorkbook.xls!'MyWorksheet.MyMacro</narrative><display x="-225" y="-195" w="180" h="210" /></stage><stage stageid="68cef488-9754-4735-aa7b-770e11b73a5d" name="Start" type="Start"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="The integer handle identifying the instance that contains the macro. The default of zero indicates the currently active instance." stage="Handle" /><input type="text" name="Macro Name" narrative="The name of the macro to run" stage="Macro Name" /><input type="text" name="Param" narrative="Param" stage="Param" /><input type="text" name="Param2" narrative="Param2" stage="Param2" /></inputs><onsuccess>d243ff50-d8da-42c0-af27-aee8969a1386</onsuccess></stage><stage stageid="4336ade1-9c93-455c-b86d-170a9f895373" name="End" type="End"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="d243ff50-d8da-42c0-af27-aee8969a1386" name="Run Macro With 2 Params" type="Code"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Macro Name" expr="[Macro Name]" /><input type="text" name="Parameter" expr="[Param]" /><input type="text" name="Parameter2" expr="[Param2]" /></inputs><onsuccess>4336ade1-9c93-455c-b86d-170a9f895373</onsuccess><code><![CDATA[
GetInstance(Handle).Run(Macro_Name, Parameter, Parameter2)]]></code></stage><stage stageid="1d4403bd-b9c8-48ac-980a-4098a5823bb5" name="Handle" type="Data"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="165" y="-105" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="79e18149-7e58-4173-930d-47c5e26897d0" name="Macro Name" type="Data"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="165" y="-60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="85db13a8-0c05-464d-88a4-0ac609d3168b" name="Param" type="Data"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><loginhibit /><display x="165" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0615084d-2477-48e3-8beb-5b84dd5169b1" name="Param2" type="Data"><subsheetid>195c95cc-c03a-460a-94ce-7d210be34491</subsheetid><display x="165" y="0" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf053c99-e1e2-4085-b7a1-5f1443ac35ba" name="Sort Fields" type="SubSheetInfo"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><narrative>Sorts any number of columns based on given criteria( 1 column at a time)
Clear Existing Sort: Set to True if  existing sorting needs to be cleared
ColumnXRange: Privide Column range (X1:X100)
Match case: True /  False
SortTypecolX : Type of sorting to apply</narrative><display x="-120" y="-330" w="150" h="90" /></stage><stage stageid="5a930461-1af0-4644-a161-e89015ab26b7" name="Start" type="Start"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><narrative>Sorts any number of columns based on given criteria( 1 column at a time)</narrative><display x="165" y="-210" /><inputs><input type="number" name="handle " narrative="handle " stage="handle" /><input type="text" name="Workbook name" narrative="Workbook name" stage="Workbook Name" /><input type="text" name="Worksheet name" narrative="Worksheet name" stage="worksheet name" /><input type="flag" name="Clear existing Sort" narrative="Clear existing Sort (True/False)" stage="Clear existing Sort" /><input type="text" name="Column1Range" narrative="Range for Column 1 (X1:X100)" stage="Column1Range" /><input type="text" name="SheetRange" narrative="Reference of the Range(A1 for whole sheet)" stage="SortRange" /><input type="flag" name="MatchCase" narrative="True or False" stage="MatchCase" /><input type="number" name="SortTypeCol1" narrative="1 for ascending and  2 for descending" stage="SortTypeCol1" /></inputs><onsuccess>f0f1664e-0544-4a9f-9196-2622f8fd51bf</onsuccess></stage><stage stageid="05c77123-d620-4a39-a91a-b1ed69ff2f43" name="End" type="End"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="165" y="-90" /></stage><stage stageid="219534c6-eeb9-4187-a877-de0712990e48" name="handle" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-225" y="-225" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1c2b350f-eb3b-4a4d-99d8-f1797344270b" name="Workbook Name" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-135" y="-225" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ae08e014-2e93-4ff7-a04d-4c940039be83" name="worksheet name" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="-225" y="-180" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f0f1664e-0544-4a9f-9196-2622f8fd51bf" name="Sort Fields " type="Code"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="165" y="-150" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="flag" name="Clear_existing_Sort" expr="[Clear existing Sort]" /><input type="text" name="RangeCol1" expr="[Column1Range]" /><input type="number" name="SortTypeCol1" expr="[SortTypeCol1]" /><input type="flag" name="Match_case" expr="[MatchCase]" /><input type="text" name="SortRange" expr="[SortRange]" /></inputs><onsuccess>05c77123-d620-4a39-a91a-b1ed69ff2f43</onsuccess><code><![CDATA[if Clear_existing_Sort then
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort.SortFields.clear
end if

getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort.SortFields.Add (Key:=getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(RangeCol1), SortOn:=0, Order:=SortTypeCol1, DataOption:=0)

   With getinstance(handle).Workbooks(workbook).Sheets(worksheet).Sort
    .SetRange (getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(SortRange))
      .Header = 1
        .MatchCase = Match_case
        .Orientation = 1
        .SortMethod = 1
      .Apply
    End With




]]></code></stage><stage stageid="ed483bdb-071a-4fb6-9f4c-fd91fc82596e" name="SortRange" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-135" y="-180" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d84596ba-301b-4f01-aaa5-37be58e53c68" name="SortTypeCol1" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-225" y="-135" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="73750c0a-b9db-4f5a-8423-b8ac470a7051" name="Column1Range" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-45" y="-180" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bdf59a2a-3b40-41ad-a107-93be18ed96c3" name="Sort Fields" type="Block"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="105" y="-180" w="195" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1fad2b54-848d-4869-a213-94798c62f432" name="Recover" type="Recover"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="255" y="-150" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>c3aab8e8-17c9-4f03-8a3e-bffcdcc56c2a</onsuccess></stage><stage stageid="c3aab8e8-17c9-4f03-8a3e-bffcdcc56c2a" name="Throw : SE : Error in Sorting" type="Exception"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="375" y="-150" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Sorting| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" savescreencapture="yes" /></stage><stage stageid="8feb3251-086f-45c7-8eef-9249b7f217da" name="Input" type="Block"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="-300" y="-270" w="330" h="180" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="5fd31044-1f7a-4b74-ab0e-3948b3baba4a" name="Clear existing Sort" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><display x="-45" y="-225" w="90" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="b2c7fa36-1ee4-444f-a78e-e72fc598243b" name="MatchCase" type="Data"><subsheetid>9a9c8db9-d03c-41ae-81bc-997d5040b634</subsheetid><loginhibit /><display x="-135" y="-135" w="90" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="110f9048-fc30-460c-84e5-4058c3f54f20" name="Replace All" type="SubSheetInfo"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><narrative>Search for a value and replaces all with the specified value.</narrative><display x="-195" y="-150" w="150" h="90" /></stage><stage stageid="7303dba3-1f9d-45c6-b6c2-bc8659e7b8bb" name="Start" type="Start"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-135" /><inputs><input type="number" name="handle " narrative="Handle" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="range" narrative="Range to be searched" stage="range" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /><input type="text" name="SearchValue" narrative="Value to be searched" stage="SearchValue" /><input type="text" name="ReplaceValue" narrative="Replacement Value" stage="ReplaceValue" /><input type="number" name="LookatValue" narrative="Can be one of the following XlLookAt constants: xlWhole or xlPart. (exact match - 1, partial match - 2 , default -2)" stage="LookatValue" /><input type="flag" name="MatchCase" narrative="True - case sensitive ; Default - False" stage="MatchCase" /><input type="flag" name="SearchFormat" narrative="Search formart for the method :  Default - False" stage="SearchFormat" /><input type="flag" name="ReplaceFormat" narrative="Replace Format for the method : Default - False" stage="ReplaceFormat" /></inputs><onsuccess>c3e1de75-dce2-46be-b329-e34d70e2ea45</onsuccess></stage><stage stageid="d14dbfa8-7c12-4fd5-b40d-6d3be0a62da1" name="End" type="End"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="6f2d426a-ee0e-4f71-814d-3eae4cce6206" name="handle" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="-195" y="-60" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf6def6c-bb29-40ef-8de2-fc2860df1eb6" name="Workbook Name" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="-195" y="-30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f8daa14d-0cb2-4a45-9af5-6bf52654dc76" name="ReplaceValue" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="-195" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ec8af010-1298-4839-8294-baaf5367af3a" name="worksheet name" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="-195" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="961cf63c-3c67-4d9c-9441-8493e77b7aaf" name="SearchValue" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c3e1de75-dce2-46be-b329-e34d70e2ea45" name="Replace_All" type="Code"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="text" name="SearchValue" expr="[SearchValue]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="ReplaceValue" expr="[ReplaceValue]" /><input type="text" name="range" expr="[range]" /><input type="flag" name="MatchCase" expr="[MatchCase]" /><input type="flag" name="ReplaceFormat" expr="[ReplaceFormat]" /><input type="flag" name="SearchFormat" expr="[SearchFormat]" /><input type="number" name="LookatValue" expr="[LookatValue]" /></inputs><onsuccess>d14dbfa8-7c12-4fd5-b40d-6d3be0a62da1</onsuccess><code><![CDATA[
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(range).Replace(What:=SearchValue,Replacement:=ReplaceValue,Lookat:=LookatValue,MatchCase:=MatchCase,SearchFormat:=SearchFormat,ReplaceFormat:=ReplaceFormat)
]]></code></stage><stage stageid="1bb2cb66-1ff9-47f2-96ab-a9d02ad57a41" name="range" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="-195" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bad6ee83-06a9-4c9e-bf8c-e37572d5ecd0" name="LookatValue" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="180" y="30" w="120" h="30" /><datatype>number</datatype><initialvalue>2</initialvalue><private /><alwaysinit /></stage><stage stageid="59877326-3956-4198-9ffd-843d8136ee75" name="MatchCase" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="180" y="-60" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="4d4161ca-0bab-4517-a1e0-e7c09dfaca9d" name="SearchFormat" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="180" y="-30" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="bd5f3648-353d-4e3d-9566-7304c21aeff3" name="ReplaceFormat" type="Data"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><display x="180" y="0" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="492bc7bc-888b-4dcf-a6e1-8cdfb6f30023" name="Inputs with intial values" type="Block"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="105" y="-90" w="165" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="59f146ce-1369-48d7-9043-5f12793ab57a" name="Inputs" type="Block"><subsheetid>7108dd15-3cf9-40d1-97c9-9bac8fcbafde</subsheetid><loginhibit /><display x="-270" y="-90" w="150" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="401fdd58-d331-429c-8798-72d168ba0034" name="Paste without Range - No Alerts" type="SubSheetInfo"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><narrative>Paste date without considering the range. before pasting to the excel alerts will be disabled.once after paste action is done, alerts will be enabled.</narrative><display x="-180" y="165" w="150" h="90" /></stage><stage stageid="4e6d52a9-e9eb-4dff-9d06-fbbcf70f1630" name="End" type="End"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><display x="30" y="405" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="2be1237f-78c6-4999-8089-9dc6c92b3e04" name="Handle" type="Data"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="-180" y="285" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35458d08-7e08-4dca-8d3c-4ae54023aec9" name="Workbook" type="Data"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="-180" y="315" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="97b92696-3dcd-4920-9dbd-19585f2a9d0b" name="Start" type="Start"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><preconditions><condition narrative="Excel should be opened and content to be pasted should be copied to clipboard" /></preconditions><display x="30" y="165" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Handle " stage="Handle" /><input type="text" name="Workbook" narrative="Name of the Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet Name" stage="Worksheet" /></inputs><onsuccess>14756fd6-ec8c-4884-8be0-f7d8d37cac1c</onsuccess></stage><stage stageid="6558081d-23da-42ea-afa7-a29b2e57c88c" name="Success?" type="Decision"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><display x="30" y="315" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>4e6d52a9-e9eb-4dff-9d06-fbbcf70f1630</ontrue><onfalse>23943116-dde1-4b2f-abf7-4ff7483aee89</onfalse></stage><stage stageid="23943116-dde1-4b2f-abf7-4ff7483aee89" name="Exception" type="Exception"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="195" y="315" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to paste from clipboard: &quot; &amp; [Message]" /></stage><stage stageid="edfb6bf7-eb26-49dd-ade0-0fed43206536" name="Success" type="Data"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="315" y="210" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ec833c51-bc60-467b-b737-68cc6288556f" name="Message" type="Data"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="315" y="240" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="14756fd6-ec8c-4884-8be0-f7d8d37cac1c" name="Paste without Range - no alerts" type="Code"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><narrative>Paste the value without any range selection</narrative><display x="30" y="240" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[Handle]" /><input type="text" name="workbookname" expr="[Workbook]" /><input type="text" name="worksheetname" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>6558081d-23da-42ea-afa7-a29b2e57c88c</onsuccess><code><![CDATA[Try
getInstance(handle).DisplayAlerts = false 
Dim ws as Object = GetWorksheet(handle,workbookname,worksheetname)
ws.Paste
Success = True
Catch e As Exception
	Success = False
	Message = e.Message
End Try
getInstance(handle).DisplayAlerts = false

]]></code></stage><stage stageid="4982b126-5c3e-4597-b20e-f6c6e70b1233" name="Worksheet" type="Data"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><display x="-180" y="345" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ce0297c9-f34c-4027-90bb-a69212b5f9e6" name="Inputs" type="Block"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><display x="-270" y="255" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ca1d50d5-1951-446f-a2b1-fbafa313bef0" name="Outputs" type="Block"><subsheetid>ff25cdec-db31-4356-b3d3-65603dea8b70</subsheetid><loginhibit /><display x="225" y="180" w="180" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0234d441-f9f9-4a97-a14a-d34840792980" name="Top Alignment for Selected Range" type="SubSheetInfo"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><narrative>Align Entire Column to top,bottom or center

</narrative><display x="-360" y="-105" w="210" h="90" /></stage><stage stageid="f24d42a9-ea6f-4fdb-b991-69ffd23d3713" name="Top alignment of Column" type="Code"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="105" y="-15" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Colname Range" expr="[Column Name]" /><input type="number" name="Align" expr="[Align]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>671cc33b-a0fc-48b2-ad60-5bf2b19d5c39</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try


xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)


'Align entire column
xlSheet1.Range(Colname_Range).VerticalAlignment= Align
Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="51e6fbfd-f53a-40ab-b26b-f3ab4856f4bf" name="Start" type="Start"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><loginhibit /><display x="105" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle created" stage="handle" /><input type="text" name="Work Book Name" narrative="Opened Work book name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work sheet name to access" stage="Worksheet" /><input type="text" name="Column Name Range" narrative="(Ex: A:D, A:A, C:F etc.)" stage="Column Name" /><input type="number" name="Align" narrative="Top Alignmnet code- &quot;-4160&quot;" stage="Align" /></inputs><onsuccess>f24d42a9-ea6f-4fdb-b991-69ffd23d3713</onsuccess></stage><stage stageid="671cc33b-a0fc-48b2-ad60-5bf2b19d5c39" name="End" type="End"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><loginhibit /><display x="105" y="75" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /></outputs></stage><stage stageid="b701bec2-c5a4-44ff-a7d3-a687ea2e958e" name="handle" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-135" y="-105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="57788527-5e20-43c6-b770-e105e69a5309" name="Workbook" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-135" y="-60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="26a03285-ef1a-4897-8231-e6e0cc28ef9b" name="Worksheet" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-135" y="-15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1869fdfa-7aca-4b56-94b9-85a2290eca05" name="Column Name" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-135" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ddc8c53b-42e7-4927-a74f-49e05096934f" name="Success" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-360" y="0" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="29ce5bd0-ca05-4673-9480-ec20175c549d" name="Message" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-360" y="60" w="180" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af38fd2f-170c-44f5-a497-e7d3ed3edd9b" name="Input parameters" type="Block"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><loginhibit /><display x="-240" y="-135" w="210" h="240" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="60667a8b-c98c-4f3f-9d7c-c7ad46a40f5e" name="Output Parameters" type="Block"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><loginhibit /><display x="-465" y="-45" w="210" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="cab6eb8b-72c5-4e74-90dd-196ee463aa0c" name="Align" type="Data"><subsheetid>5d7fe3e9-b5c3-4835-99ce-4bd24cf28d5b</subsheetid><display x="-135" y="75" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ed7639f-0b7a-44a3-b0fc-fbdd8c043c56" name="End" type="End"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="15" y="135" /></stage><stage stageid="f2e9ad11-f49b-4a50-90d5-9fda2b6f443a" name="handle" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><display x="-255" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b590a256-94a5-443b-962b-9c61259873cf" name="Workbook Name" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><display x="-330" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a91cf739-a695-43e9-a703-eea69c980472" name="Range" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><display x="-195" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52ccaaf2-49a3-4bfa-bf7a-76e04996bd2c" name="worksheet name" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="-300" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3183f80c-d8aa-4db1-b919-866039aabde8" name="filter_criteria" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="-240" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="24548e1c-9533-4f8c-9c5c-0eeb0a27edc4" name="Filter Excel Rows" type="Code"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="text" name="Req_ID" expr="[filter_criteria]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="range" expr="[Range]" /><input type="number" name="Field_Number" expr="[Field Number]" /><input type="flag" name="ThrowException" expr="[flg_ThrowExceptionOnError]" /></inputs><onsuccess>5ed7639f-0b7a-44a3-b0fc-fbdd8c043c56</onsuccess><code><![CDATA[If(ThrowException = False) Then
	Try
		getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(range).AutoFilter(Field:=Field_Number, Criteria1:= Req_ID)
	Catch ex as exception
	End Try
Else
	getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(range).AutoFilter(Field:=Field_Number, Criteria1:= Req_ID)
End If]]></code></stage><stage stageid="7f42db71-9c10-49d8-bce2-4fca9b2f34b9" name="Field Number" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="-180" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2dee0791-4af1-423b-8454-6e9c53e3bff4" name="Activate Workbook" type="SubSheet"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook Name]" /></inputs><onsuccess>24548e1c-9533-4f8c-9c5c-0eeb0a27edc4</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="363ed372-1705-40d8-988f-da086156b421" name="flg_ThrowExceptionOnError" type="Data"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><display x="-255" y="150" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="e87c2481-7ea8-4969-9a31-709b8eedc341" name="Start" type="Start"><subsheetid>edd5457e-8e1b-4fe3-b3ac-be0af29e7714</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="handle " narrative="handle to use for interacting with workbook" stage="handle" /><input type="text" name="workbook name" narrative="Name of the workbook" stage="Workbook Name" /><input type="text" name="range" narrative="Range to apply the filter on" stage="Range" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /><input type="text" name="filter_criteria" narrative="Criteria of the filter" stage="filter_criteria" /><input type="number" name="field_number" narrative="Field/ column number in the given range to apply the filter on" stage="Field Number" /><input type="flag" name="Throw Exception on error" narrative="Flag to denote if exception is required or not on executing code" stage="flg_ThrowExceptionOnError" /></inputs><onsuccess>2dee0791-4af1-423b-8454-6e9c53e3bff4</onsuccess></stage><stage stageid="a63fc723-93f9-4fcf-a409-7607625bec71" name="Press Sendkey" type="SubSheetInfo"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit onsuccess="true" /><narrative>This stage will perform global send key operation (eg: Enter, Shift etc) on the activated workbook and cell.

​​Timeout: Open instance within time
WorkbookName : Active Workbook Name
Wait : Delay before passing send Keys
Send Key Value : Send Key which a user desires to pass ({F2} {Enter} etc)
Wait_Flag : True: to have Microsoft Excel wait for the keys to be processed before returning control to the macro. 
                   False (or omitted) to continue running the macro without waiting for the keys to be processed.</narrative><display x="-795" y="-120" w="420" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="1d22f648-b4ae-4669-a1c8-e59a535726d6" name="End" type="End"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit onsuccess="true" /><display x="-495" y="75" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="bb18e805-98d6-491f-96aa-db6f823b2813" name="workbookname" type="Data"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit onsuccess="true" /><display x="-705" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d9252edf-de70-4fde-a415-92b0d5558a94" name="Start" type="Start"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit onsuccess="true" /><preconditions><condition narrative="Activate Workbook, Worksheet &amp; Cell" /></preconditions><postconditions><condition narrative="NA" /></postconditions><display x="-495" y="-90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Workbook Name" narrative="The name of the workbook in which the sheet exists - The default empty value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="SendKeyValue" narrative="Send Key Value" stage="SendKeyValue" /><input type="number" name="Timeout" narrative="Timeout in seconds for Excel Operation" stage="Timeout" /><input type="number" name="Wait" narrative="Wait time to Activate Excel Application" stage="Wait" /><input type="flag" name="Wait_Flag" narrative="True to have Microsoft Excel wait for the keys to be processed before returning control to the macro. False (or omitted) to continue running the macro without waiting for the keys to be processed" stage="Wait_Flag" /></inputs><onsuccess>fe1622ed-190f-4f43-8c46-91b5840385e0</onsuccess></stage><stage stageid="fe1622ed-190f-4f43-8c46-91b5840385e0" name="Press Sendkey" type="Code"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit onsuccess="true" /><display x="-495" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="SendKeyValue" expr="[SendKeyValue]" /><input type="number" name="Timeout" expr="[Timeout]" /><input type="number" name="Wait" expr="[Wait]" /><input type="flag" name="Wait_Flag" expr="[Wait_Flag]" /></inputs><onsuccess>1d22f648-b4ae-4669-a1c8-e59a535726d6</onsuccess><code><![CDATA[Dim obj = ExecWithTimeout(Timeout, "Open Named Instance",Function() OpenNamedObjectAA(workbookname))
Dim Minimize As Integer
Minimize = -4140
obj.WindowState = Minimize
Obj.Application.wait(Wait)
Dim Maximize As Integer
Maximize = -4137
obj.WindowState = Maximize
Obj.Application.wait(Wait)
obj.Application.SendKeys(SendKeyValue,Wait_Flag)
]]></code></stage><stage stageid="607ae6ee-6c7a-4563-8364-710dbddeda75" name="SendKeyValue" type="Data"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit /><display x="-705" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b2f15e5-b4fe-425e-8a28-a8bf859e5b8d" name="Input" type="Block"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit /><display x="-780" y="-60" w="150" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6769e533-1e87-4f51-8ea7-a1b1aff087dc" name="Timeout" type="Data"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><display x="-705" y="0" w="120" h="30" /><datatype>number</datatype><initialvalue>60</initialvalue><private /><alwaysinit /></stage><stage stageid="75004405-3be8-48e9-af8f-9012f1ff7332" name="Wait" type="Data"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><display x="-705" y="60" w="120" h="30" /><datatype>number</datatype><initialvalue>2</initialvalue><private /><alwaysinit /></stage><stage stageid="ed8b2d4f-f3a2-4f1d-98dc-3c2c17816d49" name="Recover" type="Recover"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><display x="-390" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>90bf6e75-ca0e-47bb-9420-ac3c73853b7e</onsuccess></stage><stage stageid="90bf6e75-ca0e-47bb-9420-ac3c73853b7e" name="Exception : Sendkeys" type="Exception"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><display x="-255" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Excels &gt;&gt; Error in Press Sendkey action| (BP Error : &quot; &amp; ExceptionDetail() &amp; &quot;)&quot;" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="544e40dc-a4fe-467e-a9cd-167add2af52f" name="Recover" type="Block"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><loginhibit /><display x="-585" y="-45" w="240" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="5f1055d9-3b25-475f-b9ec-449c44cc93e8" name="Wait_Flag" type="Data"><subsheetid>f72d72ef-c25d-40d3-92cb-358ae56ef625</subsheetid><display x="-705" y="90" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="cd88b283-1602-4496-83cd-9126383d5009" name="Set AutoCalculation- Manual/Automatic" type="SubSheetInfo"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><narrative>Set the autocalculation on a given Handler as Manual or Automatic
For Manual set parameter= -4135
For Automatic set parameter= -4105</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1be7bdd8-36cd-44e7-8d91-49e72e82aa28" name="Start" type="Start"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="45" y="-150" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="flag" name="EnableManualAutoCalculation" narrative="Required. If True, Autocalculation will be set to MANUAL. Else, set to AUTOMATIC. By Default, it is set to FALSE. This setting will be applied at a HANDLE level" stage="EnableManualAutoCalculation" /></inputs><onsuccess>38ba7272-a401-4a49-8289-12a3955c4cf1</onsuccess></stage><stage stageid="2ab788b2-4f92-408e-a589-5dfedaca79d6" name="End" type="End"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="45" y="150" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="25974942-a149-4cd0-ae7a-06ae13541275" name="Set Autocalculation" type="Code"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="45" y="105" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="enumValue" expr="[Enum Value]" /></inputs><onsuccess>2ab788b2-4f92-408e-a589-5dfedaca79d6</onsuccess><code><![CDATA[GetInstance(handle).Calculation=enumValue]]></code></stage><stage stageid="6132eab7-e3a0-4d49-aad4-8d2caf470e20" name="handle" type="Data"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><display x="-195" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="38ba7272-a401-4a49-8289-12a3955c4cf1" name="CheckInstanceHandle" type="SubSheet"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="45" y="-90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>ded10d1e-f905-4298-a82a-5f969e9be8b0</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="a2f80f13-0584-4f45-94d2-5d7bad91b921" name="Enum Value" type="Data"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><display x="-195" y="75" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d04bb2db-a3e8-4814-bf2d-013397c470e6" name="EnableManualAutoCalculation" type="Data"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="23316fd5-c25c-4174-99ef-7923484060ff" name="Set Manual Enum-Manual" type="Calculation"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="-45" y="0" w="90" h="30" /><onsuccess>25974942-a149-4cd0-ae7a-06ae13541275</onsuccess><calculation expression="-4135" stage="Enum Value" /></stage><stage stageid="ded10d1e-f905-4298-a82a-5f969e9be8b0" name="Enable Manual Calculation" type="Decision"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="45" y="-45" w="90" h="30" /><decision expression="[EnableManualAutoCalculation]" /><ontrue>23316fd5-c25c-4174-99ef-7923484060ff</ontrue><onfalse>d5e18dca-760d-4598-9ec9-3a6abda4cba2</onfalse></stage><stage stageid="d5e18dca-760d-4598-9ec9-3a6abda4cba2" name="Set Automatic Enum" type="Calculation"><subsheetid>3316fb16-2f33-4902-86e3-f27f3af3dadc</subsheetid><loginhibit /><display x="120" y="0" w="90" h="30" /><onsuccess>25974942-a149-4cd0-ae7a-06ae13541275</onsuccess><calculation expression="-4105" stage="Enum Value" /></stage><stage stageid="a6f187ee-3434-4051-89fb-26b75b8849cc" name="Extended - Calculate" type="SubSheetInfo"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><narrative>calulate actions is extended for whole book update</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="c2b847dc-0d42-456b-b360-87d92f769769" name="Start" type="Start"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><loginhibit /><display x="15" y="-150" /><inputs><input type="number" name="handle" narrative="handle of your instance" stage="Handle" /><input type="text" name="Workbook" narrative="workbook you want to calculate" stage="Workbook" /></inputs><onsuccess>21cbeaaa-785a-4a6a-bcc3-9f973fecfb78</onsuccess></stage><stage stageid="d32e904b-d9e3-4500-b3c2-fe4ace5917e2" name="End" type="End"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="flag" name="Success" narrative="returns the flag if any failure" stage="Success" /><output type="text" name="Message" narrative="output message if any error" stage="Message" /></outputs></stage><stage stageid="21cbeaaa-785a-4a6a-bcc3-9f973fecfb78" name="Calculate" type="Code"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><loginhibit /><display x="15" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>d32e904b-d9e3-4500-b3c2-fe4ace5917e2</onsuccess><code><![CDATA[Dim wb, excel, range As Object

Try

wb = GetWorkbook(Handle, Workbook)
excel = wb.Application
excel.Calculate

'range = excel.Selection
'range.Cut

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	excel = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="5096e9db-2e00-42b1-a965-123cacda05d6" name="Success" type="Data"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><display x="-255" y="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="5ab48dc4-708e-4556-bee7-37e7ff4c2133" name="Message" type="Data"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><display x="-180" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c56a423-dfc2-4bc2-9cc6-668bdea20379" name="Handle" type="Data"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><display x="-195" y="30" /><datatype>number</datatype><initialvalue>1</initialvalue><private /><alwaysinit /></stage><stage stageid="4d2e693e-653f-4467-8bc2-94451a79e94c" name="Workbook" type="Data"><subsheetid>531e6cbc-4aef-4a27-ac44-dfc3707835ac</subsheetid><display x="-255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="176d0f36-f602-4aa8-befe-c719fdd92edc" name="Save As Read Only" type="SubSheetInfo"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><narrative>Save the workbook in read only mode</narrative><display x="-255" y="-165" w="360" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="63e0a2ca-a1da-48f9-b04c-8f93ba11781f" name="Start" type="Start"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="-255" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." stage="filename" /><input type="text" name="Workbook" narrative="Name of the workbook" stage="workbookname" /></inputs><onsuccess>06af791d-bee2-4d57-b5ee-f56a934166bd</onsuccess></stage><stage stageid="6c72bc64-880b-48f7-a183-a9fadb06b3a1" name="End" type="End"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="workbookname" /></outputs></stage><stage stageid="8b8be507-2435-4882-910b-c2a5d0d85fa0" name="handle" type="Data"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><display x="-210" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="90286970-9f59-4b08-b52e-b5a2a6869b7d" name="filename" type="Data"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><display x="-210" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06af791d-bee2-4d57-b5ee-f56a934166bd" name="CheckInstanceHandle" type="SubSheet"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="-195" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>51bb8cdb-1336-4954-8cd1-cedf0640e217</onsuccess><processid>492548e8-2fa5-473e-9061-df8326d46e4c</processid></stage><stage stageid="51bb8cdb-1336-4954-8cd1-cedf0640e217" name="VerifyFileExists" type="SubSheet"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="-135" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="filename" expr="[filename]" /></inputs><onsuccess>d286794a-6e66-4d42-a7dc-1f9759d44949</onsuccess><processid>41a07606-d51b-4fe3-a076-7a77a4ca2cde</processid></stage><stage stageid="1bd5e32b-3ab0-4019-800e-6ad450e65034" name="workbookname" type="Data"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="-210" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="19f14524-a031-4d79-97ca-4249237388b2" name="Enable Events" type="Data"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><display x="-180" y="120" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="81178802-992b-4359-a4f4-b1c6ae34864d" name="Set Events Enabled" type="SubSheet"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer identifier for the instance on which the events should be enabled / disabled. Zero indicates the 'current active' instance." expr="[handle]" /><input type="flag" name="Enable Events" narrative="True to enable events on the specified instance, False to disable events" expr="[Enable Events]" /></inputs><onsuccess>6c72bc64-880b-48f7-a183-a9fadb06b3a1</onsuccess><processid>69db5cf5-4908-49c7-9027-8f48e26e5b27</processid></stage><stage stageid="d286794a-6e66-4d42-a7dc-1f9759d44949" name="Save As read Only" type="Code"><subsheetid>f93660f9-d028-4055-b558-b76c734aaaf0</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="workbookname" expr="[workbookname]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="filename" expr="[filename]" /></inputs><outputs><output type="text" name="name" stage="workbookname" /></outputs><onsuccess>81178802-992b-4359-a4f4-b1c6ae34864d</onsuccess><code><![CDATA[Dim wb as Object = GetWorkbook(handle,workbookname)
Dim excel as Object = wb.Application
excel.DisplayAlerts = False
wb.SaveAs(Filename:=filename,ReadOnlyRecommended:=True)
excel.DisplayAlerts = True
]]></code></stage><stage stageid="a5d5b3dd-8560-4e91-9f1d-d1603fa9b20a" name="Get Filtered Row Numbers As Collection" type="SubSheetInfo"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><narrative>Get all filtered row numbers to a collectioin</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="139f4c06-60d0-46e4-8440-75ec3e353f02" name="End" type="End"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><loginhibit /><display x="135" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="DataRow" narrative="The spreadsheet data from the specified range, as a collection" stage="worksheetcollection" /></outputs></stage><stage stageid="2c5789b5-c7c5-4cbe-8b1f-8145f26f4ce4" name="handle" type="Data"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><display x="-75" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="398ea76b-91ee-46a2-b926-3464beceeecb" name="workbookname" type="Data"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><display x="-75" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff312ebc-8ec3-4b50-8ba8-3c1d468b3009" name="Start" type="Start"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><loginhibit /><display x="135" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="Range" narrative="The starting cell of the range of interest" stage="Range" /></inputs><onsuccess>51318cc9-3832-444e-97d4-e6c5e3dd3be3</onsuccess></stage><stage stageid="59cc3121-4fac-458c-b8f8-ff77c2bd1563" name="Get Filtered Row Numbers" type="Code"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><loginhibit /><display x="135" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Range" expr="[Range]" /></inputs><outputs><output type="collection" name="worksheetcollection" stage="worksheetcollection" /></outputs><onsuccess>139f4c06-60d0-46e4-8440-75ec3e353f02</onsuccess><code><![CDATA[
	Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
	Dim rng as Object
	Dim table As New DataTable()
	table.Columns.Add("RowNumber",GetType(Integer))
	
	rng = ws.Range(Range)


	For Each cl as Object In rng.SpecialCells(12)
       table.Rows.Add(cl.Row)
		
    Next cl
	
					
					
				
		
	worksheetcollection = table]]></code></stage><stage stageid="51318cc9-3832-444e-97d4-e6c5e3dd3be3" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><loginhibit /><display x="135" y="-60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>59cc3121-4fac-458c-b8f8-ff77c2bd1563</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="057e0fa9-5ce1-40c4-b192-4abab14fe899" name="worksheetname" type="Data"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><display x="-75" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5d1e74e0-1e24-45e2-b3a6-93b9b93dca46" name="worksheetcollection" type="Collection"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><display x="345" y="-15" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="ad755ba0-810b-4c0a-bb22-4dd2a1d66a21" name="Range" type="Data"><subsheetid>8381f617-9f64-42b6-bffc-9dce6f23f987</subsheetid><display x="270" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e50e7556-3960-4f58-b785-23bfd6546737" name="Save Workbook with Timeout" type="SubSheetInfo"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><narrative>Saves the workbook using the current name as a filename.

Params:
- handle : Number : The integer identifying the instance on which the workbook should be saved. The default of 0 indicates the current instance.
- Workbook Name : The name of the workbook to be saved. The default of empty indicates that the active workbook should be saved.

Exceptions: 
- Bad Handle : If the given handle did not correspond to an instance.
- Workbook Not Found : If the given workbook did not exist on the specified instance.</narrative><display x="-285" y="-135" w="420" h="150" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="3a71c961-c582-4d3d-88f0-4429335eb3ad" name="Start" type="Start"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><loginhibit /><display x="15" y="-195" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be saved" stage="workbookname" /><input type="number" name="Timeout" narrative="Number of seconds before timeout" stage="Timeout" /></inputs><onsuccess>57bae653-0d96-4cec-8f47-c4660ba554d0</onsuccess></stage><stage stageid="e2fea6a8-3cfa-4aef-a88a-b1a01972eb7e" name="End" type="End"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><loginhibit /><display x="15" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="05f74e4c-7046-4745-8abb-b41cc5dbe2a1" name="handle" type="Data"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><display x="-195" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="88f1c3d6-dfa9-4438-8c4f-378a82593a80" name="SaveWorkbookwith" type="Code"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><loginhibit /><display x="15" y="-60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="number" name="Timeout" expr="[Timeout]" /></inputs><onsuccess>e2fea6a8-3cfa-4aef-a88a-b1a01972eb7e</onsuccess><code><![CDATA[
ExecWithTimeout(Timeout, "Saving workbook takes long due to some unrecognized pop up message And TimeOut",
Function()
    Dim wb as Object = GetWorkbook(handle,workbookname)
	Dim excel as Object = wb.Application
	excel.DisplayAlerts = False
	wb.Save()
	excel.DisplayAlerts = True
	Return True
End Function)

]]></code></stage><stage stageid="dc6554e2-c365-4f7c-a883-e2df86c8bdcd" name="workbookname" type="Data"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><display x="-195" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="57bae653-0d96-4cec-8f47-c4660ba554d0" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><loginhibit /><display x="15" y="-120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>88f1c3d6-dfa9-4438-8c4f-378a82593a80</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="c0e521d1-9614-472d-936b-ddc1d69431fa" name="Timeout" type="Data"><subsheetid>e9ba402e-1136-4087-a6fa-7518ad631eb5</subsheetid><display x="-195" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="049bd08e-3c3e-4245-8666-8845470feaf8" name="Get Cell Value with Error" type="SubSheetInfo"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><narrative>Get All cell values with error like (#N/A)</narrative><display x="-195" y="-105" w="270" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e3e48087-a89e-4499-8e39-c8e807e0862f" name="Start" type="Start"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance from which the required cell value should be retrieved. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Cell Reference" narrative="The cell reference indicating which cell's value should be retrieved. An empty value indicates that the currently active cell's value should be retrieved." stage="cellref" /></inputs><onsuccess>187ab8ff-2f3b-4b32-89dc-a690af30e8a7</onsuccess></stage><stage stageid="8563b21b-df48-4fbf-85ae-669fa51b007d" name="End" type="End"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="15" y="135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Value" narrative="The (unformatted) value from the required cell." stage="value" /></outputs></stage><stage stageid="b7e45c3f-58aa-4da9-85c9-9c9f834c6196" name="cellref" type="Data"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><display x="-195" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be80ec00-b97c-41b4-a266-11aa5be10bce" name="value" type="Data"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><display x="-195" y="60" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea12c61f-23df-40d7-ab69-c4c71d5ccfc7" name="Get Cell Value with Error" type="Code"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="15" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="cellref" expr="[cellref]" /></inputs><outputs><output type="text" name="value" stage="value" /></outputs><onsuccess>8563b21b-df48-4fbf-85ae-669fa51b007d</onsuccess><code><![CDATA[
	Dim cellVal as String = GetInstance(handle).ActiveCell.Value
	value = IIf(cellVal Is Nothing, "", cellVal)

	If value="-2146826273" Then
		value="#VALUE!"
	ElseIf value="-2146826259" Then
		value="#NAME?"
	ElseIf value="-2146826281" Then
		value="#DIV/0!"
	ElseIf value="-2146826265" Then
		value="#REF!"
	ElseIf value="-2146826288" Then
		value="#NULL!"
	ElseIf value="-2146826246" Then
		value="#N/A"
	ElseIf value="-2146826252" Then
		value="#NUM!"
	End If
	]]></code></stage><stage stageid="6793738a-5f66-470f-af04-617a2c5e5777" name="Go To Cell" type="SubSheet"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be navigated to. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" narrative="The cell reference on the currently active sheet within the specified instance which should be navigated to." expr="[cellref]" /></inputs><onsuccess>ea12c61f-23df-40d7-ab69-c4c71d5ccfc7</onsuccess><processid>ed502669-4207-4c88-895d-8c58ec321578</processid></stage><stage stageid="3612561b-9772-4d96-aaad-fd87f6147ffc" name="handle" type="Data"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><display x="-195" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="187ab8ff-2f3b-4b32-89dc-a690af30e8a7" name="cellref empty?" type="Decision"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="15" y="-90" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[cellref]=&quot;&quot;" /><ontrue>18d3d063-e9cf-4d1b-9c9a-7e881bb7c56f</ontrue><onfalse>6793738a-5f66-470f-af04-617a2c5e5777</onfalse></stage><stage stageid="18d3d063-e9cf-4d1b-9c9a-7e881bb7c56f" name="anchor3" type="Anchor"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="105" y="-90" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>834a84b2-a0be-4943-be88-3a56560c4fd8</onsuccess></stage><stage stageid="834a84b2-a0be-4943-be88-3a56560c4fd8" name="anchor4" type="Anchor"><subsheetid>2696c101-10e2-46b5-8905-5b34818af3a2</subsheetid><loginhibit /><display x="105" y="0" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>ea12c61f-23df-40d7-ab69-c4c71d5ccfc7</onsuccess></stage><stage stageid="0932bc0c-e0e7-4fa5-b389-e20656f50ce8" name="csvToXlsm" type="SubSheetInfo"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><narrative>Converts CSV Files to .XLSM Files</narrative><display x="-195" y="-120" w="150" h="90" /></stage><stage stageid="a82bb2eb-b96c-4a39-847d-a7d241f9aaa8" name="Start" type="Start"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><preconditions><condition narrative=".csv files should be accesible" /></preconditions><display x="0" y="-210" /><inputs><input type="text" name="CSV FilePath" narrative="File Path of CSV file to be converted" stage="CSV FilePath" /><input type="text" name="Destination FilePath" narrative="File Path where xlsx should be placed" stage="Destination Filepath" /></inputs><onsuccess>6262b8ba-965f-4a0d-87ed-496ecd76b258</onsuccess></stage><stage stageid="7300b5f0-3ea2-4578-993c-5bb28ca4e1ae" name="End" type="End"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="150" /></stage><stage stageid="833bde31-8436-4b4c-a321-f37262a1d8dc" name="handle" type="Data"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><display x="-240" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c048166d-12ef-42f6-82db-2ff525555fcc" name="Workbook Name" type="Data"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><display x="-225" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3f52c68d-fc76-4132-bb2d-fa694273c97b" name="CsvToXlsm" type="Code"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="45" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="destination_filepath" expr="[Destination Filepath]" /></inputs><onsuccess>7bf11550-8184-4293-8b23-05219d8c0738</onsuccess><code><![CDATA[getinstance(handle).Workbooks(workbook).SaveAs(destination_filepath,52)]]></code></stage><stage stageid="23c4cb40-b76c-4334-81c2-1736b1649cc4" name="Create Instance" type="SubSheet"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="-120" /><inputs><input type="flag" name="Enable Events" narrative="Flag to indicate that events should be enabled / disabled on the attached instance - defaulted to True" expr="" /></inputs><outputs><output type="number" name="handle" narrative="An integer which can be used to identify the created instance in subsequent actions" stage="handle" /></outputs><onsuccess>4341de5e-d095-498b-b7ff-c0243651b3fd</onsuccess><processid>99e648cc-a136-471c-8424-19071c0fd9e7</processid></stage><stage stageid="4341de5e-d095-498b-b7ff-c0243651b3fd" name="Open Workbook" type="SubSheet"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="-60" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." expr="[CSV FilePath]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="Workbook Name" /></outputs><onsuccess>e7328c83-84ba-46d9-9f84-01f3f23e4a1d</onsuccess><processid>2fb01e3f-e275-43bc-83eb-579001da335b</processid></stage><stage stageid="e7328c83-84ba-46d9-9f84-01f3f23e4a1d" name="Show Workbook" type="SubSheet"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="-15" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance which should have its window displayed. The default of zero indicates the currently active instance." expr="[handle]" /></inputs><onsuccess>3f52c68d-fc76-4132-bb2d-fa694273c97b</onsuccess><processid>268628ce-c0f3-492a-be5c-87b432e16d1d</processid></stage><stage stageid="7bf11550-8184-4293-8b23-05219d8c0738" name="Close All Instances" type="SubSheet"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="90" /><onsuccess>7300b5f0-3ea2-4578-993c-5bb28ca4e1ae</onsuccess><processid>feb8ce9f-299e-4152-85a1-354a5f9d995c</processid></stage><stage stageid="8d0e398c-5090-49f4-9337-7c2b80bee894" name="Destination Filepath" type="Data"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="-255" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fccfe80b-0dd2-4967-af99-9e9e4fb1f581" name="CSV FilePath" type="Data"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><display x="-270" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6262b8ba-965f-4a0d-87ed-496ecd76b258" name="Close All Instances" type="SubSheet"><subsheetid>4ace662f-e94e-442d-b4c7-867c6d54ae74</subsheetid><loginhibit /><display x="0" y="-165" /><onsuccess>23c4cb40-b76c-4334-81c2-1736b1649cc4</onsuccess><processid>feb8ce9f-299e-4152-85a1-354a5f9d995c</processid></stage><stage stageid="ddbaa83b-84ce-4697-8f1d-891966b26218" name="Save Workbook As with Password" type="SubSheetInfo"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><narrative>Save the given workbook using the given file name.

Params :
- handle : Number : The integer identifying the instance on which the workbook resides. Default (0) indicates the current instance
- Workbook Name : Text : The name of the workbook which should be saved. Default ("") indicates the active workbook.
- File name : Text : The path and name of the file to which the workbook should be saved.
- password: Password : The Password protect a file from opening.

Output :
- New Workbook Name : Text : The new name with which the workbook is identified within the excel instance.

Exceptions: 
- Bad Handle : If the given handle did not correspond to an instance.
- Workbook Not Found : If the given workbook did not exist on the specified instance.</narrative><display x="-285" y="-180" w="420" h="210" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="19d6a6d3-cb90-4ef8-a5d5-ce5c753793a9" name="End" type="End"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><loginhibit /><display x="15" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="New Workbook Name" narrative="The new workbook name which Excel will use to identify the workbook within the instance." stage="newworkbookname" /></outputs></stage><stage stageid="b430df16-15fa-48f1-95d4-4c2aa1e74a4f" name="filename" type="Data"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><display x="-255" y="60" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="28007dc1-a836-4b54-9390-94820eafd076" name="handle" type="Data"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><display x="-255" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="90ccfc35-853b-497b-a957-9f2862a4eb50" name="Start" type="Start"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><loginhibit /><display x="15" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook which should be saved resides. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook which should be saved" stage="workbookname" /><input type="text" name="Filename" narrative="The full path and filename to which the workbook should be saved." stage="filename" /><input type="password" name="password" narrative="The password to open the workbook." stage="password" /></inputs><onsuccess>3e1e8211-f823-4070-9ea6-1bbfb8003562</onsuccess></stage><stage stageid="e4a25dfd-2713-4b85-b3bc-909df2cada3e" name="workbookname" type="Data"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><display x="-255" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5b06c9d-6d48-481c-b7c8-ac4fada4bd7d" name="SaveWorkbookAs with Password" type="Code"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="filename" expr="[filename]" /><input type="password" name="password" expr="[password]" /></inputs><outputs><output type="text" name="newworkbookname" stage="workbookname" /></outputs><onsuccess>19d6a6d3-cb90-4ef8-a5d5-ce5c753793a9</onsuccess><code><![CDATA[
Dim wb as Object = GetWorkbook(handle,workbookname)
Dim excel as Object = wb.Application

excel.DisplayAlerts = False
wb.SaveAs(filename, ,password)
excel.DisplayAlerts = True

newworkbookname = wb.Name]]></code></stage><stage stageid="3e1e8211-f823-4070-9ea6-1bbfb8003562" name="CheckInstanceAndWorkbook" type="SubSheet"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><loginhibit /><display x="15" y="-75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /></inputs><onsuccess>e5b06c9d-6d48-481c-b7c8-ac4fada4bd7d</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="c1de7975-991c-473f-887c-7a6703585329" name="newworkbookname" type="Data"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><narrative>The new workbook name assigned by Excel after saving the book</narrative><display x="-135" y="15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63c514b3-dabc-4cb7-9f4c-0ecfbb20467a" name="password" type="Data"><subsheetid>d9b5b13c-ab8a-4c6a-8a40-69ffdd0de229</subsheetid><display x="-135" y="-30" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="21f4ca67-252a-4646-a929-e7942526ed58" name="Save Selected Range as PDF" type="SubSheetInfo"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><narrative>Save the selected range from excel file to PDF file - Veda</narrative><display x="45" y="-165" w="150" h="90" /></stage><stage stageid="4575b5b1-ed69-4675-a538-df45cc1a1815" name="End" type="End"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="315" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="babb8408-3ec0-4600-9e8e-ef7619a615bf" name="Handle" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="-75" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e3a0e67f-2e71-46ac-b32b-e355e54ba9ff" name="Workbook" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="-15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="771935b2-e5f9-46ee-93e7-e0add61d9e8e" name="Worksheet" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="510b5118-ce63-4e41-b9e3-5b8d65b79174" name="Save as PDF" type="Start"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="315" y="-180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="The integer handle identifying the instance on which the required action should be executed." stage="Handle" /><input type="text" name="Workbook" narrative="The name of the workbook on which the required action should be executed." stage="Workbook" /><input type="text" name="Worksheet" narrative="The name of the worksheet on which the required action should be executed." stage="Worksheet" /><input type="text" name="Filepath" narrative="The full path and filename to which the exported range should be saved as pdf." stage="Filepath" /><input type="text" name="SheetRange" narrative="The range to be exported and saved as pdf." stage="SheetRange" /></inputs><onsuccess>ec484532-5da1-497d-b1e6-1e2eac154a54</onsuccess></stage><stage stageid="ec484532-5da1-497d-b1e6-1e2eac154a54" name="Save Selected Range as PDF" type="Code"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="315" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Filepath" expr="[Filepath]" /><input type="text" name="SheetRange" expr="[SheetRange]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>965c8f32-2dfa-4735-95e1-07dc7eeaf5e7</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()

excel = ws.Application
sheet = excel.ActiveSheet

wb.Sheets(Worksheet).Range(SheetRange).ExportAsFixedFormat(0, Filepath ,0, 1, 0,,,0)
'sheet.ExportAsFixedFormat (0, Filepath ,0, 1, 0,,,0)

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	ws = Nothing
	excel = Nothing
	sheet = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="965c8f32-2dfa-4735-95e1-07dc7eeaf5e7" name="Success?" type="Decision"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="315" y="-60" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>4575b5b1-ed69-4675-a538-df45cc1a1815</ontrue><onfalse>17a61fc1-32a0-4b67-b2ea-d3816cd7bf07</onfalse></stage><stage stageid="17a61fc1-32a0-4b67-b2ea-d3816cd7bf07" name="Exception" type="Exception"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="405" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="System Exception" detail="&quot;Failed to select row: &quot; &amp; [Message]" /></stage><stage stageid="62cb9fc5-de48-4a7c-85e5-fe00c37b7bab" name="Success" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="90" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd1245f2-1af2-44e7-b85a-40735eebe7e5" name="Message" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4128806d-5a66-4599-9adc-473a2d101a1a" name="Filepath" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><loginhibit onsuccess="true" /><display x="60" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ce48ccf-0608-4793-a173-6ff7de87c1a2" name="SheetRange" type="Data"><subsheetid>6f5627c4-0e79-4a9a-b1a1-98d700a9eac1</subsheetid><display x="60" y="45" w=