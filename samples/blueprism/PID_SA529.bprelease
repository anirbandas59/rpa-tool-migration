put type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="Cols" expr="[Col Range]" /><input type="text" name="SheetName" expr="[SheetName]" /><input type="flag" name="HideCol?" expr="[HideCols?]" /></inputs><onsuccess>78e680ea-7335-45ca-aa94-1291fc5755af</onsuccess><code><![CDATA[Dim wb as Object = getinstance(handle).Workbooks(workbookname).Worksheets(SheetName)
wb.Columns(Cols).EntireColumn.Hidden = HideCol_]]></code></stage><stage stageid="7f1561db-908b-4808-bcd7-4d7738d817a1" name="handle" type="Data"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><display x="-135" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="034f011c-19f7-466e-b877-014cc48ec3fc" name="workbookname" type="Data"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><display x="-135" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fff9f6d7-5c87-4c71-9567-8e9f07297d52" name="Col Range" type="Data"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><display x="-255" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3faaf381-37f4-4465-9c74-65658fd3841a" name="SheetName" type="Data"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><display x="-270" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="55c237e3-5816-476d-83ff-103ff33f88d6" name="HideCols?" type="Data"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /></stage><stage stageid="417016ee-6d08-4ac6-94ba-f148a96f2d5b" name="Recover" type="Recover"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><loginhibit /><display x="315" y="-60" /><onsuccess>275c88e3-04f1-4b6e-bbc1-a9bf73135d9e</onsuccess></stage><stage stageid="275c88e3-04f1-4b6e-bbc1-a9bf73135d9e" name="Exception" type="Exception"><subsheetid>b5b87491-63ae-4871-ba3d-f159750929ad</subsheetid><display x="315" y="15" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="e465ac71-32c9-4a5f-895c-123574268f9b" name="Filter Column between 2 numbers" type="SubSheetInfo"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><narrative>Apply Number Filter between 2 number ranges in a single column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="e63a723b-d865-44de-9c0b-317806d1c99e" name="Start" type="Start"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-105" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="workbookName" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookName" /><input type="text" name="startCell" narrative="Cell Reference From Which Filter Should Apply" stage="startCell" /><input type="number" name="coloumn" narrative="Column Number To which Filter Should Apply" stage="coloumn" /><input type="text" name="Criteria1" narrative="Criteria1 to be checked . Ex: &lt;50" stage="Criteria1" /><input type="text" name="Criteria2" narrative="Criteria2 to be checked. Ex: &gt;20" stage="Criteria2" /><input type="number" name="xlAutoFilterOperator" narrative="xlAutoFilterOperator (Eg: xlAnd is 1, xlOr is 2) ref : https://docs.microsoft.com/en-us/office/vba/api/excel.xlautofilteroperator" stage="xlAutoFilterOperator" /></inputs><onsuccess>11968476-57a5-44f4-943a-4dd63c84e105</onsuccess></stage><stage stageid="b5066a84-e935-4d68-8307-388032bc89af" name="End" type="End"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="75" y="30" /><outputs><output type="flag" name="success" narrative="Whether the operation was performed successfully" stage="success" /><output type="text" name="message" narrative="Error Message If Any" stage="message" /></outputs></stage><stage stageid="11968476-57a5-44f4-943a-4dd63c84e105" name="Filter Column between 2 numerical values" type="Code"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-60" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbookName]" /><input type="number" name="column" expr="[coloumn]" /><input type="text" name="StartCell" expr="[startCell]" /><input type="text" name="Critera_1" expr="[Criteria1]" /><input type="text" name="Criteria_2" expr="[Criteria2]" /><input type="number" name="FilterOperator" expr="[xlAutoFilterOperator]" /></inputs><outputs><output type="flag" name="Success" stage="success" /><output type="text" name="Message" stage="message" /></outputs><onsuccess>618e8c93-eb88-4ac4-b5f0-fe9a8f0ee751</onsuccess><code><![CDATA[Dim wb, excel, range As Object
Try
wb = GetWorkbook(Handle, Workbook)
excel = wb.Application
range = excel.Selection
excel.Range(StartCell).Select()
excel.Selection.AutoFilter(Field:=Column,Criteria1:=Critera_1,Operator:=FilterOperator,Criteria2:=Criteria_2)
Success = True
Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try ]]></code></stage><stage stageid="7b56da43-9c7c-4cfd-8c4a-55d65f903854" name="handle" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-225" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0c493340-5c19-4659-b173-727cdc32bcba" name="workbookName" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ae5a5b30-dda5-4f85-8ed2-c16b50242a1d" name="message" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="390" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f669a552-73e6-4f4f-ac01-9b7bc77c876f" name="success" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="315" y="-60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6bedf7c2-626a-4f2e-9c3f-597ed342f4db" name="Criteria1" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d8723a74-70d7-4ad1-961b-590533ee0147" name="coloumn" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="618e8c93-eb88-4ac4-b5f0-fe9a8f0ee751" name="Success?" type="Decision"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="75" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[success]" /><ontrue>b5066a84-e935-4d68-8307-388032bc89af</ontrue><onfalse>20e072fc-d7fe-473b-8186-f34a69931cce</onfalse></stage><stage stageid="20e072fc-d7fe-473b-8186-f34a69931cce" name="Exception" type="Exception"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="180" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="Business Exception" detail="[message]" /></stage><stage stageid="3421abe4-f022-47b0-b55b-28c21811c10d" name="startCell" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c50994b8-c88d-4510-ab5d-cee0d18dc3da" name="xlAutoFilterOperator" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9828c258-60e8-4f8b-8d26-6a6fc9e74db4" name="Inputs" type="Block"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit /><display x="-300" y="-45" w="285" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a0d990a4-2002-4d2e-bfc0-afb627494565" name="Output" type="Block"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit /><display x="270" y="-90" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="93903430-89da-4988-b247-2f2feba5d93a" name="Criteria2" type="Data"><subsheetid>573c5f2b-bbe9-4516-81c8-e4bfa4557bc7</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="46d87070-d688-4a92-8947-e8b6a577ffa0" name="Find First Filtered Row" type="SubSheetInfo"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><narrative>This action be used to find the first filtered Row number.</narrative><display x="-300" y="-195" w="240" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="914a2877-67d7-404f-9b58-661202cb10c7" name="Start" type="Start"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-15" y="-75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required cell should be sought. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="workbook" narrative="Name of the Workbook" stage="workbook" /><input type="text" name="worksheet" narrative="Name of the worksheet" stage="worksheet" /></inputs><onsuccess>610f1336-0a11-4303-9663-773fdc6ee57d</onsuccess></stage><stage stageid="e63e0c98-d10f-4edb-b140-68818843786c" name="End" type="End"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-15" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="firstRow" narrative="First Row number after applying the filters is returned" stage="firstRow" /></outputs></stage><stage stageid="610f1336-0a11-4303-9663-773fdc6ee57d" name="Find first filtered " type="Code"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[workbook]" /><input type="text" name="Worksheet" expr="[worksheet]" /></inputs><outputs><output type="text" name="firstRow" stage="firstRow" /></outputs><onsuccess>e63e0c98-d10f-4edb-b140-68818843786c</onsuccess><code><![CDATA[Dim wb, ws As Object
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
wb.Activate()
ws.Activate()
firstRow = ws.AutoFilter.Range.Offset(1).SpecialCells(12).row]]></code></stage><stage stageid="5bc6b2eb-f202-4760-8f02-38dc5aa440d0" name="handle" type="Data"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="-30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c20bf72e-03e6-4311-a61f-0d3dfd34113e" name="firstRow" type="Data"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b964891-435f-4f68-bf99-3ea4e85249b0" name="workbook" type="Data"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4aaa4093-f43e-4ceb-ab29-97a52dcbdf03" name="worksheet" type="Data"><subsheetid>c0f3d1e0-ed29-45b7-a5b1-3468f4dba55e</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b82c7aa5-92d0-430c-b3a2-31265718f5e5" name="Return Row Numbers in Filtered Range" type="SubSheetInfo"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><narrative>This action returns a text containing comma seperated row numbers in the filtered range
Prerequisite :  Activate Worksheet  before using this action</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="97e46a75-b858-4b20-a962-5edd4f0c65f2" name="Start" type="Start"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="90" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the cell to be formatted is contained. The default of zero indicates the currently active instance." stage="handle" /><input type="number" name="ColumnNumber" narrative="Any column Number to loop through all the rows" stage="ColumnNumber" /></inputs><onsuccess>9fd6aede-8e72-43d3-be4c-48e39cd58277</onsuccess></stage><stage stageid="64495a43-6d17-4152-b15b-517957349376" name="handle" type="Data"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb7da922-c909-4321-a9b6-6a094f736e7c" name="End" type="End"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="90" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Rows" narrative="Comma seperated values of the Row numbers in filtered range" stage="Rows" /></outputs></stage><stage stageid="95198701-5187-4e11-b1ae-63b6b97a8788" name="Return Row Numbers" type="Code"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="90" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="column" expr="[ColumnNumber]" /></inputs><outputs><output type="text" name="rownums" stage="Rows" /><output type="number" name="count" stage="count" /></outputs><onsuccess>cb7da922-c909-4321-a9b6-6a094f736e7c</onsuccess><code><![CDATA[Dim Inst As Object = GetInstance(handle)
Dim excel as Object = GetInstance(handle)
Dim cell as Object = excel.ActiveCell
Inst.DisplayAlerts = False
rownums = ""
'Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
'	Dim r as Object
'	r = ws.Range(Start_Cell & ":" & End_Cell)


Dim wb as Object = GetWorkbook(handle,Nothing)
'For Each cell In Range("A1:A111").SpecialCells(xlCellTypeVisible)
Count = wb.Application.WorksheetFunction.Subtotal(3, wb.ActiveSheet.AutoFilter.Range.Offset(1,0).Columns(column).SpecialCells(12))
'MsgBox(count)
For Each cell In wb.ActiveSheet.AutoFilter.Range.Offset(1,0).Columns(column).SpecialCells(12)
if count = 0 then
Exit For
else
'cell.Value = input
if rownums = "" then
rownums = (cell.Row).ToString()
else
rownums = rownums + "," + (cell.Row).ToString()
end if
count = count - 1
End IF 
Next cell

Inst.DisplayAlerts = True


'Do Until cell.Height <> 0
'cell.Offset(1, 0).Activate()
'Loop]]></code></stage><stage stageid="9fd6aede-8e72-43d3-be4c-48e39cd58277" name="Activate Workbook" type="SubSheet"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="90" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>95198701-5187-4e11-b1ae-63b6b97a8788</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="ed851300-bf48-48c0-aa31-b6b7faa26df7" name="ColumnNumber" type="Data"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="-135" y="-15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="734d1f53-59db-4bed-81be-b2e086190d39" name="count" type="Data"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit onsuccess="true" /><display x="-210" y="15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="18ea1664-cb2b-4e1d-af32-37c2d442379a" name="Rows" type="Data"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><display x="-225" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a7824875-0362-4b06-aee4-1ca2c6220840" name="Block7" type="Block"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit /><display x="-270" y="-45" w="195" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="02965583-b94d-44cb-a0d8-0f49df1665a0" name="Output" type="Block"><subsheetid>a9b37923-af30-4b5c-9372-c694da6c9f26</subsheetid><loginhibit /><display x="-270" y="60" w="120" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e2128cf0-e0e2-4341-8caa-b18ddda9fb61" name="Move Worksheet - No Display alerts" type="SubSheetInfo"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><narrative>This action can either be used to copy or move the workseet from one workbook to another workbook. This action will also hide alerts that may pop-up during the Move/Copy operation.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="8c8fad6f-8d47-4350-8882-40260d800ae5" name="Start" type="Start"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="Excel handle" stage="Handle" /><input type="text" name="Source Workbook" narrative="source workbook file name" stage="Source Workbook" /><input type="text" name="Source Worksheet" narrative="source worksheet name" stage="Source Worksheet" /><input type="text" name="Destination Workbook" narrative="destination workbook" stage="Destination Workbook" /><input type="number" name="Destination Position" narrative="destination worksheet position" stage="Destination Position" /><input type="flag" name="Copy" narrative="Copy= true and false = cut" stage="Copy" /></inputs><onsuccess>216491f7-3943-496e-98ae-3bf1a92b9bdc</onsuccess></stage><stage stageid="a39122c3-e008-4d9c-ae30-1fabec2ff42a" name="Handle" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c754b8ff-c85d-4e95-ac97-6a3895f468c7" name="Source Workbook" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2aa2a321-ec6f-4118-af08-629191d57ced" name="Source Worksheet" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d421b5b6-9b83-420e-afd6-65a81a4e7d88" name="Destination Workbook" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="957f586b-7995-4dbc-aab6-eabcad8f4733" name="Source Worksheet Exists" type="SubSheet"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="135" y="-30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." expr="[Handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." expr="[Source Workbook]" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet of interest; it will be checked for existence" expr="[Source Worksheet]" /></inputs><outputs><output type="flag" name="Worksheet Exists" narrative="Indicates whether or not the named worksheet exists" stage="Worksheet Exists" /></outputs><onsuccess>49d4b697-ece2-40e8-9b0b-4f4d6765d25f</onsuccess><processid>eacc4634-9985-4a1d-9773-8f79928708ee</processid></stage><stage stageid="24cbe3ea-fefc-4eac-99cb-8abec15748db" name="Worksheet Exists" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="210" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="49d4b697-ece2-40e8-9b0b-4f4d6765d25f" name="Worksheet Exists?" type="Decision"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="135" y="45" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Worksheet Exists]" /><ontrue>8f38a671-1623-48ca-a555-2394cf3f4b90</ontrue><onfalse>fb91478a-5d63-4e5c-9b4e-5143196ebe23</onfalse></stage><stage stageid="8f38a671-1623-48ca-a555-2394cf3f4b90" name="Move Named Worksheet - No alerts" type="Code"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="135" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="SourceWorkbook" expr="[Source Workbook]" /><input type="text" name="SourceWorksheet" expr="[Source Worksheet]" /><input type="text" name="DestinationWorkbook" expr="[Destination Workbook]" /><input type="number" name="DestinationPosition" expr="[Destination Position]" /><input type="flag" name="Copy" expr="[Copy]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>532f8b8c-a910-436b-a07b-cf77795d7de8</onsuccess><code><![CDATA[Dim dBook, sSheet As Object
Dim p As Integer

Try
getInstance(handle).DisplayAlerts = false
dBook = GetWorkbook(Handle, DestinationWorkbook)
sSheet = GetWorksheet(Handle, SourceWorkbook, SourceWorksheet)

p = Math.Max(1, DestinationPosition)
p = Math.Min(dBook.Worksheets.Count, p)

If DestinationPosition > p Then
	If Copy Then
		sSheet.Copy(After:=dBook.Worksheets(p))
	Else
		sSheet.Move(After:=dBook.Worksheets(p))
	End If
Else
	If Copy Then
		sSheet.Copy(Before:=dBook.Worksheets(p))
	Else
		sSheet.Move(Before:=dBook.Worksheets(p))
	End If
End If

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	dBook = Nothing
	sSheet = Nothing
End Try]]></code></stage><stage stageid="df7bd8f5-13b8-4521-8587-c00c3d5fb8df" name="End2" type="End"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="135" y="270" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="3949ec50-8bb9-44cf-b289-2bbf72dbcb98" name="Success" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="240" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="58e6ea89-cffb-4a00-aebe-0f08e1301b7b" name="Message" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="270" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="532f8b8c-a910-436b-a07b-cf77795d7de8" name="Success?" type="Decision"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="135" y="195" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>df7bd8f5-13b8-4521-8587-c00c3d5fb8df</ontrue><onfalse>d5b9de4c-1c31-4606-9397-720fa011a37b</onfalse></stage><stage stageid="378c0110-85d8-4ea4-8aad-5eecafafc0ea" name="Exception" type="Exception"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="345" y="195" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to copy worksheet: &quot; &amp; [Message]" /></stage><stage stageid="c857d207-71c4-40c9-905f-d7441380b638" name="Destination Position" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="ab992797-8bd3-4739-b12c-41573d964154" name="Copy" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="120" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="fb91478a-5d63-4e5c-9b4e-5143196ebe23" name="Exception" type="Exception"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="240" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Source worksheet not found&quot;" /></stage><stage stageid="216491f7-3943-496e-98ae-3bf1a92b9bdc" name="Source Worksheet Number?" type="Decision"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="IsNumber([Source Worksheet])" /><ontrue>b2b08a26-2ac7-4253-94d3-bf73add9bbb6</ontrue><onfalse>957f586b-7995-4dbc-aab6-eabcad8f4733</onfalse></stage><stage stageid="8b2e157e-2813-4738-adde-bbc94f498ae0" name="Move Numbered Worksheet1" type="Code"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="15" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="SourceWorkbook" expr="[Source Workbook]" /><input type="number" name="SourceWorksheet" expr="[Source Worksheet Number]" /><input type="text" name="DestinationWorkbook" expr="[Destination Workbook]" /><input type="number" name="DestinationPosition" expr="[Destination Position]" /><input type="flag" name="Copy" expr="[Copy]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>e8ae2569-9d5d-45d6-9951-05747453946b</onsuccess><code><![CDATA[Dim sBook, dBook As Object
Dim sSheet As Object
Dim p As Integer

Try

sBook = GetWorkbook(Handle, SourceWorkbook)
dBook = GetWorkbook(Handle, DestinationWorkbook)

sSheet = sBook.Worksheets(SourceWorksheet)

p = Math.Max(1, DestinationPosition)
p = Math.Min(sBook.Worksheets.Count, p)

If DestinationPosition > p Then
	If Copy Then
		sSheet.Copy(After:=dBook.Worksheets(p))
	Else
		sSheet.Move(After:=dBook.Worksheets(p))
	End If
Else
	If Copy Then
		sSheet.Copy(Before:=dBook.Worksheets(p))
	Else
		sSheet.Move(Before:=dBook.Worksheets(p))
	End If
End If

Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	sBook = Nothing
	dBook = Nothing
	sSheet = Nothing
End Try]]></code></stage><stage stageid="e8ae2569-9d5d-45d6-9951-05747453946b" name="anchor7" type="Anchor"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="15" y="195" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>532f8b8c-a910-436b-a07b-cf77795d7de8</onsuccess></stage><stage stageid="d5b9de4c-1c31-4606-9397-720fa011a37b" name="Copy?" type="Decision"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="240" y="195" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Copy]" /><ontrue>378c0110-85d8-4ea4-8aad-5eecafafc0ea</ontrue><onfalse>bc0aa555-fb08-4da0-9ec8-5a3faef6941e</onfalse></stage><stage stageid="bc0aa555-fb08-4da0-9ec8-5a3faef6941e" name="Exception" type="Exception"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="240" y="270" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to move worksheet: &quot; &amp; [Message]" /></stage><stage stageid="b2b08a26-2ac7-4253-94d3-bf73add9bbb6" name="Source Workbook Number" type="Calculation"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="15" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>8b2e157e-2813-4738-adde-bbc94f498ae0</onsuccess><calculation expression="[Source Worksheet]" stage="Source Worksheet Number" /></stage><stage stageid="5aeb4e44-0ad3-44cd-9215-9161fdd705e6" name="Source Worksheet Number" type="Data"><subsheetid>5f911e1c-4727-4efa-b888-9df12491a4e7</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a6516268-1eba-