0" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="275a49c4-af8d-47ac-9e8f-0d9ce792a271" name="Operation Enum {Refer Description}" type="Data"><subsheetid>95e3bf4a-4f10-4acb-8201-7e4f9d4f5c12</subsheetid><display x="-75" y="45" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bad91555-f7e7-4eec-af41-b8dece11af09" name="Block8" type="Block"><subsheetid>95e3bf4a-4f10-4acb-8201-7e4f9d4f5c12</subsheetid><loginhibit /><display x="-165" y="-225" w="180" h="450" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a5b86ed6-9ec9-4862-b423-f28c5981ce95" name="Insert Column Next to Given Cell Reference {with offset}" type="SubSheetInfo"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><narrative>Insert Column in worksheet</narrative><display x="-195" y="-120" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="ec54d713-0603-41e5-8a20-4eed6196beb8" name="End" type="End"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="120" y="195" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="text" name="Current Active_Cell" narrative="Active_Cell" stage="Active_Cell" /></outputs></stage><stage stageid="ea55f1b0-e9ae-4831-95e6-52d8e42d1750" name="Handle" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6c76d486-ba5a-4313-bc25-b14576f7544d" name="Workbook" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a45179cd-8a06-4989-b257-a944ef2e0bbf" name="Start" type="Start"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="120" y="-75" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" narrative="handle of the workbook" stage="Handle" /><input type="text" name="Workbook" narrative="Workbook Name" stage="Workbook" /><input type="text" name="Worksheet" narrative="name of the worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Ex: &quot;A1&quot;" stage="Cell Reference" /><input type="number" name="Offset No (+/-)" narrative="Offset from given Cell Ref. -ve for left &amp; =ve for right" stage="Offset" /></inputs><onsuccess>da832840-46fb-40e1-bfaa-23dbb8f5ee6f</onsuccess></stage><stage stageid="da832840-46fb-40e1-bfaa-23dbb8f5ee6f" name="Insert Column Next to Given Cell Reference {with offset}" type="Code"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="120" y="15" w="180" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="password" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell" expr="[Cell Reference]" /><input type="number" name="Offset" expr="[Offset]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="Active_Cell" stage="Active_Cell" /></outputs><onsuccess>3edfe794-de04-4e16-a82a-e2fc11511859</onsuccess><code><![CDATA[Dim wb, xlSheet1 As Object
Dim xl, range As Object
Try

wb = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = wb.Application

wb.Activate()
xlSheet1.Activate()


Dim Col_Count = xlSheet1.Range(Cell).Column

If Col_Count=1 AND offset <= 0 then
	range = xlSheet1.Range(Cell)
Else
	range = xlSheet1.Range(Cell).offset(,offset)
End if

range.Select()
range.Activate()
range.EntireColumn.Insert

Col_Count = xl.ActiveCell.Column
Active_Cell = xlSheet1.Cells(1, Col_Count).Address


Success = True

Catch e As Exception
	Success = False
	Message = e.Message
Finally
	wb = Nothing
	xl = Nothing
	range = Nothing
End Try]]></code></stage><stage stageid="3edfe794-de04-4e16-a82a-e2fc11511859" name="Success?" type="Decision"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="120" y="120" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>ec54d713-0603-41e5-8a20-4eed6196beb8</ontrue><onfalse>61ec4ccd-1b43-43f5-a311-65496f2b9f9d</onfalse></stage><stage stageid="61ec4ccd-1b43-43f5-a311-65496f2b9f9d" name="Exception" type="Exception"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="225" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to delete selection: &quot; &amp; [Message]" /></stage><stage stageid="3069d033-0c79-4132-807e-0883f385263c" name="Success" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d690fde0-448c-42fb-a224-ea11230c69ac" name="Message" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="073bc898-6548-4422-acc9-6f0689526aaa" name="Worksheet" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7a9defb4-d002-4dbc-837e-08fd0ea189e9" name="Cell Reference" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ba14a511-da00-4d4b-a368-4ebd36dc43a2" name="Offset" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><display x="-195" y="90" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e263db98-345c-40ae-a8a1-f3adac68d521" name="Block9" type="Block"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><loginhibit /><display x="-285" y="-60" w="180" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="36fa5afc-c41e-449f-ab3d-83dfb6e92e6a" name="Active_Cell" type="Data"><subsheetid>0e95339d-5324-4a85-beb5-0b18a61fe93c</subsheetid><display x="-195" y="210" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cd8e4284-0b50-412b-8a7f-6b20f7c61b65" name="Wrap/Unwrap Text in Given Range" type="SubSheetInfo"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><narrative>Wrap/Unwrap Text in Given Range
Input Parameter:
1. Handle - Handle Number
2. Workbook - Workbook Name
3. WorkSheet - Worksheetname
4. Range - Complete Range should be given. For example "A1: C73"
5. Wrap Text - True/False</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1e70486a-56d0-45da-a367-6e1f7e25c487" name="Start" type="Start"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Range" narrative="Range. Ex: &quot;A1:J27&quot; / &quot;$A$1:$J$27&quot; / &quot;A3&quot;" stage="Range" /><input type="flag" name="Wrap Text" narrative="True - Wrap Text , False - Unwrap" stage="Wrap Text" /></inputs><onsuccess>d213b7d5-ef48-4c50-b6d4-b77b4cf510a7</onsuccess></stage><stage stageid="9c2fa165-e6e5-4a36-87fe-d582402f436f" name="End" type="End"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="414011d0-e4de-42c7-a0d8-fc386f9e05bb" name="handle" type="Data"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b0ade45c-71c9-45a6-8892-5a4567bfd2b4" name="Workbook" type="Data"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c83e67fc-6769-4628-9f75-e9472ba6f96c" name="Worksheet" type="Data"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="434b137f-29e0-4922-806e-8498ba2c94aa" name="Wrap/Unwrap Text" type="Code"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><loginhibit /><display x="15" y="30" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell_Range" expr="[Range]" /><input type="flag" name="Wrap" expr="[Wrap Text]" /></inputs><onsuccess>9c2fa165-e6e5-4a36-87fe-d582402f436f</onsuccess><code><![CDATA[Dim ws as Object

ws = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet)

ws.Range(Cell_Range).WrapText = Wrap]]></code></stage><stage stageid="f49f07ac-bbfb-408e-bbde-c7b8e2d1dcc3" name="Range" type="Data"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d213b7d5-ef48-4c50-b6d4-b77b4cf510a7" name="Activate Workbook" type="SubSheet"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook]" /></inputs><onsuccess>434b137f-29e0-4922-806e-8498ba2c94aa</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="a18b8d68-a6da-4818-82ae-95f8dd457735" name="Wrap Text" type="Data"><subsheetid>d0e7e1ec-b436-43f7-8d13-19c77902f9e9</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6e1f9b36-8f22-4a2f-a7e9-837bc3725a4c" name="Filter and highlight cells within given range" type="SubSheetInfo"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><narrative>This action can be used to filter and highlight cells within the given range.
Example Range : Number between 50 to 100
</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="52a62963-0e03-4b7e-bf13-01166438fd21" name="Start" type="Start"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><preconditions><condition narrative="The excel workbook should be open and activated" /></preconditions><postconditions><condition narrative="All other instances should be closed" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="handle " narrative="handle" stage="handle" /><input type="text" name="workbook name" narrative="WorkBook Name" stage="Workbook Name" /><input type="text" name="range" narrative="Range in the worksheet. Ex:A1:B20" stage="Range" /><input type="text" name="worksheet name" narrative="Name of the worksheet" stage="worksheet name" /><input type="text" name="Criteria1" narrative="1st Condition to filter ex: &gt;50" stage="Criteria1" /><input type="text" name="Criteria2" narrative="2nd Condition to filter ex: &lt;20" stage="Criteria2" /><input type="number" name="Filter Operator" narrative="xlAutoFilterOperator (https://docs.microsoft.com/en-us/office/vba/api/excel.xlautofilteroperator )" stage="Filter Operator" /><input type="text" name="field_name" narrative="Field/Column Name if Field number not available" stage="field_name" /><input type="number" name="field_number" narrative="Column Count" stage="Field Number" /><input type="flag" name="Highlight Column Header?" narrative="Highlight Column Header?" stage="Highlight Column Header" /><input type="number" name="Color Index" narrative="Color Index(https://analysistabs.com/excel-vba/colorindex/#:~:text=VBA%20ColorIndex%20Property%20of%20Excel%20VBA%20is%20very%20useful%20to,%2D4105%20(%20or%20xlColorIndexAutomatic)" stage="Color Index" /></inputs><onsuccess>6a4016ba-40d9-4471-8232-1e7ae8280e0f</onsuccess></stage><stage stageid="23bfad1e-2922-42d0-a8fb-39115e5a618f" name="End" type="End"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="15" y="225" /></stage><stage stageid="d7f119fc-a92e-4c09-8228-b3e16d0c2709" name="handle" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-195" y="15" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef4dbf7a-edb8-42eb-b966-aa27df8be597" name="Workbook Name" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ae5d62b2-0a5d-4850-8d0f-7dd407fc3568" name="Range" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-210" y="165" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d7302fb3-87e8-400b-8be1-a560148c7174" name="worksheet name" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="-195" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="43c80aa0-2dc0-4870-bd27-cbbbe4896c90" name="Filter and Highlight Cells within a given range" type="Code"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="15" y="120" w="90" h="30" /><inputs><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="number" name="handle" expr="[handle]" /><input type="text" name="range" expr="[Range]" /><input type="number" name="Field_Number" expr="[Field Number]" /><input type="flag" name="Highlight_header" expr="[Highlight Column Header]" /><input type="number" name="Color_Index" expr="[Color Index]" /><input type="text" name="Criteria_1" expr="[Criteria1]" /><input type="text" name="Criteria_2" expr="[Criteria2]" /><input type="number" name="FilterOperator" expr="[Filter Operator]" /></inputs><onsuccess>23bfad1e-2922-42d0-a8fb-39115e5a618f</onsuccess><code><![CDATA[Try
getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range(range).AutoFilter(Field:=Field_Number, Criteria1:=Criteria_1,Operator:=FilterOperator,Criteria2:=Criteria_2)
Dim rowcount = GetWorkbook(handle, "").ActiveSheet.usedrange.columns(1).specialcells(12).count

If (rowcount >1)
	If(Highlight_header = False) Then
		getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range("1:1").EntireRow.Hidden = True
	End If

	getinstance(handle).Workbooks(workbook).Sheets(worksheet).AutoFilter.Range.Columns(Field_Number).Interior.ColorIndex = Color_Index
	getinstance(handle).Workbooks(workbook).Sheets(worksheet).Range("1:1").EntireRow.Hidden = False
End If

Catch ex as exception

End Try]]></code></stage><stage stageid="d199c54b-6fe0-4dac-83f2-35f9e497c9cb" name="Field Number" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="-195" y="135" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6a4016ba-40d9-4471-8232-1e7ae8280e0f" name="Activate Workbook" type="SubSheet"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="15" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>0d89da28-bb41-43b3-9f5a-7d6a2c2ce2fb</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="383fa045-297d-4605-ad55-b832195f9874" name="field_name" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-195" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="12c5539f-261e-439a-ad6a-b16e44d97618" name="Get Column Count" type="SubSheet"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="135" y="15" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[Workbook Name]" /><input type="text" name="worksheet" expr="[worksheet name]" /><input type="text" name="Column Name" expr="[field_name]" /></inputs><outputs><output type="number" name="Column Count" narrative="Column Count" stage="Field Number" /></outputs><onsuccess>43c80aa0-2dc0-4870-bd27-cbbbe4896c90</onsuccess><processid>9411e595-49ca-4231-9d50-8933bec4ef26</processid></stage><stage stageid="0d89da28-bb41-43b3-9f5a-7d6a2c2ce2fb" name="Field number given?" type="Decision"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><loginhibit /><display x="15" y="15" /><decision expression="IsNumber([Field Number]) = True" /><ontrue>43c80aa0-2dc0-4870-bd27-cbbbe4896c90</ontrue><onfalse>12c5539f-261e-439a-ad6a-b16e44d97618</onfalse></stage><stage stageid="b21a0a32-4bb3-44f7-ab9a-7a22ac0b086c" name="Highlight Column Header" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-210" y="195" w="180" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="624b2c5a-1de0-48d5-ad59-722a9e02a497" name="Color Index" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-210" y="225" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5dbaba91-3486-4265-ae59-ab8057291001" name="Criteria2" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-195" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="acbc3f26-4462-46c7-864a-1a9c66aefd07" name="Criteria1" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-255" y="255" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="132995df-0525-4555-b8f4-c1d46f15159d" name="Filter Operator" type="Data"><subsheetid>45ca41a9-23fc-4424-a172-bcb8cf7df820</subsheetid><display x="-225" y="285" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="df1f45fb-6179-438b-a38a-aa9115df9ce5" name="Autofill Range" type="SubSheetInfo"><subsheetid>bac5a6c0-8ef5-4326-9d33-79a08e6c2cf2</subsheetid><narrative>Autofill given range based on values present in Source Range

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- Source_range : Text : the cell range where values are already filled
- Destination_range : Text : the cell range from where values have to be filled based on source range

NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="-375" y="-225" w="300" h="180" /></stage><stage stageid="87ea820a-90ad-4982-a18d-38018e03d166" name="Fill All Visible Rows of a Column with Single Value/Formula" type="SubSheetInfo"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><narrative>Fill visible rows of a column with a single value or single formula

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- Workbook : Text : workbook name
- Sheetname : Text : Work sheet name
- From_CellRef : Text : Cell reference from where value has to be filled
- Column Letter : Text : Column letter in which value has to be filled
- Value : Text : To set cell value
NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="-285" y="-165" w="300" h="180" /></stage><stage stageid="9cdc1af9-6178-48b2-8f61-48e51513c15a" name="Start" type="Start"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><loginhibit /><narrative>Fill visible rows of a column with a single value or single formula

Params:
- handle : Number: The integer handle identifying the excel instance (0 represents 'active' instance)
- Workbook : Text : workbook name
- Sheetname : Text : Work sheet name
- From_CellRef : Text : Cell reference from where value has to be filled
- Column Letter : Text : Column letter in which value has to be filled
- Value : Text : To set cell value
NOTE - the active sheet in the instance is the one on which the cell is active</narrative><display x="15" y="-150" /><inputs><input type="number" name="handle" narrative="handle of opened workbook" stage="handle" /><input type="text" name="workbook" narrative="workbook name" stage="workbook" /><input type="text" name="Sheetname" narrative="Work sheet name" stage="Sheetname" /><input type="text" name="From_CellRef" narrative="Cell reference from where value has to be filled" stage="From_CellRef" /><input type="text" name="Column Letter" narrative="Column letter in which value has to be filled" stage="Column Letter" /><input type="text" name="Value" narrative="To set cell value" stage="Value" /></inputs><onsuccess>2e4bf81b-a2cf-41e9-95f8-39811d377652</onsuccess></stage><stage stageid="8d64bafd-f387-4387-a299-f796b79ff800" name="End" type="End"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="2e4bf81b-a2cf-41e9-95f8-39811d377652" name="Activate Workbook" type="SubSheet"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><loginhibit /><display x="15" y="-75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>6bf6961a-109c-430d-8139-75f8eaf5278b</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="6bf6961a-109c-430d-8139-75f8eaf5278b" name="Fill All Visible Rows of a Column" type="Code"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><loginhibit /><narrative>FindCount = 0
Try
'For Each  c  as System.Data.DataRow In SearchValuesAndRange.Rows
 FindCount = getinstance(Handle).Workbooks(workbook).Worksheets(Worksheet).Range("A1").Find(Value,lookin:=-4163,LookAt:=2).Address
Success = True
Catch e As Exception
	Success = False
	Message = e.Message

End Try</narrative><display x="15" y="0" w="150" h="30" /><inputs><input type="text" name="workbook" expr="[workbook]" /><input type="text" name="worksheet" expr="[Sheetname]" /><input type="text" name="From_CellRef" expr="[From_CellRef]" /><input type="text" name="Col_Letter" expr="[Column Letter]" /><input type="text" name="Value" expr="[Value]" /><input type="number" name="handle" expr="[handle]" /></inputs><onsuccess>8d64bafd-f387-4387-a299-f796b79ff800</onsuccess><code><![CDATA[Dim  wb,ws As Object
Dim excel, xlsheet1, cell_range, col As Object

From_CellRef = Replace(From_CellRef,"$","")

wb = GetWorkbook(handle, workbook)
ws = GetWorksheet(handle, workbook, worksheet)
wb.Activate()
ws.Activate()
excel = ws.Application
xlsheet1 = excel.ActiveSheet
col = ws.Range(Col_Letter & 1).Column

cell_range = Col_Letter & "" & ws.Cells(ws.Rows.Count, col).End(-4162).Row

ws.Range(From_CellRef,cell_range).SpecialCells(12).FormulaR1C1 = Value
]]></code></stage><stage stageid="e77ba92f-006b-489f-9916-909d046861ed" name="From_CellRef" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c25f915d-a9e2-4990-bd10-2c304c5bc3f1" name="Value" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a16c509a-ce89-451d-bb35-7fe3fa12c72a" name="Column Letter" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c805fbe1-1bfe-44c0-8c4a-2cc9976daf09" name="handle" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6989204a-b3b2-4f73-8154-b1930996e25f" name="Sheetname" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="48497a0e-6308-45e1-965c-4288e5625347" name="workbook" type="Data"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><display x="-285" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f73d4fbe-7605-446c-b208-577886d166c3" name="Parameters" type="Block"><subsheetid>177648f9-feef-49b8-9122-744fffadf446</subsheetid><loginhibit /><display x="-360" y="-60" w="150" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="076dce62-63df-44af-8a22-e86ab14d914a" name="Get Column Letter for Given Column Position" type="SubSheetInfo"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><narrative>Code stage returns the column letter of given column position number</narrative><display x="-165" y="-120" w="420" h="90" /></stage><stage stageid="c8ff3671-1324-4574-b1f0-064dc7ab8e73" name="Get Column Letter for Given Column Position" type="Code"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="180" y="-30" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="ColPos" expr="[Column Position]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="Column Letter" stage="Column Letter" /></outputs><onsuccess>bb4c30d0-6243-4bfd-befe-1ac9d7d26351</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try
'xl = GetInstance(handle)
xlBook  = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = xlSheet1.Application

'Get column address
'Dim Col_Count = xl.Match(ColValue, xlBook.Sheets(Worksheet).Range("1:1"), 0)
Column_Letter = Replace(xlSheet1.Cells(1, ColPos).Address(False, False), "1", "")

Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="150a3d9c-f8cb-4c05-9184-0538ef2d5c6e" name="Start" type="Start"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><loginhibit /><display x="180" y="-120" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Work Book Name" narrative="Work Book Name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work Sheet Name" stage="Worksheet" /><input type="number" name="Column Position" narrative="Column Position" stage="Column Position" /></inputs><onsuccess>c8ff3671-1324-4574-b1f0-064dc7ab8e73</onsuccess></stage><stage stageid="508310ba-1359-43f1-aa99-19b3286735de" name="handle" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-60" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b0b6b77-13ad-4234-a0f9-0f45d4b4e0a2" name="Workbook" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-60" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d75373e6-2d5d-45a6-9d85-9856c0fc1d59" name="Worksheet" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-60" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="162c233c-5266-4c41-8950-5aba9bf5dd3a" name="Success" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-285" y="-15" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bf10203f-63cc-4a9b-adb9-9cb9393c1dc5" name="Message" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-285" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8377b0f3-43dd-4636-adc8-9035533e35da" name="Input parameters" type="Block"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><loginhibit /><display x="-165" y="-60" w="210" h="195" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="2743f47a-58ad-430d-a340-a62dfcd18a10" name="Output Parameters" type="Block"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><loginhibit /><display x="-390" y="-60" w="210" h="165" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="bb4c30d0-6243-4bfd-befe-1ac9d7d26351" name="End" type="End"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><loginhibit /><display x="180" y="60" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /><output type="text" name="Column Letter" narrative="Name of the column (Letter/ text) " stage="Column Letter" /></outputs></stage><stage stageid="c6d9fd67-066e-4c3f-9e49-1e013cb71306" name="Column Letter" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-285" y="75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d5bfd734-aa99-4d23-84e7-5e69e319002a" name="Column Position" type="Data"><subsheetid>2294626a-e0c2-490c-92c2-a5dc6bf10bbc</subsheetid><display x="-60" y="105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38b6d355-06c8-4aed-b898-426836749b0e" name="Get Column Letter &amp; Position for Given Col Name" type="SubSheetInfo"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><narrative>Code stage returns the column letter &amp; position for the cell with the given value</narrative><display x="-165" y="-120" w="420" h="90" /></stage><stage stageid="6bd6cf8e-08b3-4e2e-a38c-484e4e74bcac" name="Get Column Letter &amp; Position  for given Column Name" type="Code"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="180" y="-30" w="180" h="90" /><inputs><input type="number" name="Handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="ColValue" expr="[Column Value]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="Column Letter" stage="Column Letter" /><output type="number" name="Col_Count" stage="Column Count" /></outputs><onsuccess>6473d6fd-b82f-4ddf-8143-d0c2e57351a6</onsuccess><code><![CDATA[Dim xl As Object
Dim xlBook As Object
Dim xlSheet1 As Object

Try
'xl = GetInstance(handle)
xlBook  = GetWorkbook(Handle, Workbook)
xlSheet1 = GetWorksheet(Handle, Workbook, Worksheet)
xl = xlSheet1.Application

'Get column address
Col_Count = xl.Match(ColValue, xlBook.Sheets(Worksheet).Range("1:1"), 0)
Column_Letter = Replace(xlSheet1.Cells(1, Col_Count).Address(False, False), "1", "")

Success = True

Catch e As Exception
	Success = False
	Message = e.Message

Finally
	xlSheet1 = nothing
    xlBook = nothing
    xl = nothing

End Try]]></code></stage><stage stageid="97362a94-134c-4f4c-aeed-a6dcc7b604bd" name="Start" type="Start"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><loginhibit /><display x="180" y="-120" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Work Book Name" narrative="Work Book Name" stage="Workbook" /><input type="text" name="Work Sheet Name" narrative="Work Sheet Name" stage="Worksheet" /><input type="text" name="Column Name" narrative="Column Name" stage="Column Value" /></inputs><onsuccess>6bd6cf8e-08b3-4e2e-a38c-484e4e74bcac</onsuccess></stage><stage stageid="47bb2411-ecf1-421b-81e2-9472044d9d50" name="handle" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-60" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0c93248a-b0ec-4667-967e-57e7396cbb20" name="Workbook" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-60" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f07a88ec-cecd-4470-acfb-a9587f958c7e" name="Worksheet" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-60" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="35d7f431-40ae-4fa0-9142-9aa1a15cf5c1" name="Column Value" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-60" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d6c54d6f-c493-4e30-a8b2-1c3df63beaf3" name="Success" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-285" y="-30" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c204f9b-0c19-4b53-831c-deb6d939c566" name="Message" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-285" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b85e440-ff5f-4ba5-90e9-0a8d0ce4a525" name="Input parameters" type="Block"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><loginhibit /><display x="-165" y="-60" w="210" h="195" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="0f6aa750-48a9-477d-a2ed-916ed9277653" name="Output Parameters" type="Block"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><loginhibit /><display x="-390" y="-60" w="210" h="195" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="6473d6fd-b82f-4ddf-8143-d0c2e57351a6" name="End" type="End"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><loginhibit /><display x="180" y="60" /><outputs><output type="flag" name="Success" narrative="Whether the operation was performed successfully" stage="Success" /><output type="text" name="Message" narrative="Error message on failure" stage="Message" /><output type="text" name="Column Letter" narrative="Name of the column (Letter/ text) " stage="Column Letter" /><output type="number" name="Column Position" narrative="Column Position" stage="Column Count" /></outputs></stage><stage stageid="37d5ce03-caf3-43bf-863b-e204141acc04" name="Column Letter" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-285" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e36f99cf-9d59-43ba-8108-ba36eb5edabb" name="Column Count" type="Data"><subsheetid>f5f3205a-f03a-4b53-b1ed-8a2e58d4139c</subsheetid><display x="-285" y="105" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9ab73c11-2c59-4753-a6a6-9a6a4bbcd83c" name="Add New Note" type="SubSheetInfo"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><narrative>Add New Note. Any previous comments will be replaced with new note.
Input Parameter:
1. Handle - Handle Number
2. Workbook - Workbook Name
3. WorkSheet - Worksheetname
4. Cell Reference - Works with single Cell Reference
5. Note - Note to be added</narrative><display x="-195" y="-135" w="150" h="120" /></stage><stage stageid="22fa8c37-7d21-47e5-8aab-10410f8087a0" name="Start" type="Start"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Cell Reference. Ex: &quot;A3&quot;" stage="Range" /><input type="text" name="Note" narrative="Note/Comment/Instruction/Guideline" stage="Note" /></inputs><onsuccess>e842f832-f8ce-4270-be6b-00da087d9eb1</onsuccess></stage><stage stageid="ceeafca5-61c8-4d81-b883-ea81e6a7ad8f" name="End" type="End"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><loginhibit /><display x="15" y="150" /></stage><stage stageid="d2f1425c-4265-4357-b7a5-e272aeaa9bd4" name="handle" type="Data"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0077102d-bf11-48db-9673-db74fa52e41e" name="Workbook" type="Data"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="61482177-c900-43d2-9273-115e5bb962c2" name="Worksheet" type="Data"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b94cf35-ee78-43b5-9832-802c879fad31" name="Add Note" type="Code"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><loginhibit /><display x="15" y="90" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell_Range" expr="[Range]" /><input type="flag" name="Note" expr="[Note]" /></inputs><onsuccess>ceeafca5-61c8-4d81-b883-ea81e6a7ad8f</onsuccess><code><![CDATA[Dim ws as Object

ws = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet)

ws.Range(Cell_Range).AddComment(Note)]]></code></stage><stage stageid="1f048559-5529-48ce-8b3a-e2ccebc640b5" name="Range" type="Data"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e842f832-f8ce-4270-be6b-00da087d9eb1" name="Activate Workbook" type="SubSheet"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook]" /></inputs><onsuccess>3944e42c-12a1-48b7-97c0-ea01d8b22fa4</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="6e914968-5596-43b8-a9f8-242e898f07a2" name="Note" type="Data"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3944e42c-12a1-48b7-97c0-ea01d8b22fa4" name="Delete Note" type="SubSheet"><subsheetid>3239a27e-58f9-4d8d-95db-21779c725c84</subsheetid><loginhibit /><display x="15" y="30" w="120" h="30" /><inputs><input type="number" name="Handle" narrative="Handle" expr="[handle]" /><input type="text" name="Workbook" narrative="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" narrative="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell Reference" narrative="Cell Reference. Ex: &quot;A3&quot;" expr="[Range]" /></inputs><onsuccess>0b94cf35-ee78-43b5-9832-802c879fad31</onsuccess><processid>29d386a0-114a-4c25-b31a-1191d910b854</processid></stage><stage stageid="80273eb0-2fe3-48e8-b9a0-031a199f318d" name="Append New Note to Existing One" type="SubSheetInfo"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><narrative>Append new note at the end of existing note in a given cell.
Input Parameter:
1. Handle - Handle Number
2. Workbook - Workbook Name
3. WorkSheet - Worksheetname
4. Cell Reference - Works with single Cell Reference
5. New Note - Note to be appended at the end
6. Delimiter Ascii No - Ascii no of a delimiter to separate existing note with new note. Ex: "Next Line - 10, Semicolon - 59"

Output:
1. New Note: New note set for the given cell</narrative><display x="-195" y="-135" w="150" h="120" /></stage><stage stageid="623735e7-9d43-4b2c-b598-b499c2e06a86" name="Start" type="Start"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Cell Reference. Ex: &quot;A3&quot;" stage="Range" /><input type="text" name="New Note" narrative="New Note/Comment/Instruction/Guideline" stage="New Note" /><input type="number" name="Delimiter Ascii No" narrative="Ascii number of a delimiter to separate from existing text with appended text" stage="Delimiter Ascii No" /></inputs><onsuccess>4bb3e288-2d3c-4369-9824-54794c17eb6c</onsuccess></stage><stage stageid="6ee814be-1b73-49c7-b98b-f5fbb1ba89c4" name="End" type="End"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="text" name="New Note" narrative="New Note" stage="New Note" /></outputs></stage><stage stageid="08e289a9-cfbc-4fa2-941c-c1955e1d5462" name="handle" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2dafc254-d60d-4e76-bcd1-a6f1106fdbe0" name="Workbook" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bc8d4665-0346-449b-8955-e247bebb1755" name="Worksheet" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3127d0fb-6afd-4a23-9f85-c69fc5ea8abe" name="Append Note" type="Code"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><loginhibit /><display x="15" y="30" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell_Reference" expr="[Range]" /><input type="text" name="Note" expr="[New Note]" /><input type="number" name="Delimiter" expr="[Delimiter Ascii No]" /></inputs><outputs><output type="text" name="comment" stage="New Note" /></outputs><onsuccess>6ee814be-1b73-49c7-b98b-f5fbb1ba89c4</onsuccess><code><![CDATA[Dim ws as Object
Dim Existing_Text as Object

ws = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet)

Existing_Text = ""

If Not ws.Range(Cell_Reference).Comment Is Nothing Then
	Existing_Text = ws.Range(Cell_Reference).Comment.Existing_Text
	'MsgBox(Existing_Text)
	ws.Range(Cell_Reference).Comment.Delete
End If

If Existing_Text <> "" AND Note <> ""
	comment = Existing_Text & Chr(Delimiter) & Note
	'MsgBox(comment)
	ws.Range(Cell_Reference).AddComment(comment)
Else
	comment = Existing_Text & Note
	ws.Range(Cell_Reference).AddComment(comment)
End If]]></code></stage><stage stageid="46e6ae0f-e8da-419e-83da-ccd2c66e188e" name="Range" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4bb3e288-2d3c-4369-9824-54794c17eb6c" name="Activate Workbook" type="SubSheet"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook]" /></inputs><onsuccess>3127d0fb-6afd-4a23-9f85-c69fc5ea8abe</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="4b11d1a1-4d16-4ecb-94b6-6566d9483259" name="Existing Note" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="150" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c8a974a-93d1-4a3f-b6a0-40980c7bb1ed" name="New Note" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="90" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eb72c176-d2dd-4c2b-a864-a0c08acdae89" name="Delimiter Ascii No" type="Data"><subsheetid>bd8e6103-a019-4f68-ab7e-f639bf8b881e</subsheetid><display x="-195" y="120" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b78a916-2f49-46a9-8415-07da87a867fe" name="Get Note from a Given Cell" type="SubSheetInfo"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><narrative>Returns note of a gievn cell
Input Parameter:
1. Handle - Handle Number
2. Workbook - Workbook Name
3. WorkSheet - Worksheetname
4. Cell Reference - Works with single Cell Reference

Output:
1. Note - Text to be returned</narrative><display x="-225" y="-135" w="150" h="120" /></stage><stage stageid="a5e318a2-97f5-4993-aa66-8ec32e853f99" name="Start" type="Start"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Cell Reference. Ex: &quot;A3&quot;" stage="Range" /></inputs><onsuccess>e0154e6b-9fef-4586-a56c-6aeb1cae0930</onsuccess></stage><stage stageid="afbf354a-d835-4312-8b32-031be1574b19" name="End" type="End"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="text" name="Note" narrative="Note" stage="Note" /></outputs></stage><stage stageid="23c0e43d-0425-4fc2-994c-db87b3902145" name="handle" type="Data"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><display x="-225" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5305cb97-dd33-4bea-ba83-e68a23df52f6" name="Workbook" type="Data"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><display x="-225" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bcb8fee6-66ae-4ddb-b3c1-ddf4ce502b09" name="Worksheet" type="Data"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><display x="-225" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="acbb9e6b-40b3-4230-b93e-c106b2e371d7" name="Get Note" type="Code"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><loginhibit /><display x="15" y="45" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell_Range" expr="[Range]" /></inputs><outputs><output type="text" name="Note" stage="Note" /></outputs><onsuccess>afbf354a-d835-4312-8b32-031be1574b19</onsuccess><code><![CDATA[
Dim ws as Object

ws = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet)

If Not ws.Range(Cell_Range).Comment Is Nothing Then
	If ws.Range(Cell_Range).Comment.Text <> "" Then
		Note = ws.Range(Cell_Range).Comment.Text
	Else
		Note = ""
	End If
End If
]]></code></stage><stage stageid="891ee299-733a-4d33-b1f1-f54ca4fd989b" name="Range" type="Data"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><display x="-225" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e0154e6b-9fef-4586-a56c-6aeb1cae0930" name="Activate Workbook" type="SubSheet"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook]" /></inputs><onsuccess>acbb9e6b-40b3-4230-b93e-c106b2e371d7</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="d90efc51-7c97-42ba-b7e1-3459b5a682ee" name="Note" type="Data"><subsheetid>ebb4db57-2be9-421b-bd93-c7de6aa1c0d4</subsheetid><display x="-225" y="90" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="aef599d7-779a-4419-9df5-584c6269c9a4" name="Delete Note" type="SubSheetInfo"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><narrative>Delete Note if exists
Input Parameter:
1. Handle - Handle Number
2. Workbook - Workbook Name
3. WorkSheet - Worksheetname
4. Cell Reference - Works with single Cell Reference
</narrative><display x="-195" y="-120" w="150" h="90" /></stage><stage stageid="f31f5685-78e9-4510-b7e1-7662502b2e0b" name="Start" type="Start"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Handle" stage="handle" /><input type="text" name="Workbook" narrative="Workbook" stage="Workbook" /><input type="text" name="Worksheet" narrative="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" narrative="Cell Reference. Ex: &quot;A3&quot;" stage="Range" /></inputs><onsuccess>462edd7f-6233-47ee-94db-fe35f42fbbb7</onsuccess></stage><stage stageid="0ecc5a70-fa3f-44ee-9d15-e8daab61358c" name="End" type="End"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><loginhibit /><display x="15" y="105" /></stage><stage stageid="fa9ccd52-439e-4b44-a94a-1f79e861cdb9" name="handle" type="Data"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a25ab6a8-d016-4619-be6b-832f81592c7d" name="Workbook" type="Data"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><display x="-195" y="0" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9d598588-7acc-47c0-9076-f62fac3938c6" name="Worksheet" type="Data"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><display x="-195" y="30" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="697a9fa2-602a-42d5-88cc-b390d701c369" name="Delete Note" type="Code"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><loginhibit /><display x="15" y="30" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Cell_Range" expr="[Range]" /></inputs><onsuccess>0ecc5a70-fa3f-44ee-9d15-e8daab61358c</onsuccess><code><![CDATA[
Dim ws as Object

ws = getinstance(handle).Workbooks(Workbook).Sheets(Worksheet)

If Not ws.Range(Cell_Range).Comment Is Nothing Then
	If ws.Range(Cell_Range).Comment.Text <> "" Then
		ws.Range(Cell_Range).Comment.Delete
	End If
End If

]]></code></stage><stage stageid="051a2dda-c0cf-4501-b6e1-fbef3fc97336" name="Range" type="Data"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><display x="-195" y="60" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="462edd7f-6233-47ee-94db-fe35f42fbbb7" name="Activate Workbook" type="SubSheet"><subsheetid>29d386a0-114a-4c25-b31a-1191d910b854</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="[Workbook]" /></inputs><onsuccess>697a9fa2-602a-42d5-88cc-b390d701c369</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="1d5873b3-5036-4865-848d-3908ac86763b" name="Set Cell Color" type="SubSheetInfo"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><narrative>Fills the the specified range of cells with given color (RGB values)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d7cc8e98-039a-45f7-9c97-f98dbebdfb57" name="Start" type="Start"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Mandatory : Specify the workbook name to be used" stage="Workbook" /><input type="text" name="Worksheet" narrative="Mandatory : Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /><input type="text" name="Reference" narrative="Mandatory : Range - cell reference ex :(A1:B1) or Cell name (ex;B1)" stage="Reference" /><input type="number" name="Red value" narrative="Mandatory : 0-255" stage="R value" /><input type="number" name="Green value" narrative="Mandatory : 0-255" stage="G Value" /><input type="number" name="Blue value" narrative="Mandatory : 0-255" stage="B Value" /></inputs><onsuccess>89fd724d-dd2a-42ad-822f-50079e3d0cfc</onsuccess></stage><stage stageid="d3a06b23-b4ed-4925-8935-b89274fbc700" name="End" type="End"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="89fd724d-dd2a-42ad-822f-50079e3d0cfc" name="set cell color" type="Code"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Reference]" /><input type="number" name="R" expr="[R value]" /><input type="number" name="G" expr="[G Value]" /><input type="number" name="B" expr="[B Value]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>387447d0-7ab8-42e7-ab63-496521e4eacc</onsuccess><code><![CDATA[Dim wb,ws,xlSheet1,xl,range As Object

Try
GetInstance(handle).DisplayAlerts = false
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
xl = ws.Application
xlSheet1 = xl.ActiveSheet
xlSheet1.Range(Reference).interior.color=RGB(R,G,B)

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                xl = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="4eb37f69-beff-4c57-8ead-b41a60e3345e" name="Message" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3652c27e-7822-48bc-b161-dbfdd88fc4a3" name="Success" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e28edc9-17ec-4965-9d63-61f82b812174" name="Workbook" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d43664e7-3517-40af-8798-41a27939af82" name="Handle" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="51c0a983-b932-43e4-84ca-e6b5f76d0cd5" name="Worksheet" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="01247646-c090-40c8-8bb1-645d81a2f928" name="Reference" type="Data"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0639aabd-25cb-4de9-982f-bc2bec28f93b" name="Inputs" type="Block"><subsheetid>1ff43e7e-74cf-426e-8dc7-6b43c46cf679</subsheetid><loginhibit onsuccess="true" /><display x="-270" y="-30" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="72892ce2-7f1c-4613-9180-