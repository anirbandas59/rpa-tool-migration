tem actions in this object. NB not the same as a Mapiex ID." expr="[coll_Item Data.EntryID]" /><input type="text" name="Folder Path" friendlyname="Folder Path" narrative="The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." expr="[txt_Local Folder Name]" /><input type="text" name="File Name" friendlyname="File Name" narrative="Name of pattern of the file to be saved. common cases inlcude &quot;.docx&quot; , &quot;.pdf&quot; , &quot;.xlsx&quot; etc." expr="[coll_Split Values.Attachment]" /><input type="text" name="AsFileName" friendlyname="AsFileName" narrative="Save as file name" expr="Left([txt_Attachment Name], [coll_ConfigFileData.Attachment Character Limit])" /></inputs><onsuccess>37504703-89a2-4cca-93b8-ef43a2f572da</onsuccess><resource object="MS Outlook Extended VBO" action="Save specific Attachment As" /></stage><stage stageid="0565e0a7-53c1-447a-9031-f3f273b9eaf6" name="Check Attachment Length" type="Decision"><subsheetid>fec61eef-8ae9-473b-9ca0-2cd38dd396d6</subsheetid><loginhibit onsuccess="true" /><display x="15" y="150" /><decision expression="Len(Trim([coll_Split Values.Attachment]))&lt;=ToNumber([coll_ConfigFileData.Attachment Character Limit])" /><ontrue>4c8af291-b8f3-497b-8c52-7c2c4083371d</ontrue><onfalse>62390f26-6291-4827-b04b-abf7a9ab6c49</onfalse></stage><stage stageid="aefae60a-4285-40d2-b71a-5b7bf0e35c5e" name="Set Status" type="Calculation"><subsheetid>8f814e4a-ce3a-4fd2-8a04-5f2b890ceba7</subsheetid><loginhibit onsuccess="true" /><display x="330" y="165" /><onsuccess>f4ec6a45-3020-46a4-ae6e-e3dcd0909e0f</onsuccess><calculation expression="&quot;Got Items&quot;" stage="txt_Queue Status" /></stage><stage stageid="f214215a-03b1-423b-9b2a-aeb754a6570f" name="txt_Queue Status" type="Data"><loginhibit onsuccess="true" /><display x="-360" y="450" w="180" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="5b7cb785-3b4a-4530-9d3b-4e5399ac2e08" name="Check Queue Status" type="Decision"><loginhibit onsuccess="true" /><display x="210" y="-300" /><decision expression="Trim([txt_Queue Status])&lt;&gt;&quot;&quot;" /><ontrue>8c3fb001-6b73-426b-af49-3a17ac111f5a</ontrue><onfalse>866503d0-d338-4637-aa3a-5f341a195719</onfalse></stage><stage stageid="8c3fb001-6b73-426b-af49-3a17ac111f5a" name="Anchor51" type="Anchor"><loginhibit onsuccess="true" /><display x="135" y="-300" w="10" h="10" /><onsuccess>c826a57b-0f88-4dd1-b414-6b733f143bcf</onsuccess></stage><stage stageid="c826a57b-0f88-4dd1-b414-6b733f143bcf" name="Anchor52" type="Anchor"><loginhibit onsuccess="true" /><display x="135" y="-195" w="10" h="10" /><onsuccess>8e11c6b6-0605-4b1a-b8f2-deb0384b0fc7</onsuccess></stage><stage stageid="0ffa0fda-db26-41c1-b0dc-88bdee211494" name="Set Status" type="Action"><subsheetid>e5ead44f-6e56-4826-bf5f-5fc4eb9514ae</subsheetid><loginhibit onsuccess="true" /><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="15" y="-60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[txt_Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;SYSTEM EXCEPTION&quot;" /></inputs><onsuccess>5121681e-f653-40a2-a0af-850e7093fb44</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="7e1c9f91-0aa6-4df5-bf22-0cc455f2e6a2" name="Set Status" type="Action"><subsheetid>e5ead44f-6e56-4826-bf5f-5fc4eb9514ae</subsheetid><loginhibit onsuccess="true" /><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="495" y="-165" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[txt_Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;BUSINESS EXCEPTION&quot;" /></inputs><onsuccess>d8c11e8a-14c9-436a-9af3-92eecbc0977c</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="4b1d2f1d-4930-4d76-aec3-694aafd94f58" name="Check Status" type="Decision"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-255" y="-45" w="90" h="30" /><decision expression="Trim(Lower([In_txt_Queue Item Status]))=&quot;completed&quot;" /><ontrue>b6b4f1e9-7590-46aa-b899-ee35b78acd6f</ontrue><onfalse>2bcbd198-5afb-40e1-872b-f4985d80b974</onfalse></stage><stage stageid="1ccdd681-33b8-4f12-991d-96ff445ad213" name="dt_Completed DateTime" type="Data"><loginhibit onsuccess="true" /><display x="-360" y="855" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38b7534b-923f-48f9-b149-492d9ad63d9e" name="Total Time Spent" type="Data"><loginhibit onsuccess="true" /><display x="-360" y="885" w="180" h="30" /><datatype>timespan</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="76f7956e-1475-4f67-9d5d-4ff5496bd8a5" name="Get Item Data" type="Action"><loginhibit onsuccess="true" /><narrative>Get data relating to an item in a queue. You do not need to have a lock on the item to do this.</narrative><display x="90" y="150" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to get data from. An error will be raised if this item does not exist." expr="[txt_Item ID]" /></inputs><outputs><output type="text" name="Key" friendlyname="Key" narrative="The key value of the item." stage="txt_Key" /><output type="number" name="Priority" friendlyname="Priority" narrative="The priority of the item" stage="" /><output type="text" name="Status" friendlyname="Status" narrative="The status of the item." stage="txt_Status" /><output type="number" name="Attempts" friendlyname="Attempts" narrative="The number of attempts already made to work this item." stage="" /><output type="timespan" name="Worktime" friendlyname="Worktime" narrative="The total time spent on this item (including previous attempts)" stage="Total Time Spent" /><output type="timespan" name="Attempt Worktime" friendlyname="Attempt Worktime" narrative="The amount of time spent on this particular attempt of the item" stage="" /><output type="datetime" name="Loaded DateTime" friendlyname="Loaded DateTime" narrative="The date and time at which this item was first loaded into the queue." stage="dt_Loaded DateTime" /><output type="datetime" name="Deferred DateTime" friendlyname="Deferred DateTime" narrative="The date and time at which this item has been deferred to. Empty if this item has not been deferred." stage="" /><output type="datetime" name="Completed DateTime" friendlyname="Completed DateTime" narrative="The date and time at which this item was marked as complete. Empty if this item has not been marked as complete" stage="dt_Completed DateTime" /><output type="datetime" name="Exception DateTime" friendlyname="Exception DateTime" narrative="The date and time at which this item was marked as an exception. Empty if there has never been an exception on this item." stage="" /><output type="text" name="Exception Reason" friendlyname="Exception Reason" narrative="The exception reason recorded against this item." stage="" /><output type="text" name="Tags" friendlyname="Tags" narrative="The semi-colon separated set of tags which apply to the item. " stage="txt_Tags" /><output type="collection" name="Data" friendlyname="Data" narrative="The data associated with the item - a single collection row." stage="" /></outputs><onsuccess>412cb26b-caa7-4247-8672-71c6cb4537a9</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Item Data" /></stage><stage stageid="181cdd0f-1664-4f2d-b5d8-b64d173d71b1" name="In_txt_Process Name" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="-105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3d362852-2ea6-41a6-8924-b1edada7b953" name="In_txt_ItemId" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="-75" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0a4716a8-78dd-4ac5-aae3-26cc663b962f" name="In_txt_ItemKey" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="-45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="79b28d41-59cc-4d8c-ad55-4cdc685cd279" name="In_dt_InputDataReceivedOn" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="-15" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="652f7fb6-384c-4111-862c-6acd0ebd8a0b" name="In_dt_ItemCreatedOn" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="15" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cc2bf6a2-9fee-4098-81db-b2c90dae8a77" name="In_dt_ItemCompletedOn" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="45" w="180" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="50fc56dd-10c8-49be-84dd-519bd263698f" name="In_Total Work Time" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="75" w="180" h="30" /><datatype>timespan</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6e12f69c-f973-4c17-80a1-a421bf3a242b" name="In_txt_Queue Item Status" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e56db1b8-8bd7-4f8d-83dd-76a30b63b20d" name="In_txt_Final Outcome" type="Data"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-540" y="135" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd7dca92-5235-477f-838d-913758e3e1fb" name="sendDataToDataGateways" type="Data"><loginhibit onsuccess="true" /><display x="-360" y="480" w="180" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><exposure>Session</exposure><alwaysinit /></stage><stage stageid="954e5236-f3e5-4e78-9cfe-c69033cf87c9" name="Inputs" type="Block"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><display x="-645" y="-135" w="210" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7d7643e6-ae7f-4f2e-ad16-2fa82983e407" name="Send Data to Data Gateways" type="Action"><subsheetid>10679a12-816c-43cb-a248-1a6b157a7504</subsheetid><loginhibit onsuccess="true" /><narrative>This action can be used to serialize and send a Blue Prism collection to the data gateway. 
    There is a limit of approximately ~4MB on the data that can be sent through this method. 
    This is due to limitations enforced by the JSON Serializer.</narrative><display x="-195" y="15" w="90" h="30" /><inputs><input type="text" name="Process Name" friendlyname="Process Name" narrative="Process Name" expr="[In_txt_Process Name]" /><input type="text" name="Item Id" friendlyname="Item Id" narrative="Unique id to investigate from Blue Prism database" expr="[In_txt_ItemId]" /><input type="text" name="Item Key" friendlyname="Item Key" narrative="Unique id to help business team connect to the transaction" expr="[In_txt_ItemKey]" /><input type="datetime" name="Input Data Received On" friendlyname="Input Data Received On" narrative="Time when input was available for the bot. Example Email reveived on, Input received from SAP etc." expr="[In_dt_InputDataReceivedOn]" /><input type="datetime" name="Item Created On" friendlyname="Item Created On" narrative="Time when item is loaded into the queue" expr="[In_dt_ItemCreatedOn]" /><input type="datetime" name="Item Completed On" friendlyname="Item Completed On" narrative="Completed time for the item. Helps calculate TAT" expr="[In_dt_ItemCompletedOn]" /><input type="timespan" name="Total Work Time" friendlyname="Total Work Time" narrative="Handling time for the transaction" expr="[In_Total Work Time]" /><input type="text" name="Queue Item Status" friendlyname="Queue Item Status" narrative="COMPLETED, COMPLETED WITHOUT OUTCOME, SYSTEM EXCEPTION, BUSINESS EXCEPTION" expr="[In_txt_Queue Item Status]" /><input type="text" name="Final Outcome" friendlyname="Final Outcome" narrative="Applicable only in case of BUSINESS EXCEPTION, SYSTEM EXCEPTION or COMPLETED WITHOUT OUTCOME" expr="[In_txt_Final Outcome]" /><input type="text" name="Resource VM" friendlyname="Resource VM" narrative="Resource VM name" expr="GetResourceName()" /></inputs><onsuccess>d264c98c-a086-4678-97c5-cdfac720474c</onsuccess><resource object="Utility_DataGateways-CustomFramework" action="Send Data to Data Gateways" /></stage><stage stageid="412cb26b-caa7