</narrative><display x="-180" y="-135" w="240" h="60" /></stage><stage stageid="b1a36775-f579-4945-8b24-8e763d9ee14a" name="Get Sharepoint Credentials" type="SubSheetInfo"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><narrative>Get Sharepoint Tenant ID, Client ID , Client secret key from credential manager</narrative><display x="-180" y="-45" w="150" h="90" /></stage><stage stageid="aaf4d9b9-ddee-4e57-965f-a554c1338921" name="Start" type="Start"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><preconditions><condition narrative="Credential should be present in blueprism credential manager" /></preconditions><postconditions><condition narrative="None" /></postconditions><display x="15" y="-150" /><onsuccess>b59f093b-60cb-4b0f-94c0-72a8f71942d0</onsuccess></stage><stage stageid="dfa437f4-85aa-4467-914a-bfb7a7a5bdfa" name="End" type="End"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="15" y="150" /><outputs><output type="password" name="Tenant ID" narrative="Tenant ID for Sharepoint" stage="Tenant ID" /><output type="password" name="Client ID" narrative="Client ID for Sharepoint" stage="Client ID" /><output type="password" name="Client Secret Key" narrative="Client Secret Ket for Sharepoint" stage="Client_Secret" /></outputs></stage><stage stageid="a7889b1a-6518-446f-a59d-52cd1c3bd8cc" name="Output Parameters" type="Block"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-450" y="75" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="0507cf0a-ffb6-47d5-a4fc-5a271405730d" name="Get Sharepoint Credentials" type="Block"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid><display x="-90" y="-75" w="285" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="65392e99-9d0b-4712-8904-e824d518d8f2" name="Recover" type="Recover"><subsheetid>6565363c-2e10-4c0b-9ac9-992a20df8182</subsheetid