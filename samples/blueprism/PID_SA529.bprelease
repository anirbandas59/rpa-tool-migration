exception</narrative><display x="15" y="180" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>2bd04759-6431-4486-a836-b2859435809c</ontrue><onfalse>37eeaebb-8677-487f-8195-b296e4240fb4</onfalse></stage><stage stageid="a36a283b-251c-4526-aaa3-34daa4e0e59a" name="Received exception after running the script" type="Exception"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="240" y="135" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="f46f913b-aa3c-4292-a31a-f8589d82637c" name="Input" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-285" y="-90" w="180" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7330be1d-3d26-47ff-9ff1-b7ff64e5d507" name="Inhouse" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-480" y="-45" w="180" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7a34f308-6012-437c-b091-988467d66a7f" name="End" type="End"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="330" /><outputs><output type="text" name="Success_Message" narrative="On Success a meesge with file location will be shared" stage="Run Report" /></outputs></stage><stage stageid="c7b606e6-1572-4393-a1b0-c14d1a281e0f" name="User Name" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-390" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9599652b-194e-44bf-9fb1-3bf5ff8d8733" name="Result_File_location" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ccfc495-f8d7-41db-8a57-dceb98a15575" name="Check_ResultLoc" type="Decision"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="15" y="-45" /><decision expression="[Result_File_location]=&quot;&quot;" /><ontrue>f3069b13-620f-451e-8208-6dcb084885f2</ontrue><onfalse>09747f33-7bbb-406e-b92a-52c43767c366</onfalse></stage><stage stageid="f3069b13-620f-451e-8208-6dcb084885f2" name="Set_Default_Loc" type="Calculation"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="135" y="-45" /><onsuccess>09747f33-7bbb-406e-b92a-52c43767c366</onsuccess><calculation expression="[Script_Location]" stage="Result_File_location" /></stage><stage stageid="7342907a-2581-4f7c-ae27-b3e77647cb88" name="Count" type="Data"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-390" y="135" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="7aa56265-197a-4e6f-90c8-91b46527b3cc" name="Get Oldest Filename in folder" type="SubSheetInfo"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><narrative>For the given Site and folder location, the name of the oldest file (as per the modifed date) is given as output</narrative><display x="-390" y="-75" w="180" h="60" /></stage><stage stageid="bdb3acf5-5262-4989-9b47-07d10074ac06" name="Start" type="Start"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="List/Lib_Name" narrative="List or library name" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /></inputs><onsuccess>e08ec335-408f-4b88-991e-3113864026cf</onsuccess></stage><stage stageid="a831a54d-16a3-4ced-898a-3dd84c12ee49" name="Build Script" type="Calculation"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="-45" w="90" h="30" /><onsuccess>c7291b3c-2bd6-4a0a-aef8-85059e31d0ab</onsuccess><calculation expression="&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$items=(Get-PnPFolderItem $SourceName -ErrorAction Stop -WarningAction silentlyContinue) &quot;&amp; NewLine() &amp; &#xA;&quot;$items = $items | Sort-Object -Property {$_.TimeLastModified} &quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount = $items.Count&quot;&amp; NewLine() &amp;&#xA;&quot;$FileName = ''&quot;&amp; NewLine() &amp; &#xA;&quot;$emptyStr = ''&quot; &amp; NewLine() &amp; &#xA;&#xA;&quot;If ($itemsCount -gt 0){ &quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;foreach($itm in $items) {&quot;&amp; NewLine() &amp; &#xA;&quot;If ($itm.GetType().Name -eq 'File') { &quot;&amp; NewLine() &amp; &#xA;&quot;$FileName = $itm.Name&quot;&amp; NewLine() &amp; &#xA;&quot;Break&quot;&amp; NewLine() &amp; &#xA; &quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;Else { continue}}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;If ( $FileName -eq $emptyStr) {&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('No files found')&quot;&amp; NewLine() &amp; &#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&quot;Else{ &quot;&amp; NewLine() &amp; &#xA;&quot;Write-Host 'FILE NAME: '$FileName}&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Else{&quot;&amp; NewLine() &amp; &#xA;&quot;Throw ('Folder is empty')&quot;&amp; NewLine() &amp; &#xA;&quot;}}&quot;&amp; NewLine() &amp; &#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="c7c8ee6c-1fbe-4d7d-83ed-5d7b68eb0a62" name="Run PnP_Script" type="SubSheet"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="90" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>da3595e6-57c9-43f6-acf7-a7fff2365c37</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="89d52a2b-425a-4ce2-b982-248cc6e201dd" name="Delete_Script" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="240" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>c592a196-6c01-402c-a412-e5a4ac5b1822</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="c7291b3c-2bd6-4a0a-aef8-85059e31d0ab" name="Generate_PnPScript" type="SubSheet"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="0" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_Oldest_File_in_folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>1ebebe8f-0b5d-46a5-ae0c-e2e572e2ad72</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="1ebebe8f-0b5d-46a5-ae0c-e2e572e2ad72" name="Check_Error" type="Decision"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>c6aba161-e823-4935-bfcb-b225f34da387</ontrue><onfalse>c7c8ee6c-1fbe-4d7d-83ed-5d7b68eb0a62</onfalse></stage><stage stageid="c6aba161-e823-4935-bfcb-b225f34da387" name="Exception while creating  Script" type="Exception"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="e408fa9a-ed40-4586-8166-8f336c1fbb91" name="Check Process_Exist" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="180" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>b789d48c-1a71-453a-9327-342de10cf3c7</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="b789d48c-1a71-453a-9327-342de10cf3c7" name="ProcessExist?" type="Decision"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="135" y="180" /><decision expression="[P_Exists]=True" /><ontrue>01fb71e1-1daa-4b3e-abd7-9a3d646a322a</ontrue><onfalse>89d52a2b-425a-4ce2-b982-248cc6e201dd</onfalse></stage><stage stageid="01fb71e1-1daa-4b3e-abd7-9a3d646a322a" name="Kill Process" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="135" y="240" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>89d52a2b-425a-4ce2-b982-248cc6e201dd</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="7ec1cf6e-beb1-4210-a2c9-0d083abe0870" name="SP_Site_URL" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-195" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="811a5389-b2f9-4019-be95-9f0de6e940ec" name="SP_RelLib_Url" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c491f2eb-72b0-4543-88be-82b8f7c79dfb" name="Output" type="Block"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-285" y="60" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0f299f7f-e6f3-427e-bc89-855a9189fd81" name="Script" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="21e14ddb-5d11-4be4-9474-f486bc652308" name="Return Message" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3167540e-24c8-43c1-a41a-bfc10dd9a8b1" name="Script Path" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="47646786-7c5d-4194-8293-93b28b4a2784" name="Error_Message" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e431abcb-b05c-467b-96ff-1a03a5d4542e" name="Run Report" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="240" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9f36076c-5d9f-488d-9978-29179f3beb90" name="P_Exists" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><narrative>Process exist or not</narrative><display x="-390" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4243aa12-99c0-4c2d-882f-0960f4b73054" name="Unexpected exception recover" type="Recover"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="150" y="-90" /><onsuccess>e599647a-10e4-4681-bbf9-126aa1b0f633</onsuccess></stage><stage stageid="65eaf556-9c11-45b7-a759-ccd46676bd01" name="Unexpected Exception" type="Exception"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="-45" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="646039d8-b1c8-4f9d-adc9-26b55a394584" name="Script_Location" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e599647a-10e4-4681-bbf9-126aa1b0f633" name="Delete_Script" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="-90" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>65eaf556-9c11-45b7-a759-ccd46676bd01</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ebff2709-090d-42b7-822d-61971d9e8430" name="Validate Temp Script Path" type="SubSheet"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="-90" w="90" h="30" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>a831a54d-16a3-4ced-898a-3dd84c12ee49</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="da3595e6-57c9-43f6-acf7-a7fff2365c37" name="Error Message?" type="Decision"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="135" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>620a5b59-f89a-499c-b59b-93006bd4b3f7</ontrue><onfalse>e408fa9a-ed40-4586-8166-8f336c1fbb91</onfalse></stage><stage stageid="96805e6f-324d-4a11-afa7-daf9f347b882" name="Received exception after running the script" type="Exception"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="180" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="88746fc0-f721-4ada-a5b0-c194d2b87838" name="Input" type="Block"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-285" y="-105" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cbcabc70-7ba5-462b-adfd-bfa6e0bd2974" name="Inhouse" type="Block"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-480" y="-30" w="180" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2e6263c7-4125-4cba-b9ad-75b39ec6b433" name="End" type="End"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="345" /><outputs><output type="text" name="Oldest File Name" narrative="Name of the oldest file in the specified folderq" stage="FileName" /></outputs></stage><stage stageid="2731b636-2005-41dc-97ab-c8f6f77fdfa8" name="User Name" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c63af18f-25b7-4eea-a66a-96614274faef" name="Count" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="120" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="c592a196-6c01-402c-a412-e5a4ac5b1822" name="Extract Filename" type="MultipleCalculation"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="15" y="285" w="90" h="30" /><onsuccess>2e6263c7-4125-4cba-b9ad-75b39ec6b433</onsuccess><steps><calculation expression="InStr([Run Report], &quot;FILE NAME:  &quot;)+Len(&quot;FILE NAME:  &quot;)" stage="NameStartPoint" /><calculation expression="Mid([Run Report],[NameStartPoint], Len([Run Report]) - [NameStartPoint])" stage="FileName" /></steps></stage><stage stageid="78dbf523-77ae-4842-b54c-12d4459327d2" name="NameStartPoint" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-390" y="150" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ba86c75c-cf80-4279-af77-dfba3fa9c2d2" name="FileName" type="Data"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-195" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f08c73a8-1596-4945-8dea-37a21469746b" name="Block10" type="Block"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="-60" y="-120" w="255" h="435" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="76095ce3-25f1-4759-a557-22dcaa68cb5f" name="Block11" type="Block"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="-60" y="-120" w="255" h="420" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ec797894-8845-4157-ad5d-9c3f6342209a" name="Get MetaData Of File" type="SubSheetInfo"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><narrative>For a given Filer, all the metadata (specified in the input collection) are extracted and sent as output collection

To know what are the internal field names in Sharepoint use "GetField_InternalName" page</narrative><display x="-405" y="-270" w="180" h="90" /></stage><stage stageid="1586dfe5-1a76-4ce2-812e-9956eeb9ec82" name="Start" type="Start"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-450" /><inputs><input type="collection" name="Column_names" narrative="Collection of all header/ fields need to be extracted." stage="Field_Names" /><input type="text" name="SP_URL" narrative="Site/Subsite URL" stage="SP_Site_URL" /><input type="text" name="File Path" narrative="Complete Path of the file to extract Metadata for" stage="SP_RelLib_Url" /><input type="text" name="temp_Script_location" narrative="Temporary script location(Optional)" stage="Script_Location" /></inputs><onsuccess>978ff6cd-8e12-455e-9d9b-114dc159c12b</onsuccess></stage><stage stageid="80c37908-143e-4994-9903-abc151ae8a91" name="Build Script" type="Calculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="-45" w="90" h="30" /><onsuccess>1be6784b-8ea3-4675-a07b-9e8000f3e260</onsuccess><calculation expression="&quot;$SourceName= &quot; &amp; Chr(34) &amp;[SP_RelLib_Url]&amp; Chr(34)  &amp; NewLine() &amp; &#xA;&#xA;&quot;Try { &quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;$items=( Get-PnPFile -Url $SourceName -AsListItem -ErrorAction Stop -WarningAction silentlyContinue) &quot;&amp; NewLine() &amp; &#xA;&quot;$itemsCount= $items.Count&quot; &amp; NewLine() &amp;&#xA;&#xA;&quot;if ($itemsCount -gt 0) {&quot; &amp; NewLine() &amp;&#xA;&quot;$FieldList= &quot; &amp;[Field_Qry] &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;Metadata- $FieldList&quot; &amp; Chr(34) &amp; NewLine() &amp;&#xA;&quot;}&quot; &amp; NewLine() &amp;&#xA;&quot;Else{&quot;&amp; NewLine() &amp;&#xA;&quot;Throw(&quot; &amp;Chr(34)&amp; &quot;File not found to extract Metadata&quot; &amp; Chr(34) &amp;&quot;)&quot; &amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp;&#xA;&quot;}&quot;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;" stage="Script" /></stage><stage stageid="4f875140-17c2-4991-92f4-928206eb8c26" name="Run PnP_Script" type="SubSheet"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="45" w="90" h="30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>9b5b9cce-e72f-4d6e-9e1b-7d931ab56cf1</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d7b48a78-1439-4e31-b2c2-76def6423b9f" name="Delete_Script" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="180" w="90" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>f11a377e-513a-430c-96d8-f26a9e15d24b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="1be6784b-8ea3-4675-a07b-9e8000f3e260" name="Generate_PnPScript" type="SubSheet"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-45" w="90" h="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;MetaData&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>96e02a43-5bed-49bd-b71e-5bea65a3b945</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="96e02a43-5bed-49bd-b71e-5bea65a3b945" name="Check_Error" type="Decision"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="0" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>6e1e9024-b760-439c-854e-f037442e6359</ontrue><onfalse>4f875140-17c2-4991-92f4-928206eb8c26</onfalse></stage><stage stageid="6e1e9024-b760-439c-854e-f037442e6359" name="Exception while creating  Script" type="Exception"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="390" y="0" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="3729dcac-8c9e-42ca-8b66-e620f59fb52e" name="Check Process_Exist" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="135" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>eee25d0c-4511-4d0e-86e9-5c45b1bc5de3</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="eee25d0c-4511-4d0e-86e9-5c45b1bc5de3" name="ProcessExist?" type="Decision"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="135" /><decision expression="[P_Exists]=True" /><ontrue>5557ff6d-5d3b-4877-8d23-05ddc7f7b77d</ontrue><onfalse>d7b48a78-1439-4e31-b2c2-76def6423b9f</onfalse></stage><stage stageid="5557ff6d-5d3b-4877-8d23-05ddc7f7b77d" name="Kill Process" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="180" w="90" h="30" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d7b48a78-1439-4e31-b2c2-76def6423b9f</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="f7004139-7f8e-4375-b700-d955dd2fba22" name="SP_Site_URL" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-210" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="47acd251-36f9-4771-a6dc-ac391026a68c" name="SP_RelLib_Url" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-165" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0bba83c-7d1d-45cf-966a-875e4c8edb0f" name="Output" type="Block"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-300" y="15" w="180" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2fd1021d-5bfc-4241-ae18-c37b9d49b520" name="Script" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ae26b8f0-8c8d-44f9-a7b5-efa9ca80c7c4" name="Return Message" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e941b1d3-1402-4848-9064-e02db1f8416e" name="Script Path" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="-180" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6bf427f2-ef8a-4459-a220-bc75e5501d86" name="Error_Message" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3b4ca3a2-3a5a-4f56-a2f1-de836d90523c" name="Run Report" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d815eca3-eaa3-4526-a6cb-1dc5211f8125" name="P_Exists" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="0" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9630692e-04f4-4a44-90d6-841eeae05607" name="Unexpected exception recover" type="Recover"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="45" /><onsuccess>d493bbf3-6691-4e3c-88f6-15152c0d4354</onsuccess></stage><stage stageid="64872a93-12de-476e-8d4a-2e2d951dc2b5" name="Unexpected Exception" type="Exception"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="390" y="45" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="b54f719c-8c86-4b8b-a19b-3e2f59c43281" name="Script_Location" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d493bbf3-6691-4e3c-88f6-15152c0d4354" name="Delete_Script" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="285" y="45" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>64872a93-12de-476e-8d4a-2e2d951dc2b5</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="77689d60-a2a0-49d2-bdc7-acef148e01dc" name="Validate Temp Script Path" type="SubSheet"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-270" w="90" h="30" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>fc11d912-5b2f-4fbe-b215-122035840a2b</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="9b5b9cce-e72f-4d6e-9e1b-7d931ab56cf1" name="Error Message?" type="Decision"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="90" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>d7e67637-7125-40ac-b522-6fc63a99968f</ontrue><onfalse>3729dcac-8c9e-42ca-8b66-e620f59fb52e</onfalse></stage><stage stageid="3f40da45-acaf-41b8-a8ab-5f16b599b8c9" name="Received exception after running the script" type="Exception"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="390" y="90" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="1c77cbda-56d2-4a5c-b1b1-324d615b7c7e" name="Input" type="Block"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-300" y="-315" w="180" h="225" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="013e207e-8be8-46ab-b198-351efbc66782" name="Inhouse" type="Block"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-495" y="-210" w="180" h="405" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="efda88c5-d830-4e9f-95f4-472a28f4a1b1" name="End" type="End"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="420" /><outputs><output type="text" name="Success_Message" narrative="On Success a meesge with file location will be shared" stage="Run Report" /></outputs></stage><stage stageid="7cfef055-2d6e-43d0-8416-4a087ec2a9e6" name="User Name" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0890714f-2e1e-4650-9fba-f236b9155aa1" name="Field_Names" type="Collection"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="-270" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Field_Names" type="text" /></collectioninfo></stage><stage stageid="fc11d912-5b2f-4fbe-b215-122035840a2b" name="Loop Start1" type="LoopStart"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-180" w="90" h="30" /><onsuccess>421b3680-70d4-4383-8036-c0b8a73c4863</onsuccess><groupid>85cc307b-6e01-4fcb-b14f-5da8228aca3a</groupid><looptype>ForEach</looptype><loopdata>Field_Names</loopdata></stage><stage stageid="e75b7c91-57b0-4fdd-9943-f1c4c7657bdc" name="Loop End1" type="LoopEnd"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-90" w="90" h="30" /><onsuccess>95df95dd-49d8-43df-be3f-e5bbcb0da777</onsuccess><groupid>85cc307b-6e01-4fcb-b14f-5da8228aca3a</groupid></stage><stage stageid="421b3680-70d4-4383-8036-c0b8a73c4863" name="Build_Script_calc" type="MultipleCalculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="-135" w="90" h="30" /><onsuccess>e75b7c91-57b0-4fdd-9943-f1c4c7657bdc</onsuccess><steps><calculation expression="[Field_Qry]&amp; &quot;+&quot; &amp; Chr(34) &amp;  &quot;\n&quot; &amp; [Field_Names.Field_Names] &amp; &quot;:XXXXX:&quot; &amp; Chr(34) &amp; &quot;+&quot; &amp;&quot;$items.FieldValues[&quot; &amp; Chr(34) &amp; [Field_Names.Field_Names] &amp; Chr(34) &amp; &quot;]&quot;" stage="Field_Qry" /></steps></stage><stage stageid="891d07a1-85d6-44dd-8ee4-cf4281854a30" name="Field_Qry" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="-135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f11a377e-513a-430c-96d8-f26a9e15d24b" name="Fetch Result from Run Report" type="MultipleCalculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="225" w="90" h="30" /><onsuccess>08a62a6f-e122-4803-b300-f4abf20d2938</onsuccess><steps><calculation expression="Right([Run Report],Len([Run Report]) - InStr([Run Report], &quot;Metadata-&quot;) + 1)" stage="Result" /><calculation expression="Replace([Result], &quot;Metadata- \n&quot;, &quot;&quot;)" stage="Result" /></steps></stage><stage stageid="08a62a6f-e122-4803-b300-f4abf20d2938" name="Split Run Report" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="225" w="90" h="30" /><inputs><input type="text" name="Text to Split" narrative="The text to split" expr="[Result]" /><input type="text" name="Split Char" narrative="The split delimiter" expr="&quot;\n&quot;" /><input type="text" name="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Field&quot;" /></inputs><outputs><output type="collection" name="Split Values" narrative="The resulting collection containing the split values" stage="MetaData" /></outputs><onsuccess>adf92dd1-fad4-4675-8ce2-e08ce6398fd5</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="59a07fdf-6e3f-4ed4-b0eb-ce596969b885" name="Loop MetaData" type="LoopStart"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="270" w="90" h="30" /><onsuccess>9dda607a-c874-4ef5-bdd2-819193a93f82</onsuccess><groupid>05a6a3a3-a85e-47d2-9768-f5a3ef92c22c</groupid><looptype>ForEach</looptype><loopdata>MetaData</loopdata></stage><stage stageid="c0748131-653b-4939-9154-6b55cb186b8f" name="Loop MetaData" type="LoopEnd"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="360" w="90" h="30" /><onsuccess>efda88c5-d830-4e9f-95f4-472a28f4a1b1</onsuccess><groupid>05a6a3a3-a85e-47d2-9768-f5a3ef92c22c</groupid></stage><stage stageid="adf92dd1-fad4-4675-8ce2-e08ce6398fd5" name="Add Field Value to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="270" w="90" h="30" /><inputs><input type="collection" name="Collection" narrative="The collection to append a field to." expr="[MetaData]" /><input type="text" name="Field Name" narrative="The name of the new field." expr="&quot;Value&quot;" /><input type="text" name="Value" narrative="The value to be put in the new field." expr="" /></inputs><outputs><output type="collection" name="Appended Collection" narrative="The collection with field appended." stage="MetaData" /></outputs><onsuccess>59a07fdf-6e3f-4ed4-b0eb-ce596969b885</onsuccess><resource object="Utility - Collection Manipulation" action="Append Field (Text)" /></stage><stage stageid="9dda607a-c874-4ef5-bdd2-819193a93f82" name="Split Each value" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="15" y="315" w="90" h="30" /><inputs><input type="text" name="Text to Split" narrative="The text to split" expr="[MetaData.Field]" /><input type="text" name="Split Char" narrative="The split delimiter" expr="&quot;:XXXXX:&quot;" /><input type="text" name="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Value&quot;" /></inputs><outputs><output type="collection" name="Split Values" narrative="The resulting collection containing the split values" stage="Split Values" /></outputs><onsuccess>4378119d-7196-4334-b989-2ec52d0adbfc</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="a240aa2a-240a-47b1-b4a4-029ae973fad5" name="MetaData" type="Collection"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-210" y="60" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="51afdbbc-11f5-4596-9d9b-4e0bad6c2fee" name="Split Values" type="Collection"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="4378119d-7196-4334-b989-2ec52d0adbfc" name="Add Field Name to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="315" w="90" h="30" /><inputs><input type="number" name="Row Index" narrative="The row index within the collection to read from. The index is from 0 to N-1 (where N is the total number of rows in the collection)." expr="0" /><input type="collection" name="Collection" narrative="The collection to read." expr="[Split Values]" /><input type="text" name="Field Name" narrative="The field within the collection to read." expr="&quot;Value&quot;" /></inputs><outputs><output type="text" name="Value Read" narrative="The value of the requested field as text." stage="MetaData.Field" /></outputs><onsuccess>2fa9590f-3a67-4db4-945d-140169b8c60c</onsuccess><resource object="Utility - Collection Manipulation" action="Read Collection Field" /></stage><stage stageid="2fa9590f-3a67-4db4-945d-140169b8c60c" name="Add Field Value to MetaData" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="360" w="90" h="30" /><inputs><input type="number" name="Row Index" narrative="The row index within the collection to read from. The index is from 0 to N-1 (where N is the total number of rows in the collection)." expr="1" /><input type="collection" name="Collection" narrative="The collection to read." expr="[Split Values]" /><input type="text" name="Field Name" narrative="The field within the collection to read." expr="&quot;Value&quot;" /></inputs><outputs><output type="text" name="Value Read" narrative="The value of the requested field as text." stage="MetaData.Value" /></outputs><onsuccess>c0748131-653b-4939-9154-6b55cb186b8f</onsuccess><resource object="Utility - Collection Manipulation" action="Read Collection Field" /></stage><stage stageid="f393cce1-98ae-4bcc-b709-f28903db2029" name="Result" type="Data"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-405" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="95df95dd-49d8-43df-be3f-e5bbcb0da777" name="Remove additional '+'" type="Calculation"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="150" y="-90" w="90" h="30" /><onsuccess>80c37908-143e-4994-9903-abc151ae8a91</onsuccess><calculation expression="Right([Field_Qry], Len([Field_Qry]) - 1)" stage="Field_Qry" /></stage><stage stageid="21003a18-4e56-492e-9840-cd1c1b8344ae" name="Block12" type="Block"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="-60" y="-300" w="285" h="675" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="217d7803-bb86-4628-9785-bbbe2fc03dd3" name="Create Power Shell Script" type="Code"><subsheetid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</subsheetid><display x="-45" y="75" /><inputs><input type="text" name="Script" expr="[Script]" /><input type="text" name="ScriptName" expr="[Script_Name]" /><input type="text" name="Script Directory" expr="[ScriptLocation]" /></inputs><outputs><output type="text" name="MSG" stage="Return Message" /><output type="text" name="ScriptPath" stage="ScriptPath" /></outputs><onsuccess>0f4714ab-8f19-43a2-8032-daed7cf00036</onsuccess><code><![CDATA[String fileName = "";
String Filepath = Script_Directory ;

MSG = "";
ScriptPath = "";
            try
            {
				fileName = ScriptName;
				
				//Check if Dir exist
				if (!System.IO.Directory.Exists(Filepath))

                    {                    
                        System.IO.Directory.CreateDirectory(Filepath);                    
                    } 
				
				
				// Create complete script path 
				Filepath = Filepath + @"\" + fileName + @".ps1";
				//ScriptPath = Filepath;
				 
					
					
                // Check if file already exists. If yes, delete it.     
                if (System.IO.File.Exists(Filepath))
                {
                    
					//System.IO.File.Delete(fileName);
                }

                // Create a new file     
                using (StreamWriter sw = new StreamWriter(File.Open(Filepath, FileMode.Create), Encoding.UTF8))
				{    
				sw.WriteLine(Script);     
				}

                
				ScriptPath = Filepath;
            }
            catch (Exception Ex)
            {
                MSG = Ex.ToString();
            }
			]]></code></stage><stage stageid="e5312272-a193-4074-ad2c-aa4880107717" name="Create New Library Folder" type="SubSheetInfo"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Create New Folder in a library.
MinAccess:- Add_Edit
On success "Folder Created Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="2bbe0469-0faf-44e0-a8a3-a9b6323c5194" name="Start" type="Start"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-210" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target Folder Name Ex:- PNP_Test_Lib/Unittesting" stage="SP_RelLib_Url" /><input type="text" name="New_Folder_Name" narrative="New Folder . Ex:- Test" stage="New_Foldername" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>158e88b6-b686-4969-946c-fb0d3f3ca12a</onsuccess></stage><stage stageid="dccd5738-1f0f-42d1-b35a-c50678078ae2" name="Build Script" type="Calculation"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-15" /><onsuccess>b48cb8ed-a1f8-4715-8542-6402e8a02085</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Add-PnPFolder -Name &quot; &amp;Chr(34) &amp; [New_Foldername]  &amp;Chr(34) &amp;  &quot; -Folder &quot; &amp;Chr(34) &amp;  [SP_RelLib_Url] &amp;Chr(34) &amp;  &quot; -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Folder Created  Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException]  { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="821c9172-5fd0-435a-88b5-2101585bb982" name="Run PnP_Script" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="165" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>0b22aaa2-3703-4ec6-a637-31773192f382</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="934c51e8-3921-442f-a503-5228a8bc3040" name="Delete_Script" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="435" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ec7b6214-d923-4732-9329-3cae273ab25a</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="b48cb8ed-a1f8-4715-8542-6402e8a02085" name="Generate_PnPScript" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_Folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>3a81f8ef-e854-4cbe-a077-7b8272cf356c</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="3a81f8ef-e854-4cbe-a077-7b8272cf356c" name="Check_Error" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>2ad22732-0bc7-43aa-8e5e-6dc16f229580</ontrue><onfalse>fe00f795-3298-4bf8-8c4f-756d479082ba</onfalse></stage><stage stageid="2ad22732-0bc7-43aa-8e5e-6dc16f229580" name="Exception while creating  Script" type="Exception"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="20a11f7c-4a74-4f22-a886-e08f2e752c09" name="Check Process_Exist" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="285" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>6c10463b-a8bc-41f6-bf0c-a219c485add7</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="6c10463b-a8bc-41f6-bf0c-a219c485add7" name="ProcessExist?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="330" /><decision expression="[P_Exists]=True" /><ontrue>c68a31c0-3ae4-4ba4-bb70-d633274bc328</ontrue><onfalse>cab351e2-386e-4dbe-92d0-e56c1e355818</onfalse></stage><stage stageid="cab351e2-386e-4dbe-92d0-e56c1e355818" name="Anchor8" type="Anchor"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="90" y="330" w="10" h="10" /><onsuccess>0c6a1db0-12e7-4f5c-bcc8-15abaff9a7d9</onsuccess></stage><stage stageid="c68a31c0-3ae4-4ba4-bb70-d633274bc328" name="Kill Process" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="375" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>934c51e8-3921-442f-a503-5228a8bc3040</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="0c6a1db0-12e7-4f5c-bcc8-15abaff9a7d9" name="Anchor9" type="Anchor"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="90" y="435" w="10" h="10" /><onsuccess>934c51e8-3921-442f-a503-5228a8bc3040</onsuccess></stage><stage stageid="75a48717-2ddb-425d-916e-2ff6a4b8b0ae" name="SP_Site_URL" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fded85c2-ef04-41be-a3d5-01ceb9f2160a" name="SP_RelLib_Url" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-285" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b764642c-0d64-4350-a560-50da9aebafaf" name="Output" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-285" y="225" w="105" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fc4bb500-eb71-4938-b7b2-5ae3f78a9699" name="Script" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c8c261a2-9494-49f6-9cff-b77f84f3c15e" name="Return Message" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="04ad6817-1b69-401c-8289-76886c4e55e6" name="Script Path" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="88428cdb-db66-43b7-af98-841ddab4c1eb" name="Error_Message" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-225" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="93abf720-4714-475c-879f-f32bff6f5812" name="Run Report" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-240" y="315" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="883b8b5d-384c-4a11-b7d8-2ab44d522ef3" name="P_Exists" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="270" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="826bfa76-5bdb-45cf-bd09-99a03486d3c0" name="Unexpected exception recover" type="Recover"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="450" y="-30" /><onsuccess>215c5fde-c138-4d6d-9b8c-68a6c643e307</onsuccess></stage><stage stageid="329e292c-f2f0-4d3a-a25d-d45ca050cdc2" name="Unexpected Exception" type="Exception"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="525" y="75" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="654301c1-8d17-46ec-9ae9-a23c5bf05002" name="Script_Location" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-240" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="215c5fde-c138-4d6d-9b8c-68a6c643e307" name="Delete_Script" type="Action"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="450" y="75" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>329e292c-f2f0-4d3a-a25d-d45ca050cdc2</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ef1b2002-9b80-46b7-ba93-b16ba94e77bf" name="Validate Temp Script Path" type="SubSheet"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>dccd5738-1f0f-42d1-b35a-c50678078ae2</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="018b0769-e7b0-4fdb-b740-498f8ed53185" name="Error Message?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Checks if run received exception</narrative><display x="105" y="225" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>4a99e6a0-61cb-4bd0-ab57-08d764938c16</ontrue><onfalse>20a11f7c-4a74-4f22-a886-e08f2e752c09</onfalse></stage><stage stageid="4a99e6a0-61cb-4bd0-ab57-08d764938c16" name="Received exception after running the script" type="Exception"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="210" y="225" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="0105628d-48ed-4f94-8d69-bb50f20942b4" name="Input" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-315" y="60" w="165" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3f723268-7d9b-4777-9835-15b9263b8097" name="Inhouse" type="Block"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-465" y="60" w="120" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ec7b6214-d923-4732-9329-3cae273ab25a" name="End" type="End"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="15" y="495" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Folder Created Successfully&#xA;&quot; will be displayed" stage="Run Report" /><output type="text" name="Error_Message" narrative="On Error &quot; correcsponding  error message &quot; will be displayed" stage="Error_Message" /></outputs></stage><stage stageid="0f342f6d-44b7-49db-a7f3-640ed22d84a3" name="User Name" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-405" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91ee6138-bc9f-4355-9c13-2d6102db11d5" name="New_Foldername" type="Data"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-270" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b22aaa2-3703-4ec6-a637-31773192f382" name="Is folder already Exists?" type="Decision"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="225" /><decision expression="InStr(Lower([Run Report]), &quot;already exists&quot;)&gt;0" /><ontrue>41404d70-906f-4d2e-89c7-4462f963b4fc</ontrue><onfalse>018b0769-e7b0-4fdb-b740-498f8ed53185</onfalse></stage><stage stageid="41404d70-906f-4d2e-89c7-4462f963b4fc" name="Message - Folder already exists" type="Calculation"><subsheetid>fc563bc9-212e-44c5-9776-e6de4a87abc3</subsheetid><display x="-75" y="225" /><onsuccess>20a11f7c-4a74-4f22-a886-e08f2e752c09</onsuccess><calculation expression="Replace([Run Report], &quot;ERROR&quot;, &quot;&quot;)" stage="Run Report" /></stage><stage stageid="dfa213dc-e42c-4d29-b9c5-4c96e264de3c" name="Upload File without FSO Access" type="SubSheetInfo"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>It will upload the file without FSO access and update the  metadata.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="15cda6e2-2ba6-411e-b53c-d5f2075b5581" name="Start" type="Start"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without Metadata.</narrative><display x="90" y="-255" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Library Name" narrative="Library name in Sharepoint" stage="Library Name" /></inputs><onsuccess>fc009d75-d18c-46f2-9cb2-127a5c354ed8</onsuccess></stage><stage stageid="d1a4f59e-b859-4a3a-9fc9-3d40ca2532d4" name="End" type="End"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="420" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="d5e0909f-beee-4e5a-a67a-8233eb7f4b69" name="Return Message" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-435" y="360" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bf699542-d536-4d1a-9dbe-5c6d2158bd30" name="Build Script" type="Calculation"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="-60" /><onsuccess>f6b344ef-c6bc-425a-a0de-680e4cdb74b6</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$SourceFile=&quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FileStream = ([System.IO.FileInfo] (Get-Item $SourceFile)).OpenRead()&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx = Get-PnPContext&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($ctx.web);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$lists = $ctx.web.lists;$ctx.load($lists);$ctx.executequery();$myList = $lists | Where-Object{$_.Title -eq '___RPA_LIBRARYNAME___'}&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile = new-object Microsoft.SharePoint.Client.fileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.OverWrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.ContentStream = $FileStream&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$newFile.Url = $ctx.web.url + &quot;&amp;Chr(34)&amp;&quot;___RPA_LIBRARYPATH___&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;&#xA;$addFile = $myList.RootFolder.Files.Add($newFile)&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($addFile);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$FileStream.Close()&quot;&#xA;" stage="Script" /></stage><stage stageid="04a672d9-7718-497c-be18-3c3ace021cb9" name="Script" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-315" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="65e95c2b-53d8-44b6-908a-5448648674d9" name="SP_Site_URL" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>Link for site or subsite.</narrative><display x="-435" y="195" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="407c8052-eab2-4eb1-b82a-11ad706f2102" name="SP_Lib_Folder_Path" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-435" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d15cd05e-5a2e-443b-acb7-fb024ba1003e" name="FilePath" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>File Location to upload the file.</narrative><display x="-435" y="255" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2d2de81c-08f5-4f6f-8682-9330dc105a59" name="Run PnP_Script" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="150" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>6fd3f066-3704-4e29-a04f-f14202f5fc58</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="c7d9f2fc-6402-444f-8857-fc16833b87b0" name="Note3" type="Note"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

****************************************************************************************************
Considering the file from "C:\Apps\Test.xlsx" to be uploaded to "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data)</narrative><display x="-450" y="-90" w="300" h="240" /></stage><stage stageid="0c76f22e-5dcc-4135-9709-fbd13384e4ad" name="Script Path" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-330" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8c83a6e8-2251-469b-9922-d4cba00e641c" name="Delete_Script" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="360" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>d1a4f59e-b859-4a3a-9fc9-3d40ca2532d4</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="412fd076-4280-427b-8cbb-f1e747efa29c" name="Generate_PnPScript" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>56e87b71-1782-4b52-b47d-c35895f7a9b2</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="01c6b367-09c5-4172-b793-115eabbda837" name="Input" type="Block"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-495" y="135" w="120" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d40336d7-92be-42ed-9c67-e2ad8ecb1121" name="Output" type="Block"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-495" y="315" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="39b9b8d6-255b-4012-92c5-9604902f301c" name="Inhouse" type="Block"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-360" y="135" w="120" h="300" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="56e87b71-1782-4b52-b47d-c35895f7a9b2" name="Check_Error" type="Decision"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="90" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>5b1d9a4f-0735-4e77-a585-30d6a32b8d74</ontrue><onfalse>2d2de81c-08f5-4f6f-8682-9330dc105a59</onfalse></stage><stage stageid="5b1d9a4f-0735-4e77-a585-30d6a32b8d74" name="Exception while creating  Script" type="Exception"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="285" y="90" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="6fd3f066-3704-4e29-a04f-f14202f5fc58" name="Check Process_Exist" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="195" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>b950981f-5cda-4796-b134-cf36ee3b98ed</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="79ae29cb-56fe-4621-828d-bf2b440eb652" name="Exists" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-285" y="225" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b950981f-5cda-4796-b134-cf36ee3b98ed" name="ProcessExist?" type="Decision"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="255" /><decision expression="[Exists]=True" /><ontrue>2c210d73-17dc-464d-8fe2-a8e4ab714034</ontrue><onfalse>984bd6e5-6b5d-4077-8d5b-77c818ebedac</onfalse></stage><stage stageid="179e1c21-6630-43ae-8a42-e23d89198df6" name="Temp_Retry" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-270" y="285" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="984bd6e5-6b5d-4077-8d5b-77c818ebedac" name="Anchor8" type="Anchor"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="195" y="255" w="10" h="10" /><onsuccess>67036341-0915-422c-805c-d1d68e4cf100</onsuccess></stage><stage stageid="2c210d73-17dc-464d-8fe2-a8e4ab714034" name="Kill Process" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="300" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>8c83a6e8-2251-469b-9922-d4cba00e641c</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="67036341-0915-422c-805c-d1d68e4cf100" name="Anchor9" type="Anchor"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="195" y="360" w="10" h="10" /><onsuccess>8c83a6e8-2251-469b-9922-d4cba00e641c</onsuccess></stage><stage stageid="20134306-4db4-4170-8a68-f03e756a70f5" name="Run_Status" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-330" y="225" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2dc18ff2-38cf-4aa4-ba53-59fe047340a8" name="Error_Message" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-450" y="420" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0b2ff36-170b-4f15-90c1-17a15b376f7e" name="Unexpected exception recover" type="Recover"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="420" y="150" /><onsuccess>e234edee-0c13-427a-a993-fa39e1b3c5cb</onsuccess></stage><stage stageid="bedcf681-99eb-452f-8977-70b9b3ff6fdf" name="Unexpected Exception" type="Exception"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="570" y="150" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="35056a2f-a611-4366-9203-cc8a7e626c99" name="Script_Loc" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-270" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e234edee-0c13-427a-a993-fa39e1b3c5cb" name="Delete_Script" type="Action"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="495" y="150" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>bedcf681-99eb-452f-8977-70b9b3ff6fdf</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="43e11505-3f4f-4d82-8c36-8f3efb3f62dc" name="Validate Temp Script Path" type="SubSheet"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="-105" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>bf699542-d536-4d1a-9dbe-5c6d2158bd30</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="b562fc00-7af5-49be-9c5c-bc4c801ca152" name="Library Name" type="Data"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="-435" y="225" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6b344ef-c6bc-425a-a0de-680e4cdb74b6" name="Make changes" type="MultipleCalculation"><subsheetid>3ce49509-11f5-4f0f-aa86-17c4409e5ae7</subsheetid><display x="90" y="0" /><onsuccess>412fd076-4280-427b-8cbb-f1e747efa29c</onsuccess><steps><calculation expression="Replace([Script], &quot;___RPA_LIBRARYNAME___&quot;, [Library Name])" stage="Script" /><calculation expression="Replace([Script], &quot;___RPA_LIBRARYPATH___&quot;, [SP_Lib_Folder_Path])" stage="Script" /></steps></stage><stage stageid="620a5b59-f89a-499c-b59b-93006bd4b3f7" name="Delete_Script" type="Action"><subsheetid>3a56289b-f197-435f-b0af-1dea4b8893c3</subsheetid><display x="255" y="135" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>96805e6f-324d-4a11-afa7-daf9f347b882</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="2bd04759-6431-4486-a836-b2859435809c" name="Delete_Script" type="Action"><subsheetid>2e90dbca-68b2-4198-b4aa-3bd5290680df</subsheetid><display x="240" y="180" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>a36a283b-251c-4526-aaa3-34daa4e0e59a</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="d7e67637-7125-40ac-b522-6fc63a99968f" name="Delete_Script" type="Action"><subsheetid>23c9e0dc-cb13-49fa-9897-b83d685934a9</subsheetid><display x="285" y="90" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3f40da45-acaf-41b8-a8ab-5f16b599b8c9</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="5960732a-e83a-487e-a4c2-1fea650ab344" name="Upload File without FSO Access with single Metadata" type="SubSheetInfo"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>It will upload the file without FSO access and  will updates  the single  metadata with provided value.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="991f47f6-b4e5-401b-ac5c-6b752727b1de" name="Start" type="Start"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><preconditions><condition narrative="Make sure you have right level of access from parent site level." /><condition narrative="Please make sure you have right level of access to Parent site, Sub site, Library etc. Please refre the read me document to setup the correct level of access." /></preconditions><postconditions><condition narrative="NA" /></postconditions><narrative>Helps to upload file to sharepoint without FSO access  and updates Metadata value given</narrative><display x="90" y="-285" /><inputs><input type="text" name="SharePoint Folder path" narrative="Library with subfolder location.This should also contain file name to be uploaded (Example:-SharePointAPI Testing/TestFolder12/test.xlsx) Here, test.xlsx is the file name which should be present in the path" stage="SP_Lib_Folder_Path" /><input type="text" name="FilePath" narrative="Complete path for the file to be uploaded  (Example:- C:\Apps\Temp)" stage="FilePath" /><input type="text" name="Sp_URL" narrative="SharePoint Site/ Subsite URL (Example: -https://eu001-sp.shell.com/sites/AAAAA3201/SA_QA)" stage="SP_Site_URL" /><input type="text" name="Script_Loc" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Loc" /><input type="text" name="Library Name" narrative="Library name in Sharepoint" stage="Library Name" /><input type="text" name="FieldValue" narrative="Metadata value" stage="FieldValue" /><input type="text" name="FieldName" narrative="Metdata Column name" stage="FieldName" /></inputs><onsuccess>240a4d86-5f8a-4be3-802f-a5029627bb93</onsuccess></stage><stage stageid="3f407478-1d64-4b92-af33-0a80d1f9851b" name="End" type="End"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="420" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run message ( On success returns the details of the file)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Returns failure/exception message ( On error returns error message)" stage="Error_Message" /></outputs></stage><stage stageid="40dc1194-9043-4c80-bcda-16b4ea81f3c9" name="Return Message" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-300" y="420" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c533714-5bf6-44a9-b976-21f9545020af" name="Build Script" type="Calculation"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="-60" /><onsuccess>843f4c23-1d43-4ee8-b818-9c27af4116d8</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$SourceFile=&quot;&amp;Chr(34)&amp;[FilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;$FileStream = ([System.IO.FileInfo] (Get-Item $SourceFile)).OpenRead()&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx = Get-PnPContext&quot;&amp;NewLine()&amp;&quot;&#xA;$ctx.load($ctx.web);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$lists = $ctx.web.lists;$ctx.load($lists);$ctx.executequery();$myList = $lists | Where-Object{$_.Title -match '___RPA_LIBRARYNAME___'}&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile = new-object Microsoft.SharePoint.Client.fileCreationInformation&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.OverWrite = $true&quot;&amp;NewLine()&amp;&quot;&#xA;$newFile.ContentStream = $FileStream&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$newFile.Url = $ctx.web.url + &quot;&amp;Chr(34)&amp;&quot;___RPA_LIBRARYPATH___&quot;&amp;Chr(34)&amp;NewLine()&amp;&quot;&#xA;&#xA;$addFile = $myList.RootFolder.Files.Add($newFile)&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem = $addFile.ListItemAllFields&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem[&quot;&amp;&quot;&quot;&quot;&quot;&amp;[FieldName]&amp;&quot;&quot;&quot;&quot;&amp;&quot;]=&quot;&quot;&quot;&amp;[FieldValue]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$listItem.Update()&quot;&amp;NewLine()&amp;&quot;&#xA;&#xA;$ctx.load($addFile);$ctx.executequery()&quot;&amp;NewLine()&amp;&quot;&#xA;$FileStream.Close()&quot;" stage="Script" /></stage><stage stageid="71fde886-fb7a-49d9-9141-7348edc6795c" name="Script" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="364e4f9d-e93d-4f70-a33f-8d35acf8fe1c" name="SP_Site_URL" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>Link for site or subsite.</narrative><display x="-450" y="210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="78ed1832-35b4-4613-a8c5-dffa8e4349f9" name="SP_Lib_Folder_Path" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>Path for Library till the subfolder level where the file to be uploaded.</narrative><display x="-450" y="165" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b272951-4eda-4dac-90eb-925f05618520" name="FilePath" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>File Location to upload the file.</narrative><display x="-450" y="300" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27aa4108-618f-4c12-8892-b536b3227914" name="Run PnP_Script" type="SubSheet"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="150" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>517f95c6-6275-4ac2-bb63-0f6d19825347</onsuccess><breakpoint type="0"><condition></condition></breakpoint><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="32ac1eb3-a027-45e0-9ec3-68c5c8c4eed2" name="Note3" type="Note"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


Share_Lib_Folder_Path: Includes Library and sub folder ( Example:- Documents/FO/Data)


SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

****************************************************************************************************
Considering the file from "C:\Apps\Test.xlsx" to be uploaded to "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data)</narrative><display x="-450" y="-90" w="300" h="240" /></stage><stage stageid="5c9b0422-8b58-4b76-8ca8-0b8408f7f244" name="Script Path" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-240" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8940eca9-ca92-4165-849d-1c25a685c08a" name="Delete_Script" type="Action"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="360" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3f407478-1d64-4b92-af33-0a80d1f9851b</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="2a280cac-266e-417b-a756-0321aa0e4b4d" name="Generate_PnPScript" type="SubSheet"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="45" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_upload&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>d02e7cca-4e8a-4716-a7f6-05de62cbb448</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="d3bf72d6-f0af-426e-b9da-2117075d8c4c" name="Input" type="Block"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-525" y="135" w="150" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e1deb47a-fbf5-4aab-bce1-1df90cd8a23d" name="Output" type="Block"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-360" y="375" w="120" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="56149f8e-4367-417d-bd71-46a24038369e" name="Inhouse" type="Block"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-360" y="135" w="165" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d02e7cca-4e8a-4716-a7f6-05de62cbb448" name="Check_Error" type="Decision"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="90" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>9627ce23-ca0c-4246-9a91-e5fa493047e0</ontrue><onfalse>27aa4108-618f-4c12-8892-b536b3227914</onfalse></stage><stage stageid="9627ce23-ca0c-4246-9a91-e5fa493047e0" name="Exception while creating  Script" type="Exception"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="285" y="90" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="517f95c6-6275-4ac2-bb63-0f6d19825347" name="Check Process_Exist" type="Action"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="195" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="Exists" /></outputs><onsuccess>0cce38ae-bdd0-4a9b-9598-ff9a0f74c77c</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="3ac16ba6-1e9e-4f09-b387-5011c6c207ba" name="Exists" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-240" y="255" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0cce38ae-bdd0-4a9b-9598-ff9a0f74c77c" name="ProcessExist?" type="Decision"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="255" /><decision expression="[Exists]=True" /><ontrue>0050baa5-237e-4426-a0cb-9f32e6cda0c2</ontrue><onfalse>82beb391-5601-46cc-b26d-e068e16ba856</onfalse></stage><stage stageid="b81d9f56-ce58-4304-9afe-95219648fe1b" name="Temp_Retry" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="255" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="82beb391-5601-46cc-b26d-e068e16ba856" name="Anchor8" type="Anchor"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="195" y="255" w="10" h="10" /><onsuccess>8579fe53-2aff-46c6-9c43-825ce5a8d99c</onsuccess></stage><stage stageid="0050baa5-237e-4426-a0cb-9f32e6cda0c2" name="Kill Process" type="Action"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="300" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>8940eca9-ca92-4165-849d-1c25a685c08a</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="8579fe53-2aff-46c6-9c43-825ce5a8d99c" name="Anchor9" type="Anchor"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="195" y="360" w="10" h="10" /><onsuccess>8940eca9-ca92-4165-849d-1c25a685c08a</onsuccess></stage><stage stageid="5793c4d7-f5aa-4ee0-b99f-4ea24f0fc0da" name="Run_Status" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="210" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a963eaa0-7436-413d-bed0-8eeb4c362775" name="Error_Message" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-300" y="480" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="11ddb52f-8c14-4b3b-a99d-2932ca8dd8db" name="Unexpected exception recover" type="Recover"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="420" y="150" /><onsuccess>d3a901ce-49d2-4ac0-8d9a-624ca5201037</onsuccess></stage><stage stageid="3def2a9b-a6ed-44e1-87cd-43a6013c35cf" name="Unexpected Exception" type="Exception"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="570" y="150" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="8ae13a7c-7b0e-43fa-a29c-9d2f4f68eefc" name="Script_Loc" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-240" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d3a901ce-49d2-4ac0-8d9a-624ca5201037" name="Delete_Script" type="Action"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="495" y="150" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3def2a9b-a6ed-44e1-87cd-43a6013c35cf</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="2b4e5e1f-d751-41d9-ae99-3ac82d38a3e5" name="Validate Temp Script Path" type="SubSheet"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="-105" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>9c533714-5bf6-44a9-b976-21f9545020af</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="ad8b489b-36d8-4a59-9a99-f3ac2c26b96b" name="Library Name" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-450" y="255" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="843f4c23-1d43-4ee8-b818-9c27af4116d8" name="Make changes" type="MultipleCalculation"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="90" y="0" /><onsuccess>2a280cac-266e-417b-a756-0321aa0e4b4d</onsuccess><steps><calculation expression="Replace([Script], &quot;___RPA_LIBRARYNAME___&quot;, [Library Name])" stage="Script" /><calculation expression="Replace([Script], &quot;___RPA_LIBRARYPATH___&quot;, [SP_Lib_Folder_Path])" stage="Script" /></steps></stage><stage stageid="417cec70-6904-4c8c-8414-6a4ea038ac00" name="FieldName" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-315" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9a67109-0e36-4bb8-a3d1-70e62eca8d16" name="FieldValue" type="Data"><subsheetid>037b1357-f73c-441e-9f92-656633cd1fd5</subsheetid><display x="-255" y="300" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63ac03d3-b415-44db-a205-ec92daa2c8b9" name="Get All Latest Files W.r.t File Creation Time" type="SubSheetInfo"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><narrative>Get All Latest File W.r.t File Creation time From Sharepoint</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="16af43c1-353c-4e48-bf02-93469eda186a" name="Create New Shell Document Set" type="SubSheetInfo"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><narrative>Create New Folder in a library.
MinAccess:- Add_Edit
On success "Folder Created Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f5fa8978-920d-42d7-b307-92bd9410dcf2" name="Start" type="Start"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target Folder Name Ex:- PNP_Test_Lib/Unittesting" stage="SP_RelLib_Url" /><input type="text" name="New_Folder_Name" narrative="New Folder . Ex:- Test" stage="New_Foldername" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Content_Type" narrative="Type of content that will be created, Ex: Shell Document Set" stage="Content_Type" /></inputs><onsuccess>2ea852c5-b49c-4947-baf4-8b3e4405ba49</onsuccess></stage><stage stageid="308b656b-a0a1-48a5-b822-8a5df4ccb185" name="Build Script" type="Calculation"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="-15" /><onsuccess>69073ef5-5580-49cf-8330-6fdf7e6b9759</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&#xA;&quot;Add-PnPDocumentSet -Name &quot; &amp;Chr(34) &amp; [New_Foldername]  &amp;Chr(34) &amp;  &quot; -List &quot; &amp;Chr(34) &amp;  [SP_RelLib_Url] &amp;Chr(34) &amp; &quot; -ContentType &quot; &amp;Chr(34) &amp;  [Content_Type] &amp;Chr(34) &amp;   &quot; -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Folder Created  Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException]  { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="e19a6968-e862-40a5-85b5-958fba6daa71" name="Run PnP_Script" type="SubSheet"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>ae7e50fe-ff4b-4308-ae94-ad52ece75a1c</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d01e24a1-9e47-425a-a607-78b252787406" name="Delete_Script" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>909b4328-bf5e-4a80-9d1b-ecfb1ad232cd</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="69073ef5-5580-49cf-8330-6fdf7e6b9759" name="Generate_PnPScript" type="SubSheet"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_Folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>6a539153-71e4-4d9b-a3a5-11de8fdea14d</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="6a539153-71e4-4d9b-a3a5-11de8fdea14d" name="Check_Error" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>f8f549f0-2be3-47a1-b1a7-537289e05d08</ontrue><onfalse>e19a6968-e862-40a5-85b5-958fba6daa71</onfalse></stage><stage stageid="f8f549f0-2be3-47a1-b1a7-537289e05d08" name="Exception while creating  Script" type="Exception"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="d59ffd93-48b3-4f9e-b501-fc93b9575b8b" name="Check Process_Exist" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>1132821c-34f1-4c1a-9e35-4d7f7f061b9f</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="1132821c-34f1-4c1a-9e35-4d7f7f061b9f" name="ProcessExist?" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>3aff71a3-4f05-44c9-b78c-048de173d752</ontrue><onfalse>96da6c3c-9ed4-4a7d-a5b6-e0e11ffcf8d7</onfalse></stage><stage stageid="96da6c3c-9ed4-4a7d-a5b6-e0e11ffcf8d7" name="Anchor8" type="Anchor"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="90" y="285" w="10" h="10" /><onsuccess>19efe31f-2ed0-4a9e-9101-7162a70959dc</onsuccess></stage><stage stageid="3aff71a3-4f05-44c9-b78c-048de173d752" name="Kill Process" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="330" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d01e24a1-9e47-425a-a607-78b252787406</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="19efe31f-2ed0-4a9e-9101-7162a70959dc" name="Anchor9" type="Anchor"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="90" y="390" w="10" h="10" /><onsuccess>d01e24a1-9e47-425a-a607-78b252787406</onsuccess></stage><stage stageid="b9b53a59-1a67-4f6c-bf1c-bd506a084749" name="SP_Site_URL" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-255" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b2e44ead-892c-4540-b64b-0c15dc2fa2b5" name="SP_RelLib_Url" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-255" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="860ec1cb-2bfe-4d6f-935b-42c589eed098" name="Output" type="Block"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-285" y="180" w="105" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b104d84a-b1cf-4155-a72c-d8657ad87291" name="Script" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ca11141f-ba3a-4fe3-96b2-d9ae4e3c51fd" name="Return Message" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-405" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e16c1aa3-229b-4f39-bbf3-e2262a986c35" name="Script Path" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-405" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2cad544c-97e1-49db-b65f-3f8d807d151b" name="Error_Message" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-225" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="98d78efc-f095-4710-910a-965a14d5fc59" name="Run Report" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-240" y="270" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e170c104-4144-48f1-903a-691a23c5f252" name="P_Exists" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="270" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="853e3803-c115-46c1-8127-7959fc3650df" name="Unexpected exception recover" type="Recover"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="450" y="-30" /><onsuccess>1bd60b47-0add-466f-b0f5-dc18711e5484</onsuccess></stage><stage stageid="bb771a46-7abb-4dc1-93fc-d51b086fc4f6" name="Unexpected Exception" type="Exception"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="525" y="75" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="e76fe2c7-d00c-4134-b41a-5f8532141c0e" name="Script_Location" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1bd60b47-0add-466f-b0f5-dc18711e5484" name="Delete_Script" type="Action"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="450" y="75" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>bb771a46-7abb-4dc1-93fc-d51b086fc4f6</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="c33f72fa-dd02-4af3-b9a6-7fad1a4cff93" name="Validate Temp Script Path" type="SubSheet"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>308b656b-a0a1-48a5-b822-8a5df4ccb185</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="c9ed22d8-4d07-4a95-8d84-6853d0c4123a" name="Error Message?" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><narrative>Checks if run received exception</narrative><display x="105" y="180" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>a725a3be-d3d7-49af-ac1d-f37f88cd28ac</ontrue><onfalse>d59ffd93-48b3-4f9e-b501-fc93b9575b8b</onfalse></stage><stage stageid="a725a3be-d3d7-49af-ac1d-f37f88cd28ac" name="Received exception after running the script" type="Exception"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="210" y="180" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="251e16ac-bbd8-4e94-8e7a-97f0c635c190" name="Input" type="Block"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-300" y="15" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4a1e2bf0-6b72-42da-ac81-24fda25a7d79" name="Inhouse" type="Block"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-465" y="60" w="120" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="909b4328-bf5e-4a80-9d1b-ecfb1ad232cd" name="End" type="End"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="15" y="450" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;Folder Created Successfully&#xA;&quot; will be displayed" stage="Run Report" /><output type="text" name="Error_Message" narrative="On Error &quot; correcsponding  error message &quot; will be displayed" stage="Error_Message" /></outputs></stage><stage stageid="17bf6c65-6ae6-47b8-9b5d-d6dfbbfb0bd8" name="User Name" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-405" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4aad0ae4-5cdb-4960-883f-d7f28a23a023" name="New_Foldername" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-195" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ae7e50fe-ff4b-4308-ae94-ad52ece75a1c" name="Is folder already Exists?" type="Decision"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="180" /><decision expression="InStr(Lower([Run Report]), &quot;already exists&quot;)&gt;0" /><ontrue>94c8a0c1-51f5-428f-b25f-b29d171ee102</ontrue><onfalse>c9ed22d8-4d07-4a95-8d84-6853d0c4123a</onfalse></stage><stage stageid="94c8a0c1-51f5-428f-b25f-b29d171ee102" name="Message - Folder already exists" type="Calculation"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-75" y="180" /><onsuccess>d59ffd93-48b3-4f9e-b501-fc93b9575b8b</onsuccess><calculation expression="Replace([Run Report], &quot;ERROR&quot;, &quot;&quot;)" stage="Run Report" /></stage><stage stageid="945a35e3-e59e-4bde-ba67-2605aacd0dfb" name="Content_Type" type="Data"><subsheetid>30190991-ab3e-4ddb-9772-58b10005b47c</subsheetid><display x="-255" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2ba1dcce-890d-4687-966b-28abe463ffd0" name="Get All Latest Files W.r.t File Modified Time" type="SubSheetInfo"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><narrative>Get All Latest File W.r.t File modified time From Sharepoint</narrative><display x="-555" y="-150" w="150" h="90" /></stage><stage stageid="637d96e3-040c-473a-8eaf-2dc836471e1b" name="Return Message" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="270" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3582af1a-f38d-4833-a981-2f1627cc5951" name="Generate Script" type="Calculation"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-45" y="-60" /><onsuccess>32087c91-09bf-4cb8-ba2e-239d24db0b88</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&quot;&quot; &amp;[SharePoint URL]&amp;&quot;&quot;&quot;&quot;&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;&#xA;$files= Get-PnPFolderItem -FolderSiteRelativeUrl '&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;'&quot;&amp;NewLine()&amp;&quot;&#xA;$now= (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;').AddDays(&quot;&amp;[AddDays]&amp;&quot;).AddHours(&quot;&amp;[AddHours]&amp;&quot;).AddMinutes(&quot;&amp;[AddMinutes]&amp;&quot;).AddSeconds(&quot;&amp;[AddSeconds]&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;')&quot;&amp;NewLine()&amp;&quot;&#xA;$files=$files | Sort-Object -Property TimeLastModified&quot;&amp;NewLine()&amp;&quot;&#xA;For ($i=0; $i -le $files.Count ; $i++)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;if($files[$i].TimeLastModified -gt $now -And $files[$i].TimeLastModified -lt $currentDt)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;$Excel = $files[$i].Name +&quot;&quot;,&quot;&quot;+$files[$i].TimeLastModified&quot;&amp;NewLine()&amp;&quot;&#xA;Add-Content &quot;&quot;&quot;&amp;[Destination Latest Excel Name Folder Path]&amp;&quot;&quot;&quot; $Excel }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;&#xA;&#xA;" stage="Script" /></stage><stage stageid="256ad2c2-51c2-410d-b32a-b230c8e77751" name="Script" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af412d0b-dbef-4bda-b07d-b56e17f9ba18" name="Success" type="Data"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-300" y="225" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="936e62fa-197d-4f3e-83f6-a12d92330f02" name="Standards" type="Note"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

