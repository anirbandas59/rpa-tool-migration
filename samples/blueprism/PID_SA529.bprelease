3bf-e696e86c3224" name="End" type="End"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="0" y="105" /></stage><stage stageid="d5ce566a-1de1-463f-ba89-c5cf0920e8f6" name="Remove filter - code" type="Code"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="0" y="-15" w="120" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>d8b292fb-4ca6-48ca-8b75-2e373674bea0</onsuccess><code><![CDATA[Dim wb, ws as object
Dim cells as object

Try
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)
cells = ws.cells

if ws.autofiltermode then
'If ws.FilterMode Then ws.ShowAllData
If ws.FilterMode Then cells.Autofilter
end if

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
End Try]]></code></stage><stage stageid="215aef74-2b6f-4ee3-bb01-a2d9c999ff08" name="Success" type="Data"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ad537a37-d5de-4115-8fe6-590aed599108" name="Message" type="Data"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="08dcc5bc-c38b-4fde-a7df-cef6d1f03b3f" name="Handle" type="Data"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="45" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f29bb240-2c91-4063-b00e-6a96743db08a" name="Workbook" type="Data"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5d85862c-de8d-45ca-95e1-47952e61f0ee" name="Worksheet" type="Data"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="26b323a8-73d5-47d1-a13c-9bd9ffe423a9" name="Throw Exception" type="Exception"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="120" y="45" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="d8b292fb-4ca6-48ca-8b75-2e373674bea0" name="Check Success?" type="Decision"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="0" y="45" w="90" h="30" /><decision expression="[Success]" /><ontrue>0a1ff69e-ad22-4491-b3bf-e696e86c3224</ontrue><onfalse>26b323a8-73d5-47d1-a13c-9bd9ffe423a9</onfalse></stage><stage stageid="3b7d4234-b9cc-4a7b-8327-1df51c67eb9b" name="Inputs" type="Block"><subsheetid>e06b36db-ddaf-4dfe-a8e2-5bee7d7933f6</subsheetid><loginhibit onsuccess="true" /><display x="-240" y="-45" w="135" h="135" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="4c32dc23-bd71-4f04-ac37-73001db93b7f" name="Color Range" type="SubSheetInfo"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><narrative>Coloring of cells with color index as input</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="c50bc986-2459-4797-838e-67eafa21aac7" name="End" type="End"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="15" y="90" /></stage><stage stageid="79b0d00f-5446-4ecd-ae40-9de148c99ea2" name="Color Range1" type="Code"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Reference]" /><input type="text" name="CI" expr="[Color Index]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>9c9b400e-eeb5-4fe9-bf0a-fd3a2d54620c</onsuccess><code><![CDATA[Dim wb,ws,excel,range As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

ws.Range(Reference).Interior.ColorIndex  = CI

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="d9a8b118-8c72-43a7-bde4-44e7acd0db32" name="Throw Exception" type="Exception"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="9c9b400e-eeb5-4fe9-bf0a-fd3a2d54620c" name="Check Success?" type="Decision"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>c50bc986-2459-4797-838e-67eafa21aac7</ontrue><onfalse>d9a8b118-8c72-43a7-bde4-44e7acd0db32</onfalse></stage><stage stageid="efc4551d-4239-483a-9378-d6126344f4ff" name="Color Index" type="Data"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="46cd5208-b57b-4dc6-b035-dfb96f55af82" name="Message" type="Data"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0d3022cc-a555-4c38-9302-9c3740ba13ab" name="Success" type="Data"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-60" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="589c92d0-7c00-4068-8af5-a4aca5a4dc1c" name="Workbook" type="Data"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ac9622d4-b452-44af-9b3e-1fc41b3b58e1" name="Handle" type="Data"><subsheetid>305fb954-6a1c-4574-a18e-c70a34ed8fca</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="15" /><datatype>number</datatype><initialvalue />