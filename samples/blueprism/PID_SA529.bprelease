</narrative><display x="-360" y="-45" w="150" h="210" /></stage><stage stageid="b1663b58-d99f-4f8e-9641-4b3db50ca615" name="Clean Up" type="Calculation"><subsheetid>41e124bf-bc71-4b3c-9b3b-9f5d8b8fd79f</subsheetid><loginhibit /><display x="15" y="-75" /><onsuccess>d9a607b6-73e8-49ec-b2bc-a8032c0ab747</onsuccess><calculation expression="Replace([File Name],&quot;&quot;&quot;&quot;,&quot;&quot;)" stage="File Name" /></stage><stage stageid="80208144-c05c-4b32-bd6a-de8320da32e5" name="New Entry ID" type="Data"><subsheetid>61b6fc18-b98a-4456-9381-8c8cfe9f6f60</subsheetid><display x="-180" y="180" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e97ce274-4c90-403b-8f2b-4fa8ac86d7bf" name="-------------------Extended Features----------------------" type="SubSheetInfo"><subsheetid>568cc940-38c2-412b-8031-4074a454e58b</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5e720da7-7e89-4c44-8cfe-945ce64c7d09" name="Start" type="Start"><subsheetid>568cc940-38c2-412b-8031-4074a454e58b</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>28c77448-1e12-4335-9e7d-2422586e686a</onsuccess></stage><stage stageid="28c77448-1e12-4335-9e7d-2422586e686a" name="End" type="End"><subsheetid>568cc940-38c2-412b-8031-4074a454e58b</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="99783a17-aec9-48db-bbb7-6c3cd76114a0" name="Send Email" type="SubSheetInfo"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><narrative>Sends an Email </narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bcb08776-c760-4903-b5fb-928dbc53abcc" name="End" type="End"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="15" y="120" /></stage><stage stageid="91e64bba-77b1-401f-85ca-5dfe80fef704" name="Send Item_Mailbox" type="Code"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="flag" name="Message Is HTML" expr="[Message Is HTML]" /><input type="number" name="MailBoxNumber" expr="[MailBoxNumber]" /></inputs><onsuccess>bcb08776-c760-4903-b5fb-928dbc53abcc</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim mail = app.CreateItem(0)
Dim addressCount As Integer

If [To] <> "" Then
	Dim toAddresses = Split([To], ";")
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = mail.Recipients.Add(toAddresses(addressCount)) 
	recipient.Resolve  
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTo
	Next 
	
End if

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = mail.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = mail.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

mail.Subject = Subject
mail.HTMLBody = Message

For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	mail.Attachments.Add(att)
Next

With mail
	.Save
	.SendUsingAccount = app.Session.Accounts.Item(MailBoxNumber)
	'.SentOnBehalfOfName = """SSSCMLA International Marine Triton SSSCMLA-DIO/5M3""SSSCMLA-International-Marine-Triton@shell.com"
	.Send
End with

'mail.Save
'mail.Send
'mail.SentOnBehalfOfName 

]]></code></stage><stage stageid="94632996-c5e8-45d9-9eeb-5154dfaf3ac6" name="Subject" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91a0a214-d3ba-4a13-99ab-340859c0cb7c" name="To" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8f5481fa-1da6-41e1-b5e6-7e27b33e13b9" name="Message" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="858a9631-36c3-4e41-b052-1dca9b1046b9" name="Attachments" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9acd1b42-4f2e-456e-9bc7-14972722471a" name="CC" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5055c07f-da7f-43de-b854-b308b786d5b6" name="BCC" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8d0f6636-1c2c-4f69-85ca-75de8967ceb1" name="Message Is HTML" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="27087e64-2816-454c-86c5-b8b07334bf77" name="Start" type="Start"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" stage="To" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." stage="Subject" /><input type="text" name="Message" narrative="Optional, HTML or plain text" stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="number" name="MailBoxNumber" narrative="Mailbox number. 0 is personal mail box and subsequent will start with 1." stage="MailBoxNumber" /></inputs><onsuccess>91e64bba-77b1-401f-85ca-5dfe80fef704</onsuccess></stage><stage stageid="d3bc9bd1-ed2b-4471-bb70-1760629f7fa3" name="Input" type="Block"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5d5079bc-b3b1-4892-a016-5c48b464ef48" name="MailBoxNumber" type="Data"><subsheetid>56ab9786-3ff3-4858-a096-a33ccc0336d2</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="9d2428c8-6a31-4578-b29a-7e4d33bb3de7" name="Forward Email - As Source Format" type="SubSheetInfo"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><narrative>Forward Email to recipients (To/CC/BCC) including (Message) as input parameters.
Forwards the email with source format
The &lt;Forward Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-195" y="-45" w="150" h="150" /></stage><stage stageid="7d2521ca-5b67-4efd-96e6-347e51999cd9" name="End" type="End"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="5b28b148-0c58-4ef3-84cc-c20e31085bd0" name="Entry ID" type="Data"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="588d74ce-d088-4217-9b7d-ead46f451d52" name="Message" type="Data"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1431d5aa-0138-4d53-9532-4ca8aa27eb11" name="Forward Email - As Source Format" type="Code"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><loginhibit /><narrative>Forwards the email with same Source Format eighter in HTML or Plain Text format</narrative><display x="15" y="-15" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Entry ID" expr="[Entry ID]" /></inputs><onsuccess>7d2521ca-5b67-4efd-96e6-347e51999cd9</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim mail = item.Forward
Dim addressCount As Integer

If [To] <> "" Then
	Dim toAddresses = Split([To], ";")
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = mail.Recipients.Add(toAddresses(addressCount)) 
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTo
	Next

End If

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = mail.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve	
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC
	Next

End If
	
If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = mail.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

mail.Body = Message & vbCrLf & mail.Body
mail.Save
mail.Send]]></code></stage><stage stageid="f150c2d8-8716-4045-a603-b353c1764ae6" name="To" type="Data"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="27b66117-98db-4b3d-b926-106dda9f779d" name="CC" type="Data"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33aac627-0507-4c5d-ad71-ad87094116bc" name="BCC" type="Data"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cb4b388-77fb-4d92-9c24-c8106184ace3" name="Start" type="Start"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" stage="To" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /><input type="text" name="Message" narrative="Mandatory, Any alphanumeric value allowed. HTML or plain text." stage="Message" /></inputs><onsuccess>1431d5aa-0138-4d53-9532-4ca8aa27eb11</onsuccess></stage><stage stageid="dd4b4dff-c7b5-497f-8be5-67259dae6168" name="Input" type="Block"><subsheetid>e9530224-98ef-4a28-90c2-47e4bc89d850</subsheetid><loginhibit /><display x="-270" y="45" w="150" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="13b640c1-5fd5-45fc-9aba-41f75bac58e5" name="Move Email to Inbox Sub Folder" type="SubSheetInfo"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><narrative>Moves an email to a subfolder within the inbox folder.

The Entry ID is the unique idenfier used to determine which email is to be moved.

Example
Inbox to Inbox\SubFolder </narrative><display x="-180" y="-60" w="150" h="120" /></stage><stage stageid="d1a81e48-29ef-4468-a8e8-17ed124d59f7" name="Start" type="Start"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Destination Folder" narrative="Mandatory. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Destination Folder" /><input type="text" name="MailBoxName" narrative="Mail Box Name" stage="MailBoxName" /><input type="text" name="SourceFolder" narrative="Mandatory Value for souce folder" stage="SourceFolder" /></inputs><onsuccess>67870dbd-d35f-471e-aaca-d3ddf6ba7327</onsuccess></stage><stage stageid="87a7ae3d-d234-4b8e-a3dc-66279acd6422" name="End" type="End"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="New Entry ID" narrative="Returns the new Entry ID from the Moved Email Object" stage="New Entry ID" /></outputs></stage><stage stageid="67870dbd-d35f-471e-aaca-d3ddf6ba7327" name="MoveBetweenFolders" type="Code"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="SourceFolder" expr="[SourceFolder]" /><input type="text" name="DestinationFolder" expr="[Destination Folder]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="text" name="New Entry ID" stage="New Entry ID" /></outputs><onsuccess>87a7ae3d-d234-4b8e-a3dc-66279acd6422</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
'Dim Folders
Dim FolderTemp
dim folder 
dim Dest
dest = ""
'on error resume next



Dim folder1 ,SubFolder,SubFolder1
folder = _nameSpace.Folders(MailBoxName)

'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")
SubFolder = SourceFolder
If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

folder1 = _nameSpace.Folders(MailBoxName)
SubFolder1 = DestinationFolder
If SubFolder1 <> "" Then
	For each name as string in SubFolder1.Split("\")
	folder1 = folder1.Folders(name)
	Next
End If

For Each FolderTemp In _nameSpace.Folders
    If FolderTemp.Name = MailBoxName Then
	'folder = FolderTemp.Folders("Inbox")
	Dim item = _nameSpace.GetItemFromID(Entry_ID)

	New_Entry_ID = item.Move(folder1).EntryID
	End If
Next







]]></code></stage><stage stageid="ace01fc8-b93f-4797-9b59-6dd111f26835" name="Entry ID" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-180" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4844ad30-9852-4100-b756-76b04f14c07b" name="Outlook Folder ID" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><narrative>MS Outlook - OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-180" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1169602b-d75f-4b32-8b5f-3c0ac1cde524" name="Destination Folder" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><display x="-180" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="07abb5a8-27af-4e42-8ffc-60f1875517c1" name="Input" type="Block"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><display x="-255" y="15" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="69346078-d2bc-4a6d-a0d6-edafe139aba4" name="Default" type="Block"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><display x="-255" y="135" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="54c150d4-54b3-41c1-8e13-238d7b0eabcb" name="New Entry ID" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><display x="-180" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91bc17df-8fae-4eec-91c9-b58490296f48" name="MailBoxName" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><display x="-180" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="7a0c520d-bc9b-49d9-8808-555d33f2a3a0" name="SourceFolder" type="Data"><subsheetid>f9359139-56ed-4901-9d9a-1825b468fad9</subsheetid><loginhibit /><display x="-180" y="270" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fdf78255-c09a-49b7-a517-a114d09966ce" name="Save specific Attachment" type="SubSheetInfo"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><narrative>Save only the attachment with specifice file name or file format. Existing save attachmnet page saves all the attachments</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0b0adbd4-8ef1-4830-9304-e8afa602c0a9" name="End" type="End"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="e84a89fe-edc7-41f8-a055-81d0c258a361" name="Save specific Attachment" type="Code"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Folder_Path" expr="[Folder Path]" /><input type="text" name="Entry_ID" expr="[Entry ID]" /><input type="text" name="File_Pattern" expr="[File Name]" /></inputs><onsuccess>0b0adbd4-8ef1-4830-9304-e8afa602c0a9</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"

For Each attachment As Object In item.Attachments
	If attachment.Type = 1 AndAlso attachment.FileName Like File_Pattern Then
		attachment.SaveAsFile(Folder_Path & attachment.FileName)
	End If
Next
]]></code></stage><stage stageid="c40e43b1-2e0f-4185-b3a0-e832618089dc" name="Folder Path" type="Data"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="df57ebf4-f31f-499d-93a0-6f1c6117f6a7" name="Entry ID" type="Data"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9ed9acf-293f-40cb-9803-5772c4e3194e" name="File Name" type="Data"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="26f34cfb-287b-4382-a40c-c75c25c1f485" name="Input" type="Block"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="efb1edee-809c-4487-ad71-5df3108445fc" name="Start" type="Start"><subsheetid>9c89ae2b-5315-4850-9947-49781f293321</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Folder Path" narrative="The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /><input type="text" name="File Name" narrative="Name of pattern of the file to be saved. common cases inlcude &quot;.docx&quot; , &quot;.pdf&quot; , &quot;.xlsx&quot; etc." stage="File Name" /></inputs><onsuccess>e84a89fe-edc7-41f8-a055-81d0c258a361</onsuccess></stage><stage stageid="756af0d9-a082-4f8b-b4d3-428f32e8ac67" name="Get Received Items (Basic)" type="SubSheetInfo"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><narrative>Read Emails from the outlook group email box</narrative><display x="-390" y="-75" w="150" h="90" /></stage><stage stageid="d34affb4-ba4b-4fe1-b8e0-1154ba047b34" name="Item Count" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="240" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63fda0fd-e822-43be-93f9-76c246ea0ed4" name="Internal_Get Items - Group Email" type="SubSheet"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="465" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" expr="[MailBoxName]" /><input type="text" name="SubFolder" narrative="Name of the SubFolder" expr="[SubFolder]" /></inputs><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>cfbd8018-bc0f-46ff-8ddf-6d14a2733c6b</onsuccess><processid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</processid></stage><stage stageid="6a8c26e6-8450-4574-8ee7-f813a6392342" name="Outlook Folder ID" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="cfbd8018-bc0f-46ff-8ddf-6d14a2733c6b" name="End" type="End"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="540" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="e23eb457-d627-4d89-a34b-1d076b661abc" name="Subject" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3d517493-5db7-4793-99b6-a80bab5b1cf2" name="Start" type="Start"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sender Name" narrative="Optional. The From display name, which might be a name (eg John Smith) or email address (eg admin@client.com). Asterisk wildcard permitted, eg *John Smith* for any mail where the text 'John Smith' appears in the From field." stage="Sender Name" /><input type="text" name="Sender Email" narrative="Optional. The sender email address." stage="Sender Email" /><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="SubFolder" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>32806825-409e-46c1-ab96-46ea1e441746</onsuccess></stage><stage stageid="eba00a4f-910a-4b74-8eae-38b429c77b25" name="Received Earliest" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af018896-f58c-49e9-940b-c953c8934501" name="Received Latest" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06692af6-4c18-4903-a09e-53d19ec1516a" name="Filter Expression" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="32806825-409e-46c1-ab96-46ea1e441746" name="Sender Name?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="-45" /><decision expression="[Sender Name]&lt;&gt;&quot;&quot;" /><ontrue>ba287555-8a74-4afe-bdfe-933c56118059</ontrue><onfalse>057ffdb1-6276-481f-9d70-b53f5ebac8ca</onfalse></stage><stage stageid="ba287555-8a74-4afe-bdfe-933c56118059" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="-45" /><onsuccess>057ffdb1-6276-481f-9d70-b53f5ebac8ca</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:sendername LIKE '&quot;&amp;Replace([Sender Name], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="fb0fc600-7bc8-417d-b039-e0c62e42647b" name="Clean Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="330" /><onsuccess>365311b1-ec2e-484d-903e-365a21658582</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="ee20e8bb-b026-44c1-aab7-746a4dd0962f" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>54f08020-d475-479d-924d-de4ad2e6ad90</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="3dd0e7d1-61e3-46d2-90db-946f800df40f" name="Subject?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="45" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>ee20e8bb-b026-44c1-aab7-746a4dd0962f</ontrue><onfalse>54f08020-d475-479d-924d-de4ad2e6ad90</onfalse></stage><stage stageid="057ffdb1-6276-481f-9d70-b53f5ebac8ca" name="Sender Email?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="0" /><decision expression="[Sender Email]&lt;&gt;&quot;&quot;" /><ontrue>8f886655-b84c-4af7-adcc-bafc78e03f20</ontrue><onfalse>3dd0e7d1-61e3-46d2-90db-946f800df40f</onfalse></stage><stage stageid="8f886655-b84c-4af7-adcc-bafc78e03f20" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="0" /><onsuccess>3dd0e7d1-61e3-46d2-90db-946f800df40f</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:senderemail LIKE '&quot;&amp;Replace([Sender Email], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="9087fb1a-2199-49f6-a12a-c505a8ac1cf4" name="Sender Name" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="839f322a-5886-4a27-862e-7342bf437ddb" name="Sender Email" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="365311b1-ec2e-484d-903e-365a21658582" name="Filter Expression?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="375" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>2cb52619-0355-459e-9262-025155daa6be</ontrue><onfalse>63fda0fd-e822-43be-93f9-76c246ea0ed4</onfalse></stage><stage stageid="2cb52619-0355-459e-9262-025155daa6be" name="Prepend" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="375" /><onsuccess>63fda0fd-e822-43be-93f9-76c246ea0ed4</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="95ae2f74-2b4d-4bfe-8143-c6331f36e89f" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="270" /><onsuccess>fb0fc600-7bc8-417d-b039-e0c62e42647b</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="bb130031-623d-4f69-817e-29a67105f4c7" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="135" /><onsuccess>8ddd22fe-3e25-4b39-92cb-57a6149426f6</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="90e419b9-6703-4978-8883-563526cfcb29" name="Earliest?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="135" /><decision expression="IsDate([Received Earliest])" /><ontrue>bb130031-623d-4f69-817e-29a67105f4c7</ontrue><onfalse>8ddd22fe-3e25-4b39-92cb-57a6149426f6</onfalse></stage><stage stageid="8ddd22fe-3e25-4b39-92cb-57a6149426f6" name="Latest" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="IsDate([Received Latest])" /><ontrue>791e5681-e7c1-418f-bdf9-87fd0bb7426d</ontrue><onfalse>1b032e2f-c814-4748-9c49-8df96c8a2d8a</onfalse></stage><stage stageid="791e5681-e7c1-418f-bdf9-87fd0bb7426d" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="180" /><onsuccess>1b032e2f-c814-4748-9c49-8df96c8a2d8a</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="1456ad64-e8a9-4c05-b479-c6a1a43edae7" name="Include Unread" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="13df69d3-6ae4-40ef-929c-0c820ff3b318" name="Include Read" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="1b032e2f-c814-4748-9c49-8df96c8a2d8a" name="Unread Only?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="225" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>95ae2f74-2b4d-4bfe-8143-c6331f36e89f</ontrue><onfalse>79e937c4-7bff-46f3-afca-5c3d0fee4208</onfalse></stage><stage stageid="79e937c4-7bff-46f3-afca-5c3d0fee4208" name="Read Only?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="225" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>6397db82-221d-46d8-b6ce-6cfaea57206a</ontrue><onfalse>ccc85020-6c30-4afc-b38f-41979f71a0fe</onfalse></stage><stage stageid="6397db82-221d-46d8-b6ce-6cfaea57206a" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="270" /><onsuccess>65b58888-5d4b-43c0-a147-9d30d5aee10c</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="ccc85020-6c30-4afc-b38f-41979f71a0fe" name="Anchor1" type="Anchor"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="150" y="225" w="10" h="10" /><onsuccess>085a1538-a394-445e-9f1f-d20dced254a2</onsuccess></stage><stage stageid="085a1538-a394-445e-9f1f-d20dced254a2" name="Anchor1" type="Anchor"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="150" y="330" w="10" h="10" /><onsuccess>65b58888-5d4b-43c0-a147-9d30d5aee10c</onsuccess></stage><stage stageid="65b58888-5d4b-43c0-a147-9d30d5aee10c" name="Anchor1" type="Anchor"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="330" w="10" h="10" /><onsuccess>fb0fc600-7bc8-417d-b039-e0c62e42647b</onsuccess></stage><stage stageid="d0ba4d00-0be2-4910-ae6c-d7c95bd7f6a8" name="Items" type="Collection"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="195" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="c303115c-ceba-4c97-8aa8-3aefe0434042" name="Filter Expression" type="Calculation"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="90" y="90" /><onsuccess>90e419b9-6703-4978-8883-563526cfcb29</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="54f08020-d475-479d-924d-de4ad2e6ad90" name="Message?" type="Decision"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="15" y="90" /><decision expression="[Message]&lt;&gt;&quot;&quot;" /><ontrue>c303115c-ceba-4c97-8aa8-3aefe0434042</ontrue><onfalse>90e419b9-6703-4978-8883-563526cfcb29</onfalse></stage><stage stageid="e145e9e8-58c0-42fa-b1ce-206781556876" name="Message" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="240" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ee3da003-7d05-4169-be81-0aeeff9f577a" name="Input" type="Block"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="-270" y="-120" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ad43b338-a68e-4794-8670-70354ed9b9dd" name="Output" type="Block"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><loginhibit /><display x="-270" y="150" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="9f1221c4-8993-49f7-b3f8-0ccd66dd791e" name="MailBoxName" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-195" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67c1dd06-0720-4a1e-b5b5-14284ec99f47" name="SubFolder" type="Data"><subsheetid>e0884a1e-45b6-4933-9c6e-e053655455af</subsheetid><display x="-210" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b7fc91ed-bb39-46c9-9543-dcb054270dc7" name="Get Received Items (Basic with cc and bcc) - Group Email" type="SubSheetInfo"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><narrative>Read Emails from the outlook group email box</narrative><display x="-390" y="-75" w="150" h="90" /></stage><stage stageid="d7a6f695-ca4b-4c44-8fa9-8c9d65f23df9" name="Item Count" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="240" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fc80d559-0b87-4c06-9e93-c1c791e69d41" name="Internal_Get Items - Group Email (with Cc and Bcc)" type="SubSheet"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="420" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" expr="[MailBoxName]" /><input type="text" name="SubFolder" narrative="Name of the SubFolder" expr="[SubFolder]" /></inputs><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>2fca59c3-3d6b-40e6-801b-fe4bc93cf0fb</onsuccess><processid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</processid></stage><stage stageid="17da1125-d27f-4757-891c-0f30624c5f5e" name="Outlook Folder ID" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="2fca59c3-3d6b-40e6-801b-fe4bc93cf0fb" name="End" type="End"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="480" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="2f41357d-44ef-4b45-b24d-183e42cc64ef" name="Subject" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2bbae85b-770f-42e6-ba45-4547b2f5cda0" name="Start" type="Start"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sender Name" narrative="Optional. The From display name, which might be a name (eg John Smith) or email address (eg admin@client.com). Asterisk wildcard permitted, eg *John Smith* for any mail where the text 'John Smith' appears in the From field." stage="Sender Name" /><input type="text" name="Sender Email" narrative="Optional. The sender email address." stage="Sender Email" /><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="SubFolder" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>b34b95a6-5d4e-41de-a159-6704962b00e2</onsuccess></stage><stage stageid="23cf5047-d8f9-4b72-b382-122ddce5d4d2" name="Received Earliest" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="324f320a-c9ed-43c3-bb5b-da1671f661ce" name="Received Latest" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="09f9050e-865a-4abd-806f-45f8260da8ab" name="Filter Expression" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b34b95a6-5d4e-41de-a159-6704962b00e2" name="Sender Name?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="-45" /><decision expression="[Sender Name]&lt;&gt;&quot;&quot;" /><ontrue>19bc1456-f8d9-493b-b330-e53a0e6c2ebd</ontrue><onfalse>ea25c56c-0a6c-412e-99f3-a2c235ec6241</onfalse></stage><stage stageid="19bc1456-f8d9-493b-b330-e53a0e6c2ebd" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="-45" /><onsuccess>ea25c56c-0a6c-412e-99f3-a2c235ec6241</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:sendername LIKE '&quot;&amp;Replace([Sender Name], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="3b232534-6884-47c6-9949-3ba68bff2bf5" name="Clean Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="330" /><onsuccess>f77c94b5-fec0-462a-88ba-318aad4971ac</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="1956bb47-4ac4-4e0d-841e-2c74cbfa886d" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>31882f9e-de47-42fb-a035-fc89f4a37318</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="9f7b7d69-8d78-4200-bfa5-4b0bef77db2e" name="Subject?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="45" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>1956bb47-4ac4-4e0d-841e-2c74cbfa886d</ontrue><onfalse>31882f9e-de47-42fb-a035-fc89f4a37318</onfalse></stage><stage stageid="ea25c56c-0a6c-412e-99f3-a2c235ec6241" name="Sender Email?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="0" /><decision expression="[Sender Email]&lt;&gt;&quot;&quot;" /><ontrue>6c83f099-e9cf-48e6-9484-2bc9f0a7199f</ontrue><onfalse>9f7b7d69-8d78-4200-bfa5-4b0bef77db2e</onfalse></stage><stage stageid="6c83f099-e9cf-48e6-9484-2bc9f0a7199f" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="0" /><onsuccess>9f7b7d69-8d78-4200-bfa5-4b0bef77db2e</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:senderemail LIKE '&quot;&amp;Replace([Sender Email], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="f78ea02c-5dc1-442c-992a-5e11a8f75caa" name="Sender Name" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3367b7cd-769b-4b04-b1b1-1438747e6b10" name="Sender Email" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f77c94b5-fec0-462a-88ba-318aad4971ac" name="Filter Expression?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="375" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>b26d9b78-e0a2-49ea-8308-54e0a495752d</ontrue><onfalse>fc80d559-0b87-4c06-9e93-c1c791e69d41</onfalse></stage><stage stageid="b26d9b78-e0a2-49ea-8308-54e0a495752d" name="Prepend" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="375" /><onsuccess>fc80d559-0b87-4c06-9e93-c1c791e69d41</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="bdd58cbb-659a-46c1-a012-413e452d741f" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="270" /><onsuccess>3b232534-6884-47c6-9949-3ba68bff2bf5</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="1f9ac356-695b-4af1-8cea-0efeb6d10114" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="135" /><onsuccess>7d70b49a-2a34-40fe-b5d3-c68029b6e065</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="5c8fc165-18be-4d85-8bbf-6c2a1e654f9b" name="Earliest?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="135" /><decision expression="IsDate([Received Earliest])" /><ontrue>1f9ac356-695b-4af1-8cea-0efeb6d10114</ontrue><onfalse>7d70b49a-2a34-40fe-b5d3-c68029b6e065</onfalse></stage><stage stageid="7d70b49a-2a34-40fe-b5d3-c68029b6e065" name="Latest" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="IsDate([Received Latest])" /><ontrue>fa800bfa-1ca7-4f7c-a376-ca1958bf8f58</ontrue><onfalse>0c0e8216-425d-4f9d-ae72-b68df0930621</onfalse></stage><stage stageid="fa800bfa-1ca7-4f7c-a376-ca1958bf8f58" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="180" /><onsuccess>0c0e8216-425d-4f9d-ae72-b68df0930621</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="08bf997e-eab6-4f2a-acb5-6f2527ec62e6" name="Include Unread" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="4a1544be-fba9-421c-bc39-5b0cf6716833" name="Include Read" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="0c0e8216-425d-4f9d-ae72-b68df0930621" name="Unread Only?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="225" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>bdd58cbb-659a-46c1-a012-413e452d741f</ontrue><onfalse>08b630b1-fde1-4c76-86fe-38b34050883b</onfalse></stage><stage stageid="08b630b1-fde1-4c76-86fe-38b34050883b" name="Read Only?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="225" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>0b1d8889-a3e3-436c-9f7a-b148ed8922b2</ontrue><onfalse>d983d3af-d4b0-417c-b208-b59d96436475</onfalse></stage><stage stageid="0b1d8889-a3e3-436c-9f7a-b148ed8922b2" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="270" /><onsuccess>dae7dc5d-9764-4f1c-a6f5-53c0ba42d383</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="d983d3af-d4b0-417c-b208-b59d96436475" name="Anchor1" type="Anchor"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="150" y="225" w="10" h="10" /><onsuccess>47f64df5-9f57-49a6-9894-7c164cbb08bf</onsuccess></stage><stage stageid="47f64df5-9f57-49a6-9894-7c164cbb08bf" name="Anchor1" type="Anchor"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="150" y="330" w="10" h="10" /><onsuccess>dae7dc5d-9764-4f1c-a6f5-53c0ba42d383</onsuccess></stage><stage stageid="dae7dc5d-9764-4f1c-a6f5-53c0ba42d383" name="Anchor1" type="Anchor"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="330" w="10" h="10" /><onsuccess>3b232534-6884-47c6-9949-3ba68bff2bf5</onsuccess></stage><stage stageid="1c22221b-980f-4437-9ea2-6f6fdf4318b7" name="Filter Expression" type="Calculation"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="90" y="90" /><onsuccess>5c8fc165-18be-4d85-8bbf-6c2a1e654f9b</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="31882f9e-de47-42fb-a035-fc89f4a37318" name="Message?" type="Decision"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="15" y="90" /><decision expression="[Message]&lt;&gt;&quot;&quot;" /><ontrue>1c22221b-980f-4437-9ea2-6f6fdf4318b7</ontrue><onfalse>5c8fc165-18be-4d85-8bbf-6c2a1e654f9b</onfalse></stage><stage stageid="7e2ad60d-db2e-4c05-98cd-3b9ef9955126" name="Message" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="240" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c82df14-12f6-4d63-924c-5aa4919dd931" name="Input" type="Block"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="-270" y="-120" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="56caad12-c421-4a92-b6a0-451d9f775574" name="Output" type="Block"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><loginhibit /><display x="-270" y="150" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="5a990b5a-b08d-4618-b143-932ff4015fc7" name="MailBoxName" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="-75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b1f24496-c6c0-458f-acc5-51e918311c65" name="SubFolder" type="Data"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="120" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c365e27b-191d-4159-b1a9-833235c19d9f" name="Items" type="Collection"><subsheetid>eb618e5a-390e-4dc1-a2c1-f026e98af868</subsheetid><display x="-195" y="195" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="CcEmailAddress" type="text" description="The email address of all the Cc Recipients" /><field name="BccEmailAddress" type="text" description="The email address of all the Bcc Recipients" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="7465c370-c47d-4309-a9fa-937f14b660b0" name="Get Received Items (Advanced) - Group Email" type="SubSheetInfo"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><narrative>Read Emails from the outlook group email box- Advanced</narrative><display x="-420" y="-225" w="150" h="90" /></stage><stage stageid="8683f1a6-d420-4797-80f3-a9c3fd77ced8" name="Start" type="Start"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><display x="90" y="-165" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Sub Folder" /><input type="text" name="MailBox Name" narrative="Name of the Mail Box From Where Mails to be read. Eg: &quot;SSSCMLA International Marine Triton SSSCMLA-DIO/5M3&quot;" stage="MailBoxName" /></inputs><onsuccess>0d9c2064-1122-40e9-94c0-d657ea1431d8</onsuccess></stage><stage stageid="2faa6dbc-6b66-4e53-8ea0-79968ea8f874" name="Item Count" type="Data"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><display x="-120" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8942c169-043f-485f-80f6-4927a578e16e" name="Filter Expression" type="Data"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><display x="-120" y="-120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0d9c2064-1122-40e9-94c0-d657ea1431d8" name="Internal_Get Items" type="SubSheet"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><display x="90" y="-75" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" expr="[MailBoxName]" /><input type="text" name="SubFolder" narrative="Name of the SubFolder" expr="[Sub Folder]" /></inputs><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>9f3d757f-2257-45b6-b30a-3f0b0a184414</onsuccess><processid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</processid></stage><stage stageid="64e683a1-c19b-4b6d-b991-7aaf43012696" name="Outlook Folder ID" type="Data"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-120" y="-150" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="d41ba5f1-f813-44ba-afc2-e5d764215904" name="Sub Folder" type="Data"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><display x="-120" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9f3d757f-2257-45b6-b30a-3f0b0a184414" name="End" type="End"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><display x="90" y="30" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="d68f9504-2b8b-4e56-a7c7-c7d848cd115f" name="Items" type="Collection"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><display x="-120" y="120" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="5ce5845d-7386-4750-a47d-ad49fa5b50ef" name="Input" type="Block"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><display x="-195" y="-180" w="150" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="314f4619-a26b-4bff-8876-fa69b61d0d11" name="Output" type="Block"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="be42a5c7-2dd1-4bbf-ae28-e1b4c1042b1c" name="Note3" type="Note"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><loginhibit /><narrative>API functions provided for the advanced filter expressions:

BCC = Returns a String representing the display list of blind carbon copy (BCC) names for a MailItem. Read/write.
Body = Returns or sets a String representing the clear-text body of the Outlook item. Read/write.
CC = Returns a String representing the display list of carbon copy (CC) names for a MailItem . Read/write.
CreationTime = Returns a Date indicating the creation time for the Outlook item. Read-only.
EntryID = Returns a String representing the unique Entry ID of the object. Read-only.
HTMLBody = Returns or sets a String representing the HTML body of the specified item. Read/write.
ReceivedTime = Returns a Date indicating the date and time at which the item was received. Read-only.
SenderEmailAddress = Returns a String that represents the e-mail address of the sender of the Outlook item. Read-only.
SenderName = Returns a String indicating the display name of the sender for the Outlook item. Read-only.
SentOn = Returns a Date indicating the date and time on which the Outlook item was sent. Read-only.
Subject = Returns or sets a String indicating the subject for the Outlook item. Read/write.
To = Returns or sets a semicolon-delimited String list of display names for the To recipients for the Outlook item. Read/write.
UnRead = Returns or sets a Boolean value that is True if the Outlook item has not been opened (read). Read/write.
</narrative><display x="-450" y="-75" w="480" h="210" /></stage><stage stageid="27cbdef1-0480-452d-ad7a-77bff927e761" name="MailBoxName" type="Data"><subsheetid>302185db-940a-4f76-84ac-84901fc9a566</subsheetid><display x="-120" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2595c861-a39a-405e-b695-bf54b771462a" name="Restart Outlook" type="SubSheetInfo"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><narrative>Restart Outlook</narrative><display x="-240" y="-270" w="150" h="90" /></stage><stage stageid="ea774a0c-e103-4086-b754-fb56584adddf" name="Start" type="Start"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-375" /><onsuccess>293c36bd-ae2b-4267-8e09-43e8070f5654</onsuccess></stage><stage stageid="bd02912a-3302-40c8-8499-111f3c41d6ba" name="End" type="End"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="255" /></stage><stage stageid="d6d8e5ea-1603-491a-ad47-b19ced5eb22d" name="Attach Outlook" type="Navigate"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="135" y="-285" /><onsuccess>bfbd9fca-8945-4de6-9a40-13c58571a9b7</onsuccess><step><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>AttachApplication</id><arguments><argument><id>WindowTitlesCollection</id><value></value></argument><argument><id>WindowTitle</id><value>"*Outlook"</value></argument><argument><id>ProcessName</id><value>"OUTLOOK"</value></argument><argument><id>ProcessID</id><value></value></argument><argument><id>Username</id><value></value></argument><argument><id>ChildIndex</id><value></value></argument></arguments></action></step></stage><stage stageid="5c499b6c-aa5b-458e-bd3b-4e9f935bb7dd" name="Value from Status Bar" type="Data"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="-240" y="-165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1b71564f-edb4-468b-8fa6-2517fd5947e7" name="Block1" type="Block"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="75" y="-315" w="195" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="50fcd952-ba15-4324-bbcb-ec3bac0fb30c" name="Recover1" type="Recover"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="225" y="-285" /><onsuccess>5fd9f820-9b4a-4027-84fe-3978c06754c7</onsuccess></stage><stage stageid="5fd9f820-9b4a-4027-84fe-3978c06754c7" name="Resume1" type="Resume"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="225" y="-165" /><onsuccess>880a86f3-52af-4174-bb7a-563be19b4d6b</onsuccess></stage><stage stageid="293c36bd-ae2b-4267-8e09-43e8070f5654" name="Is Outlook Connected" type="Read"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-330" /><onsuccess>892f963e-d547-4f4c-a302-1119e7de42a9</onsuccess><step stage="Value from Outlook"><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>IsConnected</id></action></step></stage><stage stageid="c1204800-3674-413a-bda0-536c950caa5c" name="Value from Outlook" type="Data"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="-240" y="-135" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="892f963e-d547-4f4c-a302-1119e7de42a9" name="Is Connected" type="Decision"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-285" /><decision expression="[Value from Outlook] = True" /><ontrue>ea2eb737-090d-4175-bed2-3035a38a9eb2</ontrue><onfalse>d6d8e5ea-1603-491a-ad47-b19ced5eb22d</onfalse></stage><stage stageid="ea2eb737-090d-4175-bed2-3035a38a9eb2" name="Terminate Outlook" type="Navigate"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-225" /><onsuccess>880a86f3-52af-4174-bb7a-563be19b4d6b</onsuccess><step><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>Terminate</id></action></step></stage><stage stageid="bfbd9fca-8945-4de6-9a40-13c58571a9b7" name="Anchor2" type="Anchor"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="135" y="-225" w="10" h="10" /><onsuccess>ea2eb737-090d-4175-bed2-3035a38a9eb2</onsuccess></stage><stage stageid="880a86f3-52af-4174-bb7a-563be19b4d6b" name="Launch" type="Navigate"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-165" /><onsuccess>d9f1108a-7472-4a54-978f-243a84d7744f</onsuccess><step><element id="d71b73b9-499a-4fa5-b8d1-d6326aca02f3" /><action><id>Launch</id></action></step></stage><stage stageid="78255988-a75e-495a-b896-51ecbc92a769" name="Read Outlook Status" type="Read"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="-30" /><onsuccess>169c06d3-0040-427a-9eec-1a0c164e9d12</onsuccess><step stage="Value from Status Bar"><element id="6624cec0-c810-4d99-bb2d-30edace1616b" /><action><id>UIAGetName</id></action></step></stage><stage stageid="d60311dc-5f87-4129-a71a-62df4d4d2c97" name="Time Out1" type="WaitEnd"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="60" y="-105" w="30" h="30" /><onsuccess>cc5baced-9775-457e-ad14-ec27635931c7</onsuccess><groupid>c1174e1d-615d-4edd-8d83-3b60b8e19236</groupid></stage><stage stageid="d9f1108a-7472-4a54-978f-243a84d7744f" name="Wait1" type="WaitStart"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-30" y="-105" w="30" h="30" /><groupid>c1174e1d-615d-4edd-8d83-3b60b8e19236</groupid><choices><choice reply="True"><name>Status Bar UIMode Check Exists</name><distance>45</distance><ontrue>78255988-a75e-495a-b896-51ecbc92a769</ontrue><element id="6624cec0-c810-4d99-bb2d-30edace1616b" /><condition><id>CheckExists</id></condition><comparetype>Equal</comparetype></choice></choices><timeout>120</timeout></stage><stage stageid="169c06d3-0040-427a-9eec-1a0c164e9d12" name="if Connected to: Microsoft Exchange?" type="Decision"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="30" /><decision expression="InStr([Value from Status Bar], &quot;Connected to: Microsoft Exchange&quot;) &gt; 0" /><ontrue>5fe6a64b-c17d-49a3-953c-39fb006b8a3c</ontrue><onfalse>bdd3c26b-1f2f-417b-83e1-7b006a4f2f0c</onfalse></stage><stage stageid="532e0528-6db8-4605-8523-eb613f82bf00" name="Time Out2" type="WaitEnd"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-135" y="30" w="30" h="30" /><onsuccess>7bd7f660-c2aa-41ad-8d6c-8c99eea7e179</onsuccess><groupid>5c5bab5c-862b-4975-a4d1-bd93f8224914</groupid></stage><stage stageid="bdd3c26b-1f2f-417b-83e1-7b006a4f2f0c" name="Wait2" type="WaitStart"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-90" y="30" w="30" h="30" /><groupid>5c5bab5c-862b-4975-a4d1-bd93f8224914</groupid><choices /><timeout>2</timeout></stage><stage stageid="e71f67ab-ac44-4d33-aaa4-8f98f6fabfe4" name="Timer1" type="Data"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-240" y="-105" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="7bd7f660-c2aa-41ad-8d6c-8c99eea7e179" name="Timer + 2" type="Calculation"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-195" y="30" /><onsuccess>7572b95b-105a-45c2-ae59-e10640007777</onsuccess><calculation expression="[Timer1] + 2" stage="Timer1" /></stage><stage stageid="7572b95b-105a-45c2-ae59-e10640007777" name="if Timer crossed 120 Seconds" type="Decision"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-195" y="-30" /><decision expression="[Timer1] &gt; 120" /><ontrue>8fe0c92f-756a-4792-bb47-ee8211150676</ontrue><onfalse>78255988-a75e-495a-b896-51ecbc92a769</onfalse></stage><stage stageid="8fe0c92f-756a-4792-bb47-ee8211150676" name="Exception1" type="Exception"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="-300" y="-30" /><exception type="Business Exception" detail="&quot;Timer Crossed 120 Seconds time limit to connect to microsoft exchange Server.&quot;" /></stage><stage stageid="a67ba2e8-b2a0-4df2-955f-1625bc6284d8" name="Read folder Sycn Status" type="Read"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="120" /><onsuccess>d02ac764-5574-4333-b20c-029f23d18d79</onsuccess><step stage="Value from Status Bar"><element id="c72de03c-a7bc-4198-b9ac-2121d8f0147e" /><action><id>UIAGetName</id></action></step></stage><stage stageid="d02ac764-5574-4333-b20c-029f23d18d79" name="if This folder is up to date. Message Arrive?" type="Decision"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="InStr([Value from Status Bar], &quot;up to date.&quot;) &gt; 0" /><ontrue>bd02912a-3302-40c8-8499-111f3c41d6ba</ontrue><onfalse>7a55a118-34f7-4d90-bf3a-e53557d0092a</onfalse></stage><stage stageid="3a7b7229-782a-4510-9f39-d395a4d83376" name="Time Out2" type="WaitEnd"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-135" y="180" w="30" h="30" /><onsuccess>b44cf472-89aa-4120-92b5-f2b1051da10c</onsuccess><groupid>475fa142-6d8d-4ac5-b6b8-7bb768e03496</groupid></stage><stage stageid="7a55a118-34f7-4d90-bf3a-e53557d0092a" name="Wait2" type="WaitStart"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-90" y="180" w="30" h="30" /><groupid>475fa142-6d8d-4ac5-b6b8-7bb768e03496</groupid><choices /><timeout>2</timeout></stage><stage stageid="b44cf472-89aa-4120-92b5-f2b1051da10c" name="Timer + 2" type="Calculation"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-195" y="180" /><onsuccess>4a69792b-90e9-466e-891e-93cdd4b2edc5</onsuccess><calculation expression="[Timer1] + 2" stage="Timer1" /></stage><stage stageid="4a69792b-90e9-466e-891e-93cdd4b2edc5" name="if Timer crossed 120 Seconds" type="Decision"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-195" y="120" /><decision expression="[Timer1] &gt; 120" /><ontrue>32f2f222-b007-47ab-95ef-d793d137ebb0</ontrue><onfalse>a67ba2e8-b2a0-4df2-955f-1625bc6284d8</onfalse></stage><stage stageid="32f2f222-b007-47ab-95ef-d793d137ebb0" name="Exception1" type="Exception"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="-300" y="120" /><exception type="Business Exception" detail="&quot;Timer Crossed 120 Seconds time limit to Get All New mails may be connetivity issue please check manually.&quot;" /></stage><stage stageid="5fe6a64b-c17d-49a3-953c-39fb006b8a3c" name="Reset the Timer" type="Calculation"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="15" y="75" /><onsuccess>a67ba2e8-b2a0-4df2-955f-1625bc6284d8</onsuccess><calculation expression="0" stage="Timer1" /></stage><stage stageid="cc5baced-9775-457e-ad14-ec27635931c7" name="Exception1" type="Exception"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="195" y="-105" /><exception type="Business Exception" detail="&quot;Failed in Launching Outlook.&quot;" /></stage><stage stageid="dd8479e4-e6e6-47c3-9790-f7946e6262b9" name="Block2" type="Block"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="-45" y="-75" w="195" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8a7bf391-ac29-4219-bb86-5bec07f561cb" name="Recover2" type="Recover"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><loginhibit /><display x="105" y="180" /><onsuccess>e049f7d4-6c77-43d7-96fb-a741e2949180</onsuccess></stage><stage stageid="e049f7d4-6c77-43d7-96fb-a741e2949180" name="Exception2" type="Exception"><subsheetid>45dd97d8-106b-4399-aaea-b34b2ed7d531</subsheetid><display x="210" y="180" /><exception type="Business Exception" detail="&quot;Error while reading outlook status.&quot;" /></stage><stage stageid="4fc62439-00a5-40f2-b8bd-a9462df1ec20" name="Internal_Get Items - Group Email (with Cc and Bcc)" type="SubSheetInfo"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><narrative>The page contains all the features as Internal_Get Items - Group Email page with additonal fields in Item collection as below:
1. CcEmailAddress - Contains the email address of all the Cc recipients of the mail
2, BccEmailAddress - Contains the email address of all the Bcc recipients of the mail
Both are a semi-colon separated list of addresses
</narrative><display x="-195" y="-120" w="180" h="90" /></stage><stage stageid="73d29153-6afc-42ff-8ca3-1b161b9bdb2b" name="Start" type="Start"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /><input type="text" name="SubFolder" narrative="Name of the SubFolder" stage="SubFolder" /></inputs><onsuccess>970c3263-ad62-43f3-a68c-c92d4c94ecbb</onsuccess></stage><stage stageid="7a345e1f-1e93-4a2b-b2be-dc99ac8d4f3f" name="End" type="End"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="50406719-c41d-4739-84ae-b5e9adaa6a27" name="Item Count" type="Data"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f856e62-18d5-4378-8454-30baa1bf983c" name="Filter Expression" type="Data"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5ab5d266-62ac-4ab8-8863-aa111219e848" name="Note2" type="Note"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="ffe55988-e521-4e23-831d-80fa48cb0bff" name="Input" type="Block"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><display x="-285" y="-60" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="8973c3a1-04b6-4f96-97dd-53793075dede" name="Output" type="Block"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><display x="-285" y="105" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="d4910f09-a5dc-4073-9e37-f8c36ae4558e" name="MailBoxName" type="Data"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6576b4e2-e34f-41b8-8852-afea63cf7e16" name="SubFolder" type="Data"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3af6e930-0e3f-49e3-9ebc-8c8c7863eec0" name="Items" type="Collection"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="CcEmailAddress" type="text" description="The email address of all the Cc Recipients" /><field name="BccEmailAddress" type="text" description="The email address of all the Bcc Recipients" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="970c3263-ad62-43f3-a68c-c92d4c94ecbb" name="Get Items - SubFolder (+Cc and Bcc)" type="Code"><subsheetid>cd24e490-3bf3-4e10-a738-bfefbefc6c81</subsheetid><loginhibit /><display x="15" y="0" w="120" h="60" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /><input type="text" name="SubFolder" expr="[SubFolder]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>7a345e1f-1e93-4a2b-b2be-dc99ac8d4f3f</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")



Dim folder 

folder = _nameSpace.Folders(MailBoxName)'("SIEP Vito IM Mailbox SIEP-PTT/PDDW")
'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")

If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("CcEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("BccEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
	If Not TypeOf item Is MailItem Then Continue For
	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.Body
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("Unread") = item.Unread
	dataTable.Rows.Add(row)

	'Fetch email ID's of CC and Bcc recipients
	Dim olRecipients = item.Recipients
	For Each olRecipient As Object In olRecipients
		'OlMailRecipientType.olCC = 2 / Outlook constant
		If olRecipient.Type = 2 Then
			row("CcEmailAddress") += olRecipient.Address + ";"
		'OlMailRecipientType.olBCC = 3 / Outlook constant
		ElseIf olRecipient.Type = 3 Then
			row("BccEmailAddress") += olRecipient.Address + ";"
		End If
	Next
	
	'MsgBox(“To: ” & strToEmails & “Cc: ” & strCcEmails & “BCc: ” & strBCcEmails)
	Item_Count += 1
Next
Items = dataTable]]></code></stage><stage stageid="0125c15d-98d3-482a-913e-1bf6e283b4f4" name="Internal_Get Items - Group Email" type="SubSheetInfo"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="88fa6f00-be82-4378-a048-8c61a35267db" name="Start" type="Start"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /><input type="text" name="SubFolder" narrative="Name of the SubFolder" stage="SubFolder" /></inputs><onsuccess>6a68d78b-3cd5-41b0-afd9-881ce0ebf6f7</onsuccess></stage><stage stageid="6612b4b3-32f4-4530-bcc8-6dbc708ea9b5" name="End" type="End"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="6a68d78b-3cd5-41b0-afd9-881ce0ebf6f7" name="Get Items - SubFolder" type="Code"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="15" y="15" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /><input type="text" name="SubFolder" expr="[SubFolder]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>6612b4b3-32f4-4530-bcc8-6dbc708ea9b5</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")



Dim folder 

folder = _nameSpace.Folders(MailBoxName)'("SIEP Vito IM Mailbox SIEP-PTT/PDDW")
'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")

If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
	If Not TypeOf item Is MailItem Then Continue For
	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.Body
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("Unread") = item.Unread
	dataTable.Rows.Add(row)
	Item_Count += 1
Next
Items = dataTable]]></code></stage><stage stageid="904e30aa-e2b3-4cee-9c5d-1a859abaed38" name="Item Count" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf5b0c73-70ee-48d0-a7a0-e8d9430ea799" name="Filter Expression" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="99102199-164b-4768-8951-d3bc085e1855" name="Items" type="Collection"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="4c9e1a84-acaa-4afe-aca0-e1118cce8872" name="Note2" type="Note"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="afc9e67c-0c22-490a-a80e-9ee596bc98e2" name="Input" type="Block"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5a58dcc9-6372-48e9-9574-c457cd7e2177" name="Output" type="Block"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="b363158c-6a79-4531-a886-6aeb33d972e7" name="MailBoxName" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9af9d998-ef7f-4ff8-9217-eab72a088550" name="SubFolder" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><display x="-195" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="17408c13-f62c-4672-b87f-948238887b51" name="Retry Limit" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="-195" y="255" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="89701e75-0091-4ae2-8b92-e4d55b9df39a" name="Retry Count" type="Data"><subsheetid>ddbe8394-3fa1-43df-9846-8b00747ed3fd</subsheetid><loginhibit /><display x="-195" y="285" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="6fe18792-8c10-4609-9009-fac8bde8303a" name="Get Received Items(Specified Folder)" type="SubSheetInfo"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bf3ff0cd-60fc-4258-b71c-f43f0edfce6b" name="Start" type="Start"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Source Folder" narrative="Name of the Folder" stage="Root Folder" /><input type="text" name="Filter Expression" stage="Filter Expression" /></inputs><onsuccess>b7534336-8152-49c6-9f2d-015065919b99</onsuccess></stage><stage stageid="8658f687-bb4e-48fc-b0fc-ff13d29f389c" name="End" type="End"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="dfd9cb45-a425-4d9d-827b-be0ec39a08c1" name="Item Count" type="Data"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e7ff4c7c-5b25-4a2a-b4eb-e13d153fe737" name="Items" type="Collection"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="3fec2222-0306-43a0-a8f3-24d2e874802f" name="Note2" type="Note"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="538bb458-62d5-4190-bf57-0ea4e44c38fd" name="Input" type="Block"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="211078c9-b4b5-4736-bdc2-da4c7f344be6" name="Output" type="Block"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="b7534336-8152-49c6-9f2d-015065919b99" name="Get Items from Folder" type="Code"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="FolderName" expr="[Root Folder]" /><input type="text" name="Filter Expression" expr="[Filter Expression]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>8658f687-bb4e-48fc-b0fc-ff13d29f389c</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
On error resume next
Dim Folders
Dim FolderTemp
dim folder 
Folders = _nameSpace.Folders
For Each FolderTemp In Folders
   ' If FolderTemp = MailBoxName Then
	folder = FolderTemp.Folders(FolderName)
			'See https://msdn.microsoft.com/en-us/library/office/aa210946(v=office.11).aspx
		'for mail item properties
		Dim dataTable As New Data.DataTable
		dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
		dataTable.Columns.Add("To", Type.GetType("System.String"))
		dataTable.Columns.Add("CC", Type.GetType("System.String"))
		dataTable.Columns.Add("Subject", Type.GetType("System.String"))
		dataTable.Columns.Add("Body", Type.GetType("System.String"))
		dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
		dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
		dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
		dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

		Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

		For Each item As Object In folderItems
			If Not TypeOf item Is MailItem Then Continue For
			Dim row As Data.DataRow = dataTable.NewRow
			row("EntryID") = item.EntryID
			row("To") = item.To
			row("CC") = item.CC
			row("Subject") = item.Subject
			row("Body") = item.Body
			
			Dim attachments As String = ""
			For Each attachment As Object In item.Attachments
				If attachment.Type = 1 Then
					attachments = attachments & "|" & attachment.DisplayName
				End If
			Next
			
			row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
			row("SentOn") = item.SentOn
			row("ReceivedOn") = item.ReceivedTime
			row("SenderName") = item.SenderName
			row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
			row("Unread") = item.Unread
			dataTable.Rows.Add(row)
			Item_Count += 1
		Next
		Items = dataTable
	'End If
Next





]]></code></stage><stage stageid="7f53c2c7-2080-400f-afed-2356ecc00b5a" name="Root Folder" type="Data"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">OAS&amp;A Report</initialvalue><private /><alwaysinit /></stage><stage stageid="68f9386a-0655-4884-a17e-8ecd869dbf7d" name="Filter Expression" type="Data"><subsheetid>28214b3e-ab07-490a-917f-4a71abe28968</subsheetid><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">[Unread]=True AND [ReceivedTime]&gt;='4/11/2019 12:00 AM'</initialvalue><private /><alwaysinit /></stage><stage stageid="8a21a962-7fad-46f8-837e-2bfd7c6e3429" name="Get Received Items(Specified Folder)" type="SubSheetInfo"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><narrative>This will move the selected email Item to a selected folder location.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d44d72b3-624e-4b07-9afd-9df3d135f994" name="End" type="End"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="New_Entry_ID" stage="New_Entry_ID" /></outputs></stage><stage stageid="446d4cc1-b5b1-4c17-b8d6-a7b1a3f07f1a" name="Move To Folder" type="Code"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="DestinationFolder" expr="[Destination Folder]" /><input type="text" name="Source Folder" expr="[Source Folder]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="New_Entry_ID" stage="New_Entry_ID" /></outputs><onsuccess>d44d72b3-624e-4b07-9afd-9df3d135f994</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim Folders
Dim FolderTemp
Dim SubFolder
Dim SrceFolder


Dim DFolders
Dim DFolderTemp
Dim DSubFolder
'Dim DSrceFolder

'on error resume next
Try
	Folders = _nameSpace.Folders
Dim dataTable As New Data.DataTable
dataTable.Columns.Add("Folder Name", Type.GetType("System.String"))

For Each FolderTemp In Folders
    If FolderTemp.Name = MailBoxName Then
	'
	For Each SubFolder in FolderTemp.Folders
		If SubFolder.Name = Source_Folder Then
			For Each SrceFolder In SubFolder.Items
				If SrceFolder.EntryID = Entry_ID Then
					
					DFolders = _nameSpace.Folders
					For Each DFolderTemp In DFolders
						If DFolderTemp.Name = MailBoxName Then
							For Each DSubFolder in DFolderTemp.Folders
							   If DSubFolder.Name = DestinationFolder Then
									New_Entry_ID = SrceFolder.Move(DSubFolder).EntryID
									Success = True
							   End If
							Next
						End If
					Next
				End If
			Next
			
		End if
	Next
	End if
Next
Catch ex As System.IO.IOException
	Success = False
	Message = ex.Message

	
End Try


]]></code></stage><stage stageid="8c774517-1cb5-45fb-81ed-9e86d036f20b" name="Entry ID" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="365f6e35-2ff5-497f-9e1b-f5c533ea9e14" name="Destination Folder" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6724d4d1-efda-42ac-bbb7-f2d614862f02" name="Input" type="Block"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c85d5691-cc4c-4107-a6cb-d3328872ff29" name="MailBoxName" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="62f23a80-bff5-4782-a542-a84bc6f46935" name="Start" type="Start"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Destination Folder" narrative="Mandatory. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Destination Folder" /><input type="text" name="MailBoxName" narrative="Mail Box Name" stage="MailBoxName" /><input type="text" name="Source Folder" narrative="Source Folder Name" stage="Source Folder" /></inputs><onsuccess>446d4cc1-b5b1-4c17-b8d6-a7b1a3f07f1a</onsuccess></stage><stage stageid="e7ba37b6-e9e9-4f37-8048-c78fa95b2dbd" name="Source Folder" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="24112b99-12da-4e08-af0b-0ae4d926e586" name="Success" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9ab8569a-2e71-40e3-baf6-0981e5c78240" name="Message" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="95e4d17a-39c9-4d90-8842-c55986ca382a" name="New_Entry_ID" type="Data"><subsheetid>a401b3d2-95af-4c48-8307-343f50633c2e</subsheetid><display x="90" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="362d6425-42aa-493a-a9cc-a0472bf04010" name="Get Mail - Using Entry ID" type="SubSheetInfo"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><narrative>Get Mail Content Details from Entry ID</narrative><display x="-330" y="-150" w="150" h="90" /></stage><stage stageid="7a9c3caf-bcfa-4937-91c6-a35b5a23a541" name="Start" type="Start"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Entry ID of the mail" stage="Entry_ID" /></inputs><onsuccess>3b330ad7-f50e-4b48-b7e2-e71fb5f54c3b</onsuccess></stage><stage stageid="4ac85401-ceff-4aa5-9235-dd9e8c04bc10" name="End" type="End"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Mail Items" narrative="Mail Item Collection containg all details" stage="Items" /></outputs></stage><stage stageid="3b330ad7-f50e-4b48-b7e2-e71fb5f54c3b" name="Get Mail Content using Entry ID" type="Code"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><loginhibit /><display x="15" y="-15" w="210" h="30" /><inputs><input type="text" name="Entry_ID" expr="[Entry_ID]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /></outputs><onsuccess>4ac85401-ceff-4aa5-9235-dd9e8c04bc10</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
'Subject = item.Subject
Dim attachments As String = ""
Dim dataTable As New Data.DataTable
		dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
		dataTable.Columns.Add("To", Type.GetType("System.String"))
		dataTable.Columns.Add("CC", Type.GetType("System.String"))
		dataTable.Columns.Add("Subject", Type.GetType("System.String"))
		dataTable.Columns.Add("Body", Type.GetType("System.String"))
		dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
		dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
		dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
		dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))
Dim row As Data.DataRow = dataTable.NewRow
			row("EntryID") = item.EntryID
			row("To") = item.To
			row("CC") = item.CC
			row("Subject") = item.Subject
			row("Body") = item.Body
			
			For Each attachment As Object In item.Attachments
				If attachment.Type = 1 Then
					attachments = attachments & "|" & attachment.DisplayName
				End If
			Next
			
			row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
			row("SentOn") = item.SentOn
			row("ReceivedOn") = item.ReceivedTime
			row("SenderName") = item.SenderName
			row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
			row("Unread") = item.Unread
			dataTable.Rows.Add(row)
Items = dataTable
]]></code></stage><stage stageid="cf3b73e1-2efd-45e9-a611-e798a76a8600" name="Entry_ID" type="Data"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><display x="-330" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c08c444b-8abb-4b50-90e0-4d863d695f50" name="Items" type="Collection"><subsheetid>931248ea-bcc7-4d6c-b603-7c0236dc862a</subsheetid><display x="-330" y="30" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="58cd7302-863e-40b1-85a6-8ae4eee94ed8" name="Save Attachments - From .MSG File" type="SubSheetInfo"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><narrative>Downloads a specfic attachment to a folder. E.g. use cases are "*.txt" or "*.docx" etc.

Input file ie .Msg is mandatory</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="41f50395-5297-4a85-8a59-80c70540b39c" name="End" type="End"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="45dc45ea-4cbe-450d-a273-e138e79b5662" name="Start" type="Start"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="Folder Path" narrative="Mandatory. The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /><input type="text" name="Msg_Path" narrative="Full path of .msg (Saved mail) (Ex:C:/Apps/test.msg)" stage="Msg_Path" /><input type="text" name="File Pattern" narrative="Optional, Default value is *.* but common cases inlcude &quot;.docx&quot; , &quot;.pdf&quot; , &quot;.xlsx&quot; etc." stage="File Pattern" /></inputs><onsuccess>4c93bcdd-6592-4386-91c3-10cecad4e410</onsuccess></stage><stage stageid="27743c13-3261-4256-a489-04c23acf8f0a" name="Folder Path" type="Data"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="efc24b17-75d4-4d82-ba98-2127a016eb35" name="Input" type="Block"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><loginhibit /><display x="-300" y="-45" w="180" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4c93bcdd-6592-4386-91c3-10cecad4e410" name="Save Attachments of MSG file" type="Code"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Folder Path" expr="[Folder Path]" /><input type="text" name="File Pattern" expr="[File Pattern]" /><input type="text" name="Msg_Path" expr="[Msg_Path]" /></inputs><onsuccess>41f50395-5297-4a85-8a59-80c70540b39c</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
Dim item as Microsoft.Office.Interop.Outlook.MailItem

item=app.Session.OpenSharedItem(Msg_Path) 


If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"

For Each attachment As Object In item.Attachments
	If attachment.Type = 1 AndAlso attachment.FileName Like File_Pattern Then
		attachment.SaveAsFile(Folder_Path & attachment.FileName)
	End If
Next
]]></code></stage><stage stageid="4c88e334-36bf-4573-b2d1-1346ed11a8b0" name="File Pattern" type="Data"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3c983e76-f940-47fd-98ae-96d5f38fed9d" name="Msg_Path" type="Data"><subsheetid>97b48f03-1d77-4238-9729-aab47923b9f4</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="406b9c0a-68bd-46f2-b037-ddf5360e1340" name="Create Root Folder" type="SubSheetInfo"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><narrative>This will create a folder base on the given parameter in Outlook Root folder</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8cc25b65-b10f-46df-9f63-9e6fb7ed7a55" name="Start" type="Start"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Mailbox" narrative="Mailbox name of the outlook(Ex. RPA01@shell,com" stage="MailBoxName" /><input type="text" name="Folder Name" narrative="The name of the folder that needs to be created" stage="Folder To Create" /></inputs><onsuccess>b71fe8ec-2ef6-49ee-80bf-a2c1d93baad3</onsuccess></stage><stage stageid="14491b0b-b504-463f-b3d7-05fb7e4c4603" name="End" type="End"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="Message" narrative="Error description" stage="Message" /><output type="flag" name="Success" narrative="True or Flase output" stage="Success" /></outputs></stage><stage stageid="b71fe8ec-2ef6-49ee-80bf-a2c1d93baad3" name="Create Folder" type="Code"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="MailBoxName" expr="[MailBoxName]" /><input type="text" name="Folder To Create" expr="[Folder To Create]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>14491b0b-b504-463f-b3d7-05fb7e4c4603</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim Folders
Dim FolderTemp
Dim SubFolder
Dim IsFound as boolean
dim parentFolder

Dim objFolder  


'Dim DSrceFolder

'on error resume next
IsFound=False
Try
Folders = _nameSpace.Folders


For Each FolderTemp In Folders
    If FolderTemp.Name = MailBoxName Then	'
		For Each SubFolder in FolderTemp.Folders
			If SubFolder.Name=Folder_To_Create then
				IsFound=True
				Exit For
			End If	
		Next
	End if
Next

If IsFound=False Then				
  Success=True
  objFolder = _nameSpace.GetDefaultFolder(6) 
  parentFolder = objFolder.Parent
  parentFolder.Folders.Add(Folder_To_Create)		
Else
		
	Message = "Folder Already Exist"

End If

Catch ex As System.IO.IOException
	Success = False
	Message = ex.Message

	
End Try

]]></code></stage><stage stageid="9271c187-c799-4b8b-af1f-2983957e9dc4" name="Input" type="Block"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><loginhibit /><display x="-255" y="15" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="37a18f59-2518-4953-8e80-988d2371e0a0" name="MailBoxName" type="Data"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><display x="-180" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0d3a698b-73d1-433a-9cc1-74b8b0153b94" name="Folder To Create" type="Data"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><display x="-180" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf3bf9af-ddaa-4629-bb5f-a2cb9875a33a" name="Success" type="Data"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><display x="-180" y="150" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4ebc2705-4a3f-42e7-9d08-685f804e9639" name="Message" type="Data"><subsheetid>78358fb8-7581-457e-bcf7-3b6d4f585b24</subsheetid><display x="-180" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3635bd78-5b65-4a49-8164-0c3b02b01162" name="Save Attachment -  including .MSG Mail Attachments" type="SubSheetInfo"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><narrative>Downloads all attachments to a folder. 

The Entry ID is the unique idenfier used to determine which email is to be actioned.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="fb704c32-696c-46e9-af95-b59c5627f892" name="End" type="End"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="bdeab7a9-4aa1-483a-ac71-e02cf3e81e35" name="Start" type="Start"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Folder Path" narrative="Mandatory. The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /><input type="text" name="File Pattern" narrative="Optional, Default value is *.* but common cases inlcude &quot;.docx&quot; , &quot;.pdf&quot; , &quot;.xlsx&quot; etc." stage="File Patterns" /></inputs><onsuccess>ae791b88-6f58-4b54-96d6-57a90e40eb4c</onsuccess></stage><stage stageid="ae791b88-6f58-4b54-96d6-57a90e40eb4c" name="Save Attachment including .msg file" type="Code"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Folder Path" expr="[Folder Path]" /><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="File Pattern" expr="[File Patterns]" /></inputs><onsuccess>fb704c32-696c-46e9-af95-b59c5627f892</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"

For Each attachment As Object In item.Attachments
	If (attachment.Type = 1 OR attachment.Type = 5 )AndAlso attachment.FileName Like File_Pattern Then
		attachment.SaveAsFile(Folder_Path & attachment.FileName)
	End If
Next
]]></code></stage><stage stageid="cd7ea67f-8b8d-4276-a337-dee9a4c2b0b2" name="Folder Path" type="Data"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d3ebf48a-5213-49fa-968c-6f1efb5b5387" name="Entry ID" type="Data"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c844ec1-8e80-4037-9e24-bfdcc242d161" name="File Patterns" type="Data"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9a3e4a8-5832-48f9-b978-9b1a8165d1b0" name="Input" type="Block"><subsheetid>17e4eaf4-6370-49c5-886f-1f32f4c8739d</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="180210f6-1561-4700-b491-adb6d84b4693" name="Internal_Get_Items - Including .MSG_Mail_Attachments" type="SubSheetInfo"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><narrative>Internal_Get Items_Including_Mail_Attachment ie .msg attachments in email will be read from inbox</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8b99f447-fbc1-4497-acf1-9cf1102ffa52" name="Start" type="Start"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="MailBoxName" narrative="Name of the functional Mail Box From Where Mails to read" stage="MailBoxName" /><input type="text" name="SubFolder" narrative="Name of the Sub Folder" stage="SubFolder" /></inputs><onsuccess>0aab561b-89bd-4841-aa34-ef107737619d</onsuccess></stage><stage stageid="f223b841-4524-4dc4-ba7e-7c78e7de497b" name="End" type="End"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="7c964d84-688a-4b40-b779-de5035640cbc" name="Item Count" type="Data"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d9915512-923b-488f-9d3d-e8cfebb6731a" name="Filter Expression" type="Data"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a51b4708-0255-4f63-a8da-4460cab7c0f6" name="Items" type="Collection"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="9c17dce3-3cd3-45d6-b6d5-f1c1f3e2ae36" name="Input" type="Block"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7c4dfb26-4a69-42e8-b47f-80e2d59c0a25" name="Output" type="Block"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="09c733d2-7c18-4741-9452-36249149dd83" name="MailBoxName" type="Data"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0aab561b-89bd-4841-aa34-ef107737619d" name="Get Items - SubFolder1 including mail attachment" type="Code"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /><input type="text" name="SubFolder" expr="[SubFolder]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>f223b841-4524-4dc4-ba7e-7c78e7de497b</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")



Dim folder 

folder = _nameSpace.Folders(MailBoxName)'("SIEP Vito IM Mailbox SIEP-PTT/PDDW")
'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")

If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
	If Not TypeOf item Is MailItem Then Continue For
	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.Body
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 OR attachment.Type=5 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("Unread") = item.Unread
	dataTable.Rows.Add(row)
	Item_Count += 1
Next
Items = dataTable]]></code></stage><stage stageid="916091e8-d404-4fcf-9f0d-b2653552a63b" name="SubFolder" type="Data"><subsheetid>2038f5b1-ce68-43e7-a9c6-dafc3f7245b6</subsheetid><display x="-195" y="30" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Inbox</initialvalue><private /><alwaysinit /></stage><stage stageid="d7ea05c0-f8b7-4cd0-b015-fb8d16e8a5a1" name="Get Alias ID" type="SubSheetInfo"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><narrative>Fetch the Alias ID of the given Email ID</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="62a04bc0-5ca3-4522-9118-3f0df8414792" name="Start" type="Start"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="15" y="-75" /><inputs><input type="text" name="Email ID" narrative="Email ID of the person to fetch Alias ID" stage="EmailID" /></inputs><onsuccess>0e6e4312-cdb0-4699-961e-6d9b59e09328</onsuccess></stage><stage stageid="cc5fede0-35a8-4764-8266-69aea9a4c2a5" name="End" type="End"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="15" y="120" /><outputs><output type="text" name="Alias ID" narrative="Aliad ID for given Email ID" stage="AliasID" /><output type="flag" name="Sucess?" narrative="Found or not found" stage="Success" /><output type="text" name="Error Message" narrative="Description in any error" stage="ErrorMsg" /></outputs></stage><stage stageid="b432c105-bf66-4055-80a2-69c191dcf71a" name="EmailID" type="Data"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0e6e4312-cdb0-4699-961e-6d9b59e09328" name="Get Alias ID" type="Code"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="15" y="15" w="90" h="30" /><font family="Segoe UI" size="11" style="Regular" color="000000" /><inputs><input type="text" name="EmailID" expr="[EmailID]" /></inputs><outputs><output type="text" name="AliasID" stage="AliasID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="ErrorMsg" stage="ErrorMsg" /></outputs><onsuccess>cc5fede0-35a8-4764-8266-69aea9a4c2a5</onsuccess><code><![CDATA[Dim ToAddr = EmailID

Try
	Dim ol = CreateObject("Outlook.Application")
	Dim mail = ol.CreateItem(0)
	Dim recipient = mail.Recipients.Add(ToAddr)

	Dim oAE = recipient.AddressEntry
	Dim ExchangeUser =  oAE.GetExchangeUser
	
	If (ExchangeUser is Nothing)
		Success = False
		AliasID = "Null"
	Else
		AliasID =  oAE.GetExchangeUser.ALIAS
		Success = True
		ErrorMSg = Nothing
	End If

	recipient.delete
	oAE = Nothing
	recipient = Nothing
	ol = Nothing

Catch ex as System.IO.IOException
	Success = False
	ErrorMsg = ex.Message
End Try]]></code></stage><stage stageid="dc5a37be-8521-4d55-a48d-dfaba5af4d6b" name="AliasID" type="Data"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0eed025-c177-43a0-a0ce-2784596c77c8" name="ErrorMsg" type="Data"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><display x="-195" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c4878079-fd8a-4075-97a8-c5b94b864f00" name="Success" type="Data"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><display x="-195" y="105" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="64e94a88-b649-4786-91c4-c228985fe405" name="Input" type="Block"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="77e71a92-5263-45fb-8160-69b0d3da01b6" name="Output" type="Block"><subsheetid>2c125163-3c1f-4d99-9066-b75b10e5eca5</subsheetid><loginhibit /><display x="-270" y="30" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="b1e14d13-6e5b-4192-ab6f-069d1b9d459e" name="Get Mail - Read Details from .MSG File" type="SubSheetInfo"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><narrative>Getting all details of mail from saved mail ie .msg file

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="b3a4b980-5e6e-4780-b075-c9cea25647c6" name="Start" type="Start"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Msg_Path" narrative="Full Path of.msg file (saved mail) (Ex:C:/Apps/test.msg)" stage="Msg_Path" /></inputs><onsuccess>a8c5484b-eebb-4db3-aaf0-7140f5134bee</onsuccess></stage><stage stageid="148cc3f0-5c62-455d-97ca-578202df5922" name="End" type="End"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="a8c5484b-eebb-4db3-aaf0-7140f5134bee" name="Get Items Category from msg" type="Code"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="msg_Path" expr="[Msg_Path]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>148cc3f0-5c62-455d-97ca-578202df5922</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
Dim item as Microsoft.Office.Interop.Outlook.MailItem

item=app.Session.OpenSharedItem(msg_Path) 


Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))
dataTable.Columns.Add("Categories", Type.GetType("System.String"))

	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.Body
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("Unread") = item.Unread
	row("Categories") = item.Categories
	dataTable.Rows.Add(row)
	Item_Count += 1

Items = dataTable]]></code></stage><stage stageid="f5efa2b7-a07f-40ef-8033-aabbdc9c5176" name="Item Count" type="Data"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><display x="-195" y="180" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4eb09ca9-2d3f-4475-a397-bfc4195242e2" name="Items" type="Collection"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><display x="-195" y="135" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /><field name="Categories" type="text" description="Categories assigned to email" /></collectioninfo></stage><stage stageid="8f4f28c5-c3c1-4c90-ba12-0b83315acf01" name="Input" type="Block"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="684b5c56-d635-42a5-9d8a-1fcb22d973a7" name="Output" type="Block"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><loginhibit /><display x="-270" y="90" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="2f7e9f00-ae5f-4af3-a0f0-d72d3f5bf6fe" name="Msg_Path" type="Data"><subsheetid>26ccbd2a-404a-45af-8dd1-b64222935b61</subsheetid><display x="-195" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0a4c5b95-c25d-4da2-b5a5-1b28efd2d5eb" name="Move Email between Groups - with Signature" type="SubSheetInfo"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-225" y="-180" w="150" h="90" /></stage><stage stageid="c1121f7d-86a6-4307-a587-2c1786ac06e5" name="Start" type="Start"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="in_ToMailBoxName" stage="ToMailBoxName" /><input type="text" name="in_ToSubFolder" stage="ToSubFolder" /><input type="text" name="in_FromMailBoxName" stage="FromMailBoxName" /><input type="text" name="in_FromSubFolder" stage="FromSubFolder" /><input type="text" name="in_Subject" stage="Subject" /></inputs><onsuccess>4854b18f-a25c-4cd3-bd0b-16b14faa4ec2</onsuccess></stage><stage stageid="049c8852-8da8-40c9-9554-f62de85fc939" name="End" type="End"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="Item_Count" stage="Item Count" /></outputs></stage><stage stageid="50a1ed78-0c0b-458f-b50e-a8a77d3afd7e" name="Move Email - Sign" type="Code"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="FromMailBoxName" expr="[FromMailBoxName]" /><input type="text" name="FromSubFolder" expr="[FromSubFolder]" /><input type="text" name="ToMailBoxName" expr="[ToMailBoxName]" /><input type="text" name="ToSubFolder" expr="[ToSubFolder]" /></inputs><outputs><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>049c8852-8da8-40c9-9554-f62de85fc939</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")



Dim folder,folder1 ,SubFolder,SubFolder1

folder = _nameSpace.Folders(FromMailBoxName)'("SIEP Vito IM Mailbox SIEP-PTT/PDDW")
'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")
SubFolder = FromSubFolder
If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

folder1 = _nameSpace.Folders(ToMailBoxName)
SubFolder1 = ToSubFolder
If SubFolder1 <> "" Then
	For each name as string in SubFolder1.Split("\")
	folder1 = folder1.Folders(name)
	Next
End If

Dim newItem

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
Try
    item.HTMLBody = item.HTMLBody & "<br><br><b>Thanks<br> Automation Bot</b>"
    newItem = item
    newItem.Move(folder1)
'folderItems = folder.Items
	Item_Count += 1
   
Catch ex As TimeoutException
  '  mLastException = ex
   ' Throw

End Try
Next
]]></code></stage><stage stageid="682f0347-cf4d-439f-abac-4bac2909997a" name="Item Count" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-225" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23f122a7-662b-48a5-b12d-36e1bf5e3f14" name="Filter Expression" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-225" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="129d5363-2454-41e2-8f41-c6c8b32feb99" name="FromMailBoxName" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-225" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6d458f2c-783d-4632-ad25-73f2858cba4e" name="FromSubFolder" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-225" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b5375c3-6c1e-41fe-9105-b2022a97dc26" name="ToMailBoxName" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-180" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="30f5d761-ba00-4df9-a96d-2abc785a3f58" name="ToSubFolder" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-240" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e885a1f1-3339-4f77-9581-d012c0a3646a" name="Inputs" type="Block"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><loginhibit /><display x="-360" y="-120" w="270" h="360" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="647351ee-b3bf-4bff-867e-082356882305" name="Subject" type="Data"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><display x="-120" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4854b18f-a25c-4cd3-bd0b-16b14faa4ec2" name="Subject Expression" type="Calculation"><subsheetid>82b998ca-7123-47c2-94c1-25aef60963f8</subsheetid><loginhibit /><display x="15" y="-60" /><onsuccess>50a1ed78-0c0b-458f-b50e-a8a77d3afd7e</onsuccess><calculation expression="&quot;@SQL=urn:schemas:httpmail:subject LIKE '&quot; &amp;[Subject] &amp;&quot;%'&quot;" stage="Filter Expression" /></stage><stage stageid="bddd783a-db52-4b57-b6e9-301487870818" name="Send Email - Group Mail box via Functional Account" type="SubSheetInfo"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><narrative>Send email using shared mail box by passing functional account name</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1b897e15-ce1c-47ac-8c36-66b5f19d228c" name="End" type="End"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="a5cbf377-f0ec-4c9f-9091-c1498cdec155" name="Send email via FMB using mail box name" type="Code"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="15" y="-30" w="210" h="30" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="flag" name="Message Is HTML" expr="[Message Is HTML]" /><input type="text" name="SendFrom" expr="[SendFrom]" /></inputs><onsuccess>1b897e15-ce1c-47ac-8c36-66b5f19d228c</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim mail = app.CreateItem(0)
Dim addressCount As Integer

If [SendFrom] <> "" Then
	mail.SentOnBehalfOfName = SendFrom
End If

If [To] <> "" Then
	Dim toAddresses = Split([To], ";")
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = mail.Recipients.Add(toAddresses(addressCount)) 
	recipient.Resolve  
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTo
	Next 
	
End if

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = mail.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = mail.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

mail.Subject = Subject
mail.HTMLBody = Message

For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	mail.Attachments.Add(att)
Next

mail.Save
mail.Send

]]></code></stage><stage stageid="06d9bfc8-b46f-4fbd-a654-5c5b184ed598" name="Subject" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="97bc4b18-a7f4-4106-9906-a1301d3bdd8a" name="To" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c82b025f-707e-4965-8a0a-a875cdc314ed" name="Message" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="13eb7ae9-19d8-48b7-a00b-c162f4f72192" name="Attachments" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be712328-b8aa-4930-8dc1-1f7e78c5883d" name="CC" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1163d29-1e8c-442f-b878-3bb84668f5e8" name="BCC" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4645c3df-4c15-4d71-b56c-fcd03fa8d376" name="Message Is HTML" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="8d80898d-dfa6-4221-b28a-2708063920d9" name="Input" type="Block"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="a5588573-f8df-4c43-80d7-eba8b26dfe2a" name="SendFrom" type="Data"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-195" y="210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c92ea881-7cf4-44bd-b505-1954a76db434" name="Start" type="Start"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" stage="To" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." stage="Subject" /><input type="text" name="Message" narrative="Optional, HTML or plain text" stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="text" name="Send From" narrative="Functional Mail Box Name" stage="SendFrom" /></inputs><onsuccess>a5cbf377-f0ec-4c9f-9091-c1498cdec155</onsuccess></stage><stage stageid="75d775ee-9819-43b7-9676-91ec5f0846b3" name="Block3" type="Block"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="-105" y="-60" w="315" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7f2f62b1-8295-4009-a94b-bfdca0b41d0a" name="Recover" type="Recover"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><loginhibit /><display x="165" y="-30" /><onsuccess>870efcf9-a08b-4356-b428-6834b070f9cc</onsuccess></stage><stage stageid="870efcf9-a08b-4356-b428-6834b070f9cc" name="Throw" type="Exception"><subsheetid>1b5661f3-791c-4317-8553-71c862202048</subsheetid><display x="270" y="-30" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="99f3ee57-8c01-4293-a90e-0dcc4abb2f84" name="Send Email - GroupMailBox - SendUsingAccount" type="SubSheetInfo"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><narrative>Send Email using an account
This account will be a Functional Mail Box and the Sender must have Send As Permissions to send email 
(Example: Sender/Default Account is abc@shell.com;
 xyz@shell.com is the functional mailbox;
 the receiver must receive an email from xyz@shell.com). This page will achieve this</narrative><display x="-240" y="-195" w="270" h="90" /></stage><stage stageid="b1629795-4f10-4c37-b5fd-68a357cdfc88" name="End" type="End"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="155f48a0-0188-4106-b7bc-661d00be2469" name="Send Email from MailBox" type="Code"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="15" y="-60" w="90" h="60" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="flag" name="Message Is HTML" expr="[Message Is HTML]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><onsuccess>b1629795-4f10-4c37-b5fd-68a357cdfc88</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim mail = app.CreateItem(0)
'Dim olAcct As Outlook.Account
Dim addressCount As Integer

If [To] <> "" Then
	Dim toAddresses = Split([To], ";")
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = mail.Recipients.Add(toAddresses(addressCount)) 
	recipient.Resolve  
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTo
	Next 
	
End if

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = mail.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = mail.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

mail.Subject = Subject
mail.HTMLBody = Message

For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	mail.Attachments.Add(att)
Next

With mail
	.Save
	.SendUsingAccount = app.Session.Accounts.Item(MailBoxName)
	'.SentOnBehalfOfName = """SSSCMLA International Marine Triton SSSCMLA-DIO/5M3""SSSCMLA-International-Marine-Triton@shell.com"
	.Send
End with

'mail.Save
'mail.Send
'mail.SentOnBehalfOfName 

]]></code></stage><stage stageid="c8cde838-9b61-4a1e-8802-ac6ee512b292" name="Subject" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="-240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c460d232-0494-484b-a133-188aab931504" name="To" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="-240" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c856a3a9-28bf-4480-8b4d-504467f9e5cb" name="Message" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="-240" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a4ded55-1c9b-44ec-91d6-13788c344d44" name="Attachments" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><display x="-240" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1af9009f-cc62-4762-b448-c3f412abce61" name="CC" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><display x="-240" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1c7a6037-d020-4e37-945f-4a547e281b8a" name="BCC" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><display x="-240" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ce7a33d1-2631-4768-9e49-8e8dc577675e" name="Message Is HTML" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><display x="-240" y="90" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="4df52a1e-a544-468b-b269-da97e6e4add8" name="Input" type="Block"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="-315" y="-120" w="150" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d927ba13-a81d-4ccf-b6d2-310cf945329d" name="MailBoxName" type="Data"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><display x="-240" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcd4fb49-a031-4a52-b01d-06318bf08f89" name="Start" type="Start"><subsheetid>78364df3-9d03-4c20-b012-c4e8a03261fc</subsheetid><loginhibit /><display x="15" y="-195" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" stage="To" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." stage="Subject" /><input type="text" name="Message" narrative="Optional, HTML or plain text" stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="flag" name="Is HTML" narrative="If True, message will be in HTML." stage="Message Is HTML" /><input type="text" name="MailBoxName" narrative="Mailbox name/Account  to send the mail from" stage="MailBoxName" /></inputs><onsuccess>155f48a0-0188-4106-b7bc-661d00be2469</onsuccess></stage><stage stageid="e8232a09-a3f0-4849-bf28-7d698d3bb3e9" name="Move Email between Groups" type="SubSheetInfo"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-225" y="-180" w="150" h="90" /></stage><stage stageid="ccf7f9b8-aa2e-452a-b973-76d4ed34bcbe" name="Start" type="Start"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="in_ToMailBoxName" stage="ToMailBoxName" /><input type="text" name="in_ToSubFolder" stage="ToSubFolder" /><input type="text" name="in_FromMailBoxName" stage="FromMailBoxName" /><input type="text" name="in_FromSubFolder" stage="FromSubFolder" /><input type="text" name="in_Subject" stage="Subject" /></inputs><onsuccess>7c0fa86e-1bd0-48b1-8a7c-4586d9be3ba9</onsuccess></stage><stage stageid="d84b6d28-05e3-426b-8e71-1b9d5d8ee3f1" name="End" type="End"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="Item_Count" stage="Item Count" /></outputs></stage><stage stageid="245f7bed-205c-44b2-80b1-131f2e0bb729" name="Move Email" type="Code"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="FromMailBoxName" expr="[FromMailBoxName]" /><input type="text" name="FromSubFolder" expr="[FromSubFolder]" /><input type="text" name="ToMailBoxName" expr="[ToMailBoxName]" /><input type="text" name="ToSubFolder" expr="[ToSubFolder]" /></inputs><outputs><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>d84b6d28-05e3-426b-8e71-1b9d5d8ee3f1</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")



Dim folder,folder1 ,SubFolder,SubFolder1

folder = _nameSpace.Folders(FromMailBoxName)'("SIEP Vito IM Mailbox SIEP-PTT/PDDW")
'.Folders("Inbox").Folders("BOT")
'folder = folder.Folders("BOT Draft")
SubFolder = FromSubFolder
If SubFolder <> "" Then
	For each name as string in SubFolder.Split("\")
	folder = folder.Folders(name)
	Next
End If

folder1 = _nameSpace.Folders(ToMailBoxName)
SubFolder1 = ToSubFolder
If SubFolder1 <> "" Then
	For each name as string in SubFolder1.Split("\")
	folder1 = folder1.Folders(name)
	Next
End If

Dim newItem

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
Try
    newItem = item
    newItem.Move(folder1)
'folderItems = folder.Items
	Item_Count += 1
   
Catch ex As TimeoutException
  '  mLastException = ex
   ' Throw

End Try
Next
]]></code></stage><stage stageid="5604d992-7d70-468e-a09d-1bc8dd585e53" name="Item Count" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-225" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be14c679-2536-4d82-b966-b31acd1a805b" name="Filter Expression" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-225" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="17d89a47-4e45-4f70-9610-2fc8496753a1" name="FromMailBoxName" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-225" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5545f043-e408-4e09-88fc-5f99f0b6182c" name="FromSubFolder" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-225" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Drafts</initialvalue><private /><alwaysinit /></stage><stage stageid="8d9c6b85-8afe-402b-a0db-7cdf82455cb4" name="ToMailBoxName" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-180" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a551c1d4-f7c1-4cd8-bd33-38cfb190658e" name="ToSubFolder" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-240" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e064652-981e-42b5-8e86-1adcd9025ece" name="Inputs" type="Block"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><loginhibit /><display x="-360" y="-120" w="270" h="360" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="9c4ec02a-7029-4610-a3a1-afdeb98f63ff" name="Subject" type="Data"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><display x="-120" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7c0fa86e-1bd0-48b1-8a7c-4586d9be3ba9" name="Subject Expression" type="Calculation"><subsheetid>8ef566e5-c9d8-4bc9-a461-582745c70fb1</subsheetid><loginhibit /><display x="15" y="-60" /><onsuccess>245f7bed-205c-44b2-80b1-131f2e0bb729</onsuccess><calculation expression="&quot;@SQL=urn:schemas:httpmail:subject LIKE '&quot; &amp;[Subject] &amp;&quot;%'&quot;" stage="Filter Expression" /></stage><stage stageid="2d25035a-9c31-47bf-99ff-b82f282954a0" name="Reply All to Email - Extended" type="SubSheetInfo"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><narrative>Reply to all Emails recipients of a specific email.

The &lt;Reply All to Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-195" y="-60" w="150" h="120" /></stage><stage stageid="6834b8ac-f100-4e09-b8b6-920ef1c5e546" name="End" type="End"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="ab444ae7-8163-43b8-b0b5-0b1c79a06d2e" name="Start" type="Start"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Message" narrative="Mandatory, Any alphanumeric value allowed. HTML or plain text." stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /></inputs><onsuccess>1684488d-641f-47f7-b53d-4263572105f2</onsuccess></stage><stage stageid="1684488d-641f-47f7-b53d-4263572105f2" name="Reply All_Extended" type="Code"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /></inputs><onsuccess>6834b8ac-f100-4e09-b8b6-920ef1c5e546</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim reply = item.ReplyAll

Dim addressCount As Integer
If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = reply.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = reply.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

if Not item.Subject.Contains("RE:") Then	
	reply.Subject = "RE: " & item.Subject
Else
	reply.Subject = item.Subject
End If
	
'reply.HTMLBody = Message & vbCrLf & item.HTMLBody  //Old code which doesn't include the Email Header Addresssuch as From,To,CC,Subject etc.
reply.HTMLBody = Message & "<hr>" & "<b>From:</b> " & item.SenderName & "<" & item.SenderEmailAddress & "> <br>"& "<b>Sent:</b> " & item.ReceivedTime & vbCrLf & "<br><b>To:</b> " & item.To & vbCrLf & "<br><b>Cc:</b> " & item.CC & vbCrLf & "<br><b>Subject:</b> " & item.Subject & "<br><br><br>" & item.HTMLBody


For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	reply.Attachments.Add(att)
Next


reply.Send]]></code></stage><stage stageid="6fff21bc-9e89-40c9-8aac-084ff97c98f1" name="Entry ID" type="Data"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cbb5f398-e44f-490c-b0d9-2051b7ebf7e7" name="Message" type="Data"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="257eea74-9983-4497-8404-f6de37480eb1" name="Input" type="Block"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><loginhibit /><display x="-270" y="15" w="165" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="0502f7a7-45dc-4471-9bdf-632a1d67e25e" name="Attachments" type="Data"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><display x="-195" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6cbd65a0-a7ad-4067-a66a-18ded8ea1f4a" name="CC" type="Data"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d0e761bb-a8c9-4f9c-92fe-7cb31c4f3451" name="BCC" type="Data"><subsheetid>e9f830b1-57da-4755-8fef-de9c09287076</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a8507c1a-2c72-4274-9de9-1441bcdc9dce" name="Reply All to Email" type="SubSheetInfo"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><narrative>Reply to all Emails recipients of a specific email.

The &lt;Reply All to Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-195" y="-60" w="150" h="120" /></stage><stage stageid="99551fde-68ab-4265-8b98-376d4904fc35" name="End" type="End"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="b9d11003-1331-4ea5-b909-f6cebe194dca" name="Start" type="Start"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Message" narrative="Mandatory, Any alphanumeric value allowed. HTML or plain text." stage="Message" /></inputs><onsuccess>33342b1a-1d95-4e07-9c16-b0b494cf4823</onsuccess></stage><stage stageid="33342b1a-1d95-4e07-9c16-b0b494cf4823" name="Reply All" type="Code"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="Message" expr="[Message]" /></inputs><onsuccess>99551fde-68ab-4265-8b98-376d4904fc35</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim reply = item.ReplyAll

reply.Subject = item.Subject
reply.HTMLBody = Message & vbCrLf & item.HTMLBody
reply.Send]]></code></stage><stage stageid="63fd5e49-d4c0-4f4e-9a5e-b53fdfc3385e" name="Entry ID" type="Data"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="94fdf081-5fb1-4da1-beb2-e171ea7e9895" name="Message" type="Data"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e46ab86-0882-4c0f-9ca5-c2c93c165003" name="Input" type="Block"><subsheetid>020d9635-ae7f-4d16-8ec8-2b5731e3c266</subsheetid><loginhibit /><display x="-270" y="15" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="229422e8-c64e-4e77-96c2-8418438f17d7" name="Move Email to Inbox Sub Folder -OBSOLETE" type="SubSheetInfo"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><narrative>Moves an email to a subfolder within the inbox folder.

The Entry ID is the unique idenfier used to determine which email is to be moved.

Example
Inbox to Inbox\SubFolder </narrative><display x="-180" y="-60" w="150" h="120" /></stage><stage stageid="34f0e019-c3d1-4ad9-b69b-2fb1dbefe25d" name="Start" type="Start"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Destination Folder" narrative="Mandatory. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Destination Folder" /><input type="text" name="MailBoxName" narrative="Mail Box Name" stage="MailBoxName" /></inputs><onsuccess>81d9782d-2ad9-42e6-b9f0-579696fffcfc</onsuccess></stage><stage stageid="e06e8d23-ad84-4ffc-9009-4a000ba7a149" name="End" type="End"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="New Entry ID" narrative="Returns the new Entry ID from the Moved Email Object" stage="New Entry ID" /></outputs></stage><stage stageid="81d9782d-2ad9-42e6-b9f0-579696fffcfc" name="Move_OLD" type="Code"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="DestinationFolder" expr="[Destination Folder]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="text" name="New Entry ID" stage="New Entry ID" /></outputs><onsuccess>e06e8d23-ad84-4ffc-9009-4a000ba7a149</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
Dim Folders
Dim FolderTemp
dim folder 
dim Dest
dest = ""
'on error resume next
Folders = _nameSpace.Folders
For Each FolderTemp In Folders
    If FolderTemp.Name = MailBoxName Then
	folder = FolderTemp.Folders("Inbox")
	Dim item = _nameSpace.GetItemFromID(Entry_ID)

	If DestinationFolder <> "" Then
		'For each name as string in Destination_Folder.Split("\")
		Dest = folder.Folders(DestinationFolder)
		'Next
	End If

	New_Entry_ID = item.Move(Dest).EntryID
	End If
Next


]]></code></stage><stage stageid="0f5eb745-44d4-45dd-8b90-fbbc29e51a46" name="Entry ID" type="Data"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-180" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="caf2e2c9-fd66-45ac-a3af-842cc48b5647" name="Outlook Folder ID" type="Data"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><narrative>MS Outlook - OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-180" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e79c4be5-a006-4d85-a83e-ce3647380c3c" name="Destination Folder" type="Data"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><display x="-180" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5e45a68a-3ae1-4569-b5d9-090216451758" name="Input" type="Block"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><loginhibit /><display x="-255" y="15" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="25052d91-8fb6-4ba0-bb4b-20563b9bdff4" name="Default" type="Block"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><loginhibit /><display x="-255" y="135" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="b19687ae-c410-44d2-919e-8ca7c01a549e" name="New Entry ID" type="Data"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><display x="-180" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="374158dd-be69-4c77-bdc5-0d4e245ab9bd" name="MailBoxName" type="Data"><subsheetid>01a17604-efe0-451d-8cfb-29dcbd0a342b</subsheetid><display x="-180" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e891141-b02f-4f4a-9477-ea6aec50c298" name="Save Attachments - OBSOLETE" type="SubSheetInfo"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><narrative>Downloads all attachments to a folder. 

The Entry ID is the unique idenfier used to determine which email is to be actioned.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f2277576-4cfc-4c61-9ad2-a19cda875098" name="End" type="End"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="04d9aec8-4f9c-462f-8ac6-2f8d4684ab9b" name="Start" type="Start"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Folder Path" narrative="Mandatory. The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /></inputs><onsuccess>7e991c65-2b81-4b84-9dad-698dddf4a212</onsuccess></stage><stage stageid="7e991c65-2b81-4b84-9dad-698dddf4a212" name="Save Attachments_OLD" type="Code"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Folder Path" expr="[Folder Path]" /><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="File Pattern" expr="[File Pattern]" /></inputs><onsuccess>f2277576-4cfc-4c61-9ad2-a19cda875098</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"

For Each attachment As Object In item.Attachments
	If attachment.Type = 1 AndAlso attachment.FileName Like File_Pattern Then
		attachment.SaveAsFile(Folder_Path & attachment.FileName)
	End If
Next
]]></code></stage><stage stageid="6a61bacc-a061-46a0-b40a-f91ff5a369cc" name="Folder Path" type="Data"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c86ef37-9acb-4e5f-9dde-2e150f290f85" name="Entry ID" type="Data"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c3ab27a-0305-4afd-99ac-0a9db6f0ffd6" name="File Pattern" type="Data"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">*.*</initialvalue><private /><alwaysinit /></stage><stage stageid="ae0da0be-d40a-4003-a20a-1de544549267" name="Input" type="Block"><subsheetid>ae7410e9-759b-4561-aaba-4badd46a7408</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="69ca26c4-4e60-4702-a66c-7bed7ec59a10" name="Get Received Items (Basic) - OBSOLETE" type="SubSheetInfo"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><narrative>Lists Inbox items matching the parameters provided</narrative><display x="-390" y="-75" w="150" h="90" /></stage><stage stageid="76c1a264-4fb9-44ba-9682-99bf63e290ee" name="Item Count" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="240" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="52cbe6ae-99c8-4586-966b-5296aefb3d4d" name="Internal_Get Items" type="SubSheet"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="420" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="MailBoxName" friendlyname="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" expr="[MailBoxName]" /></inputs><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>f3ddcd87-3f96-411d-a179-0d0495b5931a</onsuccess><processid>ae91b57c-f70f-4552-9614-4bdd2e58503a</processid></stage><stage stageid="6c308020-d3f1-491e-bd25-bb03b90a0dda" name="Outlook Folder ID" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="03faa462-1489-43f1-8213-ccfe1a6c9161" name="Sub Folder" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f3ddcd87-3f96-411d-a179-0d0495b5931a" name="End" type="End"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="480" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="a234705b-7750-414b-9272-c9da6dadbb29" name="Subject" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">Transmit Doc*</initialvalue><private /><alwaysinit /></stage><stage stageid="fc5a4497-c9da-4081-b6c7-6aa410077559" name="Start" type="Start"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sender Name" narrative="Optional. The From display name, which might be a name (eg John Smith) or email address (eg admin@client.com). Asterisk wildcard permitted, eg *John Smith* for any mail where the text 'John Smith' appears in the From field." stage="Sender Name" /><input type="text" name="Sender Email" narrative="Optional. The sender email address." stage="Sender Email" /><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Sub Folder" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>c9b08330-9266-42d8-afb1-bfd0212a0bb1</onsuccess></stage><stage stageid="ed695023-3ebd-4466-b984-54b33de61309" name="Received Earliest" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d779b004-3051-4ec3-8e1c-e0789a7556f7" name="Received Latest" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fcd90998-4836-4740-94d8-e4a16f6c9a8a" name="Filter Expression" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9b08330-9266-42d8-afb1-bfd0212a0bb1" name="Sender Name?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="-45" /><decision expression="[Sender Name]&lt;&gt;&quot;&quot;" /><ontrue>cf721a2d-fb9a-45b4-a23e-79acd1788264</ontrue><onfalse>6026daca-0a8d-430d-8d29-4b1a47bbd744</onfalse></stage><stage stageid="cf721a2d-fb9a-45b4-a23e-79acd1788264" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="-45" /><onsuccess>6026daca-0a8d-430d-8d29-4b1a47bbd744</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:sendername LIKE '&quot;&amp;Replace([Sender Name], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="5d16b439-8384-4785-82eb-4d90c136ef72" name="Clean Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="330" /><onsuccess>e9554fa4-9c52-4334-8596-1870756ff851</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="8da24dc5-05ed-46e0-9809-310f7b278651" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>33f96e1e-970b-4b66-a480-d88515be04fd</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="df17b66b-e23b-47e0-9b32-8f57f8933650" name="Subject?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="45" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>8da24dc5-05ed-46e0-9809-310f7b278651</ontrue><onfalse>33f96e1e-970b-4b66-a480-d88515be04fd</onfalse></stage><stage stageid="6026daca-0a8d-430d-8d29-4b1a47bbd744" name="Sender Email?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="0" /><decision expression="[Sender Email]&lt;&gt;&quot;&quot;" /><ontrue>4db35983-ba48-40d4-ae96-ce58aae25eac</ontrue><onfalse>df17b66b-e23b-47e0-9b32-8f57f8933650</onfalse></stage><stage stageid="4db35983-ba48-40d4-ae96-ce58aae25eac" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="0" /><onsuccess>df17b66b-e23b-47e0-9b32-8f57f8933650</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:senderemail LIKE '&quot;&amp;Replace([Sender Email], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="4fb628f1-f6c5-4b20-8b86-14b09ec9aaa2" name="Sender Name" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9fa83032-7314-41df-9f66-a9b85b5e7c59" name="Sender Email" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e9554fa4-9c52-4334-8596-1870756ff851" name="Filter Expression?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="375" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>70daf41d-55cb-41f7-a833-571bb6dd163c</ontrue><onfalse>52cbe6ae-99c8-4586-966b-5296aefb3d4d</onfalse></stage><stage stageid="70daf41d-55cb-41f7-a833-571bb6dd163c" name="Prepend" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="375" /><onsuccess>52cbe6ae-99c8-4586-966b-5296aefb3d4d</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="e5c8f5e5-2c69-4e56-a9a9-065a6822578c" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="270" /><onsuccess>5d16b439-8384-4785-82eb-4d90c136ef72</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="40907441-3be5-4017-8cd8-ce39d1d45e00" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="135" /><onsuccess>8dacbd62-bf37-4356-8b27-60b6d6ef3c7b</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="f3271667-af96-4466-865e-1208fce2b7a7" name="Earliest?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="135" /><decision expression="IsDate([Received Earliest])" /><ontrue>40907441-3be5-4017-8cd8-ce39d1d45e00</ontrue><onfalse>8dacbd62-bf37-4356-8b27-60b6d6ef3c7b</onfalse></stage><stage stageid="8dacbd62-bf37-4356-8b27-60b6d6ef3c7b" name="Latest" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="IsDate([Received Latest])" /><ontrue>6ed0d913-094a-4fab-8579-32febc1aaf56</ontrue><onfalse>7efc0b33-05f9-44d9-a9cf-40d3e3a0c762</onfalse></stage><stage stageid="6ed0d913-094a-4fab-8579-32febc1aaf56" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="180" /><onsuccess>7efc0b33-05f9-44d9-a9cf-40d3e3a0c762</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="f450016e-a94a-4f57-bda5-84ca5a1729cb" name="Include Unread" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="5c31a9c2-8d23-4103-abbf-a1227bf7eb37" name="Include Read" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="7efc0b33-05f9-44d9-a9cf-40d3e3a0c762" name="Unread Only?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="225" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>e5c8f5e5-2c69-4e56-a9a9-065a6822578c</ontrue><onfalse>dc3e85f5-5b43-4254-9a67-08b13dd0328d</onfalse></stage><stage stageid="dc3e85f5-5b43-4254-9a67-08b13dd0328d" name="Read Only?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="225" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>72639236-cc85-4361-a525-dbc901418695</ontrue><onfalse>9c50f8f8-6533-4a09-a74c-f3b78165994b</onfalse></stage><stage stageid="72639236-cc85-4361-a525-dbc901418695" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="270" /><onsuccess>923ffb40-85c5-4ba1-beb5-bd4bd5a01402</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="9c50f8f8-6533-4a09-a74c-f3b78165994b" name="Anchor1" type="Anchor"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="150" y="225" w="10" h="10" /><onsuccess>3c4b866a-41ad-44f7-9cf3-de8e155c6390</onsuccess></stage><stage stageid="3c4b866a-41ad-44f7-9cf3-de8e155c6390" name="Anchor1" type="Anchor"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="150" y="330" w="10" h="10" /><onsuccess>923ffb40-85c5-4ba1-beb5-bd4bd5a01402</onsuccess></stage><stage stageid="923ffb40-85c5-4ba1-beb5-bd4bd5a01402" name="Anchor1" type="Anchor"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="330" w="10" h="10" /><onsuccess>5d16b439-8384-4785-82eb-4d90c136ef72</onsuccess></stage><stage stageid="4e764844-ba4d-45df-9304-2d8f9ed8a3c2" name="Items" type="Collection"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="-195" y="195" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="f9f11b66-32d1-4bbd-bd57-31fc63ef08e3" name="Filter Expression" type="Calculation"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="90" y="90" /><onsuccess>f3271667-af96-4466-865e-1208fce2b7a7</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="33f96e1e-970b-4b66-a480-d88515be04fd" name="Message?" type="Decision"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="15" y="90" /><decision expression="[Message]&lt;&gt;&quot;&quot;" /><ontrue>f9f11b66-32d1-4bbd-bd57-31fc63ef08e3</ontrue><onfalse>f3271667-af96-4466-865e-1208fce2b7a7</onfalse></stage><stage stageid="2db225a4-62a9-479c-b5ba-09e4dd4b750a" name="Message" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><display x="240" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5e750ff4-dfbb-4396-a604-2128fd627698" name="Input" type="Block"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="-270" y="-120" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="182ac5a7-766b-4288-88f3-26da49f9b569" name="Output" type="Block"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><display x="-270" y="150" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="061d588d-c15f-4b58-b85e-0efb9f93255c" name="MailBoxName" type="Data"><subsheetid>d7314e45-c4db-4920-9ad2-771a4c4970f3</subsheetid><loginhibit /><narrative>Name of the Mail Box From Where Mails to read</narrative><display x="-195" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c3b4962-61e1-445e-af1d-852699ff5d9d" name="Internal_Get Items - OBSOLETE" type="SubSheetInfo"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="101d0b00-7900-40a2-82a7-e84fd13b9828" name="Start" type="Start"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>f780b0a7-6fc3-4dea-a96d-6d0c861efc82</onsuccess></stage><stage stageid="e67a31de-8677-4473-81e8-8e1055832dfe" name="End" type="End"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="f780b0a7-6fc3-4dea-a96d-6d0c861efc82" name="Get Items_OLD" type="Code"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>e67a31de-8677-4473-81e8-8e1055832dfe</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
On error resume next
Dim Folders
Dim FolderTemp
dim folder 
Folders = _nameSpace.Folders
For Each FolderTemp In Folders
    If FolderTemp = MailBoxName Then
	folder = FolderTemp.Folders("Inbox")
			'See https://msdn.microsoft.com/en-us/library/office/aa210946(v=office.11).aspx
		'for mail item properties
		Dim dataTable As New Data.DataTable
		dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
		dataTable.Columns.Add("To", Type.GetType("System.String"))
		dataTable.Columns.Add("CC", Type.GetType("System.String"))
		dataTable.Columns.Add("Subject", Type.GetType("System.String"))
		dataTable.Columns.Add("Body", Type.GetType("System.String"))
		dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
		dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
		dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
		dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
		dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

		Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

		For Each item As Object In folderItems
			If Not TypeOf item Is MailItem Then Continue For
			Dim row As Data.DataRow = dataTable.NewRow
			row("EntryID") = item.EntryID
			row("To") = item.To
			row("CC") = item.CC
			row("Subject") = item.Subject
			row("Body") = item.Body
			
			Dim attachments As String = ""
			For Each attachment As Object In item.Attachments
				If attachment.Type = 1 Then
					attachments = attachments & "|" & attachment.DisplayName
				End If
			Next
			
			row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
			row("SentOn") = item.SentOn
			row("ReceivedOn") = item.ReceivedTime
			row("SenderName") = item.SenderName
			row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
			row("Unread") = item.Unread
			dataTable.Rows.Add(row)
			Item_Count += 1
		Next
		Items = dataTable
	End If
Next





]]></code></stage><stage stageid="420f17d1-355c-45c1-a72c-5687bb6cfbf3" name="Item Count" type="Data"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7b6a3aa4-969f-48bc-b3fe-44ba5fda26cb" name="Filter Expression" type="Data"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f51aed20-1f06-42fe-b7ca-68fd6a785c5d" name="Items" type="Collection"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="8020c858-84c5-427e-9654-a885506ea45d" name="Note2" type="Note"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="8182b017-c889-4853-b8bd-4717a47f58e3" name="Input" type="Block"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d4aa7869-4f4e-4ef5-b3cf-6ba0ded5eede" name="Output" type="Block"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="8d803261-c5a0-4410-be43-0d7fd22b3262" name="MailBoxName" type="Data"><subsheetid>ae91b57c-f70f-4552-9614-4bdd2e58503a</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9ae7d6a-53da-4d77-8ef2-5e049f9656b5" name="Save Email As File" type="SubSheetInfo"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><narrative>Stores a specified email as a ".html" file on any file location (file path).
The Entry ID is the unique idenfier used to determine which email is to be saved. This is avaialble when emails are read using Get Received Emails Action</narrative><display x="-195" y="-75" w="150" h="120" /></stage><stage stageid="6e840579-823d-428a-b2c9-3581b7a8ed06" name="Start" type="Start"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="File Path" narrative="Mandatory. The destination file path. Default blank." stage="File Path" /><input type="text" name="File Name" narrative="Mandatory. The File Name for the stored Email." stage="File Name" /></inputs><onsuccess>b3c7c437-2409-4ffa-af7e-5894af05f0ee</onsuccess></stage><stage stageid="6cadc6a5-d8f5-4814-adf4-122a404e87e4" name="End" type="End"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="b3c7c437-2409-4ffa-af7e-5894af05f0ee" name="Save As - HTML" type="Code"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="File Path" expr="[File Path]" /><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="File Name" expr="[File Name]" /></inputs><onsuccess>6cadc6a5-d8f5-4814-adf4-122a404e87e4</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
Dim item = _nameSpace.GetItemFromID(Entry_ID)
item.SaveAs (File_Path & File_Name & ".htm",OlSaveAsType.olHTML)]]></code></stage><stage stageid="0f3ffc7b-d7e0-4359-a4d7-dab11f1ac13e" name="File Path" type="Data"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b83479fe-586d-4a11-a767-669121cb818f" name="Entry ID" type="Data"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f7dc6098-dd5a-427f-aa96-5978f6523887" name="File Name" type="Data"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><display x="-195" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6914f049-c4cc-4467-84a9-9a5a8894fe95" name="Input" type="Block"><subsheetid>01becf51-b820-482f-b0c5-35c3f43fa33d</subsheetid><loginhibit /><display x="-270" y="0" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3637868d-9810-4ce9-b5e5-d0db4ea1fd96" name="Get_Email_Body_Type" type="SubSheetInfo"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><narrative>Get type of email for example HTML, Plain Text,Rich Text etc. This actions returns a number value .HTML-2 Value ,Plain Text -1,Rich Text -3</narrative><display x="-195" y="-45" w="150" h="150" /></stage><stage stageid="787e4ebf-4afd-4719-b753-f6d65fbccb0d" name="End" type="End"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><loginhibit /><display x="15" y="60" /><outputs><output type="number" name="Type if email" narrative="Return a number value HTML-2,Plain Text 1" stage="Type" /></outputs></stage><stage stageid="f03f5bd0-caec-4b82-b1f3-f524ce5279e9" name="Entry ID" type="Data"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8a4c85a7-1df0-45bc-8c1f-91fb08f22ff3" name="Get body type of email" type="Code"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><loginhibit /><narrative>Get the type of email which means HTML or Plain Text or Rich text</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /></inputs><outputs><output type="number" name="BType" stage="Type" /></outputs><onsuccess>787e4ebf-4afd-4719-b753-f6d65fbccb0d</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim mail = item.Forward
Dim bodyType= item.BodyFormat

BType=item.BodyFormat
]]></code></stage><stage stageid="28983da5-6dcb-45a1-880c-32c15a672dd8" name="Start" type="Start"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><loginhibit /><display x="15" y="-60" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /></inputs><onsuccess>8a4c85a7-1df0-45bc-8c1f-91fb08f22ff3</onsuccess></stage><stage stageid="3a92b52d-1b14-46d6-8b14-1c67dfd7a81e" name="Input" type="Block"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><loginhibit /><display x="-270" y="45" w="150" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ec08688c-7b42-4148-acb8-ce099eb620a1" name="Type" type="Data"><subsheetid>8742cdcb-4f3f-4711-a908-73aae1f4c1d0</subsheetid><display x="-195" y="135" w="120" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a66a38d7-0c1a-4e5c-9626-7ed834e89681" name="Send Email" type="SubSheetInfo"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><narrative>Sends an Email with Voting Options</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7834cf3c-0b28-4b5a-89ff-593ddd7146bc" name="End" type="End"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="15" y="120" /></stage><stage stageid="b9a9cc83-b505-46b1-8b4d-a52fba6dff4b" name="Send Item with VotingOptions" type="Code"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="To" expr="[To]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /><input type="text" name="Subject" expr="[Subject]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="flag" name="Message Is HTML" expr="[Message Is HTML]" /><input type="text" name="VotingOptions" expr="[in_votingOptions]" /></inputs><onsuccess>7834cf3c-0b28-4b5a-89ff-593ddd7146bc</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim mail = app.CreateItem(0)
Dim addressCount As Integer

If [To] <> "" Then
	Dim toAddresses = Split([To], ";")
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = mail.Recipients.Add(toAddresses(addressCount)) 
	recipient.Resolve  
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTo
	Next 
	
End if

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = mail.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = mail.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

mail.Subject = Subject
mail.HTMLBody = Message
mail.VotingOptions = VotingOptions

For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	mail.Attachments.Add(att)
Next

mail.Save
mail.Send

]]></code></stage><stage stageid="6bbd25fa-4563-4bf7-985f-411cf3ab1088" name="Subject" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4ebb1a85-6c07-4fad-8f66-877002d23d06" name="To" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fff66ddb-0a8e-4c34-9a91-c7f316c854fd" name="Message" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="23653b00-e62f-4ad3-84a3-17413bf62a2e" name="Attachments" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="46f9a042-03ab-47c3-bd6e-d9048524e723" name="CC" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e3b58de-2233-46f6-bd79-e89ff2ebc553" name="BCC" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7884fbcf-b9f5-47b6-a979-5e77f777d214" name="Message Is HTML" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="23d13106-c5fe-47c3-ba95-fcae53623177" name="Start" type="Start"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" stage="To" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." stage="Subject" /><input type="text" name="Message" narrative="Optional, HTML or plain text" stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="text" name="Voting Options" narrative="Mandatory, enter the voting options required. Ex: Accept;Reject" stage="in_votingOptions" /></inputs><onsuccess>b9a9cc83-b505-46b1-8b4d-a52fba6dff4b</onsuccess></stage><stage stageid="91532a29-e0d1-4ba1-bb5e-a602c0914798" name="Input" type="Block"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="22b90fae-0711-459e-bd55-152a0ea9cc6e" name="in_votingOptions" type="Data"><subsheetid>8f499677-ebb9-4b96-a583-a3c8c09bb5aa</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9d0b04b1-fe42-44f2-9487-aa4177d1aa50" name="Get Email ID from Alias ID" type="SubSheetInfo"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><narrative>Fetch the Email ID of the given Alias ID</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f4f38700-c810-4558-a263-f16c6c66fef2" name="Start" type="Start"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><loginhibit /><display x="15" y="-75" /><inputs><input type="text" name="AliasID" narrative="Alias ID of the person to fetch Alias ID" stage="AliasID" /></inputs><onsuccess>cf86e0c4-0747-4f77-bc3a-8f55fd319c36</onsuccess></stage><stage stageid="f38d4efe-5d21-48cd-a08b-88ea3aa1c181" name="End" type="End"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><loginhibit /><display x="15" y="120" /><outputs><output type="text" name="Email ID" narrative=" Email ID for given Alias ID" stage="EmailID" /><output type="flag" name="Sucess?" narrative="Found or not found" stage="Success" /><output type="text" name="Error Message" narrative="Description in any error" stage="ErrorMsg" /></outputs></stage><stage stageid="cd442b53-36c2-4ae9-82c7-cb6978b2a406" name="AliasID" type="Data"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><display x="-195" y="-15" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="cf86e0c4-0747-4f77-bc3a-8f55fd319c36" name="Get Email ID" type="Code"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><loginhibit /><display x="15" y="15" w="90" h="30" /><font family="Segoe UI" size="11" style="Regular" color="000000" /><inputs><input type="text" name="AliasID" expr="[AliasID]" /></inputs><outputs><output type="text" name="EmailID" stage="EmailID" /><output type="flag" name="Success" stage="Success" /><output type="text" name="ErrorMsg" stage="ErrorMsg" /></outputs><onsuccess>f38d4efe-5d21-48cd-a08b-88ea3aa1c181</onsuccess><code><![CDATA[Dim ToAddr = AliasID

Try
	Dim ol = CreateObject("Outlook.Application")
	Dim mail = ol.CreateItem(0)
	Dim recipient = mail.Recipients.Add(ToAddr)

	Dim oAE = recipient.AddressEntry
	Dim ExchangeUser =  oAE.GetExchangeUser
	
	If (ExchangeUser is Nothing)
		Success = False
		AliasID = "Null"
	Else
		EmailID =  oAE.GetExchangeUser.PrimarySmtpAddress
		Success = True
		ErrorMSg = Nothing
	End If

	recipient.delete
	oAE = Nothing
	recipient = Nothing
	ol = Nothing

Catch ex as System.Exception
	Success = False
	ErrorMsg = ex.Message
End Try]]></code></stage><stage stageid="70d2b4fc-5cdf-4e5c-aa9d-d054c12f7c61" name="EmailID" type="Data"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><display x="-195" y="60" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="76451b97-17c5-41bb-874c-79f6be4f5b06" name="ErrorMsg" type="Data"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><display x="-195" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bded040d-a233-41b9-80e4-794d1147a62e" name="Success" type="Data"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><display x="-195" y="105" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="99d7e1b5-f6f2-4be6-97ad-863dbbd051b7" name="Input" type="Block"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="3d09fd84-834c-404c-984e-e96d09cb8860" name="Output" type="Block"><subsheetid>06c51a06-fb3d-423a-8f8e-063c286d962b</subsheetid><loginhibit /><display x="-270" y="30" w="150" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="45207685-b537-4d9a-b9d3-ff78bf7423c0" name="Reply All to Email" type="SubSheetInfo"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><narrative>Reply to all Emails recipients of a specific email including appending custom TO recipients.

The &lt;Reply All to Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-195" y="-60" w="150" h="120" /></stage><stage stageid="f4e96293-089d-4e6d-9bdc-ce336a771c12" name="End" type="End"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="ede3d5b3-b37f-4a71-a325-0d0e731df127" name="Start" type="Start"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Message" narrative="Mandatory, Any alphanumeric value allowed. HTML or plain text." stage="Message" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." stage="Attachments" /><input type="text" name="TO" narrative="Optional, Reply to all Emails recipients of a specific email including appending custom TO recipients." stage="TO" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="CC" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" stage="BCC" /></inputs><onsuccess>dfc2f4db-1b9c-4bbb-b161-d13978e1384b</onsuccess></stage><stage stageid="dfc2f4db-1b9c-4bbb-b161-d13978e1384b" name="Reply To All with custom TO" type="Code"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="Attachments" expr="[Attachments]" /><input type="text" name="TOrecipients" expr="[TO]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /></inputs><onsuccess>f4e96293-089d-4e6d-9bdc-ce336a771c12</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim reply = item.ReplyAll

Dim addressCount As Integer
If TOrecipients <> "" Then
	Dim toAddresses = Split([TOrecipients], ";")
	addressCount = 0
	For addressCount = LBound(toAddresses) To UBound(toAddresses)
	Dim recipient = reply.Recipients.Add(toAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olTO 
	Next

End If

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = reply.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = reply.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

if Not item.Subject.Contains("RE:") Then	
	reply.Subject = "RE: " & item.Subject
Else
	reply.Subject = item.Subject
End If
	
'reply.HTMLBody = Message & vbCrLf & item.HTMLBody  //Old code which doesn't include the Email Header Addresssuch as From,To,CC,Subject etc.
reply.HTMLBody = Message & "<hr>" & "<b>From:</b> " & item.SenderName & "<" & item.SenderEmailAddress & "> <br>"& "<b>Sent:</b> " & item.ReceivedTime & vbCrLf & "<br><b>To:</b> " & item.To & vbCrLf & "<br><b>Cc:</b> " & item.CC & vbCrLf & "<br><b>Subject:</b> " & item.Subject & "<br><br><br>" & item.HTMLBody


For Each att As String In Attachments.Split(";"c)
	If att = "" Then Continue For
	reply.Attachments.Add(att)
Next


reply.Send]]></code></stage><stage stageid="01cffc7d-c285-4290-abab-8f8082fd04fc" name="Entry ID" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eebb10be-5459-4de1-abb6-b675a9ed0cf4" name="Message" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="baa30fa3-2d6d-4459-97b6-515b67bf8ecd" name="Input" type="Block"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><loginhibit /><display x="-270" y="15" w="165" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="ae19c6b5-4a0c-4747-abdb-6d4761c9165e" name="Attachments" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><display x="-195" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f79abbdb-f077-4b9a-889b-b91af7112728" name="CC" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><display x="-195" y="135" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9635d279-2dd6-4326-9276-312159385c1e" name="BCC" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="547bce05-b019-49fb-9cd6-91381832b275" name="TO" type="Data"><subsheetid>049ae8fa-5c76-413f-8d2f-d365fac0f778</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6d7be415-d8bb-4945-9597-d600064ed006" name="Mark Email With Category" type="SubSheetInfo"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><narrative>Marks a specific email as unread.

The Entry ID is the unique idenfier used to determine which email is to be marked.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f774f3fe-8d2b-4355-aa60-7d13a306f40a" name="Start" type="Start"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Category" narrative="Provide Category name" stage="Category" /></inputs><onsuccess>9918fffc-4ffd-4386-9e0b-172246b3efda</onsuccess></stage><stage stageid="202a7f54-d437-48ac-82c2-34bb783b63f7" name="End" type="End"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="9918fffc-4ffd-4386-9e0b-172246b3efda" name="Mark Category" type="Code"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="Category" expr="[Category]" /></inputs><onsuccess>202a7f54-d437-48ac-82c2-34bb783b63f7</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
item.Categories = Category
item.save]]></code></stage><stage stageid="4c1b1c1f-3222-4904-a0b1-2753f79fcce0" name="Entry ID" type="Data"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8ba63ee7-0f41-4dae-b54f-dd291a8406e2" name="Input" type="Block"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><loginhibit /><display x="-270" y="-45" w="165" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cd171e91-d3f9-4f7a-b2b7-56dae4ac8e3b" name="Category" type="Data"><subsheetid>efb11c84-5d76-4cc7-a53c-0d63be07a29f</subsheetid><display x="-195" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="31de8747-c0c0-4269-aea5-acf3b3b6c520" name="Save specific Attachment As" type="SubSheetInfo"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><narrative>Save only the attachment with specifice file name or file format. Existing save attachmnet page saves all the attachments</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d43ba8f8-e0c9-4ceb-9fe7-4d892ae8dba7" name="End" type="End"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="71363ca0-1001-4a18-907f-3023adcb01e1" name="Folder Path" type="Data"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d350d592-e7af-4c29-8f16-73f4b2ee65db" name="Entry ID" type="Data"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c8dad795-416f-43c8-b948-fa419146b0d0" name="File Name" type="Data"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3722b20a-1265-47b8-9252-976475e611e0" name="Input" type="Block"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1fc5aaf7-7a8b-47b2-b266-edc60a14b249" name="Start" type="Start"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Folder Path" narrative="The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /><input type="text" name="File Name" narrative="Name of pattern of the file to be saved. common cases inlcude &quot;.docx&quot; , &quot;.pdf&quot; , &quot;.xlsx&quot; etc." stage="File Name" /><input type="text" name="AsFileName" narrative="Save as file name" stage="AsFileName" /></inputs><onsuccess>5b105ec8-50bb-46a5-aa4b-cde7844c726a</onsuccess></stage><stage stageid="12f73feb-4e8b-4f35-bc88-60433210f758" name="AsFileName" type="Data"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><narrative>Save as file name</narrative><display x="-195" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b105ec8-50bb-46a5-aa4b-cde7844c726a" name="Save specific Attachment As" type="Code"><subsheetid>08a7af23-6fb5-470e-9940-aec93dea9b0b</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Folder_Path" expr="[Folder Path]" /><input type="text" name="Entry_ID" expr="[Entry ID]" /><input type="text" name="File_Pattern" expr="[File Name]" /><input type="text" name="SaveAsName" expr="[AsFileName]" /></inputs><onsuccess>d43ba8f8-e0c9-4ceb-9fe7-4d892ae8dba7</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"
Dim SpecialChar() As String = {"\","/",":","*","?","|","<",">"}

For Each attachment As Object In item.Attachments
	'For Each schar As String In SpecialChar
		'File_Pattern = File_Pattern.Replace(schar,"")
	'Next
'a=File_Pattern.ToLower()
'b=attachment.DisplayName.ToLower()
	If attachment.Type = 1 AndAlso attachment.DisplayName.ToLower() Like File_Pattern.ToLower() Then
		Dim Extension As string = System.IO.Path.GetExtension(attachment.FileName).ToLower()
		attachment.SaveAsFile(Folder_Path & SaveAsName & Extension)
		If Not System.IO.File.Exists(Folder_Path & SaveAsName & Extension) Then
			Throw new System.Exception("Unable to save attachment")
		End If
	End If
Next

]]></code></stage><stage stageid="efdb8814-c46f-4989-a9fb-aee3a01deb97" name="Success" type="Data"><subsheetid>f6f16944-bdad-4ff4-a5df-b687b904183c</subsheetid><loginhibit onsuccess="true" /><display x="-150" y="105" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4a5a3e15-8644-4ca1-b9c7-30db0b0b5cef" name="Message" type="Data"><subsheetid>f6f16944-bdad-4ff4-a5df-b687b904183c</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="135" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fc3cdbb5-3a74-4f17-bb39-9c58420f0c6b" name="Reply to Email - Extended" type="SubSheetInfo"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><narrative>Reply to Email sender of a specific email with CC &amp; BCC Option

The &lt;Reply to Email&gt; action will only call one ID specific (Entry ID) email item. 

If multiple emails are expected to be called, the process design would need to reflect that requirement.</narrative><display x="-165" y="-60" w="150" h="120" /></stage><stage stageid="e3090677-a5a6-4034-b19b-0b0e8aaaafef" name="End" type="End"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="af51f171-4f44-411c-af34-97f1a1976a36" name="Start" type="Start"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Message" narrative="Mandatory, Any alphanumeric value allowed. HTML or plain text." stage="Message" /><input type="text" name="BCC" narrative="BCC Email IDs (Optional)" stage="BCC" /><input type="text" name="CC" narrative="CC Email IDs (Optional)" stage="CC" /></inputs><onsuccess>9ce92713-6701-4ac3-a5da-648838fecd1d</onsuccess></stage><stage stageid="9ce92713-6701-4ac3-a5da-648838fecd1d" name="Reply Ext" type="Code"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="Message" expr="[Message]" /><input type="text" name="CC" expr="[CC]" /><input type="text" name="BCC" expr="[BCC]" /></inputs><onsuccess>e3090677-a5a6-4034-b19b-0b0e8aaaafef</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
Dim reply = item.Reply

Dim addressCount As Integer

If CC <> "" Then
	Dim ccAddresses = Split([CC], ";")
	addressCount = 0
	For addressCount = LBound(ccAddresses) To UBound(ccAddresses)
	Dim recipient = reply.Recipients.Add(ccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olCC 
	Next

End If

If BCC <> "" Then
	Dim bccAddresses = Split([BCC], ";")
	addressCount = 0
	For addressCount = LBound(bccAddresses) To UBound(bccAddresses)
	Dim recipient = reply.Recipients.Add(bccAddresses(addressCount))
	recipient.Resolve
	If recipient.Resolved Then recipient.Type = OlMailRecipientType.olBCC
	Next

End If

if Not item.Subject.Contains("RE:") Then	
	reply.Subject = "RE: " & item.Subject
Else
	reply.Subject = item.Subject
End If
	
reply.HTMLBody = Message & "<hr>" & "<b>From:</b> " & item.SenderName & "<" & item.SenderEmailAddress & "> <br>"& "<b>Sent:</b> " & item.ReceivedTime & vbCrLf & "<br><b>To:</b> " & item.To & vbCrLf & "<br><b>Cc:</b> " & item.CC & vbCrLf & "<br><b>Subject:</b> " & item.Subject & "<br><br><br>" & item.HTMLBody

reply.Send]]></code></stage><stage stageid="96f244bf-7e69-46f9-9388-15c0f25feb5d" name="Entry ID" type="Data"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-165" y="60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b63ca8b7-d833-4169-a8c6-f74d42cf3635" name="Input" type="Block"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><loginhibit /><display x="-255" y="30" w="180" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="92038f34-9265-474e-9101-4c38d4c6e5a7" name="Message" type="Data"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><loginhibit onsuccess="true" /><display x="-165" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9cb0ae90-364a-471e-9678-5ac97fa1da44" name="CC" type="Data"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><display x="-165" y="150" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="62c3748f-e837-42fa-8bc7-95a8f123c975" name="BCC" type="Data"><subsheetid>9c9427ee-6032-4edb-b841-fd86d6ebb3f4</subsheetid><display x="-165" y="120" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ba6b4d3b-40a9-4b38-99b2-a7371ec64ba1" name="Get Received Items (Basic) - Undelivered Mails" type="SubSheetInfo"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><narrative>Lists Inbox items matching the parameters provided</narrative><display x="-390" y="-75" w="150" h="90" /></stage><stage stageid="06062785-b4b2-4e73-8dde-2353312d5f84" name="Item Count" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="240" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a2364d84-6e57-49ca-9caf-9d2e0b80bb78" name="Internal_Get Items" type="SubSheet"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="345" /><inputs><input type="text" name="Filter Expression" friendlyname="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="MailBoxName" friendlyname="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" expr="[MailBoxName]" /></inputs><outputs><output type="collection" name="Items" friendlyname="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" friendlyname="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>7577f82a-62c0-4788-bf9a-a2205e3d20cd</onsuccess><processid>a89e696d-742f-42f8-9519-087c6620c77a</processid></stage><stage stageid="7da7bb3f-66ba-4240-95ae-5b8493c11854" name="Outlook Folder ID" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="c66acf98-e3f1-4036-b36f-4c741433bf8c" name="Sub Folder" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7577f82a-62c0-4788-bf9a-a2205e3d20cd" name="End" type="End"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="420" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="c6d45e92-b291-4e5d-af0f-ab72b09b0abf" name="Subject" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bec44643-add4-4f73-ae7d-dd19d671bb59" name="Start" type="Start"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Sub Folder" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>6f893d30-eb27-46a8-b829-7e95f43966de</onsuccess></stage><stage stageid="93b1d2d3-e836-4764-8385-f78adb8811b1" name="Received Earliest" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cbdc606b-115a-466c-a005-8b95bb82511a" name="Received Latest" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4250252-de48-4445-a9e3-7451e517e0d3" name="Filter Expression" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8b4d9270-2304-443d-8337-378b444d2cef" name="Clean Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="255" /><onsuccess>df8def60-0d81-4dc4-869c-64ecd1183912</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="5021957d-ecc8-4491-966d-97d61ebf079b" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="-30" /><onsuccess>f17a0056-5c9e-46a4-9eae-71817487b86f</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="6f893d30-eb27-46a8-b829-7e95f43966de" name="Subject?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="-30" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>5021957d-ecc8-4491-966d-97d61ebf079b</ontrue><onfalse>f17a0056-5c9e-46a4-9eae-71817487b86f</onfalse></stage><stage stageid="df8def60-0d81-4dc4-869c-64ecd1183912" name="Filter Expression?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="300" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>1460afb0-640d-4f44-8997-d1f91b0d4759</ontrue><onfalse>a2364d84-6e57-49ca-9caf-9d2e0b80bb78</onfalse></stage><stage stageid="1460afb0-640d-4f44-8997-d1f91b0d4759" name="Prepend" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="300" /><onsuccess>a2364d84-6e57-49ca-9caf-9d2e0b80bb78</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="0ee4e9ac-2c33-4864-94de-ff532a136fdb" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="195" /><onsuccess>8b4d9270-2304-443d-8337-378b444d2cef</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="67cad529-e313-4545-a3e3-bd4ff0b03e09" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="60" /><onsuccess>dc01dacf-6c29-45fa-ac7e-dfa77b67874e</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="3dd16e8a-6b2c-4a55-85c8-09677fb2cc2b" name="Earliest?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="60" /><decision expression="IsDate([Received Earliest])" /><ontrue>67cad529-e313-4545-a3e3-bd4ff0b03e09</ontrue><onfalse>dc01dacf-6c29-45fa-ac7e-dfa77b67874e</onfalse></stage><stage stageid="dc01dacf-6c29-45fa-ac7e-dfa77b67874e" name="Latest" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="105" /><decision expression="IsDate([Received Latest])" /><ontrue>4e8bde44-8603-4d37-9188-0848213056df</ontrue><onfalse>7241df90-d42e-4fd0-b8e4-b398982c4203</onfalse></stage><stage stageid="4e8bde44-8603-4d37-9188-0848213056df" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="105" /><onsuccess>7241df90-d42e-4fd0-b8e4-b398982c4203</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="7f0d5354-663c-4801-be3a-9f5244ff04b2" name="Include Unread" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="392174c9-c097-401d-81fd-6742e3f8762b" name="Include Read" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="7241df90-d42e-4fd0-b8e4-b398982c4203" name="Unread Only?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="150" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>0ee4e9ac-2c33-4864-94de-ff532a136fdb</ontrue><onfalse>8b43df43-4221-4de7-90e1-030aa04a56bc</onfalse></stage><stage stageid="8b43df43-4221-4de7-90e1-030aa04a56bc" name="Read Only?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="150" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>f17d8194-ea79-4c65-85af-81873aecc2b7</ontrue><onfalse>0f12977c-6c8e-43c4-a8c3-b28a11a56b67</onfalse></stage><stage stageid="f17d8194-ea79-4c65-85af-81873aecc2b7" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="195" /><onsuccess>9a7bfda0-c18c-43d7-8341-feee9df042fa</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="0f12977c-6c8e-43c4-a8c3-b28a11a56b67" name="Anchor1" type="Anchor"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="150" y="150" w="10" h="10" /><onsuccess>4e10c5f1-1fe2-4ad3-ac80-d4e0cc244f45</onsuccess></stage><stage stageid="4e10c5f1-1fe2-4ad3-ac80-d4e0cc244f45" name="Anchor1" type="Anchor"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="150" y="255" w="10" h="10" /><onsuccess>9a7bfda0-c18c-43d7-8341-feee9df042fa</onsuccess></stage><stage stageid="9a7bfda0-c18c-43d7-8341-feee9df042fa" name="Anchor1" type="Anchor"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="255" w="10" h="10" /><onsuccess>8b4d9270-2304-443d-8337-378b444d2cef</onsuccess></stage><stage stageid="7652aa4d-7bcf-4aba-b972-c8e3ef295525" name="Items" type="Collection"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="-195" y="195" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="b302d741-5fb6-41c7-b27d-cb6483961408" name="Filter Expression" type="Calculation"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="90" y="15" /><onsuccess>3dd16e8a-6b2c-4a55-85c8-09677fb2cc2b</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:textdescription LIKE '&quot;&amp;Replace([Message], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="f17a0056-5c9e-46a4-9eae-71817487b86f" name="Message?" type="Decision"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="15" y="15" /><decision expression="[Message]&lt;&gt;&quot;&quot;" /><ontrue>b302d741-5fb6-41c7-b27d-cb6483961408</ontrue><onfalse>3dd16e8a-6b2c-4a55-85c8-09677fb2cc2b</onfalse></stage><stage stageid="7cfb6cd1-d98f-4109-81c6-c549cd41cc3d" name="Message" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><display x="240" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4fa696ea-c692-44c6-ac24-8c69354a5daf" name="Input" type="Block"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="-270" y="-120" w="150" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="745ccbe4-8910-4b1d-b1f6-b145ad96dc5f" name="Output" type="Block"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><display x="-270" y="150" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="a80f287a-6d36-40dc-a9e1-a82a328daed6" name="MailBoxName" type="Data"><subsheetid>93dc3ac7-9358-45f9-bbcf-f5edeb2cfee8</subsheetid><loginhibit /><narrative>Name of the Mail Box From Where Mails to read</narrative><display x="-195" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b931e0d3-aa1b-469e-895b-7a9cb8d361de" name="Internal_Get Items - Fetch Undelivered Emails" type="SubSheetInfo"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="f2747fb2-37db-4c31-969e-6a7c27943b5f" name="Start" type="Start"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="MailBoxName" narrative="Name of the Mail Box From Where Mails to read" stage="MailBoxName" /></inputs><onsuccess>cea8e266-4aad-4cec-b38b-d93a78339fe3</onsuccess></stage><stage stageid="b00576a1-513a-4c96-a94a-ff5fcc44ace9" name="End" type="End"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="cea8e266-4aad-4cec-b38b-d93a78339fe3" name="Get Items - Undelivered" type="Code"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>b00576a1-513a-4c96-a94a-ff5fcc44ace9</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
On error resume next
Dim Folders
Dim FolderTemp
dim folder 
Folders = _nameSpace.Folders
For Each FolderTemp In Folders
    If FolderTemp = MailBoxName Then
	folder = FolderTemp.Folders("Inbox")
			'See https://msdn.microsoft.com/en-us/library/office/aa210946(v=office.11).aspx
		'for mail item properties
		Dim dataTable As New Data.DataTable
		dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
		'dataTable.Columns.Add("To", Type.GetType("System.String"))
		'dataTable.Columns.Add("CC", Type.GetType("System.String"))
		dataTable.Columns.Add("Subject", Type.GetType("System.String"))
		dataTable.Columns.Add("Body", Type.GetType("System.String"))
		dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
		'dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
		'dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
		'dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
		'dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
		dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

		Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

		For Each item As Object In folderItems
			If  TypeOf item Is MailItem Then Continue For
			Dim row As Data.DataRow = dataTable.NewRow
			row("EntryID") = item.EntryID
			'row("To") = item.To
			'row("CC") = item.CC
			row("Subject") = item.Subject
			row("Body") = item.Body
			
			Dim attachments As String = ""
			For Each attachment As Object In item.Attachments
				If attachment.Type = 1 Then
					attachments = attachments & "|" & attachment.DisplayName
				End If
			Next
			
			row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
			'row("SentOn") = item.SentOn
			'row("ReceivedOn") = item.ReceivedTime
			'row("SenderName") = item.SenderName
			'row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
			row("Unread") = item.Unread
			dataTable.Rows.Add(row)
			Item_Count += 1
		Next
		Items = dataTable
	End If
Next





]]></code></stage><stage stageid="641639ce-37ec-4b61-b44e-9d10f629fb69" name="Item Count" type="Data"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><display x="-195" y="195" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="56b27085-b62d-4f8f-9f57-1ffd1b07db38" name="Filter Expression" type="Data"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bbaf8857-36b2-4c44-a66b-ec34ea3b1ca4" name="Items" type="Collection"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><display x="-195" y="150" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="e4eb3b5e-bd99-421f-b5c7-82e7d03e4751" name="Note2" type="Note"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="58cb3360-4b79-423f-a356-b9e5e4a3f6bf" name="Input" type="Block"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="dd38f4a2-17eb-46d4-bc78-f2edbdef3ad0" name="Output" type="Block"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><loginhibit /><display x="-270" y="105" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="7aa38107-22b1-473d-8cd2-f5ebfd1ebc53" name="MailBoxName" type="Data"><subsheetid>a89e696d-742f-42f8-9519-087c6620c77a</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="0b96ff72-9a55-44a8-a423-16d35a7e039d" name="Copy Email from Inbox to Inbox SubFolder" type="SubSheetInfo"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><narrative>Copies an email from Inbox to a subfolder within the inbox folder.

The Entry ID is the unique idenfier used to determine which email is to be copied.

Example
Inbox to Inbox\SubFolder </narrative><display x="-180" y="-60" w="150" h="120" /></stage><stage stageid="41a04bc3-2259-4b81-83a3-750c8873b239" name="Start" type="Start"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Destination Folder" narrative="Mandatory. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Destination Folder" /><input type="text" name="MailBoxName" narrative="Mail Box Name" stage="MailBoxName" /><input type="text" name="SourceFolder" narrative="Mandatory Value for souce folder" stage="SourceFolder" /></inputs><onsuccess>fd191653-4f8f-464b-8016-b2f70b96c2a8</onsuccess></stage><stage stageid="f8e2f190-a47d-46e7-af31-aebe0c9cd2eb" name="End" type="End"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="text" name="New Entry ID" narrative="Returns the new Entry ID from the Moved Email Object" stage="New Entry ID" /></outputs></stage><stage stageid="fd191653-4f8f-464b-8016-b2f70b96c2a8" name="CopyBetweenFolders" type="Code"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="SourceFolder" expr="[SourceFolder]" /><input type="text" name="DestinationFolder" expr="[Destination Folder]" /><input type="text" name="MailBoxName" expr="[MailBoxName]" /></inputs><outputs><output type="text" name="New Entry ID" stage="New Entry ID" /></outputs><onsuccess>f8e2f190-a47d-46e7-af31-aebe0c9cd2eb</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")
Dim Folders
Dim FolderTemp
dim folder 
dim Dest
dest = ""
'on error resume next
Folders = _nameSpace.Folders
For Each FolderTemp In Folders
    If FolderTemp.Name = MailBoxName Then
	folder = FolderTemp.Folders("Inbox")
	Dim item = _nameSpace.GetItemFromID(Entry_ID)

	If DestinationFolder <> "" Then
		'For each name as string in Destination_Folder.Split("\")
		Dest = folder.Folders(DestinationFolder)
		'Next
		Dim CopiedItem = item.Copy
	New_Entry_ID = CopiedItem.Move(Dest).EntryID
	exit for
	End If
	
	
	End If
Next
app = Nothing]]></code></stage><stage stageid="3ba65916-0481-47bc-8b81-017218bd7b6c" name="Entry ID" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-180" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b1bd6b73-a087-4cf5-afa2-829326af8001" name="Outlook Folder ID" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><narrative>MS Outlook - OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-180" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="be5e30e8-1a43-4f80-afd7-1eea79843e12" name="Destination Folder" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><display x="-180" y="75" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3c261504-5647-4ed3-b7ad-2031ed2ee8ab" name="Input" type="Block"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><display x="-255" y="15" w="150" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="b68b8c37-55ea-4191-b310-849a289080da" name="Default" type="Block"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><display x="-255" y="135" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FFCC99" /></stage><stage stageid="6fac9cc6-b452-4ed1-8b6f-ebd52303d9d7" name="New Entry ID" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><display x="-180" y="195" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33f2bbd1-26e7-4021-99a9-068458db28b7" name="MailBoxName" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><display x="-180" y="105" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="b824c97a-01a7-4474-9c0b-449d19906e52" name="SourceFolder" type="Data"><subsheetid>193d38a8-a62b-4b3d-bd11-97e403c5aa11</subsheetid><loginhibit /><display x="-180" y="255" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="93d03bc6-327e-47fb-bdda-de1647ccd38a" name="Check Email has Attachments of Specific file type" type="SubSheetInfo"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><narrative>Check if email has any attachments of specified file type

The Entry ID is the unique idenfier used to determine which email is to be actioned.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="94923e12-a5c9-4c0e-9952-700d81f25c05" name="End" type="End"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="flag" name="Out_flg_AttachmentFound" narrative="True if email has attachments, else false" stage="Out_flg_AttachmentFound" /><output type="number" name="Out_FileCount" narrative="Number of files matching the file type required" stage="Out_FileCount" /></outputs></stage><stage stageid="b3df9703-638b-4315-9cb3-934f6db8b1d2" name="Start" type="Start"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="In_txt_FilePattern" narrative="Required File Pattern" stage="File Pattern" /></inputs><onsuccess>c96a8de1-153c-4471-b6e6-0d592a08985f</onsuccess></stage><stage stageid="c96a8de1-153c-4471-b6e6-0d592a08985f" name="Check if Email has Attachments of specific file type" type="Code"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="File Pattern" expr="[File Pattern]" /></inputs><outputs><output type="flag" name="AttachmentFound" stage="Out_flg_AttachmentFound" /><output type="number" name="Count" stage="Out_FileCount" /></outputs><onsuccess>94923e12-a5c9-4c0e-9952-700d81f25c05</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

Count = item.Attachments.Count
Dim Out_AttachmentFound = False
Count = 0

For Each attachment As Object In item.Attachments
	If attachment.Type = 1 AndAlso InStr(LCase(attachment.FileName), File_Pattern)> 0 Then
		'attachment.SaveAsFile(Folder_Path & attachment.FileName)
		Out_AttachmentFound = True
		Count = Count + 1
	End If
Next

AttachmentFound = Out_AttachmentFound]]></code></stage><stage stageid="9cb393e2-c32a-4549-b24b-8dc618c04b70" name="Entry ID" type="Data"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5a209406-a3b7-45eb-8446-d8c0eb54f669" name="Input" type="Block"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fc9a0d95-6a06-419c-8f88-e5d92ae05c4f" name="Out_flg_AttachmentFound" type="Data"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><display x="-195" y="75" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f84a76a8-9a9e-48cc-bbc6-974752bc8c52" name="OutPut" type="Block"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><loginhibit /><display x="-270" y="45" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="32146e34-0c3c-4d04-af02-3fba8d5bafe8" name="File Pattern" type="Data"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="998b4846-3f7a-493b-aebe-8dab4bba677f" name="Out_FileCount" type="Data"><subsheetid>094d33ef-7d2d-4ad8-8246-fdd1b7a10bc4</subsheetid><display x="-195" y="105" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e43ec7bd-da10-4188-804e-e4219c5bc555" name="Save Attachments - With Same file names" type="SubSheetInfo"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><narrative>Downloads all attachments to a folder. 
Even if the attachements have same filenames

The Entry ID is the unique idenfier used to determine which email is to be actioned.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="ada6a9ba-222d-449c-b3cd-3f8522526109" name="End" type="End"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="fa5d60d5-e69d-4c9f-b411-317281679627" name="Start" type="Start"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><loginhibit /><display x="15" y="-135" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." stage="Entry ID" /><input type="text" name="Folder Path" narrative="Mandatory. The destination folder path for the attachments to be stored. Example &quot;C:\Temp&quot;." stage="Folder Path" /></inputs><onsuccess>3c3ad000-65c2-4f2c-b91b-d34e75e97250</onsuccess></stage><stage stageid="3c3ad000-65c2-4f2c-b91b-d34e75e97250" name="Save Attachments - With Same file names" type="Code"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Folder Path" expr="[Folder Path]" /><input type="text" name="Entry ID" expr="[Entry ID]" /><input type="text" name="File Pattern" expr="[File Pattern]" /></inputs><onsuccess>ada6a9ba-222d-449c-b3cd-3f8522526109</onsuccess><code><![CDATA[Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim File_Counter = 1

Dim item = _nameSpace.GetItemFromID(Entry_ID)
If item Is Nothing Then Return

If Not Folder_Path.EndsWith("\") Then Folder_Path &="\"

For Each attachment As Object In item.Attachments
	If attachment.Type = 1 AndAlso attachment.FileName Like File_Pattern Then
		attachment.SaveAsFile(Folder_Path & File_Counter & "_" & attachment.FileName)
		File_Counter = File_Counter + 1
	End If
Next
]]></code></stage><stage stageid="ada96513-0cb0-4330-86e0-f0b37152104a" name="Folder Path" type="Data"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><display x="-195" y="15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2338f8ce-ef3f-4248-8cab-9f632f26995d" name="Entry ID" type="Data"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><narrative>An ID obtained from one of the Get Item actions in this object.</narrative><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3df19426-df6d-4bc3-9dda-2ac57e56ea0e" name="File Pattern" type="Data"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">*.*</initialvalue><private /><alwaysinit /></stage><stage stageid="c5f69218-f8fa-4ebc-a4b9-24ec72b6cb2f" name="Input" type="Block"><subsheetid>c51aaa35-40c0-4c4a-aec9-ff1535f2a3d4</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2d5c20c4-5483-491d-b1df-ebf0417315e7" name="Internal_Get Items - Distribution List" type="SubSheetInfo"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><narrative>Sub function used by multiple actions within VBO. Do not change or publish.

Uses the Restrict method to create a filtered list of folder items. Not intended for publication.

</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="761e14dc-f003-4a82-be56-2f380a248e05" name="Start" type="Start"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><display x="15" y="-90" /><inputs><input type="text" name="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" stage="Filter Expression" /><input type="text" name="Sub Folder" narrative="Optional, default blank. The inbox sub folder to look in." stage="Sub Folder" /></inputs><onsuccess>e8442fe0-4099-4dc4-bace-9e46bdc72eca</onsuccess></stage><stage stageid="d4455028-cbab-4966-b564-71ab53bf6bbb" name="End" type="End"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><display x="15" y="105" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="e8442fe0-4099-4dc4-bace-9e46bdc72eca" name="Get Items - DL" type="Code"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><display x="15" y="0" /><inputs><input type="text" name="Filter Expression" expr="[Filter Expression]" /><input type="number" name="Outlook Folder ID" expr="[Outlook Folder ID]" /><input type="text" name="Sub Folder" expr="[Sub Folder]" /></inputs><outputs><output type="collection" name="Items" stage="Items" /><output type="number" name="Item Count" stage="Item Count" /></outputs><onsuccess>d4455028-cbab-4966-b564-71ab53bf6bbb</onsuccess><code><![CDATA[

Dim app = CreateObject("Outlook.Application")
Dim _nameSpace = app.GetNameSpace("MAPI")

Dim folder = _nameSpace.GetDefaultFolder(Outlook_Folder_ID)

If Sub_Folder <> "" Then
	For each name as string in Sub_Folder.Split("\")
	folder = folder.Folders(name)
	Next
End If

'See https://msdn.microsoft.com/en-us/library/office/aa210946(v=office.11).aspx
'for mail item properties
Dim dataTable As New Data.DataTable
dataTable.Columns.Add("EntryID", Type.GetType("System.String"))
dataTable.Columns.Add("To", Type.GetType("System.String"))
dataTable.Columns.Add("CC", Type.GetType("System.String"))
dataTable.Columns.Add("Subject", Type.GetType("System.String"))
dataTable.Columns.Add("Body", Type.GetType("System.String"))
dataTable.Columns.Add("Attachments", Type.GetType("System.String"))
dataTable.Columns.Add("ReceivedOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SentOn", Type.GetType("System.DateTime"))
dataTable.Columns.Add("SenderName", Type.GetType("System.String"))
dataTable.Columns.Add("SenderEmailAddress", Type.GetType("System.String"))
dataTable.Columns.Add("Unread", Type.GetType("System.Boolean"))

Dim folderItems = If(Filter_Expression <> "", folder.Items.Restrict(Filter_Expression), folder.Items)

For Each item As Object In folderItems
	If Not TypeOf item Is MailItem Then Continue For
	Dim row As Data.DataRow = dataTable.NewRow
	row("EntryID") = item.EntryID
	row("To") = item.To
	row("CC") = item.CC
	row("Subject") = item.Subject
	row("Body") = item.Body
	
	Dim attachments As String = ""
	For Each attachment As Object In item.Attachments
        If attachment.Type = 1 Then
			attachments = attachments & "|" & attachment.DisplayName
		End If
	Next
	
	row("Attachments") = If (attachments.Length = 0, "", attachments.SubString(1))
	row("SentOn") = item.SentOn
	row("ReceivedOn") = item.ReceivedTime
	row("SenderName") = item.SenderName
	'row("SenderEmailAddress") = If (item.SenderEmailType = "EX",item.Sender.GetExchangeUser.PrimarySmtpAddress,item.SenderEmailAddress)
	row("SenderEmailAddress") = If (item.SenderEmailType = "EX",if(item.Sender.AddressEntryUserType = OlAddressEntryUserType.olExchangeDistributionListAddressEntry,item.Sender.GetExchangeDistributionList.PrimarySmtpAddress,item.Sender.GetExchangeUser.PrimarySmtpAddress),item.SenderEmailAddress)
	row("Unread") = item.Unread
	dataTable.Rows.Add(row)
	Item_Count += 1
Next
Items = dataTable]]></code></stage><stage stageid="839beed0-50c3-45fb-884e-2fb5b9b4fa27" name="Item Count" type="Data"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><display x="-195" y="180" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="38038faa-59bf-4412-a5bd-98a0585064a4" name="Filter Expression" type="Data"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><display x="-195" y="-15" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ef8af4f5-bdd3-4477-b5eb-a224a59632c1" name="Outlook Folder ID" type="Data"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="15" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="8f33adfc-b78a-48c5-b51d-93eb19bf9f91" name="Sub Folder" type="Data"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><display x="-195" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ff008d4e-6375-47cc-bf3c-225ea5c9adeb" name="Items" type="Collection"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><display x="-195" y="135" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="EntryID" type="text" description="The mail ID. NB this is different from the Mapiex ID." /><field name="To" type="text" description="The display name of the recipient(s)" /><field name="CC" type="text" description="The display name of the copied recipient(s)" /><field name="Subject" type="text" description="The mail subject line" /><field name="Body" type="text" description="The mail message" /><field name="Attachments" type="text" description="The names of the attachements as a CSV string" /><field name="ReceivedOn" type="datetime" description="The date an incoming mail was received" /><field name="SentOn" type="datetime" description="The date an outgoing mail was sent" /><field name="SenderName" type="text" description="The display name of the sender" /><field name="SenderEmailAddress" type="text" description="The email of the sender" /><field name="Unread" type="flag" description="True if an incoming mail has not been read, otherwise False" /></collectioninfo></stage><stage stageid="7c7848b5-b331-4c02-ade5-a1b0a2999c42" name="Note2" type="Note"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><narrative>NOT FOR PUBLICATION</narrative><display x="15" y="-135" w="150" h="30" /><font family="Segoe UI" size="20" style="Regular" color="FF0000" /></stage><stage stageid="8933f990-59c6-4079-910a-a7c560bdef4d" name="Input" type="Block"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><display x="-270" y="-45" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="d8739fa1-9e68-4284-a215-fe4384e6678a" name="Output" type="Block"><subsheetid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</subsheetid><loginhibit /><display x="-270" y="90" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="d8dd4a0d-61da-481f-ba1f-152ec85c785b" name="Get Received Items (Basic) - Distribution list" type="SubSheetInfo"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><narrative>Lists Inbox items matching the parameters provided. Kindly note this is different from Normal Inbox and Shared Mailbox as well. For more info, please refer https://community.blueprism.com/communities/community-home/digestviewer/viewthread?MessageKey=4ed2e33d-10f7-4ef0-b375-57828183b770&amp;CommunityKey=d8a0860f-1370-4a8d-a272-ad61dbc9b3f3&amp;tab=digestviewer</narrative><display x="-390" y="-75" w="150" h="210" /></stage><stage stageid="6e3cb22a-a83b-4f52-a244-6fed6443c2c9" name="Item Count" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="165" w="150" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d86fdf76-03af-41e4-a4bc-7880674aaa71" name="Internal_Get Items" type="SubSheet"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="420" /><inputs><input type="text" name="Filter Expression" friendlyname="Filter Expression" narrative="Mandatory. A MAPI filter, eg [From]='Mike Colleague' AND [unread] = True" expr="[Filter Expression]" /><input type="text" name="Sub Folder" friendlyname="Sub Folder" narrative="Optional, default blank. The inbox sub folder to look in." expr="[Sub Folder]" /></inputs><outputs><output type="collection" name="Items" friendlyname="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" friendlyname="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs><onsuccess>2adcbee2-6d15-44b2-b93d-eddc97cc9102</onsuccess><processid>7cd881fc-67d8-4cd0-a9af-b1c8a17d00d2</processid></stage><stage stageid="7c9730fc-9fab-4760-b427-640064070453" name="Outlook Folder ID" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><narrative>Google OlDefaultFolders Enumeration, 6 = Inbox, 5 = Sent</narrative><display x="-195" y="-60" w="150" h="30" /><datatype>number</datatype><initialvalue>6</initialvalue><private /><alwaysinit /></stage><stage stageid="32735c13-f840-4c03-9e53-d107e4930c41" name="Sub Folder" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2adcbee2-6d15-44b2-b93d-eddc97cc9102" name="End" type="End"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="480" /><outputs><output type="collection" name="Items" narrative="Details of items matching the filter" stage="Items" /><output type="number" name="Item Count" narrative="Number of items matching the filter" stage="Item Count" /></outputs></stage><stage stageid="da650fa5-76d9-450f-b18e-9f7d63283203" name="Subject" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="240" y="45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="45e24daf-5073-4293-be6e-251b4f72fef9" name="Start" type="Start"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Sender Name" narrative="Optional. The From display name, which might be a name (eg John Smith) or email address (eg admin@client.com). Asterisk wildcard permitted, eg *John Smith* for any mail where the text 'John Smith' appears in the From field." stage="Sender Name" /><input type="text" name="Sender Email" narrative="Optional. The sender email address." stage="Sender Email" /><input type="datetime" name="Received Earliest" narrative="Optional. The earliest date to search from." stage="Received Earliest" /><input type="datetime" name="Received Latest" narrative="Optional. The latest date to search to." stage="Received Latest" /><input type="text" name="Subject" narrative="Optional. Asterisk wildcard permitted, eg *Project Update for 'Project Update', 'RE: Project Update' etc." stage="Subject" /><input type="text" name="Message" narrative="Optional. Asterisk wildcard permitted, eg *Blue Prism*" stage="Message" /><input type="flag" name="Include Read" narrative="Optional, default True" stage="Include Read" /><input type="flag" name="Include Unread" narrative="Optional, default True" stage="Include Unread" /><input type="text" name="Sub Folder" narrative="Optional. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." stage="Sub Folder" /></inputs><onsuccess>53a9f753-b722-499b-8998-4fd36d5d0a7e</onsuccess></stage><stage stageid="d1893793-8e69-4519-a9ec-7a4af58552d6" name="Received Earliest" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="240" y="135" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="92f98c8b-8182-4509-9534-b903097b887d" name="Received Latest" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="240" y="180" w="150" h="30" /><datatype>datetime</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7c0ef98d-bd12-40c6-9045-046d3aed7db3" name="Filter Expression" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="53a9f753-b722-499b-8998-4fd36d5d0a7e" name="Sender Name?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="-45" /><decision expression="[Sender Name]&lt;&gt;&quot;&quot;" /><ontrue>e47d4f1b-326b-4f66-a40d-68f6734e0204</ontrue><onfalse>fbee4f53-976a-4d2c-af65-dadccca62eb2</onfalse></stage><stage stageid="e47d4f1b-326b-4f66-a40d-68f6734e0204" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="-45" /><onsuccess>fbee4f53-976a-4d2c-af65-dadccca62eb2</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:sendername LIKE '&quot;&amp;Replace([Sender Name], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="8159ef2a-ccc8-47d1-810b-483bf270df82" name="Clean Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="330" /><onsuccess>1e62eb73-5274-402f-8d67-b945c194b705</onsuccess><calculation expression="Trim(Mid([Filter Expression], 6, Len([Filter Expression])))" stage="Filter Expression" /></stage><stage stageid="0e53eb36-cb9f-4f66-92c3-45f9d934a0a5" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="45" /><onsuccess>f62650d9-2b17-4380-99e4-4b83bde82a7d</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:subject LIKE '&quot;&amp;Replace([Subject], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="9547f27b-85a8-43a9-8693-0c3e101bfae7" name="Subject?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="45" /><decision expression="[Subject]&lt;&gt;&quot;&quot;" /><ontrue>0e53eb36-cb9f-4f66-92c3-45f9d934a0a5</ontrue><onfalse>f62650d9-2b17-4380-99e4-4b83bde82a7d</onfalse></stage><stage stageid="fbee4f53-976a-4d2c-af65-dadccca62eb2" name="Sender Email?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="0" /><decision expression="[Sender Email]&lt;&gt;&quot;&quot;" /><ontrue>528c28e3-7bf3-4352-8a0e-46e7b83d3807</ontrue><onfalse>9547f27b-85a8-43a9-8693-0c3e101bfae7</onfalse></stage><stage stageid="528c28e3-7bf3-4352-8a0e-46e7b83d3807" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="0" /><onsuccess>9547f27b-85a8-43a9-8693-0c3e101bfae7</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:senderemail LIKE '&quot;&amp;Replace([Sender Email], &quot;*&quot;, &quot;%&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="1cf76b46-48a1-4ea6-ab9f-61dfd0ade1ee" name="Sender Name" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="240" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="513e23f0-7db4-44bf-89b6-2f5d34960992" name="Sender Email" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="240" y="0" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1e62eb73-5274-402f-8d67-b945c194b705" name="Filter Expression?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="375" /><decision expression="[Filter Expression]&lt;&gt;&quot;&quot;" /><ontrue>e8460236-d3b0-4a63-9b75-f659c7ba2b20</ontrue><onfalse>d86fdf76-03af-41e4-a4bc-7880674aaa71</onfalse></stage><stage stageid="e8460236-d3b0-4a63-9b75-f659c7ba2b20" name="Prepend" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="375" /><onsuccess>d86fdf76-03af-41e4-a4bc-7880674aaa71</onsuccess><calculation expression="&quot;@SQL=&quot;&amp;[Filter Expression]" stage="Filter Expression" /></stage><stage stageid="cdf0e245-4850-4c39-a943-2b4fe893e895" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="270" /><onsuccess>8159ef2a-ccc8-47d1-810b-483bf270df82</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=0&quot;" stage="Filter Expression" /></stage><stage stageid="7507347f-2c7b-42f6-888a-5901ee3414ef" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="135" /><onsuccess>54ee64ba-95ed-4582-a609-39f3fa06a4a8</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&gt;='&quot; &amp; FormatDateTime([Received Earliest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="dd27e481-3154-4fb3-a827-95150c2f8374" name="Earliest?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="135" /><decision expression="IsDate([Received Earliest])" /><ontrue>7507347f-2c7b-42f6-888a-5901ee3414ef</ontrue><onfalse>54ee64ba-95ed-4582-a609-39f3fa06a4a8</onfalse></stage><stage stageid="54ee64ba-95ed-4582-a609-39f3fa06a4a8" name="Latest" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="180" /><decision expression="IsDate([Received Latest])" /><ontrue>0ce12902-05fe-48bd-872d-1f9dbfffff14</ontrue><onfalse>72a8e2a2-95dc-446b-bc86-22f6f723df09</onfalse></stage><stage stageid="0ce12902-05fe-48bd-872d-1f9dbfffff14" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="180" /><onsuccess>72a8e2a2-95dc-446b-bc86-22f6f723df09</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:datereceived&lt;='&quot; &amp; FormatDateTime([Received Latest], &quot;dd MMMM yyyy HH:mm&quot;)&amp;&quot;'&quot;" stage="Filter Expression" /></stage><stage stageid="14988131-7174-4072-906e-98af2bbbe113" name="Include Unread" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="0" w="150" h="30" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="c2484d4d-7790-4552-97bf-0892e703d933" name="Include Read" type="Data"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="-30" w="150" h="30" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="72a8e2a2-95dc-446b-bc86-22f6f723df09" name="Unread Only?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="15" y="225" /><decision expression="[Include Unread]=True AND [Include Read]=False" /><ontrue>cdf0e245-4850-4c39-a943-2b4fe893e895</ontrue><onfalse>2a3161a6-6559-4c37-8776-11d3eb1564ae</onfalse></stage><stage stageid="2a3161a6-6559-4c37-8776-11d3eb1564ae" name="Read Only?" type="Decision"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="225" /><decision expression="[Include Read]=True AND [Include Unread]=False" /><ontrue>db30727d-e4d4-460b-acd0-2eb5de7dbc09</ontrue><onfalse>ba4bef55-19f4-48e8-ae9f-268c8b931f95</onfalse></stage><stage stageid="db30727d-e4d4-460b-acd0-2eb5de7dbc09" name="Filter Expression" type="Calculation"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="270" /><onsuccess>85f69312-9f36-4e13-8a20-e6ec5d10a28d</onsuccess><calculation expression="[Filter Expression]&amp;&quot; AND urn:schemas:httpmail:read=1&quot;" stage="Filter Expression" /></stage><stage stageid="ba4bef55-19f4-48e8-ae9f-268c8b931f95" name="Anchor1" type="Anchor"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="150" y="225" w="10" h="10" /><onsuccess>d1479989-569a-4b5a-b87b-eadc58ef5ebd</onsuccess></stage><stage stageid="d1479989-569a-4b5a-b87b-eadc58ef5ebd" name="Anchor1" type="Anchor"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="150" y="330" w="10" h="10" /><onsuccess>85f69312-9f36-4e13-8a20-e6ec5d10a28d</onsuccess></stage><stage stageid="85f69312-9f36-4e13-8a20-e6ec5d10a28d" name="Anchor1" type="Anchor"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><loginhibit /><display x="90" y="330" w="10" h="10" /><onsuccess>8159ef2a-ccc8-47d1-810b-483bf270df82</onsuccess></stage><stage stageid="772bdb6d-8509-407d-86a6-5cab7528b6f3" name="Items" type="Collection"><subsheetid>b2a39800-8f3f-40b6-8b26-97a2fe88dcdb</subsheetid><display x="-195" y="120" w="150" h="60" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field n