get latest files" stage="AddSeconds" /><input type="text" name="Current Date and Time" narrative="Current Date and Time to get latest files" stage="Current Date and Time" /><input type="text" name="Script_Loc" narrative="Location of the script to be generated" stage="Script_Loc" /></inputs><onsuccess>417f0903-d2cf-452a-aff8-8a4614d86fdb</onsuccess></stage><stage stageid="40f418d4-35a5-4d02-b23c-98b877b50506" name="Get All Filter Excel Files - DO NOT USE" type="SubSheetInfo"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><narrative>Get All Filter Excel Files From Sarepoint through API's </narrative><display x="-495" y="-315" w="150" h="90" /></stage><stage stageid="de306c5a-9b36-42fd-9966-82964917a6d6" name="Start" type="Start"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><loginhibit /><display x="330" y="-285" /><inputs><input type="text" name="SharePoint URL" narrative="Get SharePoint URL From Config File" stage="SharePoint URL" /><input type="text" name="Folder Name" narrative="Get Folder Name From Config File" stage="Folder Name" /><input type="text" name="Sub Folder Name" narrative="Get Sub Folder Name From Config File" stage="Sub Folder Name" /><input type="text" name="Script Path" narrative="Get Script Path From Config File" stage="Script_Loc" /><input type="text" name="Excel Name" narrative="Get Excel Name From Config File" stage="Excel Name" /><input type="text" name="Destination All Filter Files Folder Path" narrative="Get Destination All Filter Files Folder Path From Config File" stage="Destination All Filter Files Folder Path" /><input type="text" name="Application_Path" narrative="Get Application_Path From Config File" stage="Application_Path" /><input type="text" name="ScriptName" narrative="Get ScriptName From Config File" stage="ScriptName" /></inputs><onsuccess>0e076c53-e22d-4194-b245-6e5fc5d5a61a</onsuccess></stage><stage stageid="66040c94-a648-4b50-b0f9-061c6f380f5f" name="Return Message" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="-300" y="210" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c6e3eda-df8f-4983-9298-0a00244ae3d6" name="Generate Script" type="Calculation"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><loginhibit /><display x="330" y="-90" /><onsuccess>a448c24f-c2c6-4cab-9a43-7b881ebc5dfb</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url '&quot;&amp;[SharePoint URL]&amp;&quot;'&quot;&amp;&#xA;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine()&amp;&#xA;&quot;$results = @()&quot;&amp;NewLine()&amp;&quot;&#xA;$ExportFile = &quot;&quot;&quot;&amp;[Destination All Filter Files Folder Path]&amp;&quot;&quot;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;$now= Get-Date| ForEach-Object AddYears -1&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = Get-Date&quot;&amp;NewLine()&amp;&quot;&#xA; $allItems = Get-PnPListItem -List &quot;&quot;&quot;&amp;[Folder Name]&amp;&quot;\&quot;&amp;[Sub Folder Name]&amp;&quot;&quot;&quot; -PageSize 500 &quot;&amp;NewLine()&amp;&quot;    &#xA;    foreach($item in $allItems){&quot;&amp;NewLine()&amp;&quot;&#xA;    if ($item[&quot;&quot;FileLeafRef&quot;&quot;] -like &quot;&amp;[Excel Name]&amp;&quot; -and ([DateTime]$item[&quot;&quot;Modified&quot;&quot;] -gt $now -And [DateTime]$item[&quot;&quot;Modified&quot;&quot;] -lt $currentDt)) &quot;&amp;NewLine()&amp;&quot;&#xA;    {&quot;&amp;NewLine()&amp;&quot;&#xA;        $results += [PSCustomObject][ordered]@{&quot;&amp;NewLine()&amp;&quot;&#xA;            Name = $item[&quot;&quot;FileLeafRef&quot;&quot;] &quot;&amp;NewLine()&amp;&quot;&#xA;            ModifiedDate = [DateTime]$item[&quot;&quot;Modified&quot;&quot;]&quot;&amp;NewLine()&amp;&quot;            &#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;        }&quot;&amp;NewLine()&amp;&quot;&#xA;    }&quot;&amp;NewLine()&amp;&quot;&#xA;$results&quot;&amp;NewLine()&amp;&quot;&#xA;$results | Select Name, ModifiedDate | ConvertTo-Csv -NoTypeInformation | Select-Object -Skip 1 |Set-Content -Path $ExportFile &quot;" stage="Script" /></stage><stage stageid="3532b652-0333-42ea-ae6e-1879939218a9" name="Script" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="-300" y="90" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="66de31b7-23f0-417f-92ed-2b59279a5ba1" name="Success" type="Data"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><display x="-300" y="165" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bd503235-cce1-466e-95e2-9129b8292e65" name="Standards" type="Note"><subsheetid>338cd198-c4bf-462f-b6de-0f8d892068fc</subsheetid><loginhibit /><narrative>SharePointSubsite Path : https://eu001-sp.shell.com/sites/AAAAA2508/AnTCC

