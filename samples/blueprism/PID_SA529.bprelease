e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="345" y="90" /><onsuccess>8b1699f4-913b-4f9d-914c-86d319df7540</onsuccess></stage><stage stageid="4a0c4123-09fc-4bc1-b7e2-953d70a34d79" name="Unexpected Exception" type="Exception"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><display x="465" y="180" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="07394396-e341-4356-a2df-eb14a067cb22" name="Find_ListItem in SharePoint" type="SubSheetInfo"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Helps to Find List Item in SharePoint Library. Searches for item by provided column</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="24a38c66-f65d-4852-8772-b7dab0782fa4" name="Start" type="Start"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-255" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder)" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Share thele to be searched. (Ex:- APIdoc.docx)" stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search for" stage="Find_Item_By" /><input type="flag" name="Is Case Sensitive" narrative="Default value is False. Mark it as true to have a CaseSensitive search" stage="Case_Sensitive" /></inputs><onsuccess>dce416ef-861c-48ef-9d95-118dc1cf1d43</onsuccess></stage><stage stageid="35ede6a1-4364-4288-a1d6-fb4e2aa896ce" name="End" type="End"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="540" /><outputs><output type="flag" name="List Item Found" narrative="Returns True if List item is in provided list" stage="Found" /><output type="text" name="Result" narrative="Item found details" stage="Run Report" /></outputs></stage><stage stageid="0fc6fcd7-bc45-4b8f-8db6-aee0bf35c5ae" name="Build Script" type="Calculation"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-105" /><onsuccess>de13ca19-f82c-43e0-abc9-e757264fde0e</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;  NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize 5000&quot; &amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot;Write-Host $item['ID'] $item['Title'] $item['&quot; &amp; [Find_Item_By] &amp; &quot;'] &#xA;&quot; &amp; NewLine() &amp; &quot;Exit &quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot;NOT FOUND&quot; &amp; Chr(34)&#xA;" stage="Script" /></stage><stage stageid="a05dd916-9ae6-484f-b817-25ceef804bd7" name="Run PnP_Script" type="SubSheet"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>5c4ba2f9-fdcd-436d-8596-b1cbec6e1d53</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="dbe1eab4-3d16-4359-b8ae-c3ff99b664f0" name="Delete_Script" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3b79d6db-43ed-4487-baea-edfcc782db57</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="de13ca19-f82c-43e0-abc9-e757264fde0e" name="Generate_PnPScript" type="SubSheet"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Find&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>a790050a-c98d-4f43-be5b-11977b7eef90</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="a790050a-c98d-4f43-be5b-11977b7eef90" name="Check_Error" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="-15" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>3bc90576-f1e4-47fc-ae43-89cac72d6a81</ontrue><onfalse>a05dd916-9ae6-484f-b817-25ceef804bd7</onfalse></stage><stage stageid="3bc90576-f1e4-47fc-ae43-89cac72d6a81" name="Exception while creating  Script" type="Exception"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="210" y="-15" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="082f05a8-fbf9-47a5-9934-12568db4cce9" name="Check Process_Exist" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>041f92a9-9fa7-4988-89be-82303082f606</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="041f92a9-9fa7-4988-89be-82303082f606" name="ProcessExist?" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="195" /><decision expression="[P_Exists]=True" /><ontrue>d5d80b3d-5ff3-4937-8050-d6e10911a428</ontrue><onfalse>fa7bafcb-907e-4714-a80e-1941c481a03b</onfalse></stage><stage stageid="fa7bafcb-907e-4714-a80e-1941c481a03b" name="Anchor8" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="195" w="10" h="10" /><onsuccess>629ac1b2-49c1-4e22-895d-6a7a22cdad00</onsuccess></stage><stage stageid="d5d80b3d-5ff3-4937-8050-d6e10911a428" name="Kill Process" type="Action"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>dbe1eab4-3d16-4359-b8ae-c3ff99b664f0</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="629ac1b2-49c1-4e22-895d-6a7a22cdad00" name="Anchor9" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="300" w="10" h="10" /><onsuccess>dbe1eab4-3d16-4359-b8ae-c3ff99b664f0</onsuccess></stage><stage stageid="63c9cc5e-1871-4569-ac1d-30afc6b7f6be" name="SP_Site_URL" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-240" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2fbfd208-0ed6-487d-9e81-5e24ac810cb3" name="SP_Target_List" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="284d5307-c3b9-4190-b89a-e059ce2a4f4e" name="Item_To_Find" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>List item to retrieve</narrative><display x="-210" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="40886dc7-172a-4854-af05-ec44fa645de8" name="Input" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-270" y="-45" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="1e18e6f1-fe74-47ec-a89d-7a73464b14d7" name="Output" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-270" y="105" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e8273f32-0a67-48ec-8029-768c8bee0afb" name="Inhouse" type="Block"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-450" y="-45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7da4fbb6-b9a6-4ffa-82fa-901cd482484a" name="Script" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-420" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c7e65bfe-c738-4262-9d63-77a751d69ad4" name="Return Message" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-405" y="90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bb18e513-509b-47ab-b901-c6d28207a554" name="Script Path" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-405" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="435a6586-6842-4128-8f96-3dc39c9dbc79" name="Error_Message" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-210" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="06d4f65b-ceb9-4c96-8460-bb3e43b62ca9" name="Run Report" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b4cf6cc7-822e-45fa-9a55-25a7a6de3b74" name="P_Exists" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Process exist or not</narrative><display x="-405" y="180" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="25229ff3-f5a4-4979-abca-89f8e4304f52" name="Standards" type="Note"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><narrative>Find_Item_By: Column to be search at

Item_To_Find: Item to search for by provided column name from the supplied list

Share_Target_List: The name of the list where the item needs to be checked against

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

************************************************************************************************
Considering to search "Something" in  list "https://eu001-sp.shell.com/sites/AAAAA3201/ListName".</narrative><display x="-420" y="-135" w="300" h="150" /></stage><stage stageid="970ffc2f-60e6-4422-aeba-5258a5410c97" name="Unexpected exception recover" type="Recover"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="450" y="-120" /><onsuccess>64c81a00-1b29-449d-9df9-b22ed0cde5d8</onsuccess></stage><stage stageid="40f60ce7-4ecb-4719-ac1b-b7701043b413" name="Unexpected Exception" type="Exception"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="525" y="-15" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="bd282adc-5793-48f8-90a6-0459834accd9" name="Script_Location" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-165" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="901c402a-fc7c-41c4-8495-112a610a11c3" name="Found" type="Data"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="-225" y="240" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="786e6fd0-8898-41f6-b81e-8046fc10681d" name="Check if found" type="Decision"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="450" /><decision expression="InStr(Trim(Lower([Run Report])), Trim(Lower([Item_To_Find])))&gt;0" /><ontrue>ec1ab617-8df1-45b5-a479-1e7c51a4ab02</ontrue><onfalse>8b8a8235-2706-4535-8399-d3966d80f136</onfalse></stage><stage stageid="ec1ab617-8df1-45b5-a479-1e7c51a4ab02" name="Assign True to Found" type="Calculation"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="15" y="495" /><onsuccess>35ede6a1-4364-4288-a1d6-fb4e2aa896ce</onsuccess><calculation expression="True" stage="Found" /></stage><stage stageid="8b8a8235-2706-4535-8399-d3966d80f136" name="Anchor14" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="450" w="10" h="10" /><onsuccess>2f8be2e1-8a10-43e2-8650-1f37734ec5cf</onsuccess></stage><stage stageid="2f8be2e1-8a10-43e2-8650-1f37734ec5cf" name="Anchor15" type="Anchor"><subsheetid>0fd43286-93d2-4525-94ae-53f38f00febe</subsheetid><display x="120" y="540" w="10" h="10" /><onsuccess>35ede6a1-4364-4288-a1d6-fb4e2aa896ce</onsuccess></stage><stage stageid="24dad516-ca24-4bd5-b0cb-404000daca07" name="Note3" type="Note"><subsheetid>d343646e-e566-4e81-b7aa-da4fb65ae553</subsheetid><narrative>FilePath: C:\Apps\Test.xlsx


