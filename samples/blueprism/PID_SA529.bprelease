ccess>374e2362-1e89-44b3-b216-bf49c5009c56</onsuccess><processid>fe0cf63f-9dc6-4f40-a487-34b9e6ecafd8</processid></stage><stage stageid="bdbdb4e6-4430-4fe7-ad88-bce235471a55" name="Get Access Token" type="SubSheet"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><loginhibit /><display x="-165" y="-435" /><onsuccess>9683be13-25a3-48a2-b43e-78a14a3ac81f</onsuccess><processid>fe0cf63f-9dc6-4f40-a487-34b9e6ecafd8</processid></stage><stage stageid="cbf7bff2-d00a-45a3-8192-2f60d5e4cb6f" name="Get All File Name And Path From List" type="SubSheetInfo"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><narrative>Help to Download File from Sharepoint.</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="79e82943-b92f-44d5-baf2-ba22b88c9e5d" name="Return Message" type="Data"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-420" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3fbb80b6-4762-4b4f-896e-fb643173dc3b" name="Script" type="Data"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-600" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="965607d3-ef21-4775-a5b0-8bc4362901c2" name="SP_Site_URL" type="Data"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-420" y="-90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f7ca3e34-0309-457a-9510-3e8683bcc6c0" name="Standards" type="Note"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><narrative>Dest_Directory: destination directory where the file will be downloadedC:\Apps

Create_Dir:- To check if Directory is not there whether to create or not.

Share_Lib_File_Path: Includes Library and sub folder ( Example:- Documents/FO/Data/Test.xlsx)

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

************************************************************************************************
Considering the file from "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data/Test.xlsx" to be downloaded to "C:\Apps"
</narrative><display x="-525" y="-285" w="300" h="150" /></stage><stage stageid="8325a0d2-0bfc-4fcc-bfbb-2cd9252e1f33" name="Unexpected exception recover" type="Recover"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-255" y="390" /><onsuccess>f7f0c1aa-5a28-4302-94ed-06a56775a11a</onsuccess></stage><stage stageid="7a596e91-d1e6-4cde-9be7-d86749db937e" name="Unexpected Exception" type="Exception"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-420" y="435" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="8d717019-c980-449c-8a6b-c207ab3b2061" name="IsDirExist" type="Data"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-600" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fbbd1fc4-bb6b-447f-8e4d-9c3c69b3031d" name="Script Path" type="Data"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-600" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2a3f72ef-19a6-4fd9-850f-e83b8d47cb25" name="Start" type="Start"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-165" y="-600" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="ScriptLocation" /><input type="text" name="SourceName" narrative="SourceName" stage="SourceName" /><input type="text" name="Output_TxtFilePath" narrative="Output_TxtFilePath" stage="Output_TxtFilePath" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>2a2c933f-2c07-44b9-9a93-ca37f872d078</onsuccess></stage><stage stageid="ba391cd6-b67b-46c8-b60d-f7c22a436703" name="End" type="End"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-165" y="450" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="7049851a-0e47-42a6-8253-a00b9bc4c485" name="Build Script" type="Calculation"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-165" y="-450" /><onsuccess>3cce3fb6-1a57-4641-a242-dede872b138e</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine()&amp; &quot;$outputfile= &quot;&amp;Chr(34)&amp;[Output_TxtFilePath]&amp;Chr(34)&amp;NewLine()&amp;&quot;$SourceName= &quot;&amp;Chr(34)&amp;[SourceName]&amp;Chr(34)&amp;NewLine()&amp;&quot; if (Test-Path $outputfile -PathType Leaf){ Remove-Item $outputfile -Force }&quot;&amp;NewLine()&amp;&quot;Else{ New-Item $outputfile -ItemType File -ErrorAction stop }&quot;&amp;NewLine()&amp;&quot;Add-Content  $outputfile -Value &quot;&amp;Chr(34)&amp;&quot;File ID__RPA__File Name__RPA__Relative Path&quot;&amp;Chr(34)&amp;NewLine()&amp; &quot;Get-PnPListItem -List $SourceName -Fields(&quot;&amp;Chr(34)&amp;&quot;FSObjType&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;ID&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;FileLeafRef&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;FileDirRef&quot;&amp;Chr(34)&amp;&quot;).FieldValues -PageSize 500 -ScriptBlock { Param($items) foreach($itm in $items) { if($itm.FieldValues[&quot;&amp;Chr(34)&amp;&quot;FSObjType&quot;&amp;Chr(34)&amp;&quot;] -eq &quot;&amp;Chr(34)&amp;&quot;0&quot;&amp;Chr(34)&amp;&quot;){ $str = $itm.FieldValues[&quot;&amp;Chr(34)&amp;&quot;ID&quot;&amp;Chr(34)&amp;&quot;].ToString() + &quot;&amp;Chr(34)&amp;&quot;__RPA__&quot;&amp;Chr(34)&amp;&quot; + $itm.FieldValues[&quot;&amp;Chr(34)&amp;&quot;FileLeafRef&quot;&amp;Chr(34)&amp;&quot;] + &quot;&amp;Chr(34)&amp;&quot;__RPA__&quot;&amp;Chr(34)&amp;&quot; +   $itm.FieldValues[&quot;&amp;Chr(34)&amp;&quot;FileDirRef&quot;&amp;Chr(34)&amp;&quot;] ;  Add-Content  $outputfile $str ;  } } }&quot;&#xA; &#xA;&#xA; &#xA; &#xA; &#xA; &#xA;&#xA;" stage="Script" /></stage><stage stageid="f3b5be3e-f33f-4e54-bf05-6c9648813f8d" name="Run PnP_Script" type="SubSheet"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-165" y="-225" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>229871d7-0f0c-489c-9cdd-23ed5ed17941</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="bfd4fb68-d876-4de2-829d-833ce9530702" name="Delete_Script" type="Action"><subsheetid>01fa7f5b-cc02-43cc-9eb5-11ac73021024</subsheetid><display x="-165" y="210" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessfu