Next

]]></code></stage><stage stageid="99b8ee43-2348-46d2-9bbd-915b779a6320" name="Input_Collection" type="Collection"><subsheetid>4afb1ef8-26d6-4556-8557-80a3020e6855</subsheetid><display x="165" y="-45" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="value" type="text" /></collectioninfo><initialvalue><row><field name="value" type="text" value="* 123 @123.com" /></row><row><field name="value" type="text" value="* how " /></row><row><field name="value" type="text" value="*mno" /></row><row><field name="value" type="text" value="*xyz" /></row></initialvalue></stage><stage stageid="94d3be68-d1e6-45f0-bc86-90dd7fd4ad96" name="Ouput_Collection" type="Collection"><subsheetid>4afb1ef8-26d6-4556-8557-80a3020e6855</subsheetid><display x="165" y="0" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="41bc4c7f-3047-4865-a1d6-b0f76eb6458e" name="Column_Name" type="Data"><subsheetid>4afb1ef8-26d6-4556-8557-80a3020e6855</subsheetid><loginhibit /><display x="165" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9a795589-f2e7-426d-a6a9-936bc673717e" name="Recover" type="Recover"><subsheetid>4afb1ef8-26d6-4556-8557-80a3020e6855</subsheetid><loginhibit /><display x="-345" y="30" /><onsuccess>c3e7a18d-39c9-4f3b-8a01-66d553ff6fb7</onsuccess></stage><stage stageid="c3e7a18d-39c9-4f3b-8a01-66d553ff6fb7" name="Exception" type="Exception"><subsheetid>4afb1ef8-26d6-4556-8557-80a3020e6855</subsheetid><display x="-345" y="135" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="caa25119-f3fb-40a2-b37d-bc64f2ddd21e" name="Trim Collection headers" type="SubSheetInfo"><subsheetid>ad5d5b03-237b-4ea7-a890-6bf642996ffd</subsheetid><narrative>Collection headers with extra trailing spaces are removed from the collection header</narrative><display x="-165" y="-195" w="150" h="90" /><font family="Tahoma" size=