olor" type="SubSheetInfo"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><narrative>applying the filter based on color (RGB values)</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a424cfa2-2b59-4b7d-bce4-171119b407fc" name="Start" type="Start"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Specify the workbook name to be used" stage="Workbook" /><input type="text" name="Worksheet" narrative="Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="default handle value" stage="Handle" /><input type="number" name="Field" narrative="Column number" stage="vField" /><input type="text" name="Reference" narrative="Range - cell reference" stage="Reference" /><input type="number" name="Red value" narrative="0-255" stage="R value" /><input type="number" name="Green value" narrative="0-255" stage="G Value" /><input type="number" name="Blue value" narrative="0-255" stage="B Value" /></inputs><onsuccess>1ea9ab40-9378-4a13-828c-5c4c059319a4</onsuccess></stage><stage stageid="4374c481-3b08-45cd-b943-d8c15ab4f92a" name="End" type="End"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="1ea9ab40-9378-4a13-828c-5c4c059319a4" name="Apply filter - on Cell color" type="Code"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="number" name="vField" expr="[vField]" /><input type="text" name="Reference" expr="[Reference]" /><input type="number" name="R" expr="[R value]" /><input type="number" name="G" expr="[G Value]" /><input type="number" name="B" expr="[B Value]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>d8125d48-c3f7-4b34-8e0c-3269fcdb7600</onsuccess><code><![CDATA[Dim wb,ws,sheet,excel,range As Object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet

sheet.Range(Reference).AutoFilter(Field:=vField, Criteria1:= RGB( R, G,B) , Operator:=8)

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                excel = Nothing
                range = Nothing
End Try
]]></code></stage><stage stageid="def47206-e2f9-4484-8e4e-6b3973faec66" name="Message" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4f9a9cb9-2f13-4fae-b4a3-a3ca1284f5ea" name="Success" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e8dce2ee-2d7a-40e7-9f5a-7d06a87ecef6" name="Workbook" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a76ae5d6-02ed-4796-bfa1-a5d1483865b3" name="Handle" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="afeed3de-9ccd-4560-9583-2c1aa2a17987" name="Worksheet" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5712f0e4-b74a-466d-a345-07889b8582bd" name="vField" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="90" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="96f86abf-7837-4df6-a31a-9a60f5f34f07" name="Reference" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a714dd28-21bf-44f5-9397-0c37726ec02d" name="Inputs" type="Block"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-270" y="-30" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="98c0c5de-3148-4f48-a2c5-8a2e105bbb49" name="Stage3" type="Block"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-90" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="cf46c260-5fa8-4aad-89fd-78225f8155d2" name="Throw Exception" type="Exception"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="d8125d48-c3f7-4b34-8e0c-3269fcdb7600" name="Check Success?" type="Decision"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>4374c481-3b08-45cd-b943-d8c15ab4f92a</ontrue><onfalse>cf46c260-5fa8-4aad-89fd-78225f8155d2</onfalse></stage><stage stageid="fabde564-306a-470a-8d8c-1a2b53b8cef2" name="R value" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="150" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="dcd88686-ed26-4f6e-80b3-450925841b21" name="G Value" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="180" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f1b03d8-5978-4395-bee9-781c6c07ca22" name="B Value" type="Data"><subsheetid>8d4f0f7f-7a08-4ed7-b82c-f43e00fcb2be</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="210" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cd7ab4d4-b9a7-429b-b53d-97d0f8777600" name="Get Worksheet as Collection Offset - OBSOLETE" type="SubSheetInfo"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="63302be9-a6d1-4188-be88-24c5a53442ee" name="End" type="End"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><loginhibit /><display x="15" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Data" stage="worksheetcollection" /></outputs></stage><stage stageid="06517ac9-dc20-48bc-a3e3-d8dd1d7d5433" name="handle" type="Data"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="-195" y="0" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="bcee6096-0233-46e5-b848-77c5619bc61d" name="workbookname" type="Data"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="-195" y="45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fac11e98-6f3d-4771-adc1-2cd07ce15202" name="Start" type="Start"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" stage="handle" /><input type="text" name="Workbook Name" stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="StartCell" stage="Start Cell" /><input type="flag" name="Use Header" stage="Use Header" /></inputs><onsuccess>899cfa2c-86ca-4d21-ad44-70b749ae3359</onsuccess></stage><stage stageid="e23757d9-254c-4c43-ae37-82d8e4235240" name="GetWorksheetAsCollectionOffset - OBSOLETE" type="Code"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><loginhibit /><display x="15" y="15" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Start Cell" expr="[Start Cell]" /><input type="flag" name="Use Header" expr="[Use Header]" /></inputs><outputs><output type="collection" name="worksheetcollection" stage="worksheetcollection" /></outputs><onsuccess>63302be9-a6d1-4188-be88-24c5a53442ee</onsuccess><code><![CDATA[
	Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
	ws.Activate()

	Dim cell as Object = ws.Range(Start_Cell)
	Dim r as Object = ws.UsedRange.Offset(cell.row-1,cell.column-1)
	r.Select()
	r.Copy()

	Dim data As String = Clipboard.GetDataObject().GetData(DataFormats.Text, True)
	
	' The data split into rows
	Dim asRows() As String = Split(data, vbCrLf)
	
	Dim table As New DataTable()
	' Set a flag indicating the header row
	Dim isHeaderRow As Boolean = Use_Header
	
	For Each strRow As String In asRows
		If Not String.IsNullOrEmpty(strRow) Then
		
			Dim fields() As String = Split(strRow, vbTab)
			If Not Use_Header Then
				Dim i As Integer
				For Each field As String in fields
					i += 1
					table.Columns.Add("Field" & i)
				Next
			End If
			If isHeaderRow Then
			
				isHeaderRow = False
				For Each field As String in fields
					table.Columns.Add(field)
				Next
				
			Else

				Dim row as DataRow = table.NewRow()
				For i As Integer = 0 To fields.Length - 1
					If i < fields.Length Then
						row(i) = fields(i)
					Else
						row(i) = ""
					End If
				Next I
				table.Rows.Add(row)
				
			End If
				
		End If
		
	Next
	worksheetcollection = table]]></code></stage><stage stageid="899cfa2c-86ca-4d21-ad44-70b749ae3359" name="CheckInstanceAndWorkbook - OBSOLETE" type="SubSheet"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><loginhibit /><display x="15" y="-45" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>e23757d9-254c-4c43-ae37-82d8e4235240</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="6044aeef-c0c7-4936-9fa5-e0170863842d" name="worksheetname" type="Data"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="-195" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9aa52a23-d75b-4514-bc82-e0663ac5a656" name="worksheetcollection" type="Collection"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="225" y="0" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="5d83f00d-2f03-48ad-a2c7-de65d4566d7e" name="Start Cell" type="Data"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="90" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33a31ea9-4999-4015-a054-761d21fc8d5b" name="Use Header" type="Data"><subsheetid>e1df63fa-48ca-4b7f-84e8-a469245a5dbb</subsheetid><display x="165" y="-105" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>True</initialvalue><private /><alwaysinit /></stage><stage stageid="bce4df1c-dba1-4964-b998-f1648742dfee" name="Get Worksheet Range As Collection - Updated" type="SubSheetInfo"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="3b874428-aae0-4f6f-a253-a43ce8f25b6a" name="End" type="End"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><loginhibit /><display x="135" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Data" narrative="The spreadsheet data from the specified range, as a collection" stage="worksheetcollection" /></outputs></stage><stage stageid="f34dca6f-6eb2-47cb-b7ac-e36d19c25f45" name="handle" type="Data"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="-75" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="b1b236b6-57ea-4b70-b68b-e979a3f1c37d" name="workbookname" type="Data"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="-75" y="30" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="070c3fc8-309e-4533-a64b-4fecc800393e" name="Start" type="Start"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><loginhibit /><display x="135" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the number of rows is required. The default of zero indicates the currently active instance." stage="handle" /><input type="text" name="Workbook Name" narrative="The name of the workbook on which the number of rows is required. The default empty text value indicates the currently active workbook on the specified instance." stage="workbookname" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet within the specified workbook which should be written to a collection. The default empty text indicates the currently active worksheet within the specified workbook." stage="worksheetname" /><input type="text" name="StartCell" narrative="The starting cell of the range of interest" stage="Start Cell" /><input type="text" name="EndCell" narrative="The end cell of the range of interest" stage="End Cell" /></inputs><onsuccess>c5ca2712-c200-4900-8f8e-70a9fffb3c2e</onsuccess></stage><stage stageid="1521dd86-b98d-4ade-9dd0-6ee0ba74f9be" name="GetWorksheetRangeAsCollection - Updated" type="Code"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><loginhibit /><display x="135" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbookname" expr="[workbookname]" /><input type="text" name="worksheetname" expr="[worksheetname]" /><input type="text" name="Start Cell" expr="[Start Cell]" /><input type="text" name="End Cell" expr="[End Cell]" /></inputs><outputs><output type="collection" name="worksheetcollection" stage="worksheetcollection" /></outputs><onsuccess>3b874428-aae0-4f6f-a253-a43ce8f25b6a</onsuccess><code><![CDATA[
	Dim ws as Object = GetWorksheet(handle, workbookname, worksheetname)
	Dim r as Object
	r = ws.Range(Start_Cell & ":" & End_Cell)
	r.Select()
	r.Copy()

	Dim data As String = Clipboard.GetDataObject().GetData(DataFormats.Text, True)
	
	' The data split into rows
	Dim asRows() As String = Split(data, vbCrLf)
	
	Dim table As New DataTable()
	' Set a flag indicating the header row
	Dim isHeaderRow As Boolean = True
	
	For Each strRow As String In asRows
		If Not String.IsNullOrEmpty(strRow) Then
		
			Dim fields() As String = Split(strRow, vbTab)
			If isHeaderRow Then
			
				isHeaderRow = False
				For Each field As String in fields
					table.Columns.Add(field)
				Next
				
			Else

				Dim row as DataRow = table.NewRow()
				For i As Integer = 0 To fields.Length - 1
					If i < fields.Length Then
						row(i) = fields(i)
					Else
						row(i) = ""
					End If
				Next I
				table.Rows.Add(row)
				
			End If
				
		End If
		
	Next
	worksheetcollection = table]]></code></stage><stage stageid="c5ca2712-c200-4900-8f8e-70a9fffb3c2e" name="CheckInstanceAndWorkbook - Updated" type="SubSheet"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><loginhibit /><display x="135" y="-60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer representing an Excel instance" expr="[handle]" /><input type="text" name="workbookname" narrative="The name of the workbook to check - &quot;&quot; to indicate the active workbook" expr="[workbookname]" /></inputs><onsuccess>1521dd86-b98d-4ade-9dd0-6ee0ba74f9be</onsuccess><processid>9f7a4a91-68c9-4871-bb65-417e96cc4ad1</processid></stage><stage stageid="46cbda6e-d54c-4f90-b8e3-c7b281afea8a" name="worksheetname" type="Data"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="-75" y="75" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e1b054cc-68cb-435b-bfad-e9b972a71fad" name="worksheetcollection" type="Collection"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="345" y="-15" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="1b8dd9e6-5e4b-4fca-9fa6-33fbf667f35f" name="Start Cell" type="Data"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="210" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="057094d2-be75-4083-8c28-f685ff80ca3b" name="End Cell" type="Data"><subsheetid>cd8d43c9-3f9e-4936-a6b9-4c59a504fa6b</subsheetid><display x="270" y="-120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="164c38b6-ee60-4fbc-b6fb-4c3f993fc984" name="Clear Auto Filter" type="SubSheetInfo"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><narrative>clears auto filter from the sheet if it is enabled</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="3f6693e5-3570-447b-a56b-bd465d53d898" name="Start" type="Start"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-75" /><inputs><input type="text" name="Workbook" narrative="Mandatory : Specify the workbook name to be used" stage="Workbook" /><input type="text" name="Worksheet" narrative="Mandatory : Specify the worksheet name to be used" stage="Worksheet" /><input type="number" name="Handle" narrative="Mandatory : default handle value" stage="Handle" /></inputs><onsuccess>2809716d-2b19-49ff-8d62-4afe730ce925</onsuccess></stage><stage stageid="5f33328e-5b0a-4f23-afa6-54a42918e269" name="End" type="End"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="15" y="60" /></stage><stage stageid="2809716d-2b19-49ff-8d62-4afe730ce925" name="Clear Auto Filter" type="Code"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" w="90" h="30" /><inputs><input type="text" name="Workbook" expr="[Workbook]" /><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Worksheet" expr="[Worksheet]" /></inputs><outputs><output type="text" name="Message" stage="Message" /><output type="flag" name="Success" stage="Success" /></outputs><onsuccess>bdcaa4b5-24f6-41d9-a21d-1198c427c900</onsuccess><code><![CDATA[Dim wb,ws,xlSheet1,xl As Object

Try
GetInstance(handle).DisplayAlerts = false
wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
xl = ws.Application
xlSheet1 = xl.ActiveSheet
If(xlSheet1.AutoFilterMode=True)then
xl.selection.AutoFilter
End If
Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                xl = Nothing
End Try
]]></code></stage><stage stageid="40909424-0b1d-4591-8563-951caf377649" name="Message" type="Data"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5b2556a9-f856-4472-8814-1000b59a3c20" name="Success" type="Data"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="255" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6f92be92-f2b8-4c1b-bebd-7688e780b6ee" name="Workbook" type="Data"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c6f74d05-d510-488f-bc3f-8f7ba5a172c3" name="Handle" type="Data"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6a391bb5-dc8e-467b-b063-118c6825c975" name="Worksheet" type="Data"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="05e8759a-27dc-4889-ab2a-a8850358d62d" name="Inputs" type="Block"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="-270" y="-30" w="150" h="270" /><font family="Segoe UI" size="10" style="Regular" color="00FF00" /></stage><stage stageid="35add189-9ea7-4681-ac4b-28a8cbf2e025" name="Stage3" type="Block"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="210" y="-90" w="90" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="78faa8a4-6cb4-4350-8d3a-13d796e753b2" name="Throw Exception" type="Exception"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="135" y="15" /><exception type="System Exception" detail="[Message]" /></stage><stage stageid="bdcaa4b5-24f6-41d9-a21d-1198c427c900" name="Check Success?" type="Decision"><subsheetid>106c4ab7-2675-43a4-81e2-8bc424a15b2c</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><decision expression="[Success]" /><ontrue>5f33328e-5b0a-4f23-afa6-54a42918e269</ontrue><onfalse>78faa8a4-6cb4-4350-8d3a-13d796e753b2</onfalse></stage><stage stageid="23eeaede-e0f2-4da7-a7ed-be1ee6951a8d" name="Lock Cells" type="SubSheetInfo"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><narrative>Locks cells so it can be protected.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="1ff184a2-0848-4751-8107-f8de375b707e" name="End" type="End"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="cdfc742f-4535-4626-9b5f-c4256842a82b" name="Start" type="Start"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="number" name="Handle" narrative="Excel instance." stage="intHandle" /><input type="text" name="Workbook" narrative="Workbook name." stage="txtWorkbook" /><input type="text" name="Worksheet" narrative="Name of worksheet." stage="txtWorksheetName" /><input type="flag" name="Used Range?" narrative="Set to TRUE if cells will be locked for used range." stage="isUsedRange" /><input type="text" name="Range" narrative="OPTIONAL.  This will be used if used range is set to FALSE." stage="txtRange" /></inputs><onsuccess>ea87e38c-3065-4d8f-b54a-88201dcda547</onsuccess></stage><stage stageid="ea87e38c-3065-4d8f-b54a-88201dcda547" name="Lock Cells" type="Code"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="txtWorkbook" expr="[txtWorkbook]" /><input type="text" name="txtWorksheet" expr="[txtWorksheetName]" /><input type="number" name="intHandle" expr="[intHandle]" /><input type="flag" name="isUsedRange" expr="[isUsedRange]" /><input type="text" name="txtRange" expr="[txtRange]" /></inputs><onsuccess>1ff184a2-0848-4751-8107-f8de375b707e</onsuccess><code><![CDATA[Try
	With GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet)
		.Activate
		If isUsedRange Then
			.UsedRange.Cells.Locked = True
		Else
			.Range(txtRange).Cells.Locked = True
		End If
	End With
Catch ex As Exception
	Throw New Exception("Unable to lock cells in worksheet " + txtWorksheet + ".Exception detail: " + ex.Message)
End Try]]></code></stage><stage stageid="91c574de-2264-44d1-b354-701b18f41383" name="txtWorksheetName" type="Data"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><display x="-195" y="45" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c64bdec-ff1a-445c-a4c8-d48a9e894caf" name="intHandle" type="Data"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><display x="-195" y="-15" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f36a22a5-35ac-4fe9-a498-ea77d6164f1b" name="txtWorkbook" type="Data"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><display x="-195" y="15" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2c904ef6-d4ca-4d1d-b3bd-8759c029d385" name="Input" type="Block"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><loginhibit /><display x="-300" y="-45" w="210" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5c97c040-f108-450f-b226-c6ef9dfb6594" name="txtRange" type="Data"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><display x="-195" y="105" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f6a166c9-fd1c-44b0-8626-82d14f86cb68" name="isUsedRange" type="Data"><subsheetid>21830aba-9e0c-4ce6-a0fd-82f3c8a61456</subsheetid><display x="-195" y="75" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4d1c41ba-0e1b-4dca-96b1-a55573c6cbd4" name="Protect Sheet" type="SubSheetInfo"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><narrative>Protects a worksheet so that it cannot be modified.</narrative><display x="-195" y="-360" w="150" h="90" /></stage><stage stageid="01e9f53f-5b3e-4866-8495-e2992b811922" name="End" type="End"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><loginhibit /><display x="120" y="-75" /></stage><stage stageid="81b60a1c-6038-4e03-b1b5-d49575dc811c" name="Protect Sheet" type="Code"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><loginhibit /><display x="120" y="-180" /><inputs><input type="text" name="txtWorkbook" expr="[txtWorkbook]" /><input type="text" name="txtWorksheet" expr="[txtWorksheetName]" /><input type="number" name="intHandle" expr="[intHandle]" /><input type="text" name="txtPassword" expr="[txtPassword]" /><input type="flag" name="flgDrawingObjects" expr="[flgDrawingObjects]" /><input type="flag" name="flgContents" expr="[flgContents]" /><input type="flag" name="flgScenarios" expr="[flgScenarios]" /><input type="flag" name="flgUserInterface" expr="[flgUserInterface]" /><input type="flag" name="flgAllowFormattingCells" expr="[flgAllowFormattingCells]" /><input type="flag" name="flgAllowFormattingCols" expr="[flgAllowFormattingCols]" /><input type="flag" name="flgAllowFormattingRows" expr="[flgAllowFormattingRows]" /><input type="flag" name="flgAllowInsertingCols" expr="[flgAllowInsertingCols]" /><input type="flag" name="flgAllowInsertingRows" expr="[flgAllowInsertingRows]" /><input type="flag" name="flgAllowHyperlinks" expr="[flgAllowHyperlinks]" /><input type="flag" name="flgAllowDeletingRows" expr="[flgAllowDeletingRows]" /><input type="flag" name="flgAllowDeletingCols" expr="[flgAllowDeletingCols]" /><input type="flag" name="flgAllowSort" expr="[flgAllowSort]" /><input type="flag" name="flgAllowFilter" expr="[flgAllowFilter]" /><input type="flag" name="flgAllowPivot" expr="[flgAllowPivot]" /></inputs><onsuccess>01e9f53f-5b3e-4866-8495-e2992b811922</onsuccess><code><![CDATA[Try
	GetInstance(intHandle).Workbooks(txtWorkbook).Sheets(txtWorksheet).Protect(Password:=txtPassword,DrawingObjects:=flgDrawingObjects, Contents:=flgContents, Scenarios:=flgScenarios, UserInterfaceOnly:=flgUserInterface, AllowFormattingCells:=flgAllowFormattingCells, _
					AllowFormattingColumns:=flgAllowFormattingCols, AllowFormattingRows:=flgAllowFormattingRows, AllowInsertingColumns:=flgAllowInsertingCols, AllowInsertingRows:=flgAllowInsertingRows, AllowInsertingHyperlinks:=flgAllowHyperlinks, _
					AllowDeletingColumns:=flgAllowDeletingCols, AllowDeletingRows:=flgAllowDeletingRows, AllowSorting:=flgAllowSort, AllowFiltering:=flgAllowFilter, AllowUsingPivotTables:=flgAllowPivot)
Catch ex As Exception
	Throw New Exception("Unable to protect worksheet: " + txtWorksheet + ".Exception detail: " + ex.Message)
End Try
]]></code></stage><stage stageid="79ef30a8-009e-4b10-b423-d41d510b25ce" name="txtWorksheetName" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-210" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="55e7cc1a-ebf2-4ed5-b7e2-494e0a9aa285" name="intHandle" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-270" w="180" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e373a602-4144-4d9f-b43c-b2ebd1078aa6" name="txtWorkbook" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-240" w="180" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b90c8636-4f55-4ef9-a327-c901e6e57988" name="Input" type="Block"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><loginhibit /><display x="-300" y="-300" w="210" h="600" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="62e367d0-ab6b-4f11-abb6-35a2f2a8ab3f" name="Start" type="Start"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><loginhibit /><display x="120" y="-270" /><inputs><input type="number" name="Handle" narrative="Excel instance." stage="intHandle" /><input type="text" name="Workbook" narrative="Workbook name." stage="txtWorkbook" /><input type="text" name="Worksheet" narrative="Name of worksheet." stage="txtWorksheetName" /><input type="text" name="Password" narrative="A string that specifies a case-sensitive password for the worksheet or workbook. If this argument is omitted, you can unprotect the worksheet or workbook without using a password. Otherwise, you must specify the password to unprotect the worksheet or workbook. If you forget the password, you cannot unprotect the worksheet or workbook." stage="txtPassword" /><input type="flag" name="DrawingObjects" narrative="True to protect shapes. The default value is True." stage="flgDrawingObjects" /><input type="flag" name="Contents" narrative="True to protect contents. For a chart, this protects the entire chart. For a worksheet, this protects the locked cells. The default value is True." stage="flgContents" /><input type="flag" name="Scenarios" narrative="True to protect scenarios. This argument is valid only for worksheets. The default value is True." stage="flgScenarios" /><input type="flag" name="UserInterfaceOnly" narrative="True to protect the user interface, but not macros. If this argument is omitted, protection applies both to macros and to the user interface." stage="flgUserInterface" /><input type="flag" name="AllowFormattingCells" narrative="True allows the user to format any cell on a protected worksheet. The default value is False." stage="flgAllowFormattingCells" /><input type="flag" name="AllowFormattingColumns" narrative="True allows the user to format any column on a protected worksheet. The default value is False." stage="flgAllowFormattingCols" /><input type="flag" name="AllowFormattingRows" narrative="True allows the user to format any row on a protected worksheet. The default value is False." stage="flgAllowFormattingRows" /><input type="flag" name="AllowInsertingColumns" narrative="True allows the user to insert columns on the protected worksheet. The default value is False." stage="flgAllowInsertingCols" /><input type="flag" name="AllowInsertingRows" narrative="True allows the user to insert rows on the protected worksheet. The default value is False." stage="flgAllowInsertingRows" /><input type="flag" name="AllowInsertingHyperlinks" narrative="True allows the user to insert hyperlinks on the protected worksheet. The default value is False." stage="flgAllowHyperlinks" /><input type="flag" name="AllowDeletingColumnsAllowDeletingRows" narrative="True allows the user to delete columns on the protected worksheet, where every cell in the column to be deleted is unlocked. The default value is False." stage="flgAllowDeletingCols" /><input type="flag" name="AllowDeletingRows" narrative="True allows the user to delete rows on the protected worksheet, where every cell in the row to be deleted is unlocked. The default value is False." stage="flgAllowDeletingRows" /><input type="flag" name="AllowSorting" narrative="True allows the user to sort on the protected worksheet. Every cell in the sort range must be unlocked or unprotected. The default value is False." stage="flgAllowSort" /><input type="flag" name="AllowFiltering" narrative="True allows the user to set filters on the protected worksheet. Users can change filter criteria but can not enable or disable an auto filter. Users can set filters on an existing auto filter. The default value is False." stage="flgAllowFilter" /><input type="flag" name="AllowUsingPivotTables" narrative="True allows the user to use PivotTable reports on the protected worksheet. The default value is False." stage="flgAllowPivot" /></inputs><onsuccess>81b60a1c-6038-4e03-b1b5-d49575dc811c</onsuccess></stage><stage stageid="9f207988-af73-4ea1-acb6-cc8c794815e8" name="flgDrawingObjects" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-180" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c9dadf5-4f35-4aef-95e6-8e54349e9f0c" name="flgAllowDeletingRows" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-30" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bb7e408c-84ab-4a5e-b911-98c38be73be0" name="flgAllowDeletingCols" type="Data"><subsheetid>8eb7fa42-24e0-4104-918d-d9ad3cc954c0</subsheetid><display x="-195" y="-150" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4f539839-d274-4eae-be12-4f8adae8f784" name="flgAllowHyperlinks" type="Data"><subshe