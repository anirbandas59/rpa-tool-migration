nputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d992d434-d56d-45ce-a156-bc8b5d1b4302</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="d535b0aa-c7dd-4705-b0be-6b6b80193be5" name="Anchor9" type="Anchor"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="30" y="435" w="10" h="10" /><onsuccess>d992d434-d56d-45ce-a156-bc8b5d1b4302</onsuccess></stage><stage stageid="ee518d16-1bb6-4b20-8f0a-c839ca8ecba0" name="Unexpected exception recover" type="Recover"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="255" y="180" /><onsuccess>0b310bb7-9465-4813-bab2-f99238d9878e</onsuccess></stage><stage stageid="ccbaf9f3-84b6-429e-91e8-e347875e9684" name="Unexpected Exception" type="Exception"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="405" y="180" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="0b310bb7-9465-4813-bab2-f99238d9878e" name="Delete_Script" type="Action"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="330" y="180" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>ccbaf9f3-84b6-429e-91e8-e347875e9684</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="ff26327b-aa8b-4d3a-ba11-eb3f3669be8d" name="Validate Temp Script Path" type="SubSheet"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-75" y="-15" /><inputs><input type="text" name="Script_Loc" expr="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>d5517a7b-3562-4c03-8aac-17dedce0f150</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="f1da08e0-bf69-4ad2-b0ad-9da947960080" name="Script_Loc" type="Data"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-315" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ce8c22ea-f32c-49be-871e-cb4d99395b1e" name="Script Path" type="Data"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-375" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="71603e2e-2223-4767-bc01-24f5dfee7c08" name="Error_Message" type="Data"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-330" y="435" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9e96e8eb-a83e-482a-9344-75edf99d2ed6" name="If No Errors" type="Decision"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="30" y="180" /><decision expression="Trim([Error_Message]) = &quot;&quot;" /><ontrue>eef98247-b2a8-4bea-8810-b94e74499c45</ontrue><onfalse>7fec4ce5-036d-46de-bf63-c02c93396457</onfalse></stage><stage stageid="eef98247-b2a8-4bea-8810-b94e74499c45" name="Success = True" type="Calculation"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="30" y="225" /><onsuccess>81095294-7a03-4c54-8fe3-49d01851980b</onsuccess><calculation expression="True" stage="Success" /></stage><stage stageid="7fec4ce5-036d-46de-bf63-c02c93396457" name="Success = False" type="Calculation"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="105" y="180" /><onsuccess>7f840138-67b6-4abb-b2bb-3d08caa90cdd</onsuccess><calculation expression="False" stage="Success" /></stage><stage stageid="81095294-7a03-4c54-8fe3-49d01851980b" name="Anchor25" type="Anchor"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="30" y="285" w="10" h="10" /><onsuccess>a3e27aa9-2901-42c6-954c-d48b0869e2ef</onsuccess></stage><stage stageid="7f840138-67b6-4abb-b2bb-3d08caa90cdd" name="Anchor26" type="Anchor"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="105" y="285" w="10" h="10" /><onsuccess>81095294-7a03-4c54-8fe3-49d01851980b</onsuccess></stage><stage stageid="d6486d15-05fc-45c0-b268-796b36c72f7f" name="Exists" type="Data"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-540" y="300" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9d84c7e4-cc61-4858-b009-ed2544204335" name="End" type="End"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-75" y="480" /><outputs><output type="flag" name="Latest Files check Success" narrative="Latest Files check Status" stage="Success" /></outputs></stage><stage stageid="d5517a7b-3562-4c03-8aac-17dedce0f150" name="Generate Script" type="Calculation"><subsheetid>e34112fb-2da7-4562-806b-9475ec665ee3</subsheetid><display x="-75" y="30" /><onsuccess>e57ff7da-23d2-414a-8d5e-78486c167493</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp;Chr(34)&amp;[SharePoint URL]&amp;Chr(34)&amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;&#xA;$files= Get-PnPFolderItem -FolderSiteRelativeUrl '&quot;&amp;[Share_Lib_Folder_Path]&amp;&quot;'&quot;&amp;NewLine()&amp;&quot;&#xA;$now= (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;').AddDays(&quot;&amp;[AddDays]&amp;&quot;).AddHours(&quot;&amp;[AddHours]&amp;&quot;).AddMinutes(&quot;&amp;[AddMinutes]&amp;&quot;).AddSeconds(&quot;&amp;[AddSeconds]&amp;&quot;)&quot;&amp;NewLine()&amp;&quot;&#xA;$currentDt = (get-date '&quot;&amp;[Current Date and Time]&amp;&quot;')&quot;&amp;NewLine()&amp;&quot;&#xA;$files=$files | Sort-Object -Property TimeCreated&quot;&amp;NewLine()&amp;&quot;&#xA;For ($i=0; $i -le $files.Count ; $i++)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;if($files[$i].TimeCreated -gt $now -And $files[$i].TimeCreated -lt $currentDt)&quot;&amp;NewLine()&amp;&quot;&#xA;{&quot;&amp;NewLine()&amp;&quot;&#xA;$Excel = $files[$i].Name +&quot;&amp;Chr(34)&amp;&quot;,&quot;&amp;Chr(34)&amp;&quot;+$files[$i].TimeCreated&quot;&amp;NewLine()&amp;&quot;&#xA;Add-Content &quot;&amp;Chr(34)&amp;[Destination Latest Excel Name Folder Path]&amp;Chr(34)&amp;&quot; $Excel }&quot;&amp;NewLine()&amp;&quot;&#xA;}&quot;" stage="Script" /></stage><stage stageid="cb63487f-8c55-42e5-9100-cbf9f77cd557" name="Start" type="Start"><subsheetid>90b4d6a2-73ff-44aa-aa51-6540c2e5bfee</subsheetid><display x="-45" y="-255" /><inputs><input type="text" name="SharePoint URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SharePoint URL" /><input type="text" name="Share_Lib_Folder_Path" narrative="Folder Path in Sharepoint From Which u want Latest Files" stage="Share_Lib_Folder_Path" /><input type="text" name="Destination Latest Excel Name Folder Path" narrative="Destination Excel File Name Folder Path  (Example:- C:\Apps\Temp\latest.xlsx)" stage="Destination Latest Excel Name Folder Path" /><input type="text" name="AddDays" narrative="AddDays Range From Current Time to get latest files" stage="AddDays" /><input type="text" name="AddHours" narrative="AddHours Range From Current Time to get latest files" stage="AddHours" /><input type="text" name="AddMinutes" narrative="AddMinutes Range From Current Time to get latest files" stage="AddMinutes" /><input type="text" name="AddSeconds" narrative="AddSeconds Range From Current Time to get latest files" stage="AddSeconds" /><input type="text" name="Current Date and Time" narrative="Current Date and Time to get latest files" stage="Current Date and Time" /><input type="text" name="Script_Loc" narrative="Location of the script to be generated" stage="Script_Loc" /></inputs><onsuccess>9cf4afca-79bb-4f27-949c-3afc8b02896f</onsuccess></stage><stage stageid="6281f3d6-bb60-4170-943f-94b0323dd40d" name="Get particular ListItem" type="SubSheetInfo"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><narrative>Gets the specific item from  the list based on the parameter</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="bf45ac99-bf81-451d-96c5-524baf6d0776" name="Start" type="Start"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="-270" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name/Value of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="number" name="Page Size" narrative="(Optional)Specify the page size (Default: 5000)" stage="Page Size" /><input type="text" name="Item_to_be_Retrieved" narrative="Column name to be retrieved from item (eg:ID, Name etc.)" stage="Item_to_be_Retrieved" /></inputs><onsuccess>25cc3cd9-e9da-438e-9777-04599c1ef488</onsuccess></stage><stage stageid="9579c107-1455-48ab-9cb2-738ccaff31c1" name="End" type="End"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Item_ID" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="72d5751a-5473-47b8-b17a-ee860b3294ea" name="Build Script" type="Calculation"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="-105" /><onsuccess>7ecef7a6-1cda-457a-8918-1748c1c42411</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize &quot;&amp;[Page Size]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot;Write-Host $item['&quot;&amp;[Item_to_be_Retrieved]&amp;&quot;'] &quot; &amp; NewLine() &amp; &quot;Exit &quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &quot;Catch {&quot; &amp; NewLine() &amp; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &#xA;&quot; &amp; Chr(34) &amp;&quot;}&quot;" stage="Script" /></stage><stage stageid="8ad303db-5f8a-46a5-a318-12a9df9ab87c" name="Run PnP_Script" type="SubSheet"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>7c43c11c-5abf-42c8-a28c-ffb289209897</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="d1079102-ff10-49ce-8ce9-3d64eb7857fb" name="Delete_Script" type="Action"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>9579c107-1455-48ab-9cb2-738ccaff31c1</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="7ecef7a6-1cda-457a-8918-1748c1c42411" name="Generate_PnPScript" type="SubSheet"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_ListItem_ID&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>b28f8cd1-507b-4334-ab14-855f2a218112</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="b28f8cd1-507b-4334-ab14-855f2a218112" name="Check_Error" type="Decision"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="-15" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>ce118d13-1f15-4ca0-9716-46e2f3a6b5d4</ontrue><onfalse>8ad303db-5f8a-46a5-a318-12a9df9ab87c</onfalse></stage><stage stageid="ce118d13-1f15-4ca0-9716-46e2f3a6b5d4" name="Exception while creating  Script" type="Exception"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="210" y="-15" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="090e5198-cd60-4645-94b3-2a55dbc84fec" name="Check Process_Exist" type="Action"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="150" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>a6790451-6e06-4c74-9fb8-ff19bc3055e1</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="a6790451-6e06-4c74-9fb8-ff19bc3055e1" name="ProcessExist?" type="Decision"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="195" /><decision expression="[P_Exists]=True" /><ontrue>0c161914-5971-4a38-8944-fff3b201c3cf</ontrue><onfalse>19f6ef7e-c2e5-4c35-8d7c-c7dd116a38e9</onfalse></stage><stage stageid="19f6ef7e-c2e5-4c35-8d7c-c7dd116a38e9" name="Anchor8" type="Anchor"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="120" y="195" w="10" h="10" /><onsuccess>a38fc655-7693-4c75-9ed8-9c7ba47ac465</onsuccess></stage><stage stageid="0c161914-5971-4a38-8944-fff3b201c3cf" name="Kill Process" type="Action"><subsheetid>b92e3f31-cda9-4312-9b48-7fb9d0eccbb9</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>d1079102-ff10-49ce-8ce9-3d64eb7857fb</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="a38fc655-7