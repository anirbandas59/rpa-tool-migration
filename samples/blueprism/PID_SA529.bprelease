" y="-105" w="150" h="90" /></stage><stage stageid="85674cc3-b9de-4e30-874e-3da71e8181a7" name="Start" type="Start"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="-315" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_Lib_Folder" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder)" stage="SP_Target_Lib" /><input type="text" name="Search_FileName" narrative="Share thele to be searched. (Ex:- APIdoc.docx)" stage="File_Name" /><input type="text" name="Item Type" narrative="Choose Item Type( All,Folder or File) best fit for your search" stage="File_Type" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>b5302e79-77b2-4392-8340-0658262d9ba7</onsuccess></stage><stage stageid="e3d8a573-7e13-4b03-892f-0489519c31f8" name="End" type="End"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="345" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run details( If Item Found Shares Item Details. Else will be empty)" stage="Run Report" /><output type="text" name="Script_Error_Message" narrative="Returns error/exception details ( On error shares error details)" stage="Error_Message" /></outputs></stage><stage stageid="2e7a2267-5b21-41e4-8ad2-7d243a91e687" name="Build Script" type="Calculation"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="-105" /><onsuccess>3a6b8b9e-51c5-47fd-9972-13dd32451a0b</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &quot;Get-PnPFolderItem -FolderSiteRelativeUrl  &#xA;&quot; &amp; Chr(34) &amp; [SP_Target_Lib] &amp; Chr(34) &amp;  &quot;-ItemName &quot; &amp; Chr(34) &amp; [File_Name] &amp; Chr(34) &amp;  &quot;-ItemType &quot; &amp; Chr(34) &amp; [File_Type] &amp; Chr(34)&#xA;&#xA;" stage="Script" /></stage><stage stageid="fff232fc-fc23-4801-9fff-bca91f11b819" name="Run PnP_Script" type="SubSheet"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>75e180da-f71a-4418-905c-dfac472842b1</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="f666d545-8998-47d6-8bc4-f433feda5f57" name="Delete_Script" type="Action"><subsheetid>f999d785-4034-4d34-b96b-a71eec5cc5f5</subsheetid><display x="15" y="255" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>e3d8a573-7e13-4b03-892f-0489519c31f8</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="3a6b8b9e-51c5-47fd-9972-13dd32451a0b" name="Generate_PnPScript" type="SubSheet"><subsheetid>f999d785-403