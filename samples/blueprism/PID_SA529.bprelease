><initialvalue /><private /><alwaysinit /></stage><stage stageid="5c00e7da-6a24-41ef-9eaa-838e4a71d800" name="Update Column in Filtered Range" type="SubSheetInfo"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><narrative>Update Column value  in Filtered Range</narrative><display x="-300" y="-120" w="150" h="90" /></stage><stage stageid="539e6f5d-63dd-4064-a5b9-397672c1eed0" name="Start" type="Start"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="90" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the cell to be formatted is contained. The default of zero indicates the currently active instance." stage="handle" /><input type="number" name="ColumnNumber" narrative="Column Number for the the column to be updated from filtered column" stage="ColumnNumber" /><input type="text" name="Input Value" narrative="Same value will be assigned to all rows of column" stage="Input Value" /></inputs><onsuccess>021df0f9-a7eb-43b9-9e2d-ca7f426bf945</onsuccess></stage><stage stageid="c65f22ba-0823-4fda-b9d2-223e1610b44b" name="handle" type="Data"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="-300" y="135" w="240" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="bf38aba5-5f5a-4920-96e6-c6de6598255d" name="End" type="End"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="90" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="4e21dd4b-da59-46e2-8444-2d64ef869482" name="Update" type="Code"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="90" y="15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="number" name="column" expr="[ColumnNumber]" /><input type="text" name="input" expr="[Input Value]" /></inputs><outputs><output type="number" name="count" stage="count" /></outputs><onsuccess>bf38aba5-5f5a-4920-96e6-c6de6598255d</onsuccess><code><![CDATA[Dim Inst As Object = GetInstance(handle)
Dim excel as Object = GetInstance(handle)
Dim cell as Object = excel.ActiveCell
Inst.DisplayAlerts = False
Dim wb as Object = GetWorkbook(handle,Nothing)

Count = wb.Application.WorksheetFunction.Subtotal(3, wb.ActiveSheet.AutoFilter.Range.Offset(1,0).Columns(column).SpecialCells(12))
For Each cell In wb.ActiveSheet.AutoFilter.Range.Offset(1,0).Columns(column).SpecialCells(12)
if count = 0 then
Exit For
else
cell.Value = input
count = count - 1
End IF 
Next cell
Inst.DisplayAlerts = True]]></code></stage><stage stageid="021df0f9-a7eb-43b9-9e2d-ca7f426bf945" name="Activate Workbook" type="SubSheet"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="90" y="-45" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the workbook should be activated. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The workbook name identifying the workbook which should be activated - empty text indicates the currently active workbook, making this a no-op." expr="&quot;&quot;" /></inputs><onsuccess>4e21dd4b-da59-46e2-8444-2d64ef869482</onsuccess><processid>6632ed99-8751-4c2a-ad00-3cc016300e08</processid></stage><stage stageid="e7fbe80a-dbe3-47a7-acd7-71c01e2e2dcc" name="ColumnNumber" type="Data"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="-300" y="75" w="210" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="debf2e70-1b2a-4c5a-b5ad-bbb05fc917f9" name="Input Value" type="Data"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="-285" y="15" w="210" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7c286a56-167a-4fce-b8d4-e9788b601c3c" name="count" type="Data"><subsheetid>f910e009-0223-438a-98fc-c86d85ddff21</subsheetid><loginhibit onsuccess="true" /><display x="-315" y="195" w="240" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1df7e1ce-3bb1-4499-838a-7c7ff91a2698" name="System Separator Setting Change" type="SubSheetInfo"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><narrative>Pass System Separator as False to change the Decimal and Thousand Separator value.
Pass System Separator as True to bring the above changed values to default excel setting.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a2a49249-bf63-410f-a03a-bbce56738f57" name="Start" type="Start"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><preconditions><condition narrative="NA" /></preconditions><postconditions><condition narrative="NA" /></postconditions><display x="15" y="-105" /><inputs><input type="number" name="handle" narrative="Handle created" stage="handle" /><input type="text" name="workbook" narrative="Workbook Name" stage="workbook" /><input type="text" name="Decimal Separator" narrative="Decimal Separator value" stage="Decimal Separator" /><input type="text" name="Thousand Separator" narrative="Thousand Separator value" stage="Thousand Separator" /><input type="flag" name="System Separator" narrative="System Separator " stage="System Separator" /></inputs><onsuccess>52eb4c9a-bd01-4283-83f3-01eceb3c6344</onsuccess></stage><stage stageid="2cc425ab-d7bd-41ac-98ce-94b8fcecdf59" name="End" type="End"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="flag" name="Success" narrative="Success" stage="Success" /><output type="text" name="Message" narrative="Message incase of any error" stage="Message" /></outputs></stage><stage stageid="52eb4c9a-bd01-4283-83f3-01eceb3c6344" name="System Separator Setting Change" type="Code"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><display x="15" y="-30" w="120" h="30" /><inputs><input type="number" name="handle" expr="[handle]" /><input type="text" name="workbook" expr="[workbook]" /><input type="flag" name="System Separator" expr="[System Separator]" /><input type="text" name="DEcimal Separator" expr="[Decimal Separator]" /><input type="text" name="Thousand Separator" expr="[Thousand Separator]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /></outputs><onsuccess>2cc425ab-d7bd-41ac-98ce-94b8fcecdf59</onsuccess><code><![CDATA[Dim  wb As Object
Dim excel As Object

Try

wb = GetWorkbook(handle, workbook)
wb.Activate()

excel = wb.Application

if System_Separator = False
excel.UseSystemSeparators = False
excel.DecimalSeparator = Decimal_Separator
excel.ThousandsSeparator = Thousand_Separator
End if


if System_Separator = True
excel.DecimalSeparator = Decimal_Separator
excel.ThousandsSeparator = Thousand_Separator
excel.UseSystemSeparators = True
End if

Success = True
Message =""

Catch e as Exception
   Success = False
   Message = e.Message

Finally
   wb = Nothing
End Try ]]></code></stage><stage stageid="459d0006-dfef-495d-8571-1bae1947c886" name="handle" type="Data"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><display x="-165" y="0" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab045884-56b2-434f-80c5-3a3d7c08c19a" name="workbook" type="Data"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><display x="-165" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="77273c13-1978-4f52-901f-9107dd1aceb9" name="Inputs" type="Block"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><display x="-225" y="-30" w="105" h="240" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c539d718-b4de-416b-b5a2-97a717282524" name="Success" type="Data"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><display x="240" y="-45" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="009de826-ad66-4988-91db-b3eeabce9be1" name="Message" type="Data"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><display x="240" y="15" w="180" h="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="da5312e8-da97-497f-b4e9-2e6db6238234" name="Output Parameters" type="Block"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><loginhibit /><display x="135" y="-90" w="210" h="150" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="acccb816-76e0-4ee8-bdcc-c70e029213b3" name="Decimal Separator" type="Data"><subsheetid>62411f73-511e-46cc-a620-4651b9b61867</subsheetid><display x="-165" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3beb7258-157b-4226-ae72-3031c8360021" name="Thousand Separator" type="Data"><subsheetid>62411f73-511e-46cc-a620-46