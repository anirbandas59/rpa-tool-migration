r="[Script_Loc]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Loc" /></outputs><onsuccess>5a330e65-180e-414d-93f4-5314cb6f073c</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="26ab3e16-a544-4aae-9407-e211bc4ab15a" name="Script_Loc" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-285" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="033d0f18-f71c-44a1-b6db-a071ab2f991b" name="Script Path" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-345" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cfa44bc6-0fcb-4fe9-abb0-1e0640264cc8" name="Error_Message" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="360" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f5c546b3-87e8-4853-a966-d07d83bab508" name="If No Errors" type="Decision"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="60" y="105" /><decision expression="Trim([Error_Message]) = &quot;&quot;" /><ontrue>6f54007d-4742-4e0c-8b4a-da10aee491b7</ontrue><onfalse>9cac5213-2b4d-4391-982f-205e4a5fcc3e</onfalse></stage><stage stageid="6f54007d-4742-4e0c-8b4a-da10aee491b7" name="Success = True" type="Calculation"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="60" y="150" /><onsuccess>83bfc0e8-c377-4dff-abe9-258f64502de6</onsuccess><calculation expression="True" stage="Success" /></stage><stage stageid="9cac5213-2b4d-4391-982f-205e4a5fcc3e" name="Success = False" type="Calculation"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="135" y="105" /><onsuccess>e165fb8b-b05b-4f6e-bcdd-919401bf3748</onsuccess><calculation expression="False" stage="Success" /></stage><stage stageid="83bfc0e8-c377-4dff-abe9-258f64502de6" name="Anchor25" type="Anchor"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="60" y="210" w="10" h="10" /><onsuccess>ef0093ed-9fbc-48f7-95fe-2626e6e8e5f5</onsuccess></stage><stage stageid="e165fb8b-b05b-4f6e-bcdd-919401bf3748" name="Anchor26" type="Anchor"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="135" y="210" w="10" h="10" /><onsuccess>83bfc0e8-c377-4dff-abe9-258f64502de6</onsuccess></stage><stage stageid="f0323047-0901-4c8f-89f1-abd73d645400" name="Exists" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="405" w="150" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="14a21fdf-ad9a-4b56-be15-850740a39b46" name="End" type="End"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-45" y="405" /><outputs><output type="text" name="Run Report" narrative="Run Report" stage="Run Report" /><output type="text" name="Error_Message" narrative="Error_Message" stage="Error_Message" /></outputs></stage><stage stageid="54147a9b-e83a-48ee-b853-29a779aa1f41" name="Start" type="Start"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><preconditions><condition narrative="CSV Path:C:\Users\INH400-F\Documents\test.csv(creates CSV file automatically)" /></preconditions><display x="-45" y="-270" /><inputs><input type="text" name="SharePoint URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SharePoint URL" /><input type="text" name="Share_Lib_Folder_Path" narrative="Folder Path in Sharepoint From Which u want Latest Files" stage="Share_Lib_Folder_Path" /><input type="text" name="Csv Path" narrative="Destination Excel File Name Folder Path  (Example:- C:\Apps\Temp\latest.csv)" stage="Csv Path" /><input type="text" name="Script_Loc" narrative="Location of the script to be generated" stage="Script_Loc" /></inputs><onsuccess>3c3d97ba-ce3c-43ad-8d2f-6cbaa5c5df6a</onsuccess></stage><stage stageid="3c3d97ba-ce3c-43ad-8d2f-6cbaa5c5df6a" name="Get Access Token" type="SubSheet"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><loginhibit /><display x="-45" y="-210" /><onsuccess>3a220047-27be-4ba6-9e17-7dd57b91020a</onsuccess><processid>fe0cf63f-9dc6-4f40-a487-34b9e6ecafd8</processid></stage><stage stageid="47e4ae03-d167-4028-91a5-f631a97ff1b8" name="Csv Path" type="Data"><subsheetid>6008694c-4949-440e-8b35-f576ebcda3e5</subsheetid><display x="-300" y="-45" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9eaa647c-6ac6-4014-88ef-10351762e792" name="Get_ListItem_Id - Specific Column" type="SubSheetInfo"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><narrative>Search Item based on Unique column value and returns ID for the list Item.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="5281c2ca-c65f-4569-bbb6-7a5e653890a5" name="Start" type="Start"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="-240" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.xyz.com/sites/AAAAA1234)" stage="SP_Site_URL" /><input type="text" name="Sp_List_Name" narrative="Provide the target list Name Ex:- PNP_Test_List" stage="SP_Target_List" /><input type="text" name="List_Item_To_Find" narrative="Name of the List Item to be searched. Ex:- &quot;John &quot; " stage="Item_To_Find" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /><input type="text" name="Find_Item_By" narrative="Column name where to search Item. Ex:- First_name" stage="Find_Item_By" /><input type="text" name="ColumnNames" narrative="Specify Column names by &quot;,&quot; seperated &amp; in &quot;&quot; to use to find ID" stage="ColumnNames" /></inputs><onsuccess>bf8fda36-c95e-4251-9aee-67f987c2ae30</onsuccess></stage><stage stageid="86299f43-d9e1-401e-bfff-cf8dab5f20d9" name="End" type="End"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="390" /><outputs><output type="text" name="Item_ID" narrative="Item ID based on the Item Field value." stage="Run Report" /></outputs></stage><stage stageid="b6a238a0-5f0b-4200-aeb6-ac3747b0c709" name="Build Script" type="Calculation"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="-105" /><onsuccess>92d933e2-5103-4c4a-9362-ccf72e76f52c</onsuccess><calculation expression="&quot;Try {&quot; &amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34)  &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$listItems = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_Target_List] &amp; Chr(34) &amp; &quot;-PageSize 5000 -Fields &quot;&amp;[ColumnNames]&amp; NewLine() &amp; NewLine() &amp; &quot;foreach ($item in $listItems) { &quot; &amp; NewLine() &amp; &quot;if ($item['&quot; &amp; [Find_Item_By] &amp; &quot;'] -EQ &quot; &amp; Chr(34) &amp; [Item_To_Find] &amp; Chr(34) &amp; &quot;){&quot; &amp; NewLine() &amp; &quot;Write-Host $item['ID'] &quot; &amp; NewLine() &amp; &quot;Exit &quot; &amp; NewLine() &amp; &quot;}&quot; &amp; NewLine() &amp; &quot;} Write-Host ERROR:- Item Not Found}&quot; &amp; NewLine() &amp; &quot;Catch {&quot; &amp; NewLine() &amp; &quot;Write-Host &quot; &amp; Chr(34) &amp; &quot; Error Details :- $($_.Exception.Message) &#xA;&quot; &amp; Chr(34) &amp;&quot;}&quot;&#xA;" stage="Script" /></stage><stage stageid="cfc0c84d-22a8-420d-947c-b5beae6bbbe6" name="Run PnP_Script" type="SubSheet"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="45" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>372df29e-5945-4592-bfcf-db5a04680275</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="f8e77db4-c9d5-4dc1-a911-fdd405ba5ab3" name="Delete_Script" type="Action"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="300" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>86299f43-d9e1-401e-bfff-cf8dab5f20d9</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="92d933e2-5103-4c4a-9362-ccf72e76f52c" name="Generate_PnPScript" type="SubSheet"><subsheetid>b82aedd2-20ab-49da-8332-f4c96045e985</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Get_ListItem_ID&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>b2f3485a-a3b0-405d-87f1-1a7234574207</onsuccess><pro