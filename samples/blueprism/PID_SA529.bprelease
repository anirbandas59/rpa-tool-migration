ript" type="Action"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="450" y="75" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>27914dd0-cc4b-4a82-8b46-d3c4af583c98</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="591e76bd-705f-48a9-8016-c7a605d180a9" name="Validate Temp Script Path" type="SubSheet"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="-60" /><inputs><input type="text" name="Script_Loc" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Default Script Path" stage="Script_Location" /></outputs><onsuccess>a60fbabd-013b-43cd-aa91-0a19edb83d6c</onsuccess><processid>a5bcf15e-c836-47e3-93f2-ba5579fec4be</processid></stage><stage stageid="97c27517-d628-450f-be38-30da111e0a14" name="Error Message?" type="Decision"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><narrative>Checks if run received exception</narrative><display x="15" y="180" /><decision expression="[Error_Message]&lt;&gt;&quot;&quot; OR InStr([Run Report], &quot;ERROR&quot;)&gt;0" /><ontrue>5f15a664-f369-4e2c-a417-819ae302d23a</ontrue><onfalse>96eab4c4-5d02-4417-a581-20ed9c1632bd</onfalse></stage><stage stageid="5f15a664-f369-4e2c-a417-819ae302d23a" name="Received exception after running the script" type="Exception"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="210" y="180" /><exception type="Business Exception" detail="[Error_Message] &amp; [Run Report]" /></stage><stage stageid="859bff68-46d4-4014-a9e4-9d33389abfe2" name="Input" type="Block"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="-285" y="45" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="605e4b3a-6c6c-4069-b0f7-24f1c4c550a9" name="Inhouse" type="Block"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="-465" y="45" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3a3a059c-e788-4846-9c20-632f46cebe3f" name="End" type="End"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="450" /><outputs><output type="text" name="Success_Message" narrative="On Success &quot;File renamed Successfully&#xA;&quot; will be displayed" stage="Run Report" /></outputs><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="c3a1921d-94d4-480c-9e15-6cf49d55455f" name="User Name" type="Data"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="-390" y="225" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="49ef613a-9aaf-47ae-934d-dcfe2d7cf899" name="New_Filename" type="Data"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="-180" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="58d2be3b-7095-4fb5-9cf2-7908baec10bb" name="Rename Library Folder" type="SubSheetInfo"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><narrative>Rename Folder in a library.
MinAccess:- Add_Edit
On success "Folder Renamed Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="81d94d79-f208-4a80-8e72-dc0720b81cc5" name="Start" type="Start"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="-210" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target Folder Name Ex:- PNP_Test_Lib/Unittesting" stage="SP_RelLib_Url" /><input type="text" name="New_Folder_Name" narrative="New file name to be renamed. Ex:- UT_date" stage="New_Foldername" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>3901f0e3-92d0-4b8b-9ad1-d915bb931f9b</onsuccess></stage><stage stageid="2b8f3da9-f06a-4c3a-81b0-18706c423ece" name="Build Script" type="Calculation"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="-15" /><onsuccess>4bbf1d98-795d-4e02-ad04-8855bcc1a577</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp; &quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &#xA;&quot;Rename-PnPFolder -Folder &quot; &amp;Chr(34) &amp; [SP_RelLib_Url] &amp;Chr(34) &amp;  &quot; -TargetFolderName &quot; &amp;Chr(34) &amp;  [New_Foldername] &amp;Chr(34) &amp;  &quot; -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;Folder Renamed Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException]  { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="64071cab-7d5c-41a5-b6df-57e74afb3cd0" name="Run PnP_Script" type="SubSheet"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>85ba3d33-aca7-4b5b-b149-86e57e92bdf0</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="637960ae-5bef-437c-bbd2-c55dbc238ecf" name="Delete_Script" type="Action"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>4789b3d9-0ade-4826-bd20-bf979343ad87</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="4bbf1d98-795d-4e02-ad04-8855bcc1a577" name="Generate_PnPScript" type="SubSheet"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_Folder&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>a037b738-9369-4cda-a4cb-e6a76fdfd9f9</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="a037b738-9369-4cda-a4cb-e6a76fdfd9f9" name="Check_Error" type="Decision"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>146aac1e-83e4-4db0-8a93-cd2792f515d4</ontrue><onfalse>64071cab-7d5c-41a5-b6df-57e74afb3cd0</onfalse></stage><stage stageid="146aac1e-83e4-4db0-8a93-cd2792f515d4" name="Exception while creating  Script" type="Exception"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="090c7f42-27b5-4a8f-a2d8-305f1ff5bee3" name="Check Process_Exist" type="Action"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>c4182eec-49fe-4ea3-826e-28465bb32218</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="c4182eec-49fe-4ea3-826e-28465bb32218" name="ProcessExist?" type="Decision"><subsheetid>1d0875bd-3345-4c8a-a34f-2ca9edef3b31</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>8c961a1f-10f8-4e7d-9bf7-ef513baa0064</ontrue><onfalse>6d39420d-6554-41cb-a7da-21eed876f6dd</onfalse></stage><stage stageid="6d39420d-6554-41cb-a7da-21eed876f6dd" name="Anchor8" type="Anchor"><subsheetid>1d