t /></stage><stage stageid="01738765-614f-42c3-8e23-0539b7cb421f" name="Workbook" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="30" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b63ff32b-f4bd-4dd8-9118-93337245f014" name="Worksheet" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="0" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="397a35d1-8b7c-4f9e-87d0-d48bb86e8825" name="Start" type="Start"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="105" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" stage="Handle" /><input type="text" name="Workbook" stage="Workbook" /><input type="text" name="Worksheet" stage="Worksheet" /><input type="text" name="Cell Reference" stage="Cell Reference" /><input type="text" name="valueToFind" stage="valueToFind" /></inputs><onsuccess>175feb22-5d5e-4117-b359-ee6e585fe14c</onsuccess></stage><stage stageid="ac034f9c-fd6f-44ec-9973-84be121e30a6" name="Cell Reference" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="60" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="175feb22-5d5e-4117-b359-ee6e585fe14c" name="Find Value1" type="Code"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="105" y="-45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="number" name="Handle" expr="[Handle]" /><input type="text" name="Workbook" expr="[Workbook]" /><input type="text" name="Worksheet" expr="[Worksheet]" /><input type="text" name="Reference" expr="[Cell Reference]" /><input type="text" name="valueToFind" expr="[valueToFind]" /></inputs><outputs><output type="flag" name="Success" stage="Success" /><output type="text" name="Message" stage="Message" /><output type="text" name="FindValue1" stage="CellRef" /></outputs><onsuccess>24bcee08-8007-4e77-8e8a-4d53c55a2b0c</onsuccess><code><![CDATA[Dim wb, ws As Object
Dim excel, sheet, range As Object
dim FindValue as object

Try

wb = GetWorkbook(Handle, Workbook)
ws = GetWorksheet(Handle, Workbook, Worksheet)

wb.Activate()
ws.Activate()
excel = ws.Application
sheet = excel.ActiveSheet
range = sheet.Range(Reference)
FindValue=range.Find(valueToFind)
       
 FindValue1=FindValue.Address(False,False)
range.Select()

Success = True

Catch e As Exception
                Success = False
                Message = e.Message
Finally
                wb = Nothing
                ws = Nothing
                excel = Nothing
                sheet = Nothing
                range = Nothing
End Try]]></code></stage><stage stageid="24bcee08-8007-4e77-8e8a-4d53c55a2b0c" name="Success?" type="Decision"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="105" y="30" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>5fc82486-abb2-4b18-8d65-3c6d3d0c3ee6</ontrue><onfalse>fbfe1e2f-a351-46b7-8d3e-08a67278187b</onfalse></stage><stage stageid="fbfe1e2f-a351-46b7-8d3e-08a67278187b" name="Exception" type="Exception"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="210" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="" detail="&quot;Failed to select row: &quot; &amp; [Message]" /></stage><stage stageid="33b5a51c-3e18-4a78-bf45-18817ffa015d" name="Success" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="105" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab15bb4c-9d1f-40e1-9c45-f1a95a7457d2" name="Message" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="-105" y="135" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="33299fce-8765-4465-b371-d015713ac5c6" name="CellRef" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><display x="345" y="-30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="116b868b-14c2-4acc-96c3-0044cdde8bfd" name="valueToFind" type="Data"><subsheetid>8585802a-8709-41b5-a014-d57d3dfd1aec</subsheetid><loginhibit onsuccess="true" /><displ