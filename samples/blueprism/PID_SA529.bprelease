alculation expression="Replace([JSON], &quot;{&quot;, &quot;&quot;)" stage="JSON" /><calculation expression="Replace([JSON], &quot;}&quot;, &quot;&quot;)" stage="JSON" /><calculation expression="Replace([JSON], &quot;[&quot;, &quot;&quot;)" stage="JSON" /><calculation expression="Replace([JSON], &quot;]&quot;, &quot;&quot;)" stage="JSON" /><calculation expression="Replace([JSON], &quot;,&quot;, &quot;;&quot;)" stage="JSON" /><calculation expression="Replace([JSON], &quot;:&quot;, &quot;=&quot;)" stage="JSON" /></steps></stage><stage stageid="f432c47e-e590-42dd-9669-072b6d494db7" name="res" type="Data"><subsheetid>7d4c9878-ef84-4bef-991a-28c31042d00c</subsheetid><display x="-45" y="120" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="616c0aae-1405-4abd-8f66-48f88e514c55" name="Rename Library File" type="SubSheetInfo"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><narrative>Rename file in a library.
MinAccess:- Add_Edit
On success "File Renamed Successfully
" will be returend .</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="a4ba1b55-08c2-4cc5-a1e0-bf1f5cd5c248" name="Start" type="Start"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="-210" /><inputs><input type="text" name="SP_Site_URL" narrative="Provide SharePoint URL Ex:- https://eu001-sp.xyz.com/sites/AAAAB1234/" stage="SP_Site_URL" /><input type="text" name="Site_rel_URL" narrative="Provide the target File Name Ex:- PNP_Test_Lib/Unittesting/Test_file.txt" stage="SP_RelLib_Url" /><input type="text" name="New_File_Name" narrative="New file name to be renamed. Ex:- Result_UT.txt" stage="New_Filename" /><input type="text" name="Temp_Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>6937b927-7e05-4b8e-ae09-49c43994f2c6</onsuccess></stage><stage stageid="a60fbabd-013b-43cd-aa91-0a19edb83d6c" name="Build Script" type="Calculation"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="-15" /><onsuccess>7b61c53d-e421-4529-a92e-c61b02ecf58e</onsuccess><calculation expression="&quot;Try { &quot; &#xA;&amp; NewLine() &amp;&#xA;&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot; &amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34) &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp;NewLine() &amp; &#xA;&quot;Rename-PnPFile -SiteRelativeUrl &quot; &amp; Chr(34) &amp;[SP_RelLib_Url] &amp; Chr(34) &amp; &quot; -TargetFilename &quot; &amp;Chr(34)&amp; [New_Filename] &amp;Chr(34)&amp; &quot; -Force  -ErrorAction Stop &quot; &amp; NewLine() &amp; &#xA;&quot;Write-Host &quot;&amp; Chr(34) &amp;  &quot;File Renamed Successfully&quot; &amp; Chr(34)  &amp;&quot;}&quot;&#xA;&#xA;&amp; NewLine() &amp;&#xA;&#xA; &quot;Catch  [System.SystemException] { Write-Host &quot;&amp; Chr(34) &amp;  &quot;ERROR Message: $($_.Exception.Message)&quot; &amp; Chr(34)  &amp;&quot; }&quot;&#xA;" stage="Script" /></stage><stage stageid="e27b68ef-5a9e-4127-b043-8b578f034aa0" name="Run PnP_Script" type="SubSheet"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="135" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>97c27517-d628-450f-be38-30da111e0a14</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="9aa0ce77-fcef-49d8-ab8b-ccb5e15d4ae5" name="Delete_Script" type="Action"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="390" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>3a3a059c-e788-4846-9c20-632f46cebe3f</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="7b61c53d-e421-4529-a92e-c61b02ecf58e" name="Generate_PnPScript" type="SubSheet"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="30" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Temp_Rename_File&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>99bf19d7-e9ac-4202-8e32-892d766a7915</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="99bf19d7-e9ac-4202-8e32-892d766a7915" name="Check_Error" type="Decision"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="75" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>43f22275-8666-4f23-8aea-8318891e6ddc</ontrue><onfalse>e27b68ef-5a9e-4127-b043-8b578f034aa0</onfalse></stage><stage stageid="43f22275-8666-4f23-8aea-8318891e6ddc" name="Exception while creating  Script" type="Exception"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="210" y="75" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="96eab4c4-5d02-4417-a581-20ed9c1632bd" name="Check Process_Exist" type="Action"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="240" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>02a5b563-0d3e-48ad-abb1-06ce1d1d648e</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="02a5b563-0d3e-48ad-abb1-06ce1d1d648e" name="ProcessExist?" type="Decision"><subsheetid>44e5c5d3-a6f8-4808-8c5f-368a0a3cb638</subsheetid><display x="15" y="285" /><decision expression="[P_Exists]=True" /><ontrue>29deae62-9638-4ea8-a335-ca12297833e2</ontrue><onfalse>620b11d7-114d-404c-afdb-2cf2eb080777</onfalse></stage><stage stageid="620b11d7-114d-404c-afdb-2cf2eb080777" name="Anchor8" type="Anchor">