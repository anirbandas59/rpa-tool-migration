 type="Action"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-30" y="-240" /><inputs><input type="text" name="Directory Path" narrative="The path in which to create the directory" expr="[Dest_Directory]" /><input type="flag" name="Error If Already Exists" narrative="True to generate an error if the directory already exists" expr="" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>a4065bc6-3b2f-436a-a15b-86d4de014bf4</onsuccess><resource object="Utility - File Management" action="Create Directory" /></stage><stage stageid="7372359c-c337-44f9-8bcb-5c0965155d8e" name="Destination Directory Not found" type="Exception"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="135" y="-285" /><exception type="Business Exception" detail="&quot;Destination directory not exist and not received instruction to create&quot;" savescreencapture="yes" /></stage><stage stageid="0e163d31-58da-46d4-b5f8-26616843763e" name="Input" type="Block"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-495" y="-165" w="150" h="360" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f8daa25d-3434-419b-ac22-c41a9907178d" name="OutPut" type="Block"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-495" y="225" w="120" h="180" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f0669dc4-23fe-4e50-940b-8080bc007df5" name="Inhouse" type="Block"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><display x="-720" y="-60" w="195" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="93eb6694-d477-4c53-8a1d-da132ad2c5ec" name="Process_Exists" type="Data"><subsheetid>0455bdbc-b551-4c40-a6ea-2c3e98a7d932</subsheetid><displ