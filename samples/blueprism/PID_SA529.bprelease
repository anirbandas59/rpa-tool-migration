This action downloads all the files form the folder recursively including sub folder files (the root folder can be either a library/ list/ folder to extract details from). Output is a file either in csv/ txt format as path in Output file path parameter.</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="4e5c48e1-cbfc-4f84-9ec0-fa0a932877bf" name="Return Message" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-435" y="105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="543bee93-5efa-4fc8-8f84-b983ba1f260f" name="Script" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-600" y="-30" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b91afc84-6aa0-43cd-bfc9-54979f36f4ef" name="Unexpected exception recover" type="Recover"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-15" y="225" /><onsuccess>8381072e-b489-40ef-8bea-4782aab8102c</onsuccess></stage><stage stageid="534f9f38-edcd-4cce-827d-a499969e71d5" name="Unexpected Exception" type="Exception"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="225" y="225" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="424bd6b7-6db1-4466-9c91-df6596c83712" name="Script Path" type="Data"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-600" y="0" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c0a8e753-35e0-4454-812d-7ce05f1d5bac" name="Start" type="Start"><subsheetid>1509d2d6-19c9-42ab-8df3-6418de41957a</subsheetid><display x="-165" y="-270" /><inputs><input type="text" name="Script Location" narrative="Folder Location to create script(Ex:- C:\Apps\PID1)" stage="ScriptLocation" /><input type="text" name="Base URL" narrative="