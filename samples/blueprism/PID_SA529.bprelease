3-689f-4457-8892-f59663923717</subsheetid><display x="-465" y="105" w="90" h="30" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="36c1325f-1e1b-4635-9057-3fdbce841d29" name="Set Terminate Retry Counter" type="Calculation"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="15" y="-45" /><onsuccess>c359ed0b-caa7-4706-9245-53b50e617155</onsuccess><calculation expression="0" stage="intTerminateRetryCounter" /></stage><stage stageid="fc2cf542-8af9-4280-936e-72e1873f355a" name="intTerminateRetryCounter" type="Data"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-465" y="15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="767e7bde-b46b-466e-9b70-43175fff6a9d" name="Anchor6" type="Anchor"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="120" y="195" w="10" h="10" /><onsuccess>2243d77f-4122-4dce-8cf7-a7fa9cedb7f2</onsuccess></stage><stage stageid="054e57fd-700e-477e-8d78-56c95096d9a3" name="Recover1" type="Recover"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-60" y="135" /><onsuccess>a55700a1-e24a-4a81-86c7-f4da779cf49d</onsuccess></stage><stage stageid="a55700a1-e24a-4a81-86c7-f4da779cf49d" name="Increment Terminate Retry Counter" type="Calculation"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-150" y="135" /><onsuccess>285d4661-644d-410d-bc67-ce7a28cc9fcd</onsuccess><calculation expression="[intTerminateRetryCounter]+1" stage="intTerminateRetryCounter" /></stage><stage stageid="285d4661-644d-410d-bc67-ce7a28cc9fcd" name="Retry?" type="Decision"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-225" y="135" /><decision expression="[intTerminateRetryCounter]&lt;= [intMaxNumRetries]" /><ontrue>9e1b1d61-3586-4ee2-b5ae-f9482fd5dce9</ontrue><onfalse>568a97dd-932d-4480-aecc-e0472f060971</onfalse></stage><stage stageid="568a97dd-932d-4480-aecc-e0472f060971" name="Throw Exception" type="Exception"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-225" y="180" /><exception type="System Exception" detail="ExceptionDetail()" savescreencapture="yes" /></stage><stage stageid="9e1b1d61-3586-4ee2-b5ae-f9482fd5dce9" name="Resume1" type="Resume"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-225" y="0" /><onsuccess>c359ed0b-caa7-4706-9245-53b50e617155</onsuccess></stage><stage stageid="d5e98b81-8b46-4541-a109-d31a67eef223" name="Anchor7" type="Anchor"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="15" y="90" w="10" h="10" /><onsuccess>096a8ab8-3535-40b4-85ea-7fecc52e3255</onsuccess></stage><stage stageid="680e7bd7-0ea2-430a-8770-626cb60fb904" name="Anchor6" type="Anchor"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="120" y="45" w="10" h="10" /><onsuccess>767e7bde-b46b-466e-9b70-43175fff6a9d</onsuccess></stage><stage stageid="d40b38ad-cb02-4188-8783-d7edc7b82cc4" name="Block3" type="Block"><subsheetid>29b25663-689f-4457-8892-f59663923717</subsheetid><display x="-105" y="105" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c39b6704-27ab-471e-b290-e85bac5ebd73" name="Remove_File_From_Library" type="SubSheetInfo"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><narrative>Remove file from specific library/ sharepoint location.</narrative><display x="-75" y="-270" w="150" h="90" /></stage><stage stageid="146235cc-c8f6-4446-a3d3-3d4ecafe81ec" name="Start" type="Start"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><preconditions><condition narrative="&gt; Make sure SharePoint API is installed." /><condition narrative="&gt;Make sure you have atleast Edit access/contribute access to Site/Library to use this action." /></preconditions><postconditions><condition narrative="&gt; Get the output and create the success/failure condition." /></postconditions><display x="120" y="-330" /><inputs><input type="text" name="SP_URL" narrative="Sharepoint site/subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="Sp_Lib_Folder" narrative="SharePoint Library/Folder where we are going to search. Provide HTML format (Ex:- SharePointAPI Testing/TestFolder)" stage="SP_Target_Lib" /><input type="text" name="Search_FileName" narrative="Share thele to be searched. (Ex:- APIdoc.docx)" stage="File_Name" /><input type="text" name="Script_Location" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="Script_Location" /></inputs><onsuccess>5f3b427a-4112-4bd0-80e1-107bcea82e2f</onsuccess></stage><stage stageid="b5fdce92-71c7-453f-8b84-3c08c6aee4af" name="End" type="End"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="300" /><outputs><output type="text" name="Script_Run_Message" narrative="returns Blank/Warning for software update." stage="Run Report" /><output type="text" name="Script_Error_Message" narrative="Returns error/exception details ( On error shares error details)" stage="Error_Message" /></outputs></stage><stage stageid="f1bf3ddd-52cb-41d7-b5a8-ea15032e3b68" name="Run PnP_Script" type="SubSheet"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="15" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Run Report" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>15213a41-41f6-4e57-b528-ce320108b25c</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="ecb10ad6-0966-4aa2-8197-a0f0449d9c87" name="Delete_Script" type="Action"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="225" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>b5fdce92-71c7-453f-8b84-3c08c6aee4af</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="5f62051d-21b0-43d2-a31a-03a2de78943a" name="Generate_PnPScript" type="SubSheet"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="-90" /><inputs><input type="text" name="Script_Content" narrative="Content of the script" expr="[Script]" /><input type="text" name="Script_Name" narrative="Name Of the script" expr="&quot;Remove_File_from_library&quot;" /><input type="text" name="Script_location" narrative="Directory where to stor ethe script" expr="[Script_Location]" /></inputs><outputs><output type="text" name="Script_Path" stage="Script Path" /><output type="text" name="Status_Message" stage="Return Message" /></outputs><onsuccess>54c7086e-e300-469d-8085-1d31f5584a1a</onsuccess><processid>7da6c534-513c-499b-ad78-ecf5fb9a01a5</processid></stage><stage stageid="54c7086e-e300-469d-8085-1d31f5584a1a" name="Check_Error" type="Decision"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="-45" /><decision expression="Len([Return Message]) &gt;0" /><ontrue>cdfadb6f-f7a2-486c-adff-f2bb83d970a4</ontrue><onfalse>f1bf3ddd-52cb-41d7-b5a8-ea15032e3b68</onfalse></stage><stage stageid="cdfadb6f-f7a2-486c-adff-f2bb83d970a4" name="Exception while creating  Script" type="Exception"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="315" y="-45" /><exception type="System Exception" detail="[Return Message]" savescreencapture="yes" /></stage><stage stageid="15213a41-41f6-4e57-b528-ce320108b25c" name="Check Process_Exist" type="Action"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="60" /><inputs><input type="text" name="Process Name" narrative="The name of the process" expr="[Application_nm]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the process exists" stage="P_Exists" /></outputs><onsuccess>70126eb3-ad87-4409-9c34-6e3d3a3d5023</onsuccess><resource object="Utility - General" action="Process Exists" /></stage><stage stageid="70126eb3-ad87-4409-9c34-6e3d3a3d5023" name="ProcessExist?" type="Decision"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="120" /><decision expression="[P_Exists]=True" /><ontrue>d98b9e1b-0718-4807-81f6-93834fe06bed</ontrue><onfalse>250a35e0-c478-43a5-8795-a1de8483290d</onfalse></stage><stage stageid="250a35e0-c478-43a5-8795-a1de8483290d" name="Anchor8" type="Anchor"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="225" y="120" w="10" h="10" /><onsuccess>e5cc7998-a98e-439a-b75b-32c12d7f3bf5</onsuccess></stage><stage stageid="d98b9e1b-0718-4807-81f6-93834fe06bed" name="Kill Process" type="Action"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="120" y="165" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="[Application_nm]" /></inputs><onsuccess>ecb10ad6-0966-4aa2-8197-a0f0449d9c87</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="e5cc7998-a98e-439a-b75b-32c12d7f3bf5" name="Anchor9" type="Anchor"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="225" y="225" w="10" h="10" /><onsuccess>ecb10ad6-0966-4aa2-8197-a0f0449d9c87</onsuccess></stage><stage stageid="b65623aa-6e52-4a55-8b51-43f4a20642a0" name="SP_Site_URL" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-120" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d4751c82-c4e1-45a7-adbb-e5e6f20f5735" name="SP_Target_Lib" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-120" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6b33e8ff-7357-4ae9-9610-ff8777ef2514" name="File_Name" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-105" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ab746ec5-84bd-4a5e-82f2-06fdbfff2f48" name="Input" type="Block"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-165" y="-75" w="180" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6a8a0cf9-477f-47ee-ad18-e4b08c69319d" name="Output" type="Block"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-165" y="75" w="180" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="26c01817-73b2-4da4-b132-979164cd1474" name="Inhouse" type="Block"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-345" y="-75" w="120" h="315" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="33e630bc-d46e-4b00-82ef-8e943f6dc044" name="Script" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-270" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="970bcdab-5310-4e7a-88a5-708611945b93" name="Return Message" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-300" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="28fd5a39-8c8f-4da9-ae72-98bcea1c1bac" name="Script Path" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-285" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="8d3d9012-44d8-40b4-8a52-1435e4e382bd" name="Error_Message" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-90" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cde61b01-e414-41a3-9962-7e6e8f243de8" name="Run Report" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-105" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eeb7877f-1dcb-4b88-8a63-841cc09f530a" name="P_Exists" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><narrative>Process exist or not</narrative><display x="-255" y="15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7763f870-4499-4ee3-ad74-37cfc9b0aab3" name="Standards" type="Note"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><narrative>
File Name:- File to be Deleted (Example:- test.xlsx)

Share_Target_Lib: Includes Library and sub folder where to search file present or not( Example:- Documents/FO/Data)

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

************************************************************************************************
Considering to delete "Test.xlsx" in   "https://eu001-sp.shell.com/sites/AAAAA3201/Documents/FO/Data".
</narrative><display x="-315" y="-165" w="300" h="150" /></stage><stage stageid="2781ba3d-e5d3-4914-8075-ba674e8df7a0" name="Unexpected exception recover" type="Recover"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="480" y="-45" /><onsuccess>37a10d60-849e-4b77-aa94-a511a42e2284</onsuccess></stage><stage stageid="cc3dc97d-6098-4f43-9f5a-ac19184a2023" name="Unexpected Exception" type="Exception"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="690" y="-45" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="83610e34-62bc-461e-9a93-8b643f1a5c74" name="Script_Location" type="Data"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="-60" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="37a10d60-849e-4b77-aa94-a511a42e2284" name="Delete_Script" type="Action"><subsheetid>08319810-b5ba-48cb-830d-5f64c987a2b9</subsheetid><display x="585" y="-45" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Script Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="" /></outputs><onsuccess>cc3dc97d-6098-4f43-9f5a-ac19184a2023</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="f414daff-7403-4e27-9a32-0311325a3104" name="Export List to CSV by Columns" type="SubSheetInfo"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><narrative>Exports provided columns of given list to a csv file</narrative><display x="-600" y="-120" w="150" h="90" /></stage><stage stageid="a13a44b2-c93e-49bc-a813-3cea5dfb293d" name="Return Message" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-435" y="345" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eb1120ee-3cfc-44e2-a848-1de3d147c9a4" name="Script" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-600" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67749b9d-3141-448e-9de2-8c531fb1a1e6" name="SP_Site_URL" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-420" y="45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="30b1384b-5bcd-44cf-8cc7-8997df4f9a3d" name="Dest_Directory" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-420" y="90" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="338e1eb4-816d-4f55-84f7-abb6c35ba5aa" name="Standards" type="Note"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><narrative>Dest_Directory: destination directory where the file will be downloaded e.g. C:\Apps

Create_Dir:- To check if Directory is not there whether to create or not.

SP_List: name of the list to be exported.

Column_IDs: List of column IDs to be exported. Should be provided as text enclosed in apostrophe and separated by comma e.g. 'Title','Created By'

SP_Site_URL: Sharepoint Site or subsite URL(Example:- https://eu001-sp.shell.com/sites/AAAAA3201)

CSV File name: Filename of the csv where the list is to be exported
</narrative><display x="-525" y="-285" w="300" h="150" /></stage><stage stageid="89a37263-5b82-485a-97b8-7790d0e2df00" name="Unexpected exception recover" type="Recover"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="180" y="-180" /><onsuccess>5037bb6e-72f5-4ac3-8295-f210398c6244</onsuccess></stage><stage stageid="4f14cfe1-019a-461c-bba8-563638ef8275" name="Unexpected Exception" type="Exception"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="390" y="-180" /><exception localized="yes" type="" detail="" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="ec467536-8e80-4af2-b7d4-b33b3d57a608" name="IsDirExist" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-600" y="-30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="91b0d0b7-a57a-4eea-86c0-0e8eb8ce7ee3" name="Script Path" type="Data"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-600" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="eab48703-87dd-49f9-a8e4-4d43f4926f06" name="Start" type="Start"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="-495" /><inputs><input type="text" name="SharePoint Site URL" narrative="SharePoint Site/ Subsite URL (Example:- https://eu001-sp.shell.com/sites/AAAAA3201)" stage="SP_Site_URL" /><input type="text" name="SP_List" narrative="Name of Sharepoint list to be exported." stage="SP_List" /><input type="text" name="Destination" narrative="Folder Location to download(Ex:- C:\Apps\PID1)" stage="Dest_Directory" /><input type="flag" name="Create_Dir" narrative="If Dir is not there Bot to create?" stage="Create_Dir" /><input type="text" name="ScriptLocation" narrative="(Optional)Temp script store location(Ex: C:\Apps) ( In case of not provided any value, default location will be C:\Users\&lt;UserNm&gt;\Documnets)" stage="ScriptLocation" /><input type="text" name="Filename" narrative="CSV filename to export the list to" stage="CSV Filename" /><input type="text" name="Columns" narrative="Columns to be exported provided as a text values separated by comma e.g. 'Title','Created Date'" stage="Columns" /><input type="text" name="TimeOut" narrative="(Optional) Maximum time allowed for Powershell execution, post which BluePrism gets control" stage="TimeOut" /></inputs><onsuccess>6dc96ecc-31d4-47f0-86b6-42955737b799</onsuccess></stage><stage stageid="4838b607-3cde-4106-bfab-1cb916d57d1f" name="End" type="End"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="240" /><outputs><output type="text" name="Script_Run_Message" narrative="Returns run report( On success returns nothing)" stage="Return Message" /><output type="text" name="Script_Error_Message" narrative="Return error/exception details( On error Share error details)" stage="Error_Message" /></outputs></stage><stage stageid="8cc4b2d9-20b6-4c3b-a89e-6d83fd7b42e7" name="Build Script" type="Calculation"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="-240" /><onsuccess>cf0c2a7e-7bd3-40f7-807f-a20b21b2b205</onsuccess><calculation expression="&quot;$env:PNPPOWERSHELL_UPDATECHECK=&quot;&amp;Chr(34)&amp;&quot;false&quot;&amp;Chr(34)&amp;&quot;&quot;&amp;NewLine()&amp;&quot;&#xA;Connect-PnPOnline -Url &quot;&amp; Chr(34) &amp; [SP_Site_URL] &amp; Chr(34)  &amp;&quot; -AccessToken &quot; &amp;[AccessToken] &amp;&quot; -WarningAction SilentlyContinue&quot;&amp; NewLine() &amp; &quot;$listContent = Get-PnPListItem -List &quot; &amp; Chr(34) &amp; [SP_List] &amp; Chr(34) &amp; &quot;-Fields &quot; &amp; [Columns] &amp;&quot;-Pagesize 500&quot;&amp; NewLine() &amp; &quot;$columnsToRetrieve = &quot; &amp; [Columns] &amp; NewLine() &amp; &quot;$filePath =&quot;&amp;Chr(34) &amp; [Dest_Directory]&amp; &quot;\&quot; &amp; [CSV Filename] &amp; Chr(34) &amp; NewLine() &amp; NewLine() &amp;  &quot;If (Test-Path($filePath )){&quot; &amp; NewLine() &amp; &#xA;    &quot;Remove-Item $filePath &#xA;}&quot;&#xA;&amp; NewLine() &amp; NewLine() &amp;&#xA;&quot;Foreach ($column in $columnsToRetrieve){ &quot;&amp; NewLine() &amp;&quot;&#xA;    $column + &quot;&amp; Chr(34) &amp; Chr(44)&amp; Chr(34) &amp; &quot;| Add-Content -Path $filePath -NoNewline &quot; &amp;NewLine() &amp; &quot;&#xA;}&quot; &amp;NewLine() &amp; Chr(34) &amp; Chr(34) &amp; &quot;  | Add-Content -Path $filePath &#xA;&quot;&amp; NewLine() &amp; NewLine() &amp; &quot;&#xA;Foreach ($item in $ListContent){ &quot;&amp; NewLine() &amp;&quot;&#xA;    Foreach ($column in $columnsToRetrieve){ &quot;&amp; NewLine() &amp;&quot;&#xA;       [string] $item[$column] + &quot;&amp; Chr(34) &amp; Chr(44)&amp; Chr(34) &amp; &quot; | Add-Content -Path $filePath -NoNewline &quot;&amp; NewLine() &amp;&quot;&#xA;    } &quot;&amp; NewLine() &amp;&quot;&#xA;    &quot;&amp; Chr(34) &amp; Chr(34) &amp; &quot; | Add-Content -Path $filePath &quot;&amp; NewLine() &amp;&quot;&#xA;}&quot;&#xA;" stage="Script" /></stage><stage stageid="a320d5cd-6c26-446c-b9e6-53208d5041f4" name="Run PnP_Script" type="SubSheet"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="-30" /><inputs><input type="text" name="Application" narrative="Application.exe" expr="[Application_nm] &amp; &quot;.exe&quot;" /><input type="text" name="Script_Path" narrative="Script Location" expr="[Script Path]" /></inputs><outputs><output type="text" name="Run Report" narrative="Return  run report From Power Shell" stage="Return Message" /><output type="text" name="Error_Message" narrative="return failure/error message" stage="Error_Message" /></outputs><onsuccess>ee467597-5d80-43fe-8b01-8c6c5e56d847</onsuccess><processid>7c20ffe9-31ed-4311-8f74-2fdb02423ff3</processid></stage><stage stageid="8d8e1141-0cc7-4466-9a9e-9db3f43a777b" name="Delete_Script" type="Action"><subsheetid>56008328-fdd9-441a-afe4-a6ec51310048</subsheetid><display x="-165" y="18