Output: C:\Apps\Screenshot.PNG
</narrative><display x="-135" y="-405" w="150" h="90" /></stage><stage stageid="4b1ca357-f78a-4c63-850d-4d19f7542f75" name="Start" type="Start"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="165" y="-330" /><inputs><input type="text" name="ScreenShot_ Path" narrative="Enter the loaction/only path to save the screenshot in. By default the name of the file will be Screenshot.PNG. For Example: C:\Apps\" stage="Path" /></inputs><onsuccess>224f0ae5-12ac-452b-b4c6-d6e13e6ee27b</onsuccess></stage><stage stageid="06fed063-5d69-4606-9cef-a83797703c57" name="count" type="Data"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="-15" y="-165" /><datatype>number</datatype><initialvalue>1</initialvalue><private /><alwaysinit /></stage><stage stageid="c2add96e-bbe2-4200-be25-21cb7da390b0" name="SetImage from Clipboard39" type="Code"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="165" y="-225" /><inputs><input type="image" name="Input" expr="[ScreenshotImage]" /></inputs><onsuccess>721fd516-5892-486c-ad35-790f22289638</onsuccess><code><![CDATA[My.Computer.Clipboard.SetImage(Input)]]></code></stage><stage stageid="3d701e62-2ff3-4f96-8e0a-722b9f40b64f" name="Screenshot" type="Data"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="0" y="-255" /><datatype>image</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="53028d8b-4b18-4a99-9a2c-427462986cc3" name="Recover1" type="Recover"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="285" y="-120" /><onsuccess>0a61f860-4b9b-4928-817f-8375f172c9ac</onsuccess></stage><stage stageid="0a61f860-4b9b-4928-817f-8375f172c9ac" name="Resume1" type="Resume"><subsheetid>786bc679-3987-448e-b3d5-821818e0556f</subsheetid><display x="420" y="-120" /><onsuccess>8b1add39-4aad-4b06-a17f-7e6c9c824c14</onsuccess></stage><stage stageid="8b1add39-4aad-4b06-a17f-7e6c9c824c14" name="count" type="Calculation"><subsheetid>786