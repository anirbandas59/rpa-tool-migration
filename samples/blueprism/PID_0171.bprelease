success>100444b8-2a45-43a5-8712-697016438d48</onsuccess></stage><stage stageid="a432cf5e-cae0-4a74-be28-ef763bda19d1" name="ImageD1" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="345" y="-210" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>1274,798,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="fc093c37-8911-4b45-8628-24c0a0d6eb0e" name="ImageD2" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="345" y="-180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>22,21,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="c890aa27-a3cf-4220-b793-5453de6c2da6" name="Test D" type="MultipleCalculation"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="345" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>5d6da74b-99a7-4547-bc24-cb1dc9933db1</onsuccess><steps><calculation expression="[ImageD1]" stage="Image1" /><calculation expression="[ImageD2]" stage="Image2" /></steps></stage><stage stageid="c93e73e2-7dea-420f-afa2-282beaed8bbb" name="ImageE1" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="420" y="-210" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>88,92,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="391c7a1a-153f-4329-afad-9e2811004927" name="ImageE2" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="420" y="-180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>22,9,137224,iVBORw0KGgoAAAANSUhEUgAAABYAAAAJCAIAAAC5VksiAAAARklEQVQoU82MuQ0AMAgDs//SjhEmgiIPXa7hbBADwNhz3or/XtAd5dheSo0kJJfZl5SyhKBX9q6rEPPedRWS3WB2lF9eABOnKp5ipdZLWgAAAABJRU5ErkJggg==</initialvalue><private /><alwaysinit /></stage><stage stageid="357258b5-2c54-4b5e-88f0-149130f0d9a7" name="Test E" type="MultipleCalculation"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="420" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>5d6da74b-99a7-4547-bc24-cb1dc9933db1</onsuccess><steps><calculation expression="[ImageE1]" stage="Image1" /><calculation expression="[ImageE2]" stage="Image2" /></steps></stage><stage stageid="c2faa07f-240e-42e2-840d-e815708b5f25" name="ImageF1" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="495" y="-210" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>1274,798,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="ac16f798-3613-4a37-acdb-451417aa0b41" name="ImageF2" type="Data"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><display x="495" y="-180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>22,21,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="20098fe4-924e-459e-a482-eaacc8c2ad93" name="Test F" type="MultipleCalculation"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><narrative>Second image contains a colour discrepency</narrative><display x="495" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>5d6da74b-99a7-4547-bc24-cb1dc9933db1</onsuccess><steps><calculation expression="[ImageF1]" stage="Image1" /><calculation expression="[ImageF2]" stage="Image2" /><calculation expression="10" stage="Tolerance" /></steps></stage><stage stageid="88569bfa-19b7-46bb-b618-eede691b2e1d" name="### TEST Find Image (all instances)" type="SubSheetInfo"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="5c42899a-46ba-4b05-bd20-3566317f609c" name="Start" type="Start"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>8e1d176a-541b-446b-992c-5ef4f564d630</onsuccess></stage><stage stageid="03db28f0-4ce9-4f0b-b9f9-4dbcd17c96e8" name="Find All Images TEST1" type="Code"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="image" name="Image1" expr="[Image1]" /><input type="image" name="Image2" expr="[Image2]" /><input type="number" name="Tolerance" expr="[Tolerance]" /></inputs><outputs><output type="collection" name="Locations" stage="Locations" /><output type="flag" name="Found" stage="Found" /><output type="number" name="MS" stage="T1" /></outputs><onsuccess>950aad91-ddbd-4069-bbdf-9bae942b99de</onsuccess><code><![CDATA[Dim s As New System.Diagnostics.Stopwatch
s.Start()

Locations = New DataTable
Locations.Columns.Add("X", GetType(System.Int32))
Locations.Columns.Add("Y", GetType(System.Int32))

Dim points As List(Of Point) = FindImagesL2R(Image1, Image2, Tolerance, True)

Found= False
If points.Count>0 Then
	For Each p As Point In points
		Dim r As DataRow = Locations.NewRow()
		Found = True
		r("X") = p.X
		r("Y") = p.Y
		Locations.Rows.Add(r)
	Next
End If

s.Stop()
MS = s.ElapsedMilliseconds()]]></code></stage><stage stageid="56d3004b-707b-46a0-b159-a3ef34bb17d3" name="End2" type="End"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="15" y="150" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="950aad91-ddbd-4069-bbdf-9bae942b99de" name="Note1" type="Note"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><narrative>No equivalent current method</narrative><display x="15" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>56d3004b-707b-46a0-b159-a3ef34bb17d3</onsuccess></stage><stage stageid="5ed32315-297a-4791-8490-9e14add5f9ea" name="Image1" type="Data"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="-255" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="efdb20db-a103-4d9d-90cf-118c49f22e8d" name="Image2" type="Data"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="-195" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e5e730f8-a34b-4058-af8e-190afb9fb509" name="Tolerance" type="Data"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><display x="-135" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="1cb4592a-61dd-4fe4-9a6a-9bcddd561d44" name="Locations" type="Collection"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><display x="-255" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="edd2d094-14ab-455