ysis" /></steps></stage><stage stageid="38608d76-2a83-4252-9ca3-2d2907534866" name="Mark as read mail" type="SubSheetInfo"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><narrative>Mark as read mail</narrative><display x="-420" y="-105" w="150" h="90" /></stage><stage stageid="aea979c5-f86e-41f5-ab1c-feac842cf3e4" name="Start" type="Start"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="15" y="-105" /><inputs><input type="text" name="Entry ID" narrative="Get Entry ID " stage="Entry ID" /><input type="text" name="Destination Folder" narrative="Read Email Destination Folder" stage="Destination Folder" /></inputs><onsuccess>de6c1ed5-bab8-4668-b46f-ad68971ff7f4</onsuccess></stage><stage stageid="d8512526-c8f1-411b-93ae-2d8b7699d051" name="End" type="End"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="15" y="75" /></stage><stage stageid="de6c1ed5-bab8-4668-b46f-ad68971ff7f4" name="Mark Email As Read" type="Action"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="15" y="-45" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." expr="[Entry ID]" /></inputs><onsuccess>1ae1b643-373d-494b-9eac-ed8f400b2fbc</onsuccess><resource object="MS Outlook Email VBO" action="Mark Email As Read" /></stage><stage stageid="50d6c2d3-5950-4bc1-ba1a-37eba625612a" name="Entry ID" type="Data"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="-210" y="-30" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1ae1b643-373d-494b-9eac-ed8f400b2fbc" name="Move Email" type="Action"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="15" y="15" /><inputs><input type="text" name="Entry ID" narrative="Mandatory. An ID obtained from one of the Get Item actions in this object. NB not the same as a Mapiex ID." expr="[Entry ID]" /><input type="text" name="Destination Folder" narrative="Mandatory. Any alphanumeric value valid. The Subfolder in the Inbox, eg. Subfolder A needs to be declared as &quot;Subfolder A&quot;. A Nested Subfolder eg. Subfolder B in Subfolder A, needs to be declared as &quot;Subfolder A\Subfolder B&quot;." expr="[Destination Folder]" /></inputs><outputs><output type="text" name="New Entry ID" narrative="Returns the new Entry ID from the Moved Email Object" stage="New Entry ID" /></outputs><onsuccess>d8512526-c8f1-411b-93ae-2d8b7699d051</onsuccess><resource object="MS Outlook Email VBO" action="Move Email to Inbox Sub Folder" /></stage><stage stageid="29aa03f5-6003-4aca-bcf6-678e66c6fb26" name="New Entry ID" type="Data"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="-210" y="-120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="969d3b70-ca6d-490c-9e9f-c3a15701e4fa" name="Mark as read mail" type="SubSheet"><display x="375" y="405" w="90" h="60" /><inputs><input type="text" name="Entry ID" narrative="Get Entry ID " expr="[Item Data.EntryID]" /><input type="text" name="Destination Folder" narrative="Read Email Destination Folder" expr="[ConfigFileData.ReadEmail_DestinationPath]" /></inputs><onsuccess>e3035b4a-aba4-4fa5-932e-cbaab6a81b7b</onsuccess><processid>38206b0b-1112-479e-bece-4bb26df0c041</processid></stage><stage stageid="73f5e42e-fc14-4e2b-8fe0-d0f363226b89" name="Destination Folder" type="Data"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="-210" y="15" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4cd92d25-5d6f-4875-b7f7-b6505be77f1e" name="Input" type="Block"><subsheetid>38206b0b-1112-479e-bece-4bb26df0c041</subsheetid><display x="-270" y="-60" w="120" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="da96cc3f-eb01-4102-948b-c61532be2aa8" name="