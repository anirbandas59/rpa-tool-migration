="flag" name="Enable Events" narrative="Flag to indicate that events should be enabled / disabled on the attached instance - defaulted to True" expr="True" /></inputs><outputs><output type="number" name="handle" narrative="An integer which can be used to identify the created instance in subsequent actions" stage="handle" /></outputs><onsuccess>de41421a-c61d-4772-9fb2-e8b368ed4a86</onsuccess><resource object="MS Excel VBO" action="Create Instance" /></stage><stage stageid="4aab50d0-ae1b-43dd-adb4-60524310d313" name="handle" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-225" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="de41421a-c61d-4772-9fb2-e8b368ed4a86" name="Open  WorkBook" type="Action"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="15" y="-30" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." expr="[SummaryFilePath]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="Workbook Name" /></outputs><onsuccess>fecfc8e6-4f85-4773-aeaa-6bd4672a44ce</onsuccess><resource object="MS Excel VBO" action="Open Workbook" /></stage><stage stageid="86305491-9b11-4a38-a62b-cb862ccf79e4" name="Workbook Name" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-330" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d4fc445f-96ee-41ed-8042-d3c28a773bfd" name="Sammary_WorkSheet" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-255" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fecfc8e6-4f85-4773-aeaa-6bd4672a44ce" name="Write Collection" type="Action"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="15" y="15" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the specified collection should be written. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook within which the data should be written. The default empty value indicates the current workbook within the specified instance." expr="[Workbook Name]" /><input type="text" name="Worksheet Name" narrative="The name of the worksheet on which the given data should be written. The default empty value indicates the current sheet within the specified workbook." expr="[Sammary_WorkSheet]" /><input type="collection" name="Collection" narrative="The collection containing the data which should be written to the worksheet." expr="[Sammary_Collection]" /><input type="text" name="Cell Reference" narrative="The reference at which the collection should be written." expr="&quot;A2&quot;" /><input type="flag" name="Include Column Names" narrative="True to indicate that the column names from the collection should be written out as the first row; False to ignore the column names and just write out the data." expr="False" /></inputs><onsuccess>31e1e894-0c5e-4906-8d90-d381833c1599</onsuccess><resource object="MS Excel VBO" action="Write Collection" /></stage><stage stageid="3a5fae18-fe2e-424a-9835-0e6c6ffed3d7" name="UnAuthorise" type="Data"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><display x="-510" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="fd0674d9-26e9-425d-9df7-d45effbf1836" name="Close Reslut Entry Screen" type="Action"><subsheetid>b7af32c8-b45a-495e-aa58-8684cc