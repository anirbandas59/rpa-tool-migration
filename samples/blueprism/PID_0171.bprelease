ments" narrative="Optional, Comma-separated file paths. Default blank." expr="[File Path]" /></inputs><onsuccess>633fd161-818b-4334-964c-4a693b5b6003</onsuccess><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="4ef76e7b-d62f-49cd-8f52-25a298bf3c85" name="SystemException_Maiil ID" type="Data"><subsheetid>df99780d-ef83-461d-b3a0-64f409d7d8b7</subsheetid><display x="-150" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b8beeb46-bd36-4815-a91a-7fc1f61fa0a6" name="BusinessException_Mail ID" type="Data"><subsheetid>df99780d-ef83-461d-b3a0-64f409d7d8b7</subsheetid><display x="-240" y="-30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="317c0204-dccb-44b4-aaf6-d7732178d0d0" name="Get Mails" type="SubSheetInfo"><subsheetid>86fc3e93-0638-449a-ac6a-54e5c8da7098</subsheetid><narrative>Get Mails from Outlook </narrative><display x="-195" y="-210" w="150" h="90" /></stage><stage stageid="de561dfc-32b4-4850-8f73-b6d8079b4aba" name="Start" type="Start"><subsheetid>86fc3e93-0638-449a-ac6a-54e5c8da7098</subsheetid><display x="45" y="-120" /><inputs><input type="text" name="Sender Mail ID" narrative="Sender Mail ID" stage="Sender Mail ID" /><input type="text" name="Sender Name" narrative="Sender Name" stage="Sender Name" /><input type="text" name="Subject" narrative="Mail Subject" stage="Subject" /><input type="text" name="Input File Path" narrative="Attachment Path" stage="Input File Path" /><input type="text" name="MailBoxName" narrative="MailBoxName" stage="MailBoxName" /><input type="text" name="Sub Folder" narrative="Sub Folder" stage="Sub Folder" /></inputs><onsuccess>93e160e5-e185-4775-8373-5071720a129b</onsuccess></stage><stage stageid="26beaee2-ff5e-4c3f-a054-5f1367173e56" name="End" type="End"><subsheetid>86fc3e93-0638-449a-ac6a-54e5c8da7098</subsheetid><display x="45" y="120" /><outputs><output type="collection" name="Mail Items" narrative="Ge