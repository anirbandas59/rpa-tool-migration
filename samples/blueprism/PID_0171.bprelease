ccess><groupid>755a928d-1109-4393-b44a-e265a1395a22</groupid></stage><stage stageid="15f784c0-4879-4a2e-ab6f-c44f5c384d85" name="Field Names" type="Collection"><subsheetid>4d41bfc8-e552-41ae-9e45-65dc3d1f7276</subsheetid><display x="-135" y="120" w="150" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Field Name" type="text" /><field name="Data Type" type="text" /></collectioninfo></stage><stage stageid="905724f1-237f-4641-9511-289841ec3498" name="Exists" type="Data"><subsheetid>4d41bfc8-e552-41ae-9e45-65dc3d1f7276</subsheetid><display x="-135" y="255" w="150" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>flag</datatype><initialvalue>False</initialvalue><private /><alwaysinit /></stage><stage stageid="eb7af2be-1265-40b6-8ea7-89fdda2b0ab1" name="Match?" type="Decision"><subsheetid>4d41bfc8-e552-41ae-9e45-65dc3d1f7276</subsheetid><loginhibit /><display x="75" y="120" w="90" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Field Names.Field Name] = Trim([Field])" /><ontrue>c4532590-c3c0-4014-98f4-bc3e1f30e5df</ontrue><onfalse>54fa6a7b-f874-43d4-ac4a-4c16f28d1a9f</onfalse></stage><stage stageid="d656772f-8ec9-4848-8f30-a4bda4f01837" name="anchor2" type="Anchor"><subsheetid>4d41bfc8-e552-41ae-9e45-65dc3d1f7276</subsheetid><loginhibit /><display x="210" y="255" w="10" h="10" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>26b8ca01-8895-483f-93ef-66df5bbb0a34</onsuccess></stage><stage stageid="c4532590-c3c0-4014-98f4-bc3e1f30e5df" name="Exists" type="Calculation"><subsheetid>4d41bfc8-e552-41ae-9e45-65dc3d1f7276</subsheetid><loginhibit /><display x="210" y="120" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>d656772f-8ec9-4848-8f30-a4bda4f01837</onsuccess><calculation expression="True" stage="Exists" /></stage><stage stageid="2e050fc0-fed0-49b4-bafc-a33a0aee5ad9" name="Success?" type="Decision"><subsheetid>3a772458-463d-46cf-8451-6cf5b4aeae30</subsheetid><loginhibit /><display x="15" y="15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><decision expression="[Success]" /><ontrue>c491f60e-4aa7-4abb-a203-5a78c0b64469</ontrue><onfalse>510a1b6e-59d7-40a0-8886-483ef66093e9</onfalse></stage><stage stageid="510a1b6e-59d7-40a0-8886-483ef66093e9" name="FAIL" type="Exception"><subsheetid>3a772458-463d-46cf-8451-6cf5b4aeae30</subsheetid><display x="120" y="15" w="30" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><exception type="UtilityException" detail="&quot;Error occurred removing null rows: &quot; &amp; [Message]" /></stage><stage stageid="aca9c6e7-7ae7-4b8f-a928-4716ad3acbd8" name="----------------------------Extended Features----------------------------" type="SubSheetInfo"><subsheetid>25c51866-af1a-42f0-a31a-e135fa55ced8</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7fcadaca-11de-4b5e-8dce-7b88b0d061be" name="Start" type="Start"><subsheetid>25c51866-af1a-42f0-a31a-e135fa55ced8</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>e214d8cf-6133-4021-9178-f94f8ca8dd0e</onsuccess></stage><stage stageid="e214d8cf-6133-4021-9178-f94f8ca8dd0e" name="End" type="End"><subsheetid>25c51866-af1a-42f0-a31a-e135fa55ced8</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="90199f80-f97f-449e-a317-48f62212f4ea" name="Remove Empty Columns" type="SubSheetInfo"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><narrative>Removes all the empty columns from the input collection</narrative><display x="-330" y="-60" w="150" h="90" /></stage><stage stageid="43e6a7af-9c9a-43a2-b494-5e3be106abcd" name="End" type="End"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Collection Out" narrative="Collection with all the empty columns removed" stage="Collection Out" /></outputs></stage><stage stageid="402ae32a-afe4-4df1-b3a0-b78e46e69eef" name="Start" type="Start"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><preconditions><condition narrative="None." /></preconditions><postconditions><condition narrative="The collection will have empty columns removed." /></postconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Collection In" narrative="The collection to remove empty columns from" stage="Collection In" /></inputs><onsuccess>d633ece1-2b52-4efd-9823-24590d732097</onsuccess></stage><stage stageid="bd187c10-9389-43fd-931f-c4c1c43cea95" name="End" type="End"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><outputs><output type="collection" name="Collection Out" narrative="Collection with all the empty columns removed" stage="Collection Out" /></outputs></stage><stage stageid="8e74412c-a87c-44af-82e7-7faf6c6adcf3" name="Collection In" type="Collection"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><display x="-165" y="-60" w="120" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="5a7aa797-8be6-48a0-9358-8b9caf6e0a50" name="Collection Out" type="Collection"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><display x="-165" y="45" w="120" h="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="d633ece1-2b52-4efd-9823-24590d732097" name="Remove empty Columns" type="Code"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="collection" name="Collection In" expr="[Collection In]" /></inputs><outputs><output type="collection" name="Collection Out" stage="Collection Out" /></outputs><onsuccess>bd187c10-9389-43fd-931f-c4c1c43cea95</onsuccess><code><![CDATA[Dim bRemove as Boolean
Dim iRow as integer
Dim iCol as integer

' Loop through each column
For iCol = Collection_In.Columns.Count - 1 to 0 step -1
	bRemove = True
	'Loop through each row
	For iRow = Collection_In.Rows.Count - 1 to 0 step -1
		'Check if the content is not empty and set the flag as false
		If Trim(Collection_In.Rows(iRow)(iCol).ToString()) & "" <> "" then
			bRemove = False
			exit for
		end if
	Next
	'Check if for all rows the column is blank and remove the column
	if bRemove = True then
		Collection_In.Columns.Remove(Collection_In.Columns(iCol))
	end if
Next

'Set output parameter
Collection_Out = Collection_In.Copy]]></code></stage><stage stageid="db3a8656-064e-4294-873d-c0dd8b01e361" name="Input parameters" type="Block"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><display x="-240" y="-105" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="000a6e34-7343-4f66-85cc-1769cf093e97" name="Output parameters" type="Block"><subsheetid>7d2d4b73-fb4c-4bf3-a11b-a148364c18cc</subsheetid><loginhibit /><display x="-240" y="0" w="150" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="f54b62cf-b53b-42d5-a452-07ca71713ba7" name="Remove Duplicates from Collection" type="SubSheetInfo"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><narrative>Object to remove duplicates from collection</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="9013a697-595a-42f7-8015-61ecc97a4e96" name="Start" type="Start"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="collection" name="Input Collection" narrative="Collection with duplicates" stage="Input_Collection" /><input type="text" name="Column Name" narrative="Column Name to Remove Duplicates" stage="Column_Name" /></inputs><onsuccess>8d13eb36-97cc-4b43-a93a-cb78e69c86a2</onsuccess></stage><stage stageid="cf17d959-26ea-498c-a260-db19d883f1de" name="End" type="End"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="Output Collection" narrative="Output Colelction Name" stage="Output_Collection" /></outputs></stage><stage stageid="8d13eb36-97cc-4b43-a93a-cb78e69c86a2" name="Remove Duplicates from Collection" type="Code"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="15" y="-15" w="90" h="60" /><inputs><input type="collection" name="input_collection" expr="[Input_Collection]" /><input type="text" name="column_name" expr="[Column_Name]" /></inputs><outputs><output type="collection" name="output_collection" stage="Output_Collection" /></outputs><onsuccess>cf17d959-26ea-498c-a260-db19d883f1de</onsuccess><code><![CDATA[Dim newvar as string

Dim aRowData As String

output_collection = new DataTable()

output_collection.Columns.Add(column_name, GetType(String))

For Each aRow as DataRow In input_Collection.Rows

aRowData = CStr(aRow(column_name))

newvar = aRowData.Replace("*", " ")


output_collection.Rows.Add(newvar)

Next

]]></code></stage><stage stageid="9e80aacc-37db-4de7-8405-37a3e8c21bfc" name="Output_Collection" type="Collection"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><display x="150" y="-15" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="824431ce-a0c1-42ec-bee8-abef12be8171" name="Input_Collection" type="Collection"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="150" y="-75" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="e8a802b4-67cc-4772-984c-84047e07aafd" name="Column_Name" type="Data"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="150" y="45" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a78a1877-2ceb-404e-8a30-bba45a9b758e" name="Input Parameters" type="Block"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="90" y="-120" w="120" h="210" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="18893f40-a811-494c-aee3-48d90303381e" name="Exception" type="Exception"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><display x="-135" y="90" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="32f0af87-33af-44d0-a832-90b9af3ac79e" name="Recover" type="Recover"><subsheetid>28b19cc5-7346-4c4f-a0b0-9431114b2317</subsheetid><loginhibit /><display x="-135" y="0" /><onsuccess>18893f40-a811-494c-aee3-48d90303381e</onsuccess></stage><stage stageid="3f075ad2-37e2-446a-8d5f-7ce5c06703fb" name="Compare Collection" type="SubSheetInfo"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><narrative>Object to Compare 2 collection and return unique values in output collection.</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="afed3d98-7fcb-4d17-81b9-c5163fac1351" name="Start" type="Start"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="-135" /><inputs><input type="collection" name="Input Collection 1" narrative="Collection 1 Name" stage="input_collection1" /><input type="collection" name="Input Collection 2" narrative="Collection 2 Name" stage="input_collection2" /><input type="text" name="Column Name" narrative="Name of the column to be compared " stage="Column_Name" /></inputs><onsuccess>1dd85246-bfe0-4e11-b89a-5d7cb6cfa845</onsuccess></stage><stage stageid="aaf083a7-4c98-4356-9baf-7a459d18d0ff" name="End" type="End"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="60" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection Name" stage="output_collection" /></outputs></stage><stage stageid="1dd85246-bfe0-4e11-b89a-5d7cb6cfa845" name="Compare Collection" type="Code"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="135" y="-45" w="90" h="60" /><inputs><input type="collection" name="input_collection1" expr="[input_collection1]" /><input type="collection" name="input_collection2" expr="[input_collection2]" /><input type="text" name="column_name" expr="[Column_Name]" /></inputs><outputs><output type="collection" name="output_collection" stage="output_collection" /></outputs><onsuccess>aaf083a7-4c98-4356-9baf-7a459d18d0ff</onsuccess><code><![CDATA[Dim aRowData As String

Dim bRowData As String

Dim temp As Integer 

output_collection = new DataTable()

output_collection.Columns.Add(column_name, GetType(String))

For Each aRow as DataRow In input_Collection1.Rows
temp = 0
aRowData = CStr(aRow(column_name))

For Each bRow As DataRow In input_collection2.Rows

bRowData = CStr(bRow(column_name))

If bRowData.contains(aRowData) Then
temp = 1
end if

Next
If temp = 0 then
output_collection.Rows.Add(new Object() {aRowData})
end if


Next

]]></code></stage><stage stageid="741b8493-626d-4f3d-a856-8f79d652ee58" name="output_collection" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><display x="-60" y="0" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="d49c6a3b-a373-415b-aeb8-44c54be436bb" name="input_collection1" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-225" y="-15" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="66be3f08-3928-4c7d-bfcb-797cecbce10c" name="input_collection2" type="Collection"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-225" y="30" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="e61c44c5-6eb4-47a2-95bd-f6132f39a224" name="Column_Name" type="Data"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><display x="-225" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="87010318-e5a5-4750-be07-0835ba6d112e" name="Input Parameters" type="Block"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-285" y="-45" w="135" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="66b424f5-547f-4352-a19b-b55eb216ecfb" name="Output Parameters" type="Block"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-120" y="-45" w="120" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="64a31e51-f13b-43cb-8567-0ccb5176a8fc" name="Recover" type="Recover"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><loginhibit /><display x="-405" y="-30" /><onsuccess>e0bc8874-0327-43b4-ac05-5f1f4ead9e7a</onsuccess></stage><stage stageid="e0bc8874-0327-43b4-ac05-5f1f4ead9e7a" name="Exception" type="Exception"><subsheetid>71bf3f8b-23ef-4b94-91a0-7589fbcdc1cf</subsheetid><display x="-405" y="75" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="d30d9c7b-327c-4257-af93-0b881f2a7732" name="Compare Collection - with vlookup" type="SubSheetInfo"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><narrative>Object to Compare 2 collection and return unique values in output collection.with vlookup</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="c148a53b-84f1-40a2-91d5-233dd3859d46" name="Start" type="Start"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="135" y="-135" /><inputs><input type="collection" name="Input Collection 1" narrative="Input Collection 1 Name" stage="input_collection1" /><input type="collection" name="Input Collection 2" narrative="Input Collection 2 Name" stage="input_collection2" /><input type="text" name="Column Name" narrative="Name of the column to be compared " stage="Column_Name" /><input type="text" name="Vlookup" narrative="Vlookup Column" stage="vlookup_column" /></inputs><onsuccess>e9fab988-3b2f-463e-98ef-7f2ccc0b3f0f</onsuccess></stage><stage stageid="3d6882bd-fea4-436d-8d41-6e7ca0db30cb" name="End" type="End"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="135" y="60" /><outputs><output type="collection" name="Output Collection" narrative="Output Collection Name" stage="output_collection" /></outputs></stage><stage stageid="e9fab988-3b2f-463e-98ef-7f2ccc0b3f0f" name="Compare Collection - with vlookUp" type="Code"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="135" y="-45" w="90" h="60" /><inputs><input type="collection" name="input_collection1" expr="[input_collection1]" /><input type="collection" name="input_collection2" expr="[input_collection2]" /><input type="text" name="column_name" expr="[Column_Name]" /><input type="text" name="vlookup_column" expr="[vlookup_column]" /></inputs><outputs><output type="collection" name="output_collection" stage="output_collection" /></outputs><onsuccess>3d6882bd-fea4-436d-8d41-6e7ca0db30cb</onsuccess><code><![CDATA[Dim aRowData As String
Dim vlookup As String
Dim bRowData As String

Dim temp As Integer 

output_collection = new DataTable()

output_collection.Columns.Add(column_name, GetType(String))

output_collection.Columns.Add(vlookup_column, GetType(String))

For Each aRow as DataRow In input_Collection1.Rows
temp = 0
aRowData = CStr(aRow(column_name))
vlookup = CStr(aRow(vlookup_column))

For Each bRow As DataRow In input_collection2.Rows

bRowData = CStr(bRow(column_name))

If bRowData.contains(aRowData) Then
temp = 1
end if

Next
If temp = 0 then
output_collection.Rows.Add(new Object() {aRowData,vlookup})

end if


Next

]]></code></stage><stage stageid="5e1a61de-6f15-4106-bfc4-159cec83f79e" name="output_collection" type="Collection"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><display x="-60" y="0" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="c33c5a0c-7b33-45c8-b7ac-46b6275d1e30" name="input_collection1" type="Collection"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="-225" y="-15" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="b3c3bf9f-64d7-4bb7-b50a-ee8e23a9da9a" name="input_collection2" type="Collection"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="-225" y="30" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="39fac2fd-39de-453d-b2fb-5bd508d75fc3" name="Column_Name" type="Data"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><display x="-225" y="75" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6e2ede43-1523-4cb5-b24b-d9fef06e5099" name="Input Parameters" type="Block"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="-285" y="-45" w="135" h="195" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7763b276-9536-4bb6-ba97-acc80eec19bc" name="Output Parameters" type="Block"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><loginhibit /><display x="-120" y="-45" w="120" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="798dbdca-6cca-44e4-bdf9-b38b7be88e81" name="vlookup_column" type="Data"><subsheetid>f4648080-ddda-4a02-b60f-7158d4ac5874</subsheetid><display x="-225" y="120" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="40c414d9-56ca-4703-ab96-47ce637221c8" name="Recover" t