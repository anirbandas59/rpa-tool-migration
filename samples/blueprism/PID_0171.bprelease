a82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="-240" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="146d635e-36c8-4c6b-a6d6-623bb1f6b2ef" name="Image2" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="-180" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5332f575-9d77-4620-95e3-6fdfd29767fc" name="Tolerance" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="-120" y="-30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="755b909f-e94f-467b-b56a-bf55440458e9" name="T1" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><display x="-120" y="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="83997500-f9a8-48b7-9ad4-b80c5ea5f472" name="T2" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><display x="-120" y="135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="95a3174d-71bc-4092-b541-c874cde8dc02" name="Note1" type="Note"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><narrative>New method with timestamp output added</narrative><display x="15" y="-15" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>9f41f230-66e8-476f-a706-ec93445dc776</onsuccess></stage><stage stageid="868cb219-b215-448a-bcf8-af6654a1cfd1" name="Note1" type="Note"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><narrative>Current method with timestamp output added</narrative><display x="15" y="90" w="120" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>8e151130-323c-4500-9a87-5cc4ca625508</onsuccess></stage><stage stageid="9f41f230-66e8-476f-a706-ec93445dc776" name="Find Image By Colour TEST" type="Code"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="15" y="30" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="image" name="Image1" expr="[Image1]" /><input type="image" name="Image2" expr="[Image2]" /><input type="number" name="R" expr="255" /><input type="number" name="G" expr="255" /><input type="number" name="B" expr="255" /></inputs><outputs><output type="flag" name="Found" stage="Found" /><output type="number" name="X" stage="X" /><output type="number" name="Y" stage="Y" /><output type="number" name="MS" stage="T1" /></outputs><onsuccess>868cb219-b215-448a-bcf8-af6654a1cfd1</onsuccess><code><![CDATA[Dim s As New System.Diagnostics.Stopwatch
s.Start()

R = Math.Min(Math.Max(0, R), 255)
G = Math.Min(Math.Max(0, G), 255)
B = Math.Min(Math.Max(0, G), 255)
Dim c As Color = Color.FromARGB(R, G, B)

Dim points As List(Of Point) = FindImagesByColour(Image1, Image2, c, False)

For Each p As Point In points
	Found = True
	X = p.X
	Y = p.Y

s.Stop()
MS = s.ElapsedMilliseconds()

	Exit Sub
Next

Found = False
X = -1
Y = -1

s.Stop()
MS = s.ElapsedMilliseconds()]]></code></stage><stage stageid="8e151130-323c-4500-9a87-5cc4ca625508" name="Detect Partial Image1" type="Code"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="15" y="135" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="image" name="Potential SubImage" expr="[Image2]" /><input type="image" name="Main Image" expr="[Image1]" /></inputs><outputs><output type="number" name="X Index" stage="X Index" /><output type="number" name="Y Index" stage="Y Index" /><output type="flag" name="Contained" stage="Contained" /><output type="number" name="MS" stage="T2" /></outputs><onsuccess>6de1df50-90e8-45ea-aaba-838e1678229f</onsuccess><code><![CDATA[Dim s As New System.Diagnostics.Stopwatch
s.Start()

Contained = False

Dim bmPartial as Bitmap = ctype(Potential_SubImage, bitmap)
Dim bmCaptured as bitmap = ctype(Main_Image, bitmap)

Dim i As Integer = 0
Dim j As Integer = 0
For i = 0 to bmCaptured.Width - bmPartial.Width 
   For j = 0 to bmCaptured.Height - bmPartial.Height 
      Dim IsSubImage as Boolean = True
      For x as integer = 0 to bmpartial.width -1
         For y as integer = 0 to bmpartial.height -1
            If bmCaptured.GetPixel(i+x,j+y).ToArgb() <> bmPartial.GetPixel(x,y).ToArgb()
               IsSubImage = False
               Goto NextAnchor
            End If
         Next
      Next

NextAnchor:
      If IsSubImage Then
         X_Index = i
         Y_Index = j
         Contained = True

s.Stop()
MS = s.ElapsedMilliseconds()

         Exit Sub
      End If

   Next
Next

X_Index = -1
Y_Index = -1
Contained = False

s.Stop()
MS = s.ElapsedMilliseconds()]]></code></stage><stage stageid="9edd133c-411c-431d-978a-ca086ccff11b" name="ImageB1" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="195" y="-210" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>1023,631,137224,</initialvalue><private /><alwaysinit /></stage><stage stageid="685730f6-b111-4d75-9219-aa3bd90533e7" name="ImageB2" type="Data"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="195" y="-180" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>image</datatype><initialvalue>28,12,137224,iVBORw0KGgoAAAANSUhEUgAAABwAAAAMCAIAAAD+uUpYAAAAT0lEQVQ4T9WMQQoAIAgE/f+nTcjELY0QOjindVal7zCzpoh7m9LzqeSJzqt9kYAVfsNLny2cEgjrggQK96EECvehVGTe1DSCzsl9ttACogEHt6RcOb5bKAAAAABJRU5ErkJggg==</initialvalue><private /><alwaysinit /></stage><stage stageid="35bddc6e-acb5-4031-b740-f390a3cd2452" name="Test B" type="MultipleCalculation"><subsheetid>034aa82b-4f3a-4db5-9a82-dbeefc079c49</subsheetid><loginhibit /><display x="195" y="-135" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>95a3174d-71bc-4092-b541-c874cde8dc02</onsuccess><steps><calculation expression="[ImageB1]" stage="Image1" /><calculation expression="[ImageB2]" stage="Image2" /></steps></stage><stage stageid="9e68d195-c705-4516-924e-717cbc57400b" name="Note2" type="Note"><subsheetid>ae7c74d2-8181-4edc-87bb-0f2c0853dad6</subsheetid><loginhibit /><narrative>TEST PAGE ONLY, TO BE DELETED</narrative><display x="225" y="30" w="210" h="150" /><font family="Tahoma" size="14" style="Bold" color="FF0000" /></stage><stage stageid="c138a76e-fae2-4e0c-b628-51848ba47a2e" name="Note2" type="Note"><subsheetid>575f7bc4-7c9b-404a-a86d-f6807e9c86f3</subsheetid><loginhibit /><narrative>TEST PAGE ONLY, TO BE DELETED</narrative><display x="210" y="90" w="210" h="150" /><font family="Tahoma" size="14" style="Bold" color