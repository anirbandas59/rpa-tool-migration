stageid="78bb24c0-ce31-49f1-a159-b81a000d2b4a" name="Anchor7" type="Anchor"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="15" y="135" w="10" h="10" /><onsuccess>12516427-beb7-4345-b8ee-e479db6f5795</onsuccess></stage><stage stageid="b46ceec0-c051-4fde-b4dc-1e8243abe42b" name="Resource" type="Data"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="-360" y="210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c9ebd312-5b15-46f1-9503-fa89b3ca26b7" name="Sharepoint App Client ID" type="Data"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><narrative>This is not the same as an Azure App ID. This is the client ID generated from the sharepoint admin screens</narrative><display x="-360" y="180" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="2444b701-fb04-43fe-92d9-f8f8c4e5055c" name="Client ID" type="Data"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="-360" y="-15" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="74362798-b439-4fb1-a6d2-732627be3e3a" name="Tenant ID" type="Data"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="-360" y="-45" w="120" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="ce2a9cfa-8547-4ec5-84a3-20802dc18646" name="Recover" type="Recover"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><loginhibit /><display x="-180" y="60" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>1dbf7a16-eab8-4cfa-b140-333500a689f7</onsuccess></stage><stage stageid="1dbf7a16-eab8-4cfa-b140-333500a689f7" name="Exception" type="Exception"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="-180" y="135" /><exception localized="yes" type="" detail="" usecurrent="yes" /></stage><stage stageid="c6420cce-03e7-4e14-9c6d-732cf7480f42" name="URL Sub Site" type="Data"><subsheetid>28624cb7-7f33-4857-ba88-33aa31ce4220</subsheetid><display x="-450" y="150" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d1572aeb-f751-4860-a174-f6873828973d" name="Folder Exists ?" type="Decision"><display x="105" y="-60" /><decision expression="[Folder Exists ?]" /><ontrue>4ab58101-973f-42d3-aab0-efe82d985353</ontrue><onfalse>3829b876-599d-4ff5-b0cb-6dc0b18b4a54</onfalse></stage><stage stageid="3829b876-599d-4ff5-b0cb-6dc0b18b4a54" name="Exception" type="Exception"><display x="195" y="-60" /><exception type="System Unavailable Exception" detail="&quot;Sharepoint API Utility &gt;&gt; API Error. Blueprism Exception : &quot; &amp;[Exception Detail] " /></stage><stage stageid="ffa86b27-bde2-4436-b48c-d96fdf3d7c85" name="Downloaded ?" type="Data"><display x="-360" y="165" w="120" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="693be145-8b78-4805-996d-1fe497d4ee46" name="Download File - Processed Parameters" type="Block"><display x="-450" y="120" w="180" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="df9f420d-e684-4867-8136-096767196628" name="Sharepoint_Folder_Path" type="Data"><display x="-570" y="-270" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a589e265-afe1-4ede-9b97-286f795101bd" name="Input Parameters" type="Block"><display x="-645" y="-315" w="150" h="135" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="e6ef3ac2-7731-4151-9017-be8afe1889f0" name="Config_File_Name" type="Data"><display x="-570" y="-240" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9a85ba27-7c62-4cab-8e7d-714e64c9f72b" name="VM_Download_Path" type="Data"><display x="-570" y="-210" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="7dcb46be-fbf3-4c00-a0d9-cec157fc7dd1" name="Note" type="Note"><narrative>Tenant ID, Client ID and Client Secret key is derived from Blueprism credential manager.

Sharepoint URL is derived from Environment varibale - RPA_Sharepoint_URL

Sharepoint Bearer token is stored in credential manager -RPA_Sharepoint_Bearer_Token</narrative><display x="-300" y="-540" w="300" h="210" /></stage><stage stageid="f3ca92a0-5984-487e-9975-67f930665c5e" name="Example" type="Note"><narrative>Sharepoint Folder- eg. "/sites/AAFAA5234/RPAProjectDocument/"
Note that https://eu001-sp.shell.com/ is not used in folder path as it is automatically derived from Sharepoint URL.

Config File Name- eg - "config_PID_10_DS_ABC.xlsx"
Note that the Config file name has the file extension.

VM Download Path - eg. "C:\apps"
Config file will be downloaded to this path</narrative><display x="-630" y="-540" w="300" h="210" /></stage><stage stageid="c284eb34-fc19-4d20-a14f-4d0e3dcbeefa" name="VM File Name with Path" type="Calculation"><subsheetid>28624cb7-7f33-4857-ba88-33aa31ce4220</subsheetid><display x="30" y="135" /><onsuccess>74c51776-c8c3-4bfc-80f8-c16da40755c1</onsuccess><calculation expression="[VM_Path]&amp;[File_Name]" stage="VM File Name with Path" /></stage><stage stageid="f5b2ca46-3607-45ef-a180-3506610d7efd" name="VM File Name with Path" type="Data"><subsheetid>28624cb7-7f33-4857-ba88-33aa31ce4220</subsheetid><display x="-450" y="270" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e87454d8-28a3-4081-96d1-3832d5bea490" name="File Name with Path" type="Data"><display x="-360" y="195" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4ab58101-973f-42d3-aab0-efe82d985353" name="File Exists" type="SubSheet"><display x="105" y="-15" /><inputs><input type="text" name="Bearer Token Credetial Name" narrative="Credential Name for Bearer token" expr="[RPA_Sharepoint_Bearer_Token]" /><input type="text" name="Folder Path" narrative="Folder to check" expr="[Sharepoint_Folder_Path]&amp;[Config_File_Name]" /><input type="text" name="URL Business Entity" narrative="Business Entity URL obtained from Get URL Components action" expr="[URL - Business Entity]" /><input type="text" name="URL Subsite" narrative="Subsite URL obtained from Get URL Components action" expr="[URL - Subsite]" /></inputs><outputs><output type="flag" name="Folder Exists ?" narrative="Flag to check if Folder exists" stage="Config File Exists ?" /></outputs><onsuccess>d6c722f3-b213-4910-9f57-0b1e3f1c42f5</onsuccess><processid>4e9d820e-05ae-431b-9274-f250e2e8d849</processid></stage><stage stageid="d6c722f3-b213-4910-9f57-0b1e3f1c42f5" name="File Exists ?" type="Decision"><display x="105" y="30" /><decision expres