tive unless specified otherwise in the regular expression using &quot;(?i)&quot;" expr="" /></inputs><outputs><output type="flag" name="Contains Search Term" friendlyname="Contains Search Term" narrative="Flag indicating if the collection found the given search term or not" stage="Contains Search Term" /><output type="collection" name="Groups" friendlyname="Groups" narrative="The groups defined in the regular expression when it is applied to the found term" stage="" /></outputs><onsuccess>f738f533-3193-4368-9011-770c60308493</onsuccess><resource object="Utility - Collection Manipulation_Extended" action="Collection Contains Value" /></stage><stage stageid="a79ff1c7-7118-4109-9c2e-f6e30ccbd899" name="Update Dataitem" type="Calculation"><subsheetid>4e9d820e-05ae-431b-9274-f250e2e8d849</subsheetid><loginhibit onsuccess="true" /><display x="15" y="345" /><onsuccess>298995ec-56e9-4d4e-bb31-cf4763fdb938</onsuccess><calculation expression="[Response Headers.Column2]" stage="Retry-After" /></stage><stage stageid="8d797f36-804d-4100-a2e9-b2d812f4f083" name="Retry-After" type="Data"><subsheetid>4e9d820e-05ae-431b-9274-f250e2e8d849</subsheetid><display x="-255" y="270" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f738f533-3193-4368-9011-770c60308493" name="Retry-After Exists ?" type="Decision"><subsheetid>4e9d820e-05ae-431b-9274-f250e2e8d849</subsheetid><display x="15" y="255" /><decision expression="[Contains Search Term]" /><ontrue>da843eae-ef2a-46d8-8383-f50b30ed2883</ontrue><onfalse>3720a53f-2027-4eef-aa97-33e82d58ae26</onfalse></stage><stage stageid="3720a53f-2027-4eef-aa97-33e82d58ae26" name="Anchor8" type="Anchor"><subsheetid>4e9d820e-05ae-431b-9274-f250e2e8d849</subsheetid><loginhibit onsuccess="true" /><display x="75" y="255" w="10" h="10" /><onsuccess>6f520e05-c8e1-4ffd-bc6a-9299e1fe2ce6</onsuccess></stage><stage stageid="6f520e05-c8e1-4ffd-bc6a-9299e1fe2ce6" name="Anchor9" type="Anchor"><subsheetid>4e9d8