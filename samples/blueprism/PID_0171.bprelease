4c67343f53e" name="Start" type="Start"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><display x="-45" y="-135" /><onsuccess>66fadbac-6af3-4348-b061-207ced62cbfb</onsuccess></stage><stage stageid="a6b65de4-ede8-41e6-aaa9-4c8151229547" name="End" type="End"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><display x="-45" y="165" /></stage><stage stageid="1bd35938-a391-4bc6-bc67-b5b7447c65a0" name="Get Item Data" type="Action"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><loginhibit onsuccess="true" /><narrative>Get data relating to an item in a queue. You do not need to have a lock on the item to do this.</narrative><display x="-45" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item to get data from. An error will be raised if this item does not exist." expr="[Item ID]" /></inputs><outputs><output type="collection" name="Data" narrative="The data associated with the item - a single collection row." stage="" /><output type="text" name="Status" narrative="The status of the item." stage="Item Status" /><output type="number" name="Attempts" narrative="The number of attempts already made to work this item." stage="" /><output type="text" name="Key" friendlyname="Key" narrative="The key value of the item." stage="txt_ItemKey" /><output type="number" name="Priority" friendlyname="Priority" narrative="The priority of the item" stage="" /><output type="timespan" name="Worktime" friendlyname="Worktime" narrative="The total time spent on this item (including previous attempts)" stage="tmspan_Worktime" /><output type="timespan" name="Attempt Worktime" friendlyname="Attempt Worktime" narrative="The amount of time spent on this particular attempt of the item" stage="" /><output type="datetime" name="Loaded DateTime" friendlyname="Loaded DateTime" narrative="The date and time at which this item was first loaded into the queue." stage="datetm_Loaded DateTime" /><output type="datetime" name="Deferred DateTime" friendlyname="Deferred DateTime" narrative="The date and time at which this item has been deferred to. Empty if this item has not been deferred." stage="" /><output type="datetime" name="Completed DateTime" friendlyname="Completed DateTime" narrative="The date and time at which this item was marked as complete. Empty if this item has not been marked as complete" stage="datetm_Completed DateTime" /><output type="datetime" name="Exception DateTime" friendlyname="Exception DateTime" narrative="The date and time at which this item was marked as an exception. Empty if there has never been an exception on this item." stage="datetm_Exception DateTime" /><output type="text" name="Exception Reason" friendlyname="Exception Reason" narrative="The exception reason recorded against this item." stage="Exception Detail" /><output type="text" name="Tags" friendlyname="Tags" narrative="The semi-colon separated set of tags which apply to the item. " stage="" /></outputs><onsuccess>3d7701d1-2993-4627-810b-41d7222b4aaf</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Item Data" /></stage><stage stageid="48c8866a-7d15-4a42-8189-a4e0e4ae2121" name="Data Gateway Completed" type="Action"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><loginhibit onsuccess="true" /><display x="-90" y="105" /><inputs><input type="text" name="Process Name" friendlyname="Process Name" narrative="Process Name" expr="[ConfigFileData.ProcessName]" /><input type="text" name="Item Id" friendlyname="Item Id" narrative="Unique id to investigate from Blue Prism database" expr="[Item ID]" /><input type="text" name="Item Key" friendlyname="Item Key" narrative="Unique id to help business team connect to the transaction" expr="[txt_ItemKey]" /><input type="datetime" name="Input Data Received On" friendlyname="Input Data Received On" narrative="Time when input was available for the bot. Example Email reveived on, Input received from SAP etc." expr="[datetm_InputReceivedOn]" /><input type="datetime" name="Item Created On" friendlyname="Item Created On" narrative="Time when item is loaded into the queue" expr="[datetm_Loaded DateTime]" /><input type="datetime" name="Item Completed On" friendlyname="Item Completed On" narrative="Completed time for the item. Helps calculate TAT" expr="[datetm_Completed DateTime]" /><input type="timespan" name="Total Work Time" friendlyname="Total Work Time" narrative="Handling time for the transaction" expr="[tmspan_Worktime]" /><input type="text" name="Queue Item Status" friendlyname="Queue Item Status" narrative="COMPLETED, COMPLETED WITHOUT OUTCOME, SYSTEM EXCEPTION, BUSINESS EXCEPTION" expr="[Item Status]" /><input type="text" name="Final Outcome" friendlyname="Final Outcome" narrative="Applicable only in case of BUSINESS EXCEPTION, SYSTEM EXCEPTION or COMPLETED WITHOUT OUTCOME" expr="[Exception Detail]" /><input type="text" name="Resource VM" friendlyname="Resource VM" narrative="Resource VM name" expr="GetResourceName()" /></inputs><onsuccess>a6b65de4-ede8-41e6-aaa9-4c8151229547</onsuccess><resource object="Utility_DataGateways-CustomFramework" action="Send Data to Data Gateways" /></stage><stage stageid="66fadbac-6af3-4348-b061-207ced62cbfb" name="Send Data to Gateways" type="Decision"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><display x="-45" y="-75" /><decision expression="[flg_SendDatatoDataGateways]" /><ontrue>1bd35938-a391-4bc6-bc67-b5b7447c65a0</ontrue><onfalse>293a60a8-4c00-4c1a-b034-0d8d7ed865e4</onfalse></stage><stage stageid="3d7701d1-2993-4627-810b-41d7222b4aaf" name="Is Completed" type="Decision"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><display x="-45" y="45" /><decision expression="[flg_IsCompleted]" /><ontrue>48c8866a-7d15-4a42-8189-a4e0e4ae2121</ontrue><onfalse>9264d934-fc12-47ce-9f74-43cd434932dc</onfalse></stage><stage stageid="9264d934-fc12-47ce-9f74-43cd434932dc" name="Data Gateway Exception " type="Action"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><loginhibit onsuccess="true" /><display x="0" y="105" /><inputs><input type="text" name="Process Name" friendlyname="Process Name" narrative="Process Name" expr="[ConfigFileData.ProcessName]" /><input type="text" name="Item Id" friendlyname="Item Id" narrative="Unique id to investigate from Blue Prism database" expr="[Item ID]" /><input type="text" name="Item Key" friendlyname="Item Key" narrative="Unique id to help business team connect to the transaction" expr="[txt_ItemKey]" /><input type="datetime" name="Input Data Received On" friendlyname="Input Data Received On" narrative="Time when input was available for the bot. Example Email reveived on, Input received from SAP etc." expr="[datetm_InputReceivedOn]" /><input type="datetime" name="Item Created On" friendlyname="Item Created On" narrative="Time when item is loaded into the queue" expr="[datetm_Loaded DateTime]" /><input type="datetime" name="Item Completed On" friendlyname="Item Completed On" narrative="Completed time for the item. Helps calculate TAT" expr="[datetm_Exception DateTime]" /><input type="timespan" name="Total Work Time" friendlyname="Total Work Time" narrative="Handling time for the transaction" expr="[tmspan_Worktime]" /><input type="text" name="Queue Item Status" friendlyname="Queue Item Status" narrative="COMPLETED, COMPLETED WITHOUT OUTCOME, SYSTEM EXCEPTION, BUSINESS EXCEPTION" expr="[Item Status]" /><input type="text" name="Final Outcome" friendlyname="Final Outcome" narrative="Applicable only in case of BUSINESS EXCEPTION, SYSTEM EXCEPTION or COMPLETED WITHOUT OUTCOME" expr="[Exception Detail]" /><input type="text" name="Resource VM" friendlyname="Resource VM" narrative="Resource VM name" expr="GetResourceName()" /></inputs><onsuccess>a6b65de4-ede8-41e6-aaa9-4c8151229547</onsuccess><resource object="Utility_DataGateways-CustomFramework" action="Send Data to Data Gateways" /></stage><stage stageid="293a60a8-4c00-4c1a-b034-0d8d7ed865e4" name="End" type="End"><subsheetid>05a6c8a7-1f5d-408a-93c4-4074ca3a6c56</subsheetid><display x="45" y="-75" /></stage><stage stageid="ab905ad4-ee49-4a0a-9e77-6f2e775ac6ff" name="Completed No Outcome" type="SubSheetInfo"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>This page can be used to check if the current exception belongs to 'Completed Without Outcome' category

</narrative><display x="15" y="-240" w="180" h="60" /></stage><stage stageid="54bdb792-ba46-41d6-ab06-88c6def25844" name="Start" type="Start"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="330" y="-255" /><inputs><input type="text" name="Exception Type" narrative="Exception Type : Ex: SYSTEM EXCEPTION" stage="Exception Type" /></inputs><onsuccess>b0125a2a-deff-4f7b-8182-d71cb662ddaf</onsuccess></stage><stage stageid="f6ba92af-c558-4d83-a63d-f4f3fb6076f4" name="End" type="End"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="240" y="45" /></stage><stage stageid="b0125a2a-deff-4f7b-8182-d71cb662ddaf" name="Split Completed Wo Outcome Rules" type="Action"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="330" y="-195" /><inputs><input type="text" name="Text to Split" friendlyname="Text to Split" narrative="The text to split" expr="[ConfigFileData.Completed_without_outcome_msgs]" /><input type="text" name="Split Char" friendlyname="Split Char" narrative="The split delimiter" expr="&quot;,&quot;" /><input type="text" name="Collection Field Name" friendlyname="Collection Field Name" narrative="The name of the field for the resulting collection" expr="&quot;Exception&quot;" /></inputs><outputs><output type="collection" name="Split Values" friendlyname="Split Values" narrative="The resulting collection containing the split values" stage="coll_Exceptions" /></outputs><onsuccess>c5558065-b5af-40eb-bcf6-e73d74044312</onsuccess><resource object="Utility - Strings" action="Split Text" /></stage><stage stageid="9db9b55a-d37e-4719-b13c-ef5f1afa10e7" name="Check If Rule Is Found" type="Action"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="330" y="-75" /><inputs><input type="collection" name="Collection" friendlyname="Collection" narrative="Required : The collection to search" expr="[coll_Exceptions]" /><input type="text" name="Column Name" friendlyname="Column Name" narrative="Required : The name of the column to search" expr="&quot;Exception&quot;" /><input type="text" name="Exact Value" friendlyname="Exact Value" narrative="Optional : The exact value to search for - this is case insensitive" expr="[Exception Detail]" /><input type="text" name="Regex" friendlyname="Regex" narrative="Optional : The regular expression to search for - this is case sensitive unless specified otherwise in the regular expression using &quot;(?i)&quot;" expr="" /></inputs><outputs><output type="flag" name="Contains Search Term" friendlyname="Contains Search Term" narrative="Flag indicating if the collection found the given search term or not" stage="flg_Contains Search Term" /><output type="collection" name="Groups" friendlyname="Groups" narrative="The groups defined in the regular expression when it is applied to the found term" stage="" /></outputs><onsuccess>f7bc16b0-b287-465f-930e-2bb22ec8f4c9</onsuccess><resource object="Utility - Collection Manipulation_Extended" action="Collection Contains Value" /></stage><stage stageid="e3f1241d-a62e-4e40-aa64-ba666081aa74" name="flg_Contains Search Term" type="Data"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="15" y="-135" w="180" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f7bc16b0-b287-465f-930e-2bb22ec8f4c9" name="Completed Without Outcome" type="Decision"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="330" y="-15" /><decision expression="[flg_Contains Search Term]" /><ontrue>a04c9da2-2944-4036-8336-c70a13c15edd</ontrue><onfalse>f0d8e923-49d8-4e1f-a969-b9fbf3d43c0f</onfalse></stage><stage stageid="a04c9da2-2944-4036-8336-c70a13c15edd" name="Set Status" type="Action"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="240" y="-15" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;COMPLETED WITHOUT OUTCOME&quot;" /></inputs><onsuccess>f6ba92af-c558-4d83-a63d-f4f3fb6076f4</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="f0d8e923-49d8-4e1f-a969-b9fbf3d43c0f" name="Set Status" type="Action"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="330" y="45" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[Exception Type]" /></inputs><onsuccess>f6ba92af-c558-4d83-a63d-f4f3fb6076f4</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="a093621e-3443-4979-8439-bc6fadf487ec" name="Variables" type="Block"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="-75" y="-195" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7865e2a3-edb6-41ac-9b21-f3eb6b140755" name="Completed without outcome" type="Decision"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="150" y="-15" /><decision expression="InStr([txt_Exception Detail],[coll_Exceptions.Exception])&gt;0" /><ontrue>a04c9da2-2944-4036-8336-c70a13c15edd</ontrue><onfalse>3fe1222d-06b4-4893-ae02-587c250e58e4</onfalse></stage><stage stageid="3f42cf9d-40b7-4f98-b475-1011c91921a2" name="Exceptions" type="LoopStart"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="150" y="-75" /><onsuccess>7865e2a3-edb6-41ac-9b21-f3eb6b140755</onsuccess><groupid>12dd7abc-dc2e-4ac0-8620-926566d33618</groupid><looptype>ForEach</looptype><loopdata>coll_Exceptions</loopdata></stage><stage stageid="3fe1222d-06b4-4893-ae02-587c250e58e4" name="Exceptions" type="LoopEnd"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="150" y="45" /><onsuccess>24e3f04e-b9a7-4eff-91be-3f2f9241593e</onsuccess><groupid>12dd7abc-dc2e-4ac0-8620-926566d33618</groupid></stage><stage stageid="d5c5d010-7cc6-43d4-baec-e8f8461fe2df" name="Aprox Match                      /                        Exact Match" type="Block"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="120" y="-225" w="330" h="285" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5e877744-5331-41e1-a3f9-de6ec27540de" name="Note10" type="Note"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>If the recieved Exception is not an exact match with the one present in the Config file, this logic can be used

After Split Text action, Link it to this Block
</narrative><display x="45" y="-15" w="90" h="150" /><font family="Segoe UI" size="10" style="Bold" color="008000" /></stage><stage stageid="24e3f04e-b9a7-4eff-91be-3f2f9241593e" name="Anchor5" type="Anchor"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="150" y="105" w="10" h="10" /><onsuccess>bb4d1b97-f2a5-4420-a930-e3921c6b7f95</onsuccess></stage><stage stageid="bb4d1b97-f2a5-4420-a930-e3921c6b7f95" name="Anchor6" type="Anchor"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="330" y="105" w="10" h="10" /><onsuccess>f0d8e923-49d8-4e1f-a969-b9fbf3d43c0f</onsuccess></stage><stage stageid="1b5be24e-7821-4f96-9b33-92841b4ce092" name="Note12" type="Note"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>Storing 'Completed Without Outome' messages in Config file is the recommended approach.
If you want to use a different approach, please connect with the QA reviewer to explain your Strategy.</narrative><display x="675" y="-195" w="390" h="60" /><font family="Segoe UI" size="10" style="Bold" color="008000" /><onsuccess>b0125a2a-deff-4f7b-8182-d71cb662ddaf</onsuccess></stage><stage stageid="d902efd8-17ea-4beb-bd87-d86db0cc16f7" name="Recover" type="Recover"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit /><display x="420" y="45" /><onsuccess>397001ed-50a6-4609-80f8-7663b08108bc</onsuccess><breakpoint type="0"><condition></condition></breakpoint></stage><stage stageid="397001ed-50a6-4609-80f8-7663b08108bc" name="Resume" type="Resume"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit /><display x="510" y="45" /><onsuccess>0c1e4f49-e437-4204-8b28-62b60535de1a</onsuccess></stage><stage stageid="6ee2d76a-b3b1-4a5c-8b10-e9aa8f14a02b" name="End8" type="End"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="510" y="165" /></stage><stage stageid="0c1e4f49-e437-4204-8b28-62b60535de1a" name="Set Status" type="Action"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="510" y="105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="[Exception Type]" /></inputs><onsuccess>6ee2d76a-b3b1-4a5c-8b10-e9aa8f14a02b</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="2b4fc464-a12b-4d0c-88c2-5f4656c6c18f" name="Note12" type="Note"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><narrative>The list of Completed without Outcome Messages are stored in the Config file
We are checking if the obtained exception for the Current Item matches with the One in the list.
Please note that this logic needs an exact match </narrative><display x="675" y="-75" w="390" h="60" /><font family="Segoe UI" size="10" style="Bold" color="008000" /><onsuccess>9db9b55a-d37e-4719-b13c-ef5f1afa10e7</onsuccess></stage><stage stageid="c5558065-b5af-40eb-bcf6-e73d74044312" name="Exact Match Logic Followed" type="Decision"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="330" y="-135" /><decision expression="[flg_CompletedWithoutOutcomeExactMatchLogic]" /><ontrue>9db9b55a-d37e-4719-b13c-ef5f1afa10e7</ontrue><onfalse>7164a61d-8989-42cd-97e1-d03b220e8118</onfalse></stage><stage stageid="7164a61d-8989-42cd-97e1-d03b220e8118" name="Anchor2" type="Anchor"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><loginhibit onsuccess="true" /><display x="150" y="-135" w="10" h="10" /><onsuccess>3f42cf9d-40b7-4f98-b475-1011c91921a2</onsuccess></stage><stage stageid="d35efbd8-ec42-46d6-abb0-a57a4ddc78ab" name="coll_Exceptions" type="Collection"><subsheetid>3906e13c-250b-40cd-a33b-cef14db2c89a</subsheetid><display x="15" y="-165" w="180" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Exception" type="text" /></collectioninfo></stage><stage stageid="d7088bc6-1262-43b8-8022-0b23cc50995f" name="txt_Exception Detail" type="Data"><subsheetid>5fd952f0-1be2-40e8-8afa-485524c5a5cd</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="75" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="0d9c3943-fd1f-4a3d-a318-46b3b6486ccc" name="txt_Exception Stage" type="Data"><subsheetid>5fd952f0-1be2-40e8-8afa-485524c5a5cd</subsheetid><loginhibit onsuccess="true" /><display x="-180" y="45" w="180" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="81c6bd34-4202-441e-ac4a-b483c154af57" name=