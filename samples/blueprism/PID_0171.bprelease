ce" /></stage><stage stageid="40dd570e-d9af-4d8d-afa0-c9b37b8b2b14" name="handle" type="Data"><subsheetid>8f814e4a-ce3a-4fd2-8a04-5f2b890ceba7</subsheetid><display x="-270" y="255" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="edfdf91f-b4d8-4b4b-97cd-3ac91691575b" name="Open WorkBook" type="Action"><subsheetid>8f814e4a-ce3a-4fd2-8a04-5f2b890ceba7</subsheetid><loginhibit /><display x="30" y="285" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" narrative="The path and name of the file which should be opened." expr="[Excel File Path]" /></inputs><outputs><output type="text" name="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="Workbook Name" /></outputs><onsuccess>5c84c787-eb2f-45da-ba23-61d7a6df9b71</onsuccess><resource object="MS Excel VBO" action="Open Workbook" /></stage><stage stageid="178d9d02-c1cc-47d9-aaeb-c7324e65d8a2" name="Excel File Path" type="Data"><subsheetid>8f814e4a-ce3a-4fd2-8a04-5f2b890ceba7</subsheetid><loginhibit /><display x="-165" y="255" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /></stage><stage stageid="00a7f2c8-d795-4881-912f-78e8c5c0a1ae" name="Get Input Worksheet As Collection" type="Action"><subsheetid>8f814e4a-ce3a-4fd2-8a04-5f2b890ceba7</subsheetid><loginhibit /><display x="30" y="450" /><inputs><input type="number" name="handle" narrative="The integer handle identifying the instance on which the worksheet which should be retrieved resides. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Workbook Name" narrative="The name of the workbook which contains the sheet required. The default empty text indica