ot;&lt;/p&gt;&#xA;&lt;p&gt;&lt;em&gt;Thanks,&lt;/em&gt;&lt;br /&gt;&#xA;&lt;strong&gt;SMART Automation Team&lt;/strong&gt;&lt;/p&gt;&quot;" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." expr="[SummaryReport_SaveAsPath]" /></inputs><onsuccess>efbac7a1-d9c5-4ba6-b3f9-faeb7d7140a3</onsuccess><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="7aedb17a-fd45-40c0-ad1f-469f9c5133c9" name="SummaryReport_SaveAsPath" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-195" y="210" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4b0692e6-1b2c-42fb-91ee-7280f37f7373" name="BusinessException_Mail ID" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-330" y="405" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5a140989-baba-4bce-97c9-41e12fe06915" name="MailToOnBusinessException_CC" type="Data"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-255" y="405" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="09d8593d-e317-4aaf-84df-1c5c37639801" name="Mail" type="Block"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-375" y="375" w="240" h="105" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="3bfdf58b-7344-42a4-b18e-d7f0672059e5" name="Move File" type="Block"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-375" y="270" w="240" h="90" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="776f6723-80fc-4c5c-a325-3d4597854378" name="WorkBook Path" type="Block"><subsheetid>fe551650-5364-4729-aeb7-e3c142eaa446</subsheetid><display x="-390" y="120" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><st