collection" name="Collection 1" narrative="The first collection to be merged." expr="[FinalProduct_Collection]" /><input type="collection" name="Collection 2" narrative="The second collection to be merged." expr="[SummaryReport]" /></inputs><outputs><output type="collection" name="Collection 3" narrative="The resulting merged collection." stage="FinalProduct_Collection" /></outputs><onsuccess>e883729b-5238-48ea-bb33-ae56053d3097</onsuccess><resource object="Utility - Collection Manipulation_Extended" action="Merge Collection" /></stage><stage stageid="6d34619e-278b-46b8-ad13-362ee7897344" name="SummaryReport" type="Collection"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><display x="-510" y="-435" w="120" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Column8" type="text" /><field name="Column9" type="text" /><field name="Column10" type="text" /><field name="Column11" type="text" /></collectioninfo></stage><stage stageid="f09a36a0-d836-4b4b-84fc-66592444a4e3" name="Parameter Not Matched?" type="Decision"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><display x="165" y="810" /><decision expression="[Exception in Entry Value]=&quot;Parameter Not Matched&quot;" /><ontrue>c8239b99-d0b0-49dd-9ebf-f6ea98033051</ontrue><onfalse>d5879c9f-2fb5-4796-bb49-2533f4c9ccfa</onfalse></stage><stage stageid="c8239b99-d0b0-49dd-9ebf-f6ea98033051" name="Status Upadate" type="MultipleCalculation"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><display x="75" y="810" /><onsuccess>c07588a6-b4d4-4224-9dd0-998d6b43b696</onsuccess><steps><calculation expression="&quot;UnAuthorise&quot;" stage="UnAuthorise" /><calculation expression="&quot;Null&quot;" stage="Output_value" /><calculation expression="&quot;Fail&quot;" stage="Entry Status" /><calculation expression="&quot;Component(&quot;&amp;Trim([FinalProduct_Collection.Component])&amp;&quot;) not found in Sample Manager&quot;" stage="Exception in Entry Value" /></steps></stage><stage stageid="c07588a6-b4d4-4224-9dd0-998d6b43b696" name="Anchor28" type="Anchor"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><display x="75" y="930" w="10" h="10" /><onsuccess>622e5964-09ec-4263-952b-7736e0754a36</onsuccess></stage><stage stageid="aa2b6a2e-b879-4124-8871-0360680bcb22" name="Mark as read mail and move Exception Folder" type="SubSheet"><display x="855" y="645" w="90" h="60" /><inputs><input type="text" name="Entry ID" narrative="Get Entry ID " expr="[Item Data.EntryID]" /><input type="text" name="Destination Folder" narrative="Read Email Destination Folder" expr="[ConfigFileData.ReadEmail_ExceptionDestinationPath]" /></inputs><onsuccess>8bc0791d-9842-4414-9188-387807a7d2ed</onsuccess><processid>251ae6b6-27a1-4732-8bc0-dd9d387f6bcc</processid></stage><stage stageid="79a4d070-0b52-4a53-8add-95855dc51018" name="Mark as read mail" type="SubSheet"><display x="570" y="570" w="90" h="60" /><inputs><input type="text" name="Entry ID" narrative="Get Entry ID " expr="[Item Data.EntryID]" /><input type="text" name="Destination Folder" narrative="Read Email Destination Folder" expr="[ConfigFileData.ReadEmail_DestinationPath]" /></inputs><onsuccess>03cbe3fc-0e4e-4d11-8772-604ea9266ddd</onsuccess><processid>38206b0b-1112-479e-bece-4bb26df0c041</processid></stage><stage stageid="8bc0791d-9842-4414-9188-387807a7d2ed" name="Resume1" type="Resume"><display x="855" y="570" /><onsuccess>ffb4d158-5875-4239-bd22-b7ca87c93bbc</onsuccess></stage><stage stageid="fc7300a5-8093-49a8-9f1d-980e414569af" name="Kill Excel" type="Action"><subsheetid>858db872-b36b-4417-9a7b-d680a7d5ada3</subsheetid><narrative>Close Excel</narrative><display x="15" y="-165" /><inputs><input type="text" name="Process Name" narrative="The name of the process to kill" expr="&quot;EXCEL&quot;" /></inputs><onsuccess>ba7fab06-ccd5-4fec-be6a-e788303760ba</onsuccess><resource object="Utility - Environment" action="Kill Process" /></stage><stage stageid="a19aae51-90ea-4c27-9df7-6fcc9625f92d" name="ConvertConfigFile As Collection" type="SubSheet"><display x="0" y="-330" w="150" h="30" /><inputs><input type="text" name="ConfigFileFullPath" friendlyname="ConfigFileFullPath" narrative="Specify full path of the Config file" expr="[Config File Path]" /></inputs><outputs><output type="collection" name="ConfigFileData" friendlyname="ConfigFileData" narrative="Returns Config file as Collection (It will return Single row collection. i.e. Each AssetName as Header and Corresponding values as Row)" stage="ConfigFileData" /></outputs><onsuccess>17035c00-f5b4-4139-aef3-0e0aac448e6a</onsuccess><processid>009115fb-ed6b-454d-b571-7822263319f5</processid></stage><stage stageid="17035c00-f5b4-4139-aef3-0e0aac448e6a" name="Delete Config File" type="Action"><display x="0" y="-270" w="120" h="30" /><inputs><input type="text" name="File Name" narrative="The full path to the file to delete" expr="[Config File Path]" /></inputs><outputs><output type="flag" name="Success" narrative="True if successful" stage="Success" /><output type="text" name="Message" narrative="An error message if unsuccessful" stage="Exception Detail" /></outputs><onsuccess>18e5d438-4e93-4e40-96d8-94888c3a6d69</onsuccess><resource object="Utility - File Management" action="Delete File" /></stage><stage stageid="28c9633d-6e80-4e1c-89f5-1fb3ade06d95" name="Download Config File from SharePoint" type="Process"><display x="0" y="-390" w="120" h="30" /><inputs><input type="text" name="Sharepoint Folder Path" narrative="Sharepoint folder path excluding domain name &lt;eg. &quot;/sites/AAFAA5234/RPA Release File/PID_022_DS_PEMEX/&quot; &gt;" expr="[Generic_RPA_Sharepoint_API_Config_File_Folder_Path]" /><input type="text" name="Config File Name" narrative="Config File name with extension" expr="[PID_171_US_EV_LIMS_Prelude_ConfigFile]" /><input type="text" name="VM Download Path" narrative="Path to save config file in VM &lt;eg. &quot;C\apps\&quot;" expr="&quot;C:\Users\&quot;&amp;[Current User Name]&amp;&quot;\Documents\&quot;" /></inputs><outputs><output type="flag" name="File Downloaded ?" narrative="Flag to determine if download is complete" stage="ConfigFile_Exists" /><output type="text" name="Config File Path" narrative="Config file file name with downloaded path" stage="Config File Path" /></outputs><onsuccess>a19aae51-90ea-4c27-9df7-6fcc9625f92d</onsuccess><processid>d615d7c3-c5d0-4b01-b056-5c24afd881a2</processid></stage><stage stageid="4e0f28d9-9d83-4a4b-9e23-fa57f0d722e8" name="Get User Name" type="Action"><narrative>Gets the Current User Name</narrative><display x="0" y="-450" w="120" h="30" /><outputs><output type="text" name="User Name" narrative="The name of the logged in user in the current system" stage="Current User Name" /></outputs><onsuccess>28c9633d-6e80-4e1c-89f5-1fb3ade06d95</onsuccess><resource object="Utility - Environment" action="Get User Name" /></stage><stage stageid="5cec6b10-2b57-479a-9e42-bc8f5a8310e0" name="Recover" type="Recover"><display x="165" y="-300" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>6f170645-6f22-4496-a6ca-cb3fa39a7afb</onsuccess></stage><stage stageid="9d1646dd-49f3-4c2e-b4b9-048456ef0b41" name="Resume" type="Resume"><display x="300" y="-375" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>49cf7b76-dbfd-4b6f-addc-54d13137690e</onsuccess></stage><stage stageid="6f170645-6f22-4496-a6ca-cb3fa39a7afb" name="Exception Data" type="MultipleCalculation"><display x="300" y="-300" w="90" h="30" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>9d1646dd-49f3-4c2e-b4b9-048456ef0b41</onsuccess><steps><calculation expression="ExceptionType()" stage="Exception Type" /><calculation expression="ExceptionDetail()" stage="Exception Detail" /></steps></stage><stage stageid="49cf7b76-dbfd-4b6f-addc-54d13137690e" name="Business Exception?" type="Decision"><display x="420" y="-375" w="120" h="60" /><decision expression="Lower([Exception Type]) = &quot;business exception&quot;" /><ontrue>b199902d-d52f-471f-b94b-7594e5a0f5d8</ontrue><onfalse>02cbed42-660f-4a35-ab85-05dce61da54e</onfalse></stage><stage stageid="b199902d-d52f-471f-b94b-7594e5a0f5d8" name="Mail Business - Failure" type="MultipleCalculation"><narrative>Attributes for business exceptions</narrative><display x="540" y="-375" w="90" h="30" /><onsuccess>6535bd40-2582-42c1-bb25-d52101e61628</onsuccess><steps><calculation expression="[ConfigFileData.To-List Business Exception]" stage="Mail_To" /><calculation expression="[ConfigFileData.Cc-List Business Exception]" stage="Mail_Cc" /><calculation expression="&quot;XP Bot – PO Confirmation Report – Exception&quot;" stage="Mail_Subject" /><calculation expression="&quot;&lt;p&gt;Hi All,&lt;/p&gt;&lt;br/&gt;&#xA;&lt;p&gt;Please find below the status of PO Confirmation:&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Exception Type : &lt;/strong&gt;&quot; &amp; [Exception Type] &amp; &quot;&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Exception Details : &lt;/strong&gt;&quot; &amp; [Exception Detail] &amp; &quot;&lt;/p&gt;&lt;br/&gt;&#xA;&lt;p&gt;Thanks,&lt;/p&gt;&#xA;&lt;p&gt;XP Bot&lt;/p&gt;&quot;" stage="Mail_Body" /></steps></stage><stage stageid="02cbed42-660f-4a35-ab85-05dce61da54e" name="Mail on System exception" type="MultipleCalculation"><narrative>Attributes for system exceptions
</narrative><display x="420" y="-450" w="90" h="30" /><onsuccess>6535bd40-2582-42c1-bb25-d52101e61628</onsuccess><steps><calculation expression="[ConfigFileData.To-List System Exception]&amp;&quot;;&quot;&amp;[Generic_SupportTeam_EmailID]" stage="Mail_To" /><calculation expression="&quot;XP Bot – PO Confirmation Report – Exception&quot;" stage="Mail_Subject" /><calculation expression="&quot;&lt;p&gt;Hi All,&lt;/p&gt;&lt;br/&gt;&#xA;&lt;p&gt;Please find below the status of PO Confirmation:&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Exception Type : &lt;/strong&gt;&quot; &amp; [Exception Type] &amp; &quot;&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Exception Details : &lt;/strong&gt;&quot; &amp; [Exception Detail] &amp; &quot;&lt;/p&gt;&lt;br/&gt;&#xA;&lt;p&gt;Thanks,&lt;/p&gt;&#xA;&lt;p&gt;XP Bot&lt;/p&gt;&quot;" stage="Mail_Body" /><calculation expression="[ConfigFileData.Cc-List System Exception]" stage="Mail_Cc" /></steps></stage><stage stageid="6535bd40-2582-42c1-bb25-d52101e61628" name="Send Email" type="Action"><display x="540" y="-450" /><inputs><input type="text" name="To" narrative="Mandatory. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;" expr="[Mail_To]" /><input type="text" name="CC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="[Mail_Cc]" /><input type="text" name="BCC" narrative="Optional. Any alphanumeric value allowed. Single Recipient = &quot;Name1@emaill.com&quot;; Multi Recipient = &quot;Name1@emaill.com; Name2@email.com&quot;. Default blank" expr="" /><input type="text" name="Subject" narrative="Optional. Any alphanumeric value allowed." expr="[Mail_Subject]" /><input type="text" name="Message" narrative="Optional, HTML or plain text" expr="[Mail_Body]" /><input type="text" name="Attachments" narrative="Optional, Comma-separated file paths. Default blank." expr="[Mail_Attachments]" /></inputs><onsuccess>e22cfb92-6fcf-4f76-bd16-88066026087b</onsuccess><breakpoint type="0"><condition></condition></breakpoint><resource object="MS Outlook Email VBO" action="Send Email" /></stage><stage stageid="e22cfb92-6fcf-4f76-bd16-88066026087b" name="Terminate" type="Exception"><display x="660" y="-450" /><exception type="System Exception" detail="[Exception Detail]" /></stage><stage stageid="18e5d438-4e93-4e40-96d8-94888c3a6d69" name="Deleted?" type="Decision"><display x="0" y="-225" w="90" h="30" /><decision expression="[Success]" /><ontrue>832b89eb-e411-459f-ac7a-4584e360f5ef</ontrue><onfalse>120379bd-62b2-46f7-8071-a1abe9c85dec</onfalse></stage><stage stageid="120379bd-62b2-46f7-8071-a1abe9c85dec" name="Failed to Delete Config file" type="Exception"><display x="135" y="-225" w="90" h="30" /><exception type="System Exception" detail="[Exception Detail]" /></stage><stage stageid="e2a3dd48-0eb3-48b6-afb8-46be6938e589" name="Note13" type="Note"><narrative>Always delete downloaded config file after reading it to a collection.
In case, if Config file has to read again, always download the latest file from SharePoint.</narrative><display x="-285" y="-270" w="180" h="60" /><font family="Segoe UI" size="10" style="Regular" color="0000FF" /></stage><stage stageid="a46150aa-ce07-4113-9053-7643410b7ef5" name="ConfigFile Varaible" type="Block"><display x="-945" y="-300" w="180" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FFCC00" /></stage><stage stageid="fd387e06-c6cf-4f57-aec8-4a1e6413239c" name="Generic_RPA_Sharepoint_API_Config_File_Folder_Path" type="Data"><display x="-855" y="-270" w="150" h="30" /><datatype>text</datatype><initialvalue /><exposure>Environment</exposure><private /><alwaysinit /></stage><stage stageid="348575c6-81cc-48c1-ad80-4cabed041d72" name="Current User Name" type="Data"><display x="-855" y="-240" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e492c9f4-acf4-4d1a-a574-f7a3e1ff2dad" name="Email Parameters" type="Block"><display x="-945" y="-195" w="180" h="195" /><font family="Segoe UI" size="10" style="Regular" color="FFFF00" /></stage><stage stageid="f54cff56-8992-4070-aaec-2d152241182f" name="Mail_To" type="Data"><display x="-855" y="-150" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="7b1a6b11-ccc3-4810-9e97-4453a997194a" name="Mail_Cc" type="Data"><display x="-855" y="-120" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="87a135cb-467f-4f0b-adbb-2b5807d6e8d9" name="Mail_Subject" type="Data"><display x="-855" y="-90" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="009eec6e-429a-41ed-a1f2-e017f4492c27" name="Mail_Body" type="Data"><display x="-855" y="-60" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="a46a2eca-228d-4484-913e-ea1c89627f56" name="Mail_Attachments" type="Data"><display x="-855" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="0b79be6f-3bed-429b-bf10-c144009725bf" name="ConvertConfigFile As Collection" type="SubSheetInfo"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><narrative>Convert given Config file as Collection.
Make Sure that Config file should contain the headers "AssetName" and "Value"</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="089736e8-7e40-4f5d-846b-bc650230d348" name="Start" type="Start"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="120" y="-75" /><inputs><input type="text" name="ConfigFileFullPath" narrative="Specify full path of the Config file" stage="ConfigFileFullPath" /></inputs><onsuccess>6f51d7ce-c0c0-40cb-8c53-884c725ff1ce</onsuccess></stage><stage stageid="04c2fa67-625b-419f-bc65-7a71ea3d1141" name="End" type="End"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="135" y="150" /><outputs><output type="collection" name="ConfigFileData" narrative="Returns Config file as Collection (It will return Single row collection. i.e. Each AssetName as Header and Corresponding values as Row)" stage="ConfigFileData_temp" /></outputs></stage><stage stageid="b238e6ad-492b-446e-9da8-b088c029dbcb" name="DataCollection" type="Collection"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="-105" y="120" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="231f1eca-7a78-4983-8ff1-fbe72670720a" name="Loop Coll Start" type="LoopStart"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="-75" /><onsuccess>85431d0f-9d92-424a-b856-d756cf66bcd9</onsuccess><groupid>24faa12e-fc7a-4793-b14e-720392fc2ad4</groupid><looptype>ForEach</looptype><loopdata>DataCollection</loopdata></stage><stage stageid="f8cd7f46-0de8-43e7-b9fd-eb887ec28ebb" name="Loop Coll End" type="LoopEnd"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="225" /><onsuccess>4b285295-8272-4ac8-a467-0a2f1bb19b6c</onsuccess><groupid>24faa12e-fc7a-4793-b14e-720392fc2ad4</groupid></stage><stage stageid="66d37d32-c0e3-48f4-8081-46508f42fd28" name="Append {" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="-135" /><onsuccess>231f1eca-7a78-4983-8ff1-fbe72670720a</onsuccess><calculation expression="&quot;{&quot;" stage="JSON String" /></stage><stage stageid="247cfbcb-6247-49b4-aa39-52160d262880" name="JSON String" type="Data"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="-180" y="165" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="85431d0f-9d92-424a-b856-d756cf66bcd9" name="Append AssetName to JSON String" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="-30" /><onsuccess>68f64b95-a47d-409c-af19-ab3fa001505b</onsuccess><calculation expression="[JSON String] &amp; Chr(34) &amp; [DataCollection.AssetName] &amp; Chr(34)" stage="JSON String" /></stage><stage stageid="68f64b95-a47d-409c-af19-ab3fa001505b" name="Append :" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="15" /><onsuccess>db55ebd2-611a-473c-9942-b14bfd844dd1</onsuccess><calculation expression="[JSON String] &amp; &quot;:&quot;" stage="JSON String" /></stage><stage stageid="4b98025e-a9cb-4289-84cc-4c535be0bf70" name="Append AssetValue to JSON String" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="105" /><onsuccess>e2d0680d-9d42-45c3-9152-29c51a317865</onsuccess><calculation expression="[JSON String] &amp; Chr(34) &amp; [EscapeString] &amp; Chr(34)" stage="JSON String" /></stage><stage stageid="e2d0680d-9d42-45c3-9152-29c51a317865" name="Append ," type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="150" /><onsuccess>f8cd7f46-0de8-43e7-b9fd-eb887ec28ebb</onsuccess><calculation expression="[JSON String] &amp; &quot;,&quot;" stage="JSON String" /></stage><stage stageid="ad592d9f-9677-4df8-a5c1-84f3444cc4f1" name="Append }" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="225" /><onsuccess>dae78847-26a7-4783-b998-ba1c64c68ef9</onsuccess><calculation expression="[JSON String] &amp; &quot;}&quot;" stage="JSON String" /></stage><stage stageid="4b285295-8272-4ac8-a467-0a2f1bb19b6c" name="Remove Last Comma" type="Calculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="345" y="225" /><onsuccess>ad592d9f-9677-4df8-a5c1-84f3444cc4f1</onsuccess><calculation expression="Mid([JSON String] , 1, Len([JSON String] ) - 1)" stage="JSON String" /></stage><stage stageid="bd2734e7-8c31-46fd-9c61-d4c3e67a89c6" name="EscapeString" type="Data"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="-180" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="db55ebd2-611a-473c-9942-b14bfd844dd1" name="Replace Special Character" type="MultipleCalculation"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="420" y="60" /><onsuccess>4b98025e-a9cb-4289-84cc-4c535be0bf70</onsuccess><steps><calculation expression="Replace([DataCollection.Value] , &quot;\&quot;, &quot;\\&quot;)" stage="EscapeString" /><calculation expression="Replace([EscapeString] , Chr(34), &quot;\&quot; &amp; Chr(34))" stage="EscapeString" /></steps></stage><stage stageid="dae78847-26a7-4783-b998-ba1c64c68ef9" name="Json To Collection" type="Action"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="150" /><inputs><input type="text" name="json" expr="[JSON String]" /></inputs><outputs><output type="collection" name="Result" stage="ConfigFileData_temp" /></outputs><onsuccess>04c2fa67-625b-419f-bc65-7a71ea3d1141</onsuccess><resource object="Utility - JSON" action="JSON to Collection" /></stage><stage stageid="ec30e033-1d4c-4751-b81c-99ae73ec54ac" name="ConfigFileData_temp" type="Collection"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="585" y="-15" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="0b84a184-054d-46d3-a23b-26675eb11fae" name="ConfigFileFullPath" type="Data"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="-180" y="0" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c3ee17e-5959-4181-952d-aeb1542ad183" name="Input Parameter" type="Block"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="-240" y="-45" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="84927ba1-bf6a-470d-b682-5aa19e9b1ec0" name="DataItems" type="Block"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="-240" y="90" w="240" h="120" /><font family="Segoe UI" size="10" style="Regular" color="00FFFF" /></stage><stage stageid="3d3a98dc-cb2b-4b80-beda-7be9121af631" name="Output Parameter" type="Block"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="480" y="-75" w="240" h="135" /><font family="Segoe UI" size="10" style="Regular" color="808080" /></stage><stage stageid="6f51d7ce-c0c0-40cb-8c53-884c725ff1ce" name="FileExists" type="Action"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="-75" /><inputs><input type="text" name="File Name" narrative="The name of the file to check" expr="[ConfigFileFullPath]" /></inputs><outputs><output type="flag" name="Exists" narrative="True if the file exists" stage="Exists" /></outputs><onsuccess>d2d05bff-6793-475f-9dae-10a2f253a72c</onsuccess><resource object="Utility - File Management" action="File Exists" /></stage><stage stageid="01dcdb65-4f43-4706-9c8c-f81b5398ae60" name="Exists" type="Data"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="-105" y="165" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="d2d05bff-6793-475f-9dae-10a2f253a72c" name="IsFileExists?" type="Decision"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="-135" /><decision expression="[Exists]" /><ontrue>3935ec71-c3fc-45c4-b944-30d33da36ac8</ontrue><onfalse>f8ac441d-d2e3-4579-aae4-6811d64f5ca9</onfalse></stage><stage stageid="f8ac441d-d2e3-4579-aae4-6811d64f5ca9" name="FileNotFound" type="Exception"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="255" y="-195" /><exception type="System Unavailable Exception" detail="[ConfigFileFullPath] &amp; &quot; does not exists&quot;" /></stage><stage stageid="263a4bfa-2ed3-4a13-a500-26358e014d0b" name="Json Exception Block" type="Block"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><narrative>This Block will throw an exception when input contains Special characters like Double Quote " or Backward Slash \</narrative><display x="180" y="30" w="165" h="150" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="f3d56113-3dc7-4a38-ac33-334e7c0e1aea" name="Json Exception" type="Exception"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><display x="135" y="60" /><exception type="System Unavailable Exception" detail="&quot;Invalid AssetName. AssetName Should not contain any Special Characters. Example double Quotes and Backslash&quot;" /></stage><stage stageid="8a172d6d-5a36-4064-9377-4ff26277511a" name="Json Recover" type="Recover"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="105" /><onsuccess>480fe61c-da99-4473-83e8-a1afeca49390</onsuccess></stage><stage stageid="480fe61c-da99-4473-83e8-a1afeca49390" name="Json Recover" type="Resume"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="255" y="60" /><onsuccess>f3d56113-3dc7-4a38-ac33-334e7c0e1aea</onsuccess></stage><stage stageid="3935ec71-c3fc-45c4-b944-30d33da36ac8" name="Read Excel As Collection" type="SubSheet"><subsheetid>009115fb-ed6b-454d-b571-7822263319f5</subsheetid><loginhibit /><display x="345" y="-135" /><inputs><input type="text" name="fileName" friendlyname="fileName" narrative="Specify the Excel file name to read data" expr="[ConfigFileFullPath]" /><input type="text" name="sheetName" friendlyname="sheetName" narrative="Specify the Excel sheet name to read data" expr="[ConfigFileSheetName]" /></inputs><outputs><output type="collection" name="DataCollection" friendlyname="DataCollection" narrative="Returns Excel data as Collection" stage="DataCollection" /></outputs><onsuccess>66d37d32-c0e3-48f4-8081-46508f42fd28</onsuccess><processid>eeeb6765-9d9f-4374-b7cd-d5ca8f3dfa61</processid></stage><stage stageid="de1699c3-7fa0-40dd-a348-3fed17742d98" name="Config File Path" type="Data"><display x="-345" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="9c38d444-89a1-4a07-a3ac-81d3dba730d2" name="Success" type="Data"><display x="-345" y="90" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="34ed7352-4b11-40d7-8bb4-84c30a1c350b" name="ConfigFile_Exists" type="Data"><display x="-345" y="-45" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5f1510f1-d42f-44e4-a9c2-fc2ff6db51e4" name="Result" type="Data"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><display x="-345" y="270" /><font family="Segoe UI" size="10" style="Bold" color="000000" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c97a2221-d0fb-4ab5-9f5a-c194e0788037" name="MailItems_Count" type="Data"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><display x="-285" y="270" /><datatype>number</datatype><initialvalue>5</initialvalue><private /><alwaysinit /></stage><stage stageid="4ed00de3-0cf0-491a-8691-0d8eedfaff30" name="Email_Subject" type="Data"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><display x="-285" y="180" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="4c75cb16-a628-46d8-9450-c87c793d9075" name="Input" type="Block"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="-390" y="150" w="150" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fb832e21-70b0-4ef0-afcd-23a5f618b269" name="Output" type="Block"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="-390" y="225" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="726d5707-9294-479a-a1dc-be06329802e7" name="Mail Items" type="LoopStart"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><onsuccess>1a7727fa-1f43-4350-ab0b-1acbe2b3ca20</onsuccess><groupid>aa14417f-cc7e-4dc6-9d7f-2a99c45ee303</groupid><looptype>ForEach</looptype><loopdata>Mail Items</loopdata></stage><stage stageid="37e407dc-6199-4b13-9aed-9f488dfb0a27" name="Mail Items" type="LoopEnd"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="15" y="255" /><onsuccess>dd448208-1686-4aaf-b8bc-f24409e3c6f9</onsuccess><groupid>aa14417f-cc7e-4dc6-9d7f-2a99c45ee303</groupid></stage><stage stageid="1a7727fa-1f43-4350-ab0b-1acbe2b3ca20" name="Read EmailSubject" type="Calculation"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="15" y="75" /><onsuccess>0f884163-f173-4204-860e-fdd39e1602e0</onsuccess><calculation expression="[Mail Items.Subject]" stage="Email_Subject" /></stage><stage stageid="0f884163-f173-4204-860e-fdd39e1602e0" name="Is Item In Queue" type="Action"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><narrative>Check if an item with the given key is already in the queue</narrative><display x="15" y="135" /><font family="Segoe UI" size="10" style="Bold" color="000000" /><inputs><input type="text" name="Queue Name" narrative="The name of the queue to check" expr="[QueueName]" /><input type="text" name="Key" friendlyname="Key" narrative="The key to check." expr="[Email_Subject]" /><input type="flag" name="Include Pending" friendlyname="Include Pending" narrative="Check any items in the queue which are currently awaiting being worked. This will include any deferred items which have a deferral date in the past and any locked items. Optional - Default is True" expr="True" /><input type="flag" name="Include Deferred" friendlyname="Include Deferred" narrative="Check any items in the queue which are currently deferred to a later date. Optional - Default is True" expr="False" /><input type="flag" name="Include Completed" friendlyname="Include Completed" narrative="Check any items in the queue which are completed. Optional - Default is True" expr="False" /><input type="flag" name="Include Terminated" friendlyname="Include Terminated" narrative="Check any items in the queue which have been fully terminated. Optional - Default is True" expr="False" /></inputs><outputs><output type="collection" name="Item IDs" narrative="The Item IDs which represent the work items found with the given key" stage="Item IDs" /><output type="flag" name="Result" friendlyname="Result" narrative="True if an item with the given key is in the queue, False otherwise." stage="Result" /></outputs><onsuccess>f88809d5-5a09-4c2d-9d2d-3a2391cd85e4</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Is Item In Queue" /></stage><stage stageid="f88809d5-5a09-4c2d-9d2d-3a2391cd85e4" name="Item Already added in Queue?" type="Decision"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><display x="15" y="195" /><decision expression="[Result]" /><ontrue>81ec9717-b1b3-4592-b611-5e103c4fabe9</ontrue><onfalse>37e407dc-6199-4b13-9aed-9f488dfb0a27</onfalse></stage><stage stageid="81ec9717-b1b3-4592-b611-5e103c4fabe9" name="Remove Row" type="Action"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="120" y="195" /><inputs><input type="text" name="Collection Name" friendlyname="Collection Name" narrative="The name of the collection to act upon" expr="&quot;Mail Items&quot;" /></inputs><onsuccess>14853cb1-9227-42d0-8b15-b124afe1f12b</onsuccess><resource object="Blueprism.AutomateProcessCore.clsCollectionActions" action="Remove Row" /></stage><stage stageid="dd448208-1686-4aaf-b8bc-f24409e3c6f9" name="Count Rows" type="Action"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><narrative>Check if an item with the given key is already in the queue</narrative><display x="15" y="315" /><font family="Segoe UI" size="10" style="Bold" color="000000" /><inputs><input type="text" name="Collection Name" friendlyname="Collection Name" narrative="The name of the collection to act upon" expr="&quot;Mail Items&quot;" /></inputs><outputs><output type="number" name="Count" friendlyname="Count" narrative="The number of rows counted in the collection" stage="MailItems_Count" /></outputs><onsuccess>03ec2a80-84b1-44f4-8ffe-74f9b2c50c25</onsuccess><resource object="Blueprism.AutomateProcessCore.clsCollectionActions" action="Count Rows" /></stage><stage stageid="03ec2a80-84b1-44f4-8ffe-74f9b2c50c25" name="No New Emails?" type="Decision"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><display x="15" y="375" /><decision expression="[MailItems_Count]=0" /><ontrue>4da4b5e2-abeb-4c93-9572-484ddcce68d8</ontrue><onfalse>c4ee9c17-2f38-4780-9426-16935400764c</onfalse></stage><stage stageid="c4ee9c17-2f38-4780-9426-16935400764c" name="Add to Queue" type="Action"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><narrative>The Data collection contains the items to be added to the queue. The collection may contain single or multiple rows, with each representing an item to be added.

If there is a failure during the process, the queue will be unchanged - i.e. no rows will be loaded even if the error occurred on the last one.

If Defer Until is specified, the items will not be available to be worked until then. Otherwise, they are available immediately.

If the queue has a key field defined, an item added has key data longer than the maximum permitted 255 characters, an error will occur</narrative><display x="15" y="435" /><inputs><input type="text" name="Queue Name" narrative="The name of the queue to add items to" expr="[QueueName]" /><input type="collection" name="Data" narrative="A collection containing the data, one row for each item to be added" expr="[Mail Items]" /><input type="datetime" name="Defer Until" narrative="Optionally, the date/time the new item(s) should be deferred until" expr="" /><input type="number" name="Priority" narrative="Optionally, the priority for the new item(s). Lower numbers represent higher priorities. The default is 0." expr="" /><input type="text" name="Tags" narrative="Optionally, a semi-colon-separated set of tags to apply to the queue item(s)" expr="" /><input type="text" name="Status" narrative="Optionally, the initial status required of the work queue item(s) " expr="" /><input type="number" name="Batch Size" friendlyname="Batch Size" narrative="Optionally, the batch size to use when adding many items to the queue.  A Value of 0 will process all items in one batch.  An empty field will use the default batch size of 1000." expr="" /></inputs><outputs><output type="collection" name="Item IDs" narrative="The IDs of the items which have been added to the queue, in the order of the collection of data passed that was input" stage="Item IDs" /></outputs><onsuccess>798a2609-c9b8-49fb-900d-19a17a2a1c74</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Add To Queue" /></stage><stage stageid="14853cb1-9227-42d0-8b15-b124afe1f12b" name="Anchor32" type="Anchor"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="120" y="255" w="10" h="10" /><onsuccess>37e407dc-6199-4b13-9aed-9f488dfb0a27</onsuccess></stage><stage stageid="4da4b5e2-abeb-4c93-9572-484ddcce68d8" name="Anchor33" type="Anchor"><subsheetid>b749d60a-bded-4d36-b099-3627ed699606</subsheetid><loginhibit onsuccess="true" /><display x="120" y="375" w="10" h="10" /><onsuccess>798a2609-c9b8-49fb-900d-19a17a2a1c74</onsuccess></stage><stage stageid="7d05a195-ee18-4baa-85ee-ef8c30f603d4" name="System Exception?" type="Decision"><display x="-105" y="570" /><decision expression="[Exception Type]=&quot;System Exception&quot;" /><ontrue>d2537f1c-3ca3-4daf-ab4e-8db52dd596fc</ontrue><onfalse>9bc8ae7e-b4e4-4921-870a-7a4cfce0ad01</onfalse></stage><stage stageid="9bc8ae7e-b4e4-4921-870a-7a4cfce0ad01" name="End7" type="End"><loginhibit onsuccess="true" /><display x="-15" y="570" /></stage><stage stageid="d2537f1c-3ca3-4daf-ab4e-8db52dd596fc" name="SE: Outlook Issue" type="Exception"><display x="-105" y="630" /><font family="Segoe UI" size="10" style="Bold" color="000000" /><exception localized="yes" type="System Exception" detail="[Exception Detail]" savescreencapture="yes" /></stage><stage stageid="1cf95201-19d9-4d22-97fa-be2c071ea4bf" name="SE: Outlook/Send Email Issue" type="Exception"><display x="-195" y="570" /><exception localized="yes" type="System Exception" detail="[Exception Detail]" usecurrent="yes" savescreencapture="yes" /></stage><stage stageid="fe027fd8-2a57-4afa-9090-58a9796e60eb" name="Component Names" type="LoopStart"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><loginhibit onsuccess="true" /><display x="165" y="390" /><font family="Segoe UI" size="10" style="Bold" color="800000" /><onsuccess>0cddfbd8-b25e-4367-8421-b0e6449b8198</onsuccess><groupid>87352aa5-46a5-4831-af76-3666883cd591</groupid><looptype>ForEach</looptype><loopdata>Component Names</loopdata></stage><stage stageid="c5d20ac1-5c7e-43e5-adec-eda8158f487b" name="Component Names" type="LoopEnd"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><loginhibit onsuccess="true" /><display x="360" y="390" /><font family="Segoe UI" size="10" style="Bold" color="800000" /><onsuccess>cfb1deb6-f3fc-4482-961f-2b61aac925ab</onsuccess><groupid>87352aa5-46a5-4831-af76-3666883cd591</groupid></stage><stage stageid="0cddfbd8-b25e-4367-8421-b0e6449b8198" name="Convert to Lowercase" type="Calculation"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><loginhibit onsuccess="true" /><display x="255" y="390" /><font family="Segoe UI" size="10" style="Bold" color="800000" /><onsuccess>c5d20ac1-5c7e-43e5-adec-eda8158f487b</onsuccess><calculation expression="Lower(Trim([Component Names.Value]))" stage="Component Names.Value" /></stage><stage stageid="cfb1deb6-f3fc-4482-961f-2b61aac925ab" name="Anchor4" type="Anchor"><subsheetid>b7af32c8-b45a-495e-aa58-8684ccacf066</subsheetid><loginhibit onsuccess="true" /><display x="360" y="435" w="10" h="10" /><font family="Segoe UI" size="10" style="Regular" color="800000" /><onsuccess>13d00d8a-ff81-45c0-a256-6d35722d97b1</onsuccess></stage><stage stageid="e49bed9c-30ed-48f8-aded-5dcc88400b5c" name="Utility - General::Sleep" type="Action"><subsheetid>bf57723b-f31f-465f-a44d-6b23e78fd2de</subsheetid><loginhibit onsuccess="true" /><display x="60" y="0" w="90" h="30" /><font family="Segoe UI" size="10" style="Regular" color="800000" /><inputs><input type="number" name="Sleep Time (Seconds)" friendlyname="Sleep Time (Seconds)" narrative="The time (in seconds) for which to sleep" expr="[Sleep-2s]" /></inputs><onsuccess>a904fcc6-6b99-4ba1-9a12-6209dfdec5f8</onsuccess><resource object="Utility - General" action="Sleep" /></stage><stage stageid="1d4f9bfc-ba1f-43b7-a7de-73501c222be1" name="Sleep-2s" type="Data"><subsheetid>bf57723b-f31f-465f-a44d-6b23e78fd2de</subsheetid><loginhibit onsuccess="true" /><display x="-225" y="135" w="150" h="30" /><font family="Segoe UI" size="10" style="Regular" color="800000" /><datatype>number</datatype><initialvalue>2</initialvalue><private /><alwaysinit /></stage><stage stageid="4cab344d-b30d-4980-910f-3239efe74b10" name="Send Info to Data Gateways" type="SubSheetInfo"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><narrative>Sends data to Data Gateways</narrative><display x="-540" y="-180" w="150" h="90" /></stage><stage stageid="11d3de85-44bb-4630-abf5-3a1b57066403" name="Start" type="Start"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><display x="-210" y="-210" w="90" h="30" /><inputs><input type="text" name="Work Queue Name" stage="in_DateGateways_coll.WorkQueueName" /><input type="text" name="Item Id" stage="in_DateGateways_coll.ItemId" /><input type="text" name="Item Key" stage="in_DateGateways_coll.ItemKey" /><input type="datetime" name="Input Data Received On" stage="in_DateGateways_coll.InputDataReceivedOn" /><input type="datetime" name="Item Created On" stage="in_DateGateways_coll.ItemCreatedOn" /><input type="datetime" name="Execution Started On" stage="in_DateGateways_coll.ItemExecutionStartedOn" /><input type="datetime" name="Item Completed On" stage="in_DateGateways_coll.ItemCompletedOn" /><input type="text" name="Result Status" stage="in_DateGateways_coll.ResultStatus" /><input type="text" name="CustomMessage" stage="in_DateGateways_coll.CustomMessage" /></inputs><onsuccess>2cb08568-9050-41fe-abf6-2d39741271c9</onsuccess></stage><stage stageid="6892afdc-79e8-42f3-bcfd-a3d4f0842e24" name="End" type="End"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><display x="-210" y="30" w="90" h="30" /></stage><stage stageid="280e1392-b316-4a8a-95c0-1e47f3f9d1c9" name="in_DateGateways_coll" type="Collection"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><display x="-540" y="-90" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><singlerow /><field name="WorkQueueName" type="text" description="Process Work Queue Name" /><field name="ItemId" type="text" description="Item Id" /><field name="ItemKey" type="text" description="Primary Key of the item" /><field name="InputDataReceivedOn" type="datetime" description="This could be the main trigger point such as EmailReceivedOn, file etc." /><field name="ItemCreatedOn" type="datetime" description="Queue Item Created on" /><field name="ItemExecutionStartedOn" type="datetime" description="Queue Item Execution started on" /><field name="ItemCompletedOn" type="datetime" description="Queue Item completed on" /><field name="ResultStatus" type="text" description="Status of the Item" /><field name="CustomMessage" type="text" description="CustomMessage such as Tags, additional info for the analytics visiblity etc." /></collectioninfo><initialvalue><singlerow /><row><field name="WorkQueueName" type="text" value="" /><field name="ItemId" type="text" value="" /><field name="ItemKey" type="text" value="" /><field name="InputDataReceivedOn" type="datetime" value="" /><field name="ItemCreatedOn" type="datetime" value="" /><field name="ItemExecutionStartedOn" type="datetime" value="" /><field name="ItemCompletedOn" type="datetime" value="" /><field name="ResultStatus" type="text" value="" /><field name="CustomMessage" type="text" value="" /></row></initialvalue></stage><stage stageid="15208ed9-097c-4cff-afde-0b19941ca4c6" name="Data Gateways::Send Custom Data" type="Action"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><loginhibit onsuccess="true" /><narrative>This action can be used to serialize and send a Blue Prism collection to the data gateway. 
    There is a limit of approximately ~4MB on the data that can be sent through this method. 
    This is due to limitations enforced by the JSON Serializer.</narrative><display x="-210" y="-45" w="180" h="60" /><inputs><input type="collection" name="Custom Data" friendlyname="Custom Data" narrative="The Blue Prism collection to send to the data gateways table" expr="[in_DateGateways_coll]" /></inputs><onsuccess>6892afdc-79e8-42f3-bcfd-a3d4f0842e24</onsuccess><resource object="Blueprism.Automate.clsDataGatewaysActions" action="Send Custom Data" /></stage><stage stageid="b3c5f3c7-b820-4390-b4a0-dccaca7d415e" name="Note31" type="Note"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><narrative>Data Gateways may not be enabled in DEV/SIT/UAT.
During those executions, running these will not result in error as it's written to primary database.
In the environments or for Processes where Data Gateway is enabled (in PROD), the Datagateways Engine will read and send the data to configured output application ( Secondary Database, File, HTTP, SPLUNK, etc.)</narrative><display x="60" y="-60" w="270" h="180" /><font family="Segoe UI" size="13" style="Bold" color="993300" /></stage><stage stageid="2cb08568-9050-41fe-abf6-2d39741271c9" name="SendDataToDataGateways?" type="Decision"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><display x="-210" y="-150" w="150" h="30" /><decision expression="[SendData_To_Gateways]" /><ontrue>15208ed9-097c-4cff-afde-0b19941ca4c6</ontrue><onfalse>290155a1-bafd-43ed-bb78-5a8e9ca28279</onfalse></stage><stage stageid="290155a1-bafd-43ed-bb78-5a8e9ca28279" name="Anchor3" type="Anchor"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><loginhibit onsuccess="true" /><display x="-330" y="-150" w="10" h="10" /><onsuccess>8609c6b7-1690-4d85-ad90-4884ec177566</onsuccess></stage><stage stageid="8609c6b7-1690-4d85-ad90-4884ec177566" name="Anchor160" type="Anchor"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><loginhibit onsuccess="true" /><display x="-330" y="30" w="10" h="10" /><onsuccess>6892afdc-79e8-42f3-bcfd-a3d4f0842e24</onsuccess></stage><stage stageid="6f718c54-8404-460f-9b1b-7a64ac07169f" name="Note32" type="Note"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><narrative>We can control the requirement of Data Gateways for Processes, Environment specific (True in Prod, False in Non-Prod etc.)</narrative><display x="-345" y="-195" w="150" h="60" /><font family="Segoe UI" size="11" style="Italic" color="993300" /></stage><stage stageid="438ace04-2543-4bce-9062-625867e87778" name="Variables" type="Block"><subsheetid>2fd134f3-45a9-4bde-9050-0a45b0139809</subsheetid><loginhibit onsuccess="true" /><display x="-615" y="-120" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="4dba392f-