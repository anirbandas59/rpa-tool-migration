15" y="-150" /><inputs><input type="password" name="Client ID" narrative="Client ID for Sharepoint" stage="Client ID" /><input type="password" name="Tenant ID" narrative="Tenant ID for Sharepoint" stage="Tenant ID" /></inputs><onsuccess>7dc31458-608a-47cd-9961-8958acb12f87</onsuccess></stage><stage stageid="bbf81f23-defc-4ec5-bb07-e53f84ef212a" name="Get URL Components" type="Action"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-30" /><inputs><input type="text" name="Sharepoint URL" narrative="Sharepoint URL to get URL components &lt;eg.  https://eu001-sp.shell.com/sites/AAAAA0626 &gt;" expr="[RPA_Sharepoint_URL]" /></inputs><outputs><output type="collection" name="URL Components" narrative="Components of URL split into collection fields" stage="URL Components" /></outputs><onsuccess>b42b59ef-8e3f-4dce-af1a-06c0159108ce</onsuccess><resource object="Utility_Sharepoint_API_Config" action="Extract Sharepoint URL" /></stage><stage stageid="c4c2ffb7-9e13-4154-ac85-b84225b56c37" name="Assign URL Components" type="MultipleCalculation"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="150" y="45" w="150" h="30" /><onsuccess>3998ac0b-898f-4c1b-9bd5-5547f351c54a</onsuccess><steps><calculation expression="[URL Components.businessEntity]" stage="URL - Business Entity" /><calculation expression="[URL Components.uriPath]" stage="URL - SubSite" /></steps></stage><stage stageid="4415b465-722e-4df2-ac66-cdb0b8124024" name="End" type="End"><subsheetid>38d1af81-a59c-4021-ba37-b77a0ac447e1</subsheetid><display x="15" y="210" /><outputs><output type="text" name="URL - Business Entity" narrative="Gives the Business Entity from the provided URL" stage="URL - Business Entity" /><output type="text" name="URL - Subsite" narrative="Gives the Subsite part of the provided URL" stage="URL - SubSite" /><output type="text" name="Sharepoint App Client ID" narrative="Sharepoint App Client ID for API" stage="Shar