aysinit /></stage><stage stageid="120ae211-8901-4f50-baac-40cde254eca2" name="Message" type="Data"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="195" y="15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="44fca212-127e-4d09-993e-84275cdd2c23" name="check directory?" type="Decision"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="30" y="60" /><decision expression="[Success]" /><ontrue>7e918a3e-c910-483c-8358-74f6af4956ca</ontrue><onfalse>b8f2a522-8ba7-4a19-9f47-c43ada79ab38</onfalse></stage><stage stageid="7e918a3e-c910-483c-8358-74f6af4956ca" name="save the screenshot to PNG" type="Action"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="30" y="105" /><inputs><input type="text" name="FileName" expr="[FileName]" /><input type="text" name="Filenamepath" expr="[Screen shot path]" /></inputs><onsuccess>741650b6-9268-4541-bb84-599c3e545514</onsuccess><resource object="Utility_Object_Generic_ImageSearch" action="Clipboard image to PNG File" /></stage><stage stageid="e0929c8f-3406-40ad-abb4-1517d89fcd25" name="Anchor32" type="Anchor"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="-135" y="15" w="10" h="10" /><onsuccess>740b567c-218e-4f57-97a6-58d120eb0e17</onsuccess></stage><stage stageid="b8f2a522-8ba7-4a19-9f47-c43ada79ab38" name="count?" type="Calculation"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="-45" y="60" /><onsuccess>a4003da5-b698-446b-87a1-c3f13076f566</onsuccess><calculation expression="[count]+1" stage="count" /></stage><stage stageid="a4003da5-b698-446b-87a1-c3f13076f566" name="counter?" type="Decision"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="-135" y="60" /><decision expression="[count]&gt;4" /><ontrue>ae34d2d1-8f29-469e-8a17-6741162d2537</ontrue><onfalse>e0929c8f-3406-40ad-abb4-1517d89fcd25</onfalse></stage><stage stageid="ae34d2d1-8f29-469e-8a17-6741162d2537" name="End4" type="End"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="-240" y="60" /></stage><stage stageid="b53c0e45-0998-4368-94f0-305b888092a9" name="count" type="Data"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="225" y="-45" /><datatype>number</datatype><initialvalue>1</initialvalue><private /><alwaysinit /></stage><stage stageid="a0c1768b-d801-4e96-bcd5-877647bc3b00" name="Screen shot path" type="Data"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="150" y="-45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cbe719d5-5cd4-46f4-abca-f97449c95d32" name="FileName" type="Data"><subsheetid>d1a97087-e5d8-464e-a271-5b767139b131</subsheetid><display x="-255" y="135" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cf29e726-7c36-49ac-a5f0-1b6c9338ef07" name="FileName" type="Data"><subsheetid>07708b38-ee7e-44e4-9cd5-dc263291f719</subsheetid><display x="-45" y="-90" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
        <object id="da1df941-2cbd-4458-8976-b368eaeca214" name="Utility_Sharepoint_API_Config" xmlns="http://www.blueprism.co.uk/product/process"><process name="Utility_Sharepoint_API_Config" version="1.0" bpversion="7.3.1.15031" narrative="Sharepoint_API_Object to download config files from RPA Sharepoint site" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="Application Root"><id>7261d565-ef82-4c20-8947-d8e0d9c9f939</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>0</camerax><cameray>-2</cameray><zoom version="2">1.25</zoom></view><preconditions><condition narrative="None" /></preconditions><endpoint narrative="None" /><subsheet subsheetid="a3823867-6967-499c-a67f-9bf619e31167" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="1ad0659e-ade6-4295-89d6-3d44676367ae" type="Normal" published="True"><name>Extract Sharepoint URL</name><view><camerax>-142</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="3001d0b7-d65b-4394-b1ed-b443effd5e86" type="Normal" published="True"><name>Get File</name><view><camerax>-52</camerax><cameray>-21</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="deb81301-b6f4-44e2-9f30-f874bbe0f40f" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>2bbef592-0043-41c8-bc91-6f7bb772c96e</onsuccess></stage><stage stageid="2bbef592-0043-41c8-bc91-6f7bb772c96e" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="bfbde942-7dd7-4cc8-bdc9-508f1027bf7f" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>Newtonsoft.Json.dll</reference><reference>System.Linq.dll</reference><reference>System.Core.dll</reference><reference>System.Runtime.Serialization.dll</reference><reference>System.Security.dll</reference><reference>System.Net.Http.dll</reference><reference>Microsoft.IdentityModel.Clients.ActiveDirectory.dll</reference><reference>System.Runtime.Extensions.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import><import>Newtonsoft.Json</import><import>Newtonsoft.Json.Linq</import><import>System.Linq</import><import>System.Collections.Generic</import><import>System.Security.Cryptography.X509Certificates</import><import>System.Globalization</import><import>Microsoft.IdentityModel.Clients.ActiveDirectory</import><import>System.Net.Http</import><import>System.Net.Http.Headers</import><import>System.IO</import></imports><language>csharp</language><globalcode><![CDATA[]]></globalcode><code><![CDATA[// Function to get url components as colelction 
		
		static DataTable getURLComponents(string url)
        {

            string businessEntity, uriPath;

            businessEntity = url.Replace("https://", "").Replace("http://","");
           
			businessEntity = businessEntity.Substring(0, businessEntity.IndexOf(".shell.com"));
			uriPath = url.Substring(url.IndexOf(".shell.com") + 10, url.Length - url.IndexOf(".shell.com") - 10);

            DataTable DT = new DataTable();
            DT.Columns.Add("businessEntity");
            DT.Columns.Add("uriPath");

            var rw = DT.NewRow();
            rw["businessEntity"] = businessEntity;
            rw["uriPath"] = uriPath;
            DT.Rows.Add(rw);

            return DT;

        }
		
	
		// Function to download file as binary from sharepoint.
		//Input : Sharepoint URL - https://eu001-sp.shell.com/sites/AAAAA0626 

			//Output : businessEntity - eu001-sp
             //		   URIPath - /sites/AAAAA0626
		
		static byte[] getFile(string businessEntity, string urlSubsite, string accessToken, string fileSeverRelativeUrl )
        {
            HttpClient client = new HttpClient();
            UriBuilder builder = new UriBuilder();
            builder.Scheme = "https";
            builder.Host = businessEntity;//"blueprismindia.sharepoint.com";  
            client.DefaultRequestHeaders.Accept.Clear();
            client.DefaultRequestHeaders.Accept.Add(
                new MediaTypeWithQualityHeaderValue("application/json"));
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);
            client.BaseAddress = builder.Uri;
          	var response = client.GetAsync(urlSubsite+ "_api/web/GetFileByServerRelativeUrl("+ fileSeverRelativeUrl + ")/$value").Result;
            return response.Content.ReadAsByteArrayAsync().Result;
        }
		
		]]></code></stage><stage stageid="f5dd090e-cd93-4a47-92c5-997d1d544d63" name="Clean Up" type="SubSheetInfo"><subsheetid>a3823867-6967-499c-a67f-9bf619e31167</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="8d745eb6-ce38-4e18-a9db-036759c54588" name="Start" type="Start"><subsheetid>a3823867-6967-499c-a67f-9bf619e31167</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>7bbaed88-b0a4-4efd-be7b-fcd0acb229d8</onsuccess></stage><stage stageid="7bbaed88-b0a4-4efd-be7b-fcd0acb229d8" name="End" type="End"><subsheetid>a3823867-6967-499c-a67f-9bf619e31167</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="53bd9ca1-82f0-43f5-a2b0-c20a6bb5e2f2" name="Note1" type="Note"><subsheetid>a3823867-6967-499c-a67f-9bf619e31167</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="a8f5cb2a-ef20-4dfe-81ef-e453b0707e06" name="Note2" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="ac2b63b3-66c0-4065-825d-7caaceb9cba7" name="Get File" type="SubSheetInfo"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><narrative>GetFile From Sharepoint</narrative><display x="-180" y="-210" w="150" h="90" /></stage><stage stageid="4f1ee033-5fc6-44d0-834d-3c058503ed05" name="Start" type="Start"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><preconditions><condition narrative="Access Token to Sharepoint shoule be available" /></preconditions><postconditions><condition narrative="File will be downloaded as binary" /></postconditions><display x="15" y="-150" /><inputs><input type="text" name="Bussines Entity" narrative="Business Entity received from Get URL Components action" stage="bussinesEntity" /><input type="text" name="Bearer token Credential Name" narrative="Credential Name to get Bearer token" stage="Sharepoint_Bearer_Token" /><input type="text" name="File URL " narrative="File URL in sharepoint" stage="File_URL" /><input type="text" name="URL Subsite" narrative="URL Subsite obtained from Get URL Components action" stage="URL Subsite" /></inputs><onsuccess>fe7c7bdf-c453-4ad8-a6d9-019f21de6acf</onsuccess></stage><stage stageid="43279674-a36c-4db9-855e-e26bb894980e" name="End" type="End"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="15" y="60" /><outputs><output type="binary" name="File Data" narrative="Binary File data downloaded from Sharepoint" stage="fileData" /></outputs></stage><stage stageid="931d15dd-c6eb-4d15-a619-4b7c31c55a8b" name="bussinesEntity" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-360" y="-75" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="63832d41-a11b-4e76-ad07-ab6e6a068a06" name="fileData" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="-360" y="120" w="90" h="30" /><datatype>binary</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a8a326b8-2dce-4238-b8d8-8ea41fd87b29" name="Sharepoint_Bearer_Token" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="-360" y="-135" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f5f9c27b-7fb4-4a39-afe4-99dea60b8a95" name="Call Sharepoint Rest API and Return File" type="Code"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="15" y="-15" w="180" h="30" /><inputs><input type="text" name="bussinesEntity" expr="[bussinesEntity] &amp;&quot;.shell.com&quot;" /><input type="password" name="accessToken" expr="[Bearer Token]" /><input type="text" name="fileSeverRelativeUrl" expr="[File_URL]" /><input type="text" name="urlSubsite" expr="[URL Subsite]&amp;&quot;/&quot;" /></inputs><outputs><output type="binary" name="fileData" stage="fileData" /></outputs><onsuccess>43279674-a36c-4db9-855e-e26bb894980e</onsuccess><code><![CDATA[fileData = getFile(bussinesEntity, urlSubsite, accessToken, fileSeverRelativeUrl );]]></code></stage><stage stageid="eafe7065-38d9-41bb-8d30-12768fd5ce5c" name="File_URL" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="-360" y="-105" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="3f91de20-82b2-4ed9-8ad8-b7c65bd14219" name="Output Parameters" type="Block"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-435" y="75" w="165" h="75" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="98f93472-4c1e-46d4-afa2-be4cf72cfefc" name="Get File as Binary" type="Block"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-105" y="-45" w="315" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="5ad81e1d-a383-48c6-99e9-5a9ba55d49c5" name="Recover" type="Recover"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="150" y="-15" /><onsuccess>0154bc68-9545-4563-8f26-dc00721a069d</onsuccess></stage><stage stageid="0154bc68-9545-4563-8f26-dc00721a069d" name="Exception" type="Exception"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="270" y="-15" /><exception type="System Exception" detail="&quot;Sharepoint_API&gt;&gt;Get File&gt;&gt; Error in Downloading file from Sharepoint. Exception details: &quot; &amp; ExceptionDetail() " /></stage><stage stageid="47858bcf-c2ab-47a2-bf08-009d830c4836" name="Input Parameters" type="Block"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-435" y="-180" w="165" h="165" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="6cc65433-bdb4-4d30-8121-5c781fa43362" name="Extract Sharepoint URL" type="SubSheetInfo"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><narrative>Get all the components of the URL</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="397872d6-207d-4d65-834f-380133a0a280" name="Start" type="Start"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><preconditions><condition narrative="Sharepoint URL is available in Blueprism Environment Variable - &quot;Sharepoint URL&quot;" /></preconditions><postconditions><condition narrative="Components of the URL will be split into fields in Output Collection" /></postconditions><display x="15" y="-105" /><inputs><input type="text" name="Sharepoint URL" narrative="Sharepoint URL to get URL components &lt;eg.  https://eu001-sp.shell.com/sites/AAAAA0626 &gt;" stage="Sharepoint URL" /></inputs><onsuccess>b85fb72e-1c4b-4eec-b206-5b397a38ca07</onsuccess></stage><stage stageid="358ecb6c-1cf0-4e3b-aa57-3d639788194d" name="End" type="End"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="collection" name="URL Components" narrative="Components of URL split into collection fields" stage="URL Components" /></outputs></stage><stage stageid="b85fb72e-1c4b-4eec-b206-5b397a38ca07" name="Get URL Components" type="Code"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><display x="15" y="-15" w="120" h="30" /><inputs><input type="text" name="URL" expr="[Sharepoint URL]" /></inputs><outputs><output type="collection" name="URLComponents" stage="URL Components" /></outputs><onsuccess>358ecb6c-1cf0-4e3b-aa57-3d639788194d</onsuccess><code><![CDATA[URLComponents = getURLComponents(URL);]]></code></stage><stage stageid="70844299-9422-460c-b7b0-6f6628efc45e" name="Sharepoint URL" type="Data"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><narrative>Sharepoint URL </narrative><display x="-495" y="-30" w="150" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f7f2d49b-083f-4d3c-9230-334a352149de" name="URL Components" type="Collection"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><display x="-495" y="75" w="150" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="a530090c-eaeb-4898-acde-7ee0aaa9f6dd" name="Derived Parameters" type="Block"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><display x="-585" y="-75" w="180" h="90" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="2f64d8b2-e180-4dc6-84ef-468c6e8be9a2" name="Output Parameters" type="Block"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><display x="-585" y="30" w="180" h="75" /><font family="Segoe UI" size="10" style="Regular" color="CCFFCC" /></stage><stage stageid="1f8f8f3f-d0ee-4ebf-8b86-99047110d793" name="Recover" type="Recover"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><display x="255" y="-60" /><onsuccess>5093c2ba-890e-40b6-a9be-e4252bc334a2</onsuccess></stage><stage stageid="5093c2ba-890e-40b6-a9be-e4252bc334a2" name="Exception" type="Exception"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><display x="255" y="45" /><exception type="System Exception" detail="&quot;Sharepoint_API &gt;&gt; Extract Sharepoint URL &gt;&gt; Unable to get the components of the URL provided. Exception Details: &quot; &amp; ExceptionDetail() " /></stage><stage stageid="77a1ed08-ca89-4cc6-8039-69db350294f9" name="Example" type="Note"><subsheetid>1ad0659e-ade6-4295-89d6-3d44676367ae</subsheetid><loginhibit /><narrative>Input : Sharepoint URL - https://eu001-sp.shell.com/sites/AAAAA0626 

Output : businessEntity - eu001-sp
             URIPath - /sites/AAAAA0626</narrative><display x="-195" y="0" w="210" h="90" /></stage><stage stageid="284d35e8-a009-4f1d-b391-8901e9e145ae" name="Example" type="Note"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><narrative>Input : Sharepoint Bearer Token- Credential Name to get bearer token.
           
           File_URL - URL of the file with extension excluding the domain name
eg. "/sites/AAAAA0626/TEST LIB/test1/Run_a_custom_report_2015-10-29T145736.xlsx"

      Business Entity - Business entity received as ouput in Get URL Components            Action -" eu001-sp"

Output : fileData - Downloaded sharepoint file in binary format</narrative><display x="-195" y="30" w="120" h="210" /></stage><stage stageid="fe7c7bdf-c453-4ad8-a6d9-019f21de6acf" name="Get Bearer Token" type="Action"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><narrative>Get the specified set of credentials.

An Exception will occur if access to the credentials is not allowed, based on the running Resource, Process and User.</narrative><display x="15" y="-90" w="90" h="30" /><inputs><input type="text" name="Credentials Name" narrative="The name of the credentials to get" expr="[Sharepoint_Bearer_Token]" /></inputs><outputs><output type="password" name="Password" narrative="The password" stage="Bearer Token" /><output type="text" name="Username" narrative="The user name" stage="" /><output type="date" name="Expiry Date" narrative="The expiry date" stage="" /><output type="text" name="Status" narrative="The status" stage="" /></outputs><onsuccess>f5f9c27b-7fb4-4a39-afe4-99dea60b8a95</onsuccess><resource object="Blueprism.Automate.clsCredentialsActions" action="Get" /></stage><stage stageid="4f76c89a-23a4-44d2-86ef-01aba9be2d08" name="Bearer Token" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="-360" y="30" w="90" h="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="8660b8d1-60a8-433c-81f7-afe40b445757" name="Processed Parameters" type="Block"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-435" y="0" w="165" h="60" /><font family="Segoe UI" size="10" style="Regular" color="FFFF99" /></stage><stage stageid="8f5a3844-ea50-401c-bd63-586663488c1b" name="Get bearer token" type="Block"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="-105" y="-120" w="315" h="60" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="2a9ae211-451f-4fdf-bda4-3d2269a61f9a" name="Recover" type="Recover"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><loginhibit /><display x="150" y="-90" /><onsuccess>4dd3d0e8-05d4-48f5-8bc3-c11cb58100b8</onsuccess></stage><stage stageid="4dd3d0e8-05d4-48f5-8bc3-c11cb58100b8" name="Exception" type="Exception"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="270" y="-90" /><exception type="System Exception" detail="&quot;Sharepoint_API&gt;&gt;Get File&gt;&gt; Error in getting bearer token from credential manager. Exception details: &quot; &amp; ExceptionDetail() " /></stage><stage stageid="73fdb39b-3eab-40f9-aa5a-b6b063a46208" name="URL Subsite" type="Data"><subsheetid>3001d0b7-d65b-4394-b1ed-b443effd5e86</subsheetid><display x="-360" y="-45" w="120" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage></process></object>
