CALL 'SAP Login'
# ############## MAINFRAME LOGIN ##############
# ///////////////////////////// Input value for Mainframe login /////////////////////////////
SET DEX_Retry_Flag TO True
SET DEX_LoginStatus TO False
SET DEX_ApplicationPath TO $'''C:\\ProgramData\\Hummingbird\\Connectivity\\15.00\\Shared\\Profile\\Default 3270.hep'''
SET DEX_DLLFilePath TO $'''C:\\Program Files (x86)\\Power Automate Desktop\\ehlapi32.dll'''
SET DEX_WindowTitle TO $'''A - Default 3270 (mvsa.europe.shell.com)'''
SET DEX_SessionName TO $'''A'''
SET DEX_UserName TO $'''USERNAME'''
SET DEX_Password TO $'''PASSWORD'''
SET DEX_LoginError TO $'''%''%'''
SET DEX_SessionScreenName TO $'''CL/SuperSession Main Menu'''
SET DEX_Environment TO $'''SITCOC'''
SET DEX_MainScreen TO $'''OTIS Main Menu - DEX'''
CALL 'Launch & Login DEX Application'
# ############## Download File from SharePoint ##############
